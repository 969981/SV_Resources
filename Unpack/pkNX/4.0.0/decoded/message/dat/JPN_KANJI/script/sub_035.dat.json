  "\u307E\u3042\uFF01\u3000\u3068\u3063\u3066\u3082\u3000{\u5927|\u304A\u304A}\u304D\u3044\u308F\u306D\uFF01\\n\u30C9\u30C3\u30B7\u30EA\u3068\u3000{\u80CC\u4E2D|\u305B\u306A\u304B}\u3092\u3000\u3042\u305A\u3051\u3089\u308C\u308B\\r\\n{\u5B89\u5FC3\u611F|\u3042\u3093\u3057\u3093\u304B\u3093}\u304C\u3000\u3059\u3054\u3044\u308F\uFF01",
  "\u3075\u3075\uFF01\u3000{\u666E\u901A|\u3075\u3064\u3046}\u306E{\u5B50|\u3053}\u3088\u308A\\n\u3051\u3063\u3053\u3046\u3000{\u5927|\u304A\u304A}\u304D\u3081\u3000\u307F\u305F\u3044\u3088\uFF01\\r\\n\u3053\u306E{\u500B\u6027|\u3053\u305B\u3044}\u3000{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306B\u3057\u3066\u306D\uFF01",
  "{\u666E\u901A|\u3075\u3064\u3046}\u306E{\u5B50|\u3053}\u3088\u308A\\n\u3061\u3087\u3063\u3074\u308A\u3000{\u5927|\u304A\u304A}\u304D\u3081\u3000\u307F\u305F\u3044\u306D\uFF01",
  "\u30B6\u30FB{\u6A19\u6E96|\u3072\u3087\u3046\u3058\u3085\u3093}\uFF01\\n{\u5E73\u5747\u7684|\u3078\u3044\u304D\u3093\u3066\u304D}\u306A\u30B5\u30A4\u30BA\u3067\\r\\n\u30AA\u30FC\u30BD\u30C9\u30C3\u30AF\u30B9\u306A{\u9B45\u529B|\u307F\u308A\u3087\u304F}\u304C\u3000\u3042\u308B\u308F",
  "{\u666E\u901A|\u3075\u3064\u3046}\u306E{\u5B50|\u3053}\u3088\u308A\\n\u3061\u3087\u3063\u3074\u308A\u3000{\u5C0F|\u3061\u3044}\u3055\u3081\u3000\u307F\u305F\u3044\u306D\uFF01",
  "\u3075\u3075\uFF01\u3000{\u666E\u901A|\u3075\u3064\u3046}\u306E{\u5B50|\u3053}\u3088\u308A\\n\u3051\u3063\u3053\u3046\u3000{\u5C0F|\u3061\u3044}\u3055\u3081\u3000\u307F\u305F\u3044\uFF01\\r\\n\u3053\u306E{\u500B\u6027|\u3053\u305B\u3044}\u3000{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306B\u3057\u3066\u306D\uFF01",
  "\u307E\u3042\uFF01\u3000\u3068\u3063\u3066\u3082\u3000{\u5C0F|\u3061\u3044}\u3055\u3044\u308F\u306D\uFF01\\n[VAR 0101(0001)]{\u754C|\u304B\u3044}\u306E\u3000{\u5C0F|\u3061\u3044}\u3055\u306A\u30A2\u30A4\u30C9\u30EB\uFF01\\r\\n\u30C1\u30E3\u30FC\u30DF\u30F3\u30B0\u3055\u304C\u3000\u3059\u3054\u3044\u308F\uFF01",
  "\u30A4\u30C3\u30C4\u3000\u30A2\u3000\u30B9\u30E2\u30FC\u30EB\u3000\u30DD\u30B1\u30E2\u30F3\uFF01\uFF01\uFF01\uFF01\\c\\n\u3053\u3093\u306A\u306B\u3000{\u5C0F|\u3061\u3044}\u3055\u3044\u306E\\n\u3081\u3063\u305F\u306B\u3000\u304A{\u76EE|\u3081}\u306B\u3000\u304B\u304B\u308C\u306A\u3044\u308F\uFF01",
  "\u304D\u3063\u3068\u3000{\u4E16\u754C\u4E00|\u305B\u304B\u3044\u3044\u3061}\u3000{\u5C0F|\u3061\u3044}\u3055\u306A\\n[VAR 0101(0001)]\u3088\uFF01",
  "\u3067\u3063\u304B\u3044\u306E\\n{\u898B|\u307F}\u305B\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u3046\\r\\n\u3042\u304B\u3057\u3092\u3000\u3064\u3051\u3066\u3042\u3052\u308B\u308F\u306D",
  "\u3061\u3063\u3061\u3083\u3044\u306E\\n{\u898B|\u307F}\u305B\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u3046\\r\\n\u3042\u304B\u3057\u3092\u3000\u3064\u3051\u3066\u3042\u3052\u308B\u308F\u306D",
  "[VAR 0102(0001)]\u306F\\n\u3067\u3063\u304B\u3044\u3042\u304B\u3057\u3092\u3000\u3064\u3051\u3066\u3082\u3089\u3063\u305F\uFF01",
  "[VAR 0102(0001)]\u306F\\n\u3061\u3063\u3061\u3083\u3044\u3042\u304B\u3057\u3092\u3000\u3064\u3051\u3066\u3082\u3089\u3063\u305F\uFF01",
  "\u30B5\u30A4\u30BA\u304C\u3000{\u6C17|\u304D}\u306B\u306A\u3063\u305F\u3089\\n\u3044\u3064\u3067\u3082\u3000{\u6765|\u304D}\u3066\u306D",
  "{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u5927|\u304A\u304A}\u304D\u3044{\u5B50|\u3053}\u3084\\n{\u5C0F|\u3061\u3044}\u3055\u3044{\u5B50|\u3053}\u304C\u3000\u3044\u308B\u306E\u3000{\u77E5|\u3057}\u3063\u3066\u308B\uFF1F\\c\\n\u3046\u3061\u306E\u3000\u30D1\u30C1\u30EA\u30B9\u3061\u3083\u3093\u305F\u3061\\n{\u898B\u6BD4|\u307F\u304F\u3089}\u3079\u308B\u3068\u3000\u308F\u304B\u308A\u3084\u3059\u3044\u308F\uFF01\\c\\n\u308F\u305F\u3057\u306F\u3000{\u898B|\u307F}\u308B\u3060\u3051\u3067\u3000\u3068\u30FC\u3063\u3066\u3082\\n{\u53B3\u5BC6|\u3052\u3093\u307F\u3064}\u306B\u3000\u30DD\u30B1\u30E2\u30F3\u306E{\u5927|\u304A\u304A}\u304D\u3055\u304C\u3000\u308F\u304B\u308B\u306E\u3088\uFF01",
  "[~ 21]"
