[
  "\u305D\u308C\u3058\u3083\u3042\u3000{\u4ECA|\u3044\u307E}\u304B\u3089\\n\u30B0\u30E9\u30A6\u30F3\u30C9\u3067\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u3088\u3046\u3088\uFF01[VAR 0114(0004)]",
