[
  "\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u2026\u2026",
  "\u3042\u3000\u3082\u3057\u3082\u3057\uFF01\\n\u308F\u305F\u3057\u3000\u30CD\u30E2\u3000\u30CD\u30E2\uFF01[VAR 0114(0004)]",
  "\u3053\u308C\u304B\u3089\u306F\u3000\u30B9\u30DE\u30DB\u3067\\n\u304A\u305F\u304C\u3044\u306E{\u8FD1\u6CC1|\u304D\u3093\u304D\u3087\u3046}\u3000{\u77E5|\u3057}\u3089\u305B\u3042\u304A\u3046\u3088\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u306F\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u897F\u5074|\u306B\u3057\u304C\u308F}\u304B\u3089\\n{\u65C5\u7ACB|\u305F\u3073\u3060}\u3064\u3053\u3068\u306B\u3000\u3057\u305F\u3093\u3060\u306D\uFF01[VAR 0114(0004)]",
  "\u305D\u3063\u3061\u3000\u3060\u3063\u305F\u3089\\n\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u304C\u3000{\u8FD1|\u3061\u304B}\u3044\u3088\uFF01[VAR 0114(0004)]",
  "\u3080\u3057\u30BF\u30A4\u30D7\u306E\u30B8\u30E0\u3000\u3042\u308B\u304B\u3089\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\u3000{\u6311|\u3044\u3069}\u3081\u308B\u306D\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u306A\u3089\u3000\u304D\u3063\u3068{\u52DD|\u304B}\u3066\u308B\uFF01\\n\u304C\u3093\u3070\u3063\u3066\uFF01\u3000\u307E\u305F{\u9023\u7D61|\u308C\u3093\u3089\u304F}\u3059\u308B\u30FC\uFF01[VAR 0114(0004)]",
  "\u3082\u3057\u3082\u3057\uFF1F\u3000[VAR 0100(0000)]\u306E\\n\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u3067\u3000\u3042\u3063\u3066\u308B\u3088\u306A[VAR 0114(0006)]",
  "\u30AA\u30EC\u3000\u30DA\u30D1\u30FC\u3060\u305C\uFF01\\n\u3061\u3083\u3093\u3068\u3000{\u65C5\u7ACB|\u305F\u3073\u3060}\u3063\u305F\u304B\u3000{\u5FC3\u914D|\u3057\u3093\u3071\u3044}\u3067\u3088[VAR 0114(0006)]",
  "[VAR 0100(0000)]\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E\\n{\u6771|\u3072\u304C\u3057}\u3063{\u5074|\u304B\u308F}\u304B\u3089\u3000{\u51FA\u767A|\u3057\u3085\u3063\u3071\u3064}\u3057\u305F\u3093\u3060\u306A\uFF01[VAR 0114(0006)]",
  "\u305D\u3063\u304B\u3089\u3060\u3063\u305F\u3089\u3000{\u5CA9\u58C1|\u304C\u3093\u307A\u304D}\u306E\u30CC\u30B7\u304C\\n\u3044\u308B\u3063\u3066\u3044\u3046\u3000{\u5CA9\u5834|\u3044\u308F\u3070}\u304C\u3000{\u8FD1|\u3061\u304B}\u3044\u305C[VAR 0114(0006)]",
  "\u30BD\u30A4\u30C4\u306F\u3000{\u5CA9|\u3044\u308F}\u307F\u3066\u3048\u306B\\n{\u58C1|\u304B\u3079}\u306B\u3000{\u5F35|\u306F}\u308A\u3064\u3044\u3066\\r\\n{\u7372\u7269|\u3048\u3082\u306E}\u3092\u3000{\u72D9|\u306D\u3089}\u3063\u3066\u3093\u3060\u3068\uFF01[VAR 0114(0006)]",
  "\u305F\u3060\u3000\u30CC\u30B7{\u63A2|\u3055\u304C}\u3057\u306B\u3000{\u5922\u4E2D|\u3080\u3061\u3085\u3046}\u306B\u306A\u3063\u3066\\n{\u5D16|\u304C\u3051}\u304B\u3089\u3000{\u843D|\u304A}\u3061\u308B\u3068\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\uFF01\\c\\n\u305D\u3093\u306A\u3068\u304D\u306F\u3000\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u3067\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3000{\u547C|\u3088}\u3076\u3088\u3046\u306B\u306A\\c\\n{\u5CA9\u5834|\u3044\u308F\u3070}\u304C\u3000{\u591A|\u304A\u304A}\u304F\u3066\u3000{\u5929\u7136|\u3066\u3093\u306D\u3093}\u306E\\n{\u8FF7\u8DEF|\u3081\u3044\u308D}\u307F\u3066\u3048\u306B\u3000\u306A\u3063\u3066\u308B\u304B\u3089\\r\\n{\u8FF7|\u307E\u3088}\u308F\u306D\u3048\u3088\u3046\u3000\u304C\u3093\u3070\u3063\u3066\u3000{\u63A2|\u3055\u304C}\u305D\u3046\u305C\uFF01\\r\\n\u30CC\u30B7\u3000{\u898B|\u307F}\u3064\u3051\u305F\u3089\u3000\u30E8\u30ED\u30B7\u30AF\u3061\u3083\u3093\u306A\uFF01[VAR 0114(0006)]"
]
