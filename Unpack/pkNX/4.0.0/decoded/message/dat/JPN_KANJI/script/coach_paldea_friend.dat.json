  "{\u5E97|\u307F\u305B}\u3067\u3000{\u898B|\u307F}\u3064\u3051\u305F\u3068\u304D\\n\u30AA\u30DE\u30A8\u306E{\u9854|\u304B\u304A}\u304C\u3000\u30C1\u30E9\u3064\u3044\u3066\u3055\\r\\n\u3060\u304B\u3089\u3000\u3084\u308B\u3088\uFF01\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u306A\uFF01[VAR 0114(0006)]",
  "[VAR 0100(0000)]\u306F\u3000\u30DA\u30D1\u30FC\u304B\u3089\\n[VAR FF00(0008)]\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u30AB\u30D0\u30FC\uFF08\u30C8\u30DE\u30C8\uFF09[VAR FF00(0000)]\\c\\n[VAR FF00(0008)]\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u30AB\u30D0\u30FC\uFF08\u30D9\u30FC\u30B3\u30F3\uFF09[VAR FF00(0000)]\\n[VAR FF00(0008)]\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u30AB\u30D0\u30FC\uFF08\u30D5\u30EB\u30FC\u30C4\uFF09[VAR FF00(0000)]\u3092\\r\\n\u3082\u3089\u3063\u305F\uFF01",
  "{\u8CA0|\u307E}\u3051\u306F\u3000\u3057\u305F\u3051\u3069\\n\u30DE\u30D5\u30A3\u30C6\u30A3\u30D5\u306F\u3000{\u6E80\u8DB3|\u307E\u3093\u305E\u304F}{\u6C17|\u3052}\u3060\u305C\uFF01[VAR 0114(0006)]",
  "[VAR 0100(0000)]\uFF01\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3042\u308A\u304C\u3068\u306A\uFF01[VAR 0114(0006)]",
  "\u304A\u304A\uFF01\u3000\u307E\u3050\u308C\u3067\u3000{\u52DD|\u304B}\u3063\u3061\u307E\u3063\u305F\uFF01\\n\u30DE\u30F3\u30AD\u30FC\u3082\u3000{\u6728|\u304D}\u304B\u3089\u3000{\u843D|\u304A}\u3061\u308B\u3063\u3066\u3084\u3064\u304B\uFF1F[VAR 0114(0006)]",
  "\u30C9\u30FC\u30E0\u3067\u3000{\u6D77|\u3046\u307F}{\u898B|\u307F}\u3066\u305F\u3089\\n\u30CE\u30CE\u30AF\u30E9\u30B2\u304C\u3000{\u6CF3|\u304A\u3088}\u3044\u3067\u3066\u3000\u30D3\u30C3\u30AF\u30EA\u3057\u305F\u305C\uFF01\\c\\n\u30A2\u30A4\u30C4\u3000{\u5225|\u3079\u3064}\u306E\u30DD\u30B1\u30E2\u30F3\u3000\u3089\u3057\u3044\u3051\u3069\\n\u3059\u3052\u30FC\u3000{\u4F3C|\u306B}\u3066\u308B\u3088\u306A\uFF01[VAR 0114(0006)]",
  "\u30AD\u30BF\u30AB\u30DF\u306E{\u91CC|\u3055\u3068}\u306F\\n\u30CF\u30CA\u30D3\u30E9\u30A2\u30A4\u30B9\u304C\u3000\u3046\u307E\u304B\u3063\u305F\u306A\\c\\n\u3053\u3053\u306E{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u3060\u3068\u3000{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u30D4\u30B6\u304C\\n\u306A\u304B\u306A\u304B\u3000\u30A4\u30B1\u308B\u305C\uFF01[VAR 0114(0006)]",
  "[VAR 0100(0000)]\u306E\u3000{\u6BCD|\u304B\u3042}\u3061\u3083\u3093\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3000\u3046\u307E\u304B\u3063\u305F\u3088\u306A\u30FC\\c\\n{\u4ECA\u5EA6|\u3053\u3093\u3069}\u3000\u30AA\u30DE\u30A8\u304C\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3082\u3000{\u98DF|\u304F}\u308F\u305B\u3066\u304F\u308C\u3088[VAR 0114(0006)]",
  "\u30AA\u30DE\u30A8\u306E\u3000[VAR 0101(0001)]\u306F\u3000\u3088\u304F\\n\u30DE\u30D5\u30A3\u30C6\u30A3\u30D5\u3068\u3000\u3058\u3083\u308C\u3066\u3000{\u904A|\u3042\u305D}\u3093\u3067\u308B\uFF01\\r\\n\u3044\u3044\u30E4\u30C4\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u306A\uFF01[VAR 0114(0006)]",
