[
  "\u3053\u307E\u3081\u306B\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\uFF01\\n\u304A{\u5E97|\u307F\u305B}\u3092\u3000{\u898B|\u307F}\u305F\u3089\u3000{\u8CB7|\u304B}\u3044\u3082\u306E\uFF01\\r\\n\u305D\u308C\u304C\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u306E{\u79D8\u8A23|\u3072\u3051\u3064}\u3088\uFF01",
  "\u3053\u306E\u30C8\u30E9\u30C3\u30AF\u3067\\n\u30AA\u30EA\u30FC\u30D6\u3092\u3000{\u904B|\u306F\u3053}\u3093\u3067\u3044\u308B\u3093\u3060\\r\\n{\u53CE\u7A6B|\u3057\u3085\u3046\u304B\u304F}\u306E{\u6642\u671F|\u3058\u304D}\u306F\u3000{\u5927\u5FD9|\u304A\u304A\u3044\u305D\u304C}\u3057\u3055\uFF01",
  "\u300E\u30E0\u30AF\u30ED\u30B8\u300F\u3067\u3000{\u58F2|\u3046}\u3063\u3066\u308B\u3000\u304A{\u83D3\u5B50|\u304B\u3057}\uFF01\\n\u3068\u3063\u3066\u3082\u3000\u304A\u3044\u3057\u304F\u3066\u3000{\u5927\u4EBA\u6C17|\u3060\u3044\u306B\u3093\u304D}\u306A\u306E\uFF01",
  "\u30BB\u30EB\u30AF\u30EB\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306F\\n{\u6226|\u305F\u305F\u304B}\u3046\u30D1\u30C6\u30A3\u30B7\u30A8\u3000\u30AB\u30A8\u30C7\uFF01\\r\\n{\u53EF\u6190|\u304B\u308C\u3093}\u306A{\u898B|\u307F}\u305F{\u76EE|\u3081}\u306B\u3000{\u6C17|\u304D}\u3092{\u629C|\u306C}\u304F\u306A\u3088",
  "\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u306F\\n\u30AA\u30EA\u30FC\u30D6{\u53CE\u7A6B\u796D|\u3057\u3085\u3046\u304B\u304F\u3055\u3044}\u306E\u3000{\u771F|\u307E}\u3063{\u6700\u4E2D|\u3055\u3044\u3061\u3085\u3046}\uFF01\\r\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u3082\u3000\u304A{\u796D\u4ED5\u69D8|\u307E\u3064\u308A\u3057\u3088\u3046}\u306B\u3000\u306A\u3063\u3066\u308B\u3088\uFF01",
  "\u3053\u308D\u3053\u308D\u3000\u30D4\u30AD\u30FC\u30F3\uFF01\\c\\n\u30BF\u30DE\u30F3\u30C1\u30E5\u30E9\u306F\u3000{\u7CF8\u7389|\u3044\u3068\u3060\u307E}\u3092\u3000{\u7740|\u304D}\u3053\u3093\u3067\\n{\u5916\u6575|\u304C\u3044\u3066\u304D}\u304B\u3089\u3000{\u8EAB|\u307F}\u3092{\u5B88|\u307E\u3082}\u308B\u3093\u3060\u3088\uFF01",
  "\u3053\u3053\u306F\u3000\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\\n\u30BB\u30EB\u30AF\u30EB\u306F\u3000\u30B5\u30FC\u30AF\u30EB\u3068\u3082\u3000{\u8AAD|\u3088}\u3080\uFF01\\r\\n\u30AA\u30EA\u30FC\u30D6\u306E{\u5F62|\u304B\u305F\u3061}\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u3060\u306A\uFF01",
  "\u30D3\u30D3\u30E8\u30F3\u306F\u3000{\u66AE|\u304F}\u3089\u3057\u3066\u305F\\n{\u5834\u6240|\u3070\u3057\u3087}\u306B\u3088\u3063\u3066\u3000{\u59FF|\u3059\u304C\u305F}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3089\u3057\u3044\\c\\n\u3053\u3044\u3064\u3089\u306F\u3000\u3069\u3053\u304B\u3089\u3000{\u6765|\u304D}\u305F\u3093\u3060\u308D\u3046\uFF1F",
  "\u3053\u306E{\u5E97|\u307F\u305B}\u3000\u304A{\u8336|\u3061\u3083}\u3057\u306A\u304C\u3089\\n\u30B8\u30E0\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u304C\u3000{\u898B|\u307F}\u308C\u308B\u3093\u3060"
]
