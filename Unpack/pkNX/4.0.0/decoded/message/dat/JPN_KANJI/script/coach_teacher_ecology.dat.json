  "\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u306F\\n\u3068\u30FC\u3063\u3066\u3082\u3000{\u8208\u5473\u6DF1|\u304D\u3087\u3046\u307F\u3076\u304B}\u3044\u3067\u3059\u30FC\\c\\n\u30D1\u30EB\u30C7\u30A2\u3067\u306F\u3000{\u898B|\u307F}\u3089\u308C\u306A\u3044\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u3063\u3071\u3044\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u306F\u3000\u3044\u308D\u3093\u306A{\u5730\u65B9|\u3061\u307B\u3046}\u3092\\n{\u884C|\u3044}\u304D{\u6765|\u304D}\u3067\u304D\u3066\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3067\u3059\u30FC\\c\\n{\u79FB\u52D5|\u3044\u3069\u3046}{\u4E2D|\u3061\u3085\u3046}\u306F\u3000\u307C\u30FC\u3063\u3068\u3000\u3057\u3066\u308B\u3068\\n\u3059\u3050{\u7740|\u3064}\u304F\u306E\u3067\u3000{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000{\u82E6|\u304F}\u3058\u3083\u306A\u3044\u3067\u3059\u3057\u30FC[VAR 0114(002A)]",
  "\u3088\u305D\u3055\u307E\u306E\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306B\\n\u30B5\u30F3\u30C0\u30EB\u3067\u3000{\u6765|\u304D}\u3061\u3083\u3044\u307E\u3057\u305F\u3042\\c\\n\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000{\u898B|\u307F}\u3064\u304B\u3063\u305F\u3089\\n\u307E\u305F\u3000{\u6012|\u304A\u3053}\u3089\u308C\u305D\u3046\u3067\u3059\u30FC[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u3000[VAR 0101(0001)]\u306F\\n\u3068\u30FC\u3063\u3066\u3082\u3000{\u500B\u6027\u7684|\u3053\u305B\u3044\u3066\u304D}\u3067\u3059\u306D\u3048\uFF01\\r\\n{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u307F\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3067\u3059\u30FC[VAR 0114(002A)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30B4\u30AF\u30EA\u30F3\u306F\\n\u304A\u3082\u3057\u308D\u3044{\u5B50|\u3053}\u3000\u306A\u3093\u3067\u3059\u3088\u304A\uFF01\\c\\n\u304F\u3044\u3057\u3093\u307C\u3046\u3000\u306A\u306E\u3067\\n\u306F\u3084\u3081\u306B\u3000\u304D\u306E\u307F\u3092\u3000{\u98DF|\u305F}\u3079\u307E\u3042\u3059[VAR 0114(002A)]"
]
