[
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF01\\n{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000\u3084\u3063\u3066\u3044\u304F\u305E\uFF01[VAR 0114(0024)]",
  "\u307F\u3093\u306A\u3000{\u8AB2\u5916\u6388\u696D|\u304B\u304C\u3044\u3058\u3085\u304E\u3087\u3046}\u306E\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u306F\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\u3060\u308D\u3046\u304B\uFF01\uFF1F[VAR 0114(0024)]",
  "\u30B8\u30E0\u3092{\u76EE\u6307|\u3081\u3056}\u3057\uFF01\u3000{\u91CE|\u306E}\u3092{\u99C6|\u304B}\u3051\uFF01\\n{\u76F8\u68D2|\u3042\u3044\u307C\u3046}\u306E\u30DD\u30B1\u30E2\u30F3\u3068\u3000\u3068\u3082\u306B\u3000{\u8D70|\u306F\u3057}\u308B\\r\\n{\u5927\u5192\u967A|\u3060\u3044\u307C\u3046\u3051\u3093}\u304C\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u306A\uFF01[VAR 0114(0024)]",
  "{\u5B66\u5916|\u304C\u304F\u304C\u3044}\u3067\u3000{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u3057\u3066\u3044\u308B\u3068\\n{\u5927|\u304A\u304A}\u304D\u304F\u3000{\u5149|\u3072\u304B}\u308A\u304B\u304C\u3084\u304F\u3000[VAR FF00(0006)]{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}[VAR FF00(0000)]\u3092\\r\\n{\u898B|\u307F}\u3064\u3051\u308B\u3053\u3068\u3082\u3000{\u591A|\u304A\u304A}\u3044\u3093\u3058\u3083\u306A\u3044\u304B\uFF01[VAR 0114(0024)]",
  "{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306F\u3000{\u5730\u4E2D|\u3061\u3061\u3085\u3046}\u304B\u3089\u3000\u306B\u3058\u307F{\u51FA|\u3067}\u308B\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30A8\u30CD\u30EB\u30AE\u30FC\u306E\u3000\u304B\u305F\u307E\u308A\uFF01[VAR 0114(0024)]",
  "{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u3092\u3000{\u8ABF|\u3057\u3089}\u3079\u308B\u3068\\n{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u306A\u3069\u3000{\u8AB0|\u3060\u308C}\u304B\u3068\u3000\uFF14{\u4EBA|\u306B\u3093}\u3067\\r\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3053\u3068\u306B\u3000\u306A\u308B\uFF01[VAR 0114(0024)]",
  "\u305D\u306E{\u6226|\u305F\u305F\u304B}\u3044\u3092\\n\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3068\u3000\u3044\u3046\uFF01\uFF01[VAR 0114(0024)]",
  "\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3046\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u5F37\u6575|\u304D\u3087\u3046\u3066\u304D}\u3060\uFF01[VAR 0114(0024)]",
  "{\u666E\u901A|\u3075\u3064\u3046}\u306E\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u7570|\u3053\u3068}\u306A\u308B{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u3092\\n\u3068\u308B\u3053\u3068\u304C\u3000\u3042\u308B\u306E\u3067\u3000{\u6C17|\u304D}\u3092{\u629C|\u306C}\u304F\u306A\u3088\uFF01[VAR 0114(0024)]",
  "\u3060\u304C\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3067\u306F\\n\u30C8\u30EC\u30FC\u30CA\u30FC\u3082\u3000\u300E[VAR FF00(0006)]\u304A\u3046\u3048\u3093[VAR FF00(0000)]\u300F\u3000\u3068\u3044\u3046\\r\\n{\u7279\u6B8A|\u3068\u304F\u3057\u3085}\u306A{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u304C\u3000\u3067\u304D\u308B\u3093\u3060\uFF01[VAR 0114(0024)]",
  "\u304A\u3046\u3048\u3093\u306B\u306F\u3000\uFF13{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u3000\u3042\u308B\uFF01[VAR 0114(0024)]",
  "{\u5473\u65B9\u5168\u4F53|\u307F\u304B\u305F\u305C\u3093\u305F\u3044}\u306E\u3000{\u653B\u6483|\u3053\u3046\u3052\u304D}\u3068{\u7279\u653B|\u3068\u304F\u3053\u3046}\u3092\\n{\u9AD8|\u305F\u304B}\u3081\u308B\u3000[VAR FF00(0006)]\u3044\u3051\u3044\u3051\u30C9\u30F3\u30C9\u30F3[VAR FF00(0000)][VAR 0114(0024)]",
  "{\u5473\u65B9\u5168\u4F53|\u307F\u304B\u305F\u305C\u3093\u305F\u3044}\u306E\u3000{\u9632\u5FA1|\u307C\u3046\u304E\u3087}\u3068{\u7279\u9632|\u3068\u304F\u307C\u3046}\u3092\\n{\u9AD8|\u305F\u304B}\u3081\u308B\u3000[VAR FF00(0006)]\u304C\u3063\u3061\u308A\u307C\u3046\u304E\u3087[VAR FF00(0000)][VAR 0114(0024)]",
  "\u305D\u3057\u3066\u3000\uFF13\u3064\u3081\u306F\u2026\u2026\\n{\u554F\u984C|\u3082\u3093\u3060\u3044}\u306B\u3000\u3057\u3066\u307F\u3088\u3046\uFF01[VAR 0114(0024)]",
  "{\u5473\u65B9\u5168\u4F53|\u307F\u304B\u305F\u305C\u3093\u305F\u3044}\u306E\u3000{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3092\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3055\u305B\u308B\\n\u304A\u3046\u3048\u3093\u306F\u3000{\u4F55|\u306A\u3093}\u3068\u3044\u3046{\u540D\u524D|\u306A\u307E\u3048}\u3000\u3060\u308D\u3046\u304B\uFF01[VAR 0114(0024)]",
  "\u3044\u3084\u3057\u306E\u30A8\u30FC\u30EB",
  "\u30C9\u30D0\u3063\u3068\u30AD\u30BA\u3050\u3059\u308A",
  "{\u7206\u88C2\u56DE\u5FA9\u6CE2|\u3070\u304F\u308C\u3064\u304B\u3044\u3075\u304F\u306F}",
  "{\u6B63|\u305F\u3060}\u3057\u3044{\u7B54|\u3053\u305F}\u3048\u3060\uFF01\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306F\\n\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\u306E\u3000{\u5927\u5148\u751F|\u3060\u3044\u305B\u3093\u305B\u3044}\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u30C9\u30D0\u3063\u3068\u30AD\u30BA\u3050\u3059\u308A\u2026\u2026\uFF01\uFF1F\\n\u305D\u308C\u306F\u3000\u304A\u3046\u3048\u3093\u3000\u3068\u3044\u3046\u3088\u308A\\r\\n{\u5F37\u5F15|\u3054\u3046\u3044\u3093}\u306A\u3000{\u533B\u7642\u884C\u70BA|\u3044\u308A\u3087\u3046\u3053\u3046\u3044}\u3060\u306A\u2026\u2026\uFF01[VAR 0114(0024)]",
  "{\u7206\u88C2\u56DE\u5FA9\u6CE2|\u3070\u304F\u308C\u3064\u304B\u3044\u3075\u304F\u306F}\u2026\u2026\uFF01\uFF1F\\n\u306A\u304B\u306A\u304B\u3000\u3053\u3046\u3070\u3057\u3044\u304C\\r\\n\u305D\u3093\u306A{\u6280|\u308F\u3056}\u304C\u3000\u3042\u3063\u305F\u3089\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u307F\u305F\u3044\u306A\uFF01[VAR 0114(0024)]",
  "\uFF13\u3064\u3081\u306F\u3000[VAR FF00(0006)]\u3044\u3084\u3057\u306E\u30A8\u30FC\u30EB[VAR FF00(0000)]\uFF01\\n{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3092\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3055\u305B\\r\\n{\u72B6\u614B\u7570\u5E38|\u3058\u3087\u3046\u305F\u3044\u3044\u3058\u3087\u3046}\u3082\u3000{\u6CBB|\u306A\u304A}\u305B\u308B\u3000{\u512A|\u3059\u3050}\u308C\u3082\u306E\u3060\uFF01[VAR 0114(0024)]",
  "\uFF11{\u56DE|\u304B\u3044}\u306E\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3067\\n\uFF13{\u56DE|\u304B\u3044}\u307E\u3067\u3000\u304A\u3046\u3048\u3093\u3000\u3067\u304D\u308B\u305E\uFF01[VAR 0114(0024)]",
  "\u3061\u306A\u307F\u306B\u3000\u304A\u3046\u3048\u3093\u3000\u3059\u308B\u3068\\n{\u81EA\u5206|\u3058\u3076\u3093}\u306E\u30BF\u30FC\u30F3\u3092\u3000{\u6D88\u8CBB|\u3057\u3087\u3046\u3072}\u3059\u308B\u306E\u3067\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u6280|\u308F\u3056}\u306F\u3000{\u51FA|\u3060}\u305B\u306A\u304F\u306A\u308B\u304B\u3089\u306A\uFF01[VAR 0114(0024)]",
  "{\u7D50\u8AD6|\u3051\u3064\u308D\u3093}\uFF01\uFF01[VAR 0114(0024)]",
  "{\u62BC|\u304A}\u3057\u3066\u3000\u30C0\u30E1\u306A\u3089\u3000{\u5F15|\u3072}\u3044\u3066\u307F\u308D\uFF01\\n\u305D\u308C\u3067\u3082\u3000\u30C0\u30E1\u306A\u3089\u3000\u304A\u3046\u3048\u3093\u3060\uFF01[VAR 0114(0024)]",
  "{\u4EF2\u9593|\u306A\u304B\u307E}\u3092\u3000\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u3053\u3068\u3067\\n{\u958B|\u3072\u3089}\u3051\u308B{\u9053|\u307F\u3061}\u3082\u3000\u3042\u308B\u3082\u306E\u3060\u305E\uFF01[VAR 0114(0024)]",
  "\u30E0\u30E0\uFF01\u3000{\u4F53|\u304B\u3089\u3060}\u3067\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3082\u3089\u304A\u3046\u3068\\n{\u601D|\u304A\u3082}\u3063\u305F\u304C\u3000\u3082\u3046{\u6642\u9593|\u3058\u304B\u3093}\u304B\u2026\u2026[VAR 0114(0024)]",
  "\u305D\u308C\u3067\u306F\u3000{\u89E3\u6563|\u304B\u3044\u3055\u3093}\u3060\uFF01\\n\u304A\u306E\u304A\u306E\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000{\u904E|\u3059}\u3054\u3057\u3066\u304F\u308C\uFF01[VAR 0114(0024)]"
