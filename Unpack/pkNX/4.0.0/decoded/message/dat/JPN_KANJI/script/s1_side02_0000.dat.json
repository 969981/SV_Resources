[
  "[~ 18]",
  "\u2026\u2026\u304A\u3063\u3000\u306A\u3093\u3060\u3000\u306A\u3093\u3060\uFF1F\\n{\u6C17|\u304D}\u3065\u304B\u306A\u304B\u3063\u305F\u3088[VAR 0114(002C)]",
  "\u30AD\u30DF\u306F\u2026\u2026\\n\u3048\u3048\u3068\u3000\u305D\u3046\u3060\\r\\n\u3042\u3066\u3066\u3042\u3052\u3088\u3046\uFF01[VAR 0114(002C)]",
  "\u30D1\u30EB\u30C7\u30A2\u304B\u3089\u3000\u3084\u3063\u3066\u304D\u305F\\n{\u6797\u9593\u5B66\u6821\u4E2D|\u308A\u3093\u304B\u3093\u304C\u3063\u3053\u3046\u3061\u3085\u3046}\u306E\u3000{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u30AF\u30F3\uFF01[VAR 0114(002C)]",
  "\u3042\u305F\u308A\u3067\u3059\uFF01",
  "{\u4F55\u6545|\u306A\u305C}\u305D\u308C\u3092\uFF1F",
  "\u3075\u3063\u3075\u3063\u3075\u30FC\uFF01\\n\u305B\u307E\u3044{\u6751|\u3080\u3089}\u3060\u304B\u3089\u3000\u3044\u308D\u3044\u308D\u3068\u306D\\r\\n{\u8033|\u307F\u307F}\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u304F\u308B\u3093\u3060\u3088[VAR 0114(002C)]",
  "\u30EF\u30BF\u30B7\u306F\u3000\u30B5\u30B6\u30EC\\n\u3061\u3087\u3063\u3074\u308A\u3000\u30AB\u30E1\u30E9{\u597D|\u305A}\u304D\u306A\u3000{\u65C5|\u305F\u3073}\u306E{\u8005|\u3082\u306E}\u3055[VAR 0114(0046)]",
  "\u3053\u3063\u3061\u306F\u3000{\u76F8\u68D2|\u3042\u3044\u307C\u3046}\u306E\u30AC\u30FC\u30C7\u30A3\\n{\u982D|\u3042\u305F\u307E}\u306E\u30C4\u30CE\u304C\u3000\u30AD\u30E5\u30FC\u30C8\u3067\u3057\u3087[VAR 0114(0046)]",
  "\u3050\u3075\u3093\uFF01",
  "\u3044\u304D\u306A\u308A\u3067\u3000{\u60AA|\u308F\u308B}\u3044\u3051\u3069\\n{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3000{\u64AE|\u3068}\u3089\u305B\u3066\u3082\u3089\u3063\u3066\u3082\u3000\u3044\u3044\u304B\u306A\uFF1F[VAR 0114(0046)]",
  "{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u30AF\u30F3\\n{\u7D20\u76F4|\u3059\u306A\u304A}\u3059\u304E\u3066\u3000{\u5FC3\u914D|\u3057\u3093\u3071\u3044}\u3060\u3088\\r\\n{\u77E5|\u3057}\u3089\u306A\u3044{\u4EBA|\u3072\u3068}\u3000{\u4FE1\u7528|\u3057\u3093\u3088\u3046}\u3057\u3059\u304E\u3061\u3083\u3000\u3044\u3051\u306A\u3044\u306A[VAR 0114(0046)]",
  "{\u5199\u771F|\u3057\u3083\u3057\u3093}\u306F\u3000{\u64AE|\u3068}\u308B\u3051\u3069\u306D[VAR 0114(0046)]",
  "{\u4F1A|\u3042}\u3063\u305F\u3070\u304B\u308A\u306E{\u4EBA|\u3072\u3068}\u3092\\n{\u9069\u5EA6|\u3066\u304D\u3069}\u306B\u3000{\u4FE1\u7528|\u3057\u3093\u3088\u3046}\u3057\u3059\u304E\u306A\u3044\uFF01\\r\\n\u3057\u3063\u304B\u308A\u3057\u3066\u308B\u306D\u3000{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u30AF\u30F3\uFF01[VAR 0114(0046)]",
  "\u306A\u3093\u3060\u304B\u3000\u30AD\u30DF\u3063\u3066\\n{\u65B0\u9BAE|\u3057\u3093\u305B\u3093}\u3067\u3000\u304A\u3082\u3057\u308D\u3044[VAR 0114(0046)]",
  "\u30EF\u30BF\u30B7\u306F\u3000\u3057\u3070\u3089\u304F\\n\u3053\u306E{\u6751|\u3080\u3089}\u3092\u3000{\u62E0\u70B9|\u304D\u3087\u3066\u3093}\u306B\u3000\u3057\u3066\u308B\u304B\u3089\u3055[VAR 0114(0046)]",
  "\u3084\u308B\u3079\u304D\u3053\u3068\u304C\u3000{\u7D42|\u304A}\u308F\u3063\u305F\u3089\\n\u307E\u305F\u3000{\u58F0|\u3053\u3048}\u304B\u3051\u3066\u3088\\c\\n\u30AD\u30BF\u30AB\u30DF{\u56F3\u9451|\u305A\u304B\u3093}\u3067\u3000\u30DD\u30B1\u30E2\u30F3\\n\uFF11\uFF15\uFF10{\u5339|\u3074\u304D}\u3000{\u96C6|\u3042\u3064}\u3081\u305F\u308A\u3055\uFF01[VAR 0114(0046)]",
  "{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u30AF\u30F3\uFF01\u3000\u30AD\u30DF\u306B\u306F\\n\u3084\u308B\u3053\u3068\u304C\u3000\u3042\u308B\u3093\u3058\u3083\u306A\u3044\uFF1F\\c\\n\u30AD\u30BF\u30AB\u30DF{\u56F3\u9451|\u305A\u304B\u3093}\u3067\u3000\u30DD\u30B1\u30E2\u30F3\\n\uFF11\uFF15\uFF10{\u5339|\u3074\u304D}\u3000{\u96C6|\u3042\u3064}\u3081\u305F\u308A\u3055\uFF01\\r\\n\u305D\u308C\u3000{\u7D42|\u304A}\u308F\u3063\u305F\u3089\u3000{\u58F0|\u3053\u3048}\u304B\u3051\u3066\u3088\\c\\n{\u6642\u9593|\u3058\u304B\u3093}\u306F\u3000{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u3060\u305E\u30FC\uFF1F\\n\u30BF\u30A4\u30E0\u3000\u30A4\u30BA\u3000\u30DE\u30CD\u30FC\u3063\u3066\u306D\uFF01[VAR 0114(0046)]"
]
