[
  "\u3069\u3046\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u3067\u3059\uFF01\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3057\u3066\u307E\u3059\u304B\uFF01\uFF1F",
  "\u3053\u3053\u3000[VAR 0105(0001)]\u3067\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306E\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u306B\u3000{\u52DD|\u304B}\u3063\u305F\u3089\\r\\n{\u8C6A\u83EF|\u3054\u3046\u304B}\u306A{\u666F\u54C1|\u3051\u3044\u3072\u3093}\u3092\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3067\u3059\u3088\uFF01",
  "[VAR 0105(0001)]\u3067\\n\u3042\u306A\u305F\u304C\u3000{\u52DD|\u304B}\u3063\u305F\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u306F\u2026\u2026\\r\\n[VAR 0201(0003)]{\u4EBA|\u306B\u3093}\u3000\u3067\u3059\u306D\uFF01",
  "{\u5408\u8A08|\u3054\u3046\u3051\u3044}\u3000[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306B\u3000{\u52DD|\u304B}\u3066\u308C\u3070\\n{\u8C6A\u83EF|\u3054\u3046\u304B}\u306A{\u666F\u54C1|\u3051\u3044\u3072\u3093}\u3092\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3067\u3059\u3088\uFF01",
  "\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\n\u305F\u304F\u3055\u3093\u3000{\u52DD\u5229|\u3057\u3087\u3046\u308A}\u3092\u3000\u304A\u3055\u3081\u307E\u3057\u305F\u306D\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u3088\u308A\\n{\u8C6A\u83EF|\u3054\u3046\u304B}\u306A{\u666F\u54C1|\u3051\u3044\u3072\u3093}\u306E\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3067\u3059\uFF01",
  "\u3055\u3089\u306B\u3000\u3082\u3046\uFF11\u3064\uFF01",
  "{\u5F53|\u3068\u3046}\u30A4\u30D9\u30F3\u30C8\u306F\u3000\u307B\u304B\u306E\u30A8\u30EA\u30A2\u3067\u3082\\n\u3084\u3063\u3066\u3044\u308B\u306E\u3067\u3000\u305D\u3061\u3089\u3067\u3082\u3000\u305C\u3072\uFF01",
  "\u30A4\u30D9\u30F3\u30C8\u3078\u306E\u3000\u3054{\u53C2\u52A0|\u3055\u3093\u304B}\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\uFF01"
]
