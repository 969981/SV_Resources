  "\u305D\u3057\u3066\u3000\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u3092\\n{\u51FA|\u3060}\u3057\u3066\u3082\u3089\u3048\u307E\u3059\u304B\u3042\uFF1F[VAR 0114(002A)]",
  "\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304C\u3000{\u8FFD\u52A0|\u3064\u3044\u304B}\u3057\u3066\u304F\u308C\u305F\\n{\u56F3\u9451|\u305A\u304B\u3093}\u30A2\u30D7\u30EA\u306E\u3000{\u8CDE\u72B6|\u3057\u3087\u3046\u3058\u3087\u3046}{\u6A5F\u80FD|\u304D\u306E\u3046}\u3067\\r\\n[VAR 0100(0000)]\u3055\u3093\u3092\u3000\u304A{\u795D|\u3044\u308F}\u3044\u3057\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3092\u3000{\u8A8D\u5B9A|\u306B\u3093\u3066\u3044}\u3057\u3066\u3044\u308B\\n{\u4F01\u696D|\u304D\u304E\u3087\u3046}\u304B\u3089\u3082\u3000\u30E1\u30C3\u30BB\u30FC\u30B8\u304C\\r\\n{\u5C4A|\u3068\u3069}\u3044\u3066\u3044\u307E\u3057\u305F\u306D\u3048[VAR 0114(002A)]",
