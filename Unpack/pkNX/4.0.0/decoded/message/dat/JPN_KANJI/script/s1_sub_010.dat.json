  "\u308F\u3042\u30FC\u3000\u308F\u3042\u30FC\uFF01\\n\u30AD\u30BF\u30AB\u30DF{\u56F3\u9451|\u305A\u304B\u3093}\u3000{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u3060\u3042\u30FC\uFF01\\r\\n\u3059\u3054\u3044\u30FC\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3059\u3054\u3044\u3067\u3059\u30FC\uFF01[VAR 0114(002A)]",
  "\u30AD\u30BF\u30AB\u30DF\u306E{\u91CC|\u3055\u3068}\u306E\u3000\u30DD\u30B1\u30E2\u30F3{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u306F\\n[VAR 0100(0000)]\u3055\u3093\u306E\u3000\u304A\u304B\u3052\u3067\\r\\n\u3053\u308C{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u306A\u3044\u304F\u3089\u3044\u3000{\u9032|\u3059\u3059}\u307F\u307E\u3057\u305F\u3042\uFF01[VAR 0114(002A)]",
  "\u304A{\u795D|\u3044\u308F}\u3044\u306B\u3000{\u4F55|\u306A\u306B}\u304B\\n{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u305F\u3044\u3067\u3059\u304C\u3000{\u6301|\u3082}\u3061{\u5408|\u3042}\u308F\u305B\u304C\u2026\u2026[VAR 0114(002A)]",
