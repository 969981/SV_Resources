  "\u3053\u308C\u304B\u3089\u3082\u3000\u30AD\u30BF\u30AB\u30DF\u306E\u30DD\u30B1\u30E2\u30F3\u306B\\n\u3044\u30FC\u3063\u3071\u3044\u3000{\u51FA\u4F1A|\u3067\u3042}\u3063\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]",
