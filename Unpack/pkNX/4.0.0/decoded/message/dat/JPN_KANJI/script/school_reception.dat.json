  "\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF08\uFF14\uFF09\u3000\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB",
  "{\u7F8E\u8853|\u3073\u3058\u3085\u3064}\uFF08\uFF14\uFF09\u3000\u30CD\u30A4\u30C1\u30E3\u30FC\u30A2\u30FC\u30C6\u30A3\u30B9\u30C8",
  "{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\uFF08\uFF14\uFF09\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u306E{\u52B9\u679C|\u3053\u3046\u304B}\u3092{\u9AD8|\u305F\u304B}\u3081\u308B",
  "{\u751F\u7269|\u305B\u3044\u3076\u3064}\uFF08\uFF15\uFF09\u3000{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u30DD\u30B1\u30E2\u30F3",
  "{\u6570\u5B66|\u3059\u3046\u304C\u304F}\uFF08\uFF15\uFF09\u3000{\u6280|\u308F\u3056}\u306E{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}",
  "{\u6B74\u53F2|\u308C\u304D\u3057}\uFF08\uFF15\uFF09\u3000{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306E{\u63A2\u691C\u8A18|\u305F\u3093\u3051\u3093\u304D}",
  "{\u8A00\u8A9E\u5B66|\u3052\u3093\u3054\u304C\u304F}\uFF08\uFF15\uFF09\u3000{\u60B2|\u304B\u306A}\u3057\u307F\u306E{\u8A00\u8449|\u3053\u3068\u3070}",
  "\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF08\uFF15\uFF09\u3000\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3",
  "{\u7F8E\u8853|\u3073\u3058\u3085\u3064}\uFF08\uFF15\uFF09\u3000\u30D1\u30EB\u30C7\u30A2{\u5341\u666F|\u3058\u3063\u3051\u3044}",
  "{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\uFF08\uFF15\uFF09\u3000\u30DD\u30B1\u30E2\u30F3\u30A6\u30A9\u30C3\u30B7\u30E5",
  "{\u751F\u7269|\u305B\u3044\u3076\u3064}\uFF08\uFF16\uFF09\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u30D5\u30A9\u30EB\u30E0",
  "{\u6570\u5B66|\u3059\u3046\u304C\u304F}\uFF08\uFF16\uFF09\u3000\u30BF\u30A4\u30D7\u306E{\u4E00\u81F4|\u3044\u3063\u3061}",
  "{\u6B74\u53F2|\u308C\u304D\u3057}\uFF08\uFF16\uFF09\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u306E{\u89E3\u660E|\u304B\u3044\u3081\u3044}",
  "{\u8A00\u8A9E\u5B66|\u3052\u3093\u3054\u304C\u304F}\uFF08\uFF16\uFF09\u3000\u3088\u308D\u3053\u3073\u306E{\u8A00\u8449|\u3053\u3068\u3070}",
  "\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF08\uFF16\uFF09\u3000{\u901A\u4FE1|\u3064\u3046\u3057\u3093}\u306E\u3059\u3059\u3081",
  "{\u7F8E\u8853|\u3073\u3058\u3085\u3064}\uFF08\uFF16\uFF09\u3000\u30EA\u30DC\u30F3\u3068\u3042\u304B\u3057",
  "{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\uFF08\uFF16\uFF09\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5236\u670D|\u305B\u3044\u3075\u304F}",
  "\u3082\u3069\u308B"
]
