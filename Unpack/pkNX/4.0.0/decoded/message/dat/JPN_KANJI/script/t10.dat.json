[
  "\u3053\u3053\u306F\u3000\u30B9\u30A4\u30EA\u30E7\u30AF\u30BF\u30A6\u30F3\\n{\u81EA\u7136|\u3057\u305C\u3093}\u3068\u3000\u308A\u3093\u3054\u304C\u3000{\u540D\u7523|\u3081\u3044\u3055\u3093}\u3088",
  "{\u6797\u9593\u5B66\u6821|\u308A\u3093\u304B\u3093\u304C\u3063\u3053\u3046}\u3067\u3000{\u6D77\u5916|\u304B\u3044\u304C\u3044}\u304B\u3089\u3000{\u6765|\u304D}\u305F\u3063\u3066\uFF1F\\n\u3069\u3046\u308A\u3067\u3000{\u898B|\u307F}\u305F\u3053\u3068\u306A\u3044\u3000{\u9854|\u304B\u304A}\u306A\u308F\u3051\u3060\uFF01",
  "\u304A{\u796D|\u307E\u3064}\u308A\u306E\u3000{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u3000{\u5927\u4E08\u592B|\u3060\u3044\u3058\u3087\u3046\u3076}\u305D\u3046\uFF1F\\n{\u58F2|\u3046}\u308A{\u7269|\u3082\u306E}\u306E\u3000{\u767A\u9001|\u306F\u3063\u305D\u3046}\u304C\u3000{\u9045|\u304A\u304F}\u308C\u3066\u308B\u306E\u2026\u2026",
  "\u3053\u3053\u3093\u3068\u3053\u3000{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000{\u5BB6|\u3044\u3048}\u3067\\n{\u713C|\u3084}\u304D\u305D\u3070{\u4F5C|\u3065\u304F}\u308A\u3000{\u7DF4\u7FD2|\u308C\u3093\u3057\u3085\u3046}\u3057\u3066\u308B\u305C",
  "{\u6843\u6CA2\u5546\u5E97|\u3082\u3082\u3056\u308F\u3057\u3087\u3046\u3066\u3093}\u306F\u3000{\u4FBF\u5229|\u3079\u3093\u308A}\u3060\u3079\uFF01\\n{\u9053\u5177|\u3069\u3046\u3050}\u306F\u3000\u3082\u3061\u308D\u3093\u306E\u3053\u3068\uFF01\\c\\n{\u5E97|\u307F\u305B}\u306E\u3070\u3042\u3061\u3083\u3093\u304C\u3000{\u7DE8|\u3042}\u3093\u3060\\n\u3042\u3063\u305F\u3051\u3048\u3000{\u9774\u4E0B|\u304F\u3064\u3057\u305F}\u3082\u3000{\u58F2|\u3046}\u3063\u3066\u3093\u3060\u3088",
  "\u3053\u306E{\u5148|\u3055\u304D}\u3000{\u767B|\u306E\u307C}\u3063\u3066\u3044\u304F\u3068\u3000\u30AD\u30BF\u30AB\u30DF\u30BB\u30F3\u30BF\u30FC\uFF01\\n\u305D\u3053\u305D\u3053\u3000{\u5C71\u9053|\u3084\u307E\u307F\u3061}\u3060\u304B\u3089\u3000\u30D5\u30A1\u30A4\u30C8\u3060\u3088\uFF01",
  "\u30CB\u30E7\u30ED\u30E2\u306E\u304A{\u8179|\u306A\u304B}\uFF01\\n{\u898B|\u307F}\u3066\u308B\u3068\u3000{\u76EE|\u3081}\u304C\u307E\u308F\u308B\u30FC\uFF01",
  "\u30BC\u30A4\u30E6\u3061\u3083\u3093\u3068\u3000\u30B9\u30B0\u30EA\u3061\u3083\u3093\\n{\u6D77\u5916|\u304B\u3044\u304C\u3044}\u306E{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306B\u3000{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3057\u305F\u306E\u3088\u306D\u3000",
  "\u304A\u3055\u308F\u304C\u305B{\u59C9\u5F1F|\u304D\u3087\u3046\u3060\u3044}\u304C\\n{\u5E30|\u304B\u3048}\u3063\u3066\u304D\u305F\u3093\u3060\u3063\u3066\uFF1F",
  "{\u7530|\u305F}\u3093\u307C\u306E\u3000{\u7A32|\u3044\u306D}\u304C{\u5B9F|\u307F\u306E}\u3063\u305F\u3089\\n\u304A{\u7C73|\u3053\u3081}\u2026\u2026\u3000\u30E9\u30A4\u30B9\u304C\u3000\u3067\u304D\u308B\u306E\u3088\uFF01",
  "\u30E9\u30A4\u30B9\u3092\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306B\u3000\u306F\u3055\u3080\uFF01\uFF1F\\n\u30AD\u30BF\u30AB\u30DF\u3067\u306F\u3000{\u805E|\u304D}\u304B\u306A\u3044\u3000{\u98DF|\u305F}\u3079{\u65B9|\u304B\u305F}\u3060\u306A",
  "\u3053\u306E{\u6751|\u3080\u3089}\u3000{\u4F55|\u306A\u306B}\u3082\u306A\u3044\u3067\u3057\u3087\uFF1F\\n\u305D\u3053\u304C\u3000\u3044\u3044\u3068\u3053\u306A\u306E\u3055",
  "\u3053\u3053\u306F\u3000\u30B9\u30A4\u30EA\u30E7\u30AF\u30BF\u30A6\u30F3\\n\u30AA\u30E2\u30C6{\u796D|\u307E\u3064}\u308A\u304C\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u3060\u3088\uFF01",
  "{\u9752\u5E74\u56E3|\u305B\u3044\u306D\u3093\u3060\u3093}\u306E\u3000\u307F\u3093\u306A\u3067\u3000{\u796D|\u307E\u3064}\u308A\\n{\u76DB|\u3082}\u308A{\u4E0A|\u3042}\u3052\u3066\u308B\u304B\u3089\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u304F\u308C\u3088\uFF01",
  "\u30AD\u30BF\u30AB\u30DF\u30BB\u30F3\u30BF\u30FC\u3067\\n\u3068\u3082\u3063\u3053\u3055\u307E\u3000{\u898B|\u307F}\u305F\u305C\uFF01\uFF01\\r\\n\u30AD\u30BF\u30AB\u30DF\u3082\u3061\u3000\u3044\u3063\u3071\u3044\u3000{\u98DF|\u304F}\u3063\u3066\u305F\uFF01\uFF01",
  "\u30AA\u30FC\u30AC\u30DD\u30F3\u3055\u307E\u3068\u3000\u306A\u304B\u3088\u304F\u306A\u3063\u305F\\n{\u5B50\u4F9B|\u3053\u3069\u3082}\u304C\u3000\u3044\u308B\u3063\u3066\u3000{\u805E|\u304D}\u3044\u305F\u305C\uFF01\\r\\n\u2026\u2026\u3082\u3057\u304B\u3057\u3066\u3000\u30B9\u30B0\u30EA\u304B\u306A\uFF1F",
  "\u30DC\u30AF\u3000\u30A4\u30A4\u30CD\u30A4\u30CC\u3055\u307E\u3000{\u597D|\u3059}\u304D\uFF01\\n{\u7DD1\u8272|\u307F\u3069\u308A\u3044\u308D}\u306A\u3068\u3053\u304C\u3000\u3044\u3044\u3088\u306D\u30FC\uFF01",
  "{\u672C\u7269|\u307B\u3093\u3082\u306E}\u306E\u3000\u30A4\u30A4\u30CD\u30A4\u30CC\u3055\u307E\uFF01\\n\u304A{\u9762|\u3081\u3093}\u307B\u3069\u3000{\u7DD1\u8272|\u307F\u3069\u308A\u3044\u308D}\u3058\u3083\u3000\u306A\u304B\u3063\u305F\u3088\uFF01\uFF01",
  "\u30AA\u30FC\u30AC\u30DD\u30F3\u3055\u307E\u306F\u3000\u304A{\u9762|\u3081\u3093}\u3082\\n{\u672C\u7269|\u307B\u3093\u3082\u306E}\u3082\u3000{\u7DD1\u8272|\u307F\u3069\u308A\u3044\u308D}\u3067\u3000\u3044\u3044\u3088\u306D\uFF01",
  "\u30D5\u30EB\u30FC\u30C4{\u98F4\u5C4B|\u3042\u3081\u3084}\u306E\u3000\u308A\u3093\u3054\u3042\u3081\uFF01\\c\\n\u30A2\u30C3\u30D7\u30EB\u30D2\u30EB\u30BA\u3067\u3000{\u63A1|\u3068}\u308C\u305F\u3066\u306E\\n\u308A\u3093\u3054\u3092\u3000\u307E\u308B\u3054\u3068\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\u306E\u3088\uFF01",
  "\u300E\u30AA\u30E2\u30C6\u300F\u306B\u306F\u3000\u304A{\u9762|\u3081\u3093}\u3068\u3044\u3046\u3000{\u610F\u5473|\u3044\u307F}\u3082\u3042\u308B\\n\u3060\u304B\u3089\u3000\u304A{\u9762|\u3081\u3093}\u3092\u304B\u3076\u308B\u3000{\u796D|\u307E\u3064}\u308A\u306A\u306E\u304B\u306A\u3041",
  "\u30AD\u30D3\u30AD\u30D3\uFF01",
  "\u30AD\u3000\u30AD\u30D3\u3000\u30AD\u3000\u30AD\u30D3",
  "\u30AD\u30D3\u3000\u30AD\u30D3\u2026\u2026\\n\u30AD\u2026\u2026\u3000\u30D3\u2026\u2026"
]
