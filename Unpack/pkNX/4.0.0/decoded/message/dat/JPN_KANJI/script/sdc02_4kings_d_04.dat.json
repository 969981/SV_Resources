[
  "\u3048\u30FC\u3063\u3068\\n\u3053\u306E\u3078\u3093\u3067\u3000\u3044\u3063\u304B\u3041[VAR 0114(004A)]",
  "[VAR 0100(0000)]\u304C\u3000{\u6226|\u305F\u305F\u304B}\u3046{\u59FF|\u3059\u304C\u305F}\u2026\u2026[VAR 0114(004A)]",
  "\u305D\u3046\u3044\u3084\u3000\u30B3\u30FC\u30C8\u306E\u3000{\u5916|\u305D\u3068}\u304B\u3089\u3057\u304B\\n{\u898B|\u307F}\u305F\u3053\u3068\u3000\u306A\u304B\u3063\u305F\u3063\u3051\u304B[VAR 0114(004A)]",
  "\u3053\u3046\u3084\u3063\u3066\\n{\u6B63\u9762|\u3057\u3087\u3046\u3081\u3093}\u3000{\u5207|\u304D}\u3093\u306E\u306F\u3000{\u521D|\u306F\u3058}\u3081\u3066\u3060\u306D\u3043[VAR 0114(004A)]",
  "\u30D6\u30EB\u30D9\u30EA\u30FC\u30B0\u2026\u2026\u3000\u30AD\u30E7\u30FC\u30C0\u30A4\u306B\u3083\\n{\u52DD|\u304B}\u3063\u3066\u3082\u3089\u308F\u306D\u3048\u3068\u3000\u3053\u307E\u308B[VAR 0114(004A)]",
  "\u3053\u307E\u308B\u2026\u2026\\n{\u975E\u5E38|\u3072\u3058\u3087\u3046}\uFF5E\u306B\u3000\u3053\u307E\u308B\uFF01[VAR 0114(004A)]",
  "\u2026\u2026\u3068\u306F\u3000\u3044\u3063\u3066\u3082\u3088[VAR 0114(004A)]",
  "\u3053\u3053\u3067\u3000{\u624B\u629C|\u3066\u306C}\u3044\u305F\u3089\\n\u30AA\u30A4\u30E9\u304C\u3000{\u697D|\u305F\u306E}\u3057\u304F\u306D\u3048\u304B\u3089\u306A\\r\\n\u3061\u3043\u3068\u3000\u3084\u308B{\u6C17|\u304D}\u3000{\u51FA|\u3060}\u3055\u305B\u3066\u3082\u3089\u3046\u305C[VAR 0114(004A)]",
  "\u2026\u2026\u307E\uFF01\\n{\u5805\u82E6|\u304B\u305F\u304F\u308B}\u3057\u3044\u3053\u3068\u3000\u306A\u3093\u3056\u3000\u306D\u3048\u304B[VAR 0114(004A)]",
  "[VAR 0100(0000)]\u306F\u3000\u3044\u3064\u3082\u3069\u304A\u308A\\n{\u6226|\u305F\u305F\u304B}\u3063\u3066\u304F\u308C\u308A\u3083\u3042\u3000\u3044\u3044\u306E\u3088[VAR 0114(004A)]",
  "\u30C4\u30D0\u3063\u3055\u3093{\u7684|\u3066\u304D}\u306B\u306F\\n\u30BE\u30AF\u30BE\u30AF\u3057\u3066\u308B\u305C[VAR 0114(004A)]",
  "\u305D\u3044\u3058\u3083\u3042\\n\u307C\u3061\u307C\u3061\u3000{\u59CB|\u306F\u3058}\u3081\u3063\u304B\u3043[VAR 0114(004A)]",
  "{\u697D|\u305F\u306E}\u3057\u304F\u3000\u3084\u308D\u3046\u305C\\n\u30AD\u30E7\u30FC\u30C0\u30A4\uFF01[VAR 0114(004A)]",
  "\u3078\u3063\u3078\u3063\u3078\uFF01\\n\u3079\u3089\u307C\u3046\u306B\u3000{\u697D|\u305F\u306E}\u3057\u304B\u3063\u305F\u306A\u3042[VAR 0114(004A)]",
  "[VAR 0100(0000)]\u2026\u2026\u3000\u30AD\u30E7\u30FC\u30C0\u30A4\u3092\\n\u30EA\u30FC\u30B0{\u90E8|\u3076}\u3000{\u8A98|\u3055\u305D}\u3063\u3066\u3000\u3088\u304B\u3063\u305F\u305C\u3043[VAR 0114(004A)]",
  "\u30AA\u30A4\u30E9\u306B\u3000{\u52DD|\u304B}\u3063\u305F\u304B\u3089\u306B\u3083\u3042\\n{\u6B63\u5F0F\u5165\u90E8|\u305B\u3044\u3057\u304D\u306B\u3085\u3046\u3076}\u3000\u3059\u308B\u3063\u304D\u3083\u306D\u3048\u306A\uFF01\\r\\n\u306A\uFF01\uFF1F\u3000\u3044\u3044\u3060\u308D\u3043\uFF01\uFF1F[VAR 0114(004A)]",
  "\u3078\u3063\u3078\u3063\u3078\uFF01\\n{\u6C17\u524D|\u304D\u307E\u3048}\u3000\u3044\u3044\u306A\uFF01[VAR 0114(004A)]",
  "\u30B1\u30C1\u30B1\u30C1\u3057\u306A\u3055\u3093\u306A\u3063\u3066\uFF01\\n{\u53E3|\u304F\u3061}\u3067\u306F\u3000\u305D\u3046{\u8A00|\u3044}\u3063\u3066\u3082\\r\\n{\u672C\u5FC3|\u307B\u3093\u3057\u3093}\u306F\u2026\u2026\u3000\u3060\u308D\u3043\uFF01\uFF1F[VAR 0114(004A)]",
  "\u305D\u3044\u3058\u3083\u3000{\u90E8\u54E1\u540D\u7C3F|\u3076\u3044\u3093\u3081\u3044\u307C}\u3067\u3000{\u4F7F|\u3064\u304B}\u3046\\n{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3000{\u64AE|\u3068}\u308B\u3068\u3059\u3063\u304B\u3043\uFF01[VAR 0114(004A)]",
  "\u2026\u2026{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3000\u306F\u3063\u3061\u3083\u3051\u3059\u304E\u3063\u3066\\n\u30BF\u30ED\u306B\u3000{\u6012|\u304A\u3053}\u3089\u308C\u305D\u3046\u3060\u306A[VAR 0114(004A)]",
  "\u3042\u3068\u2026\u2026\u3000\u306A\u3093\u304B\u3000\u3042\u3063\u305F\u306A[VAR 0114(004A)]",
  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u3000{\u8CA0|\u307E}\u304B\u3057\u305F\u3084\u3064\u306B\u3083\\n\u308F\u3056\u30DE\u30B7\u30F3\u3000\u3084\u308B\u3093\u3060\u3063\u305F\u304B\uFF1F[VAR 0114(004A)]",
  "{\u6301|\u3082}\u3061{\u5408|\u3042}\u308F\u305B\u304C\u3000\u306D\u3048\u304B\u3089\\n\u3061\u3087\u3044\u3068\u3000{\u5F85|\u307E}\u3063\u3066\u306A[VAR 0114(004A)]",
  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u3000\u30AB\u30AD\u30C4\u30D0\u30BF\u306B\\n{\u52DD\u5229|\u3057\u3087\u3046\u308A}\u3000\u304A\u3081\u3067\u3068\u3046\uFF01"
]
