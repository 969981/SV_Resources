[
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF01\\n{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000\u3084\u3063\u3066\u3044\u304F\u305E\uFF01[VAR 0114(0024)]",
  "\u3053\u306E{\u524D|\u307E\u3048}\u3000{\u6559|\u304A\u3057}\u3048\u305F\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\uFF01\\n\u307F\u3093\u306A\u306F\u3000{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3057\u3066\u3044\u308B\u304B\u306A\uFF01[VAR 0114(0024)]",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u5F37\u6575|\u304D\u3087\u3046\u3066\u304D}\u3060\uFF01\\n{\u96E3\u6613\u5EA6|\u306A\u3093\u3044\u3069}\u306E{\u9AD8|\u305F\u304B}\u3044\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u3060\u3068\u3000\u3055\u3089\u306B\\r\\n{\u624B|\u3066}\u3054\u308F\u3044{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u3092\u3000\u3057\u304B\u3051\u3066\u304F\u308B\u305E[VAR 0114(0024)]",
  "\u305D\u306E{\u540D|\u306A}\u3082\u3000[VAR FF00(0006)]\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9[VAR FF00(0000)]\uFF01[VAR 0114(0024)]",
  "{\u76F8\u624B|\u3042\u3044\u3066}\u304C\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9\u3092\u3000{\u5C55\u958B|\u3066\u3093\u304B\u3044}\u3057\u3066\u308B\u3068[VAR 0114(0024)]",
  "{\u4E0E|\u3042\u305F}\u3048\u308B\u3000\u30C0\u30E1\u30FC\u30B8\u304C\\n{\u5927|\u304A\u304A}\u304D\u304F\u3000{\u6E1B|\u3078}\u3063\u3066\u3057\u307E\u3046\u3093\u3060\uFF01[VAR 0114(0024)]",
  "\u305D\u308C\u304C\u3000{\u767A\u52D5|\u306F\u3064\u3069\u3046}\u3055\u308C\u308C\u3070\u3000{\u6700\u5F8C|\u3055\u3044\u3054}\u2026\u2026[VAR 0114(0024)]",
  "{\u6211\u3005|\u308F\u308C\u308F\u308C}\u306F\u3000\u306A\u3059\u3059\u3079\u3082\u3000\u306A\u304F\\n{\u8CA0|\u307E}\u3051\u3066\u3057\u307E\u3046\u3000\u304B\u3082\u3057\u308C\u306A\u3044\u2026\u2026\uFF01[VAR 0114(0024)]",
  "\u3053\u3053\u3067\u3000{\u554F\u984C|\u3082\u3093\u3060\u3044}\uFF01[VAR 0114(0024)]",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9\u3092\u3000{\u5C55\u958B|\u3066\u3093\u304B\u3044}\u3055\u308C\u305F\u3089\\n\u308F\u305F\u3057\u305F\u3061\u306F\u3000\u3069\u3046\u3059\u308C\u3070\u3000\u3044\u3044\u3093\u3060\uFF01\uFF1F[VAR 0114(0024)]",
  "\u305D\u3063\u3068{\u76EE|\u3081}\u3092{\u9589|\u3068}\u3058\u308B",
  "{\u5BB6|\u3044\u3048}\u306B{\u96FB\u8A71|\u3067\u3093\u308F}\u3059\u308B",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u3067{\u653B\u6483|\u3053\u3046\u3052\u304D}",
  "\u304A\u3044\u304A\u3044\u3000{\u6700\u671F|\u3055\u3044\u3054}\u3092\\n{\u53D7|\u3046}\u3051{\u5165|\u3044}\u308C\u308B\u3093\u3058\u3083\u306A\u3044\uFF01\\r\\n\u3042\u304C\u3051\u3070\u3000{\u7A81\u7834\u53E3|\u3068\u3063\u3071\u3053\u3046}\u304C\u3000{\u958B|\u3072\u3089}\u3051\u308B\u306F\u305A\u3060\uFF01[VAR 0114(0024)]",
  "\u304A\u3044\u304A\u3044\u3000{\u6700\u671F|\u3055\u3044\u3054}\u3092\u3000\u3055\u3068\u3063\u3066\\n{\u5BB6\u65CF|\u304B\u305E\u304F}\u3068\u3000{\u8A71|\u306F\u306A}\u3059\u3093\u3058\u3083\u306A\u3044\uFF01\\r\\n\u3042\u304C\u3051\u3070\u3000{\u7A81\u7834\u53E3|\u3068\u3063\u3071\u3053\u3046}\u304C\u3000{\u958B|\u3072\u3089}\u3051\u308B\u306F\u305A\u3060\uFF01[VAR 0114(0024)]",
  "{\u6B63|\u305F\u3060}\u3057\u3044{\u7B54|\u3053\u305F}\u3048\u3060\uFF01\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306F\\n\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3000\u30DE\u30B9\u30BF\u30FC\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9{\u4E2D|\u3061\u3085\u3046}\u306E\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u306B\u306F\\n{\u901A\u5E38|\u3064\u3046\u3058\u3087\u3046}\u306E{\u653B\u6483|\u3053\u3046\u3052\u304D}\u306F\u3000\u3042\u307E\u308A\u3000{\u52B9|\u304D}\u304B\u306A\u3044\uFF01[VAR 0114(0024)]",
  "\u3057\u304B\u3057\u3000\u3053\u3061\u3089\u3082\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3057\u3066\\n{\u653B\u6483|\u3053\u3046\u3052\u304D}\u3059\u308C\u3070\u3000{\u6709\u52B9|\u3086\u3046\u3053\u3046}\u306A{\u624B\u6BB5|\u3057\u3085\u3060\u3093}\u3000\u3068\u306A\u308B\uFF01\\c\\n\u30C6\u30E9\u30B9\u30BF\u30A4\u30D7\u306E{\u6280|\u308F\u3056}\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3053\u3068\u3067\\n\u3055\u3089\u306B\u3000{\u5927|\u3060\u3044}\u30C0\u30E1\u30FC\u30B8\u3060\uFF01[VAR 0114(0024)]",
  "\u30C0\u30E1\u30FC\u30B8\u3092\u3000{\u4E0E|\u3042\u305F}\u3048{\u7D9A|\u3064\u3065}\u3051\u308C\u3070\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9\u3092\u3000{\u7834\u58CA|\u306F\u304B\u3044}\u3067\u304D\\r\\n{\u76F8\u624B|\u3042\u3044\u3066}\u306E{\u4F53\u52E2|\u305F\u3044\u305B\u3044}\u3092\u3000\u304F\u305A\u3059\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u305E\uFF01[VAR 0114(0024)]",
  "\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB{\u4E2D|\u3061\u3085\u3046}\u306F\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u3059\u308B\u3000\u30BF\u30A4\u30DF\u30F3\u30B0\u3082\\r\\n{\u91CD\u8981|\u3058\u3085\u3046\u3088\u3046}\u3068\u3000\u306A\u3063\u3066\u304F\u308B\u308F\u3051\u3060\u306A[VAR 0114(0024)]",
  "{\u7D50\u8AD6|\u3051\u3064\u308D\u3093}\uFF01\uFF01[VAR 0114(0024)]",
  "{\u76EE|\u3081}\u306B\u306F\u3000{\u76EE|\u3081}\u3092\uFF01\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u306B\u306F\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3092\uFF01[VAR 0114(0024)]",
  "\u305C\u3072\u3000{\u4EF2\u9593|\u306A\u304B\u307E}\u3068\u3000{\u606F|\u3044\u304D}\u3092{\u5408|\u3042}\u308F\u305B\u3066\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30B7\u30FC\u30EB\u30C9\u3092\u3000{\u6253|\u3046}\u3061{\u7834|\u3084\u3076}\u3063\u3066\u304F\u308C[VAR 0114(0024)]",
  "\u30E0\u30E0\uFF01\u3000{\u4F53|\u304B\u3089\u3060}\u3067\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3082\u3089\u304A\u3046\u3068\\n{\u601D|\u304A\u3082}\u3063\u305F\u304C\u3000\u3082\u3046{\u6642\u9593|\u3058\u304B\u3093}\u304B\u2026\u2026[VAR 0114(0024)]",
