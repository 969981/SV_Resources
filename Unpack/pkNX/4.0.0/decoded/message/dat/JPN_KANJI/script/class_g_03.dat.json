[
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3000\u30B9\u30DE\u30DB\u3092\u3000\u3057\u307E\u3044\u305F\u307E\u3048\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3088\u3046[VAR 0114(0029)]",
  "{\u524D|\u307E\u3048}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u306F\u3000\uFF28\uFF30\u306E\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u306B\u3064\u3044\u3066\\n{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3092\u3000\u3055\u305B\u3066\u3082\u3089\u3063\u305F\u304C\u2026\u2026[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306E\u3042\u3068\u3000{\u4E00\u90E8|\u3044\u3061\u3076}\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u304B\u3089\\n[VAR FF00(0006)]\uFF30\uFF30\uFF08\u30D1\u30EF\u30FC\u30DD\u30A4\u30F3\u30C8\uFF09[VAR FF00(0000)]\u306B\u3064\u3044\u3066\u3000{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u3055\u308C\u305F[VAR 0114(0029)]",
  "\uFF28\uFF30\u304C\u3000\u306A\u304F\u306A\u308B\u3068\u3000\u3072\u3093\u3057{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u306B\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3053\u3068\u304C\u3000\u3067\u304D\u306A\u304F\u306A\u308B[VAR 0114(0029)]",
  "\u305D\u308C\u3067\u306F\u3000\uFF30\uFF30\u304C\u3000\u306A\u304F\u306A\u308B\u3068\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u3069\u3046\u306A\u3063\u3066\u3057\u307E\u3046\u306E\u3060\uFF1F[VAR 0114(0029)]",
  "{\u6280|\u308F\u3056}\u304C{\u51FA|\u3060}\u305B\u306A\u304F\u306A\u308B",
  "\u3044\u3046\u3053\u3068\u3092\u304D\u304B\u306A\u304F\u306A\u308B",
  "\u3059\u3079\u3066\u306E{\u80FD\u529B|\u306E\u3046\u308A\u3087\u304F}\u304C{\u4E0B|\u3055}\u304C\u308B",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\u3060\\n{\u8EAB|\u307F}\u3092\u3082\u3063\u3066\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3044\u305F\u306E\u304B\u306A\uFF1F[VAR 0114(0029)]",
  "\u305F\u3057\u304B\u306B\u3000{\u5371\u967A|\u304D\u3051\u3093}\u306A{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u3060\u304C\u3000{\u9055|\u3061\u304C}\u3046\\c\\n\u2026\u2026\u3044\u3046\u3053\u3068\u3092\u3000\u304D\u304F\u304B\u3069\u3046\u304B\u306F\\n\u30B8\u30E0\u30D0\u30C3\u30B8\u306E{\u6570|\u304B\u305A}\u3067\u3000{\u6C7A|\u304D}\u307E\u308B\u306E\u3060\u3088[VAR 0114(0029)]",
  "\u305F\u3057\u304B\u306B\u3000{\u5371\u967A|\u304D\u3051\u3093}\u306A{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u3060\u304C\u3000{\u9055|\u3061\u304C}\u3046\\c\\n\u305D\u3046\u3044\u3063\u305F\u3000\u30D1\u30EF\u30FC\u306E\\n\u30DD\u30A4\u30F3\u30C8\u3067\u306F\u3000\u306A\u3044\u306E\u3060\u3088[VAR 0114(0029)]",
  "\uFF30\uFF30\u304C\u3000\u306A\u304F\u306A\u308C\u3070\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n{\u6280|\u308F\u3056}\u304C\u3000{\u51FA|\u3060}\u305B\u306A\u304F\u306A\u308B\u306E\u3060[VAR 0114(0029)]",
  "\uFF30\uFF30\u306F\u3000{\u6280|\u308F\u3056}\u3054\u3068\u306B\u3000{\u9055|\u3061\u304C}\u3046\u306E\u3067\\n{\u540C|\u304A\u306A}\u3058{\u6280|\u308F\u3056}\u3070\u304B\u308A\u3000{\u4F7F|\u3064\u304B}\u308F\u305A\\r\\n{\u5206\u6563|\u3076\u3093\u3055\u3093}\u3055\u305B\u308B\u3068\u3000{\u6E1B|\u3078}\u308A\u306B\u304F\u304F\u306A\u308B[VAR 0114(0029)]",
  "\u3059\u3079\u3066\u306E{\u6280|\u308F\u3056}\u306E\u3000\uFF30\uFF30\u304C\u3000\u306A\u304F\u306A\u308B\u3068\\n{\u81EA\u8EAB|\u3058\u3057\u3093}\u306B\u3082\u3000\u30C0\u30E1\u30FC\u30B8\u3092\u3000{\u53D7|\u3046}\u3051\u308B\\r\\n\u308F\u308B\u3042\u304C\u304D\u3000\u3068\u3044\u3046{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u3057\u304B\u3000\u3067\u304D\u306A\u304F\u306A\u308B[VAR 0114(0029)]",
  "\u305D\u3046\u306A\u3089\u306A\u3044\u3088\u3046\u3000\uFF30\uFF30\u3082\u3000\uFF28\uFF30\u3068\u3000{\u540C\u69D8|\u3069\u3046\u3088\u3046}\u306B\\n\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3067\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3059\u308B\u3053\u3068[VAR 0114(0029)]",
  "\u30D4\u30FC\u30D4\u30FC\u30A8\u30A4\u30C9\u3084\u3000\u30D4\u30FC\u30D4\u30FC\u30EA\u30AB\u30D0\u30FC\u306A\u3069\\n\uFF30\uFF30\u3092\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3059\u308B\u3000{\u9053\u5177|\u3069\u3046\u3050}\u3082\u3000\u3042\u308B\\r\\n{\u540D\u524D|\u306A\u307E\u3048}\u306B\u3000\u30D4\u30FC\u30D4\u30FC\u3068\u3000{\u5165|\u306F\u3044}\u3063\u3066\u308B\u306E\u304C\u3000{\u7279\u5FB4|\u3068\u304F\u3061\u3087\u3046}\u3060[VAR 0114(0029)]",
  "\u305F\u3060\u3057\u3000\u304A{\u5E97|\u307F\u305B}\u3067\u306F\u3000{\u58F2|\u3046}\u3063\u3066\u3044\u306A\u3044\u306E\u3067\\n\u3082\u3057\u3000{\u898B|\u307F}\u3064\u3051\u305F{\u5834\u5408|\u3070\u3042\u3044}\u306F\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306B{\u4F7F|\u3064\u304B}\u3046\u3088\u3046\u306B[VAR 0114(0029)]",
  "{\u5F37|\u3064\u3088}\u3044{\u6280|\u308F\u3056}\u307B\u3069\u3000{\u6700\u5927|\u3055\u3044\u3060\u3044}\uFF30\uFF30\u304C\u3000{\u5C11|\u3059\u304F}\u306A\u3044\u306E\u3067\\n{\u7121\u99C4\u6483|\u3080\u3060\u3046}\u3061\u3059\u308B\u3068\u3000\u3059\u3050\u306B\u3000{\u67AF\u6E07|\u3053\u304B\u3064}\u3057\u3066\u3057\u307E\u3046\\r\\n{\u6280|\u308F\u3056}\u306E\u30D0\u30E9\u30F3\u30B9\u3082\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306B\u306A\u3063\u3066\u304F\u308B\u306A[VAR 0114(0029)]",
  "\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3059\u308B\u306B\u3000\u3042\u305F\u3063\u3066\\n{\u6C17|\u304D}\u306B\u3059\u3079\u304D\u306F\u3000\uFF28\uFF30\u3060\u3051\u3067\u306F\u3000\u306A\u3044[VAR 0114(0029)]",
  "\u30D1\u30FC\u30C8\u30CA\u30FC\u304C\u3000{\u6700\u826F|\u3055\u3044\u308A\u3087\u3046}\u306E\\n\u30D1\u30D5\u30A9\u30FC\u30DE\u30F3\u30B9\u3092\u3000{\u51FA|\u3060}\u305B\u308B\u3088\u3046\u3000{\u6C17|\u304D}\u3092{\u914D|\u304F\u3070}\u3063\u3066\\r\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3092\u3000{\u7D9A|\u3064\u3065}\u3051\u3066\u307B\u3057\u3044[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n{\u6B21\u56DE|\u3058\u304B\u3044}\u306F\u3000{\u8A66\u9A13|\u3057\u3051\u3093}\u306E{\u65E5|\u3072}\u3060\u306A\\r\\n\u3057\u3063\u304B\u308A\u3068\u3000{\u5FA9\u7FD2|\u3075\u304F\u3057\u3085\u3046}\u3057\u3066\u304A\u304F\u3088\u3046\u306B[VAR 0114(0029)]"
]
