[
  "{\u521D|\u306F\u3058}\u3081\u307E\u3057\u3066\\n{\u6570\u5B66|\u3059\u3046\u304C\u304F}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u30BF\u30A4\u30E0\u3067\u3059[VAR 0114(0025)]",
