  "{\u597D|\u3059}\u304D\u306A{\u4EBA|\u3072\u3068}\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u306A{\u4EBA|\u3072\u3068}\\n\u3044\u308D\u3093\u306A{\u4EBA|\u3072\u3068}\u304C\u3044\u3066\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u306D[VAR 0114(0025)]",
  "\u3067\u3082\u3000\u3069\u3093\u306A{\u4EBA|\u3072\u3068}\u3067\u3082\u3000{\u5B89\u5FC3|\u3042\u3093\u3057\u3093}\u3057\u3066\\c\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3000{\u697D|\u305F\u306E}\u3057\u307F\u306A\u304C\u3089\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u304D\u307E\u3057\u3087\u3046\u30FC\uFF01[VAR 0114(0025)]",
  "\u305D\u3046\u3044\u3048\u3070\u3000\u307F\u306A\u3055\u3093\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u30BF\u30A4\u30D7{\u76F8\u6027|\u3042\u3044\u3057\u3087\u3046}\u3063\u3066\u3000\u30D0\u30C3\u30C1\u30EA\u304B\u3057\u3089\uFF1F[VAR 0114(0025)]",
  "\u304F\u3055\u306F\u3000\u307F\u305A\u306B\u3000{\u5F37|\u3064\u3088}\u304F\\n\u307F\u305A\u306F\u3000\u307B\u306E\u304A\u306B\u3000{\u5F37|\u3064\u3088}\u3044\u306E\u3088\u306D\uFF1F[VAR 0114(0025)]",
  "\u30DD\u30B1\u30E2\u30F3\u3000{\u5F97\u610F|\u3068\u304F\u3044}\u305D\u3046\u306A\u3000[VAR 0100(0000)]\u3055\u3093\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000\u305C\u3072\u3000{\u6559|\u304A\u3057}\u3048\u3066\u307B\u3057\u3044\u308F[VAR 0114(0025)]",
  "\u307B\u306E\u304A\u306B\u3000{\u5F37|\u3064\u3088}\u3044\u3000\u307F\u305A\u30BF\u30A4\u30D7\u306E{\u6280|\u308F\u3056}\\n\u307F\u305A\u3067\u3063\u307D\u3046\u3092\u3000\u307B\u306E\u304A\u30DD\u30B1\u30E2\u30F3\u306B\\r\\n\u3042\u3066\u308B\u3068\u3000\u30C0\u30E1\u30FC\u30B8\u306F\u3000\u3069\u3046\u306A\u308B\u3067\u3057\u3087\u3046\uFF1F[VAR 0114(0025)]",
  "{\u534A\u5206|\u306F\u3093\u3076\u3093}\u306B\u306A\u308B",
  "{\u5909|\u304B}\u308F\u3089\u306A\u3044",
  "\uFF12{\u500D|\u3070\u3044}\u306B\u306A\u308B",
  "\u3042\u3089\u3000{\u9006\u8EE2|\u304E\u3083\u304F\u3066\u3093}\u306E{\u767A\u60F3|\u306F\u3063\u305D\u3046}\u306D\uFF01\\n\u3067\u3082\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u306A\u3082\u306E\u3092\u3000\u3076\u3064\u3051\u3089\u308C\u308B\u3068\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306F\u3000\u3061\u3087\u3063\u3068\u3000\u3064\u3089\u3044\u304B\u3082\uFF1F[VAR 0114(0025)]",
  "[VAR 0100(0000)]\u3055\u3093\u306F\u3000{\u6211\u6162\u5F37|\u304C\u307E\u3093\u3065\u3088}\u3044\u306E\u306D\\n\u3067\u3082\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u306A\u3082\u306E\u3092\u3000\u3076\u3064\u3051\u3089\u308C\u308B\u3068\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306F\u3000\u3061\u3087\u3063\u3068\u3000\u3064\u3089\u3044\u304B\u3082\uFF1F[VAR 0114(0025)]",
  "\u306F\u3044\u3000\u3088\u304F\u3067\u304D\u307E\u3057\u305F\uFF01\\n\u3055\u3059\u304C\u3000[VAR 0100(0000)]\u3055\u3093\uFF01[VAR 0114(0025)]",
  "{\u76F8\u624B|\u3042\u3044\u3066}\u306B\u3068\u3063\u3066\u3000{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u306E\u30BF\u30A4\u30D7{\u6280|\u308F\u3056}\u3092\\n\u304F\u308A\u3060\u305B\u3070\u3000{\u52B9\u679C|\u3053\u3046\u304B}\u306F\u3000\u30D0\u30C4\u30B0\u30F3\uFF01\\r\\n\u30C0\u30E1\u30FC\u30B8\u304C\u3000\uFF12{\u500D|\u3070\u3044}\u306B\u3000\u306A\u308A\u307E\u3059[VAR 0114(0025)]",
  "{\u9006|\u304E\u3083\u304F}\u306B\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u304C\u3000{\u5F97\u610F|\u3068\u304F\u3044}\u306A\u30BF\u30A4\u30D7\u3060\u3068\\n{\u52B9\u679C|\u3053\u3046\u304B}\u306F\u3000{\u4ECA|\u3044\u307E}\u3072\u3068\u3064\u2026\u2026\\r\\n\u30C0\u30E1\u30FC\u30B8\u306F\u3000{\u534A\u5206|\u306F\u3093\u3076\u3093}\u306B\u3000\u306A\u3063\u3061\u3083\u3044\u307E\u3059[VAR 0114(0025)]",
  "\u3046\u3075\u3075\uFF01\u3000\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\u3063\u307D\u304F\u3066\\n\u30AD\u30CF\u30C0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u306F\u3000\u3061\u3087\u3063\u3068\u3000{\u60AA|\u308F\u308B}\u3044\u3051\u3069\\r\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000{\u4F8B|\u308C\u3044}\u306B\u3059\u308C\u3070[VAR 0114(0025)]",
  "\u3061\u3087\u3063\u3074\u308A{\u82E6\u624B|\u306B\u304C\u3066}\u306A\u3000{\u6570\u5B66|\u3059\u3046\u304C\u304F}\u3082\\n\u307F\u3093\u306A\u3067\u3000{\u697D|\u305F\u306E}\u3057\u304F\u3067\u304D\u3061\u3083\u3046\u308F\u3088\u306D[VAR 0114(0025)]",
  "\u3042\u3089\u3000\u30C1\u30E3\u30A4\u30E0\uFF1F\\n\u3082\u3046{\u7D42|\u304A}\u308F\u308A\u306A\u306E\u306D\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\u2026\u2026[VAR 0114(0025)]",
  "{\u6B21\u56DE|\u3058\u304B\u3044}\u3082\u3000\u307F\u306A\u3055\u3093\u3068\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3067\u304D\u308B\u306E\u3092\\n{\u5FC3\u5F85|\u3053\u3053\u308D\u307E}\u3061\u306B\u3000\u3057\u3066\u3044\u307E\u3059\u306D[VAR 0114(0025)]"
