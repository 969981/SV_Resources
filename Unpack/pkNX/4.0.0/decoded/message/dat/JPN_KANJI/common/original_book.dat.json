  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u602A\u7269",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306B\u306F\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306A\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u751F\u606F|\u305B\u3044\u305D\u304F}\u3057\u3066\u3044\u308B\u3002\\n{\u4E0B|\u3057\u305F}\u306B\u3000{\u884C|\u3044}\u304F\u306B\u3064\u308C\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u304B\\n\u3069\u3046\u304B\u3082\u3000\u308F\u304B\u3089\u306A\u3044\u3088\u3046\u306A\\n{\u5DE8\u5927|\u304D\u3087\u3060\u3044}\u3067\u3000{\u51F6\u66B4|\u304D\u3087\u3046\u307C\u3046}\u306A{\u751F\u7269|\u305B\u3044\u3076\u3064}\u304C\\n\u305D\u306E{\u59FF|\u3059\u304C\u305F}\u3092\u3000{\u898B|\u307F}\u305B{\u59CB|\u306F\u3058}\u3081\u308B\u3002\\n{\u5F7C|\u304B\u308C}\u3089\u306E{\u731B\u653B|\u3082\u3046\u3053\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u305F\u3053\u3068\u3067\\n{\u968A\u54E1|\u305F\u3044\u3044\u3093}\u304C\u3000{\u81F4\u547D\u50B7|\u3061\u3081\u3044\u3057\u3087\u3046}\u3092\u3000{\u8CA0|\u304A}\u3044\\n{\u4E00\u6642|\u3044\u3061\u3058}\u3000{\u9000\u5374|\u305F\u3044\u304D\u3083\u304F}\u3059\u308B\u3053\u3068\u3068\u3000\u306A\u3063\u305F\u3002",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u602A\u7269",
  "{\u89B3\u6E2C\u968A|\u304B\u3093\u305D\u304F\u305F\u3044}\u306E\u3000\u3072\u3068\u308A\u304C\\n{\u5076\u7136|\u3050\u3046\u305C\u3093}\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3057\u305F\u3000{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3002\\n\u30C9\u30F3\u30D5\u30A1\u30F3\u3068\u3044\u3046\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u4F3C|\u306B}\u3066\u3044\u308B\u3088\u3046\u306A{\u6C17|\u304D}\u304C\u3000\u3059\u308B\u304C\\n{\u4F53|\u304B\u3089\u3060}\u306E{\u5927|\u304A\u304A}\u304D\u3055\u3084\u3000{\u80CC\u4E2D|\u305B\u306A\u304B}\u306E{\u5F62|\u304B\u305F\u3061}\u306A\u3069\\n{\u751F\u7269\u7684|\u305B\u3044\u3076\u3064\u3066\u304D}\u306B\u3000\u307E\u3063\u305F\u304F\u3000{\u7570|\u3053\u3068}\u306A\u308B\u3002\\n\u306A\u3093\u3068\u3000{\u5049\u5927|\u3044\u3060\u3044}\u306A{\u7259|\u304D\u3070}\u3067\u3000\u3042\u308D\u3046\u304B\u3002",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u602A\u7269",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306B\u306F\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306A\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u751F\u606F|\u305B\u3044\u305D\u304F}\u3057\u3066\u3044\u308B\u3002\\n{\u4E0B|\u3057\u305F}\u306B\u3000{\u884C|\u3044}\u304F\u306B\u3064\u308C\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u304B\\n\u3069\u3046\u304B\u3082\u3000\u308F\u304B\u3089\u306A\u3044\u3088\u3046\u306A\\n{\u5C0F\u578B|\u3053\u304C\u305F}\u3067\u3000{\u6B8B\u9177|\u3056\u3093\u3053\u304F}\u306A{\u751F\u7269|\u305B\u3044\u3076\u3064}\u304C\\n\u305D\u306E{\u59FF|\u3059\u304C\u305F}\u3092\u3000{\u898B|\u307F}\u305B{\u59CB|\u306F\u3058}\u3081\u308B\u3002\\n{\u5F7C|\u304B\u308C}\u3089\u306E{\u731B\u653B|\u3082\u3046\u3053\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u305F\u3053\u3068\u3067\\n{\u968A\u54E1|\u305F\u3044\u3044\u3093}\u304C\u3000{\u81F4\u547D\u50B7|\u3061\u3081\u3044\u3057\u3087\u3046}\u3092\u3000{\u8CA0|\u304A}\u3044\\n{\u4E00\u6642|\u3044\u3061\u3058}\u3000{\u9000\u5374|\u305F\u3044\u304D\u3083\u304F}\u3059\u308B\u3053\u3068\u3068\u3000\u306A\u3063\u305F\u3002",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u602A\u7269",
  "{\u89B3\u6E2C\u968A|\u304B\u3093\u305D\u304F\u305F\u3044}\u306E\u3000\u3072\u3068\u308A\u304C\\n{\u5076\u7136|\u3050\u3046\u305C\u3093}\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3057\u305F\u3000{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3002\\n\u30C9\u30F3\u30D5\u30A1\u30F3\u3068\u3044\u3046\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u4F3C|\u306B}\u3066\u3044\u308B\u3088\u3046\u306A{\u6C17|\u304D}\u304C\u3000\u3059\u308B\u304C\\n{\u4F53|\u304B\u3089\u3060}\u306E{\u8CEA\u611F|\u3057\u3064\u304B\u3093}\u3084\u3000{\u79FB\u52D5\u65B9\u6CD5|\u3044\u3069\u3046\u307B\u3046\u307B\u3046}\u306A\u3069\\n{\u751F\u7269\u7684|\u305B\u3044\u3076\u3064\u3066\u304D}\u306B\u3000\u307E\u3063\u305F\u304F\u3000{\u7570|\u3053\u3068}\u306A\u308B\u3002\\n\u307E\u308B\u3067\u3000\u3042\u308C\u306F\u3000{\u9244|\u3066\u3064}\u306E{\u8F4D|\u308F\u3060\u3061}\u3060\u3002",
  "\u30D1\u30EB\u30C7\u30A2\u306E\u5927\u7A74",
  "{\u89B3\u6E2C\u968A|\u304B\u3093\u305D\u304F\u305F\u3044}\u304C\u3000{\u4FB5\u5165\u5730\u70B9|\u3057\u3093\u306B\u3085\u3046\u3061\u3066\u3093}\u306B\u3066\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3002\\n{\u904B|\u3046\u3093}\u3088\u304F\u3000{\u5929\u5019|\u3066\u3093\u3053\u3046}\u306B\u3000{\u6075|\u3081\u3050}\u307E\u308C\\n{\u9806\u8ABF|\u3058\u3085\u3093\u3061\u3087\u3046}\u306A{\u51FA\u767A|\u3057\u3085\u3063\u3071\u3064}\u3068\u3000\u306A\u3063\u305F\u3002\\n{\u5199\u771F\u5965|\u3057\u3083\u3057\u3093\u304A\u304F}\u306B\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3059\u308B\u3000{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306F\\n{\u9065|\u306F\u308B}\u304B{\u4E0B|\u3057\u305F}\u307E\u3067\u3000{\u7D9A|\u3064\u3065}\u3044\u3066\u3044\u308B\u304C\\n{\u4E0B\u5C64|\u304B\u305D\u3046}\u306B\u306F\u3000{\u96F2|\u304F\u3082}\u304C\u3000{\u767A\u751F|\u306F\u3063\u305B\u3044}\u3057\u3066\u304A\u308A\\n{\u8CA1\u5B9D\u4F1D\u8AAC|\u3056\u3044\u307B\u3046\u3067\u3093\u305B\u3064}\u304C\u3000{\u5642|\u3046\u308F\u3055}\u3055\u308C\u308B\\n{\u6700\u6DF1\u90E8|\u3055\u3044\u3057\u3093\u3076}\u306E{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u306F\u3000\u3067\u304D\u306A\u304B\u3063\u305F\u3002\\n\u3053\u308C\u3088\u308A\u3000{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3092\u3000{\u964D|\u304A}\u308A\u3066\u3044\u304F\u3002",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u5168\u4F53\u56F3",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u3000{\u5185\u90E8|\u306A\u3044\u3076}\u3067\u306F\\n{\u5468\u56F2|\u3057\u3085\u3046\u3044}\u306E\u3000\u3089\u305B\u3093{\u72B6|\u3058\u3087\u3046}\u306E{\u5D16|\u304C\u3051}\u3092\\n\u3064\u305F\u3063\u3066\u3044\u3051\u3070\u3000{\u964D\u4E0B|\u3053\u3046\u304B}\u304C\u3000{\u53EF\u80FD|\u304B\u306E\u3046}\u3002\\n{\u690D\u7269|\u3057\u3087\u304F\u3076\u3064}\u3084\u3000{\u6C34\u6E90|\u3059\u3044\u3052\u3093}\u3082\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3059\u308B\u3002\\n{\u6614|\u3080\u304B\u3057}\u304B\u3089\u3000\u3053\u306E\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\\n{\u6700\u6DF1\u90E8|\u3055\u3044\u3057\u3093\u3076}\u306B\u306F\u3000{\u4F1D\u8AAC|\u3067\u3093\u305B\u3064}\u306E\u304D\u306E\u307F\u3084\\n{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u306A{\u9271\u77F3|\u3053\u3046\u305B\u304D}\u306A\u3069\u304C\u3000{\u7720|\u306D\u3080}\u3063\u3066\u3044\u308B\u3068\\n\u3044\u308F\u308C\u3000\u305D\u308C\u3089\u3092\u3000{\u5B88\u8B77\u8005|\u3057\u3085\u3054\u3057\u3083}\u304C\\n{\u5B88|\u307E\u3082}\u3063\u3066\u3044\u308B\u3068\u3044\u3046\u3000{\u4F1D\u8AAC|\u3067\u3093\u305B\u3064}\u304C\u3042\u308B\u3002",
  "\u8457\u8005\u30D7\u30ED\u30D5\u30A3\u30FC\u30EB",
  "{\u672C\u66F8|\u307B\u3093\u3057\u3087}\u3000\u30B9\u30AB\u30FC\u30EC\u30C3\u30C8\u30D6\u30C3\u30AF\u306E\\n{\u8457\u8005|\u3061\u3087\u3057\u3083}\u3000\u30D8\u30B6\u30FC\u3002\\n{\u76F8\u68D2|\u3042\u3044\u307C\u3046}\u306E\u30E2\u30C8\u30C8\u30AB\u30B2\u3068\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3002\\n{\u4F5C\u5BB6|\u3055\u3063\u304B}\u3067\u3042\u308A\u3000{\u535A\u7269\u5B66|\u306F\u304F\u3076\u3064\u304C\u304F}\u306E{\u7814\u7A76\u8005|\u3051\u3093\u304D\u3085\u3046\u3057\u3083}\u3002\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3092\u3000{\u63A2\u7D22|\u305F\u3093\u3055\u304F}\u3059\u308B\\n\u30A8\u30EA\u30A2\u30BC\u30ED{\u89B3\u6E2C\u968A|\u304B\u3093\u305D\u304F\u305F\u3044}\u306B\u3000{\u9078\u51FA|\u305B\u3093\u3057\u3085\u3064}\u3055\u308C\\n{\u5E30\u9084\u5F8C|\u304D\u304B\u3093\u3054}\u3000{\u672C\u66F8|\u307B\u3093\u3057\u3087}\u3092\u3000{\u57F7\u7B46|\u3057\u3063\u3074\u3064}\u3057\u305F\u3002\\n\u30E2\u30C8\u30C8\u30AB\u30B2\u306F\u3000\u30A8\u30EA\u30A2\u30BC\u30ED{\u89B3\u6E2C\u6642|\u304B\u3093\u305D\u304F\u3058}\\n{\u8377\u7269|\u306B\u3082\u3064}\u306E{\u904B\u642C\u4FC2|\u3046\u3093\u3071\u3093\u304C\u304B\u308A}\u3068\u3057\u3066\u3000{\u6D3B\u8E8D|\u304B\u3064\u3084\u304F}\u3057\u305F\u3002",
  "{\u672C\u66F8|\u307B\u3093\u3057\u3087}\u3000\u30D0\u30A4\u30AA\u30EC\u30C3\u30C8\u30D6\u30C3\u30AF\u306E\\n{\u8457\u8005|\u3061\u3087\u3057\u3083}\u3000\u30D8\u30B6\u30FC\u3002\\n{\u76F8\u68D2|\u3042\u3044\u307C\u3046}\u306E\u30E2\u30C8\u30C8\u30AB\u30B2\u3068\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3002\\n{\u4F5C\u5BB6|\u3055\u3063\u304B}\u3067\u3042\u308A\u3000{\u535A\u7269\u5B66|\u306F\u304F\u3076\u3064\u304C\u304F}\u306E{\u7814\u7A76\u8005|\u3051\u3093\u304D\u3085\u3046\u3057\u3083}\u3002\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3092\u3000{\u63A2\u7D22|\u305F\u3093\u3055\u304F}\u3059\u308B\\n\u30A8\u30EA\u30A2\u30BC\u30ED{\u89B3\u6E2C\u968A|\u304B\u3093\u305D\u304F\u305F\u3044}\u306B\u3000{\u9078\u51FA|\u305B\u3093\u3057\u3085\u3064}\u3055\u308C\\n{\u5E30\u9084\u5F8C|\u304D\u304B\u3093\u3054}\u3000{\u672C\u66F8|\u307B\u3093\u3057\u3087}\u3092\u3000{\u57F7\u7B46|\u3057\u3063\u3074\u3064}\u3057\u305F\u3002\\n\u30E2\u30C8\u30C8\u30AB\u30B2\u306F\u3000\u30A8\u30EA\u30A2\u30BC\u30ED{\u89B3\u6E2C\u6642|\u304B\u3093\u305D\u304F\u3058}\\n{\u8377\u7269|\u306B\u3082\u3064}\u306E{\u904B\u642C\u4FC2|\u3046\u3093\u3071\u3093\u304C\u304B\u308A}\u3068\u3057\u3066\u3000{\u6D3B\u8E8D|\u304B\u3064\u3084\u304F}\u3057\u305F\u3002",
  "\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u5192\u967A",
