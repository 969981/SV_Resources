  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30DD\u30B1\u30E2\u30F3\u304C{\u56F3\u9451|\u305A\u304B\u3093}\u306B{\u8FFD\u52A0|\u3064\u3044\u304B}\u3055\u308C\u307E\u3057\u305F",
  "\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u6B69|\u3042\u308B}\u3044\u3066\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01\\c\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u8349|\u304F\u3055}\u3080\u3089\u3084\u3000{\u6D1E\u7A9F|\u3069\u3046\u304F\u3064}\u3000{\u6D77|\u3046\u307F}\u306A\u3069\\n\u3044\u308D\u3044\u308D\u306A{\u5834\u6240|\u3070\u3057\u3087}\u306B\u3000\u3044\u307E\u3059\u3088\uFF01\\c",
  "\u30C8\u30EC\u30FC\u30CA\u30FC\u3068\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u3053\u3068\u3067\\n{\u76F8\u624B|\u3042\u3044\u3066}\u306E\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6226|\u305F\u305F\u304B}\u3063\u305F\u30DD\u30B1\u30E2\u30F3\u3068\u3057\u3066\\r\\n{\u56F3\u9451|\u305A\u304B\u3093}\u306B\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3059\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\uFF01\\c\\n{\u751F\u606F\u5730|\u305B\u3044\u305D\u304F\u3061}\u304C\u3000\u308F\u304B\u308B\u306E\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u3068\\n{\u51FA\u4F1A|\u3067\u3042}\u3048\u308B{\u5834\u6240|\u3070\u3057\u3087}\u3092\u3000{\u8ABF|\u3057\u3089}\u3079\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\uFF01\\c",
  "{\u8AB0|\u3060\u308C}\u304B\u3068\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\\n{\u56F3\u9451|\u305A\u304B\u3093}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3059\u308B\u306E\u3082\u3000\u304A\u3059\u3059\u3081\u3067\u3059\uFF01\\c\\n\u30DE\u30B8\u30AB\u30EB{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u3000{\u4E16\u754C\u4E2D|\u305B\u304B\u3044\u3058\u3085\u3046}\u306E\\n\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3059\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\uFF01\\c",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3088\u3063\u3066\u3000{\u6D3B\u52D5|\u304B\u3064\u3069\u3046}\u3059\u308B\\n{\u6642\u9593\u5E2F|\u3058\u304B\u3093\u305F\u3044}\u304C\u3000{\u9055|\u3061\u304C}\u3044\u307E\u3059\uFF01\\c\\n{\u540C|\u304A\u306A}\u3058{\u5834\u6240|\u3070\u3057\u3087}\u3067\u3082\u3000{\u671D|\u3042\u3055}\u3000{\u663C|\u3072\u308B}\u3000{\u5915\u65B9|\u3086\u3046\u304C\u305F}\u3000{\u591C|\u3088\u308B}\u3067\\n{\u51FA\u73FE|\u3057\u3085\u3064\u3052\u3093}\u3059\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u5909\u5316|\u3078\u3093\u304B}\u3057\u307E\u3059\u3088\uFF01\\c",
  "{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3053\u3068\u3067\u3000{\u51FA\u4F1A|\u3067\u3042}\u3048\u308B\\n\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u307E\u3059\u3088\uFF01\\c\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6226|\u305F\u305F\u304B}\u308F\u305B\u3066\u3000{\u7D4C\u9A13|\u3051\u3044\u3051\u3093}\u3055\u305B\u305F\u308A\\n{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u305F\u308A\u3000\u3057\u3066\u307F\u307E\u3057\u3087\u3046\\c",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3059\u308B\u3053\u3068\u3067\u3057\u304B\u3000{\u51FA\u4F1A|\u3067\u3042}\u3048\u306A\u3044\\n\u30DD\u30B1\u30E2\u30F3\u3082\u3000{\u6570\u591A|\u304B\u305A\u304A\u304A}\u304F\u3000\u3044\u307E\u3059\uFF01\\c\\n\u3088\u305D\u306E{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u3068\\n\u30DD\u30B1\u30E2\u30F3{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3092\u3000\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01\\c",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u307E\u3067\\n\u3042\u3068{\u5C11|\u3059\u3053}\u3057\u3000\u3067\u3059\u306D\uFF01\\c\\n[VAR 0100(0000)]\u3055\u3093\u306A\u3089\\n\u304D\u3063\u3068\u3000\u3084\u308A\u3068\u3052\u3089\u308C\u307E\u3059\u3088\uFF01\\c",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u306F\\n{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u3057\u3066\u3044\u307E\u3059\uFF01\\c\\n\u3059\u3079\u3066\u306E\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u51FA\u4F1A|\u3067\u3042}\u3063\u305F\\n[VAR 0100(0000)]\u3055\u3093\u306E\u3000\u304C\u3093\u3070\u308A\u306B\\c\\n{\u5FC3|\u3053\u3053\u308D}\u304B\u3089\u3000\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\c",
  "\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u304C\u3000[VAR 0202(0000)]{\u518A|\u3055\u3064}\u306B\u3000\u306A\u308A\u307E\u3057\u305F\uFF01\\c\\n\u304A{\u795D|\u3044\u308F}\u3044\u306B\u3000[VAR 0109(0001)]\u3092\\n[VAR 0202(0002)]{\u500B|\u3053}\u3000\u304A{\u9001|\u304A\u304F}\u308A\u3057\u307E\u3059\u306D\uFF01\\c",
  "\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u304C\u3000[VAR 0202(0000)]{\u518A|\u3055\u3064}\u306B\u3000\u306A\u308A\u307E\u3057\u305F\uFF01\\c\\n\u304A{\u795D|\u3044\u308F}\u3044\u306B\u3000[VAR 0109(0001)]\u3092\\n[VAR 0202(0002)]{\u500B|\u3053}\u3000\u304A{\u9001|\u304A\u304F}\u308A\u3057\u307E\u3059\u306D\uFF01\\c",
