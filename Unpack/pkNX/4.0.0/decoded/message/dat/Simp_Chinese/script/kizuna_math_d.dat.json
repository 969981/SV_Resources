[
  "[VAR 0100(0000)]\uFF01\\n\u4F60\u4E5F\u6765\u5E2E\u6211\u76EF\u4E00\u4E0B\uFF01[VAR 0114(0025)]",
  "\u6211\u6B63\u51C6\u5907\u57CB\u4F0F\u4E4B\u524D\u63D0\u5230\u7684\\n\u90A3\u9053\u76EE\u5149\u7684\u4E3B\u4EBA\uFF01[VAR 0114(0025)]",
  "\u57CB\u4F0F\uFF01\uFF1F",
  "\u4E3A\u4EC0\u4E48\uFF01\uFF1F",
  "\u603B\u662F\u611F\u89C9\u5230\u88AB\u4EBA\u770B\u7740\uFF0C\\n\u6211\u4E5F\u5F88\u4E0D\u723D\u5FEB\u3002[VAR 0114(0025)]",
  "\u800C\u4E14\u90A3\u6B21\u5728\u98DF\u5802\u7684\u65F6\u5019\uFF0C\\n\u6211\u5DF2\u7ECF\u8BB0\u4F4F\u5979\u957F\u4EC0\u4E48\u6837\u5B50\u4E86\uFF01[VAR 0114(0025)]",
  "\u2026\u2026\u554A\uFF01[VAR 0114(0025)]",
  "\u5C31\u662F\u4F60\u6CA1\u9519\u5427\uFF01\\n\u6700\u8FD1\u603B\u662F\u76EF\u7740\u6211\u770B\uFF01[VAR 0114(0025)]",
  "\u6CF0\u3001\u6CF0\u59C6\u5973\u58EB\uFF01\uFF1F\\n\u4F60\u600E\u4E48\u4F1A\u77E5\u9053\u2026\u2026\uFF01\uFF1F",
  "\u5BF9\u3001\u5BF9\u4E0D\u8D77\uFF01\\n\u539F\u6765\u4F60\u5DF2\u7ECF\u5BDF\u89C9\u5230\u4E86\u554A\u3002",
  "\u90A3\u5F53\u7136\u4E86\uFF0C\u4E00\u5929\u5230\u665A\u88AB\u4EBA\u76EF\u7740\u561B\uFF01\\n\u4F60\u662F\u4E0D\u662F\u6709\u4EC0\u4E48\u4E8B\u60F3\u95EE\u6211\u554A\uFF01\uFF1F[VAR 0114(0025)]",
  "\u662F\u3001\u662F\u7684\u2026\u2026",
  "\u6CF0\u59C6\u5973\u58EB\u4F60\u62C5\u4EFB\u9053\u9986\u9986\u4E3B\u7684\u65F6\u5019\uFF0C\\n\u4ECE\u90A3\u65F6\u8D77\u6211\u5C31\u662F\u4F60\u7684\u7C89\u4E1D\uFF01\\r\\n\u6211\u975E\u5E38\u559C\u6B22\u5CA9\u77F3\u5C5E\u6027\u7684\u62DB\u5F0F\uFF01\uFF01",
  "\u54CE\u5440\u3002[VAR 0114(0025)]",
  "\u53EF\u662F\u4E00\u5E74\u534A\u4E4B\u524D\uFF0C\\n\u4F60\u7A81\u7136\u9690\u9000\u4E86\u2026\u2026\\r\\n\u5230\u5E95\u4E3A\u4EC0\u4E48\u8981\u8FD9\u6837\u505A\u5462\uFF1F",
  "\u2026\u2026\u54CE\u5440\uFF0C\\n\u539F\u6765\u4F60\u662F\u60F3\u6253\u542C\u8FD9\u4EF6\u4E8B\u554A\u3002[VAR 0114(0025)]",
  "\u6CF0\u59C6\u5973\u58EB\u9690\u9000\u7684\u539F\u56E0\\n\u6CA1\u6709\u516C\u5F00\u5BA3\u5E03\u2026\u2026",
  "\u800C\u4E14\u5B66\u751F\u4E4B\u95F4\u6D41\u4F20\u7684\u8BF4\u6CD5\u662F\uFF0C\\n\u5C31\u7B97\u53BB\u95EE\u4F60\u4E5F\u4F1A\u88AB\u7CCA\u5F04\u8FC7\u53BB\u2026\u2026",
  "\u6211\u89C9\u5F97\u95EE\u6CF0\u59C6\u5973\u58EB\u4F60\u4E0D\u613F\u610F\\n\u56DE\u7B54\u7684\u95EE\u9898\uFF0C\u662F\u5F88\u6CA1\u793C\u8C8C\u7684\u2026\u2026\\r\\n\u6240\u4EE5\u624D\u63D0\u4E0D\u8D77\u52C7\u6C14\u2026\u2026",
  "\u6240\u4EE5\u624D\u7528\u70ED\u60C5\u4F3C\u706B\u7684\u76EE\u5149\u2026\u2026\\n\u90FD\u662F\u6211\u4E0D\u597D\u3002[VAR 0114(0025)]",
  "\u54A6\uFF1F\u70ED\u60C5\u4F3C\u706B\u2026\u2026\uFF1F",
  "\u554A\uFF0C\u6CA1\u4EC0\u4E48\u2026\u2026\\n\u6211\u8F9E\u53BB\u9053\u9986\u9986\u4E3B\u7684\u539F\u56E0\u554A\uFF0C\\r\\n\u5C31\u662F\u60F3\u4E13\u6CE8\u5728\u6559\u5E08\u4E00\u804C\u4E0A\u3002[VAR 0114(0025)]",
  "\u5E76\u4E0D\u662F\u4E0D\u559C\u6B22\\n\u5F53\u9053\u9986\u9986\u4E3B\u624D\u79BB\u5F00\u7684\u2026\u2026[VAR 0114(0025)]",
  "\u4F46\u4E00\u8BF4\u8D77\u9053\u9986\u7684\u4E8B\u60C5\uFF0C\\n\u53C8\u4F1A\u56E0\u4E3A\u5F88\u6000\u5FF5\u800C\u611F\u5230\u5BC2\u5BDE\u3002[VAR 0114(0025)]",
  "\u6240\u4EE5\u554A\uFF0C\\n\u6211\u624D\u56DE\u907F\u4E86\u5B66\u751F\u7684\u63D0\u95EE\u3002[VAR 0114(0025)]",
  "\u539F\u6765\u662F\u8FD9\u6837\u2026\u2026",
  "\u4F60\u4E0D\u4F1A\u518D\u56DE\u53BB\\n\u5F53\u9053\u9986\u9986\u4E3B\u4E86\u5417\uFF1F",
  "\u55EF\u2026\u2026\u4E0D\u4F1A\u56DE\u53BB\u4E86\u3002[VAR 0114(0025)]",
  "\u5982\u4ECA\u6211\u7684\u59B9\u59B9\\n\u5C3D\u804C\u5C3D\u8D23\u5730\u62C5\u4EFB\u9053\u9986\u9986\u4E3B\u3002[VAR 0114(0025)]",
  "\u6211\u8FD9\u4E2A\u505A\u59D0\u59D0\u7684\uFF0C\\n\u73B0\u5728\u5F53\u8001\u5E08\u624D\u662F\u6700\u5FEB\u4E50\u7684\u3002[VAR 0114(0025)]",
  "\u6240\u4EE5\uFF0C\u4E0D\u8981\u53EB\u6211\u6CF0\u59C6\u5973\u58EB\uFF0C\\n\u5982\u679C\u53EB\u6211\u6CF0\u59C6\u8001\u5E08\u7684\u8BDD\uFF0C\\r\\n\u8001\u5E08\u6211\u4F1A\u5F88\uFF5E\u9AD8\u5174\u7684\u54E6\u3002[VAR 0114(0025)]",
  "\u597D\u7684\uFF0C\u867D\u7136\u5F88\u9057\u61BE\u2026\u2026\\n\u4F46\u6211\u7406\u89E3\u4E86\uFF01",
  "\u8C22\u8C22\u4F60\uFF01\\n\u6CF0\u59C6\u8001\u5E08\uFF01",
  "\u90A3\u4E48\uFF0C\u8FD9\u4EF6\u4E8B\\n\u603B\u7B97\u662F\u987A\u5229\u89E3\u51B3\u4E86\u3002[VAR 0114(0025)]",
  "\u54CE\uFF5E\u592A\u7D27\u5F20\u4E86\uFF01\\n\u8BF4\u4E86\u4E00\u5927\u5806\u542C\u8D77\u6765\u5F88\u5E05\u6C14\u7684\u8BDD\uFF01[VAR 0114(0025)]",
  "\u521A\u53D1\u73B0\u90A3\u9053\u70ED\u60C5\u4F3C\u706B\u7684\u76EE\u5149\u65F6\uFF0C\\n\u6211\u5176\u5B9E\u6709\u70B9\u5BB3\u6015\u2026\u2026[VAR 0114(0025)]",
  "\u8FD8\u597D\u6709\u4F60\u7684\u966A\u4F34\uFF0C\\n\u6211\u624D\u80FD\u548C\u652F\u6301\u6211\u7684\u7C89\u4E1D\uFF0C\\r\\n\u4E5F\u5C31\u662F\u90A3\u5B69\u5B50\u5766\u8BDA\u76F8\u5BF9\u3002[VAR 0114(0025)]",
  "\u4F60\u603B\u662F\u51FA\u73B0\u5F97\u6070\u5230\u597D\u5904\uFF0C\\n\u8C22\u8C22\u4F60\u54E6\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(0025)]",
  "\u8FD9\u662F\u8001\u5E08\u7684\u4E00\u70B9\u5FC3\u610F\u3002\\n\u5E0C\u671B\u80FD\u4E3A\u4F60\u7684\u5192\u9669\u6D3E\u4E0A\u7528\u573A\u3002[VAR 0114(0025)]",
  "\u548C\u6CF0\u59C6\u8001\u5E08\u4E4B\u95F4\u7684\\n\u7275\u7ECA\u840C\u82BD\u4E86\uFF01"
]
