[
  "\u8BF8\u4F4D\uFF0C\u6536\u8D77\u4F60\u4EEC\u7684\u624B\u673A\uFF0C\\n\u5F00\u59CB\u4E0A\u8BFE\u5427\u3002[VAR 0114(0029)]",
  "\u867D\u7136\u6709\u7684\u540C\u5B66\u671F\u4E2D\u8003\u8BD5\\n\u8865\u8003\u4E86\u597D\u51E0\u6B21\uFF0C\\r\\n\u4F46\u5927\u4F53\u4E0A\u90FD\u53CA\u683C\u4E86\uFF0C\u53EF\u559C\u53EF\u8D3A\u3002[VAR 0114(0029)]",
  "\u8BF8\u4F4D\u5DF2\u7ECF\u8BA9\u751F\u6D3B\u6240\u5FC5\u9700\u7684\\n\u77E5\u8BC6\u548C\u6280\u80FD\u6210\u4E3A\u4E86\u81EA\u5DF1\u7684\u4E00\u90E8\u5206\u3002\\r\\n\u543E\u8F88\u4E3A\u4F60\u4EEC\u611F\u5230\u9A84\u50B2\u3002[VAR 0114(0029)]",
  "\u4E0B\u534A\u5B66\u671F\u4E5F\u8981\u597D\u597D\\n\u78E8\u7EC3\u751F\u6D3B\u7684\u672C\u9886\u3002[VAR 0114(0029)]",
  "\u597D\u4E86\uFF0C\u6709\u90E8\u5206\u540C\u5B66\u95EE\u4E86\u543E\u8F88\\n\u5173\u4E8E\u98DF\u529B\u7684\u95EE\u9898\u3002[VAR 0114(0029)]",
  "\u63D0\u95EE\u8005\u4E2D\u6709\u4E00\u4F4D\\n\u559C\u6B22\u505A\u6599\u7406\u7684\u7537\u751F\u3002[VAR 0114(0029)]",
  "\u542C\u8BF4\u4ED6\u603B\u662F\\n\u72EC\u81EA\u4E00\u4EBA\u7814\u7A76\u6599\u7406\u3002[VAR 0114(0029)]",
  "\u4ED6\u5F88\u8BB2\u7A76\u98DF\u6750\uFF0C\\n\u4E00\u5929\u5230\u665A\u5730\u7814\u7A76\u5982\u4F55\u70F9\u8C03\u3002[VAR 0114(0029)]",
  "\u4F46\u4ED6\u5C31\u662F\u65E0\u6CD5\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\uFF0C\\n\u4E0D\u77E5\u5982\u4F55\u662F\u597D\u3002[VAR 0114(0029)]",
  "\u90A3\u4E48\uFF0C\u671F\u4E2D\u8003\u8BD5\u6210\u7EE9\u4F18\u79C0\u7684[VAR 0100(0000)]\uFF0C\\n\u4F60\u6765\u56DE\u7B54\u3002[VAR 0114(0029)]",
  "\u8981\u60F3\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\uFF0C\\n\u6D3E\u2026\u2026\u90A3\u4E2A\u7537\u751F\u5E94\u8BE5\u600E\u4E48\u505A\uFF1F[VAR 0114(0029)]",
  "\u591A\u591A\u70F9\u8C03",
  "\u5927\u5BB6\u4E00\u8D77\u70F9\u8C03",
  "\u6D3E\u5E15\uFF1F",
  "\u6599\u7406\u7684\u4E16\u754C\u5F88\u6DF1\u5965\u2026\u2026\\n\u5C31\u7B97\u4E00\u4E2A\u52B2\u5730\u591A\u591A\u70F9\u8C03\uFF0C\\r\\n\u52AA\u529B\u4E5F\u672A\u5FC5\u80FD\u5F97\u5230\u56DE\u62A5\u3002[VAR 0114(0029)]",
  "\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\u3002\\n\u770B\u6765\u4F60\u5DF2\u7ECF\u7406\u89E3\u4F55\u8C13\u6599\u7406\u4E86\u554A\u3002[VAR 0114(0029)]",
  "\u545C\u5443\u2026\u2026\u559C\u6B22\u505A\u6599\u7406\u7684\u7537\u751F\u7684\\n\u8EAB\u4EFD\u662F\u4E2A\u79D8\u5BC6\u2026\u2026\\r\\n\u53EF\u80FD\u662F\u6D3E\u5E15\u540C\u5B66\uFF0C\\r\\n\u4E5F\u53EF\u80FD\u4E0D\u662F\u4ED6\u54E6\u2026\u2026\uFF01[VAR 0114(0029)]",
  "\u8981\u60F3\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\uFF0C\\n\u5C31\u9700\u8981\u8BA9\u5F88\u591A\u98DF\u6750\\r\\n\u5939\u5728\u4E09\u660E\u6CBB\u5F53\u4E2D\u3002[VAR 0114(0029)]",
  "\u5373\u4F7F\u8FD9\u5BF9\uFF11\u4E2A\u4EBA\u6765\u8BF4\u5F88\u96BE\uFF0C\\n\u5982\u679C\u591A\u4E2A\u4EBA\u4E00\u8D77\u6765\u505A\u7684\u8BDD\uFF0C\\r\\n\u80FD\u7528\u7684\u9762\u5305\u4E5F\u4F1A\u76F8\u5E94\u5730\u53D8\u5927\u3002[VAR 0114(0029)]",
  "\u8FD9\u6837\u7684\u8BDD\uFF0C\u5C31\u80FD\u5F88\u5BB9\u6613\u5730\\n\u5C06\u98DF\u6750\u653E\u5230\u4E0A\u9762\u53BB\u4E86\u3002[VAR 0114(0029)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u80FD\u83B7\u5F97\\n\u6548\u679C\u5F88\u9AD8\u7684\u98DF\u529B\u3002[VAR 0114(0029)]",
  "\u6240\u4EE5\uFF0C\u5F53\u9047\u5230\u56F0\u96BE\u65F6\u4E0D\u8981\uFF11\u4E2A\u4EBA\u5305\u63FD\uFF0C\\n\u548C\u5176\u4ED6\u4EBA\u4E00\u8D77\u89E3\u51B3\u95EE\u9898\u4E5F\u662F\u4E00\u6761\u51FA\u8DEF\u3002\\r\\n\u4ECE\u8FD9\u4E2A\u6559\u8BAD\u4E2D\u53EF\u4EE5\u5B66\u5230\u8FD9\u4E00\u70B9\u554A\u3002[VAR 0114(0029)]",
  "\u6D3E\u5E15\u540C\u5B66\u4ECA\u540E\u4E5F\u4E00\u5B9A\\n\u4F1A\u548C\u670B\u53CB\u4E00\u8D77\u5236\u4F5C\u6599\u7406\u7684\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u8FD9\u4E2A\u7537\u751F\u7684\u8EAB\u4EFD\\n\u662F\u4E2A\u6D89\u53CA\u9690\u79C1\u7684\u95EE\u9898\u3002\\r\\n\u6240\u4EE5\u8BF8\u4F4D\u5C31\u4E0D\u8981\u5228\u6839\u95EE\u5E95\u4E86\uFF0C\u597D\u5427\uFF1F[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u5C31\u6B64\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
