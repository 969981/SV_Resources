[
  "\u2026\u2026\u54CE\u5440\uFF1F\\n\u770B\u6765\u6709\u521D\u6B21\u89C1\u9762\u7684\u5B66\u751F\u554A\u3002[VAR 0114(002C)]",
  "\u6211\u53EB\u505A\u857E\u8377\uFF0C\\n\u8D1F\u8D23\u5411\u4F60\u4EEC\u4F20\u6388\u53E4\u8001\u7684\u5B66\u672F\u3002[VAR 0114(0027)]",
  "\u5386\u53F2\u5F88\u5999\u2026\u2026\u975E\u5E38\u7F8E\u5999\u2026\u2026\\n\u8001\u524D\u8F88\u4EEC\u65E5\u79EF\u6708\u7D2F\u7684\u65F6\u95F4\\r\\n\u8FDE\u63A5\u7740\u6211\u4EEC\u6240\u751F\u6D3B\u7684\u5F53\u4E0B\u2026\u2026\uFF01[VAR 0114(0027)]",
  "\u4ECA\u5929\u4F60\u4EEC\u8981\u5B66\u4E60\\n\u5E15\u5E95\u4E9A\u5730\u533A\u6700\u4E0D\u4E3A\u4EBA\u77E5\u7684\u5730\u65B9\uFF0C\\r\\n\u795E\u79D8\u5DE8\u5751\u7684\u4E8B\u3002[VAR 0114(0027)]",
  "\u6B63\u5982\u5927\u5BB6\u6240\u77E5\uFF0C\\n\u5728\u5E15\u5E95\u4E9A\u4E2D\u592E\u5B58\u5728\u7740\u5DE8\u5927\u7684\u7A7A\u6D1E\uFF0C\\r\\n\u4E5F\u5C31\u662F\u5E15\u5E95\u4E9A\u5DE8\u5751\u3002[VAR 0114(0027)]",
  "\u5DE8\u5751\u4E4B\u4E2D\u7684\u533A\u57DF\u88AB\u79F0\u4E3A\u201C\u7B2C\u96F6\u533A\u201D\u3002\\n\u7814\u7A76\u8868\u660E\uFF0C\u6839\u636E\u5730\u5C42\u548C\u6210\u5206\u6765\u770B\uFF0C\\r\\n\u5B83\u65E9\u5728\uFF11\uFF10\uFF10\u4E07\u5E74\u4E4B\u524D\u5C31\u5DF2\u7ECF\u5B58\u5728\u4E86\u3002[VAR 0114(0027)]",
  "\u81EA\u53E4\u4EBA\u4EEC\u76F8\u4FE1\uFF0C\u4ECE\u5F88\u4E45\u4EE5\u524D\u5C31\u6709\\n[VAR FF00(0006)]\u67D0\u79CD\u4E1C\u897F[VAR FF00(0000)]\u6C89\u7761\u5728\u90A3\u5145\u6EE1\u8C1C\u56E2\u7684\u5DE8\u5751\u5E95\u90E8\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u4EBA\u4EEC\u6240\u8BA4\u4E3A\u7684\\n\u6C89\u7761\u4E8E\u5E15\u5E95\u4E9A\u5DE8\u5751\u7684\u5185\u90E8\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u7B2C\u96F6\u533A\u6DF1\u5904\u7684\u7A76\u7ADF\u4E3A\u4F55\u7269\u5462\uFF1F[VAR 0114(0027)]",
  "\u8D22\u5B9D",
  "\u5361\u6BD4\u517D",
  "\u5B9D\u53EF\u68A6\u4E2D\u5FC3",
  "\u5475\uFF0C\u56DE\u7B54\u6B63\u786E\uFF01\\n\u60F3\u4E0D\u5230\u4F60\u8FD8\u6709\u4E9B\u5C0F\u806A\u660E\u5462\u3002\\r\\n\u4E0A\u8BFE\u524D\u7684\u9884\u4E60\u4E5F\u505A\u5F97\u5F88\u5B8C\u7F8E\u54E6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\u867D\u7136\u4F60\u7684\u7B54\u6848\u5F88\u53EF\u7231\uFF0C\\n\u4F46\u6216\u8BB8\u662F\u88AB\u6C89\u7761\u8FD9\u4E2A\u8BCD\u8BED\u7ED9\u8BEF\u5BFC\u4E86\u5427\uFF1F\\r\\n\u6B63\u786E\u7B54\u6848\u662F\u8D22\u5B9D\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\u867D\u7136\u4F60\u7684\u7B54\u6848\u5F88\u6709\u8DA3\uFF0C\\n\u4F46\u5982\u679C\u771F\u7684\u6709\uFF0C\u90A3\u5C31\u662F\u65F6\u4EE3\u9519\u8BEF\u7684\u9057\u7269\u4E86\u3002\\r\\n\u6B63\u786E\u7B54\u6848\u662F\u8D22\u5B9D\u54E6\u3002[VAR 0114(0027)]",
  "\u6CA1\u9519\uFF01\u4EBA\u4EEC\u81EA\u53E4\u76F8\u4FE1\uFF0C\\n\u6C89\u7761\u4E8E\u5DE8\u5751\u6DF1\u5904\u7684\\r\\n\u662F\u6BD4\u4E16\u95F4\u4E07\u7269\u90FD\u66F4\u73CD\u8D35\u7684\u8D22\u5B9D\uFF01[VAR 0114(0027)]",
  "\u4E0D\u8FC7\u73B0\u5728\u5EFA\u8D77\u4E86\u7814\u7A76\u6240\uFF0C\\n\u5DF2\u7ECF\u6BEB\u65E0\u6D6A\u6F2B\u53EF\u8A00\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u2026\u2026\u554A\uFF0C\u6211\u8FD8\u662F\u8BF4\u660E\u4E00\u4E0B\u3002\\n\u9664\u4E86\u76F8\u5173\u4EBA\u5458\u4E4B\u5916\uFF0C\\r\\n\u4EFB\u4F55\u4EBA\u4E0D\u5F97\u8FDB\u5165\u5E15\u5E95\u4E9A\u5DE8\u5751\u548C\u7B2C\u96F6\u533A\u3002[VAR 0114(0027)]",
  "\u201C\u53BB\u5BFB\u5B9D\u54AF\uFF0C\u8036\uFF5E\uFF01\u201D\\c\\n\u2026\u2026\u5E0C\u671B\u4F60\u4EEC\u4E0D\u8981\u62B1\u6709\\n\u8FD9\u79CD\u8352\u5510\u7684\u5FC3\u6001\u8E0F\u5165\u7981\u533A\u3002[VAR 0114(0027)]",
  "\u5982\u679C\u53EF\u4EE5\u7684\u8BDD\uFF0C\\n\u6211\u81EA\u5DF1\u53EF\u662F\u6700\u60F3\u4E00\u6E9C\u70DF\u5730\u51B2\u53BB\u8C03\u67E5\u554A\u2026\u2026\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u54CE\u5440\uFF1F\u6211\u6216\u8BB8\u8BF4\u592A\u591A\u4E86\uFF0C\\n\u65F6\u95F4\u597D\u50CF\u8D70\u592A\u5FEB\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u6211\u4EEC\u4E0B\u56DE\u518D\u89E3\u5386\u53F2\u4E4B\u8C1C\u3002[VAR 0114(0027)]"
]
