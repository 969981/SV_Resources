[
  "\u6211\u8FFD\u4E0A\u6765\u4E86\uFF5E\uFF01\\n\u7EC8\u4E8E\u5230\u4E86\u554A\uFF5E\uFF01[VAR 0114(0004)]",
  "\u8FD9\u91CC\u5C31\u662F\u684C\u53F0\u5E02\uFF0C\\n\u5E15\u5E95\u4E9A\u5730\u533A\u6700\u5927\u7684\u57CE\u5E02\uFF01[VAR 0114(0004)]",
  "\u8FD9\u513F\u7684\u8D38\u6613\u4E00\u76F4\u90FD\u5F88\u5174\u9686\u3002\\n\u4E3A\u4E86\u83B7\u53D6\u65B0\u7684\u6280\u672F\u548C\u77E5\u8BC6\uFF0C\\r\\n\u5F88\u591A\u4EBA\u90FD\u4F1A\u5F80\u8FD9\u91CC\u6765\u5462\u3002[VAR 0114(0004)]",
  "\u6709\u80FD\u6253\u7406\u53D1\u578B\u7684\u7F8E\u5BB9\u9662\uFF0C\\n\u8FD8\u6709\u719F\u83DC\u5F88\u597D\u5403\u7684\u5E97\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u5BF9\u54EA\u4E2A\u611F\u5174\u8DA3\uFF1F[VAR 0114(0004)]",
  "\u7F8E\u5BB9\u9662",
  "\u719F\u83DC\u5E97",
  "\u4F60\u662F\u4E2A\u6F6E\u4EBA\u554A\uFF01\\c\\n\u8FD8\u662F\u8BF4\u4F60\u60F3\u7406\u4E00\u4E2A\u4E0D\u4F1A\u59A8\u788D\\n\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u53D1\u578B\uFF01\uFF1F[VAR 0114(0004)]",
  "\u4F60\u8BE5\u4E0D\u4F1A\u662F\u4E2A\u8D2A\u5403\u9B3C\u5427\uFF1F\\c\\n\u4E0D\u8FC7\u6BD5\u7ADF\u997F\u7740\u809A\u5B50\\n\u662F\u6CA1\u6CD5\u8FDB\u884C\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u554A\u3002[VAR 0114(0004)]",
  "\u554A\uFF01\u8BF4\u5230\u5BF9\u6218\u2026\u2026[VAR 0114(0004)]",
  "\u6211\u60F3\u8BA9[VAR 0100(0000)]\u4F60\\n\u4E5F\u80FD\u4F7F\u7528\u592A\u6676\u5462\uFF01[VAR 0114(0004)]",
  "\u9700\u8981\u5148\u529E\u4E2A\u624B\u7EED\u624D\u884C\uFF0C\\n\u6240\u4EE5\u6211\u53BB\u66FF\u4F60\u529E\u5427\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u4F60\u5C31\u5229\u7528\u8FD9\u6BB5\u65F6\u95F4\\n\u901B\u901B\u8857\u5427\u3002\u53EF\u597D\u73A9\u4E86\uFF01[VAR 0114(0004)]",
  "\u8FD8\u6709\u80FD\u7ED9\u5236\u670D\u589E\u6DFB\u4E2A\u6027\u7684\u65F6\u88C5\u5E97\u548C\u9910\u5385\uFF0C\\n\u4E5F\u503C\u5F97\u4E00\u53BB\u54E6\uFF01[VAR 0114(0004)]",
  "\u6211\u63A8\u8350\u4F60\u5230\u4FE1\u4F7F\u9E1F\u5305\u5305\u770B\u4E00\u770B\u3002\\n\u5728\u90A3\u91CC\u53EF\u4EE5\u4E70\u5230\\r\\n\u80FD\u8BA9\u5B9D\u53EF\u68A6\u643A\u5E26\u7684\u4FBF\u5229\u9053\u5177\u54E6\uFF5E\uFF01[VAR 0114(0004)]",
  "\u7B49\u4F60\u901B\u4E86\u4E00\u5708\u4E4B\u540E\uFF0C\\n\u6211\u4EEC\u5C31\u5728\u5B66\u6821\u524D\u96C6\u5408\u5427\uFF01\\r\\n\u697C\u68AF\u5F88\u4E0D\u5F97\u4E86\u2026\u2026\u505A\u597D\u5FC3\u7406\u51C6\u5907\u5427\u3002[VAR 0114(0004)]",
  "\u5F85\u4F1A\u513F\u89C1\uFF01\\n\u4F60\u5C31\u597D\u597D\u671F\u5F85\u7740\u5427\uFF5E\uFF01[VAR 0114(0004)]"
]
