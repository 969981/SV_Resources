[
  "\u8FD9\u4E0D\u662F\uFF11\uFF0D\uFF21\u73ED\u7684\\n[VAR 0100(0000)]\u5417\uFF1F[VAR 0114(0027)]",
  "\u6211\u5728\u8BFE\u4E0A\u8BB2\u7684\u7AE5\u8BDD\u6545\u4E8B\uFF0C\\n\u4F60\u96BE\u9053\u4E0D\u60F3\u77E5\u9053\u540E\u7EED\u5417\uFF1F[VAR 0114(0027)]",
  "\u5475\u5475\u5475\u2026\u2026\\n\u4F60\u4E56\u4E56\u4E0A\u94A9\uFF0C\u53EF\u771F\u662F\u7701\u5FC3\u3002[VAR 0114(0027)]",
  "\u4E0D\u8BB8\u6492\u8C0E\u3002\\n\u4F60\u6EE1\u8138\u5199\u7740\u60F3\u8981\u6EE1\u8DB3\\r\\n\u6C42\u77E5\u7684\u597D\u5947\u5FC3\u5462\u3002[VAR 0114(0027)]",
  "\u9F0E\u3001\u5251\u3001\u7B80\u3001\u7389\uFF0C\\n\u628A\u8FD9\uFF14\u4EF6\u5B9D\u7269\u90FD\u6536\u5165\u56CA\u4E2D\u7684\\r\\n\u738B\u57CE\u4E4B\u6240\u4EE5\u6BC1\u706D\u2026\u2026[VAR 0114(0027)]",
  "\u5176\u771F\u76F8\u5C31\u662F\uFF0C\\n\u5B9D\u7269\u6B63\u662F\u5B9D\u53EF\u68A6\u3002[VAR 0114(0027)]",
  "\uFF14\u53EA\u5B9D\u53EF\u68A6\u4F5C\u4E3A\u5B9D\u7269\\n\u8F97\u8F6C\u4E86\u591A\u4EBA\u4E4B\u624B\uFF0C\\r\\n\u4EBA\u7C7B\u7684\u6B32\u671B\u548C\u8BC5\u5492\u9010\u6E10\u9644\u5728\u5B83\u4EEC\u8EAB\u4E0A\u2026\u2026[VAR 0114(0027)]",
  "\u56E0\u53D7\u5230\u56FD\u738B\u7684\u6B32\u671B\u4FB5\u8680\uFF0C\\n\u5B83\u4EEC\u7EC8\u4E8E\u5316\u4E3A\u707E\u7978\uFF0C\u5F00\u59CB\u5927\u95F9\u8D77\u6765\u3002[VAR 0114(0027)]",
  "\u56FD\u738B\u4E3A\u4E86\u4FDD\u62A4\u81EA\u5DF1\u7684\u56FD\u5BB6\uFF0C\\n\u53EB\u6765\u58F0\u540D\u8FDC\u626C\u7684\u5B9D\u53EF\u68A6\u4F7F\u8005\uFF0C\\r\\n\u5C55\u5F00\u6FC0\u70C8\u7684\u6218\u6597\uFF0C\u7EC8\u4E8E\u5E73\u590D\u4E86\u707E\u7978\u3002[VAR 0114(0027)]",
  "\u4E4B\u540E\u90A3\uFF14\u53EA\u5B9D\u53EF\u68A6\\n\u5C31\u88AB\u5C01\u5370\u5728\u5E15\u5E95\u4E9A\u7684\u67D0\u5904\u4E86\u3002[VAR 0114(0027)]",
  "\u4F60\u8BA4\u4E3A\u2026\u2026\\n\u8FD9\u4E2A\u6545\u4E8B\u662F\u865A\u6784\u7684\u5417\uFF1F[VAR 0114(0027)]",
  "\u597D\u610F\u5916\uFF0C\u4F60\u7ADF\u6BEB\u65E0\u6D6A\u6F2B\u60C5\u6000\uFF01\uFF01[VAR 0114(0027)]",
  "\u5475\u5475\u2026\u2026\u771F\u662F\u654F\u9510\u3002[VAR 0114(0027)]",
  "\u5386\u53F2\u6027\u7684\u707E\u5BB3\u8BB0\u5F55\uFF0C\u4E2A\u4EBA\u7684\u65E5\u8BB0\u2026\u2026\\n\u6211\u7814\u8BFB\u4E86\u5404\u79CD\u5404\u6837\u7684\u8D44\u6599\uFF0C\\r\\n\u6709\u5F88\u591A\u4E8B\u5B9E\u53EF\u4EE5\u8BC1\u660E\u6545\u4E8B\u7684\u771F\u5B9E\u6027\u3002[VAR 0114(0027)]",
  "\u5982\u679C\u6211\u80FD\u786E\u5B9A\u6545\u4E8B\u662F\u771F\u7684\uFF0C\\n\u5230\u65F6\u5019\u4E5F\u544A\u8BC9\u4F60\u4E00\u58F0\u5427\u3002[VAR 0114(0027)]",
  "\u4E0E\u857E\u8377\u8001\u5E08\u7684\u5173\u7CFB\\n\u53C8\u53D8\u597D\u4E86\u4E00\u4E9B\uFF01"
]
