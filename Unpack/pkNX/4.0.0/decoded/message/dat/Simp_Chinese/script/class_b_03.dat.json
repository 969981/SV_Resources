[
  "\u540C\u5B66\u4EEC\u597D\u554A\u3002\\n\u8BA9\u6211\u4EEC\u4E00\u8D77\u5FEB\u4E50\u5730\u4E0A\u8BFE\u5427\u3002[VAR 0114(0025)]",
  "\u5927\u5BB6\u662F\u5426\u559C\u6B22\u5360\u535C\u5462\uFF1F[VAR 0114(0025)]",
  "\u5982\u679C\u5728\u6668\u95F4\u65B0\u95FB\u7684\\n\u5360\u535C\u8282\u76EE\u91CC\u770B\u5230\u81EA\u5DF1\u8FD0\u52BF\u5F88\u597D\uFF0C\\r\\n\u5FC3\u60C5\u5C31\u4F1A\u4E0D\u81EA\u89C9\u5730\u6109\u5FEB\u8D77\u6765\u5427\uFF1F[VAR 0114(0025)]",
  "\u4ECA\u5929\u7684\u4E3B\u9898\u5C31\u4E0E\u8FD0\u6C14\u76F8\u5173\uFF0C\\n\u6765\u7EE7\u7EED\u5B66\u4E60\u6570\u5B57\u5427\uFF01[VAR 0114(0025)]",
  "\u5728\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\uFF0C\\n\u5076\u5C14\u4F1A\u53D1\u751F\u2026\u2026\u51FB\u4E2D\u8981\u5BB3\u4E86\uFF01\\r\\n\u4F60\u4EEC\u5E94\u8BE5\u90FD\u89C1\u5230\u8FC7\u5427\uFF1F[VAR 0114(0025)]",
  "\u51FB\u4E2D\u8981\u5BB3\u65F6\uFF0C\\n\u4F24\u5BB3\u4F1A\u6BD4\u901A\u5E38\u591A\u51FA\u4E00\u534A\uFF0C\\r\\n\u4E5F\u5C31\u662F\uFF11.\uFF15\u500D\u54E6\u3002[VAR 0114(0025)]",
  "\u4F55\u65F6\u80FD\u51FB\u4E2D\u8981\u5BB3\uFF0C\u4F55\u65F6\u53C8\u4E0D\u80FD\uFF0C\\n\u8FD9\u4E9B\u5168\u770B\u8FD0\u6C14\u2026\u2026\u770B\u8C01\u66F4\u52A0\u5E78\u8FD0\u3002\\r\\n\u800C\u8FD9\u6837\u7684\u8FD0\u6C14\u56E0\u7D20\u5374\u4F1A\u5728\u5BF9\u6218\u4E2D\u6380\u8D77\u6CE2\u6F9C\u3002[VAR 0114(0025)]",
  "\u90A3\u4E48\uFF0C\u6709\u8C01\u77E5\u9053\\n\u51FB\u4E2D\u8981\u5BB3\u7684\u6982\u7387\u662F\u591A\u5C11\u5417\uFF1F[VAR 0114(0025)]",
  "\u5927\u7EA6\uFF11\uFF05\u3000\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF11\u6B21\uFF09",
  "\u5927\u7EA6\uFF14\uFF05\u3000\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF14\u6B21\uFF09",
  "\u5927\u7EA6\uFF11\uFF12\uFF05\u3000\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF11\uFF12\u6B21\uFF09",
  "\u54E6\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u8981\u5BB3\u6BD4\u4F60\u60F3\u7684\u66F4\u5BB9\u6613\u51FB\u4E2D\u54E6\u3002[VAR 0114(0025)]",
  "\u6CA1\u9519\uFF01\u7B54\u5F97\u975E\u5E38\u597D\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\u4F60\u5462\uFF01[VAR 0114(0025)]",
  "\u54E6\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u90A3\u6837\u7684\u8BDD\u8981\u5BB3\u4E5F\u592A\u591A\u4E86\u5427\uFF1F[VAR 0114(0025)]",
  "\u636E\u8BF4\uFF0C\u51C6\u786E\u7684\u51FB\u4E2D\u8981\u5BB3\u7684\\n\u6982\u7387\u662F\uFF12\uFF14\u5206\u4E4B\uFF11\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\uFF14.\uFF11\uFF17\uFF05\u3002[VAR 0114(0025)]",
  "\u4E5F\u6709\u6BD4\u8F83\u5BB9\u6613\u51FB\u4E2D\u8981\u5BB3\u7684\u62DB\u5F0F\uFF0C\\n\u6BD4\u5982\u5C16\u77F3\u653B\u51FB\u548C\u6697\u5F71\u722A\uFF0C\\r\\n\u4F7F\u7528\u5B83\u4EEC\u7684\u8BDD\u6709\uFF11\uFF12\uFF05\u7684\u6982\u7387\u51FB\u4E2D\u8981\u5BB3\uFF01[VAR 0114(0025)]",
  "\u4F7F\u51FA\u540D\u4E3A\u805A\u6C14\u7684\u62DB\u5F0F\uFF0C\\n\u6216\u8005\u4F7F\u7528\u540D\u4E3A\u8981\u5BB3\u653B\u51FB\u7684\u9053\u5177\u2026\u2026[VAR 0114(0025)]",
  "\u51FB\u4E2D\u8981\u5BB3\u7684\u6982\u7387\u5C31\u4F1A\u5927\u5E45\u63D0\u9AD8\uFF12\u4E2A\u7B49\u7EA7\uFF0C\\n\u80FD\u4EE5\uFF15\uFF10\uFF05\u7684\u6982\u7387\u653B\u51FB\u8981\u5BB3\u3002[VAR 0114(0025)]",
  "\u51FB\u4E2D\u8981\u5BB3\uFF0C\u6B22\u6B22\u559C\u559C\uFF0C\\n\u88AB\u51FB\u4E2D\u8981\u5BB3\uFF0C\u54ED\u54ED\u557C\u557C\u3002[VAR 0114(0025)]",
  "\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\u6240\u9690\u85CF\u7684\\n\u6982\u7387\u7684\u6570\u5B66\u77E5\u8BC6\u8D85\u51FA\u6211\u4EEC\u6240\u60F3\u3002[VAR 0114(0025)]",
  "\u901A\u8FC7\u8BA1\u7B97\u5F97\u5230\u597D\u8FD0\u7684\u8BDD\uFF0C\\n\u6216\u8BB8\u8FD8\u80FD\u8FDB\u4E00\u6B65\u5730\u4E30\u5BCC\u6218\u672F\u54E6\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u4E0B\u8BFE\u94C3\u54CD\u4E86\uFF1F\\n\u5DF2\u7ECF\u5230\u65F6\u95F4\u4E86\u5440\uFF0C\u771F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u4E0B\u6B21\u662F\u4EE4\u4EBA\u5F00\u5FC3\u7684\u671F\u4E2D\u8003\u8BD5\uFF01\\n\u5927\u5BB6\u5C31\u6EE1\u5FC3\u671F\u5F85\u5427\u3002[VAR 0114(0025)]"
]
