  "[VAR 0100(0000)]\\n\u80FD\u591F\u5236\u4F5C[VAR FF00(0006)]\u65B0\u852C\u83DC\u4E09\u660E\u6CBB[VAR FF00(0000)]\u4E86\uFF01",
