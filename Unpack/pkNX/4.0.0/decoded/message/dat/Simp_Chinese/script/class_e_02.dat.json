[
  "\u4ECA\u5929\u4E5F\u8981\u7CBE\u529B\u5145\u6C9B\u5730\u5B66\u4E60\u5BF9\u6218\u5B66\uFF01\\n\u563F\u5440\uFF01\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u90FD\u5F88\u559C\u6B22\\n\u5BFB\u5B9D\u8FD9\u9879\u8BFE\u5916\u6D3B\u52A8\u5427\uFF01\uFF1F[VAR 0114(0024)]",
  "\u6311\u6218\u9053\u9986\uFF01\u9A70\u9A8B\u5728\u5916\uFF01\\n\u4E0E\u642D\u6863\u5B9D\u53EF\u68A6\u4E00\u540C\u5954\u8DD1\uFF01\\r\\n\u8FD9\u6837\u7684\u5927\u5192\u9669\u5728\u7B49\u5F85\u7740\u4F60\u4EEC\uFF0C\u5BF9\u5427\uFF01[VAR 0114(0024)]",
  "\u800C\u5F53\u4F60\u4EEC\u5728\u6821\u5916\u6D3B\u52A8\u65F6\uFF0C\\n\u5E38\u5E38\u4F1A\u53D1\u73B0\u5927\u5927\u7684\u3001\\r\\n\u8FD8\u53D1\u7740\u5149\u7684[VAR FF00(0006)]\u7ED3\u6676[VAR FF00(0000)]\uFF0C\u5BF9\u5427\uFF01[VAR 0114(0024)]",
  "\u90A3\u7ED3\u6676\u662F\u4ECE\u5730\u4E2D\u6E17\u51FA\u7684\\n\u592A\u6676\u80FD\u91CF\u7684\u5DE8\u5757\uFF01[VAR 0114(0024)]",
  "\u4E00\u65E6\u8C03\u67E5\u4E86\u7ED3\u6676\uFF0C\\n\u5C31\u5F97\u548C\u670B\u53CB\u6216\u5176\u4ED6\u4EBA\uFF14\u4EBA\u4E00\u7EC4\uFF0C\\r\\n\u4E0E\u592A\u6676\u5B9D\u53EF\u68A6\u5C55\u5F00\u5BF9\u6218\uFF01[VAR 0114(0024)]",
  "\u90A3\u6837\u7684\u5BF9\u6218\\n\u53EB\u505A\u592A\u6676\u56E2\u4F53\u6218\uFF01\uFF01[VAR 0114(0024)]",
  "\u4F60\u4EEC\u5728\u592A\u6676\u56E2\u4F53\u6218\u4E2D\\n\u8981\u9762\u5BF9\u7684\u592A\u6676\u5B9D\u53EF\u68A6\u53EF\u662F\u5F3A\u654C\uFF01[VAR 0114(0024)]",
  "\u5B83\u6709\u65F6\u4F1A\u91C7\u53D6\u4E00\u4E9B\u4E0D\u540C\u4E8E\\n\u666E\u901A\u5B9D\u53EF\u68A6\u7684\u884C\u52A8\uFF0C\u4E0D\u80FD\u5927\u610F\uFF01[VAR 0114(0024)]",
  "\u4E0D\u8FC7\uFF0C\u5728\u592A\u6676\u56E2\u4F53\u6218\u4E2D\uFF0C\\n\u8BAD\u7EC3\u5BB6\u4E5F\u53EF\u4EE5\u91C7\u53D6\u7279\u6B8A\u7684\u884C\u52A8\uFF0C\\r\\n\u90A3\u5C31\u662F\u201C[VAR FF00(0006)]\u58F0\u63F4[VAR FF00(0000)]\u201D\uFF01[VAR 0114(0024)]",
  "\u58F0\u63F4\u6709\uFF13\u79CD\uFF01[VAR 0114(0024)]",
  "[VAR FF00(0006)]\u51B2\u51B2\u731B\u653B[VAR FF00(0000)]\u80FD\u591F\u63D0\u5347\\n\u6211\u65B9\u5168\u4F53\u7684\u653B\u51FB\u4E0E\u7279\u653B\u3002[VAR 0114(0024)]",
  "[VAR FF00(0006)]\u575A\u575A\u56FA\u5B88[VAR FF00(0000)]\u80FD\u591F\u63D0\u5347\\n\u6211\u65B9\u5168\u4F53\u7684\u9632\u5FA1\u4E0E\u7279\u9632\u3002[VAR 0114(0024)]",
  "\u800C\u7B2C\uFF13\u79CD\u662F\u2026\u2026\\n\u8BA9\u6211\u6765\u8003\u8003\u5404\u4F4D\u5427\uFF01[VAR 0114(0024)]",
  "\u80FD\u591F\u56DE\u590D\u6211\u65B9\u5168\u4F53\u4F53\u529B\u7684\u58F0\u63F4\\n\u53EB\u4EC0\u4E48\u540D\u5B57\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5566\u5566\u7597\u6108",
  "\u731B\u731B\u6D47\u4F24\u836F",
  "\u7206\u88C2\u56DE\u590D\u6CE2",
  "\u6B63\u786E\u7B54\u6848\uFF01\\n\u8F6C\u5B66\u751F\u4F60\u771F\u662F\u5BF9\u6218\u5B66\u7684\u5927\u5E08\u5462\uFF01[VAR 0114(0024)]",
  "\u731B\u731B\u6D47\u4F24\u836F\u2026\u2026\uFF01\uFF1F\\n\u90A3\u4E0E\u5176\u8BF4\u662F\u58F0\u63F4\uFF0C\\r\\n\u4E0D\u5982\u8BF4\u662F\u5F3A\u5236\u6027\u7684\u533B\u7597\u884C\u4E3A\u554A\u2026\u2026\uFF01[VAR 0114(0024)]",
  "\u7206\u88C2\u56DE\u590D\u6CE2\u2026\u2026\uFF01\uFF1F\\n\u76F8\u5F53\u6709\u7126\u9999\u5473\u5462\u3002\\r\\n\u8981\u662F\u771F\u6709\u8FD9\u6837\u7684\u62DB\u5F0F\uFF0C\u6211\u4E5F\u60F3\u7528\u4E00\u7528\u5440\uFF01[VAR 0114(0024)]",
  "\u7B2C\uFF13\u79CD\u662F[VAR FF00(0006)]\u5566\u5566\u7597\u6108[VAR FF00(0000)]\uFF01\\n\u5B83\u80FD\u56DE\u590D\u4F53\u529B\uFF0C\\r\\n\u8FD8\u80FD\u6CBB\u6108\u5F02\u5E38\u72B6\u51B5\uFF0C\u975E\u5E38\u4F18\u79C0\uFF01[VAR 0114(0024)]",
  "\u5728\uFF11\u573A\u592A\u6676\u56E2\u4F53\u6218\u4E2D\uFF0C\\n\u6700\u591A\u53EF\u4EE5\u8FDB\u884C\uFF13\u6B21\u58F0\u63F4\u54E6\uFF01[VAR 0114(0024)]",
  "\u987A\u5E26\u4E00\u63D0\uFF0C\\n\u4F7F\u7528\u58F0\u63F4\u4F1A\u6D88\u8017\u81EA\u5DF1\u7684\u56DE\u5408\uFF0C\\r\\n\u5B9D\u53EF\u68A6\u5728\u90A3\u4E00\u56DE\u5408\u5C31\u6CA1\u6CD5\u51FA\u62DB\u4E86\u54E6\uFF01[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u786C\u7684\u4E0D\u884C\uFF0C\u5C31\u6765\u8F6F\u7684\uFF01\\n\u8981\u662F\u518D\u4E0D\u884C\uFF0C\u5C31\u7528\u58F0\u63F4\u5427\uFF01[VAR 0114(0024)]",
  "\u901A\u8FC7\u652F\u63F4\u540C\u4F34\uFF0C\\n\u8BF4\u4E0D\u5B9A\u8FD8\u80FD\u5F00\u8F9F\u53E6\u4E00\u6761\u8DEF\u54E6\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u4E48\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u7CBE\u529B\u5145\u6C9B\u6BCF\u4E00\u5929\uFF01[VAR 0114(0024)]"
]
