[
  "\u539F\u6765\u5409\u96C9\u9E21\u771F\u7684\\n\u80FD\u5728\u7A7A\u4E2D\u98DE\uFF01\\r\\n\u5B83\u54BB\uFF5E\u5730\u98DE\u8FC7\u4E86\u9B3C\u5C71\uFF01",
  "\u5B9D\u4F34\u591F\u8D5E\u72D7\uFF01\\n\u7D2B\u8272\u7684\u56F4\u5DFE\u597D\u6F02\u4EAE\uFF01\\r\\n\u6211\u770B\u5230\u5B83\u5728\u8352\u5730\u6563\u6B65\uFF01",
  "\u6211\u4EE5\u4E3A\u6709\u4EBA\u5012\u5728\u90A3\u91CC\uFF0C\\n\u6CA1\u60F3\u5230\u662F\u613F\u589E\u733F\u5728\u5348\u7761\uFF01\\c\\n\u5728\u6C60\u5858\u5468\u56F4\u7761\u89C9\\n\u7684\u786E\u5F88\u8212\u670D\u554A\u3002",
  "\u6536\u96C6\u5230\u4E86\\n\u7B2C\uFF11\u4E2A\u5B9D\u4F34\u7684\u6D88\u606F\uFF01",
  "\u6536\u96C6\u5230\u4E86\\n\u7B2C\uFF12\u4E2A\u5B9D\u4F34\u7684\u6D88\u606F\uFF01",
  "\u5B9D\u4F34\u4EEC\u7684\u6D88\u606F\\n\u90FD\u6536\u96C6\u9F50\u4E86\uFF01\\r\\n\u548C\u4E39\u745C\u4ED6\u4EEC\u4F1A\u5408\u5427\uFF01",
  "\u6211\u4EEC\u8981\u4E00\u4E2A\u4E0D\u843D\u5730\u6536\u96C6\\n\u5B9D\u4F34\u7684\u76EE\u51FB\u6D88\u606F\uFF01\\r\\n\u6536\u96C6\u5B8C\u4E86\u6765\u4F1A\u5408\u54E6\uFF01[VAR 0114(0044)]",
  "\u5C31\u7B97\u662F\u548C\u6751\u91CC\u4EBA\u642D\u8BDD\uFF0C\\n\u6211\u4E5F\u5F88\u5BB3\u7F9E\u54A7\u2026\u2026[VAR 0114(0043)]"
]
