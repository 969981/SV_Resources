[
  "\u540C\u5B66\u4EEC\u597D\u554A\u3002\\n\u4ECA\u5929\u4E5F\u5FEB\u4E50\u5730\u4E0A\u8BFE\u5427\u3002[VAR 0114(0025)]",
  "\u4E0A\u5802\u8BFE\u4E2D\u6211\u4EEC\u901A\u8FC7\u62DB\u5F0F\u7684\u547D\u4E2D\\n\u6765\u5B66\u4E60\u4E86\u6982\u7387\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u6982\u7387\u5F88\u6709\u8DA3\u5462\uFF0C\u5047\u5982\u73ED\u7EA7\u91CC\u6709\uFF14\uFF10\u4E2A\u5B66\u751F\uFF0C\\n\u4F3C\u4E4E\u5C31\u6709\uFF19\uFF10\uFF05\u7684\u6982\u7387\u4F1A\u51FA\u73B0\\r\\n\uFF11\u7EC4\u540C\u4E00\u5929\u751F\u65E5\u7684\u540C\u5B66\u3002[VAR 0114(0025)]",
  "\uFF11\u5E74\u660E\u660E\u6709\uFF13\uFF10\uFF10\u5929\u4EE5\u4E0A\uFF0C\\n\u771F\u662F\u4E0D\u53EF\u601D\u8BAE\u5462\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5927\u5BB6\u81F3\u4ECA\u5B66\u4E60\u4E86\\n\u5C5E\u6027\u76F8\u514B\u5440\u3001\u51FB\u4E2D\u8981\u5BB3\u5440\u2026\u2026[VAR 0114(0025)]",
  "\u8FD8\u6709\u80FD\u529B\u4E0A\u5347\\n\u8FD9\u7C7B\u7684\u4F24\u5BB3\u8BA1\u7B97\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u8FD9\u4E9B\u4F1A\u5168\u90E8\u76F8\u4E58\u5728\u4E00\u8D77\uFF0C\\n\u53BB\u524A\u51CF\u5BF9\u624B\u7684\u4F53\u529B\u3002[VAR 0114(0025)]",
  "\u4F46\u5176\u5B9E\u6BD4\u8D77\u8FD9\u4E9B\uFF0C\\n\u8FD8\u6709\u975E\u5E38\u7B80\u5355\u7684\u65B9\u5F0F\\r\\n\u53BB\u63D0\u5347\u62DB\u5F0F\u7684\u4F24\u5BB3\u54E6\u3002[VAR 0114(0025)]",
  "\u90A3\u5C31\u662F\u4F7F\u7528\u548C\u5B9D\u53EF\u68A6\\n\u76F8\u540C\u5C5E\u6027\u7684\u62DB\u5F0F\uFF01[VAR 0114(0025)]",
  "\u5CA9\u77F3\u5C5E\u6027\u7684\u5B9D\u53EF\u68A6\\n\u4F7F\u7528\u5C16\u77F3\u653B\u51FB\u8FD9\u7C7B\u5CA9\u77F3\u5C5E\u6027\u7684\u62DB\u5F0F\uFF0C\\r\\n\u5A01\u529B\u5C31\u4F1A\u4ECE\uFF11\uFF10\uFF10\u53D8\u4E3A\uFF11.\uFF15\u500D\u7684\uFF11\uFF15\uFF10\u54E6\u3002[VAR 0114(0025)]",
  "\u867D\u7136\u5F88\u76F8\u4F3C\uFF0C\u4F46\u5730\u9762\u5C5E\u6027\u7684\\n\u5B9D\u53EF\u68A6\u5373\u4F7F\u4F7F\u7528\u5C16\u77F3\u653B\u51FB\uFF0C\\r\\n\u5A01\u529B\u4E5F\u8FD8\u662F\u7EF4\u6301\uFF11\uFF10\uFF10\u4E0D\u53D8\u3002[VAR 0114(0025)]",
  "\u8FD9\u4E2A\u57FA\u7840\u4E4B\u4E0A\uFF0C\u8FD8\u8981\u4E58\u7B97\\n\u6548\u679C\u7EDD\u4F73\u548C\u51FB\u4E2D\u8981\u5BB3\u7684\u4F24\u5BB3\uFF0C\\r\\n\u7ED3\u679C\u5C06\u662F\u65E0\u6CD5\u8F7B\u89C6\u7684\u6570\u5B57\u54E6\u3002[VAR 0114(0025)]",
  "\u90A3\u4E48\uFF0C\u4F60\u4EEC\u662F\u5426\u6709\\n\u597D\u597D\u7406\u89E3\u4E86\u5462\uFF1F\u63D0\u95EE\uFF01[VAR 0114(0025)]",
  "\u4F7F\u51FA\u5A01\u529B\uFF11\uFF10\uFF10\u4E14\u5C5E\u6027\u4E00\u81F4\u7684\u62DB\u5F0F\uFF0C\\n\u4E14\u8FD9\u4E2A\u5C5E\u6027\u6B63\u597D\u662F\u5BF9\u65B9\u7684\u5F31\u70B9\uFF0C\u5176\u5A01\u529B\u4F1A\u662F\uFF1F[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10",
  "\uFF12\uFF10\uFF10",
  "\uFF13\uFF10\uFF10",
  "\u5443\uFF5E\u53EF\u60DC\uFF01\\n\uFF11\uFF15\uFF10\u7684\u8BDD\uFF0C\u4F3C\u4E4E\u5C31\u662F\u53EA\u4E58\u7B97\u4E86\\r\\n\u5C5E\u6027\u4E00\u81F4\u7684\uFF11.\uFF15\u500D\u6548\u679C\u54E6\u3002[VAR 0114(0025)]",
  "\u5443\uFF5E\u53EF\u60DC\uFF01\\n\uFF12\uFF10\uFF10\u7684\u8BDD\uFF0C\u4F3C\u4E4E\u5C31\u662F\u53EA\u4E58\u7B97\u4E86\\r\\n\u5F31\u70B9\u9020\u6210\u7684\uFF12\u500D\u7ED3\u679C\u54E6\u3002[VAR 0114(0025)]",
  "\u7ADF\u7136\u662F\u7528\u7684\u5FC3\u7B97\uFF01\u5389\u5BB3\uFF01\\n[VAR 0100(0000)]\uFF0C\u4F60\u771F\u4E86\u4E0D\u8D77\uFF01[VAR 0114(0025)]",
  "\u5A01\u529B\uFF11\uFF10\uFF10\uFF0C\\n\u4E58\u4EE5\u5C5E\u6027\u4E00\u81F4\u7684\uFF11.\uFF15\u500D\u6548\u679C\uFF0C\\r\\n\u4E5F\u5C31\u662F\uFF11\uFF15\uFF10\uFF01[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10\u4E4B\u4E0A\u8FD8\u8981\u4E58\u4EE5\\n\u5F31\u70B9\u5E26\u6765\u7684\uFF12\u500D\u6548\u679C\uFF0C\u4E5F\u5C31\u662F\uFF13\uFF10\uFF10\uFF01[VAR 0114(0025)]",
  "\u771F\u662F\u60CA\u4EBA\uFF01\\n\u662F\u539F\u672C\u5A01\u529B\u7684\uFF13\u500D\u54E6\uFF01[VAR 0114(0025)]",
  "\u4E0D\u4EC5\u5982\u6B64\uFF0C\\n\u5982\u679C\u592A\u6676\u5C5E\u6027\u4E5F\u4E0E\u539F\u672C\u5C5E\u6027\u76F8\u540C\uFF0C\\r\\n\u90A3\u4E48\u5C5E\u6027\u4E00\u81F4\u65F6\u7684\u500D\u6570\\r\\n\u5C31\u4F1A\u4ECE\uFF11.\uFF15\u500D\u53D8\u4E3A\uFF12\u500D\u54E6\uFF01[VAR 0114(0025)]",
  "\u5F53\u7136\uFF0C\u80FD\u591F\u4F7F\u7528\u4E0D\u540C\u5C5E\u6027\u7684\\n\u62DB\u5F0F\u4E5F\u662F\u4E00\u4EF6\u5F88\u5389\u5BB3\u7684\u4E8B\u54E6\u3002\\r\\n\u6BD5\u7ADF\u53EF\u4EE5\u8BA9\u5BF9\u624B\u5927\u5403\u4E00\u60CA\u561B\u3002[VAR 0114(0025)]",
  "\u4E0D\u8FC7\uFF0C\u4E0D\u7BA1\u662F\u4EBA\u8FD8\u662F\u5B9D\u53EF\u68A6\u2026\u2026[VAR 0114(0025)]",
  "\u5230\u5E95\u8FD8\u662F\u8981\u9760\u81EA\u5DF1\u7684\u4E2A\u6027\u672C\u8272\uFF0C\\n\u624D\u6700\u80FD\u53D1\u6325\u51FA\u5B9E\u529B\u3002[VAR 0114(0025)]",
  "\u4F60\u4EEC\u5982\u679C\u80FD\u8BB0\u4F4F\u8FD9\u4E00\u70B9\uFF0C\\n\u8001\u5E08\u6211\u4F1A\u5F88\u9AD8\u5174\u7684\u3002[VAR 0114(0025)]",
  "\u2026\u2026\u6211\u73B0\u5728\u624D\u8BB2\u8FD9\u4E48\u57FA\u7840\u7684\u9053\u7406\uFF0C\\n\u771F\u662F\u4E0D\u597D\u610F\u601D\u554A\u3002[VAR 0114(0025)]",
  "\u6700\u540E\u7684\u8BFE\u5802\u4E5F\\n\u8F6C\u773C\u5C31\u7ED3\u675F\u4E86\u5462\u3002[VAR 0114(0025)]",
  "\u5927\u5BB6\u8FD9\u4E48\u79EF\u6781\u5730\u5B66\u4E60\u6570\u5B57\uFF0C\\n\u8001\u5E08\u6211\u771F\u7684\u975E\u5E38\u5F00\u5FC3\u3002[VAR 0114(0025)]",
  "\u4E0B\u6B21\u662F\u4EE4\u4EBA\u5F00\u5FC3\u7684\u671F\u672B\u8003\u8BD5\uFF01\\n\u5927\u5BB6\u8981\u597D\u597D\u590D\u4E60\u51C6\u5907\u54E6\u3002[VAR 0114(0025)]"
]
