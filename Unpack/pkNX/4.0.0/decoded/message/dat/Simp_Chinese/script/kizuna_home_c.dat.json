  "\u636E\u8BF4\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u7684\u67D0\u5904\uFF0C\\n\u6709\u79CD\u5DE8\uFF5E\u751C\u65E0\u6BD4\u7684\u2026\u2026\u8C03\u5473\u6599\uFF01[VAR 0114(0029)]",
  "\u543E\u8F88\u65E0\u8BBA\u5982\u4F55\u90FD\u60F3\\n\u4F53\u9A8C\u4E00\u4E0B\u90A3\u751C\u7F8E\u7684\u6ECB\u5473\u3002[VAR 0114(0029)]",
  "\u9664\u4E86\u4F60\uFF0C\u6CA1\u4EBA\u77E5\u9053\\n\u543E\u8F88\u662F\u4E2A\u72C2\u70ED\u7684\u751C\u98DF\u7231\u597D\u8005\uFF0C\\r\\n\u6240\u4EE5\u80FD\u62DC\u6258\u7684\u53EA\u6709\u4F60\u4E86\u2026\u2026[VAR 0114(0029)]",
  "\u543E\u8F88\u8981\u662F\u7AD9\u51FA\u6765\u4EB2\u81EA\u884C\u52A8\u7684\u8BDD\uFF0C\\n\u6050\u6015\u5F62\u8C61\u4F1A\u7834\u574F\u6B86\u5C3D\u2026\u2026[VAR 0114(0029)]",
  "\u8C22\u793C\u81EA\u7136\u4E0D\u7528\u8BF4\u3002\\n\u5982\u679C\u4F60\u6709\u5174\u8DA3\uFF0C\u5C31\u8003\u8651\u4E00\u4E0B\u5427\u3002[VAR 0114(0029)]",
  "\u543E\u8F88\u4F1A\u4E8B\u5148\u8C03\u67E5\u597D\\n\u5DE8\uFF5E\u751C\u65E0\u6BD4\u7684\u8C03\u5473\u6599\u7684\u76F8\u5173\u4FE1\u606F\u3002[VAR 0114(0029)]",
  "\u7B49\u543E\u8F88\u638C\u63E1\u8BE6\u7EC6\u60C5\u51B5\u540E\uFF0C\\n\u5C31\u8DDF\u4F60\u5206\u4EAB\u7684\u3002[VAR 0114(0029)]",
