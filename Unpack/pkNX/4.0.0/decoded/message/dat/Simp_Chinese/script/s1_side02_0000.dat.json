[
  "[~ 18]",
  "\u2026\u2026\u54E6\uFF0C\u600E\u4E48\u4E86\uFF0C\u600E\u4E48\u4E86\uFF1F\\n\u5B8C\u5168\u6CA1\u6CE8\u610F\u5230\u4F60\u3002[VAR 0114(002C)]",
  "\u4F60\u662F\u2026\u2026\\n\u55EF\uFF0C\u5BF9\u4E86\u3002\\r\\n\u8BA9\u6211\u6765\u731C\u731C\u5427\uFF01[VAR 0114(002C)]",
  "\u4F60\u662F\u6765\u81EA\u5E15\u5E95\u4E9A\uFF0C\\n\u6B63\u5728\u53C2\u52A0\u590F\u4EE4\u8425\u7684\u540C\u5B66\u5427\uFF01[VAR 0114(002C)]",
  "\u4F60\u731C\u4E2D\u4E86\uFF01",
  "\u4F60\u600E\u4E48\u731C\u5230\u7684\uFF1F",
  "\u5475\u3001\u5475\u3001\u5475\uFF5E\uFF01\\n\u56E0\u4E3A\u6751\u5B50\u5F88\u5C0F\u561B\uFF0C\\r\\n\u81EA\u7136\u5C31\u80FD\u542C\u5230\u5404\u79CD\u6D88\u606F\u4E86\u3002[VAR 0114(002C)]",
  "\u6211\u53EB\u6C99\u4FEA\uFF0C\\n\u662F\u4E2A\u6709\u4E00\u70B9\u70B9\u559C\u6B22\u76F8\u673A\u7684\u65C5\u884C\u8005\u54E6\u3002[VAR 0114(0046)]",
  "\u800C\u5B83\uFF0C\u5219\u662F\u6211\u7684\u642D\u6863\u5361\u8482\u72D7\u3002\\n\u5B83\u5934\u4E0A\u7684\u89D2\u5F88\u53EF\u7231\u5427\uFF1F[VAR 0114(0046)]",
  "\u5495\u6C6A\uFF01",
  "\u62B1\u6B49\uFF0C\u6211\u77E5\u9053\u8FD9\u6709\u70B9\u5510\u7A81\uFF0C\\n\u4F46\u4F60\u80FD\u8BA9\u6211\u62CD\u4E00\u4E0B\u7167\u7247\u5417\uFF1F[VAR 0114(0046)]",
  "\u540C\u5B66\u554A\uFF0C\u4F60\u592A\u8001\u5B9E\u4E86\uFF0C\\n\u771F\u8BA9\u4EBA\u62C5\u5FC3\u3002\\r\\n\u53EF\u4E0D\u80FD\u592A\u76F8\u4FE1\u964C\u751F\u4EBA\u54E6\u3002[VAR 0114(0046)]",
  "\u6211\u8FD8\u662F\u4F1A\u62CD\u5C31\u662F\u4E86\u3002[VAR 0114(0046)]",
  "\u4E0D\u8FC7\u5EA6\u76F8\u4FE1\\n\u624D\u8BA4\u8BC6\u6CA1\u591A\u4E45\u7684\u4EBA\uFF01\\r\\n\u4F60\u771F\u61C2\u4E8B\u554A\uFF0C\u540C\u5B66\uFF01[VAR 0114(0046)]",
  "\u611F\u89C9\u4F60\u8FD9\u6837\u7684\u4EBA\\n\u771F\u662F\u7F55\u89C1\u53C8\u6709\u8DA3\u3002[VAR 0114(0046)]",
  "\u6211\u6682\u65F6\u4F1A\u4EE5\u8FD9\u4E2A\u6751\u5B50\\n\u4F5C\u4E3A\u6D3B\u52A8\u7684\u636E\u70B9\u3002[VAR 0114(0046)]",
  "\u7B49\u4F60\u505A\u5B8C\u8BE5\u505A\u7684\u4E8B\uFF0C\\n\u5C31\u518D\u6765\u627E\u6211\u5427\u3002\\c\\n\u4F8B\u5982\u6536\u96C6\u5317\u4E0A\u56FE\u9274\u4E2D\u7684\\n\uFF11\uFF15\uFF10\u79CD\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0046)]",
  "\u540C\u5B66\uFF01\u4F60\u4E0D\u662F\u6709\\n\u8BE5\u505A\u7684\u4E8B\u5417\uFF1F\\c\\n\u4F8B\u5982\u6536\u96C6\u5317\u4E0A\u56FE\u9274\u4E2D\u7684\\n\uFF11\uFF15\uFF10\u79CD\u5B9D\u53EF\u68A6\uFF01\\r\\n\u7B49\u4F60\u6536\u96C6\u5B8C\u4E86\u540E\uFF0C\u548C\u6211\u8BF4\u4E00\u58F0\u5427\u3002\\c\\n\u65F6\u95F4\u5B9D\u8D35\u54E6\uFF5E\\n\u6BD5\u7ADF\u65F6\u95F4\u5C31\u662F\u91D1\u94B1\u554A\uFF01[VAR 0114(0046)]"
]
