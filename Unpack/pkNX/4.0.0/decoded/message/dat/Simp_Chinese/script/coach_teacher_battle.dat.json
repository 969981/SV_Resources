[
  "\u563F\u5440\uFF01\u8BF7\u6307\u6559\uFF01\uFF01[VAR 0114(0024)]",
  "\u6211\u662F\u70ED\u8840\u6CB8\u817E\u7684\u51F0\u6A97\uFF01\\n\u8BA9\u6211\u4EEC\u4E00\u8D77\u71C3\u70E7\u6597\u5FD7\u5427\uFF01[VAR 0114(0024)]",
  "\u563F\u5440\uFF01\u8F6C\u5B66\u751F\uFF01\\n\u662F\u4F60\u53EB\u6211\u6765\u7684\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0024)]",
  "\u80FD\u591F\u5728\u65B0\u7684\u804C\u573A\u8FDB\u884C\u6311\u6218\uFF0C\\n\u6211\u5BF9\u6B64\u5174\u594B\u4E0D\u5DF2\u554A\uFF01[VAR 0114(0024)]",
  "\u6211\u4F1A\u88AB\u53EB\u5230\u8FD9\u91CC\u6765\uFF0C\\n\u5E94\u8BE5\u662F\u6709\u4EC0\u4E48\u7406\u7531\u5427\uFF01[VAR 0114(0024)]",
  "\u4F60\u5E0C\u671B\u4ECE\u6211\u8FD9\u91CC\\n\u5F97\u5230\u4EC0\u4E48\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u70ED\u8840\u7CBE\u795E",
  "\u77E5\u8BC6",
  "\u53EA\u8981\u4F60\u4EBA\u5728\u5C31\u597D",
  "\u54E6\u54E6\uFF01\u90A3\u662F\u6211\u64C5\u957F\u7684\u9886\u57DF\uFF01\\c\\n\u5C31\u7528\u6211\u7684\u70ED\u8840\u7CBE\u795E\u6765\u8BA9\u84DD\u8393\u5B66\u56ED\\n\u71C3\u70E7\u8D77\u70ED\u70C8\u7684\u6C1B\u56F4\u5427\uFF01[VAR 0114(0024)]",
  "\u54E6\u54E6\uFF01\u539F\u6765\u4F60\u5BF9\u6211\u7684\\n\u5BF9\u6218\u5B66\u77E5\u8BC6\u62B1\u6709\u671F\u5F85\u554A\uFF01\\c\\n\u8FD9\u91CC\u4E0D\u6127\u662F\u6CE8\u91CD\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u5B66\u56ED\uFF01[VAR 0114(0024)]",
  "\u90A3\u662F\u4EC0\u4E48\u7406\u7531\u554A\uFF01\\n\u4F60\u600E\u4E48\u4E86\uFF0C\u8F6C\u5B66\u751F\uFF01\uFF1F\\r\\n\u4F60\u679C\u7136\u8FD8\u662F\u5728\u8BB4\u6B4C\u9752\u6625\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u4E0D\u8BBA\u5982\u4F55\uFF0C\\n\u90FD\u5305\u5728\u70ED\u8840\u6CB8\u817E\u7684\u51F0\u6A97\u6211\u8EAB\u4E0A\u5427\uFF01[VAR 0114(0024)]",
  "\u5C31\u5F53\u662F\u6302\u5728\u94C1\u638C\u529B\u58EB\u7684\u80A9\u8180\u4E0A\uFF0C\\n\u4F60\u5C3D\u7BA1\u653E\u5FC3\u5427\uFF01[VAR 0114(0024)]",
  "\u8F6C\u5B66\u751F\uFF01\\n\u751F\u6001\u5DE8\u86CB\u771F\u68D2\u554A\uFF01[VAR 0114(0024)]",
  "\u6211\u53D1\u73B0\uFF0C\\n\u5DE8\u86CB\u5C31\u76F8\u5F53\u4E8E\u662F\u5B66\u9662\u7684\u64CD\u573A\uFF01[VAR 0114(0024)]",
  "\u8FD9\u91CC\u975E\u5E38\u5BBD\u9614\uFF0C\\n\u7279\u522B\u9002\u5408\u7528\u6765\u8DD1\u6B65\u7EC3\u4E60\u5462\uFF01[VAR 0114(0024)]",
  "\u6211\u6B63\u8003\u8651\u4E0B\u5802\u8BFE\\n\u7528\u5B9E\u8DF5\u7684\u5F62\u5F0F\u7ED5\u5DE8\u86CB\u8DD1\u4E00\u5708\u5462\u3002\\r\\n\u4F60\u89C9\u5F97\u5982\u4F55\u554A\uFF1F[VAR 0114(0024)]",
  "\u4E0D\u9519\u554A\uFF01",
  "\u90A3\u6837\u7684\u8BDD\u6709\u70B9\u2026\u2026",
  "\u55EF\uFF01\u8170\u817F\u80FD\u5F97\u5230\u953B\u70BC\uFF0C\\n\u80AF\u5B9A\u662F\u767E\u5229\u800C\u65E0\u4E00\u5BB3\u7684\uFF01[VAR 0114(0024)]",
  "\u4F60\u89C9\u5F97\u8FD8\u662F\u592A\u8FC7\u5934\u4E86\u5417\uFF1F\\n\u597D\u50CF\u5C31\u53EA\u6709\u6211\u60F3\u8DD1\u4E00\u6837\uFF01\\c\\n\u771F\u6CA1\u529E\u6CD5\u2026\u2026\u90A3\u5C31\u6539\u4E3A\u8DD1\u534A\u5708\u5427\uFF01[VAR 0114(0024)]",
  "\u5F53\u7136\uFF0C\\n\u6211\u4F1A\u8BA9\u4F60\u4E5F\u4E00\u8D77\u6765\u4F53\u9A8C\u7684\uFF01[VAR 0114(0024)]",
  "\u8FD9\u4E2A\u5B66\u56ED\u7684\u5B66\u751F\\n\u771F\u662F\u5145\u6EE1\u4E86\u5E72\u52B2\u554A\uFF01[VAR 0114(0024)]",
  "\u6765\u4E0A\u5BF9\u6218\u5B66\u8BFE\u7A0B\u7684\u5B66\u751F\uFF0C\\n\u6CE8\u610F\u529B\u771F\u662F\u4E0D\u540C\u51E1\u54CD\uFF01[VAR 0114(0024)]",
  "\u542C\u8BF4\u5728\u8FD9\u4E2A\u5B66\u56ED\uFF0C\\n\u8D8A\u662F\u548C\u6218\u6597\u6709\u5173\u7684\u8BFE\u7A0B\uFF0C\\r\\n\u6210\u7EE9\u7684\u5360\u6BD4\u5C31\u8D8A\u9AD8\uFF01[VAR 0114(0024)]",
  "\u53EA\u8981\u64C5\u957F\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\u5C31\u6709\u5E0C\u671B\\n\u5F53\u8054\u76DF\u804C\u5458\uFF0C\u52A0\u5165\u5DE1\u62A4\u5458\u90E8\u961F\uFF0C\\r\\n\u6216\u662F\u6210\u4E3A\u4E13\u4E1A\u7684\u8BAD\u7EC3\u5BB6\u54E6\uFF01[VAR 0114(0024)]",
  "\u8D85\u591A\u7684\u68A6\u60F3\uFF01",
  "\u771F\u7684\u5417\uFF01\uFF1F",
  "\u5F53\u7136\uFF0C\u4F60\u7684\u76EE\u6807\u4E5F\u53EF\u4EE5\u662F\u6210\u4E3A\\n\u50CF\u6211\u4E00\u6837\u7684\u5BF9\u6218\u5B66\u8001\u5E08\u54E6\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u4F60\u662F\u7B2C\u4E00\u6B21\u542C\u8BF4\u5417\uFF01\uFF1F\\c\\n\u4F60\u4E0D\u77E5\u60C5\uFF0C\u5C45\u7136\u8FD8\u80FD\u5F53\u4E0A\u51A0\u519B\uFF0C\\n\u53EF\u89C1\u4F60\u662F\u6253\u5FC3\u773C\u91CC\u559C\u6B22\u5B9D\u53EF\u68A6\u554A\uFF01[VAR 0114(0024)]",
  "\u4E0D\u7BA1\u662F\u5BF9\u6218\u5B66\uFF0C\u8FD8\u662F\u4EFB\u4F55\u4E8B\u7269\uFF0C\\n\u53EA\u8981\u52AA\u529B\u5B66\u4E60\uFF0C\\r\\n\u5C31\u80FD\u62E5\u6709\u65E0\u9650\u7684\u9009\u62E9\uFF01[VAR 0114(0024)]",
  "\u4E3A\u4E86\u5C06\u6765\u4E0D\u540E\u6094\uFF0C\\n\u4F60\u8981\u597D\u597D\u5B66\u4E60\u554A\uFF0C\u8F6C\u5B66\u751F\uFF01[VAR 0114(0024)]",
  "\u2026\u2026\u6211\u597D\u50CF\u6709\u70B9\\n\u5728\u5BF9\u4F60\u8BF4\u6559\u7684\u611F\u89C9\u554A\uFF01[VAR 0114(0024)]",
  "\u4E0D\u8BBA\u662F\u4F5C\u4E3A\u8001\u5E08\u8FD8\u662F\u6218\u53CB\uFF0C\\n\u6211\u90FD\u4F1A\u5F88\u5173\u6CE8\u4F60\u54E6\u3002[VAR 0114(0024)]",
  "\u4E3A\u4E86\u4FC3\u8FDB\u6211\u4EEC\u7684\u611F\u60C5\uFF0C\\n\u6765\u4EA4\u6362\u5B9D\u53EF\u68A6\u5427\uFF01\uFF1F[VAR 0114(0024)]",
  "\u597D\uFF01\u90A3\u6211\u4EEC\u5F00\u59CB\u5427\uFF01\\n\u6211\u6253\u7B97\u9009\u739B\u6C99\u90A3\uFF01\\r\\n[VAR 0100(0000)]\uFF0C\u4F60\u8981\u9009\u54EA\u4E2A\u5B69\u5B50\u5462\uFF1F[VAR 0114(0024)]",
  "\u4F60\u9009[VAR 0101(0001)]\u554A\uFF01\\n\u6211\u611F\u89C9\u5B83\u633A\u563F\u5440\u7684\uFF0C\u771F\u68D2\uFF01\\c\\n\u6211\u4F1A\u6BCF\u5929\u953B\u70BC\u5B83\uFF0C\\n\u8BA9\u5B83\u5F3A\u5230\u9006\u5929\uFF01[VAR 0114(0024)]",
  "\u90A3\u4E48\u8F6C\u5B66\u751F\u4F60\u7684[VAR 0101(0001)]\\n\u5C31\u548C\u6211\u7684\u739B\u6C99\u90A3\u6765\u4EA4\u6362\u54AF\uFF01[VAR 0114(0024)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u540C\u884C\u5B9D\u53EF\u68A6\u53EA\u6709\uFF11\u53EA\u7684\u8BDD\uFF0C\\n\u662F\u4E0D\u80FD\u4EA4\u6362\u7684\uFF01\\c\\n\u7B49\u4F60\u540C\u884C\u5B9D\u53EF\u68A6\u6709\uFF12\u53EA\u4EE5\u4E0A\u4E4B\u540E\uFF0C\\n\u518D\u6765\u627E\u6211\u563F\u5440\u5427\uFF01[VAR 0114(0024)]",
  "\u73B0\u5728\u5148\u4E0D\u7528\u4EA4\u6362\u5417\uFF1F\\n\u7B49\u4F60\u60F3\u563F\u5440\u65F6\u518D\u6765\u548C\u6211\u8BF4\u5427\uFF01[VAR 0114(0024)]",
  "\u563F\u5440\uFF01\u8F6C\u5B66\u751F\uFF01\\c\\n\u4F60\u613F\u610F\u5F00\u59CB\u548C\u6211\\n\u4EA4\u6362\u5B9D\u53EF\u68A6\u4E86\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u563F\u5440\uFF01\u8F6C\u5B66\u751F\uFF01\\n\u4F60\u8981\u9080\u8BF7\u6211\u6253\u5B9D\u53EF\u68A6\u5BF9\u6218\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u539F\u6765\u4E0D\u662F\u554A\u2026\u2026\\n\u8981\u5BF9\u6218\u7684\u8BDD\uFF0C\u6211\u968F\u65F6\u5949\u966A\uFF01[VAR 0114(0024)]",
  "\u6211\u6CA1\u6709\u4EFB\u4F55\u7406\u7531\u62D2\u7EDD\uFF01\\n\u6211\u4EEC\u8DD1\u53BB\u5BF9\u6218\u573A\u5427\uFF01[VAR 0114(0024)]",
  "[~ 62]",
  "\u4E0D\u7518\u5FC3\u554A\u2026\u2026\uFF01\\n\u6211\u53C8\u88AB\u5F7B\u5E95\u6253\u8D25\u4E86\uFF01[VAR 0114(0024)]",
  "\u4F46\u662F\u6211\u7684\u6536\u83B7\u4E5F\u5F88\u5927\uFF01\\n\u6211\u4F1A\u5438\u53D6\u7ECF\u9A8C\uFF0C\u4E0B\u6B21\u4E00\u5B9A\u8981\u8D62\u4F60\uFF01[VAR 0114(0024)]",
  "\u591A\u8C22\u8F6C\u5B66\u751F\u4F60\u7684\u5173\u7167\uFF01\\n\u6536\u4E0B\u6211\u7684\u5FC3\u610F\u5427\uFF01[VAR 0114(0024)]",
  "\u4E00\u53E3\u6C14\u559D\u6389\u653B\u51FB\u589E\u5F3A\u5242\u540E\uFF0C\\n\u8BA9\u6211\u4EEC\u671D\u7740\u5915\u9633\u563F\u5440\u5427\uFF01[VAR 0114(0024)]",
  "[~ 62]",
  "\u4ECA\u5929\u7684\u5BF9\u6218\u4E5F\u5F88\u68D2\u54E6\uFF01\\n\u8F6C\u5B66\u751F\uFF0C\u8C22\u8C22\u4F60\uFF01[VAR 0114(0024)]",
  "\u4E0B\u6B21\u522B\u60F3\u50CF\u8FD9\u6B21\u4E00\u6837\u54E6\uFF01\\n\u8BA9\u6211\u4EEC\u671D\u7740\u5915\u9633\u563F\u5440\u5427\uFF01[VAR 0114(0024)]",
  "\u8FD9\u6B21\u662F\u6211\u8D62\u4E86\uFF01\\n\u6211\u4FDD\u4F4F\u4E86\u5BF9\u6218\u5B66\u8001\u5E08\u7684\u9762\u5B50\uFF01\\c\\n\u4F60\u5C31\u770B\u7740\u5927\u6D77\uFF0C\\n\u541E\u4E0B\u8F93\u6389\u7684\u4E0D\u7518\u5FC3\u5427\uFF01[VAR 0114(0024)]",
  "\u8054\u76DF\u793E\u7684\u6D3B\u52A8\u5BA4\u91CC\\n\u6324\u6EE1\u4E86\u5E74\u8F7B\u4EBA\uFF0C\\r\\n\u771F\u662F\u9752\u6625\u6C14\u606F\u7206\u68DA\u5440\uFF01[VAR 0114(0024)]",
  "\u5176\u5B9E\u554A\uFF0C\\n\u6211\u6709\u4E9B\u5BB3\u6015\u5750\u98DE\u673A\u2026\u2026\\c\\n\u6240\u4EE5\u6765\u84DD\u8393\u5B66\u56ED\u5BF9\u6211\u6765\u8BF4\uFF0C\\n\u662F\u975E\u5E38\u9700\u8981\u6C14\u52BF\u7684\u4E00\u4EF6\u4E8B\uFF01[VAR 0114(0024)]",
  "\u5728\u5BF9\u6218\u4E2D\u4E5F\u662F\\n\u53EF\u4EE5\u953B\u70BC\u8EAB\u4F53\u7684\uFF01\\c\\n\u4E0B\u6B21\u5BF9\u6218\u65F6\u5C31\u770B\u770B\u6211\u5427\uFF01\\n\u6211\u5C31\u662F\u9760\u90A3\u4E2A\u52A8\u4F5C\u6765\u63D0\u5347\u5FC3\u80BA\u529F\u80FD\u7684\uFF01[VAR 0114(0024)]",
  "\u8F6C\u5B66\u751F\u7684[VAR 0101(0001)]\\n\u4ECA\u5929\u4E5F\u5145\u6EE1\u6D3B\u529B\uFF01\\c\\n\u6211\u505A\u7684\u4E09\u660E\u6CBB\\n\u5B83\u4E5F\u5403\u5F97\u6D25\u6D25\u6709\u5473\u54E6\uFF01[VAR 0114(0024)]",
  "\u6211\u4EA4\u6362\u7ED9\u4F60\u7684\u739B\u6C99\u90A3\u6700\u8FD1\u5982\u4F55\uFF01\uFF1F\\n\u90A3\u5B69\u5B50\u662F\u62F3\u51FB\u9AD8\u624B\uFF01\\c\\n\u65E0\u8BBA\u654C\u4EBA\u6709\u591A\u5F3A\uFF0C\\n\u5B83\u90FD\u4F1A\u7528\u5404\u79CD\u5404\u6837\u7684\u62F3\u51FB\u5C06\u5BF9\u65B9\u51FB\u788E\uFF01[VAR 0114(0024)]"
]
