[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u4EEC\u5F00\u59CB\u4E0A\u8BFE\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0B\u6B21\u8981\u671F\u672B\u8003\u8BD5\uFF0C\\n\u6240\u4EE5\u4ECA\u5929\u662F\u6700\u540E\u4E00\u5802\u8BFE\u3002[VAR 0114(002A)]",
  "\u6700\u540E\u7684\u4E3B\u9898\u662F\u2026\u2026\\n\u9535\u9535\u9535\u9535\uFF5E\uFF01\u5B9D\u53EF\u68A6\u7684[VAR FF00(0006)]\u5F62\u6001[VAR FF00(0000)]\u3002\\r\\n\u5927\u5BB6\u5C31\u7406\u89E3\u4E3A\u5B9D\u53EF\u68A6\u7684\u5916\u578B\u5427\u3002[VAR 0114(002A)]",
  "\u5B9D\u53EF\u68A6\u7684\u540C\u4E00\u4E2A\u4F53\\n\u5728\u67D0\u79CD\u6761\u4EF6\u4E0B\u6539\u53D8\u5F62\u6001\uFF0C\\r\\n\u8FD9\u5C31\u53EB\u505A[VAR FF00(0006)]\u5F62\u6001\u53D8\u5316[VAR FF00(0000)]\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4F8B\u5982\u5728\u5E15\u5E95\u4E9A\u901A\u5E38\u88AB\u5F53\u505A\\n\u5750\u9A91\u5B9D\u53EF\u68A6\u7684\u6469\u6258\u8725\uFF0C\\r\\n\u5B83\u5C31\u6709\uFF13\u79CD\u5F62\u6001\u3002[VAR 0114(002A)]",
  "\u5E73\u5E38\u662F\u7528\u56DB\u811A\u6B65\u884C\u7684\u539F\u751F\u5F62\u6001\uFF0C\\n\u6218\u6597\u65F6\u5219\u4F1A\u53D8\u6210\u7528\u53CC\u811A\u7AD9\u7ACB\u7684\u5BF9\u6218\u5F62\u6001\u3002[VAR 0114(002A)]",
  "\u7136\u540E\u5F53\u4EBA\u4EEC\u8981\u9A91\u4E58\u5B83\u65F6\uFF0C\\n\u5B83\u5C31\u4F1A\u81A8\u8D77\u5589\u56CA\u548C\u5C3E\u5DF4\uFF0C\\r\\n\u53D8\u6210\u5750\u9A91\u5F62\u6001\uFF0C\u5BF9\u5427\uFF5E[VAR 0114(002A)]",
  "\u53E6\u5916\u7528\u5927\u5BB6\u719F\u6089\u7684\u4E1C\u897F\u6765\u8BF4\uFF0C\\n\u5C31\u662F\u5927\u5BB6\u6240\u62E5\u6709\u7684\u673A\u68B0\u2026\u2026[VAR 0114(002A)]",
  "\u50CF\u662F\u6709\u4E9B\u624B\u673A\\n\u4E5F\u4F1A\u6709\u67D0\u79CD\u5B9D\u53EF\u68A6\u5728\u91CC\u9762\u54E6\uFF5E[VAR 0114(002A)]",
  "\u90A3\u4E48\uFF5E\u5728\u624B\u673A\u91CC\u7684\\n\u7A76\u7ADF\u662F\u4EC0\u4E48\u5B9D\u53EF\u68A6\u5462\uFF1F[VAR 0114(002A)]",
  "\u6D1B\u6258\u59C6",
  "\u76AE\u5361\u4E18",
  "\u8D6B\u62C9\u514B\u7F57\u65AF",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u5BF9\u673A\u68B0\u548C\u5B9D\u53EF\u68A6\u90FD\u5F88\u719F\u6089\u5462\uFF5E[VAR 0114(002A)]",
  "\u786E\u5B9E\uFF0C\u5982\u679C\u624B\u673A\u91CC\u80FD\u6709\\n\u76AE\u5361\u4E18\u90A3\u5C31\u592A\u53EF\u7231\u4E86\uFF0C\\r\\n\u8BF4\u4E0D\u5B9A\u4F1A\u8BA9\u4EBA\u60F3\u591A\u8D70\u8D70\u5462\uFF01\\r\\n\u2026\u2026\u4F46\u53EF\u60DC\u56DE\u7B54\u9519\u8BEF\u4E86\u54E6\uFF5E\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\u771F\u6709\u624D\uFF01\\n\u786E\u5B9E\u8D6B\u62C9\u514B\u7F57\u65AF\u80FD\u5B66\u4F1A\u4FEE\u957F\u4E4B\u89D2\uFF0C\\r\\n\u96BE\u9053\u662F\u7528\u5C16\u5C16\u7684\u89D2\u523A\u8FDB\u624B\u673A\u91CC\uFF01\uFF1F\\r\\n\u2026\u2026\u4F46\u53EF\u60DC\u56DE\u7B54\u9519\u8BEF\u4E86\u54E6\uFF5E\uFF01[VAR 0114(002A)]",
  "\u603B\u4E4B\uFF0C\u5728\u5927\u5BB6\u624B\u673A\\n\u91CC\u9762\u7684\u662F\u6D1B\u6258\u59C6\uFF0C\\r\\n\u5B83\u4F1A\u5728\u5404\u65B9\u9762\u5E2E\u52A9\u5927\u5BB6\u54E6\uFF5E[VAR 0114(002A)]",
  "\u624B\u673A\u6D1B\u6258\u59C6\u7684\u6D1B\u6258\u59C6\u5F88\u7279\u522B\uFF0C\\n\u5B83\u4E0D\u4F1A\u8FDB\u5230\u522B\u7684\u7535\u5668\u91CC\u9762\u53BB\u3002[VAR 0114(002A)]",
  "\u4F46\u4E00\u822C\u7684\u6D1B\u6258\u59C6\u4F1A\u901A\u8FC7\\n\u8FDB\u5165\u6D17\u8863\u673A\u6216\u5FAE\u6CE2\u7089\uFF0C\\r\\n\u6765\u6539\u53D8\u81EA\u5DF1\u7684\u5F62\u6001\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4E0D\u8FC7\uFF0C\u6D1B\u6258\u59C6\u7B97\u662F\u4E00\u79CD\u4F8B\u5916\u3002\\n\u4E00\u822C\u6765\u8BF4\uFF0C\u8FD8\u662F\u901A\u8FC7\u6301\u6709\u7269\u6216\u9053\u5177\\r\\n\u6765\u6539\u53D8\u5F62\u6001\u7684\u5B9D\u53EF\u68A6\u6BD4\u8F83\u591A\u3002[VAR 0114(002A)]",
  "\u6BD4\u5982\uFF0C\u7ED9\u82B1\u821E\u9E1F\u82B1\u871C\uFF0C\\n\u5B83\u5C31\u53EF\u4EE5\u53D8\u5316\u6210\uFF14\u79CD\u4E0D\u540C\u7684\u5F62\u6001\u3002[VAR 0114(002A)]",
  "\u6709\u4E9B\u5B9D\u53EF\u68A6\u5728\u6539\u53D8\u5F62\u6001\u540E\uFF0C\\n\u8FDE\u5C5E\u6027\u548C\u62DB\u5F0F\u90FD\u4F1A\u4E00\u8D77\u6539\u53D8\u54E6\uFF5E[VAR 0114(002A)]",
  "\u5F62\u6001\u53D8\u5316\u4E0E\u8FDB\u5316\u4E0D\u540C\uFF0C\\n\u5B9D\u53EF\u68A6\u53EF\u4EE5\u53D8\u56DE\u539F\u672C\u7684\u6837\u5B50\u3002\\c\\n\u4E0E\u5F02\u8272\u4E5F\u4E0D\u4E00\u6837\uFF0C\\n\u662F\u540C\u4E00\u4E2A\u4F53\u4F1A\u53D8\u4E3A\u4E0D\u540C\u7684\u6837\u5B50\u3002[VAR 0114(002A)]",
  "\u5F62\u6001\u53D8\u5316\u2026\u2026\\n\u771F\u662F\u6DF1\u5965\u7684\u73B0\u8C61\u5462\uFF5E[VAR 0114(002A)]",
  "\u5E0C\u671B\u4F60\u4EEC\u80FD\u50CF\u5B9D\u53EF\u68A6\u5B66\u4E60\u2026\u2026\\n\u867D\u7136\u8FD9\u4E48\u8BF4\u6709\u70B9\u602A\u3002[VAR 0114(002A)]",
  "\u4F46\u6211\u5E0C\u671B\u4F60\u4EEC\u4E5F\u80FD\u5728\u8FD9\u6240\u5B66\u6821\\n\u597D\u597D\u5B66\u4E60\uFF0C\u5C3D\u60C5\u73A9\u800D\u2026\u2026[VAR 0114(002A)]",
  "\u5F62\u6001\u53D8\u5316\u51FA\u5D2D\u65B0\u7684\u81EA\u5DF1\uFF01\\n\u8FD9\u6837\u6211\u5C31\u4F1A\u5F88\u6B23\u6170\u4E86\uFF5E\\r\\n\u2026\u2026\u5F00\u73A9\u7B11\u7684\uFF01[VAR 0114(002A)]",
  "\u554A\u554A\uFF01\u6211\u5FD8\u8BB0\u8BF4\u4E86\uFF01[VAR 0114(002A)]",
  "\u968F\u5730\u533A\u800C\u4E0D\u540C\u7684\u5730\u533A\u5F62\u6001\\n\u548C\u4E00\u822C\u7684\u6837\u5B50\u4E0D\u4E00\u6837\uFF0C\\r\\n\u90A3\u662F\u4E0D\u4F1A\u6539\u53D8\u7684\uFF0C\u5C5E\u4E8E\u662F\u5148\u5929\u6027\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u563B\u563B\uFF0C\\n\u4E0B\u8BFE\u94C3\u54CD\u4E86\u3002[VAR 0114(002A)]",
  "\u5230\u6700\u540E\u90FD\u8FD9\u6837\uFF0C\u5B9E\u5728\u62B1\u6B49\u3002\\c\\n\u4F46\u6211\u6BCF\u5802\u8BFE\u90FD\u4E0A\u5F97\u5F88\u5F00\u5FC3\u3002\\n\u671F\u672B\u8003\u8BD5\u8BF7\u52A0\u6CB9\u54E6\uFF5E[VAR 0114(002A)]"
]
