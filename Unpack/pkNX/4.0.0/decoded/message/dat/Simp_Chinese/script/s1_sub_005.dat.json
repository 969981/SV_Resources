[
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01[VAR 0114(0041)]",
  "\u8FD9\u91CC\u53EF\u771F\u662F\u4E2A\u68D2\u5230\\n\u6BEB\u65E0\u770B\u5934\u7684\u5730\u65B9\u5462\uFF01[VAR 0114(0041)]",
  "\u6211\u8981\u627E\u7684\u5C31\u662F\u8FD9\u79CD\u5730\u65B9\uFF01\\n\u8C22\u8C22\u4F60\uFF0C\u6BC5\u4E07\uFF01[VAR 0114(0041)]",
  "\u592A\u597D\u5566\uFF01\u80FD\u8BA9\u99A5\u597D\u4F60\u5F00\u5FC3\\n\u5C31\u662F\u6211\u7684\u5E78\u798F\uFF01[VAR 0114(0040)]",
  "\u628A\u8FD9\u5757\u5730\u4E70\u4E0B\u6765\u505A\u751F\u610F\\n\u4F3C\u4E4E\u4E5F\u4E0D\u9519\u5462\u3002[VAR 0114(0041)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u6BCF\u6B21\u90FD\u80FD\u9047\u5230\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u8FD8\u771F\u662F\u3002\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u90A3\u5C31\u662F\u6BCF\u6B21\u90FD\u80FD\u9047\u5230\u7684\u5EB6\u6C11\u5462\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u7684\u8D85\u51E1\u9B45\u529B\u65E0\u8BBA\u4F55\u65F6\\n\u90FD\u4F1A\u5C06\u4EBA\u4EEC\u5438\u5F15\u8FC7\u6765\u5462\uFF01[VAR 0114(0040)]",
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u751A\u597D\uFF01\u751A\u597D\uFF01[VAR 0114(0041)]",
  "\u4E3A\u5927\u4F17\u5E26\u6765\u68A6\u60F3\\n\u6B63\u662F\u6211\u7B49\u540D\u6D41\u7684\u804C\u8D23\u2026\u2026[VAR 0114(0041)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u6211\u8981\u628A\\n\u8FD9\u4EFD\u9053\u5177\u8D60\u4E0E\u4F60\u3002[VAR 0114(0041)]",
  "\u8FD9\u4F4D\u5EB6\u6C11\uFF0C\u4ED4\u7EC6\u542C\u597D\u54E6\u3002\\n\u6240\u8C13\u94B1\uFF0C\u6B63\u662F\u5B58\u5728\u4E8E\u4EC0\u4E48\u90FD\u6CA1\u6709\u7684\u5730\u65B9\u3002[VAR 0114(0041)]",
  "\u65E0\u8BBA\u4F55\u65F6\uFF0C\u53EF\u80FD\u6027\\n\u90FD\u662F\u4E00\u7247\u84DD\u6D77\u5462\u2026\u2026[VAR 0114(0041)]",
  "\u54CE\uFF01\uFF1F\u592A\u53D1\u4EBA\u6DF1\u7701\u4E86\uFF01\\n\u771F\u662F\u6E17\u900F\u5FC3\u7075\u7684\u91D1\u53E5\u554A\uFF01\\r\\n\u5C31\u50CF\u662F\u505A\u5B8C\u745C\u4F3D\u540E\u559D\u7684\u70ED\u6C34\u4E00\u6837\u2026\u2026\uFF01\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\\n\u6211\u60F3\u53BB\u5317\u4E0A\u4E61\\r\\n\u54C1\u5C1D\u4E00\u4E0B[VAR FF00(0006)]\u6C34\u679C[VAR FF00(0000)]\u5462\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\u4E4B\u524D\u624D\u53BB\u8FC7\u7684\u5730\u65B9\uFF0C\\n\u73B0\u5728\u53C8\u8981\u53BB\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5440\uFF01[VAR 0114(0040)]",
  "\u6211\u4F1A\u4EB2\u624B\u69A8\u5F88\u591A\\n\u82F9\u679C\u6C41\u7ED9\u4F60\u559D\u7684\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u4E07\u5148\u751F\\n\u5DF2\u7ECF\u524D\u5F80\u5357\u7B2C\uFF15\u533A\u548C\u5357\u7B2C\uFF11\u533A\u7684\\r\\n\u4EA4\u754C\u5904\u9644\u8FD1\u4E86\u3002"
]
