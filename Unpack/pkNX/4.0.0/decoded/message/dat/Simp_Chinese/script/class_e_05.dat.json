[
  "\u4ECA\u5929\u4E5F\u8981\u7CBE\u529B\u5145\u6C9B\u5730\u5B66\u4E60\u5BF9\u6218\u5B66\uFF01\\n\u563F\u5440\uFF01\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01[VAR 0114(0024)]",
  "\u540C\u5B66\u4EEC\u5728\u671F\u4E2D\u8003\u8BD5\\n\u90FD\u6253\u4E86\u4E00\u573A\u6F02\u4EAE\u7684\u5BF9\u6218\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]",
  "\u4ECE\u4ECA\u5929\u8D77\uFF0C\u8BFE\u7A0B\u5C31\u8FDB\u5165\u4E86\u540E\u534A\u6BB5\uFF01\\n\u540C\u5B66\u4EEC\u62FF\u51FA\u5E72\u52B2\uFF0C\u8BA4\u771F\u5B66\u4E60\u5427\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u6709\u5728\u4F7F\u7528\\n\u201C\uFF32\u952ELet\u0027s Go\u201D\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5B83\u80FD\u8BA9\u5B9D\u53EF\u68A6\\n\u5411\u7740\u524D\u65B9Let\u0027s Go\uFF01[VAR 0114(0024)]",
  "\u8BA9\u5B83\u5E2E\u5FD9\u6361\u6361\u8FDC\u5904\u7684\u9053\u5177\uFF01\\n\u662F\u4E2A\u975E\u5E38\u65B9\u4FBF\u7684\u53E3\u8BC0\u54E6\uFF01[VAR 0114(0024)]",
  "\u8981\u662FLet\u0027s Go\u7684\u524D\u65B9\\n\u6709\u91CE\u751F\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\r\\n\u6D3E\u53BB\u7684\u5B9D\u53EF\u68A6\u5C31\u4F1A\u76F4\u63A5\u5C55\u5F00\u6218\u6597\uFF01[VAR 0114(0024)]",
  "\u800C\u6211\u4EEC\u628A\u8FD9\u6837\u7684\u6218\u6597\u79F0\u4E3A\\n\u81EA\u4E3B\u5BF9\u6218\uFF01\uFF01[VAR 0114(0024)]",
  "\u6B63\u5982\u5176\u540D\uFF0C\\n\u8BAD\u7EC3\u5BB6\u4E0D\u7528\u6307\u6325\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u800C\u662F\u8BA9\u5B9D\u53EF\u68A6\u81EA\u5DF1\u53BB\u5BF9\u6218\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u6218\u80DC\u4E86\uFF0C\\n\u5B9D\u53EF\u68A6\u5C31\u4F1A\u50CF\u5E73\u65F6\u90A3\u6837\u83B7\u5F97\u7ECF\u9A8C\u503C\uFF01[VAR 0114(0024)]",
  "\u719F\u7EC3\u8FD0\u7528\u81EA\u4E3B\u5BF9\u6218\u7684\u8BDD\uFF0C\\n\u5C31\u80FD\u6709\u6548\u7387\u5730\u953B\u70BC\u540C\u884C\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0024)]",
  "\u4F46\u662F\u5B9D\u53EF\u68A6\u5373\u4F7F\u5728\u81EA\u4E3B\u5BF9\u6218\u4E2D\\n\u7B49\u7EA7\u63D0\u5347\u4E86\uFF0C\u5B83\u4E5F\u65E0\u6CD5\u5B66\u4F1A\u65B0\u62DB\u5F0F\uFF0C\\r\\n\u4E5F\u4E0D\u4F1A\u8FDB\u5316\u3002\u8FD9\u70B9\u8981\u6CE8\u610F\uFF01[VAR 0114(0024)]",
  "\u6B64\u5916\uFF0C\u5982\u679C\u5B9D\u53EF\u68A6\u5728\u81EA\u4E3B\u5BF9\u6218\u4E2D\u6218\u8D25\u4E86\uFF0C\\n\u5B83\u5C31\u4F1A\u7528\u4EC5\u5269\u7684\u4F53\u529B\u56DE\u5230\u8BAD\u7EC3\u5BB6\u8EAB\u65C1\u3002\\r\\n\u8FD9\u65F6\u4E00\u5B9A\u8981\u7ACB\u523B\u5E2E\u5B83\u56DE\u590D\u4F53\u529B\uFF01[VAR 0114(0024)]",
  "\u5927\u81F4\u5C31\u662F\u8FD9\u6837\u4E86\u3002\\n\u5230\u6B64\u4E3A\u6B62\uFF0C\u540C\u5B66\u4EEC\u6709\u4EC0\u4E48\u7591\u95EE\u5417\uFF1F[VAR 0114(0024)]",
  "\u600E\u4E48\u4E2D\u65AD\u81EA\u4E3B\u5BF9\u6218\uFF1F",
  "\u53EF\u4EE5\u6355\u6349\u5B9D\u53EF\u68A6\u5417\uFF1F",
  "\u6CA1\u4EC0\u4E48\u95EE\u9898",
  "\u81EA\u4E3B\u5BF9\u6218\u4E00\u65E6\u5F00\u59CB\uFF0C\\n\u5728\u5206\u51FA\u80DC\u8D1F\u4E4B\u524D\u662F\u65E0\u6CD5\u4E2D\u65AD\u7684\uFF01\\c\\n\u4F46\u5728\u81EA\u4E3B\u5BF9\u6218\u5F00\u59CB\u4E4B\u524D\uFF0C\\n\u5B9D\u53EF\u68A6\u8FD8\u5728\u79FB\u52A8\u7684\u671F\u95F4\uFF0C\\r\\n\u5C31\u80FD\u7528\u201C\uFF3A\uFF32\u952E\u6295\u7403\uFF01\u201D\u6765\u4E2D\u65AD\uFF01[VAR 0114(0024)]",
  "\u5728\u81EA\u4E3B\u5BF9\u6218\u65F6\u5982\u679C\u4E0D\u7406\u4F1A\u5B83\uFF0C\\n\u5B83\u5C31\u4F1A\u5C06\u5BF9\u624B\u6253\u5012\uFF01\\c\\n\u56E0\u6B64\u5982\u679C\u60F3\u6355\u6349\u5BF9\u624B\u7684\u8BDD\uFF0C\\n\u5C31\u5FC5\u987B\u5F97\u81EA\u5DF1\u6307\u6325\u5B9D\u53EF\u68A6\u53BB\u5BF9\u6218\u54E6\uFF01[VAR 0114(0024)]",
  "\u55EF\uFF01\u5404\u4F4D\u540C\u5B66\u90FD\u5F88\u4F18\u79C0\u5462\uFF01\\n\u6211\u5F88\u671F\u5F85\u4F60\u4EEC\u7684\u672A\u6765\u54E6\uFF01[VAR 0114(0024)]",
  "\u5373\u4F7F\u662F\u5728\u81EA\u4E3B\u5BF9\u6218\u4E2D\uFF0C\\n\u5B9D\u53EF\u68A6\u4E5F\u4F1A\u4F7F\u51FA\u5168\u529B\\r\\n\u4E3A\u81EA\u5DF1\u7684\u8BAD\u7EC3\u5BB6\u6218\u6597\uFF01[VAR 0114(0024)]",
  "\u8BB0\u5F97\u8981\u9002\u65F6\u5730\u770B\u4E00\u4E0B\u5B83\u7684\u72B6\u51B5\uFF0C\\n\u8981\u662F\u5B83\u5FEB\u8981\u8F93\u6389\u7684\u8BDD\uFF0C\\r\\n\u5C31\u8D76\u7D27\u4E0B\u4EE4\u64A4\u9000\u5427\uFF01[VAR 0114(0024)]",
  "\u867D\u7136\u4E0D\u7528\u6211\u591A\u8BF4\uFF0C\\n\u4F46\u5B9D\u53EF\u68A6\u5728\uFF28\uFF30\u8F83\u5C11\u65F6\u4F1A\u75B2\u60EB\u7684\uFF01[VAR 0114(0024)]",
  "\u8FD9\u65F6\u5B83\u4F1A\u6392\u65A5\u81EA\u4E3B\u5BF9\u6218\uFF0C\\n\u5404\u4F4D\u540C\u5B66\u4E0D\u8981\u592A\u52C9\u5F3A\u5B9D\u53EF\u68A6\u54E6\uFF01[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u81EA\u4E3B\u5BF9\u6218\u662F\u5EFA\u7ACB\u5728\\n\u5F7C\u6B64\u4E4B\u95F4\u7684\u4FE1\u8D56\u5173\u7CFB\u4E0A\u7684\uFF01[VAR 0114(0024)]",
  "\u8981\u597D\u597D\u6D3B\u7528\uFF0C\\n\u53EF\u522B\u8BA9\u81EA\u5DF1\u7684\u5B9D\u53EF\u68A6\u5931\u671B\u4E86\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u4E48\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u7CBE\u529B\u5145\u6C9B\u6BCF\u4E00\u5929\uFF01[VAR 0114(0024)]"
]
