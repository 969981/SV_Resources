[
  "\u6B22\u8FCE\u6765\u5230\\n\u7C73\u83AB\u838E\u7684\u533B\u52A1\u5BA4\uFF5E[VAR 0114(0028)]",
  "\u4ECA\u5929\u54EA\u91CC\u4E0D\u8212\u670D\uFF5E\uFF1F\\n\u4F60\u548C\u4F60\u7684\u5B9D\u53EF\u68A6\\r\\n\u770B\u8D77\u6765\u90FD\u5F88\u6709\u6D3B\u529B\u5440\u2026\u2026[VAR 0114(0028)]",
  "\u54A6\uFF1F\\n\u6211\u597D\u50CF\u4ECE\u6CA1\u89C1\u8FC7\u4F60\uFF1F[VAR 0114(0028)]",
  "\u8FD9\u6837\u554A\uFF5E\\n\u539F\u6765\u4F60\u521A\u521A\u8F6C\u5B66\u8FDB\u6765\u5440\uFF5E[VAR 0114(0028)]",
  "\u54CE\u5440\u54CE\u5440\uFF0C\\n\u8FD9\u79CD\u73A9\u6CD5\u73B0\u5728\u5DF2\u7ECF\u4E0D\u6D41\u884C\u5566\u2026\u2026[VAR 0114(0028)]",
  "\u554A\uFF5E\u4F60\u662F[VAR 0100(0000)]\uFF01\\n\u539F\u6765\u662F\u4F20\u95FB\u4E2D\u7684\u90A3\u5B69\u5B50\u5440\uFF5E[VAR 0114(0028)]",
  "\u542C\u8BF4\u4F60\u521A\u5165\u5B66\u4E0D\u4E45\u5C31\u6389\u4E0B\u60AC\u5D16\uFF0C\\n\u8FD8\u548C\u5929\u661F\u961F\u786C\u78B0\u786C\u4E4B\u7C7B\u7684\uFF1F\\r\\n\u4F60\u53EF\u662F\u76F8\uFF5E\u5F53\u706B\u7684\u8BDD\u9898\u4EBA\u7269\u54E6\u3002[VAR 0114(0028)]",
  "\u554A\uFF0C\u5BF9\u4E86\u3002\\n\u4F60\u5F00\u59CB\u5BFB\u5B9D\u4E86\u5BF9\u5427\uFF5E\uFF1F[VAR 0114(0028)]",
  "\u8981\u662F\u5728\u5916\u9762\u9047\u5230\u6709\u8DA3\u7684\u4E8B\uFF0C\\n\u5C31\u6765\u533B\u52A1\u5BA4\u544A\u8BC9\u6211\u5427\uFF5E[VAR 0114(0028)]",
  "\u56E0\u4E3A\u5440\uFF0C\u6211\u5F88\u95F2\u561B\uFF5E\\n\u6211\u4E0D\u8D1F\u8D23\u4E0A\u8BFE\uFF0C\\r\\n\u6765\u8FD9\u91CC\u7684\u53C8\u90FD\u662F\u7FD8\u8BFE\u7684\u5B66\u751F\u2026\u2026[VAR 0114(0028)]",
  "\u90A3\u5C31\u62DC\u6258\u5566\uFF5E\\n\u6211\u4EEC\u8BF4\u597D\u4E86\u54E6\uFF5E[VAR 0114(0028)]",
  "\u4E0E\u7C73\u83AB\u838E\u8001\u5E08\u7684\u5173\u7CFB\\n\u53D8\u597D\u4E86\u4E00\u4E9B\uFF01"
]
