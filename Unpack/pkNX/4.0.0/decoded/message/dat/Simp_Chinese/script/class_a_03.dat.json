[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u4EEC\u5F00\u59CB\u4E0A\u8BFE\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0A\u4E00\u5802\u8BFE\u6211\u4EEC\\n\u63D0\u5230\u4E86\u86CB\u6709\u591A\u4E48\u5B9D\u8D35\u3002[VAR 0114(002A)]",
  "\u554A\uFF0C\u5BF9\u4E86\uFF0C\u8BF7\u95EE\u5927\u5BB6\\n\u5E73\u65F6\u5728\u4F7F\u7528\u5B9D\u53EF\u68A6\u56FE\u9274\u5417\uFF1F[VAR 0114(002A)]",
  "\u4ECE\u86CB\u91CC\u5B75\u51FA\u6765\u7684\u5B9D\u53EF\u68A6\\n\u4E5F\u4F1A\u597D\uFF5E\u597D\u5730\u88AB\u6DFB\u52A0\u5230\u5B9D\u53EF\u68A6\u56FE\u9274\u91CC\u3002\\r\\n\u5927\u5BB6\u53EF\u4EE5\u653E\u5FC3\u54E6\uFF5E[VAR 0114(002A)]",
  "\u563B\u563B\u2026\u2026\\n\u5176\u5B9E\uFF0C\u5B9D\u53EF\u68A6\u56FE\u9274App\\r\\n\u662F\u6211\u505A\u7684\u3002[VAR 0114(002A)]",
  "\u867D\u7136\u662F\u5728\u6211\u6765\u8FD9\u6240\u5B66\u6821\\n\u62C5\u4EFB\u8001\u5E08\u7684\u5F88\uFF5E\u4E45\u4E4B\u524D\u2026\u2026[VAR 0114(002A)]",
  "\u4F46\u6211\u4EE5\u524D\u662F\u4E2A\u7814\u7A76\u5458\u3002[VAR 0114(002A)]",
  "\u90A3\u4E2A\u65F6\u5019\u514B\u62C9\u97E6\u5C14\u6821\u957F\\n\u4E5F\u8FD8\u4E0D\u662F\u5B66\u6821\u7684\u8001\u5E08\uFF0C\\r\\n\u6211\u548C\u4ED6\u90FD\u5728\u540C\u4E00\u4E2A\u8BBE\u65BD\u91CC\u505A\u7814\u7A76\u3002[VAR 0114(002A)]",
  "\u90A3\u65F6\u6211\u4EEC\u6BCF\u5929\u4E00\u8D77\u7814\u7A76\u5B9D\u53EF\u68A6\uFF0C\\n\u771F\u7684\u5F88\u5F00\u5FC3\u2026\u2026\\r\\n\u867D\u7136\u6211\u603B\u662F\u5728\u6328\u9A82\u3002[VAR 0114(002A)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\u6211\u600E\u4E48\u4F1A\u8BF4\u8D77\u8FD9\u4E2A\uFF1F\\n\u6211\u4E0D\u662F\u5728\u8BB2\u56FE\u9274\u7684\u4E8B\u5417\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u5BF9\u4E86\uFF0C\u4ECA\u5929\u8FD9\u5802\u8BFE\u662F\u8981\\n\u6559\u5927\u5BB6\u5173\u4E8E\u6355\u6349\u5B9D\u53EF\u68A6\u7684\u77E5\u8BC6\u54E6\u3002[VAR 0114(002A)]",
  "\u6B63\u5982\u5927\u5BB6\u6240\u77E5\uFF0C\\n\u5982\u679C\u60F3\u8981\u6355\u6349\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u9996\u5148\u662F\u8981\u524A\u5F31\u5BF9\u65B9\u7684\u4F53\u529B\u5BF9\u5427\uFF5E[VAR 0114(002A)]",
  "\u90A3\u4E48\uFF0C\u9664\u4E86\u524A\u5F31\u5B9D\u53EF\u68A6\u7684\u4F53\u529B\u4EE5\u5916\uFF0C\\n\u5927\u5BB6\u77E5\u4E0D\u77E5\u9053\u5176\u4ED6\u80FD\u591F\u5728\u5BF9\u6218\u4E2D\\r\\n\u6BD4\u8F83\u5BB9\u6613\u6355\u6349\u5B9D\u53EF\u68A6\u7684\u6280\u5DE7\u5462\uFF1F[VAR 0114(002A)]",
  "\u7ED9\u5B83\u6811\u679C",
  "\u8BA9\u5B83\u9677\u5165\u5F02\u5E38\u72B6\u6001",
  "\u8BA9\u5B83\u89C1\u8BC6\u529B\u91CF\u7684\u5DEE\u8DDD",
  "\u54CE\u5440\u5440\uFF5E\uFF1F\u90A3\u4E2A\u4E5F\u8BB8\u662F\\n\u5176\u4ED6\u5730\u533A\u7684\u65B9\u6CD5\u5462\uFF5E\uFF1F\\c\\n\u5728\u5E15\u5E95\u4E9A\u7684\u8BA4\u77E5\\n\u6709\u4E00\uFF5E\u70B9\u4E0D\u540C\u54E6\u2026\u2026[VAR 0114(002A)]",
  "\u54C7\uFF5E[VAR 0100(0000)]\uFF01\\n\u597D\u5389\u5BB3\uFF01\u56DE\u7B54\u6B63\u786E\uFF01[VAR 0114(002A)]",
  "\u54C7\u54E6\uFF5E[VAR 0100(0000)]\uFF0C\\n\u4F60\u7684\u60F3\u6CD5\u5F88\u72C2\u91CE\u5462\u2026\u2026\\c\\n\u6D3E\u51FA\u5F3A\u5927\u7684\u5B9D\u53EF\u68A6\uFF0C\u7684\u786E\u662F\\n\u80FD\u8BA9\u5BF9\u6218\u8FDB\u884C\u5F97\u6BD4\u8F83\u6709\u5229\u3002[VAR 0114(002A)]",
  "\u516C\u5E03\u7B54\u6848\u3002\u8BA9\u5B9D\u53EF\u68A6\u9677\u5165\u5F02\u5E38\u72B6\u6001\uFF0C\\n\u5C31\u4F1A\u6BD4\u8F83\u5BB9\u6613\u6355\u6349\u5B83\u54E6\uFF5E[VAR 0114(002A)]",
  "\u5C24\u5176\u662F\u7761\u7720\u72B6\u6001\uFF0C\\n\u80FD\u591F\u5927\uFF5E\u5E45\u5EA6\u5730\u63D0\u9AD8\u6355\u83B7\u7387\uFF01[VAR 0114(002A)]",
  "\u53EA\u8981\u6709\u50AC\u7720\u7C89\u3001\u50AC\u7720\u672F\u8FD9\u7C7B\\n\u80FD\u591F\u8BA9\u5BF9\u65B9\u7761\u7740\u7684\u62DB\u5F0F\uFF0C\\r\\n\u5C31\u80FD\u6DFB\u52A0\u8BB8\u591A\u5B9D\u53EF\u68A6\u5230\u56FE\u9274\u91CC\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6B64\u5916\uFF0C\u60F3\u8981\u63D0\u5347\u6355\u83B7\u7387\u7684\u8BDD\uFF0C\\n\u4E5F\u53EF\u4EE5\u9488\u5BF9\u5B9D\u53EF\u68A6\u9009\u62E9\u9002\u5408\u5B83\u7684\u7403\u3002[VAR 0114(002A)]",
  "\u6216\u8005\u901A\u8FC7\u5403\u4E1C\u897F\u83B7\u5F97\u6355\u83B7\u529B\uFF0C\\n\u53E6\u5916\u4E5F\u53EF\u4EE5\u4ECE\u5B9D\u53EF\u68A6\u7684\u8EAB\u540E\u5C55\u5F00\u5BF9\u6218\u3002[VAR 0114(002A)]",
  "\u5982\u679C\u4F60\u5728\u6355\u6349\u5B9D\u53EF\u68A6\u65F6\u611F\u89C9\u5230\u74F6\u9888\uFF0C\\n\u53EF\u4EE5\u53BB\u95EF\u9053\u9986\u6536\u96C6\u9053\u9986\u5FBD\u7AE0\u3002[VAR 0114(002A)]",
  "\u63D0\u5347\u81EA\u5DF1\u80FD\u6355\u6349\u7684\u5B9D\u53EF\u68A6\u7684\u7B49\u7EA7\\n\u4E5F\u662F\u76F8\u5F53\u91CD\u8981\u7684\u54E6\uFF5E[VAR 0114(002A)]",
  "\u5F53\u5B9D\u53EF\u68A6\u56FE\u9274\u586B\u5F97\u5DEE\u4E0D\u591A\u65F6\uFF0C\u8BF7\u52A1\u5FC5\uFF01\\n\u62FF\u6765\u7ED9\u5409\u5C3C\u4E9A\u8001\u5E08\u6211\u770B\u770B\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u4E5F\u5F88\u5F00\u5FC3\u5462\u3002\\n\u4E0B\u4E00\u5802\u8BFE\u8981\u8003\u8BD5\u54E6\uFF5E[VAR 0114(002A)]"
]
