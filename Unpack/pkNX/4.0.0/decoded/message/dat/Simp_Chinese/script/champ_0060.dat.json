[
  "\u5EFA\u8BAE\u4F60\u53BB\u9053\u9986\u4E4B\u524D\uFF0C\\n\u5148\u6765\u4E00\u8D9F\u57CE\u9547\u91CC\u7684\u5BF9\u6218\u573A\u3002[VAR 0114(0004)]",
  "\u63D0\u524D\u4E86\u89E3\u4E00\u4E0B\u573A\u5730\u7684\\n\u4F4D\u7F6E\u548C\u6750\u8D28\u4E4B\u7C7B\u7684\u3002\\r\\n\u56E0\u4E3A\u8FD9\u4E9B\u53EF\u80FD\u4F1A\u5F71\u54CD\u6218\u5C40\uFF01[VAR 0114(0004)]",
  "\u2026\u2026[VAR 0100(0000)]\uFF0C\\n\u4E00\u770B\u4F60\u7684\u8868\u60C5\u6211\u5C31\u77E5\u9053\uFF01\\r\\n\u4F60\u73B0\u5728\u8D8A\u6765\u8D8A\u5389\u5BB3\u4E86\u5427\uFF1F[VAR 0114(0004)]",
  "\u90A3\u6211\u4E5F\u7528\u66F4\u786C\u6C14\u4E00\u70B9\u7684\\n\u5B9D\u53EF\u68A6\u548C\u4F60\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "\u90A3\u597D\uFF5E\\n[VAR 0100(0000)]\uFF0C\u8BF7\u591A\u6307\u6559\u3002[VAR 0114(0004)]",
  "\u8BA9\u6211\u4EEC\u6765\u4E00\u573A\u5927\u6709\u6536\u83B7\u7684\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "\u4F60\u73B0\u5728\u6709\uFF12\u4E2A\u9053\u9986\u5FBD\u7AE0\u5427\uFF01\uFF1F\\n\u53EA\u6709\uFF12\u4E2A\u7684\u4EBA\u54EA\u6709\u4F60\u8FD9\u4E48\u5389\u5BB3\u7684\u554A\uFF5E\uFF01[VAR 0114(0004)]",
  "\u5BF9\u4E0D\u8D77\uFF01\u6211\u6D3E\u51FA\u592A\u591A\\n\u5F3A\u8FC7\u5934\u7684\u5B9D\u53EF\u68A6\u4E86\u3002[VAR 0114(0004)]",
  "\u54CE\u5440\uFF5E\u8FD9\u771F\u662F\u4E00\u573A\\n\u6536\u83B7\u591A\u591A\u7684\u7CBE\u5F69\u5BF9\u6218\u554A\u3002[VAR 0114(0004)]",
  "\u4E3A\u4E86\u8C22\u8C22\u4F60\u966A\u6211\u5BF9\u6218\uFF0C\\n\u6536\u4E0B\u8FD9\u4E9B\u4E1C\u897F\u5427\uFF01[VAR 0114(0004)]",
  "\u5176\u5B9E\u6211\u6068\u4E0D\u5F97\u80FD\u9A6C\u4E0A\u518D\u548C\u4F60\u6BD4\u4E00\u573A\uFF01\\n\u4E0D\u8FC7\uFF0C\u6211\u6BD5\u7ADF\u662F\u4E2A\u51A0\u519B\uFF0C\\r\\n\u8981\u4F53\u8C05\u5BF9\u624B\u624D\u884C\uFF0C\u6240\u4EE5\u53EA\u597D\u5FCD\u4E00\u5FCD\u4E86\u2026\u2026[VAR 0114(0004)]",
  "\u7B49\u4F60\u7684\u5FBD\u7AE0\u6536\u96C6\u5F97\u66F4\u591A\uFF0C\\n\u6211\u4EEC\u53C8\u5728\u54EA\u4E2A\u9053\u9986\u76F8\u9047\u65F6\uFF0C\u518D\u6765\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "\u2026\u2026[VAR 0100(0000)]\u3002[VAR 0114(0004)]",
  "\u7B49[VAR 0100(0000)]\u4F60\\n\u53D8\u5F97\u66F4\u5F3A\u3001\\r\\n\u66F4\u5F3A\u3001\\r\\n\u66F4\uFF5E\u5F3A\u4E4B\u540E\u2026\u2026[VAR 0114(0004)]",
  "\u6211\u4EEC\u80FD\u5C3D\uFF5E\u60C5\u5730\u5BF9\u6218\u7684\u8BDD\u2026\u2026\\n\u90A3\u5C31\u592A\u597D\u54AF\uFF01[VAR 0114(0004)]",
  "\u8C22\u8C22\u4F60\u966A\u6211\u5BF9\u6218\uFF01\\n\u9053\u9986\u6D4B\u9A8C\u8981\u52A0\u6CB9\u54E6\uFF01[VAR 0114(0004)]"
]
