  "\u4E0D\u8FC7\uFF0C\u6211\u540C\u65F6\u4E5F\u6709\\n\u4E0D\u60F3\u7EC8\u7ED3\u5929\u661F\u961F\u7684\u5FC3\u60C5\uFF01\\r\\n\u6211\u4E0D\u80FD\u8F7B\u6613\u5730\u8F93\u7ED9\u4F60\uFF01[VAR 0114(0009)]",
