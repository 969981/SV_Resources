[
  "\u5443\u2026\u2026\u4F60\u5F88\u60CA\u8BB6\u5427\uFF1F[VAR 0114(0009)]",
  "\u6211\u5C31\u662F\u771F\u8001\u5927\u2026\u2026\\n\u800C\u4E14\u4ED9\u540E\u5176\u5B9E\u5C31\u662F\u6211\u3002[VAR 0114(0009)]",
  "\u5728\u5B66\u6821\u7684\u6821\u95E8\u524D\u6211\u89C1\u8BC6\u5230\u4E86\\n\u4F60\u6253\u8D25\u5929\u661F\u961F\u624B\u4E0B\u7684\u5B9E\u529B\uFF0C\\r\\n\u4E8E\u662F\u6211\u60F3\u51FA\u4E86\u661F\u5C18\u5927\u4F5C\u6218\u3002[VAR 0114(0009)]",
  "\u53EA\u8981\u51ED\u6211\u7684\u672C\u4E8B\uFF0C\\n\uFF2C\uFF30\u60F3\u52A0\u591A\u5C11\u5C31\u52A0\u591A\u5C11\u3002\\r\\n\u6709\u62A5\u916C\u7684\u8BDD\uFF0C\u6211\u60F3\u4F60\u4F1A\u5E2E\u6211\u7684\u3002[VAR 0114(0009)]",
  "\u6211\u4F5C\u4E3A\u8865\u7ED9\u73ED\u7684\u4E00\u5458\\n\u4E00\u76F4\u76D1\u89C6\u7740\u4F60\u7684\u52A8\u5411\u54E6\u3002[VAR 0114(0009)]",
