[
  "[VAR 0100(0000)]\u4ECE\u540C\u6B65\u7C73\u90A3\u91CC\\n\u83B7\u5F97\u4E86[VAR 0204(0001,0000)]\uFF22\uFF30\uFF01",
  "\u5514\u5514\uFF5E\u55EF\uFF0C\u540C\u6B65\u54AF\uFF5E\uFF01[VAR 0114(002C)]",
  "\u2026\u2026\u554A\uFF01\\n\u6211\u662F\u4E2A\u5389\u5BB3\u7684\u7814\u7A76\u5458\uFF0C\\r\\n\u540D\u5B57\u53EB\u505A\u540C\u6B65\u7C73\uFF01[VAR 0114(004E)]",
  "\u4F60\u613F\u610F\u534F\u52A9\u6211\u4E3A\u5389\u5BB3\u7684\u5B9E\u9A8C\\n\u63D0\u4F9B\u53CD\u9988\u4FE1\u606F\u5417\uFF1F[VAR 0114(004E)]",
  "\u4E16\u7EAA\u5927\u53D1\u73B0\u2026\u2026\\n\u4F60\u53EF\u662F\u6709\u673A\u4F1A\u76EE\u7779\u5B83\u7684\u554A\uFF01[VAR 0114(004E)]",
  "[~ 31]",
  "\u8FD9\u6837\u5C31\u5BF9\u4E86\uFF01\\n\u6211\u4EEC\u53BB\u505A\u5B9E\u9A8C\u7684\u5730\u65B9\u5427\uFF01[VAR 0114(004E)]",
  "\u63A5\u4E0B\u6765\u6211\u4EEC\u8981\u505A\u7684\u5B9E\u9A8C\\n\u5FC5\u987B\u5E26\u7740\u5B9D\u53EF\u68A6\u4E00\u8D77\u8D70\u624D\u53EF\u4EE5\u3002[VAR 0114(004E)]",
  "\u4F60\u505A\u597D\u51C6\u5907\u540E\uFF0C\\n\u8DDF\u6211\u8BF4\u4E00\u58F0\u5427\uFF01[VAR 0114(004E)]",
  "\u4F60\u80FD\u534F\u52A9\u6211\u4E3A\u5389\u5BB3\u7684\u5B9E\u9A8C\\n\u63D0\u4F9B\u53CD\u9988\u4FE1\u606F\u5417\uFF1F[VAR 0114(004E)]",
  "\u8FD9\u6837\u5C31\u5BF9\u4E86\uFF01\\n\u90A3\u4E48\uFF0C\u7ACB\u9A6C\u5F00\u59CB\u5427\u2026\u2026\\r\\n\u540C\u6B65\u540C\u6B65\u54AF\uFF5E\uFF01[VAR 0114(004E)]",
  "\u4F60\u548C\u5B9D\u53EF\u68A6\u7684\u5FC3\u60C5\\n\u73B0\u5728\u5DF2\u7ECF\u540C\u6B65\u4E86\uFF01[VAR 0114(004E)]",
  "\u56E0\u4E3A\u662F\u540C\u6B65\u7684\uFF0C\u6240\u4EE5\u4F60\u600E\u4E48\u60F3\uFF0C\\n\u5B9D\u53EF\u68A6\u5C31\u4F1A\u600E\u4E48\u52A8\uFF01[VAR 0114(004E)]",
  "\u90A3\u4E48\uFF0C\u6211\u4EEC\u5C31\u4ECE\u6B65\u884C\u6D4B\u8BD5\u5F00\u59CB\u5427\uFF01\\n\u8BD5\u7740\u8D70\u5230\u5BF9\u9762\u7684\u6811\u90A3\u91CC\uFF01[VAR 0114(004E)]",
  "\u5514\u5514\uFF5E\u55EF\uFF01\\n\u4F60\u7684\u540C\u6B65\u6027\u975E\uFF5E\u5E38\u4E0D\u9519\uFF01[VAR 0114(004E)]",
  "\u6211\u6536\u96C6\u5230\u5F88\u597D\u7684\u6570\u636E\u4E86\uFF0C\u8C22\u8C22\u4F60\uFF01\\n\u8FD9\u662F\u2026\u2026\u4E00\u70B9\u8584\u793C\uFF01[VAR 0114(004E)]",
  "\u4F60\u771F\u7684\u975E\u5E38\u6709\u5929\u5206\uFF0C\\n\u6240\u4EE5\u5C31\u518D\u966A\u6211\u505A\uFF11\u6B21\u5B9E\u9A8C\u5427\uFF01[VAR 0114(004E)]",
  "\u4E0B\u4E00\u4E2A\u5B9E\u9A8C\u4F1A\u6709\u70B9\u8F9B\u82E6\uFF0C\\n\u6240\u4EE5\u6211\u8981\u9001\u4F60\u7684\u4E0D\u662F\u8584\u793C\uFF0C\u800C\u662F\u5389\u5BB3\u7684\u4E1C\u897F\uFF01[VAR 0114(004E)]",
  "\u4F60\u7EC8\u4E8E\u613F\u610F\u534F\u52A9\u6211\u4E3A\u5389\u5BB3\u7684\u5B9E\u9A8C\\n\u63D0\u4F9B\u53CD\u9988\u4FE1\u606F\u4E86\uFF1F[VAR 0114(004E)]",
  "\u4E16\u7EAA\u5927\u3001\u5927\u53D1\u73B0\u2026\u2026\\n\u4F60\u53EF\u662F\u6709\u673A\u4F1A\u6210\u4E3A\u5148\u9A71\u8005\u7684\u554A\uFF01[VAR 0114(004E)]",
  "\u90A3\u6211\u4EEC\u5F00\u59CB\u5427\uFF5E\uFF01\\n\u540C\u6B65\u540C\u6B65\u54AF\uFF5E\uFF01[VAR 0114(004E)]",
  "\u4F60\u548C\u5B9D\u53EF\u68A6\u7684\u5FC3\u60C5\\n\u73B0\u5DF2\u518D\u5EA6\u540C\u6B65\u4E86\uFF01[VAR 0114(004E)]",
  "\u4F60\u5DF2\u7ECF\u662F\u7B2C\uFF12\u6B21\u540C\u6B65\u4E86\uFF0C\\n\u5E94\u8BE5\u80FD\u505A\u51FA\u5404\u79CD\u5404\u6837\u7684\u884C\u52A8\u54AF\uFF01[VAR 0114(004E)]",
  "\u90A3\u4E48\u6218\u6597\u6D4B\u8BD5\u5F00\u59CB\uFF01\\n\u5C31\u4EE5\u8FD9\u4E2A\u72B6\u6001\u8BD5\u7740\u548C\u5B9D\u53EF\u68A6\u5BF9\u6218\u5427\uFF01[VAR 0114(004E)]",
  "\u5514\u5514\uFF5E\u55EF\uFF01\\n\u4F60\u7684\u540C\u6B65\u6027\u5DF2\u7ECF\u767B\u5CF0\u9020\u6781\u4E86\uFF01[VAR 0114(004E)]",
  "\u65E2\u7136\u4F60\u662F\u8FD9\u4E48\u68D2\u7684\u4EBA\u624D\uFF0C\\n\u90A3\u6211\u4E5F\u80FD\u628A\u8FD9\u4E2A\u5389\u5BB3\u7684\u4E1C\u897F\u4EA4\u7ED9\u4F60\u4E86\u3002[VAR 0114(004E)]",
  "\u56E0\u4E3A\u8FD8\u662F\u8BD5\u5236\u54C1\uFF0C\u6240\u4EE5\u5916\u89C2\u4E0A\\n\u8FD8\u6709\u70B9\u2026\u2026\u90A3\u4E2A\u2026\u2026[VAR 0114(004E)]",
  "\u4F7F\u7528\u8FD9\u4E2A\uFF0C\u968F\u65F6\u968F\u5730\u90FD\u80FD\u540C\u6B65\uFF01\uFF01\\n\u53BB\u548C\u5404\u79CD\u5B9D\u53EF\u68A6\u8BD5\u8BD5\u770B\u5427\uFF01[VAR 0114(004E)]",
  "\u5B9E\u9A8C\u4E2D\u65AD\u4E86\u2026\u2026\\n\u7B49\u4F60\u60F3\u540C\u6B65\u65F6\u518D\u6765\u627E\u6211\u5427\u3002\\r\\n\u662F\u4E0D\u662F\u5BF9\u8111\u90E8\u7684\u8D1F\u62C5\u592A\u91CD\u4E86\u554A\u2026\u2026[VAR 0114(004E)]",
  "\u4F60\u5E73\u65F6\u5728\u7528\u540C\u6B65\u5668\u5417\uFF1F\\c\\n\u5728\u673A\u5668\u4E0A\u6309\uFF2C\u952E\u7684\u540C\u65F6\\n\u6309\uFF32\u952E\u5C31\u80FD\u540C\u6B65\u5566\uFF01[VAR 0114(004E)]",
  "\u8C22\u8C22\u4F60\u603B\u662F\u5E2E\u6211\u540C\u6B65\uFF01\\n\u4ECE\u4F60\u90A3\u8FB9\u4F20\u6765\u7684\u6570\u636E\u975E\u5E38\u6709\u7528\uFF01\\r\\n\u6211\u5C31\u9001\u4F60\uFF22\uFF30\u5F53\u505A\u8C22\u793C\u5427\uFF01[VAR 0114(004E)]"
]
