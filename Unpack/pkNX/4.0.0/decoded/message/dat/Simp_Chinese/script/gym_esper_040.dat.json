[
  "[VAR 0100(0000)]\uFF0C\\n\u6B22\u8FCE\u4F60\u6765\u5230\u7119\u56FA\u9053\u9986\u3002",
  "\u8D85\u80FD\u9B54\u6CD5\u5E7B\u5986\u5E08\u8389\u666E\u2026\u2026\\n\u8981\u6311\u6218\u8FD9\u4E2A\u9053\u9986\u9986\u4E3B\u5417\uFF1F",
  "\u90A3\u597D\uFF0C\u6211\u5E26\u4F60\u53BB\u5BF9\u6218\u573A\u5427\u3002",
  "\u7B49\u4F60\u51C6\u5907\u597D\u4E86\uFF0C\\n\u968F\u65F6\u90FD\u53EF\u4EE5\u544A\u8BC9\u6211\u3002",
  "\u662F\u554A\u2026\u2026\u77E5\u9053\u4E86\u3002\\n\u6211\u6765\u529E\u5C31\u597D\u3002[VAR 0114(002C)]",
  "\u6807\u8BED\u5C31\u7528\u7B80\u5355\u6613\u61C2\u7684\\n\u201C\u8981\u7F8E\uFF0C\u8FD8\u8981\u7F8E\u5F97\u81EA\u7136\u201D\u3002[VAR 0114(002C)]",
  "\u773C\u5F71\u7684\u65B0\u989C\u8272\\n\u4E5F\u62DC\u6258\u4F60\u8BA2\u8D27\u54AF\u3002[VAR 0114(002C)]",
  "\u2026\u2026\u603B\u9EBB\u70E6\u4F60\uFF0C\u8C22\u8C22\u5566\u3002\\n\u5148\u8FD9\u6837\uFF0C\u6709\u4E8B\u518D\u8054\u7CFB\uFF5E[VAR 0114(002C)]",
  "\u4F60\u597D\uFF5E\uFF01[VAR 0114(002C)]",
  "\u6211\u662F\u9053\u9986\u9986\u4E3B\u8389\u666E\u3002\\c\\n\u5176\u5B9E\u5316\u5986\u5E08\\n\u624D\u662F\u6211\u7684\u6B63\u4E1A\u5462\u3002[VAR 0114(001C)]",
  "\u51F0\u6A97\u5BF9\u4F60\u7684\u8BC4\u4EF7\u5F88\u9AD8\u54E6\u3002\\n\u8BF4\u4F60\u5B9E\u529B\u5F88\uFF5E\u201C\u5927\u5F3A\u201D\u3002[VAR 0114(001C)]",
  "\u5475\u5475\u2026\u2026[VAR 0100(0000)]\uFF0C\\n\u4F60\u771F\u662F\u4E2A\u53EF\u7231\u7684\u6311\u6218\u8005\u3002[VAR 0114(001C)]",
  "\u505A\u5B8C\u8389\u666E\u6211\u72EC\u521B\u7684\u4F53\u64CD\u540E\uFF0C\\n\u4F60\u4EEC\u53D8\u5F97\u66F4\u7F8E\u4E86\uFF0C\u5FC3\u91CC\u4E00\u5B9A\u5F88\u9AD8\u5174\u5427\uFF1F[VAR 0114(001C)]",
  "\u5B9D\u53EF\u68A6\u7684\u8EAB\u4F53\\n\u4E5F\u8BA9\u4F60\u6253\u7406\u5F97\u5F88\u5E72\u51C0\u3002\\r\\n\u2026\u2026\u4F60\u6709\u9897\u5F88\u68D2\u7684\u7231\u7F8E\u4E4B\u5FC3\u5462\u3002[VAR 0114(001C)]",
  "[~ 30]",
  "\u5BF9\u4E8E\u4EBA\u548C\u5B9D\u53EF\u68A6\u6765\u8BF4\uFF0C\\n\u4EEA\u8868\u90FD\u662F\u5F88\u91CD\u8981\u7684\u54E6\u3002[VAR 0114(001C)]",
  "\u80FD\u8BA9\u4EFB\u4F55\u4EBA\u90FD\u6447\u8EAB\u4E00\u53D8\u7684\u9B54\u672F\u3002\\n\u2026\u2026\u8FD9\u5C31\u662F\u5316\u5986\u3002\\r\\n\u2026\u2026\u8FD9\u5C31\u662F\u7F8E\u5986\u3002[VAR 0114(001C)]",
  "\u7528\u8389\u666E\u6211\u7684\u62DB\u5F0F\\n\u628A\u4F60\u7684\u5B9D\u53EF\u68A6\u53D8\u5F97\u66F4\uFF5E\u7F8E\u5427\uFF01\uFF01[VAR 0114(001C)]",
  "\u4E0D\u4F46\u8BA9\u6211\u8F93\u4E86\u5BF9\u6218\uFF0C\\n\u8FD8\u5728\u7F8E\u4E3D\u8FD9\u4E00\u70B9\u4E0A\u548C\u6211\u4E0D\u76F8\u4E0A\u4E0B\u2026\u2026[VAR 0114(001C)]",
  "\u4F60\u5F88\u4E0D\u9519\u2026\u2026\uFF01\\n\u975E\u5E38\u4E0D\u9519\uFF0C\u55EF\uFF0C\u5B8C\u7F8E\u2026\u2026\uFF01[VAR 0114(001C)]",
  "\u5728\u4F60\u65E5\u540E\u6210\u4E3A\u5927\u4EBA\u7269\u4E4B\u524D\uFF0C\\n\u4E5F\u8BB8\u8389\u666E\u6211\u8BE5\u628A\u4F60\u79C1\u85CF\u8D77\u6765\uFF1F[VAR 0114(001C)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF0C\u8389\u666E\u6211\u73B0\u5728\\n\u5E94\u8BE5\u91CD\u65B0\u78E8\u7EC3\u81EA\u5DF1\u624D\u662F\u3002[VAR 0114(001C)]",
  "[VAR 0100(0000)]\uFF0C\u606D\u559C\u4F60\u3002\\n\u6211\u5C31\u7528\u8FD9\u4FDD\u7559\u5230\u6700\u540E\u7684\u59FF\u52BF\\r\\n\u628A\u8FD9\u4E2A\u9053\u9986\u5FBD\u7AE0\u5956\u52B1\u7ED9\u4F60\u5427\u3002[VAR 0114(001C)]",
  "\u6709[VAR 0200(0001)]\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u7B49\u7EA7[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4F1A\u66F4\u5BB9\u6613\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u5B83\u4EEC\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\u54E6\u3002[VAR 0114(001C)]",
  "\u6709\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u4E0D\u7BA1\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u5B83\u4EEC\u90FD\u4F1A\u597D\uFF5E\u597D\u5730\u542C\u4F60\u7684\u8BDD\u54E6\u3002[VAR 0114(001C)]",
  "\u53EA\u8981\u597D\u597D\u953B\u70BC\u8EAF\u5E72\uFF0C\\n\u4F60\u4E5F\u80FD\u628A\u8FD9\u4E2A\u62DB\u5F0F\u7528\u5F97\u5F88\u6E9C\u7684\u3002[VAR 0114(001C)]",
  "\u4F60\u548C\u8389\u666E\u6211\u7684\u5408\u7167\uFF0C\\n\u53EF\u4E0D\u8BB8\u4E0A\u4F20\u5230\u793E\u4EA4\u5E73\u53F0\u54E6\u3002[VAR 0114(001C)]",
  "\u2026\u2026\u53C8\u662F\u51FA\u6C57\u53C8\u662F\u4E00\u901A\u6298\u817E\uFF0C\\n\u90FD\u8BA9\u6211\u6709\u70B9\u6389\u5986\u4E86\u3002[VAR 0114(001C)]",
  "\u6211\u5F97\u8D76\u7D27\u8865\u5986\u624D\u884C\uFF0C\\n\u5426\u5219\u5C31\u4F1A\u803D\u8BEF\u540E\u9762\u7684\u884C\u7A0B\u4E86\u3002\\r\\n\u597D\u4E86\uFF0C\u8F9B\u82E6\u4F60\u4E86\uFF5E[VAR 0114(001C)]",
  "\u606D\u559C\uFF01\\n\u4F60\u7A81\u7834\u4E86\u7119\u56FA\u9053\u9986\uFF01"
]
