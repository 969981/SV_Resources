  "\u4F60\u6EDA\u6A44\u6984\\n\u6EDA\u5F97\u592A\u6E9C\u4E86\uFF0C\u8C22\u8C22\uFF5E[VAR 0114(002C)]",
  "\u54CE\u5440\uFF5E\\n\u6211\u8FD8\u6CA1\u4ECB\u7ECD\u81EA\u5DF1\u5462\uFF0C\u662F\u5427\uFF5E\uFF1F[VAR 0114(002C)]",
  "\u6211\u662F\u6D3E\u8212\u857E\u30FB\u6155\u6ECB\u7684\u5E97\u957F\u963F\u67AB\uFF5E[VAR 0114(002C)]",
  "\u54CE\u5440\u5440\uFF5E\uFF1F\u73B0\u5728\u6211\u4E0A\u7684\u662F\\n\u5706\u6A21\u9053\u9986\u7684\u73ED\u624D\u5BF9\u5462\uFF5E[VAR 0114(0016)]",
  "\u8BF4\u9519\u4E86\uFF5E\u8BF4\u9519\u4E86\uFF5E\\n\u6211\u662F\u9053\u9986\u9986\u4E3B\u963F\u67AB\u624D\u5BF9\u5462\uFF5E[VAR 0114(0016)]",
  "\u5E73\u65F6\u662F\u4E2A\u505A\u751C\u70B9\u7684\\n\u751C\u70B9\u5E08\u54E6\uFF5E[VAR 0114(0016)]",
  "\u653E\u5165\u53E3\u4E2D\u5C31\u4F1A\u611F\u5230\u5E78\u798F\u7684\u751C\u70B9\\n\u548C\u85CF\u5728\u8349\u6728\u5F53\u4E2D\u7684\u866B\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u5B83\u4EEC\u90FD\u5F88\u5C0F\uFF0C\u5374\u62E5\u6709\u5F88\u5927\u7684\u529B\u91CF\uFF5E[VAR 0114(0016)]",
  "\u4F60\u53EF\u8981\u597D\u597D\u52A0\u6CB9\uFF0C\\n\u4E0D\u8981\u7ED9\u6211\u53EF\u4E58\u4E4B\u673A\u54E6\uFF5E[VAR 0114(0016)]",
  "\u5373\u4F7F\u662F\u5728\u5BF9\u6218\u5F53\u4E2D\uFF0C\\n\u4F60\u7684\u5B9E\u529B\u4E5F\u5728\u4E0D\u65AD\u81A8\u80C0\u554A\uFF5E[VAR 0114(0016)]",
  "\u6211\u4E5F\u8981\u5B8C\u6210\u66F4\uFF5E\u8FDB\u4E00\u6B65\u7684\\n\u8FDB\u5316\u624D\u884C\u5440\uFF5E[VAR 0114(0016)]",
  "\u6211\u90D1\u91CD\u5BA3\u5E03\uFF0C\u4F60\u5408\u683C\u5566\uFF5E\uFF01\\n\u8FD9\u4E2A\u80FD\u8BC1\u660E\u4F60\u6218\u80DC\u9053\u9986\u9986\u4E3B\u7684\\r\\n\u9053\u9986\u5FBD\u7AE0\uFF0C\u5C31\u8BF7\u4F60\u6536\u4E0B\u5427\uFF5E[VAR 0114(0016)]",
  "\u963F\u67AB\u6211\u7279\u5236\u7684\u624B\u5DE5\u86CB\u7CD5\\n\u4E5F\u4E00\u8D77\u591A\u591A\uFF5E\u5730\u4EAB\u7528\u5427\uFF5E[VAR 0114(0016)]",
  "\u6709[VAR 0200(0001)]\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u7B49\u7EA7[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4F1A\u66F4\u5BB9\u6613\u6349\u5230\uFF0C\\r\\n\u4E5F\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\uFF5E[VAR 0114(0016)]",
  "\u6709\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u4E0D\u7BA1\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u5B83\u4EEC\u90FD\u4F1A\u4E56\u4E56\u5730\u542C\u4F60\u7684\u8BDD\u54E6\uFF5E\uFF01[VAR 0114(0016)]",
  "\u4F60\u5403\u4E1C\u897F\u7684\u6837\u5B50\u771F\u662F\u597D\u8D5E\uFF0C\\n\u8981\u4E0D\u8981\u4E5F\u5C1D\u5C1D\u62DB\u5F0F\u5B66\u4E60\u5668\u8FD9\u4E2A\u751C\u70B9\u5462\uFF5E\uFF1F[VAR 0114(0016)]",
  "\u5728\u5192\u9669\u7684\u9014\u4E2D\u5F97\u5230\u7684\\n\u62DB\u5F0F\u5B66\u4E60\u5668\u4EE5\u540E\u53EF\u4EE5\u7528\\r\\n\u62DB\u5F0F\u5B66\u4E60\u5668\u673A\u5236\u9020\u54E6\uFF5E[VAR 0114(0016)]",
  "\u795D\u4F60\u4ECA\u540E\u524D\u8FDB\u7684\u9053\u8DEF\\n\u5145\u6EE1\u7518\u751C\u4E0E\u67D4\u987A\uFF5E[VAR 0114(0016)]",
  "\u90A3\u4E48\uFF0C\\n\u6211\u4EEC\u540E\u4F1A\u6709\u671F\uFF5E[VAR 0114(0016)]",
