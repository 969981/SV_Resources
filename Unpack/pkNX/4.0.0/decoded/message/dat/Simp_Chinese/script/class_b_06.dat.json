[
  "\u540C\u5B66\u4EEC\u597D\u554A\u3002\\n\u8BA9\u6211\u4EEC\u4E00\u8D77\u5FEB\u4E50\u5730\u4E0A\u8BFE\u5427\u3002[VAR 0114(0025)]",
  "\u5927\u5BB6\u5927\uFF5E\u5E45\u590D\u4E60\\n\u4E0A\u4E00\u5802\u8BFE\u7684\u77E5\u8BC6\u4E86\u5417\uFF1F[VAR 0114(0025)]",
  "\u4E58\u7B97\u554A\uFF05\u554A\u8FD9\u4E9B\uFF0C\\n\u786E\u5B9E\u662F\u6709\u70B9\u96BE\u5462\u3002[VAR 0114(0025)]",
  "\u90A3\u4E48\uFF0C\u4ECA\u5929\u4E5F\u4F7F\u7528\uFF05\\n\u6765\u7EE7\u7EED\u4E86\u89E3\u6982\u7387\u5427\u3002[VAR 0114(0025)]",
  "\u542C\u4E0A\u53BB\u6216\u8BB8\u5F88\u96BE\uFF0C\\n\u4F46\u5176\u5B9E\u5927\u5BB6\u5DF2\u7ECF\\r\\n\u5728\u719F\u7EC3\u4F7F\u7528\u6982\u7387\u4E86\u3002[VAR 0114(0025)]",
  "\u5B9D\u53EF\u68A6\u7684\u5404\u4E2A\u62DB\u5F0F\\n\u4E5F\u5B58\u5728\u7740\u540D\u4E3A\u547D\u4E2D\u7684\u6982\u7387\uFF0C\\r\\n\u5B83\u4EE3\u8868\u7740\u62DB\u5F0F\u662F\u5426\u80FD\u771F\u6B63\u547D\u4E2D\u5BF9\u624B\u3002[VAR 0114(0025)]",
  "\u649E\u51FB\u7684\u547D\u4E2D\u662F\uFF11\uFF10\uFF10\uFF01\\n\u8FD9\u610F\u5473\u7740\uFF11\uFF10\uFF10\uFF05\u7684\u610F\u601D\u3002\\r\\n\u4F7F\u51FA\uFF11\uFF10\uFF10\u6B21\uFF0C\uFF11\uFF10\uFF10\u6B21\u90FD\u80FD\u547D\u4E2D\u5BF9\u624B\u3002[VAR 0114(0025)]",
  "\u80FD\u8BA9\u5BF9\u624B\u9677\u5165\u7761\u7720\u72B6\u6001\u7684\\n\u50AC\u7720\u672F\u7684\u547D\u4E2D\u4E3A\uFF16\uFF10\uFF01[VAR 0114(0025)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u662F\uFF16\uFF10\uFF05\u3002\\n\uFF11\uFF10\uFF10\u6B21\u79CD\u6709\uFF16\uFF10\u6B21\u80FD\u547D\u4E2D\u5BF9\u624B\u2026\u2026\\r\\n\u53CD\u8FC7\u6765\u8BF4\uFF0C\u6709\uFF14\uFF10\u6B21\u4F1A\u5931\u8D25\u3002[VAR 0114(0025)]",
  "\u901A\u5E38\u6765\u8BF4\uFF0C\u7279\u522B\u5389\u5BB3\u7684\\n\u62DB\u5F0F\u5F80\u5F80\u62E5\u6709\u8F83\u4F4E\u7684\u547D\u4E2D\u3002[VAR 0114(0025)]",
  "\u662F\u7528\u7EDD\u5BF9\u80FD\u547D\u4E2D\u7684\u62DB\u5F0F\u8D70\u7A33\u59A5\u8DEF\u7EBF\u5462\u2026\u2026\\n\u8FD8\u662F\u7528\u867D\u4E0D\u4E00\u5B9A\u547D\u4E2D\u4F46\u4F24\u5BB3\u9AD8\u7684\u62DB\u5F0F\u5462\u2026\u2026[VAR 0114(0025)]",
  "\u5149\u662F\u601D\u8003\u7528\u54EA\u4E2A\u62DB\u5F0F\uFF0C\\n\u5927\u5BB6\u5C31\u5DF2\u7ECF\u5728\u5B66\u4E60\u6982\u7387\u4E86\u54E6\uFF5E\uFF01[VAR 0114(0025)]",
  "\u8BF4\u5230\u9002\u5408\u7528\u6765\u8BF4\u660E\u547D\u4E2D\u7684\u8BDD\u9898\u2026\u2026\\n\u5E94\u8BE5\u5C31\u662F\u51B2\u6D6A\u548C\u6C34\u70AE\u4E86\u5427\uFF1F[VAR 0114(0025)]",
  "\u51B2\u6D6A\u7684\u547D\u4E2D\u662F\uFF11\uFF10\uFF10\uFF0C\\n\u4E5F\u5C31\u662F\u4E00\u5B9A\u80FD\u9020\u6210\u5A01\u529B\uFF19\uFF10\u7684\u4F24\u5BB3\u3002[VAR 0114(0025)]",
  "\u6C34\u70AE\u7684\u547D\u4E2D\u867D\u7136\u53EA\u6709\uFF18\uFF10\uFF0C\\n\u4F46\u5B83\u5A01\u529B\uFF11\uFF11\uFF10\u7684\u4F24\u5BB3\u503C\u5F97\u671F\u5F85\uFF01[VAR 0114(0025)]",
  "\u51B2\u6D6A\u548C\u6C34\u70AE\uFF0C\\n\u5927\u5BB6\u60F3\u8981\u54EA\u4E2A\u62DB\u5F0F\u5462\uFF1F[VAR 0114(0025)]",
  "\u51B2\u6D6A",
  "\u6C34\u70AE",
  "\u770B\u60C5\u51B5",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u662F\u8E0F\u5B9E\u6C42\u7A33\u7684\u98CE\u683C\u5440\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u662F\u6D6A\u6F2B\u8C6A\u653E\u7684\u98CE\u683C\u5440\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u5728\u601D\u8003\u5404\u79CD\u5404\u6837\u7684\u60C5\u51B5\u5440\uFF1F[VAR 0114(0025)]",
  "\u521A\u521A\u662F\u8001\u5E08\u6211\u968F\u53E3\u7684\u63D0\u95EE\uFF0C\\n\u5E76\u6CA1\u6709\u6B63\u786E\u7B54\u6848\uFF01\\r\\n\u5927\u5BB6\u9009\u62E9\u81EA\u5DF1\u559C\u6B22\u7684\u62DB\u5F0F\u5C31\u597D\uFF5E[VAR 0114(0025)]",
  "\u8FD9\u4E0D\u540C\u4E8E\uFF30\uFF30\u7684\u6D88\u8017\u91CF\uFF0C\\n\u6216\u662F\u62DB\u5F0F\u80FD\u5426\u547D\u4E2D\u591A\u4E2A\u5BF9\u8C61\uFF0C\\r\\n\u5E76\u4E0D\u662F\u8BF4\u54EA\u79CD\u5C31\u4E00\u5B9A\u597D\u54E6\u3002[VAR 0114(0025)]",
  "\u8FD9\u4E2A\u51B2\u6D6A\u548C\u6C34\u70AE\u7684\u95EE\u9898\\n\u4ECE\u524D\u8D77\u5C31\u662F\u5E38\u88AB\u8BAE\u8BBA\u7684\u8BDD\u9898\u3002[VAR 0114(0025)]",
  "\u5C31\u8001\u5E08\u6211\u4E2A\u4EBA\u800C\u8A00\uFF0C\\n\u6211\u66F4\u504F\u597D\u5CA9\u77F3\u5C5E\u6027\u7684\u5CA9\u5D29\u6216\u662F\u5C16\u77F3\u653B\u51FB\u3002[VAR 0114(0025)]",
  "\u5176\u5B9E\u6211\u66F4\u60F3\u70ED\u70C8\u5730\\n\u8BA8\u8BBA\u5CA9\u77F3\u5C5E\u6027\u7684\u62DB\u5F0F\u5462\u3002\\r\\n\u54CE\u5440\uFF0C\u4E0B\u8BFE\u94C3\u54CD\u4E86\uFF0C\u771F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u4E0B\u6B21\u5C31\u662F\u540E\u534A\u6BB5\u7684\u6700\u540E\u4E00\u5802\u8BFE\uFF01\\n\u8BA9\u6211\u4EEC\u4EE5\uFF11\uFF10\uFF10\uFF05\u7684\u7CBE\u529B\u6765\u76F8\u89C1\u5427\uFF01[VAR 0114(0025)]"
]
