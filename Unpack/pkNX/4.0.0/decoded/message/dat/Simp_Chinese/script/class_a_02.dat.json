[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u4EEC\u5F00\u59CB\u4E0A\u8BFE\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0A\u4E00\u5802\u8BFE\u6559\u7684\u201C\uFF3A\uFF32\u952E\u6295\u7403\uFF01\u201D\uFF0C\\n\u5927\u5BB6\u6709\u6CA1\u6709\u8BD5\u8BD5\u770B\u5440\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u8D70\u5C31\u80FD\u53D1\u73B0\\n\u5B83\u4EEC\u4E2A\u6027\u4E30\u5BCC\uFF0C\u975E\u5E38\u53EF\u7231\u3002[VAR 0114(002A)]",
  "\u60F3\u8981\u548C\u6240\u6709\u540C\u884C\u5B9D\u53EF\u68A6\\n\u90FD\u4E92\u52A8\u7684\u65F6\u5019\uFF0C\\r\\n\u91CE\u9910\u4E5F\u662F\u4E2A\u503C\u5F97\u63A8\u8350\u7684\u65B9\u6CD5\u3002[VAR 0114(002A)]",
  "\u5927\u5BB6\u56F4\u7740\u684C\u5B50\u4E00\u8D77\u505A\u4E09\u660E\u6CBB\uFF0C\\n\u4E5F\u53EF\u4EE5\u548C\u5B9D\u53EF\u68A6\u73A9\u3002\\r\\n\u7B80\u76F4\u662F\u5176\u4E50\u65E0\u7A77\u3002[VAR 0114(002A)]",
  "\u5173\u4E8E\u6599\u7406\u7684\u4E8B\uFF0C\u53EF\u4EE5\u5728\\n\u8428\u74E6\u7F57\u8001\u5E08\u7684\u8BFE\u5802\u4E2D\u5B66\u5230\u54E6\uFF5E[VAR 0114(002A)]",
  "\u8FD8\u6709\uFF0C\u5F00\u59CB\u91CE\u9910\u7684\u8BDD\uFF0C\\n\u5C31\u5076\u5C14\u4F1A\u5728\u653E\u7F6E\u4E8E\\r\\n\u684C\u5B50\u65C1\u7684\u91CE\u9910\u7BEE\u91CC\u2026\u2026[VAR 0114(002A)]",
  "\u53D1\u73B0\u5F88\uFF5E\u91CD\u8981\u7684\u90A3\u4E2A\u54E6\uFF01[VAR 0114(002A)]",
  "\u5C31\u662F\u4F1A\u8BDE\u751F\u51FA\u5B9D\u53EF\u68A6\u7684\u5F88\u91CD\u8981\u7684\u90A3\u4E2A\uFF01\\n\u5927\u5BB6\u4E00\u8D77\u8BF4\u51FA\u7B54\u6848\u5427\u2026\u2026\u4E00\u3001\u4E8C\uFF5E\u4E09\uFF01[VAR 0114(002A)]",
  "\u76D2\u5B50\uFF01",
  "\u7CBE\u7075\u7403\uFF01",
  "\u86CB\uFF01",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u8BF4\u7684\u662F\u76D2\u5B50\u5417\uFF1F\\c\\n\u76D2\u5B50\u662F\u7528\u6765\u5BC4\u653E\u5B9D\u53EF\u68A6\u7684\uFF0C\\n\u548C\u8BDE\u751F\u5B83\u4EEC\u7684\u4E1C\u897F\u4E0D\u592A\u4E00\u6837\u54E6\u3002[VAR 0114(002A)]",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u8BF4\u7684\u662F\u7CBE\u7075\u7403\u5417\uFF1F\\c\\n\u76EE\u524D\u8FD8\u6CA1\u6709\u4EBA\u786E\u8BA4\u5230\\n\u4ECE\u7403\u8BDE\u751F\u7684\u5B9D\u53EF\u68A6\u5462\uFF5E[VAR 0114(002A)]",
  "\u592A\u597D\u4E86\uFF5E\uFF01\\n\u5927\u5BB6\u90FD\u56DE\u7B54\u6B63\u786E\uFF01[VAR 0114(002A)]",
  "\u6CA1\u9519\uFF0C\u91CD\u8981\u7684\u90A3\u4E2A\\n\u5C31\u662F\u6307\u5B9D\u53EF\u68A6\u7684\u86CB\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4E0D\u77E5\u9053\u86CB\u662F\u4ECE\u54EA\u91CC\u6765\u7684\uFF0C\\n\u4E5F\u8BB8\u662F\u524D\u6765\u91CE\u9910\u7684\u5B9D\u53EF\u68A6\\r\\n\u5077\u5077\u653E\u8FDB\u91CE\u9910\u7BEE\u91CC\u7684\u5462\u3002[VAR 0114(002A)]",
  "\u53EA\u8981\u901A\u8FC7\u8D70\u8DEF\u5C31\u80FD\u7EF4\u6301\u5B75\u86CB\u7684\u6E29\u5EA6\uFF0C\\n\u65F6\u673A\u6210\u719F\u5C31\u80FD\u5B75\u51FA\u5B9D\u53EF\u68A6\u54E6\u3002[VAR 0114(002A)]",
  "\u76D2\u5B50\u91CC\u7684\u6E29\u5EA6\u4E0D\u8DB3\u4EE5\u5B75\u5316\uFF0C\\n\u56E0\u6B64\u8981\u628A\u5B83\u653E\u5728\u540C\u884C\u7684\u961F\u4F0D\u91CC\u8D70\u8DEF\u54E6\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u6211\u8981\u544A\u8BC9\u5927\u5BB6\\n\u4E00\u4EF6\u5F88\uFF5E\u91CD\u8981\u7684\u4E8B\u60C5\u54E6\u3002[VAR 0114(002A)]",
  "\u5B9D\u53EF\u68A6\u662F\u5E26\u7740\u5BF9\u4EBA\u7C7B\u7684\u4FE1\u4EFB\uFF0C\\n\u624D\u5C06\u86CB\u6258\u4ED8\u7ED9\u6211\u4EEC\u7684\u3002[VAR 0114(002A)]",
  "\u6240\u4EE5\uFF0C\u5982\u679C\u5927\u5BB6\u80FD\u8D1F\u8D77\u8D23\u4EFB\u597D\u597D\u5B75\u86CB\uFF01\\n\u5409\u5C3C\u4E9A\u8001\u5E08\u6211\u554A\uFF0C\u4F1A\u5F88\u9AD8\u5174\u7684\uFF5E[VAR 0114(002A)]",
  "\u6211\u660E\u660E\u8FD8\u5728\u8BB2\u91CD\u8981\u7684\u5185\u5BB9\uFF0C\\n\u6CA1\u60F3\u5230\u7ADF\u7136\u548C\u949F\u58F0\u91CD\u53E0\u4E86\u3002\\r\\n\u2026\u2026\u671F\u5F85\u548C\u5927\u5BB6\u4E0B\u4E00\u5802\u8BFE\u89C1\u54AF\uFF5E[VAR 0114(002A)]",
