[
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01[VAR 0114(0041)]",
  "\u6BC5\u4E07\uFF0C\u5FEB\u770B\uFF01\\n\u8FD9\u91CC\u6709\u4E2A\u6C34\u6D3C\u5462\u3002[VAR 0114(0041)]",
  "\u99A5\u597D\uFF0C\u8FD9\u662F\u4E00\u5EA7\u6E56\u54E6\uFF01\\n\u5B83\u662F\u5E15\u5E95\u4E9A\u6700\u5927\u7684\u6E56\uFF0C\\r\\n\u8457\u540D\u7684\u5927\u9505\u6E56\u5440\uFF01[VAR 0114(0040)]",
  "\u8FD9\u3001\u8FD9\u662F\u6E56\uFF01\uFF1F\u5C31\u7B97\u9000\u4E00\u767E\u6B65\u8BF4\uFF0C\\n\u4E5F\u5C31\u662F\u4E2A\u6C60\u5858\uFF0C\u4E0D\u662F\u5417\uFF01\uFF1F[VAR 0114(0041)]",
  "\u6211\u8BF4\uFF0C\u6BC5\u4E07\u2026\u2026\\n\u6C60\u5858\u548C\u6E56\u6CCA\u6709\u4EC0\u4E48\u533A\u522B\u5462\uFF1F[VAR 0114(0041)]",
  "\u6211\u4E0D\u77E5\u9053\u5440\uFF0C\u99A5\u597D\u2026\u2026\\n\u6211\u4EEC\u540D\u6D41\u7684\u4EF7\u503C\u89C2\\r\\n\u6BD4\u8D77\u666E\u901A\u4EBA\u8981\u66F4\u4E0D\u62D8\u5C0F\u8282\u2026\u2026[VAR 0114(0040)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u603B\u80FD\u9047\u5230\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u8FD8\u771F\u662F\u3002\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u90A3\u5C31\u662F\u603B\u80FD\u9047\u5230\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u8FD9\u4F4D\u5EB6\u6C11\u2026\u2026\\n\u4F60\u53EF\u77E5\u9053\u6C60\u5858\u548C\u6E56\u6CCA\u7684\u533A\u522B\u5728\u54EA\u91CC\uFF1F[VAR 0114(0041)]",
  "\u5927\u5C0F\uFF1F",
  "\u6DF1\u5EA6\uFF1F",
  "\u539F\u6765\u5982\u6B64\uFF0C\u4E0D\u6127\u662F\u5EB6\u6C11\uFF01\\n\u975E\u5E38\u4E86\u89E3\u57FA\u7840\u5E38\u8BC6\u5462\uFF01[VAR 0114(0041)]",
  "\u4EE5\u793C\u8FD8\u793C\\n\u662F\u6211\u7B49\u540D\u6D41\u7684\u804C\u8D23\u2026\u2026[VAR 0114(0041)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u6211\u8981\u628A\\n\u8FD9\u4EFD\u9053\u5177\u8D60\u4E0E\u4F60\u3002[VAR 0114(0041)]",
  "\u8FD9\u4F4D\u5EB6\u6C11\uFF0C\u4ED4\u7EC6\u542C\u597D\u54E6\u3002\\n\u6240\u8C13\u5E78\u798F\uFF0C\u5C31\u50CF\u662F\u6C34\u8FB9\u4E00\u6837\u2026\u2026[VAR 0114(0041)]",
  "\u4E00\u5904\u6C34\u8FB9\u662F\u6C34\u6D3C\u3001\u6C60\u5858\u8FD8\u662F\u6E56\u6CCA\uFF0C\\n\u5168\u90FD\u53D6\u51B3\u4E8E\u4E2A\u4EBA\u7684\u60F3\u6CD5\u3002[VAR 0114(0041)]",
  "\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u5BF9\u65B9\u521A\u521A\u6559\u4F60\u7684\u77E5\u8BC6\uFF0C\\r\\n\u5C45\u7136\u7ACB\u523B\u5C31\u62FF\u6765\u5411\u672C\u4EBA\u5C55\u793A\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\\n\u6211\u60F3\u53BB\u5C1D\u8BD5\u6500\u767B\u4E00\u4E0B\\r\\n\u50CF\u6211\u4EEC\u516C\u53F8\u4E00\u6837[VAR FF00(0006)]\u6D01\u767D\u7684\u5C71[VAR FF00(0000)]\u3002[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\u5E15\u5E95\u4E9A\u4E0D\u52A8\u4EA7\\n\u4E0D\u7BA1\u600E\u4E48\u8BF4\u4E5F\u662F\u4E2A\u6D01\u767D\u7684\u826F\u5FC3\u4F01\u4E1A\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5440\uFF01[VAR 0114(0040)]",
  "\u6211\u4EEC\u53BB\u96EA\u5C71\u4E00\u8FB9\u89C2\u8D4F\u51B0\u5C5E\u6027\u5B9D\u53EF\u68A6\\n\u4E00\u8FB9\u54C1\u5C1D\u51B0\u6DC7\u6DCB\u5427\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u4E07\u5148\u751F\\n\u5DF2\u7ECF\u524D\u5F80\u5E15\u5E95\u4E9A\u4E2D\u5E7F\u5927\u7684\u6C34\u8FB9\u4E86\u3002",
  "\u5E7F\u5927\u7684\u6C34\u8FB9\u6307\u7684\u662F\u2026\u2026\\n\u6CB3\u5DDD\uFF1F\u6C60\u5858\uFF1F\\r\\n\u4E5F\u53EF\u80FD\u662F\u6E56\u6CCA\uFF1F"
]
