[
  "\u540C\u5B66\u4EEC\u597D\u554A\u3002\\n\u671F\u4E2D\u8003\u8BD5\u8F9B\u82E6\u4E86\u3002[VAR 0114(0025)]",
  "\u4E0D\u7BA1\u662F\u6EE1\u5206\u8FD8\u662F\u5DEE\u70B9\u6CA1\u53CA\u683C\u7684\u540C\u5B66\uFF0C\\n\u5927\u5BB6\u90FD\u597D\u597D\u52AA\u529B\u4E86\uFF0C\u662F\u5427\uFF1F[VAR 0114(0025)]",
  "\u5168\u73ED\u540C\u5B66\u90FD\u53CA\u683C\u4E86\uFF0C\\n\u8001\u5E08\u6211\u554A\uFF0C\u975E\u5E38\u5730\u5F00\u5FC3\u3002[VAR 0114(0025)]",
  "\u8FD9\u5E94\u8BE5\u5C31\u610F\u5473\u7740\uFF0C\\n\u6211\u8BA9\u5927\u5BB6\u559C\u6B22\u4E0A\u4E86\u6570\u5B57\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u5269\u4E0B\u7684\u8BFE\u5802\u5462\uFF0C\\n\u5927\u5BB6\u4E5F\u8981\u52AA\u529B\u8BA9\u77E5\u8BC6\u5927\uFF5E\u5E45\u589E\u52A0\u54E6\uFF01[VAR 0114(0025)]",
  "\u8BF4\u5230\u5927\uFF5E\u5E45\uFF01\\n\u2026\u2026\u6CA1\u9519\uFF01\\r\\n\u5C31\u4F1A\u8054\u60F3\u5230\u5B9D\u53EF\u68A6\u7684\u80FD\u529B\u4E0A\u5347\u4E86\uFF01[VAR 0114(0025)]",
  "\u5728\u5BF9\u6218\u4E2D\uFF0C\u5B9D\u53EF\u68A6\u7684\u80FD\u529B\\n\u4F1A\u65F6\u800C\u4E0A\u5347\u65F6\u800C\u53C8\u4E0B\u964D\u7684\u5427\uFF1F[VAR 0114(0025)]",
  "\u6BD4\u5982\uFF0C\u5F53\u5B9D\u53EF\u68A6\u4F7F\u7528\\n\u540D\u4E3A\u81EA\u6211\u6FC0\u52B1\u7684\u62DB\u5F0F\u540E\uFF0C\\r\\n\u653B\u51FB\u548C\u7279\u653B\u5C31\u80FD\u4E0A\u5347\uFF11\u4E2A\u7B49\u7EA7\u3002[VAR 0114(0025)]",
  "\u800C\u653B\u51FB\u548C\u7279\u653B\u7684\u7EA7\u522B\\n\u6BCF\u4E0A\u5347\uFF11\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u4F24\u5BB3\u4E5F\u80FD\u4E0A\u5347\uFF15\uFF10\uFF05\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u4E4B\u540E\u518D\u6B21\u4F7F\u7528\u81EA\u6211\u6FC0\u52B1\u7684\u8BDD\uFF0C\\n\u653B\u51FB\u548C\u7279\u653B\u5C31\u4F1A\u4E0A\u5347\uFF12\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u5728\u539F\u672C\u4F24\u5BB3\u7684\u57FA\u7840\u4E0A\u63D0\u5347\u4E86\uFF11\uFF10\uFF10\uFF05\uFF0C\\r\\n\u4E5F\u5C31\u662F\u8BF4\u7B49\u4E8E\uFF12\u6B21\u4EFD\u91CF\u7684\u4F24\u5BB3\u3002[VAR 0114(0025)]",
  "\u800C\u540D\u4E3A\u5251\u821E\u7684\u62DB\u5F0F\\n\u80FD\u8BA9\u653B\u51FB\u7EA7\u522B\u4E0A\u5347\uFF12\u4E2A\u7B49\u7EA7\u3002\\r\\n\u4F7F\u51FA\uFF11\u6B21\uFF0C\u4F24\u5BB3\u5C31\u662F\uFF12\u500D\u54E6\uFF01[VAR 0114(0025)]",
  "\u90A3\u4E48\uFF0C\u4F7F\u7528\uFF12\u6B21\u5251\u821E\u540E\\n\u653B\u51FB\u7EA7\u522B\u4F1A\u4E0A\u5347\uFF14\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u62DB\u5F0F\u7684\u4F24\u5BB3\u4F1A\u53D8\u6210\u51E0\u500D\u5462\uFF1F[VAR 0114(0025)]",
  "\uFF12\u500D",
  "\uFF13\u500D",
  "\uFF14\u500D",
  "\u662F\u7684\uFF0C\u8FD9\u9898\u5F88\u5BB9\u6613\u51FA\u9519\u5462\u3002\\n\u5982\u679C\u662F\u4F7F\u51FA\u81EA\u6211\u6FC0\u52B1\u7684\u8BDD\uFF0C\\r\\n\u6B63\u786E\u7B54\u6848\u7684\u786E\u662F\uFF12\u500D\u4F24\u5BB3\u6CA1\u9519\u2026\u2026[VAR 0114(0025)]",
  "\u8FD9\u4E48\u96BE\u90FD\u80FD\u7B54\u5BF9\uFF0C\u4F60\u771F\u5389\u5BB3\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01[VAR 0114(0025)]",
  "\u662F\u7684\uFF0C\u8FD9\u9898\u5F88\u5BB9\u6613\u51FA\u9519\u5462\u3002\\n\u867D\u8BF4\u662F\u4E0A\u5347\uFF14\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u4F46\u5E76\u4E0D\u7B49\u4E8E\uFF14\u500D\uFF0C\u8FD9\u5C31\u662F\u96BE\u70B9\u6240\u5728\u3002[VAR 0114(0025)]",
  "\u7EA7\u522B\u6BCF\u63D0\u5347\uFF11\u4E2A\u7B49\u7EA7\uFF0C\\n\u4F24\u5BB3\u4F1A\u968F\u4E4B\u63D0\u5347\uFF15\uFF10\uFF05\u3002[VAR 0114(0025)]",
  "\uFF14\u4E2A\u7B49\u7EA7\u7684\u8BDD\u5C31\u7528\uFF14\u00D7\uFF15\uFF10\uFF05\uFF0C\\n\u4E5F\u5C31\u662F\u589E\u52A0\uFF12\uFF10\uFF10\uFF05\u3002[VAR 0114(0025)]",
  "\u539F\u672C\u7684\u4F24\u5BB3\u662F\uFF11\uFF10\uFF10\uFF05\uFF0C\\n\u518D\u52A0\u4E0A\uFF12\uFF10\uFF10\uFF05\uFF0C\u4E5F\u5C31\u662F\uFF13\uFF10\uFF10\uFF05\u3002[VAR 0114(0025)]",
  "\u56E0\u6B64\u4E0B\u4E00\u4E2A\u4F7F\u51FA\u7684\u62DB\u5F0F\u7684\\n\u4F24\u5BB3\u5C31\u4F1A\u53D8\u6210\uFF13\u500D\u54E6\u3002[VAR 0114(0025)]",
  "\u5728\u521A\u521A\u7684\u8BA1\u7B97\u57FA\u7840\u4E0A\uFF0C\\n\u8FD8\u8981\u52A0\u4E0A\u5C5E\u6027\u76F8\u514B\u548C\u51FB\u4E2D\u8981\u5BB3\u7684\u4E58\u7B97\uFF0C\\r\\n\u56E0\u6B64\u5373\u4F7F\u662F\u5C11\u8BB8\u4E0A\u5347\u4E5F\u4E0D\u80FD\u6389\u4EE5\u8F7B\u5FC3\u54E6\u3002[VAR 0114(0025)]",
  "\u987A\u5E26\u4E00\u63D0\uFF0C\\n\u201C\u80FD\u529B\u63D0\u9AD8\u4E86\u201D\u662F\u6307\u4E0A\u5347\uFF11\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u201C\u5927\u5E45\u63D0\u9AD8\u4E86\u201D\u662F\u6307\u4E0A\u5347\uFF12\u4E2A\u7B49\u7EA7\uFF0C\\r\\n\u201C\u5DE8\u5E45\u63D0\u9AD8\u4E86\u201D\u662F\u6307\u4E0A\u5347\uFF13\u4E2A\u7B49\u7EA7\u3002\\r\\n\u80FD\u529B\u4E0A\u5347\u662F\u7528\u8FD9\u6837\u7684\u65B9\u5F0F\u6765\u8868\u73B0\u54E6\u3002[VAR 0114(0025)]",
  "\u5728\u5BF9\u6218\u4E2D\u624D\u80FD\u4F7F\u7528\u7684\\n\u529B\u91CF\u5F3A\u5316\u548C\u7279\u653B\u5F3A\u5316\\r\\n\u4E5F\u80FD\u8BA9\u80FD\u529B\u7EA7\u522B\u5927\u5E45\u4E0A\u5347\u54E6\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u4E0B\u8BFE\u94C3\u54CD\u4E86\uFF1F\\n\u5DF2\u7ECF\u5230\u65F6\u95F4\u4E86\u5440\uFF0C\u771F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u8FD9\u6B21\u7684\u8BFE\u5F88\u96BE\uFF0C\\n\u6240\u4EE5\u8981\u5927\uFF5E\u5E45\u590D\u4E60\u54E6\u3002\\r\\n\u90A3\u4E48\uFF0C\u4E0B\u6B21\u518D\u89C1\u54AF\u3002[VAR 0114(0025)]"
]
