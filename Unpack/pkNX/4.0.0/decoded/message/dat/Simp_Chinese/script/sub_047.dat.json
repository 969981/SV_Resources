[
  "\u628A\u98DF\u6750\u8FD9\u6837\u2026\u2026\\n\u7136\u540E\u518D\u628A\u8C03\u5473\u6599\u90A3\u6837\u2026\u2026",
  "\u2026\u2026\u554A\uFF0C\u62B1\u6B49\uFF01\\n\u521A\u624D\u6211\u5728\u601D\u8003\uFF01\\c\\n\u6211\u5728\u7814\u7A76\u4E09\u660E\u6CBB\u7684\u98DF\u8C31\u3002\\c\\n\u603B\u6709\u4E00\u5929\u6211\u8981\u5B9E\u73B0\u68A6\u60F3\uFF0C\u90A3\u5C31\u662F\\n\u7814\u7A76\u51FA\u80FD\u88AB\u8A89\u4E3A\u5927\u5E08\u7EA7\u7684\u6781\u81F4\u98DF\u8C31\uFF01\\c\\n\u5982\u679C\u4F60\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\\n\u5C31\u8BA9\u6211\u4F20\u6388\u7ED9\u4F60\u4E09\u660E\u6CBB\u7684\u98DF\u8C31\u5427\uFF01",
  "[VAR 0100(0000)]\\n\u53EF\u4EE5\u5236\u4F5C\u65B0\u7684\u4E09\u660E\u6CBB\u4E86\uFF01",
  "[VAR 0100(0000)]\\n\u53EF\u4EE5\u5236\u4F5C\u65B0\u7684\u5927\u5E08\u7EA7\u4E09\u660E\u6CBB\u4E86\uFF01",
  "\u8FD9\u53EF\u662F\u597D\u5403\u5230\u4E0B\u5DF4\u90FD\u8981\u6389\u4E0B\u6765\uFF0C\\n\u8BD5\u7740\u505A\u505A\u770B\u5427\uFF01",
  "\u6211\u8981\u662F\u60F3\u51FA\u65B0\u98DF\u8C31\u7684\u8BDD\uFF0C\\n\u518D\u4F20\u6388\u7ED9\u4F60\u54E6\uFF01",
  "\u2026\u2026\u554A\uFF0C\u662F\u4F60\u554A\uFF01\\n\u6211\u60F3\u51FA\u65B0\u98DF\u8C31\u4E86\u54E6\uFF01",
  "\u2026\u2026\u554A\uFF0C\u662F\u4F60\u554A\uFF01\\c\\n\u6211\u73B0\u5728\u6B63\u5728\u7814\u7A76\u7684\u98DF\u8C31\\n\u9700\u8981\u5F88\u7A00\u6709\u7684\u8C03\u5473\u6599\u3002\\c\\n\u540D\u5B57\u53EB\u505A\u79D8\u4F20\uFF5E\u4EC0\u4E48\u7684\uFF0C\\n\u603B\u5171\u6709\uFF15\u79CD\u8C03\u5473\u6599\u2026\u2026\\c\\n\u53EA\u8981\u80FD\u770B\u4E0A\u4E00\u773C\u90A3\u4E9B\u8C03\u5473\u6599\uFF0C\\n\u6211\u6216\u8BB8\u5C31\u80FD\u60F3\u51FA\u65B0\u98DF\u8C31\u4E86\u3002",
  "\u90A3\u4E2A\u79D8\u4F20\uFF5E\u4EC0\u4E48\u7684\uFF0C\\n\u603B\u5171\u6709\uFF15\u79CD\u8C03\u5473\u6599\u2026\u2026\\c\\n\u53EA\u8981\u80FD\u770B\u4E0A\u4E00\u773C\u90A3\u4E9B\u8C03\u5473\u6599\uFF0C\\n\u6211\u6216\u8BB8\u5C31\u80FD\u60F3\u51FA\u65B0\u98DF\u8C31\u4E86\u3002",
  "\u4F60\u62FF\u7740\u7684\u90A3\u3001\u90A3\u4E2A\uFF01\\n\u4E0D\u5C31\u662F\u90A3\u4E2A\u79D8\u4F20\uFF5E\u4EC0\u4E48\u7684\u5417\uFF01\uFF1F\\r\\n\u545C\u545C\u2026\u2026\u554A\uFF0C\u554A\u554A\u2026\u2026\\r\\n\u6211\u7684\u8111\u6D77\u4E2D\u6D6E\u73B0\u51FA\u4E86\u98DF\u8C31\uFF5E\uFF01\uFF1F",
  "\u547C\uFF0C\u547C\u2026\u2026\\n\u6211\u521B\u4F5C\u51FA\u4E86\u60CA\u4EBA\u7684\u98DF\u8C31\uFF01\\r\\n\u8FD9\u6B63\u662F\u6781\u81F4\u7684\u4E09\u660E\u6CBB\u2026\u2026\uFF01\\r\\n\u8BF7\u4E00\u5B9A\u8BD5\u7740\u5236\u4F5C\u770B\u770B\u2026\u2026\uFF01\uFF01",
  "\u591A\u4E8F\u4E86\u4F60\uFF0C\u6240\u6709\u5927\u5E08\u7EA7\u4E09\u660E\u6CBB\u7684\\n\u6784\u60F3\u5168\u90E8\u6210\u4E3A\u4E86\u73B0\u5B9E\uFF01\\c\\n\u771F\u7684\u975E\u5E38\u611F\u8C22\u4F60\\n\u5728\u6211\u7684\u9010\u68A6\u4E4B\u8DEF\u4E0A\u7ED9\u4E88\u7684\u5E2E\u52A9\uFF01",
  "\u8FD9\u4E2A\u4E16\u754C\u4E0A\u4E00\u5B9A\u6709\\n\u5C1A\u65E0\u4EBA\u77E5\u7684\u7F8E\u5473\u4E09\u660E\u6CBB\uFF01\\c\\n\u4F60\u8981\u662F\u4E5F\u60F3\u51FA\u65B0\u98DF\u8C31\u7684\u8BDD\uFF0C\\n\u522B\u5FD8\u4E86\u548C\u5176\u4ED6\u4EBA\u5206\u4EAB\u54E6\uFF01"
]
