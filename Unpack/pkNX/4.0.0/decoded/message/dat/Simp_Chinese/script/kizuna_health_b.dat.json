[
  "\u6B22\u8FCE\u6765\u5230\\n\u7C73\u83AB\u838E\u7684\u533B\u52A1\u5BA4\uFF5E[VAR 0114(0028)]",
  "\u54A6\uFF1F[VAR 0100(0000)]\uFF0C\\n\u4F60\u662F\u4E0D\u662F\u53D8\u5F3A\u58EE\u4E86\u4E00\u70B9\uFF1F[VAR 0114(0028)]",
  "\u554A\uFF5E\u8FD9\u4E48\u4E0D\u5BA2\u6C14\u5440\uFF5E\uFF1F\\n\u4E0D\u8FC7\uFF0C\u4F60\u7684\u795E\u60C5\u771F\u7684\u53D8\u4E86\u3002[VAR 0114(0028)]",
  "\u4E0D\u5BF9\uFF5E\u4F60\u7684\u795E\u60C5\\n\u679C\u7136\u662F\u6709\u70B9\u53D8\u5316\u54E6\u3002[VAR 0114(0028)]",
  "\u6211\u731C\u4F60\u4E00\u5B9A\u901A\u8FC7\u5BFB\u5B9D\\n\u7ECF\u5386\u4E86\u5404\u79CD\u5404\u6837\u7684\u4E8B\u60C5\uFF5E[VAR 0114(0028)]",
  "\u7ED9\u6211\u8BB2\u8BB2\\n\u4F60\u90FD\u5728\u505A\u4E9B\u4EC0\u4E48\u5427\u3002[VAR 0114(0028)]",
  "\u54E6\uFF5E\u539F\u6765\u4F60\u5728\u505A\\n\u8FD9\u4E48\u6709\u8DA3\u7684\u4E8B\u60C5\u554A\uFF5E[VAR 0114(0028)]",
  "\u5C0F\u5B69\u5B50\u771F\u662F\u5389\u5BB3\uFF5E\u2026\u2026\\n\u6BCF\u5929\u90FD\u5728\u6311\u6218\u65B0\u4E8B\u7269\u5462\u3002[VAR 0114(0028)]",
  "\u76F8\u6BD4\u4E4B\u4E0B\u2026\u2026[VAR 0114(0028)]",
  "\u2026\u2026\u6211\u66FE\u7ECF\\n\u68A6\u60F3\u6210\u4E3A\u5B66\u6821\u7684\u8001\u5E08\u3002[VAR 0114(0028)]",
  "\u554A\uFF0C\u6211\u73B0\u5728\u53EA\u662F\u5B66\u6821\u62A4\u7406\u5E08\uFF0C\\n\u662F\u4E0D\u80FD\u4E0A\u8BFE\u7684\u3002[VAR 0114(0028)]",
  "\u517B\u62A4\u6559\u5E08\u7684\u8003\u8BD5\uFF0C\\n\u6211\u4E00\u76F4\u8003\u4E0D\u8FC7\uFF5E[VAR 0114(0028)]",
  "\u4E0D\u7BA1\u6311\u6218\u591A\u5C11\u6B21\u90FD\u4E0D\u884C\uFF0C\\n\u5C31\u8FD9\u6837\u5728\u533B\u52A1\u5BA4\u5F97\u8FC7\u4E14\u8FC7\u4E86\u3002[VAR 0114(0028)]",
  "\u554A\uFF0C\u62B1\u6B49\u3002\\n\u4E0D\u5C0F\u5FC3\u8BF4\u4E86\u8FD9\u4E48\u6C89\u91CD\u7684\u8BDD\u9898\u3002[VAR 0114(0028)]",
  "\u56E0\u4E3A\u4F60\u5F88\u64C5\u957F\u503E\u542C\uFF0C\\n\u4E0D\u77E5\u4E0D\u89C9\u5C31\u8BF4\u51FA\u6765\u4E86\u3002[VAR 0114(0028)]",
  "\u5E0C\u671B\u4F60\u4E0D\u8981\u4ECB\u610F\uFF0C\\n\u518D\u6765\u627E\u6211\u54E6\u3002[VAR 0114(0028)]",
  "\u4E0E\u7C73\u83AB\u838E\u8001\u5E08\u7684\u5173\u7CFB\\n\u53C8\u53D8\u597D\u4E86\u4E00\u4E9B\uFF01"
]
