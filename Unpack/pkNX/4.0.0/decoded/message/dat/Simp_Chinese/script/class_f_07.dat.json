[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8BF7\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u5149\u9634\u4F3C\u7BAD\uFF01[VAR 0114(0012)]",
  "\u65F6\u95F4\u7684\u6D41\u901D\u5982\u6B64\u4E4B\u5FEB\uFF0C\\n\u8FD9\u6B21\u5DF2\u7ECF\u662F\u540E\u534A\u6BB5\u7684\u6700\u540E\u4E00\u5802\u8BFE\u4E86\u3002[VAR 0114(0012)]",
  "\u4ECA\u5929\u5C0F\u751F\u8981\u544A\u8BC9\u5404\u4F4D\u7684\u4E8B\\n\u53EF\u80FD\u4E0E\u7F8E\u672F\u7684\u5173\u8054\u6CA1\u90A3\u4E48\u7D27\u5BC6\u3002[VAR 0114(0012)]",
  "\u4F46\u662F\u827A\u672F\u5E76\u6CA1\u6709\\n\u5FC5\u987B\u7EDD\u5BF9\u9075\u5FAA\u7684\u9650\u5236\uFF01[VAR 0114(0012)]",
  "\u6240\u4EE5\u5C0F\u751F\u5C31\\n\u653E\u4E0B\u987E\u8651\u5730\u7EE7\u7EED\u8BF4\u4E0B\u53BB\u4E86\u3002[VAR 0114(0012)]",
  "\u5E0C\u671B\u5404\u4F4D\u540C\u5B66\u8BB0\u4F4F\u4EE5\u4E0B\uFF12\u70B9\uFF01\\n\u5956\u7AE0\uFF01\u2026\u2026\u4EE5\u53CA\u8BC1\u7AE0\uFF01[VAR 0114(0012)]",
  "\u65E0\u8BBA\u662F\u5956\u7AE0\u8FD8\u662F\u8BC1\u7AE0\uFF0C\\n\u90FD\u50CF\u662F\u63CF\u8FF0\u90A3\u53EA\u5B9D\u53EF\u68A6\u7684\u4E00\u79CD\u79F0\u53F7\u3002[VAR 0114(0012)]",
  "\u5F53\u5B9D\u53EF\u68A6\u52AA\u529B\u8FBE\u6210\u67D0\u4EF6\u4E8B\uFF0C\\n\u6216\u662F\u7D2F\u79EF\u67D0\u79CD\u7ECF\u9A8C\u65F6\u2026\u2026[VAR 0114(0012)]",
  "\u4E3A\u4E86\u7EAA\u5FF5\u5B83\u6240\u8FBE\u5230\u7684\u6210\u679C\\n\u800C\u6234\u5728\u8EAB\u4E0A\u7684\uFF0C\u5C31\u662F\u5956\u7AE0\u3002[VAR 0114(0012)]",
  "\u6BD4\u5982\u5F53\u5B9D\u53EF\u68A6\u4E0E\u8BAD\u7EC3\u5BB6\\n\u4E4B\u95F4\u4EB2\u5BC6\u5230\u6781\u81F4\u65F6\uFF0C\\r\\n\u5C31\u80FD\u7ED9\u5B83\u6234\u4E0A\u597D\u53CB\u5956\u7AE0\u3002[VAR 0114(0012)]",
  "\u597D\u53CB\u5956\u7AE0\u7684\u8BA4\u5B9A\u4EBA\\n\u662F\u5728\u73BB\u74F6\u5E02\u5462\u3002[VAR 0114(0012)]",
  "\u53E6\u4E00\u65B9\u9762\uFF0C\u5927\u90E8\u5206\u7684\u8BC1\u7AE0\\n\u5219\u662F\u5B9D\u53EF\u68A6\u5728\u9047\u89C1\u8BAD\u7EC3\u5BB6\u65F6\\r\\n\u5C31\u5DF2\u7ECF\u6234\u7740\u7684\u4E1C\u897F\u3002[VAR 0114(0012)]",
  "\u6BD4\u5982\u6DD8\u6C14\u4E4B\u8BC1\uFF0C\\n\u6216\u662F\u6D3B\u529B\u4E4B\u8BC1\u7B49\u7B49\uFF0C\\r\\n\u8BC1\u7AE0\u5448\u73B0\u51FA\u4E86\u5B9D\u53EF\u68A6\u7684\u6027\u60C5\u3002[VAR 0114(0012)]",
  "\u80FD\u5426\u9047\u89C1\u6234\u7740\u8BC1\u7AE0\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u8FD9\u5B8C\u5168\u51ED\u8FD0\u6C14\uFF01[VAR 0114(0012)]",
  "\u5982\u679C\u80FD\u6349\u5230\u6234\u7740\u8BC1\u7AE0\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u90A3\u53EF\u662F\u975E\u5E38\u5E78\u8FD0\u7684\u3002[VAR 0114(0012)]",
  "\u6B64\u5916\uFF0C\u8FD8\u6709\u4EE4\u4EBA\u5F00\u5FC3\u7684\u5C0F\u4E50\u8DA3\uFF01\\n\u5982\u679C\u6709\u6234\u7740\u5956\u7AE0\u6216\u8BC1\u7AE0\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD8\u53EF\u4EE5\u505A\u4EC0\u4E48\u5462\uFF1F\u6709\u8C01\u77E5\u9053\u5417\uFF1F[VAR 0114(0012)]",
  "\u4EA4\u6362\u5956\u7AE0",
  "\u5411\u4EBA\u70AB\u8000",
  "\u6539\u53D8\u79F0\u547C",
  "\u2026\u2026\u5F88\u53EF\u60DC\uFF0C\u5956\u7AE0\u6216\u8BC1\u7AE0\\n\u4E0D\u80FD\u9001\u7ED9\u522B\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u4E5F\u4E0D\u80FD\u4EA4\u6362\u3002[VAR 0114(0012)]",
  "\u53EF\u4EE5\u5411\u4EBA\u70AB\u8000\uFF01\\n\u4F60\u8BF4\u5F97\u5B8C\u5168\u6CA1\u9519\uFF01\\r\\n\u4F46\u53EF\u522B\u8FD9\u6837\u5C31\u8F7B\u6613\u6EE1\u8DB3\u4E86\u54E6\uFF01[VAR 0114(0012)]",
  "\u771F\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF0C\\n\u4F60\u5F88\u535A\u5B66\u5462\u3002[VAR 0114(0012)]",
  "\u6234\u7740\u5956\u7AE0\u6216\u8BC1\u7AE0\u7684\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0012)]",
  "\u5728\u5B83\u88AB\u6D3E\u4E0A\u573A\u53BB\u5BF9\u6218\u65F6\uFF0C\\n\u4F60\u53EF\u4EE5\u7528\u559C\u7231\u7684\u79F0\u547C\u9001\u5B83\u51FA\u53BB\u54E6\u3002[VAR 0114(0012)]",
  "\u5982\u679C\u6234\u7740\u597D\u53CB\u5956\u7AE0\u7684\u8BDD\uFF0C\\n\u5C31\u662F\u201C\u4E0A\u5427\uFF01\u631A\u53CB\u5706\u9646\u9CA8\uFF01\u201D\\r\\n\u2026\u2026\u5927\u81F4\u5C31\u662F\u8FD9\u79CD\u611F\u89C9\u3002[VAR 0114(0012)]",
  "\u53E6\u5916\uFF0C\u521A\u624D\u5C0F\u751F\u8BB2\u8FC7\u5927\u90E8\u5206\u7684\u8BC1\u7AE0\\n\u662F\u5B9D\u53EF\u68A6\u5728\u9047\u89C1\u8BAD\u7EC3\u5BB6\u65F6\\r\\n\u5C31\u5DF2\u7ECF\u6234\u7740\u7684\u4E1C\u897F\u3002[VAR 0114(0012)]",
  "\u4F46\u6700\u8FD1\u4F3C\u4E4E\u6709\u4E9B\u8BC1\u7AE0\u662F\\n\u4ED8\u51FA\u4E86\u52AA\u529B\u5C31\u80FD\u83B7\u5F97\u7684\u3002[VAR 0114(0012)]",
  "\u7F8E\u98DF\u4E4B\u8BC1\u2026\u2026\\n\u6361\u62FE\u4E4B\u8BC1\u2026\u2026\\r\\n\u642D\u6863\u4E4B\u8BC1\uFF0C\u8BF8\u5982\u6B64\u7C7B\u3002[VAR 0114(0012)]",
  "\u628A\u8BC1\u7AE0\u7684\u540D\u5B57\u5F53\u4F5C\u7EBF\u7D22\u53BB\u8C03\u67E5\uFF0C\\n\u8BF4\u4E0D\u5B9A\u4E5F\u53E6\u6709\u4E00\u756A\u98CE\u8DA3\u5462\u3002[VAR 0114(0012)]",
  "\u597D\u4E86\uFF0C\\n\u6700\u540E\u4E00\u5802\u8BFE\u4E5F\u5C31\u6B64\u7ED3\u675F\u4E86\uFF01[VAR 0114(0012)]",
  "\u4E0B\u6B21\u5C31\u662F\u671F\u672B\u8003\u8BD5\u4E86\u3002\\n\u5404\u4F4D\u540C\u5B66\u8981\u597D\u597D\u590D\u4E60\uFF0C\\r\\n\u4E89\u53D6\u4E00\u6B21\u901A\u8FC7\u54E6\u3002[VAR 0114(0012)]"
