[
  "\u54A6\uFF0C\u83AB\u975E\u4F60\u5C31\u662F\\n\u4F20\u95FB\u4E2D\u7684\u90A3\u4E2A\u4EBA\u5417\uFF1F",
  "\u4ECE\u5E15\u5E95\u4E9A\u6765\u7559\u5B66\u7684\\n[VAR 0100(0000)]\uFF01\u6CA1\u9519\u5427\uFF1F",
  "\u6CA1\u9519\uFF01",
  "\u4F60\u662F\uFF1F",
  "\u6211\u662F\u70B9\u5FC3\u5927\u53D4\u3002",
  "\u5927\u53D4\u6211\u5440\uFF0C\\n\u559C\u6B22\u52AA\u529B\u7684\u5B66\u751F\u3002",
  "\u7279\u522B\u662F\u5728\u84DD\u4E50\u6D3B\u65B9\u9762\u975E\u5E38\u52AA\u529B\u7684\u4EBA\uFF0C\\n\u6211\u4F1A\u9001\u7ED9\u4ED6\u4EEC\u70B9\u5FC3\u4F5C\u4E3A\u5956\u52B1\u54E6\u3002",
  "\u6211\u9001\u7684\u70B9\u5FC3\u662F\u914D\u5408\u5B9D\u53EF\u68A6\u7684\u559C\u597D\\n\u624B\u5DE5\u5236\u4F5C\u7684\u7279\u6B8A\u70B9\u5FC3\uFF01",
  "\u53EA\u8981\u5E26\u5728\u8EAB\u4E0A\uFF0C\u53EF\u80FD\u5C31\u4F1A\\n\u5728\u67D0\u4E2A\u5730\u65B9\u548C\u5389\u5BB3\u7684\u5B9D\u53EF\u68A6\u76F8\u9047\u54E6\u3002",
  "\u4F60\u5728\u84DD\u4E50\u6D3B\u65B9\u9762\u597D\u597D\u52AA\u529B\u8FC7\u4E4B\u540E\\n\u8BB0\u5F97\u8981\u544A\u8BC9\u53D4\u53D4\u6211\u54E6\uFF01",
  "[VAR 0100(0000)]\u4F60\u7684\\n\u84DD\u4E50\u6D3B\u7684\u60C5\u51B5\u2026\u2026",
  "\u554A\u5440\u5440\uFF0C\u771F\u5389\u5BB3\uFF01\\n\u4F60\u5B8C\u6210\u96C6\u53CB\u5708\u4EFB\u52A1\u4E86\u5440\uFF01",
  "\u554A\u5440\u5440\uFF0C\u771F\u5389\u5BB3\uFF01\\n\u4F60\u90FD\u5B8C\u6210[VAR 0202(0001)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52A1\u4E86\uFF01",
  "\u54CE\u5440\u5440\uFF0C\u771F\u5389\u5BB3\uFF01\\n\u4F60\u90FD\u5B8C\u6210[VAR 0202(0001)]\u6B21\u84DD\u4E50\u6D3B\u7684\u4EFB\u52A1\u4E86\uFF01",
  "\u8981\u6211\u7ED9\u4F60\u5956\u52B1\u2026\u2026\\n\u53EF\u80FD\u8FD8\u4E3A\u65F6\u8FC7\u65E9\u554A\u3002",
  "\u518D\u5B8C\u6210[VAR 0202(0002)]\u6B21\u84DD\u4E50\u6D3B\u7684\u4EFB\u52A1\\n\u6216\u662F[VAR 0202(0003)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52A1\uFF0C\\r\\n\u6211\u5C31\u4F1A\u4E3A\u4F60\u9001\u4E0A\u70B9\u5FC3\u54E6\u3002",
  "\u4F60\u505A\u84DD\u4E50\u6D3B\u7684\u4EFB\u52A1\u5DF2\u7ECF\u8DB3\u591F\u52AA\u529B\u4E86\uFF0C\\n\u6240\u4EE5\u53EA\u8981\u518D\u5B8C\u6210[VAR 0202(0003)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52A1\uFF0C\\r\\n\u6211\u5C31\u4F1A\u4E3A\u4F60\u9001\u4E0A\u70B9\u5FC3\u54E6\u3002",
  "\u4F60\u505A\u96C6\u53CB\u5708\u4EFB\u52A1\u5DF2\u7ECF\u8DB3\u591F\u52AA\u529B\u4E86\uFF0C\\n\u6240\u4EE5\u53EA\u8981\u518D\u5B8C\u6210[VAR 0202(0002)]\u6B21\u84DD\u4E50\u6D3B\u7684\u4EFB\u52A1\uFF0C\\r\\n\u6211\u5C31\u4F1A\u4E3A\u4F60\u9001\u4E0A\u70B9\u5FC3\u54E6\u3002",
  "\u96C6\u53CB\u5708\u4EFB\u52A1\u5440\uFF0C\u597D\u50CF\u662F\\n\u5728\u8054\u76DF\u96C6\u53CB\u5708\u548C\u670B\u53CB\u4E00\u8D77\\r\\n\u5B8C\u6210\u5F88\u591A\u84DD\u4E50\u6D3B\u4EE5\u540E\u5C31\u4F1A\u5F00\u59CB\u54E6\u3002",
  "\u8FD8\u662F\u8BF4\u4F60\u60F3\u518D\u542C\u4E00\u6B21\\n\u7A00\u6709\u5B9D\u53EF\u68A6\u7684\u6545\u4E8B\u5462\uFF1F",
  "\u8981\u542C\u54EA\u53EA\u5B9D\u53EF\u68A6\u7684\u6545\u4E8B\u5462\uFF1F\\n\u5982\u679C\u4F60\u6709\u5B83\u7684\u70B9\u5FC3\u5C31\u7ED9\u6211\u770B\u770B\u5427\u3002",
  "\u90A3\u4E0D\u662F\\n\u6211\u7ED9\u4F60\u7684\u70B9\u5FC3\u5427\u2026\u2026",
  "\u4E0D\u542C\u6211\u8BB2\u6545\u4E8B\u5417\uFF1F\\n\u4F60\u4E0D\u7528\u5BA2\u6C14\u5440\uFF01",
  "\u65E2\u7136[VAR 0100(0000)]\u4F60\u8FD9\u4E48\u52AA\u529B\uFF0C\\n\u90A3\u6211\u5C31\u4E3A\u4F60\u9001\u4E0A\u5B9D\u53EF\u68A6\u7684\u70B9\u5FC3\u5427\u3002",
  "\u8FD9\u662F[VAR 0109(0004)]\uFF01",
  "[VAR 0101(0005)]\u554A\uFF0C\\n\u53EF\u662F\u4E00\u79CD\u975E\uFF5E\u5E38\u7A00\u6709\uFF0C\\r\\n\u5F88\u5C11\u80FD\u89C1\u5230\u7684\u5B9D\u53EF\u68A6\u54E6\u3002",
  "\u8BF4\u8D77\u6025\u51BB\u9E1F\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u7684\u96EA\u5C71\u627E\u5230\u4E2A\u5F88\u68D2\u7684\u6C60\u5858\uFF0C\\n\u4E8E\u662F\u5C31\u5728\u90A3\u51B0\u51B7\u7684\u6C60\u6C34\u91CC\u6E38\u8D77\u6CF3\u6765\u3002",
  "\u7136\u540E\u5440\uFF0C\u6025\u51BB\u9E1F\u5B83\\n\u5530\u5730\u4ECE\u7011\u5E03\u90A3\u8FB9\u98DE\u4E86\u4E0B\u6765\uFF0C\\r\\n\u5728\u6211\u7684\u5934\u9876\u4E00\u8FB9\u5531\u6B4C\u4E00\u8FB9\u98DE\u6765\u98DE\u53BB\u5462\uFF01",
  "\u6211\u9AD8\u5174\u5F97\u548C\u6025\u51BB\u9E1F\u5531\u8D77\u6B4C\u6765\uFF0C\\n\u592A\u9633\u4E0B\u4E86\u5C71\u4E5F\u6CA1\u6709\u505C\u4E0B\uFF0C\\r\\n\u56DE\u8FC7\u795E\u6765\u5DF2\u7ECF\u662F\u65E9\u4E0A\u5566\u3002",
  "\u8BF4\u8D77\u95EA\u7535\u9E1F\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u722C\u4E0A\u4E00\u5EA7\u706F\u5854\uFF0C\\n\u6B63\u5728\u773A\u671B\u8FDC\u5904\u7684\u57CE\u9547\u3002",
  "\u7136\u540E\u5440\uFF0C\u5929\u4E0A\u7A81\u7136\u54D7\u54D7\u4E0B\u8D77\u4E86\u5927\u96E8\uFF01\\n\u6211\u60F3\u7740\u201C\u8FD9\u53EF\u4E0D\u5F97\u4E86\u554A\u201D\uFF0C\\r\\n\u5C31\u6253\u7B97\u4ECE\u706F\u5854\u4E0A\u4E0B\u53BB\u3002",
  "\u8FD9\u65F6\u95EA\u7535\u9E1F\u4ECE\u7535\u95EA\u96F7\u9E23\u7684\u5929\u7A7A\\n\u98CE\u9A70\u7535\u63A3\u5730\u98DE\u4E86\u8FC7\u6765\uFF01\\r\\n\u5B83\u4ECE\u6211\u65C1\u8FB9\u7ECF\u8FC7\uFF0C\u7136\u540E\u5C31\u98DE\u8D70\u4E86\u3002",
  "\u8BF4\u8D77\u706B\u7130\u9E1F\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u5E15\u5E95\u4E9A\u7684\u897F\u90E8\u6500\u5CA9\u3002",
  "\u90A3\u5929\u7A81\u7136\u547C\u5730\u4E00\u4E0B\u522E\u8D77\u4E86\u6C99\u5C18\u66B4\uFF01\\n\u5F04\u5F97\u6211\u5634\u91CC\u90FD\u662F\u6C99\u5B50\uFF0C\u90A3\u6ECB\u5473\u53EF\u96BE\u53D7\u5566\uFF5E\\r\\n\u6211\u6B63\u6253\u7B97\u653E\u5F03\u6500\u5CA9\uFF0C\u8BF4\u65F6\u8FDF\u90A3\u65F6\u5FEB\u2026\u2026",
  "\u706B\u7130\u9E1F\u51FA\u73B0\u4E86\u3002\u5B83\u7684\u706B\u5149\\n\u8000\u773C\u5F97\u5728\u6C99\u5C18\u66B4\u91CC\u4E5F\u80FD\u770B\u89C1\u3002\\r\\n\u662F\u5B83\u9F13\u52B1\u4E86\u6211\u3002\u591A\u4E8F\u4E86\u5B83\uFF0C\\r\\n\u6211\u6700\u7EC8\u624D\u722C\u5B8C\u4E86\u90A3\u9762\u5CA9\u58C1\u3002",
  "\u8BF4\u8D77\u96F7\u516C\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u548C\u96F7\u516C\\n\u4E00\u8D77\u722C\u8FC7\u5C71\u5462\u3002",
  "\u56E0\u4E3A\u96F7\u516C\u5B83\u7279\u522B\u5730\u654F\u6377\uFF0C\\n\u80FD\u8FDC\uFF5E\u8FDC\u5730\u628A\u6211\u7529\u5728\u540E\u9762\u3002\\c\\n\u6240\u4EE5\u6211\u5C31\u4E00\u8FB9\u5BF9\u81EA\u5DF1\u8BF4\\n\u201C\u52A0\u628A\u52B2\u513F\u554A\uFF5E\u201D\u4E00\u8FB9\u62FC\u547D\u8FFD\u8D76\u5B83\u3002",
  "\u6700\u540E\uFF0C\u6211\u5728\u96F7\u516C\u7684\u8EAB\u8FB9\\n\u6B23\u8D4F\u5230\u4E86\u5317\u65B9\u5927\u5730\u4E0A\\r\\n\u96C4\u4F1F\u58EE\u89C2\u7684\u6C99\u6F20\u7F8E\u666F\u3002",
  "\u8BF4\u8D77\u708E\u5E1D\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u5192\u9669\uFF0C\\n\u78B0\u5DE7\u9047\u5230\u8FC7\u5B83\u5462\u3002",
  "\u90A3\u91CC\u662F\u5EA7\u77FF\u5C71\uFF0C\\n\u5730\u4E0A\u88AB\u6316\u5F97\u5230\u5904\u90FD\u662F\u5751\u3002\\c\\n\u4F46\u5373\u4FBF\u662F\u5DE8\u5927\u7684\u5751\uFF0C\\n\u708E\u5E1D\u4E5F\u80FD\u55D6\u5730\u4E00\u4E0B\u8DF3\u8FC7\u53BB\uFF01",
  "\u6211\u60F3\u7740\u81EA\u5DF1\u4E5F\u4E0D\u80FD\u8F93\u7ED9\u708E\u5E1D\uFF0C\\n\u5C31\u62FC\u547D\u5730\u8DDF\u5728\u5B83\u540E\u9762\u3002\\r\\n\u6700\u540E\u6211\u548C\u5B83\u4E00\u8D77\u5E76\u80A9\u6B23\u8D4F\u4E86\u5927\u6D77\u5462\u3002",
  "\u8BF4\u8D77\u6C34\u541B\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u5728\u5E15\u5E95\u4E9A\u7684\u4E00\u5EA7\u6709\u540D\u7684\u6E56\\n\u770B\u89C1\u8FC7\u6C34\u541B\u5462\u3002",
  "\u6211\u548C\u6C34\u541B\u8BF4\\n\u8981\u548C\u5B83\u6BD4\u4E00\u6BD4\uFF0C\\r\\n\u770B\u8C01\u80FD\u66F4\u5FEB\u5730\u6E38\u5230\u5CB8\u8FB9\u3002",
  "\u6211\u558A\u51FA\u201C\u9884\u5907\uFF5E\u5F00\u59CB\uFF01\u201D\u5C31\u6E38\u4E86\u8D77\u6765\u3002\\n\u6CA1\u60F3\u5230\u6C34\u541B\u80FD\u5728\u6C34\u9762\u4E0A\u8DD1\uFF0C\u5FEB\u5F97\u5F88\u3002\\r\\n\u6211\u4F5C\u4E3A\u4EBA\u7C7B\uFF0C\u53EA\u80FD\u7528\u4EF0\u6CF3\u548C\u5B83\u8F83\u91CF\u54E6\u3002\\c\\n\u4E0D\u8FC7\u90A3\u771F\u662F\u4E00\u573A\u7CBE\u5F69\u7684\u6BD4\u8D5B\u554A\u3002\\n\u6211\u4EE5\u5FAE\u5C0F\u7684\u5DEE\u8DDD\u8F93\u7ED9\u5B83\u5566\u3002",
  "\u8BF4\u8D77\u6D1B\u5947\u4E9A\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u7528\u4EF0\u6CF3\\n\u5728\u7F8E\u4E3D\u7684\u5E15\u5E95\u4E9A\u7684\u6D77\u4E0A\u6E38\u6CF3\u3002",
  "\u56E0\u4E3A\u90A3\u7247\u6D77\u7279\u522B\u5730\u51B7\uFF0C\\n\u7A0D\u5FAE\u6E38\u4E86\u4E00\u9635\u6211\u5C31\u611F\u89C9\u6D51\u8EAB\u53D1\u5BD2\u3002\\c\\n\u4E8E\u662F\u54C6\u54C6\u55E6\u55E6\u5730\u627E\u4E86\u4E2A\\n\u9644\u8FD1\u7684\u5C9B\u722C\u4E0A\u4E86\u5CB8\u3002",
  "\u7136\u540E\u5440\uFF0C\u9644\u8FD1\u51FA\u73B0\u4E86\u4E00\u4E2A\u5DE8\u5927\u7684\u6F29\u6DA1\uFF0C\\n\u6D1B\u5947\u4E9A\u4ECE\u6D77\u91CC\u5530\u5730\u8E7F\u4E86\u51FA\u6765\uFF01\\c\\n\u90A3\u573A\u666F\u8FDE\u6211\u90FD\u60CA\u6389\u4E86\u4E0B\u5DF4\uFF0C\\n\u9AD8\u5174\u5F97\u8FDE\u8EAB\u4E0A\u6709\u591A\u51B7\u90FD\u5FD8\u5566\u3002",
  "\u8BF4\u8D77\u51E4\u738B\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u90A3\u4E2A\u65F6\u5019\uFF0C\u6211\u4E5F\u2026\u2026\\n\u8FD8\u53EA\u662F\u4E2A\u65B0\u624B\u8BAD\u7EC3\u5BB6\u5462\u3002",
  "\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u897F\u5357\u90E8\u6709\u4E2A\u7011\u5E03\u3002\\n\u4E3A\u4E86\u8BA9\u5B9D\u53EF\u68A6\u53D8\u5F3A\uFF0C\\r\\n\u6211\u5728\u90A3\u9644\u8FD1\u901A\u5BB5\u8BAD\u7EC3\u3002\u5C31\u5728\u90A3\u65F6\uFF01",
  "\u51E4\u738B\u4EAE\u95EA\u95EA\u5730\u53D1\u7740\u5149\uFF0C\\n\u5728\u4E0A\u7A7A\u51FA\u73B0\u4E86\uFF01\\c\\n\u6211\u60F3\u51E4\u738B\u5B83\u53EF\u80FD\u662F\\n\u6765\u7ED9\u6211\u52A0\u6CB9\u7684\u5427\u3002",
  "\u8BF4\u8D77\u62C9\u5E1D\u4E9A\u65AF\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u5E15\u5E95\u4E9A\\n\u5357\u8FB9\u7684\u6D77\u91CC\u6E38\u4EF0\u6CF3\u3002",
  "\u6211\u6E38\u4E86\u597D\u4E00\u9635\u5B50\uFF0C\\n\u5B9E\u5728\u662F\u611F\u89C9\u6709\u70B9\u7D2F\u4E86\uFF0C\u4E8E\u662F\u5C31\\r\\n\u56DE\u5230\u5CB8\u4E0A\uFF0C\u53BB\u77F3\u5934\u7684\u9634\u51C9\u4E0B\u4F11\u606F\u4E00\u4F1A\u3002",
  "\u7ED3\u679C\u771F\u662F\u65E0\u5DE7\u4E0D\u6210\u4E66\u554A\uFF01\\n\u62C9\u5E1D\u4E9A\u65AF\u6B63\u597D\u5C31\u5728\u90A3\u91CC\u5462\u3002\\c\\n\u5B83\u548C\u6211\u56DB\u76EE\u76F8\u5BF9\uFF0C\u5FAE\u5FAE\u4E00\u7B11\uFF0C\\n\u7136\u540E\u5C31\u98DE\u8D70\u5566\u3002",
  "\u8BF4\u8D77\u62C9\u5E1D\u6B27\u65AF\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u5728\u5E15\u5E95\u4E9A\u4E1C\u5317\u90E8\\n\u5076\u7136\u9047\u5230\u8FC7\u5B83\u5462\u3002",
  "\u867D\u7136\u6211\u4EEC\u8BED\u8A00\u4E0D\u901A\uFF0C\\n\u4F46\u603B\u611F\u89C9\u5B83\u5728\u53EB\u6211\u8DDF\u4E0A\u6765\u3002\\c\\n\u4E8E\u662F\u6211\u5C31\u8FFD\u7740\u98DE\u8D70\u7684\u62C9\u5E1D\u6B27\u65AF\\n\u767B\u4E0A\u4E86\u5C16\u9510\u7684\u5CA9\u58C1\u3002",
  "\u56DE\u8FC7\u795E\u6765\uFF0C\u6211\u53D1\u73B0\u81EA\u5DF1\\n\u6765\u5230\u4E86\u4E00\u5904\u88AB\u5C71\u5D16\u5305\u56F4\u7684\u6C60\u5858\u3002\\r\\n\u90A3\u80AF\u5B9A\u662F\u4E2A\u4E0D\u4E3A\u4EBA\u77E5\u7684\u5730\u70B9\u5427\u3002",
  "\u8BF4\u8D77\u76D6\u6B27\u5361\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u5192\u9669\uFF0C\\n\u770B\u5230\u6D77\u91CC\u6709\u5947\u602A\u7684\u77F3\u5934\u3002",
  "\u7136\u540E\u6211\u624D\u60F3\u8D77\u2026\u2026\\n\u201C\u554A\uFF0C\u8FD9\u5C31\u662F\u90A3\u8457\u540D\u7684\\r\\n\u767E\u7075\u767E\u9A8C\u7684\u77F3\u5934\u5440\uFF01\u201D\\c\\n\u6211\u60F3\u7740\u6765\u90FD\u6765\u4E86\uFF0C\\n\u5C31\u95ED\u4E0A\u773C\u775B\u8BB8\u4E86\u4E2A\u613F\u3002",
  "\u8FC7\u4E86\u4E00\u4F1A\u513F\u6211\u7741\u5F00\u773C\u53D1\u73B0\uFF0C\\n\u77F3\u5934\u524D\u9762\u4E0D\u5F97\u4E86\uFF01\\c\\n\u53EA\u542C\u8F70\u9686\u4E00\u58F0\u5DE8\u54CD\uFF0C\u76D6\u6B27\u5361\u51FA\u73B0\u4E86\uFF01\\n\u771F\u662F\u628A\u6211\u5413\u4E86\u4E00\u5927\u8DF3\uFF01",
  "\u8BF4\u8D77\u56FA\u62C9\u591A\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\\n\u5192\u9669\u7684\u65F6\u5019\u89C1\u8FC7\u56FA\u62C9\u591A\u54E6\u3002",
  "\u4F60\u77E5\u9053\u5728\u9547\u5B50\u4E0B\u9762\u6709\u4E2A\u5927\u7A7A\u6D1E\u5427\uFF1F\\n\u90A3\u4E2A\u9547\u5B50\u53EB\u4EC0\u4E48\u540D\u5B57\u6765\u7740\u2026\u2026\\c\\n\u603B\u4E4B\u5B83\u5C31\u662F\u5728\u90A3\u91CC\\n\u8BA9\u6211\u7ED9\u649E\u89C1\u7684\u3002",
  "\u6211\u5F53\u65F6\u60F3\u7740\u201C\u554A\uFF0C\u662F\u56FA\u62C9\u591A\u201D\uFF0C\\n\u4E8E\u662F\u5C31\u6253\u8D77\u7CBE\u795E\u8BD5\u7740\u548C\u5B83\u6253\u4E86\u58F0\u62DB\u547C\u3002\\r\\n\u6BD5\u7ADF\u90A3\u53EF\u662F\u5927\u9646\u5B9D\u53EF\u68A6\u554A\u3002\\r\\n\u7136\u540E\u5440\uFF0C\u5B83\u5C31\u5411\u6211\u5C55\u793A\u4E86\u5927\u5927\u7684\u722A\u5B50\u3002",
  "\u8BF4\u8D77\u70C8\u7A7A\u5750\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u563F\u54DF\u563F\u54DF\u5730\\n\u722C\u4E00\u5EA7\u7279\uFF5E\u522B\u9661\u5CED\u7684\u5C71\u5D16\u3002",
  "\u7B49\u6211\u722C\u5230\u9876\u4E0A\uFF0C\u55E8\u5440\uFF0C\\n\u90A3\u666F\u8272\u53EF\u771F\u662F\u7F8E\u6781\u5566\u3002\\c\\n\u5F80\u811A\u4E0B\u4E00\u671B\uFF0C\\n\u53EA\u80FD\u770B\u5230\u6EE1\u773C\u7684\u767D\u4E91\uFF01\\r\\n\u53EF\u771F\u662F\u4E2A\u5947\u5999\u7684\u5730\u65B9\u554A\uFF5E",
  "\u5C31\u5728\u90A3\u65F6\uFF0C\u70C8\u7A7A\u5750\u5530\u5730\\n\u7A7F\u7834\u4E91\u5C42\u98DE\u4E86\u51FA\u6765\uFF01\\r\\n\u90A3\u573A\u9762\u5440\uFF5E\u53EF\u771F\u662F\u592A\u60CA\u4EBA\u5566\u3002",
  "\u8BF4\u8D77\u52FE\u5E15\u8DEF\u7FC1\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u5E15\u5E95\u4E9A\u5192\u9669\uFF0C\\n\u52FE\u5E15\u8DEF\u7FC1\u7A81\u7136\u4ECE\u5C71\u5D16\u4E0A\u8DF3\u4E86\u4E0B\u6765\u3002",
  "\u6211\u54CE\u5466\u5582\u5730\u53EB\u51FA\u58F0\u6765\uFF0C\\n\u60CA\u5F97\u5446\u4F4F\u4E86\u4E00\u4F1A\u513F\u3002\\c\\n\u53EF\u80FD\u662F\u56E0\u4E3A\u6211\u7684\u8868\u60C5\u5F88\u6709\u8DA3\u5427\uFF1F\\n\u52FE\u5E15\u8DEF\u7FC1\u5F00\u59CB\u6162\u60A0\u60A0\u5730\u8D70\u52A8\u8D77\u6765\uFF0C\\c\\n\u5E26\u7740\u6211\u53BB\u4E86\u90A3\u9644\u8FD1\\n\u6709\u540D\u7684\u7011\u5E03\u5462\u3002",
  "\u6211\u548C\u52FE\u5E15\u8DEF\u7FC1\u9053\u4E86\u8C22\u4E4B\u540E\uFF0C\\n\u5B83\u5C31\u8DD1\u7740\u7A7F\u8FC7\u7AF9\u6797\u79BB\u5F00\u4E86\u3002",
  "\u8BF4\u8D77\u4EE3\u62C9\u57FA\u7FC1\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u6709\u4E00\u5929\uFF0C\u6211\u548C\u5F80\u5E38\u4E00\u6837\uFF0C\\n\u6B63\u5728\u5FEB\u4E50\u5730\u6500\u5CA9\u3002",
  "\u6211\u722C\u5230\u76F8\u5F53\u9AD8\u7684\u5730\u65B9\u540E\\n\u56DE\u5934\u4E00\u770B\uFF0C\u6B63\u597D\u53EF\u4EE5\u5728\u5357\u8FB9\\r\\n\u770B\u89C1\u53D8\u5F97\u5C0F\u5C0F\u7684\u5706\u6A21\u9547\u3002\\c\\n\u6211\u770B\u5F97\u51FA\u4E86\u4E00\u4F1A\u513F\u795E\uFF0C\\n\u7A81\u7136\u95F4\u4EE3\u62C9\u57FA\u7FC1\u5728\u6211\u65C1\u8FB9\u5750\u4E0B\u4E86\uFF01",
  "\u6211\u611F\u89C9\u5B83\u770B\u8D77\u6765\u597D\u50CF\u5F88\u95F2\uFF0C\\n\u6240\u4EE5\u5C31\u548C\u5B83\u4E00\u8D77\u5403\u4E86\u70B9\u5FC3\u3002",
  "\u8BF4\u8D77\u6BD5\u529B\u5409\u7FC1\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u5192\u9669\uFF0C\\n\u78B0\u5230\u6BD5\u529B\u5409\u7FC1\u6B63\u5728\u6811\u836B\u4E0B\u4F11\u606F\u3002",
  "\u4E0D\u77E5\u600E\u4E48\u7684\uFF0C\\n\u90A3\u91CC\u7684\u6811\u4E0A\u9762\u6709\u5947\u7279\u7684\u82B1\u7EB9\u3002\\c\\n\u6211\u5728\u6811\u548C\u6BD5\u529B\u5409\u7FC1\u4E4B\u95F4\u770B\u6765\u770B\u53BB\uFF0C\\n\u5C31\u8FD9\u6837\u89C2\u8D4F\u4E86\u4E00\u9635\u3002",
  "\u7136\u540E\u5440\uFF0C\u6BD5\u529B\u5409\u7FC1\u4E5F\u6446\u51FA\u4E86\\n\u4E00\u5E45\u60CA\u5947\u7684\u8868\u60C5\u76EF\u7740\u6211\u770B\u3002\\c\\n\u4E8E\u662F\u6211\u5C31\u7ED9\u5B83\u8BB2\u5192\u9669\u7684\u6545\u4E8B\uFF0C\\n\u5B83\u542C\u5F97\u4F3C\u4E4E\u6D25\u6D25\u6709\u5473\u5462\u3002",
  "\u8BF4\u8D77\u83B1\u5E0C\u62C9\u59C6\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u7684\\n\u67D0\u4E2A\u9547\u5B50\u9644\u8FD1\u770B\u5230\u8FC7\u83B1\u5E0C\u62C9\u59C6\u54E6\u3002",
  "\u90A3\u662F\u4E00\u4E2A\u5DE5\u4EBA\u5F88\u591A\u7684\u9547\u5B50\u3002\\c\\n\u6211\u5728\u77F3\u5730\u7684\u4E0A\u65B9\u89C2\u8D4F\u4E86\u5F88\u4E45\\n\u4ED6\u4EEC\u52AA\u529B\u5DE5\u4F5C\u7684\u6837\u5B50\u3002",
  "\u6211\u6B63\u60F3\u7740\u201C\u4ED6\u4EEC\u53EF\u771F\u52AA\u529B\u554A\u201D\uFF0C\\n\u5FFD\u7136\u5BDF\u89C9\u5230\u6709\u4EC0\u4E48\u5728\u80CC\u540E\u3002\\c\\n\u56DE\u8FC7\u5934\u4E00\u770B\uFF0C\u53D1\u73B0\\n\u83B1\u5E0C\u62C9\u59C6\u6B63\u7AD9\u5728\u90A3\u91CC\u5462\uFF01\\c\\n\u53EF\u80FD\u662F\u56E0\u4E3A\u83B1\u5E0C\u62C9\u59C6\u4E5F\u559C\u6B22\\n\u52AA\u529B\u5DE5\u4F5C\u7684\u5DE5\u4EBA\u4EEC\u5427\uFF5E",
  "\u8BF4\u8D77\u6377\u514B\u7F57\u59C6\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u6B65\u884C\\n\u4ECE\u684C\u53F0\u5E02\u524D\u5F80\u6DF1\u94B5\u9547\u3002",
  "\u7136\u540E\u5440\uFF0C\u6211\u770B\u5230\u6709\u4E2A\u5927\u9ED1\u5F71\\n\u5728\u4E1C\u8FB9\u7684\u5929\u7A7A\u547C\u54BB\u5730\u98DE\u8FC7\uFF01\\c\\n\u6211\u4E00\u8FB9\u60F3\u7740\u201C\u600E\u4E48\u4E86\u600E\u4E48\u4E86\uFF01\uFF1F\u201D\\n\u4E00\u8FB9\u722C\u5230\u9AD8\u5904\u770B\u4E86\u770B\uFF0C\u53D1\u73B0\u662F\u6377\u514B\u7F57\u59C6\uFF01",
  "\u6211\u60CA\u5446\u4E86\uFF0C\u6123\u6123\u5730\u76EF\u7740\u4E0A\u65B9\u770B\uFF0C\\n\u7136\u540E\u6377\u514B\u7F57\u59C6\u5C31\u843D\u5230\u4E86\u6211\u8EAB\u8FB9\u3002\\c\\n\u6211\u4EEC\u4E92\u76F8\u76EF\u7740\u5BF9\u65B9\u770B\u4E86\u4E00\u4F1A\u513F\u3002\\n\u54CE\u5440\uFF5E\u6377\u514B\u7F57\u59C6\u53EF\u771F\u5E05\u554A\uFF5E",
  "\u8BF4\u8D77\u914B\u96F7\u59C6\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u6B63\u5728\u722C\u96EA\u5C71\uFF0C\\n\u78B0\u4E0A\u4E86\u731B\u70C8\u7684\u66B4\u98CE\u96EA\uFF0C\\r\\n\u6211\u60F3\u7740\u201C\u8FD9\u53EF\u53D7\u4E0D\u4E86\u554A\u201D\uFF0C\u5C31\u8FDB\u4E86\u4E00\u4E2A\u6D1E\u7A9F\u3002",
  "\u90A3\u4E2A\u6D1E\u7A9F\u5440\uFF0C\u7279\u522B\u5730\u5927\uFF0C\\n\u5C31\u597D\u50CF\u8FF7\u5BAB\u4E00\u6837\u5462\uFF01\\c\\n\u6211\u6765\u4E86\u5174\u81F4\uFF0C\\n\u5C31\u5F00\u59CB\u5728\u91CC\u9762\u63A2\u9669\uFF0C\\r\\n\u7A81\u7136\u4E00\u9762\u51B0\u5899\u52A8\u4E86\u8D77\u6765\u3002",
  "\u6211\u5FC3\u60F3\u201C\u54CE\u5440\u5440\uFF01\uFF1F\u201D\uFF0C\\n\u7136\u540E\u5B9A\u775B\u4ED4\u7EC6\u4E00\u770B\uFF0C\\r\\n\u53D1\u73B0\u539F\u6765\u662F\u914B\u96F7\u59C6\uFF01\u633A\u60CA\u4EBA\u7684\u5427\uFF1F",
  "\u8BF4\u8D77\u7D22\u5C14\u8FE6\u96F7\u6B27\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u5E74\u6211\u53BB\u5E15\u5E95\u4E9A\u5730\u533A\\n\u770B\u8FC7\u5B9D\u53EF\u68A6\u8054\u76DF\u3002",
  "\u6211\u5728\u5916\u9762\u770B\u7740\uFF0C\u5DE5\u4F5C\u4EBA\u5458\u6CE8\u610F\u5230\u6211\uFF0C\\n\u4E8E\u662F\u5C31\u8BA9\u6211\u8FDB\u53BB\u770B\u4E86\u3002\\c\\n\u5DE5\u4F5C\u4EBA\u5458\u751A\u81F3\u8FD8\u5E26\u6211\u53BB\u4E86\\n\u753B\u7740\u8054\u76DF\u6807\u5FD7\u7684\u89C2\u666F\u53F0\u5462\u3002\\c\\n\u6211\u5728\u90A3\u91CC\u773A\u671B\u5B66\u6821\u90A3\u8FB9\u7684\u98CE\u666F\uFF0C\\n\u7A81\u7136\u4E00\u4E2A\u5E9E\u5927\u7684\u8EAB\u5F71\u4ECE\u773C\u524D\u6A2A\u7A7F\u800C\u8FC7\uFF01",
  "\u6CA1\u60F3\u5230\u90A3\u8EAB\u5F71\u5C45\u7136\u662F\u7D22\u5C14\u8FE6\u96F7\u6B27\uFF01\\c\\n\u867D\u7136\u5B83\u4E00\u77AC\u95F4\u5C31\u8DD1\u8FDC\u4E86\uFF0C\\n\u6CA1\u80FD\u548C\u5B83\u6253\u62DB\u547C\uFF0C\u4F46\u5B83\u53EF\u771F\u5E05\u5440\uFF5E",
  "\u8BF4\u8D77\u9732\u5948\u96C5\u62C9\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u7684\\n\u6D77\u6EE9\u6B23\u8D4F\u5915\u9633\u3002",
  "\u770B\u7740\u592A\u9633\uFF0C\u5C31\u4F1A\u8BA9\u4EBA\\n\u610F\u8BC6\u5230\u81EA\u5DF1\u6709\u591A\u6E3A\u5C0F\u3002\\c\\n\u4E8E\u662F\u6211\u7684\u5FC3\u60C5\u5C31\\n\u53D8\u5F97\u6709\u70B9\u4F24\u611F\u3002\\c\\n\u8FD9\u65F6\uFF0C\u660E\u660E\u592A\u9633\u8FD8\u6CA1\u5B8C\u5168\u843D\u4E0B\uFF0C\\n\u5374\u6709\u4E00\u8F6E\u5DE8\u5927\u7684\u65B0\u6708\\r\\n\u4ECE\u773C\u524D\u54BB\u54BB\u5730\u6A2A\u7A7F\u800C\u8FC7\uFF01",
  "\u56E0\u4E3A\u4E8B\u60C5\u53D1\u751F\u5F97\u592A\u5FEB\uFF0C\\n\u90A3\u65F6\u6211\u6CA1\u592A\u641E\u6E05\u72B6\u51B5\u3002\\c\\n\u4F46\u7EDD\u5BF9\u4E0D\u4F1A\u6709\u9519\uFF0C\\n\u90A3\u4E2A\u526A\u5F71\u80AF\u5B9A\u5C31\u662F\u9732\u5948\u96C5\u62C9\u3002",
  "\u8BF4\u8D77\u5948\u514B\u6D1B\u5179\u739B\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u7684\u7011\u5E03\u4FEE\u884C\uFF0C\\n\u7136\u540E\u5948\u514B\u6D1B\u5179\u739B\u4ECE\u9AD8\u5904\\r\\n\u7528\u51F6\u6076\u7684\u773C\u795E\u72E0\u72E0\u5730\u77AA\u4E86\u6211\uFF01",
  "\u6211\u60F3\u7740\u201C\u53EF\u4E0D\u80FD\u88AB\u5B83\u770B\u6241\u4E86\u201D\uFF0C\\n\u4E8E\u662F\u8BD5\u7740\u201C\u54C8\uFF01\uFF01\u201D\u5730\u5927\u559D\u4E86\u4E00\u58F0\uFF0C\\r\\n\u7ED3\u679C\u5948\u514B\u6D1B\u5179\u739B\u7ACB\u523B\u5C31\u9003\u8D70\u4E86\u3002",
  "\u53EF\u80FD\u662F\u88AB\u6211\u7684\u558A\u58F0\u5413\u4E86\u4E00\u8DF3\u5427\uFF0C\\n\u5728\u90A3\u9644\u8FD1\u7684\u840C\u82BD\u9E7F\u5B83\u4EEC\u4E5F\u90FD\\r\\n\u9003\u4E4B\u592D\u592D\u5566\uFF5E\u54C8\u54C8\u54C8\u54C8\u54C8\u3002",
  "\u8BF4\u8D77\u718A\u5F92\u5F1F\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u5192\u9669\uFF0C\\n\u78B0\u5230\u718A\u5F92\u5F1F\u6B63\u5728\u4FEE\u884C\u5462\uFF01\\c\\n\u6211\u548C\u5B83\u642D\u8BDD\u8BF4\u201C\u54CE\u5440\uFF0C\u4F60\u5728\u4FEE\u884C\u5417\uFF1F\u201D\uFF0C\\n\u7136\u540E\u53D1\u73B0\u6211\u5C45\u7136\u548C\u5B83\u610F\u6C14\u76F8\u6295\u3002",
  "\u4E8E\u662F\u6211\u5C31\u548C\u5B83\u4E00\u8D77\u953B\u70BC\u4E86\u4E00\u9635\uFF0C\\n\u7ED3\u679C\u718A\u5F92\u5F1F\u5B83\u7A81\u7136\u53D8\u5F97\u626D\u626D\u634F\u634F\u3002",
  "\u628A\u957F\u5728\u65C1\u8FB9\u7684\u7AF9\u7B0B\\n\u62D4\u51FA\u6765\u9001\u7ED9\u6211\u4E86\u5462\uFF5E",
  "\u8BF4\u8D77\u96EA\u66B4\u9A6C\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u51FA\u4E8E\u4E2A\u4EBA\u7231\u597D\\n\u53BB\u722C\u5E15\u5E95\u4E9A\u7684\u96EA\u5C71\u3002",
  "\u6211\u5728\u79EF\u96EA\u7684\u9053\u8DEF\u4E0A\u8D70\u554A\u8D70\uFF0C\\n\u6B63\u5F53\u6211\u89C9\u5F97\u9A6C\u4E0A\u8981\u5230\u5C71\u9876\u7684\u65F6\u5019\uFF0C\\r\\n\u53D1\u73B0\u4E86\u4E00\u5EA7\u5012\u584C\u7684\u623F\u5B50\u3002\\c\\n\u56E0\u4E3A\u623F\u5B50\u7684\u5899\u58C1\u8FD8\u5F88\u7ED3\u5B9E\uFF0C\\n\u6211\u60F3\u5728\u90A3\u91CC\u4F11\u606F\u4E00\u4E0B\uFF0C\u4E8E\u662F\u5F80\u91CC\u9762\u770B\u4E86\u770B\u3002",
  "\u7ED3\u679C\u6CA1\u60F3\u5230\uFF0C\u6211\u88AB\u62A2\u5148\u4E86\u4E00\u6B65\uFF01\\n\u50CF\u767D\u96EA\u4E00\u6837\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u96EA\u66B4\u9A6C\u6B63\u5728\u91CC\u9762\u7761\u89C9\u5462\uFF01\\n\u54CE\u5440\uFF5E\u90A3\u573A\u9762\u771F\u662F\u8BA9\u6211\u60CA\u5446\u5566\uFF5E",
  "\u8BF4\u8D77\u7075\u5E7D\u9A6C\u2026\u2026\\n\u7ED9\u4F60\u8BB2\u8BB2\u6211\u5E74\u8F7B\u65F6\u7684\u6545\u4E8B\u5427\uFF1F\\c\\n\u5F53\u65F6\u6211\u51FA\u4E8E\u4E2A\u4EBA\u7231\u597D\\n\u53BB\u722C\u5E15\u5E95\u4E9A\u7684\u5C71\u3002",
  "\u6211\u6162\u6162\u60A0\u60A0\u5730\u8D70\u5728\\n\u8349\u6728\u4E1B\u751F\u7684\u767B\u5C71\u9053\u4E0A\u3002\\c\\n\u9014\u4E2D\u53D1\u73B0\u4E86\u4E00\u5EA7\u722C\u6EE1\u85E4\u8513\u7684\u5E9F\u589F\u3002\\n\u6211\u60F3\u5728\u90A3\u91CC\u4F11\u606F\u4E00\u4E0B\uFF0C\u4E8E\u662F\u5F80\u91CC\u9762\u770B\u4E86\u770B\u3002",
  "\u8FD9\u4E00\u770B\u53EF\u4E0D\u5F97\u4E86\uFF0C\\n\u50CF\u9ED1\u5F71\u4E00\u6837\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u7075\u5E7D\u9A6C\u7A81\u7136\u4ECE\u5E9F\u589F\u91CC\u63A2\u51FA\u4E86\u8111\u888B\uFF0C\\n\u771F\u662F\u628A\u6211\u5413\u4E86\u4E00\u5927\u8DF3\u5462\uFF5E",
  "\u53EA\u8981\u5E26\u7740\u70B9\u5FC3\uFF0C\\n\u4E5F\u8BB8\u4F60\u4E5F\u80FD\u89C1\u5230\u5B83\u54E6\uFF5E",
  "\u8981\u662F\u4F60\u89C1\u5230\u4E86[VAR 0101(0005)]\uFF0C\\n\u8BB0\u5F97\u5E2E\u6211\u548C\u5B83\u95EE\u597D\u54E6\u3002",
  "\u2026\u2026\u54A6\uFF1F\\c\\n\u628A\u521A\u624D\u90A3\u4E2A\u70B9\u5FC3\u7ED9\u4F60\u4E4B\u540E\uFF0C\\n\u6211\u624B\u4E0A\u7684\u70B9\u5FC3\u6B63\u597D\u6CA1\u6709\u4E86\u3002",
  "\u8FD9\u90FD\u662F[VAR 0100(0000)]\u4F60\\n\u52AA\u529B\u5B8C\u6210\u84DD\u4E50\u6D3B\u7684\u6210\u679C\u5440\uFF5E",
  "\u867D\u7136\u6211\u5DF2\u7ECF\u6CA1\u6709\u70B9\u5FC3\u53EF\u4EE5\u7ED9\u4F60\u4E86\uFF0C\\n\u4F46\u5076\u5C14\u2026\u2026\u4E5F\u6765\u542C\u6211\u8BB2\u8BB2\u6545\u4E8B\u5427\u3002",
  "[VAR 0100(0000)]\uFF01\u4F60\u8981\\n\u518D\u542C\u6211\u8BB2\u4E00\u6B21\u5B9D\u53EF\u68A6\u7684\u6545\u4E8B\u5417\uFF1F",
  "\u5927\u53D4\u6211\u5440\uFF01\u5728\u5E15\u5E95\u4E9A\u5730\u533A\u4EE5\u5916\u7684\\n\u5F88\u591A\u5730\u533A\u4E5F\u65C5\u884C\u8FC7\u54E6\u3002\\c\\n\u5728\u5404\u79CD\u5404\u6837\u7684\u5730\u65B9\\n\u5403\u8FC7\u5404\u79CD\u5404\u6837\u7684\u4E1C\u897F\u5462\uFF5E",
  "\u5927\u53D4\u6211\u5440\uFF01\u4EE5\u524D\u6253\\n\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E5F\u633A\u5F3A\u7684\u54E6\uFF01\\c\\n\u5F53\u65F6\u6211\u548C\u642D\u6863\u963F\u67CF\u602A\\n\u5728\u8001\u5BB6\u53EF\u662F\u6218\u65E0\u4E0D\u80DC\u5462\uFF5E",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u80FD\u6765\u6211\u597D\u9AD8\u5174\u5440\u3002\\c\\n\u9AD8\u5174\u5F97\u8BA9\u6211\u5FCD\u4E0D\u4F4F\\n\u90FD\u60F3\u5531\u6B4C\u5566\uFF5E\\r\\n\u55D2\uFF5E\u5566\u5566\u5566\u5566\u5566\uFF0C\u5566\u5566\uFF5E",
  "\u6211\u505A\u7684\u70B9\u5FC3\\n\u6750\u6599\u786E\u5B9E\u666E\u901A\u4E86\u70B9\u3002\\c\\n\u4F46\u6211\u4F1A\u4E00\u8FB9\u60F3\u8C61\u5403\u70B9\u5FC3\u7684\\n\u5B9D\u53EF\u68A6\u5F00\u5FC3\u7684\u6837\u5B50\u4E00\u8FB9\u5236\u4F5C\uFF0C\\r\\n\u6240\u4EE5\u5473\u9053\u4E00\u5B9A\u975E\uFF5E\u5E38\u597D\u5403\u5427\uFF5E",
  "\u867D\u7136\u6211\u4E0D\u61C2\u5B9D\u53EF\u68A6\u7684\u8BED\u8A00\uFF0C\\n\u4F46\u53EA\u8981\u770B\u7740\u5B83\u4EEC\u7684\u773C\u775B\uFF0C\\r\\n\u5C31\u80FD\u731C\u51FA\u5B83\u4EEC\u5927\u6982\u5728\u60F3\u4EC0\u4E48\uFF0C\u597D\u795E\u5947\u554A\uFF5E\\c\\n\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u3002\\n[VAR 0100(0000)]\u4F60\u4E5F\u8FD9\u4E48\u89C9\u5F97\u5427\uFF1F"
]
