[
  "\u8BF8\u4F4D\uFF0C\u6536\u8D77\u4F60\u4EEC\u7684\u624B\u673A\uFF0C\\n\u5F00\u59CB\u4E0A\u8BFE\u5427\u3002[VAR 0114(0029)]",
  "\u5728\u505A\u5B9E\u5730\u8C03\u67E5\u65F6\uFF0C\\n\u5982\u679C\u4E00\u76F4\u5E26\u7740\u5B9D\u53EF\u68A6\u8D70\u7684\u8BDD\u2026\u2026[VAR 0114(0029)]",
  "\u5B9D\u53EF\u68A6\u7684\u8272\u8C03\u5C31\u4F1A\u53D1\u751F\u53D8\u5316\u3002\\n\u6709\u4EBA\u6CE8\u610F\u5230\u8FD9\u4E00\u70B9\u5417\uFF1F[VAR 0114(0029)]",
  "\u54CE\u5440\uFF0C\u8FD9\u53EF\u4E0D\u662F\u5728\u8BF4\\n\u5B9D\u53EF\u68A6\u53D8\u6210\u4E86\u5F02\u8272\u5B9D\u53EF\u68A6\u2026\u2026[VAR 0114(0029)]",
  "\u2026\u2026\u800C\u662F\u5B83\u53D8\u5F97\u810F\u516E\u516E\u7684\uFF01[VAR 0114(0029)]",
  "\u4E00\u573A\u53C8\u4E00\u573A\u7684\u5BF9\u6218\uFF01\uFF01\\n\u63A5\u62DB\uFF01\u53D7\u4F24\uFF01\uFF01[VAR 0114(0029)]",
  "\u5386\u7ECF\u98CE\u5439\u96E8\u6253\uFF01\uFF01\\n\u641E\u5F97\u4E00\u8EAB\u6CE5\u6C99\uFF01\uFF01[VAR 0114(0029)]",
  "\u7136\u540E\u5C31\u4F1A\u53D8\u5F97\u810F\u516E\u516E\u7684\uFF01\uFF01[VAR 0114(0029)]",
  "\u8BAD\u7EC3\u5BB6\u5E26\u7740\u867D\u7136\u53EF\u7231\uFF0C\\n\u4F46\u5374\u810F\u516E\u516E\u7684\u5B9D\u53EF\u68A6\\r\\n\u56DB\u5904\u8D70\u52A8\u7684\u6837\u5B50\u5C61\u89C1\u4E0D\u9C9C\u3002\\r\\n\u2026\u2026\u771F\u662F\u53EF\u60B2\u53EF\u53F9\u3002[VAR 0114(0029)]",
  "\u90A3\u4E48\uFF0C\u65E0\u6CD5\u539F\u8C05\u8FD9\u79CD\u53EF\u803B\u884C\u4E3A\u7684\\n[VAR 0100(0000)]\uFF0C\u4F60\u6765\u56DE\u7B54\u3002[VAR 0114(0029)]",
  "\u5F53\u5B9D\u53EF\u68A6\u53D8\u5F97\u810F\u516E\u516E\u65F6\uFF0C\\n\u8981\u600E\u4E48\u529E\u624D\u597D\uFF1F[VAR 0114(0029)]",
  "\u5E2E\u5B9D\u53EF\u68A6\u6D17\u6FA1",
  "\u6478\u5B9D\u53EF\u68A6\u7684\u5934",
  "\u4E0D\u7BA1\u4E0D\u987E",
  "\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\uFF01\\n\u543E\u8F88\u786E\u4FE1\u4F60\u4E00\u5B9A\u4F1A\u8FD9\u6837\u56DE\u7B54\u7684\u3002[VAR 0114(0029)]",
  "\u55EF\u55EF\uFF01\u6478\u5934\u5938\u5956\u5B9D\u53EF\u68A6\u771F\u52AA\u529B\\n\u786E\u5B9E\u4F1A\u8BA9\u5F7C\u6B64\u90FD\u5634\u89D2\u4E0A\u626C\uFF0C\\r\\n\u4F46\u5374\u4E0D\u80FD\u9664\u53BB\u5B9D\u53EF\u68A6\u8EAB\u4E0A\u7684\u6C61\u6E0D\uFF01[VAR 0114(0029)]",
  "\u8EAB\u4E0A\u7684\u96E8\u6C34\u548C\u6CE5\u57A2\\n\u786E\u5B9E\u653E\u4EFB\u4E0D\u7BA1\u4E5F\u4F1A\u81EA\u52A8\u892A\u53BB\u2026\u2026\\r\\n\u4F46\u542C\u5230\u4F60\u8FD9\u6837\u56DE\u7B54\u8FD8\u771F\u662F\u51FA\u4E4E\u610F\u6599\u3002[VAR 0114(0029)]",
  "\u810F\u4E86\u5C31\u6D17\uFF01\\n\u8FD9\u624D\u662F\u4E16\u754C\u7684\u5E38\u8BC6\u554A\u3002[VAR 0114(0029)]",
  "\u5728\u91CE\u9910\u65F6\\n\u53EA\u8981\u9760\u8FD1\u540C\u884C\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u5C31\u80FD\u505A\u51FA\u5404\u79CD\u884C\u52A8\u3002[VAR 0114(0029)]",
  "\u5B9D\u53EF\u68A6\u6D17\u6FA1\u6FA1\\n\u5C31\u662F\u5176\u4E2D\u4E4B\u4E00\uFF01\\r\\n\u2026\u2026\u4E5F\u5C31\u662F\u5E2E\u5B9D\u53EF\u68A6\u6D17\u6FA1\uFF01[VAR 0114(0029)]",
  "\u9996\u5148\uFF0C\u8981\u4E00\u8FB9\u8BA9\u6D77\u7EF5\u8D77\u6CE1\uFF0C\\n\u4E00\u8FB9\u8F7B\u8F7B\u5730\uFF0C\u7EC6\u5FC3\u5730\\r\\n\u6413\u5B9D\u53EF\u68A6\u7684\u8EAB\u4F53\u3002[VAR 0114(0029)]",
  "\u7B49\u6CE1\u6CAB\u8D77\u5F97\u8DB3\u591F\u591A\u4E4B\u540E\u2026\u2026[VAR 0114(0029)]",
  "\u7528\u6DCB\u6D74\u628A\u5305\u4F4F\u6C61\u6E0D\u7684\u6CE1\u6CAB\u51B2\u5E72\u51C0\uFF0C\\n\u6FA1\u5C31\u6D17\u5B8C\u4E86\uFF01[VAR 0114(0029)]",
  "\u5B9D\u53EF\u68A6\u4F1A\u5982\u540C\u592A\u6676\u4E00\u822C\uFF0C\\n\u91CD\u65B0\u95EA\u8000\u5149\u8292\u7684\u3002[VAR 0114(0029)]",
  "\u8FD9\u867D\u7136\u5F88\u8D39\u529B\uFF0C\u4F46\u8FD8\u80FD\u8BA9\u5B9D\u53EF\u68A6\\n\u56DE\u590D\u4F53\u529B\uFF0C\u6CBB\u6108\u5F02\u5E38\u72B6\u6001\u3002[VAR 0114(0029)]",
  "\u4E0D\u8FC7\uFF0C\u6709\u7684\u5B9D\u53EF\u68A6\u8EAB\u4E0A\u6709\\n\u4E0D\u613F\u88AB\u6413\u7684\u90E8\u4F4D\\r\\n\u4EE5\u53CA\u4E0D\u613F\u88AB\u6C34\u5F04\u6E7F\u7684\u90E8\u4F4D\uFF0C\\r\\n\u6240\u4EE5\u8981\u7279\u522B\u6CE8\u610F\u3002[VAR 0114(0029)]",
  "\u800C\u6700\u91CD\u8981\u7684\u662F\uFF0C\\n\u4E5F\u6709\u504F\u504F\u5C31\u7231\u810F\u516E\u516E\u7684\u5B9D\u53EF\u68A6\u3002[VAR 0114(0029)]",
  "\u8FD9\u4E48\u8BF4\u4F1A\u81EA\u76F8\u77DB\u76FE\uFF0C\\n\u4F46\u5E0C\u671B\u8BF8\u4F4D\u4E0D\u8981\u5FD8\u8BB0\uFF0C\\r\\n\u4E0D\u662F\u53EA\u6709\u5E2E\u5B9D\u53EF\u68A6\u6D17\u6FA1\u624D\u4EE3\u8868\u5BF9\u5B83\u597D\u3002[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u5C31\u6B64\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
