[
  "\u554A\uFF0C\u4F60\u597D\u5440\uFF5E\u4F60\u597D\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u5DF2\u7ECF\u4E60\u60EF\u5B66\u6821\u4E86\u5417\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u90A3\u771F\u662F\u592A\u597D\u4E86\u554A\uFF0C\\n\u4F60\u770B\u8D77\u6765\u5F88\u5F00\u5FC3\uFF0C\u6211\u771F\u9AD8\u5174\u554A\u3002[VAR 0114(002A)]",
  "\u76F8\u4FE1\u4ECA\u540E\u4E00\u5B9A\u4F1A\\n\u53D8\u5F97\u8D8A\u6765\u8D8A\u5FEB\u4E50\u7684\u3002\\r\\n\u8981\u662F\u6709\u4EC0\u4E48\u70E6\u607C\uFF0C\u6211\u4EEC\u4E00\u8D77\u60F3\u529E\u6CD5\uFF5E[VAR 0114(002A)]",
  "\u5BF9\u4E86\uFF01\u4F60\u5728\u4F7F\u7528\\n\u5B9D\u53EF\u68A6\u56FE\u9274App\u5417\uFF1F[VAR 0114(002A)]",
  "\u5176\u5B9E\uFF0C\u5F00\u53D1\u5B83\u7684\u4EBA\uFF0C\\n\u563F\u563F\u2026\u2026\u5C31\u662F\u6211\u5566\u3002[VAR 0114(002A)]",
  "\u53EA\u8981\u5927\u5BB6\u6349\u5230\u5B9D\u53EF\u68A6\uFF0C\\n\u6570\u636E\u5C31\u4F1A\u4F20\u9001\u5230\u6211\u8FD9\u91CC\uFF0C\\r\\n\u4ECE\u800C\u5E2E\u52A9\u5B9D\u53EF\u68A6\u7684\u8C03\u67E5\u4E0D\u65AD\u8FDB\u5C55\uFF5E[VAR 0114(002A)]",
  "\u6240\u4EE5\u4F60\u8981\u662F\u53D1\u73B0\u4E86\u6CA1\u89C1\u8FC7\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5C31\u8BD5\u7740\u6355\u6349\u5B83\u6765\u586B\u5165\u56FE\u9274\u5427\u3002[VAR 0114(002A)]",
  "\u9996\u4E2A\u76EE\u6807\uFF0C\u6536\u96C6\uFF13\uFF10\u79CD\u5B9D\u53EF\u68A6\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6536\u96C6\u597D\u4EE5\u540E\uFF0C\u5C31\u6765\u544A\u8BC9\u6211\u4E00\u58F0\u5427\uFF5E[VAR 0114(002A)]"
]
