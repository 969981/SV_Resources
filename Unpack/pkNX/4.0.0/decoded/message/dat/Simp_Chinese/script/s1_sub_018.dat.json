[
  "\u6211\u4EEC\u554A\uFF5E\u662F\u4E00\u5BF9\\n\u8D85\u7EA7\u76F8\u4EB2\u76F8\u7231\u7684\u60C5\u4FA3\uFF0C\u5BF9\u5427\uFF5E\uFF1F",
  "\u8BF4\u7684\u5BF9\uFF01\u5373\u4F7F\u5728\u5B9D\u53EF\u68A6\u5F53\u4E2D\uFF0C\\n\u4E5F\u4E0D\u5B58\u5728\u50CF\u6211\u4EEC\u8FD9\u6837\\r\\n\u65E0\u65F6\u65E0\u523B\u90FD\u5728\u4E00\u8D77\u7684\u60C5\u4FA3\u5427\uFF01",
  "\u5C31\u662F\uFF01",
  "\u2026\u2026\u8FD9\u4F4D\u8DEF\u4EBA\uFF01",
  "\u5982\u679C\u4F60\u627E\u5230\u50CF\u6211\u4EEC\u8FD9\u4E48\\n\u76F8\u4EB2\u76F8\u7231\u7684\u5B9D\u53EF\u68A6\uFF01\\r\\n\u5C31\u5E26\u6765\u7ED9\u6211\u4EEC\u770B\u770B\u5427\uFF01",
  "\u6211\u89C9\u5F97\u4E0D\u4F1A\u6709\u5C31\u662F\u4E86\uFF01\\n\u554A\uFF5E\u54C8\u54C8\uFF5E\uFF01",
  "\u4F60\u627E\u5230\u65E0\u65F6\u65E0\u523B\\n\u90FD\u76F8\u4EB2\u76F8\u7231\u7684\u5B9D\u53EF\u68A6\u4E86\u5417\uFF1F",
  "\u600E\u4E48\u53EF\u80FD\u6709\u5566\uFF01\\n\u554A\uFF5E\u54C8\u54C8\uFF5E\uFF01",
  "\u8FD9\u5B9D\u53EF\u68A6\u2026\u2026\\n\u770B\u4E0A\u53BB\u5E76\u6CA1\u76F8\u4EB2\u76F8\u7231\u7684\u611F\u89C9\uFF01\\r\\n\u554A\uFF5E\u54C8\u54C8\uFF5E\uFF01",
  "\u4EC0\u3001\u4EC0\u4E48\uFF1F\u4E00\u5BF9\u9F20\uFF01\uFF1F\\c\\n\u65E0\u8BBA\u4F55\u65F6\u90FD\u5F85\u5728\u4E00\u8D77\u7684\u4EB2\u5BC6\u60C5\u4FA3\uFF0C\\n\uFF12\u53EA\u6210\u5BF9\u76F8\u4EB2\u76F8\u7231\uFF01\uFF1F",
  "\u4EC0\u3001\u4EC0\u4E48\uFF1F\u4E00\u5BB6\u9F20\uFF01\uFF1F\\c\\n\u5B83\u4EEC\u76F8\u4EB2\u76F8\u7231\u5F97\\n\u90FD\u751F\u4E0B\u5FC3\u809D\u5B9D\u8D1D\u4E86\uFF01\uFF1F",
  "\u4EC0\u3001\u4EC0\u4E48\uFF1F\u4E00\u5BB6\u9F20\uFF01\uFF1F\\c\\n\u5B83\u4EEC\u592A\u8FC7\u76F8\u4EB2\u76F8\u7231\uFF0C\u90FD\u751F\uFF12\u53EA\u5C0F\u5B69\u4E86\uFF01\uFF1F\\n\u4EB2\u5BC6\u7A0B\u5EA6\u90FD\u8D85\u8FC7\u4E00\u5BB6\u4E86\uFF01\uFF1F",
  "\u539F\u6765\u5728\u5B9D\u53EF\u68A6\u5F53\u4E2D\u2026\u2026\\n\u4E5F\u6709\u50CF\u6211\u4EEC\u8FD9\u4E48\u76F8\u4EB2\u76F8\u7231\u7684\u60C5\u4FA3\u554A\uFF01",
  "\u8C22\u8C22\u4F60\u5E26\u6765\u7ED9\u6211\u4EEC\u770B\uFF01\\n\u8BA9\u6211\u6559\u4F60\u4E2A\u52A8\u4F5C\u6765\u7B54\u8C22\u4F60\u5427\u3002",
  "[VAR 0100(0000)]\u4ECE\u60C5\u4FA3\u90A3\u91CC\\n\u5B66\u4F1A\u4E86[VAR FF00(0008)]\u7231\u5FC3\uFF08\u53F3\uFF09\u52A8\u4F5C[VAR FF00(0000)]\u548C\\r\\n[VAR FF00(0008)]\u7231\u5FC3\uFF08\u5DE6\uFF09\u52A8\u4F5C[VAR FF00(0000)]\uFF01",
  "\u76F8\u4EB2\u76F8\u7231\u7684\u52A8\u4F5C\u2026\u2026\\n\u8DDF\u522B\u4EBA\u4E00\u8D77\u6446\u6446\u770B\u5427\uFF01",
  "\u65E0\u8BBA\u662F\u4EBA\u8FD8\u662F\u5B9D\u53EF\u68A6\uFF0C\\n\u90FD\u5145\u6EE1\u7740\u7231\u610F\u5440\u3002"
]
