  "\u6211\u53C8\u611F\u89C9\u5230\u4E0A\u6B21\u8BF4\u7684\\n\u90A3\u9053\u70ED\u60C5\u4F3C\u706B\u7684\u76EE\u5149\u4E86\uFF01[VAR 0114(0025)]",
