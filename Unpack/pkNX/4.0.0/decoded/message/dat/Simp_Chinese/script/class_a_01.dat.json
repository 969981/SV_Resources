[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u662F\u8D1F\u8D23\u6559\u751F\u7269\u7684\u5409\u5C3C\u4E9A\u3002[VAR 0114(002A)]",
  "\u5728\u6211\u7684\u8BFE\u5802\u4E0A\uFF0C\\n\u6211\u4F1A\u548C\u5927\u5BB6\u4E00\u8D77\u5B66\u4E60\u5173\u4E8E\\r\\n\u6211\u6700\u559C\u6B22\u7684\u5B9D\u53EF\u68A6\u7684\u77E5\u8BC6\u54E6\u3002[VAR 0114(002A)]",
  "\u5982\u679C\u4F60\u4EEC\u80FD\u901A\u8FC7\u6211\u7684\u8BFE\\n\u800C\u66F4\u52A0\u559C\u6B22\u5B9D\u53EF\u68A6\uFF0C\u6211\u4F1A\u5F88\u9AD8\u5174\u7684\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\uFF0C\u6211\u5C31\u6765\u6559\u5927\u5BB6\u53EF\u4EE5\\n\u66F4\u6DF1\u5165\u4E86\u89E3\u5B9D\u53EF\u68A6\u7684\u65B9\u6CD5\u5427\uFF5E[VAR 0114(002A)]",
  "\u5982\u679C\u5927\u5BB6\u60F3\u548C\u81EA\u5DF1\u7684\u5B9D\u53EF\u68A6\\n\u66F4\u52A0\u76F8\u4EB2\u76F8\u7231\u7684\u8BDD\u2026\u2026[VAR 0114(002A)]",
  "\u5C31\u628A\u5B83\u4ECE\u7403\u91CC\u653E\u51FA\u6765\\n\u4E00\u8D77\u8D70\u8D70\u5427\uFF5E[VAR 0114(002A)]",
  "\u53E3\u8BC0\u662F\u201C[VAR FF00(0006)]\uFF3A\uFF32\u952E[VAR FF00(0000)]\u6295\u7403\uFF01\u201D\\c\\n\u5B9D\u53EF\u68A6\u4F1A\u8DDF\u5728\u4F60\u540E\u9762\u54E6\uFF0C\\n\u5F88\uFF5E\u53EF\u7231\u7684\u54E6\u3002[VAR 0114(002A)]",
  "\u5411\u8DDF\u8FC7\u6765\u7684\u5B9D\u53EF\u68A6\u642D\u8BDD\uFF0C\\n\u5B83\u5C31\u4F1A\u56DE\u5E94\u4F60\u3002\u8BF7\u8BD5\u8BD5\u770B\u3002\\r\\n\u8FD9\u6837\u5C31\u53EF\u4EE5\u66F4\u52A0\u4E86\u89E3\u5B9D\u53EF\u68A6\u54E6\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF01\u6709\u4E9B\u5730\u65B9\u662F\\n\u4E0D\u80FD\u5E26\u7740\u5B9D\u53EF\u68A6\u4E00\u8D77\u8D70\u7684\u3002\\r\\n\u6709\u8C01\u77E5\u9053\u662F\u54EA\u91CC\u5417\uFF1F[VAR 0114(002A)]",
  "\u6C34\u8FB9",
  "\u5BA4\u5185",
  "\u8349\u4E1B\u91CC",
  "\u7684\u786E\u6709\u4E9B\u5B9D\u53EF\u68A6\u4E0D\u559C\u6B22\u6C34\uFF0C\\n\u4F46\u662F\u4E5F\u6709\u5B9D\u53EF\u68A6\u4E13\u7528\u7684\u5C0F\u8247\uFF0C\\r\\n\u6240\u4EE5\u4E0D\u7528\u62C5\u5FC3\uFF0C\u5C3D\u7BA1\u5E26\u5B83\u4EEC\u53BB\u6C34\u8FB9\u8D70\u8D70\u5427\uFF5E[VAR 0114(002A)]",
  "\u54C7\uFF5E\u56DE\u7B54\u6B63\u786E\uFF01\\n[VAR 0100(0000)]\uFF0C\u4F60\u9884\u4E60\u5F97\u5F88\u5145\u5206\u54E6\uFF01[VAR 0114(002A)]",
  "\u5B9D\u53EF\u68A6\u6700\u7231\u8349\u4E1B\u4E86\uFF01\\n\u53CD\u800C\u5E26\u5B83\u4EEC\u8D70\u8FDB\u53BB\u4E5F\u5B8C\u5168\u6CA1\u95EE\u9898\u3002[VAR 0114(002A)]",
  "\u4E0D\u80FD\u5E26\u7740\u5B9D\u53EF\u68A6\u8D70\u7684\u5730\u65B9\\n\u5176\u5B9E\u662F\u5BA4\u5185\u54E6\uFF5E[VAR 0114(002A)]",
  "\u6709\u4E9B\u5B9D\u53EF\u68A6\u5728\u5BA4\u5185\u8D70\u52A8\u7684\u65F6\u5019\uFF0C\\n\u53EF\u80FD\u4F1A\u5F04\u574F\u5899\u58C1\u6216\u684C\u5B50\u7B49\uFF0C\\r\\n\u6240\u4EE5\u65E0\u8BBA\u4EC0\u4E48\u5B9D\u53EF\u68A6\uFF0C\u90FD\u7981\u6B62\u5728\u5BA4\u5185\u5E26\u7740\u8D70\u3002[VAR 0114(002A)]",
  "\u56E0\u6B64\uFF0C\u5927\u5BB6\u8981\u653E\u5B9D\u53EF\u68A6\u51FA\u6765\u65F6\uFF0C\\n\u539F\u5219\u4E0A\u8BF7\u5728\u6237\u5916\uFF5E\\r\\n\u867D\u7136\u5076\u5C14\u4E5F\u4F1A\u5728\u6559\u5BA4\u91CC\u89C1\u5230\u5B83\u4EEC\u5462\u2026\u2026[VAR 0114(002A)]",
  "\u5192\u9669\u65F6\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u8D70\uFF0C\\n\u5C31\u80FD\u548C\u5B83\u53D8\u5F97\u66F4\uFF5E\u4EB2\u5BC6\u54E6\u3002[VAR 0114(002A)]",
  "\u554A\uFF01\u80FD\u591F\u5E26\u7740\u4E00\u8D77\u8D70\u7684\\n\u662F\u961F\u4F0D\u91CC\u6700\u524D\u9762\u7684\u5B9D\u53EF\u68A6\u54E6\uFF5E[VAR 0114(002A)]",
  "\u53E3\u8BC0\u662F\u201C[VAR FF00(0006)]\uFF3A\uFF32\u952E[VAR FF00(0000)]\u6295\u7403\uFF01\u201D\\n\u5BF9\u7740\u91CE\u751F\u7684\u5B9D\u53EF\u68A6\u6295\u51FA\u53BB\u65F6\uFF0C\\r\\n\u4F1A\u76F4\u63A5\u8FDB\u5165\u6218\u6597\u54E6\u3002[VAR 0114(002A)]",
  "\u90A3\u4E48\uFF0C\u4ECA\u5929\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u4E0B\u8BFE\u54AF\uFF5E[VAR 0114(002A)]"
]
