[
  "\u5C0F\u751F\u662F\u8D1F\u8D23\u6559\u7F8E\u672F\u7684\u516B\u6714\u3002\\n\u8BF7\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u8BF4\u5230\u4F55\u8C13\u7F8E\u672F\uFF01[VAR 0114(0012)]",
  "\u5728\u5EA7\u7684\u5927\u591A\u6570\u540C\u5B66\u5728\u6BD5\u4E1A\u540E\uFF0C\\n\u90FD\u4F1A\u5C06\u8FD9\u95E8\u8BFE\u6240\u6559\u7684\u77E5\u8BC6\\r\\n\u5FD8\u5F97\u4E00\u5E72\u4E8C\u51C0\u5427\uFF01[VAR 0114(0012)]",
  "\u6BD5\u7ADF\u5728\u8003\u8BD5\u548C\u5C31\u4E1A\u65F6\uFF0C\\n\u662F\u4E0D\u4F1A\u8981\u6C42\u7F8E\u672F\u77E5\u8BC6\u548C\u7F8E\u611F\u7684\u3002[VAR 0114(0012)]",
  "\u5982\u6B64\u4E00\u6765\uFF0C\u5C0F\u751F\u7684\u8FD9\u95E8\u8BFE\\n\u96BE\u9053\u5C31\u53EA\u662F\u6D6A\u8D39\u65F6\u95F4\u5417\uFF1F[VAR 0114(0012)]",
  "\u2026\u2026\u4E00\u5B9A\u4E0D\u662F\u3002\\n\u5C0F\u751F\u5E0C\u671B\u4E0D\u662F\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B66\u8BF7\u601D\u8003\u4E00\u4E0B\uFF0C\\n\u201C\u7F8E\u201D\u4E0E\u201C\u4E0D\u7F8E\u201D\u7684\u533A\u522B\\r\\n\u7A76\u7ADF\u5728\u54EA\u91CC\u5462\uFF1F[VAR 0114(0012)]",
  "\u989C\u8272\u4E0E\u5F62\u72B6",
  "\u56E0\u4EBA\u800C\u5F02",
  "\u6211\u4E0D\u77E5\u9053",
  "\u55EF\uFF0C\u539F\u6765\u5982\u6B64\u2026\u2026\\n[VAR 0100(0000)]\u4F60\u662F\u5982\u6B64\u8BA4\u4E3A\u7684\u554A\u3002[VAR 0114(0012)]",
  "\u4E0D\uFF0C\u522B\u5728\u610F\u3002\\n\u8FD9\u9053\u9898\u6CA1\u6709\u6B63\u786E\u7B54\u6848\u3002\\r\\n\u91CD\u8981\u7684\u662F\u8981\u5404\u4F4D\u540C\u5B66\u53BB\u601D\u8003\u3002[VAR 0114(0012)]",
  "\u6BD4\u5982\u5728\u770B\u5230\u8DEF\u65C1\u7EFD\u653E\u7684\u82B1\u6735\u65F6\uFF0C\\n\u4E3A\u4EC0\u4E48\u4F1A\u611F\u5230\u5B83\u5F88\u7F8E\u4E3D\u5462\u3002[VAR 0114(0012)]",
  "\u5929\u7A7A\u7684\u84DD\u4E0E\u5927\u6D77\u7684\u84DD\uFF0C\u5DEE\u522B\u5728\u54EA\u91CC\uFF1F\\n\u4E3A\u4EC0\u4E48\u6811\u6728\u7684\u989C\u8272\u4F1A\u53D1\u751F\u53D8\u5316\uFF1F\\r\\n\u6DF1\u94B5\u9547\u98CE\u8F66\u7684\u8F6C\u52A8\u2026\u2026\\r\\n\u73BB\u74F6\u5E02\u6C34\u6D41\u7684\u51B7\u51BD\u2026\u2026[VAR 0114(0012)]",
  "\u901A\u8FC7\u601D\u8003\uFF0C\u6211\u4EEC\u80FD\u591F\u66F4\u9C9C\u660E\u3001\\n\u66F4\u6DF1\u523B\u5730\u53BB\u611F\u53D7\u8EAB\u65C1\u7684\u6240\u6709\u4E8B\u7269\u3002[VAR 0114(0012)]",
  "\u90A3\u4E00\u5B9A\u80FD\u591F\u5728\u5404\u4F4D\u5B66\u4E60\u5B66\u7D2F\u65F6\uFF0C\\n\u6216\u5728\u5DE5\u4F5C\u4E0A\u9047\u5230\u96BE\u5173\u65F6\u2026\u2026[VAR 0114(0012)]",
  "\u6210\u4E3A\u4ECE\u80CC\u540E\u8F7B\u8F7B\\n\u9F13\u52B1\u5404\u4F4D\u7684\u4E00\u80A1\u52A9\u529B\u54E6\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u4ECA\u5929\u7684\u5185\u5BB9\u6709\u70B9\u6DF1\u5965\uFF0C\\n\u5C31\u7B97\u6CA1\u542C\u61C2\u4E5F\u6CA1\u6709\u5173\u7CFB\u7684\u3002[VAR 0114(0012)]",
  "\u603B\u4E4B\uFF0C\u4F55\u8C13\u7F8E\u672F\uFF01\\n\u4EBA\u751F\u53EF\u4EE5\u6CA1\u6709\u7F8E\u672F\uFF0C\u4F46\u662F\u2026\u2026\\r\\n\u6709\u4E86\u5B83\uFF0C\u4F60\u7684\u4EBA\u751F\u4E00\u5B9A\u4F1A\u66F4\u5FEB\u4E50\uFF01[VAR 0114(0012)]",
  "\u8981\u662F\u7F8E\u672F\u80FD\u591F\u4E3A\u540C\u5B66\u4EEC\u7684\u751F\u6D3B\\n\u589E\u6DFB\u4E00\u4E9B\u8272\u5F69\uFF0C\u5C0F\u751F\u4F1A\u611F\u5230\u5F88\u559C\u60A6\u7684\u3002[VAR 0114(0012)]",
  "\u4E0B\u5802\u8BFE\u5F00\u59CB\uFF0C\u6211\u4EEC\u5C31\u7528\\n\u66F4\u5B9E\u8DF5\u7684\u65B9\u5F0F\u53BB\u63A5\u89E6\u4F55\u8C13\u7F8E\u5427\uFF01\u4E0B\u8BFE\uFF01[VAR 0114(0012)]"
]
