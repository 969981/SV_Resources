[
  "[VAR 0100(0000)]\uFF01\\n\u6211\u7B49\u4F60\u5F88\u4E45\u4E86\uFF01\\r\\n\u867D\u7136\u5E76\u6CA1\u6709\u8DDF\u4F60\u7EA6\u597D\uFF01[VAR 0114(0044)]",
  "\u5176\u5B9E\u554A\u2026\u2026\\n\u6211\u6709\u4E8B\u627E\u4F60\u3002[VAR 0114(0044)]",
  "\u6628\u5929\u7684\u2026\u2026\u90A3\u4E2A\uFF01\\n\u4F60\u6CA1\u6709\u8DDF\u4EFB\u4F55\u4EBA\u8BF4\u5427\uFF01\uFF1F[VAR 0114(0044)]",
  "\u6CA1\u8BF4",
  "\u90A3\u4E2A\uFF1F",
  "\u4F60\u6CA1\u9A97\u6211\u5427\uFF5E\uFF01\uFF1F\\n\u8981\u662F\u6492\u8C0E\u7684\u8BDD\uFF0C\\r\\n\u6211\u8BA9\u4F60\u751F\u541E\u74E6\u65AF\u5F39\u54E6\u3002[VAR 0114(0044)]",
  "\u8BF4\u90A3\u4E2A\u8FD8\u80FD\u662F\u54EA\u4E2A\uFF01\\n\u6211\u4EEC\u9047\u89C1\u7684\uFF01\u9B3C\u2026\u2026\u9B3C\u9B3C\u795F\u795F\u7684\u996D\u56E2\uFF01\\r\\n\u771F\u662F\u7684\uFF01\u6CA1\u60F3\u5230\u4F60\u8FD8\u633A\u4F1A\u6349\u5F04\u4EBA\u7684\uFF01[VAR 0114(0044)]",
  "\u5728\u697C\u68AF\u4E0A\u6361\u5230\u7684\u90A3\u4E2A\uFF0C\\n\u4F60\u5E26\u4E86\u5427\uFF1F[VAR 0114(0044)]",
  "\u6211\u7237\u7237\u5F88\u4E86\u89E3\u6751\u5B50\u7684\u5386\u53F2\uFF0C\\n\u6211\u4EEC\u627E\u4ED6\u5546\u91CF\u4E00\u4E0B\\r\\n\u6628\u5929\u7684\u4E8B\u60C5\u5427\u3002[VAR 0114(0044)]",
  "\u4F60\u77E5\u9053\u6211\u5BB6\u5728\u54EA\u5427\uFF1F\\n\u5FEB\u70B9\u6765\u54E6\u3002[VAR 0114(0044)]",
  "\u7ED9\u7237\u7237\u770B\u4E00\u4E0B\u90A3\u4E2A\u4E1C\u897F\u5427\u3002[VAR 0114(0044)]",
  "\u4ECB\u7ECD\u724C\u624D\u627E\u5230\uFF11\u4E2A\uFF01\\n\u4E39\u745C\u5979\u5B8C\u5168\u4E0D\u73B0\u8EAB\u554A\uFF01\\r\\n\u4E0D\u8FC7\uFF0C\u6B63\u662F\u8FD9\u79CD\u81EA\u7531\u81EA\u5728\u7684\u6027\u683C\u2026\u2026",
  "\u4E4C\u6817\u4ED6\u662F\u4E0D\u662F\u6015\u751F\uFF1F\\n\u5BF9\u4F60\u5012\u662F\u655E\u5F00\u5FC3\u6249\u4E86\u5462\u3002",
  "\u867D\u7136\u6211\u8FD8\u6CA1\u9002\u5E94\u95F7\u70ED\u7684\u5929\u6C14\uFF0C\\n\u4F46\u662F\u6E10\u6E10\u4E60\u60EF\u4E86\u866B\u5B9D\u53EF\u68A6\u54E6\uFF01",
  "\u63A9\u9762\u796D\u8FD8\u8981\u6301\u7EED\u4E00\u6BB5\u65F6\u95F4\uFF0C\\n\u8BF7\u5C3D\u60C5\u4EAB\u53D7\u5427\u3002[VAR 0114(0045)]"
]
