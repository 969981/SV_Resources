[
  "\u554A\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0004)]",
  "\u867D\u7136\u662F\u7D27\u8D76\u6162\u8D76\uFF0C\u4F46\u6211\u603B\u7B97\u662F\u505A\u597D\\n\u53EC\u5F00[VAR FF00(0006)]\u6821\u5185\u6700\u5F3A\u5927\u8D5B[VAR FF00(0000)]\u7684\u51C6\u5907\u5566\uFF5E\uFF01[VAR 0114(0004)]",
  "\u554A\uFF0C\u5927\u8D5B\u7684\u540D\u79F0\uFF1F\\n\u6211\u7BA1\u5B83\u53EB\u201C\u6821\u5185\u6700\u5F3A\u5927\u8D5B\u201D\uFF01\\r\\n\u5F88\u7B80\u5355\u6613\u61C2\u5427\uFF5E\uFF1F[VAR 0114(0004)]",
  "\u6D3E\u5E15\u8BF4\u201C\u6FC0\u6597\u6821\u56ED\u5927\u6218\u201D\\n\u8FD9\u4E2A\u540D\u5B57\u597D\u2026\u2026[VAR 0114(0004)]",
  "\u514B\u62C9\u97E6\u5C14\u6821\u957F\u4E5F\u89C9\u5F97\u90A3\u540D\u5B57\u4E0D\u9519\u65F6\uFF0C\\n\u8FD8\u771F\u662F\u8BA9\u6211\u4F24\u8111\u7B4B\u5462\uFF01[VAR 0114(0004)]",
  "\u2026\u2026[VAR 0100(0000)]\uFF0C\\n\u4F60\u505A\u597D\u5FC3\u7406\u51C6\u5907\u4E86\u5417\uFF01\uFF1F[VAR 0114(0004)]",
  "\u4F60\u7684\u53CD\u5E94\u771F\u723D\u5FEB\uFF01\\n\u6211\u60F3\u8981\u89C1\u8BC6\u4E00\u4E0B\u4F60\u8EAB\u4E3A\u51A0\u519B\u7684\u5B9E\u529B\uFF01[VAR 0114(0004)]",
  "\u554A\u54C8\u54C8\uFF01\u4F60\u5C31\u77E5\u9053\u5F00\u73A9\u7B11\uFF01\\n\u7761\u7CCA\u6D82\u4E86\u5427\uFF5E\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\u591A\u4E8F\u4E86\u4F60\uFF0C\\n\u9996\u5E2D\u624D\u80FD\u4F5C\u4E3A\u5609\u5BBE\u53C2\u8D5B\uFF0C\u771F\u662F\u592A\u68D2\u4E86\uFF01[VAR 0114(0004)]",
  "\u2026\u2026\u9057\u61BE\u7684\u662F\uFF0C\u6211\u8981\u4F5C\u4E3A\\n\u8FD0\u8425\u7684\u4E00\u5458\u5728\u540E\u53F0\u5DE5\u4F5C\uFF0C\\r\\n\u6240\u4EE5\u5B9E\u9645\u4E0A\u662F\u4E0D\u80FD\u53C2\u6218\u7684\u5462\uFF5E[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u7684\u5B9E\u529B\u5982\u4F55\uFF0C\\n\u5C31\u8BA9\u6211\u5BA2\u89C2\u5730\u7814\u7A76\u4E00\u4E0B\u5427\uFF01[VAR 0114(0004)]",
  "\u597D\u4E86\uFF0C\u5FEB\u5230\u5165\u53E3\u7684\u524D\u53F0\u96C6\u5408\u5427\uFF01\\n\u4E0D\u8BB8\u8FDF\u5230\u54E6\uFF5E\uFF01[VAR 0114(0004)]"
]
