[
  "\u55E8\uFF0C\u540C\u5B66\u4EEC\u597D\u3002\\n\u6628\u65E5\u4E5F\u5DF2\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u4E00\u90E8\u5206\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8BA9\u6211\u4EEC\u4E00\u8D77\\n\u89E3\u6790\u5386\u53F2\u7684\u7F8E\u5999\u4E4B\u5904\u5427\u3002[VAR 0114(0027)]",
  "\u5927\u7EA6\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\uFF0C\\n\u5E15\u5E95\u4E9A\u5E1D\u56FD\u5F00\u59CB\u7EDF\u6CBB\u8FD9\u4E2A\u5730\u533A\u3002[VAR 0114(0027)]",
  "\u636E\u8BF4\uFF0C\u5E15\u5E95\u4E9A\u7684\u7687\u5E1D\\n\u662F\u4E2A\u6781\u5176\u72EC\u88C1\u7684\u4EBA\u3002[VAR 0114(0027)]",
  "\u800C\u4E14\u4ED6\u70ED\u8877\u5730\u76F8\u4FE1\u7740\\n\u7B2C\u96F6\u533A\u7684\u6700\u6DF1\u5904\u91CC\u6709\u8D22\u5B9D\u7684\u4F20\u8BF4\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u53E4\u4EE3\u7684\u4EBA\u4EEC\u4E0D\u6BD4\u73B0\u5728\uFF0C\\n\u6587\u660E\u8FD8\u6CA1\u6709\u53D1\u5C55\u8D77\u6765\u3002[VAR 0114(0027)]",
  "\u90A3\u65F6\u7684\u4ED6\u4EEC\u66F4\u5BB9\u6613\u76F8\u4FE1\\n\u8D85\u51FA\u4EBA\u7C7B\u8BA4\u77E5\u7684\u4E1C\u897F\u3002\\r\\n\u4F8B\u5982\u4E0D\u53EF\u601D\u8BAE\u7684\u4F20\u8BF4\uFF0C\u4EE5\u53CA\u5492\u8BED\u2026\u2026[VAR 0114(0027)]",
  "\u4E3A\u4E86\u83B7\u5F97\u4E0E\u90BB\u56FD\u5BF9\u6297\u7684\u529B\u91CF\uFF0C\\n\u7687\u5E1D\u6D3E\u51FA\u4E86\u975E\u5E38\u591A\u7684\u4EBA\\r\\n\u524D\u53BB\u7B2C\u96F6\u533A\u53BB\u63A2\u7D22\u8D22\u5B9D\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u5E15\u5E95\u4E9A\u5E1D\u56FD\u5F00\u59CB\u7EDF\u6CBB\\n\u8FD9\u4E2A\u5730\u533A\u662F\u591A\u5C11\u5E74\u4EE5\u524D\u7684\u4E8B\uFF1F[VAR 0114(0027)]",
  "\u5927\u7EA6\uFF11\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7EA6\uFF12\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7EA6\uFF13\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\uFF11\uFF10\uFF10\uFF10\u5E74\u524D\u7684\u8BDD\uFF0C\\r\\n\u5E1D\u56FD\u5DF2\u7ECF\u5FEB\u8981\u89E3\u4F53\u4E86\u54E6\uFF01\uFF1F[VAR 0114(0027)]",
  "\u5475\uFF0C\u56DE\u7B54\u6B63\u786E\uFF01\\n\u60F3\u4E0D\u5230\u4F60\u8FD8\u6709\u4E9B\u5C0F\u806A\u660E\u5462\u3002\\r\\n\u770B\u6765\u4F60\u4E0A\u8BFE\u6709\u5728\u597D\u597D\u542C\u8BB2\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\uFF13\uFF10\uFF10\uFF10\u5E74\u524D\u7684\u8BDD\uFF0C\\r\\n\u5E1D\u56FD\u8FD8\u4E0D\u5B58\u5728\u54E6\uFF01\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026\u6CA1\u9519\uFF0C\u5927\u7EA6\u4ECE\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\u8D77\uFF0C\\n\u6F2B\u957F\u7684\u5927\u63A2\u7D22\u65F6\u4EE3\u62C9\u5F00\u4E86\u5E8F\u5E55\u3002[VAR 0114(0027)]",
  "\u4F46\u662F\uFF0C\u636E\u8BF4\u5F53\u65F6\\n\u5E1D\u56FD\u6240\u6D3E\u51FA\u7684\u5192\u9669\u8005\u4E2D\uFF0C\\r\\n\u6CA1\u6709\u4E00\u4EBA\u5230\u8FBE\u4E86\u6700\u6DF1\u5904\u3002[VAR 0114(0027)]",
  "\u4E0D\u77E5\u662F\u56E0\u4E3A\u8DEF\u9014\u8FC7\u4E8E\u8270\u8F9B\uFF0C\\n\u8FD8\u662F\u56E0\u4E3A\u906D\u9047\u4E86\u672A\u77E5\u7684\u5B58\u5728\u2026\u2026[VAR 0114(0027)]",
  "\u60F3\u5FC5\u96BE\u5EA6\u8FC7\u9AD8\u7684\u5927\u63A2\u7D22\\n\u4E3A\u63D0\u5347\u5DE8\u5751\u7684\u795E\u79D8\u5EA6\\r\\n\u753B\u4E0B\u4E86\u6D53\u58A8\u91CD\u5F69\u7684\u4E00\u7B14\u3002[VAR 0114(0027)]",
  "\u554A\u554A\u2026\u2026\uFF01\u6211\u4E5F\u597D\u60F3\u53BB\\n\u8FD8\u6CA1\u88AB\u7EF4\u4FEE\u7684\u7B2C\u96F6\u533A\u91CC\u63A2\u7D22\u554A\u2026\u2026\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u770B\u6765\u6211\u53EA\u80FD\u671F\u5F85\\n\u65F6\u5149\u673A\u5FEB\u70B9\u88AB\u7814\u53D1\u51FA\u6765\u4E86\u3002[VAR 0114(0027)]",
  "\u54CE\u5440\uFF1F\u6211\u6216\u8BB8\u8BF4\u592A\u591A\u4E86\uFF0C\\n\u65F6\u95F4\u597D\u50CF\u8D70\u592A\u5FEB\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u6211\u4EEC\u4E0B\u56DE\u518D\u89E3\u5386\u53F2\u4E4B\u8C1C\u3002[VAR 0114(0027)]"
]
