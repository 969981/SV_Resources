[
  "\u4F60\u597D\u5440\uFF5E\u4F60\u597D\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u4F60\u5728\u5317\u4E0A\u4E61\\n\u6349\u5230\u7684\u5B9D\u53EF\u68A6\u6709\u2026\u2026[VAR 0202(0001)]\u79CD\uFF01[VAR 0114(002A)]",
  "\u590F\u4EE4\u8425\u624D\u521A\u521A\u5F00\u59CB\uFF01\\c\\n\u4F60\u5C31\u53BB\u591A\uFF5E\u89C1\u89C1\\n\u53EA\u6709\u5317\u4E0A\u624D\u6709\u7684\u5B9D\u53EF\u68A6\u5427\uFF5E[VAR 0114(002A)]",
  "\u6C14\u5019\u4E0D\u540C\uFF0C\u6816\u606F\u7684\u5B9D\u53EF\u68A6\\n\u4E5F\u5F53\u7136\u4F1A\u6709\u6240\u4E0D\u540C\uFF5E\\c\\n\u5317\u4E0A\u7684\u590F\u5929\u6E7F\u5EA6\u5F88\u9AD8\uFF0C\\n\u6240\u4EE5\u4F1A\u6709\u559C\u6B22\u6E7F\u7B54\u7B54\u7684\u5B9D\u53EF\u68A6\u54E6\uFF5E[VAR 0114(002A)]",
  "\u542C\u8BF4\u5728\u9B3C\u5C71\u7684\u9AD8\u5904\\n\u4F1A\u6709\u706B\u5C71\u6C14\u4F53\u4ECE\u5730\u9762\u5192\u51FA\u6765\uFF01\\c\\n\u559C\u6B22\u6C14\u4F53\u7684\u5B9D\u53EF\u68A6\\n\u5F85\u5728\u90A3\u91CC\u5012\u662F\u5E94\u8BE5\u4F1A\u5F88\u8212\u670D\u2026\u2026[VAR 0114(002A)]",
  "\u4F46\u662F[VAR 0100(0000)]\uFF0C\\n\u4F60\u8981\u5C0F\u5FC3\u522B\u5438\u8FDB\u592A\u591A\u6C14\u4F53\u54E6\uFF5E[VAR 0114(002A)]",
  "\u54C7\uFF5E\uFF01\\n\u4F60\u7684\u5317\u4E0A\u56FE\u9274\u51E0\u4E4E\u5FEB\u586B\u6EE1\u4E86\uFF5E\uFF01\\c\\n\u4F60\u53EF\u4EE5\u5728\u56FE\u9274\u4E0A\u786E\u8BA4\u5B9D\u53EF\u68A6\u7684\u6816\u606F\u5730\uFF0C\\n\u6216\u662F\u53BB\u7ED3\u6676\u6D1E\u7A9F\u6311\u6218\u56E2\u4F53\u6218\u7B49\u7B49\u3002\\c\\n\u79BB\u5B8C\u6210\u5C31\u53EA\u5DEE\u4E00\u70B9\u4E86\uFF0C\\n[VAR 0100(0000)]\uFF0C\u597D\u597D\u52A0\u6CB9\u5427\uFF5E[VAR 0114(002A)]",
  "\u83AB\u975E\u8FD9\u91CC\u6709\u2026\u2026\\n\u5168\u90E8\u79CD\u7C7B\u4E86\u5417\uFF5E\uFF01\uFF1F[VAR 0114(002A)]",
  "\u54C7\uFF5E\u54C7\uFF5E\uFF01\\n\u5317\u4E0A\u56FE\u9274\u5B8C\u6210\u4E86\uFF5E\uFF01\\r\\n\u592A\u5389\u5BB3\u4E86\uFF5E\u771F\u7684\u592A\u5389\u5BB3\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u591A\u4E8F\u4E86[VAR 0100(0000)]\u4F60\uFF0C\\n\u5317\u4E0A\u4E61\u7684\u5B9D\u53EF\u68A6\u8C03\u67E5\\r\\n\u53D6\u5F97\u4E86\u524D\u6240\u672A\u6709\u7684\u8FDB\u5C55\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6211\u5F88\u60F3\u9001\u4E9B\u4EC0\u4E48\u7ED9\u4F60\u5F53\u4F5C\u5E86\u795D\uFF0C\\n\u4F46\u6211\u8EAB\u4E0A\u7684\u94B1\u4E0D\u592A\u591F\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u5BF9\u4E86\uFF01[VAR 0114(002A)]",
  "\u5C31\u628A\u6211\u5728\u5317\u4E0A\u4E2D\u5FC3\\n\u4E70\u5230\u7684\u9650\u5B9A\u571F\u7279\u4EA7\u9001\u7ED9\u4F60\u5427\uFF01[VAR 0114(002A)]",
  "\u8FD8\u6709\uFF0C\\n\u53EF\u4EE5\u8BF7\u4F60\u62FF\u51FA\u624B\u673A\u6D1B\u6258\u59C6\u5417\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u514B\u62C9\u97E6\u5C14\u6821\u957F\u5E2E\u6211\\n\u5728\u56FE\u9274App\u589E\u52A0\u4E86\u5956\u72B6\u529F\u80FD\uFF0C\\r\\n\u8BA9\u6211\u6765\u4E3A[VAR 0100(0000)]\u4F60\u5E86\u795D\u4E00\u4E0B\u5427\uFF5E[VAR 0114(002A)]",
  "\u8BA4\u8BC1\u5B9D\u53EF\u68A6\u56FE\u9274\u7684\u4F01\u4E1A\\n\u4E5F\u53D1\u6765\u4E86\u6D88\u606F\uFF5E[VAR 0114(002A)]",
  "\u867D\u8BF4\u56FE\u9274\u5DF2\u7ECF\u5B8C\u6210\u4E86\uFF0C\\n\u4F46\u590F\u4EE4\u8425\u624D\u521A\u521A\u5F00\u59CB\u3002[VAR 0114(002A)]",
  "\u4ECA\u540E\u4F60\u4E5F\u8981\u548C\\n\u8BB8\uFF5E\u591A\u5317\u4E0A\u7684\u5B9D\u53EF\u68A6\u76F8\u9047\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u5929\u6C14\u771F\u597D\u554A\uFF5E\\n\u795E\u6E05\u6C14\u723D\u7684\u4E00\u5929\u5C31\u6B64\u5F00\u59CB\uFF5E[VAR 0114(002A)]",
  "\u5317\u4E0A\u7684\u590F\u5929\u771F\u662F\u95F7\u70ED\u554A\uFF5E\\n\u6211\u7684\u767D\u8272\u5DE5\u4F5C\u888D\u91CC\u8FB9\u90FD\u6E7F\u900F\u4E86\uFF5E[VAR 0114(002A)]",
  "\u5317\u4E0A\u7684\u665A\u971E\\n\u8272\u8C03\u6BD4\u5E15\u5E95\u4E9A\u8981\u6DE1\uFF0C\u771F\u662F\u6F02\u4EAE\uFF5E\\r\\n\u662F\u56E0\u4E3A\u5149\u7684\u6298\u5C04\u7387\u6709\u6240\u4E0D\u540C\u5417\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u867D\u7136\u4F60\u5F88\u52AA\u529B\u5730\u5FD9\u5230\u8FD9\u4E48\u665A\uFF0C\\n\u4F46\u5076\u5C14\u4E5F\u62AC\u5934\u770B\u770B\u5929\u7A7A\u5427\uFF01\\c\\n\u9547\u91CC\u7684\u5149\u6E90\u5F88\u5C11\uFF0C\u6240\u4EE5\u5929\u4E0A\u7684\u661F\u661F\\n\u90FD\u80FD\u770B\u5F97\u4E00\u6E05\u4E8C\u695A\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u662F\u7531\u96E8\u6C34\u5F00\u542F\u7684\u4E00\u5929\uFF5E\\c\\n\u559C\u6B22\u4E0B\u96E8\u7684\u5B9D\u53EF\u68A6\\n\u8BF4\u4E0D\u5B9A\u4F1A\u975E\u5E38\u9AD8\u5174\u5427\uFF5E[VAR 0114(002A)]",
  "\u5317\u4E0A\u7684\u590F\u5929\u5C31\u7B97\u4E0B\u96E8\u4E5F\u5F88\u95F7\uFF0C\\n\u8FD9\u6C14\u5019\u771F\u662F\u4E0D\u5F97\u4E86\u3002\\c\\n\u8FD9\u79CD\u6C14\u5019\u4F3C\u4E4E\u4E5F\u4F1A\u5BF9\u751F\u6001\u7CFB\u7EDF\u4EA7\u751F\u5F71\u54CD\uFF5E[VAR 0114(002A)]",
  "\u4E0B\u5348\u7684\u96F7\u9635\u96E8\u4E0B\u5F97\u597D\u5927\u5440\uFF5E\\c\\n\u5982\u679C\u653E\u7740\u6E7F\u6F09\u6F09\u7684\u8EAB\u4F53\u4E0D\u7BA1\uFF0C\\n\u4F53\u6E29\u5C31\u4F1A\u4E0B\u964D\uFF0C\u8981\u5C0F\u5FC3\u554A\uFF5E[VAR 0114(002A)]",
  "\u665A\u4E0A\u4E0D\u4EC5\u89C6\u7EBF\u4E0D\u597D\uFF0C\\n\u8DEF\u9762\u8FD8\u56E0\u4E3A\u4E0B\u96E8\u800C\u53D8\u5F97\u5F88\u6CE5\u6CDE\uFF0C\\r\\n\u6240\u4EE5\u4F60\u4E0D\u8981\u53BB\u592A\u8FDC\u7684\u5730\u65B9\u554A\uFF5E[VAR 0114(002A)]",
  "\u76EE\u6807\u662F\u79F0\u9738\u5317\u4E0A\u56FE\u9274\uFF01\\n\u4E00\u5171\uFF12\uFF10\uFF10\u79CD\uFF5E\uFF01\\c\\n\u5B8C\u6210\u540E\u5728\u56FE\u9274App\u6309[VAR FF00(0006)]\uFF38\u952E[VAR FF00(0000)]\uFF0C\\n\u52A0\u4E0A\u5B8C\u6210\u56FE\u9274\u7684\u6807\u8BB0\uFF0C\\r\\n\u62FF\u6765\u7ED9\u6211\u770B\u4E00\u4E0B\u5427\uFF5E[VAR 0114(002A)]"
]
