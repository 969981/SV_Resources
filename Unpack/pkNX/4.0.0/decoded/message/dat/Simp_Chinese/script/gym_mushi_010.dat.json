  "\u5706\u6A21\u9053\u9986\u7684\u9053\u9986\u6D4B\u9A8C\u662F\u2026\u2026\\n[VAR FF00(0006)]\u6EDA\u6A44\u6984[VAR FF00(0000)]\uFF01",
