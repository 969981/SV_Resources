[
  "\u6211\u53C8\u60F3\u8D77\u6765\uFF5E\\n[VAR 0100(0000)]\u4F60\u6EDA\u6A44\u6984\u7684\u6837\u5B50\u4E86\u3002[VAR 0114(0016)]",
  "\u4F60\u5F53\u65F6\u7684\u52BF\u5934\u7B80\u76F4\u50CF\u662F\\n\u592A\u6676\u5316\u6210\u683C\u6597\u5C5E\u6027\u4E86\u5462\uFF5E[VAR 0114(0016)]",
  "[VAR 0100(0000)]\uFF0C\u6211\u8FD9\u91CC\u662F\\n\u4F60\u6311\u6218\u7684\u7B2C\u51E0\u4E2A\u9053\u9986\u5462\uFF5E\uFF1F[VAR 0114(0016)]",
  "\u5706\u6A21\u9053\u9986\u79BB\u5B66\u6821\u5F88\u8FD1\uFF0C\\n\u6240\u4EE5\u6709\u5F88\u591A\u8BAD\u7EC3\u5BB6\\r\\n\u4E00\u4E0A\u6765\u5C31\u4F1A\u9009\u8FD9\u91CC\u5462\uFF5E[VAR 0114(0016)]",
  "\u56E0\u6B64\u9996\u5E2D\u8981\u6211\u50CF\u751C\u70B9\u4E00\u6837\uFF0C\\n\u4E0B\u624B\u8981\u8F6F\uFF5E\u8F6F\u7684\uFF5E[VAR 0114(0016)]",
  "\u53EF\u662F\u6211\u7684\u866B\u513F\u4EEC\\n\u603B\u662F\u8F93\u7684\u8BDD\u5C31\u592A\u53EF\u601C\u4E86\u2026\u2026[VAR 0114(0016)]",
  "\u5475\u5475\uFF0C\u9047\u5230\u8FD9\u79CD\u597D\u673A\u4F1A\uFF0C\\n\u6211\u5C31\u80FD\u62FF\u51FA\u771F\u672C\u9886\u4E86\u3002\u597D\u5174\u594B\u54E6\uFF5E[VAR 0114(0016)]",
  "\u6211\u4F1A\u8BA9\u4F60\u8F93\u5F97\\n\u4F53\u65E0\u5B8C\u80A4\u7684\uFF5E\uFF01[VAR 0114(0016)]",
  "\u4F60\u7684\u8EAB\u624B\u4E0D\u4E9A\u4E8E\u9996\u5E2D\uFF0C\\n\u8BA9\u4EBA\u56DE\u5473\u65E0\u7A77\u554A\uFF5E[VAR 0114(0016)]",
  "\u554A\uFF5E\uFF01\u62FF\u51FA\u771F\u672C\u9886\u8F93\u6389\u5BF9\u6218\uFF0C\\n\u8FD9\u79CD\u611F\u89C9\u771F\u8212\u670D\uFF5E\uFF01[VAR 0114(0016)]",
  "\u770B\u6765\u4E0B\u624B\u592A\u8FC7\u8F6F\uFF5E\u8F6F\u7684\u8BDD\uFF0C\\n\u5BF9\u81EA\u5DF1\u548C\u5BF9\u624B\u53EF\u80FD\u90FD\u4E0D\u592A\u597D\u554A\uFF5E[VAR 0114(0016)]",
  "\u6599\u7406\u5E08\u5085\u6D77\u5CB1\u4E5F\u548C\u6211\u8BF4\u8FC7\\n\u8981\u66F4\u52A0\u5B66\u4F1A\u505A\u81EA\u5DF1\u624D\u884C\u5462\uFF5E[VAR 0114(0016)]",
  "\u4ECA\u540E\u6211\u4F1A\u8BD5\u7740\\n\u505A\u81EA\u5DF1\u2026\u2026\u591A\u4E00\u70B9\u70B9\uFF01[VAR 0114(0016)]",
  "\u8981\u662F\u6709\u4EBA\u8BF4\u5706\u6A21\u9053\u9986\u66F4\u96BE\u95EF\u4E86\uFF0C\\n\u6211\u5C31\u627E\u4E2A\u501F\u53E3\u8BF4\u5473\u9053\u53D8\u82E6\u4E86\u5427\uFF5E[VAR 0114(0016)]",
  "\u90A3\u4E48\uFF0C\\n\u6211\u4EEC\u540E\u4F1A\u6709\u671F\uFF5E[VAR 0114(0016)]"
