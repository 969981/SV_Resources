[
  "\u7D2B\u7AFD\u524D\u8F88\u4F1A\u5F88\u4EB2\u5207\u5730\\n\u6559\u522B\u4EBA\u5B9D\u53EF\u68A6\u7684\u77E5\u8BC6\u54E6\u3002",
  "\u7D2B\u7AFD\u6BCF\u5929\u4F1A\u7528\u5B9D\u53EF\u68A6\u6D17\u6FA1\u6FA1\\n\u7ED9\u5B9D\u53EF\u68A6\u6D17\u4E0A\u8DB3\u8DB3\uFF13\u6B21\u6FA1\u54E6\u3002\\r\\n\u6240\u4EE5\u5979\u7684\u5B9D\u53EF\u68A6\u603B\u662F\u5F88\u5E72\u51C0\u3002",
  "\u4E0D\u7BA1\u9F99\u5C5E\u6027\u591A\u4E48\u5F3A\uFF0C\\n\u5728\u5996\u7CBE\u7684\u529B\u91CF\u524D\u90FD\u4E0D\u582A\u4E00\u51FB\uFF01",
  "\u636E\u8BF4\u7D2B\u7AFD\u660E\u660E\\n\u5728\u5C5E\u6027\u4E0A\u6709\u4F18\u52BF\uFF0C\\r\\n\u4F46\u5374\u6CA1\u6253\u8D62\u8FC7\u675C\u82E5\u3002",
  "\u6D77\u5CB8\u533A\u7684\u9B45\u529B\u5728\u4E8E\u6D77\uFF01\\n\u7528\u7684\u53EF\u662F\u771F\u6B63\u7684\u6D77\u6C34\u54E6\uFF01",
  "\u5DE8\u86CB\u7684\u4F11\u606F\u7AD9\u4E2D\\n\u6709\u81EA\u52A8\u552E\u8D27\u673A\u54E6\uFF01\\r\\n\u5728\u90A3\u80FD\u4E70\u5230\u5404\u79CD\u7403\uFF01",
  "\u7528\u6F5C\u6C34\u7403\u80FD\u591F\u66F4\u5BB9\u6613\u5730\\n\u6349\u4F4F\u5728\u6E38\u6CF3\u7684\u5B9D\u53EF\u68A6\u54E6\u3002",
  "\u90A3\u4E9B\u5806\u780C\u7740\u65B9\u5757\u7684\u5730\u65B9\uFF0C\\n\u5C0F\u7684\u53EB\u4F11\u606F\u7AD9\uFF01\\r\\n\u800C\u5927\u7684\u5219\u53EB\u5E7F\u573A\u54E6\uFF01",
  "\u8D64\u677E\u7684\u6599\u7406\u53EF\u5389\u5BB3\u4E86\uFF01\\n\u4ED6\u4F1A\u7528\u9E2D\u5634\u708E\u517D\u7684\u706B\u70E4\u98DF\u6750\uFF01",
  "\u706B\u5C5E\u6027\u7684\u5B9D\u53EF\u68A6\\n\u4E0D\u4F1A\u9677\u5165\u707C\u4F24\u72B6\u6001\uFF01\\r\\n\u77E5\u9053\u8FD9\u70B9\u4FBF\u80FD\u9886\u5148\u522B\u4EBA\u4E00\u6B65\uFF01",
  "\u8349\u539F\u533A\u6709\u6591\u6591\u9A6C\uFF0C\\n\u6240\u4EE5\u8D85\u68D2\u7684\uFF01\\c\\n\u5F53\u4F60\u8DE8\u8D8A\u533A\u57DF\uFF0C\\n\u80FD\u9047\u5230\u7684\u5B9D\u53EF\u68A6\u5C31\u4F1A\u6539\u53D8\u54E6\uFF01",
  "\u56DB\u5929\u738B\u6218\u4F1A\u5728\u5404\u5E7F\u573A\u91CC\u7684\\n\u5BF9\u6218\u573A\u4E0A\u4E3E\u884C\u54E6\uFF01",
  "\u5728\u84DD\u8393\u8054\u76DF\u6392\u540D\u4E0D\u591F\u9AD8\u7684\u8BDD\uFF0C\\n\u751A\u81F3\u90FD\u4E0D\u80FD\u6311\u6218\u56DB\u5929\u738B\u54E6\u3002",
  "\u5927\u989A\u8681\u8FDB\u5316\u540E\uFF0C\\n\u4F1A\u589E\u52A0\u9F99\u5C5E\u6027\u54E6\uFF5E\\r\\n\u4E3A\u4EC0\u4E48\u5462\uFF1F\u771F\u4E0D\u53EF\u601D\u8BAE\uFF5E",
  "\u5728\u4F7F\u7528\u56DE\u590D\u673A\u65F6\u5982\u679C\u540E\u9762\u6709\u4EBA\uFF0C\\n\u6211\u5C31\u4F1A\u7D27\u5F20\u8D77\u6765\u2026\u2026\uFF01",
  "\u7EB3\u8389\u5979\u9177\u9177\u7684\uFF0C\u8D85\u8FF7\u4EBA\uFF01\\n\u5979\u4E0D\u4F46\u662F\u5B66\u751F\u4F1A\u957F\uFF0C\u8FD8\u662F\u56DB\u5929\u738B\uFF01",
  "\u5728\u5CE1\u8C37\u533A\u6709\u5F88\u591A\\n\u7C97\u72B7\u7684\u5B9D\u53EF\u68A6\uFF01\\c\\n\u56DB\u5929\u738B\u7EB3\u8389\u4E5F\u4F1A\\n\u6D3E\u51FA\u94A2\u5B9D\u53EF\u68A6\u54E6\uFF01",
  "\u53EB\u505A\u76D4\u7532\u9E1F\u7684\u5B9D\u53EF\u68A6\\n\u5F31\u70B9\u5F88\u5C11\uFF0C\u5F88\u96BE\u5BF9\u4ED8\u54E6\uFF01\\c\\n\u5728\u751F\u6001\u5DE8\u86CB\u4E2D\uFF0C\u5B83\u8FD8\u4F1A\u5316\u8EAB\\n\u98DE\u7FD4\u51FA\u79DF\u8F66\u5927\u663E\u8EAB\u624B\uFF01",
  "\u5728\u67D0\u4E2A\u5730\u533A\u4F3C\u4E4E\u5B58\u5728\u7740\\n\u94A2\u94E0\u9E26\u7684\u5929\u654C\u3002\\c\\n\u60F3\u5FC5\u662F\u4E00\u79CD\\n\u6837\u5B50\u5F88\u53EF\u6015\u7684\u5B9D\u53EF\u68A6\u5427\uFF01",
  "\u56E0\u4E3A\u5BF9\u94A2\u94E0\u9E26\u7684\u559C\u7231\uFF0C\\n\u8BA9\u6211\u548C\u4ED6\u53D8\u5F97\u5F88\u8981\u597D\uFF01",
  "\u7528\u5587\u53ED\u5544\u9E1F\u6311\u6218\u98DE\u7FD4\u8BA1\u65F6\u8D5B\\n\u5B9E\u5728\u662F\u6709\u70B9\u9C81\u83BD\u554A\u3002",
  "\u8FD9\u91CC\u662F\u7535\u6C14\u77F3\u5CA9\u7A9F\uFF01\\n\u5982\u679C\u5E26\u7535\u7684\u8BDD\u5C31\u4F1A\u9165\u9165\u9EBB\u9EBB\u7684\uFF01",
  "\u675C\u82E5\u662F\uFF12\u5E74\u7EA7\u5B66\u751F\u2026\u2026\\n\u54A6\uFF1F\\c\\n\u53BB\u5E74\u8DDF\u524D\u5E74\uFF0C\\n\u4ED6\u597D\u50CF\u4E5F\u662F\uFF12\u5E74\u7EA7\u5B66\u751F\u2026\u2026",
  "\u6781\u5730\u533A\u91CC\u6816\u606F\u7740\\n\u6297\u5BD2\u80FD\u529B\u5F88\u5F3A\u7684\u5B9D\u53EF\u68A6\u54E6\u3002\\r\\n\u611F\u89C9\u5F53\u4E2D\u5927\u591A\u662F\u51B0\u5C5E\u6027\u7684\uFF01",
  "\u8FD9\u524D\u9762\u662F\u5CE1\u8C37\u533A\uFF01\\n\u90A3\u91CC\u7684\u5CA9\u77F3\u8868\u9762\u5751\u5751\u6D3C\u6D3C\u7684\uFF0C\\r\\n\u6240\u4EE5\u5EFA\u8BAE\u4F60\u9A91\u4E0A\u5750\u9A91\u5B9D\u53EF\u68A6\u3002",
  "\u636E\u8BF4\u548C\u5927\u5BB6\u4E00\u8D77\u8FDB\u884C\u84DD\u4E50\u6D3B\u7684\u8BDD\uFF0C\\n\u83B7\u5F97\u7684\u62A5\u916C\u4F1A\u589E\u52A0\u54E6\uFF01\\r\\n\u867D\u7136\u6211\u6CA1\u6709\u670B\u53CB\u4E00\u8D77\u8FDB\u884C\u84DD\u4E50\u6D3B\u2026\u2026",
  "\u8FD9\u91CC\u662F\u4E2D\u5FC3\u5E7F\u573A\uFF01\\n\u662F\uFF14\u4E2A\u533A\u57DF\u4EA4\u63A5\u7684\u5730\u65B9\uFF01",
  "\u6700\u8FD1\u8054\u76DF\u793E\u91CC\u7684\\n\u6C1B\u56F4\u6709\u70B9\u5DEE\u2026\u2026",
  "\u81EA\u4ECE\u4E4C\u6817\u53D6\u4EE3\u675C\u82E5\\n\u6210\u4E86\u51A0\u519B\u4E4B\u540E\u2026\u2026\\r\\n\u793E\u56E2\u6D3B\u52A8\u5C31\u53D8\u5F97\u4E0D\u5FEB\u4E50\u4E86\u3002",
  "\u867D\u7136\u8FD9\u6837\u8BF4\u4E0D\u592A\u597D\uFF0C\\n\u4F46\u6211\u65E9\u5C31\u5E0C\u671B\u4E4C\u6817\u653E\u5F03\u5F53\u51A0\u519B\u4E86\u3002\\r\\n\u6240\u4EE5\u73B0\u5728\u5F88\u5F00\u5FC3\u3002",
  "\u542C\u8BF4\u65B0\u7684\u51A0\u519B\\n\u4E0D\u662F\u5B66\u56ED\u91CC\u7684\u4EBA\uFF01",
  "\u80FD\u5F00\u5FC3\u8FDB\u884C\u5BF9\u6218\u7684\\n\u8054\u76DF\u793E\u590D\u6D3B\u4E86\uFF01",
  "\u73B0\u5728\u7684\u793E\u56E2\u6D3B\u52A8\uFF0C\\n\u6211\u6709\u52A8\u529B\u52A0\u6CB9\uFF01\\r\\n\u4E89\u53D6\u5F53\u4E2A\u56DB\u5929\u738B\u4EC0\u4E48\u7684\u5427\uFF01",
  "\u5DE8\u86CB\u4E2D\u7684\u65B9\u5757\\n\u4F1A\u53D1\u5C04\u51FA\u7EA2\u5916\u7EBF\u548C\u7D2B\u5916\u7EBF\uFF01\\c\\n\u2026\u2026\u636E\u8BF4\u4F1A\u4FC3\u8FDB\\n\u5B9D\u53EF\u68A6\u548C\u690D\u7269\u7684\u6210\u957F\uFF01",
  "\u90A3\u8FB9\u662F\u6781\u5730\u533A\uFF01\\c\\n\u56E0\u4E3A\u90A3\u91CC\u6709\u901A\u8FC7\u4EBA\u5DE5\\n\u91CD\u73B0\u51FA\u7684\u51B0\u5C71\uFF0C\u6240\u4EE5\u5F88\u51B7\u54E6\uFF5E",
  "\u56E2\u4F53\u6218\u4E4B\u7C7B\u7684\u4EFB\u52A1\uFF0C\\n\u548C\u5927\u5BB6\u4E00\u8D77\u505A\u7684\u8BDD\u5C31\u80FD\u8F7B\u677E\u5B8C\u6210\uFF01",
  "\u6211\u8981\u548C\u54E5\u54E5\\n\u4E00\u8D77\u8FDB\u884C\u84DD\u4E50\u6D3B\uFF5E\uFF01",
  "\uFF11\u5E74\u7EA7\u90A3\u4E2A\u53EB\u4E4C\u6817\u7684\u5B69\u5B50\uFF0C\\n\u7ED9\u4EBA\u7684\u611F\u89C9\u7A81\u7136\u53D8\u4E86\u3002",
  "\u51A0\u519B\u6218\u6253\u5F97\u592A\u7CBE\u5F69\u4E86\u3002\\n\u76F8\u4FE1\u4E4C\u6817\u5F88\u4E0D\u7518\u5FC3\u5427\u3002",
  "\u636E\u8BF4\u4E4C\u6817\u4F11\u5B66\u4E86\uFF0C\\n\u5E0C\u671B\u4ED6\u80FD\u65E9\u65E5\u632F\u4F5C\u8D77\u6765\u3002",
  "\u53EA\u6709\u4F18\u79C0\u7684\u5B66\u751F\uFF01\\n\u80FD\u6536\u5230\u592A\u6676\u73E0\u3002\\r\\n\u2026\u2026\u636E\u8BF4\u90A3\u6750\u6599\u5F88\u8D35\u91CD\uFF01",
  "\u592A\u6676\u5316\u771F\u662F\u6DF1\u5965\uFF01\\n\u6709\u65F6\u8FD8\u4F1A\u589E\u52A0\u5F31\u70B9\uFF01",
  "\u90A3\u8FB9\u662F\u6D77\u5CB8\u533A\uFF01\\n\u6709\u82B1\u6709\u6D77\uFF0C\u5982\u540C\u8EAB\u5728\u963F\u7F57\u62C9\uFF01\uFF1F",
  "\u54A6\uFF1F\u83AB\u975E\u2026\u2026\\n\u65B9\u5757\u7684\u989C\u8272\u4F1A\u6839\u636E\u533A\u57DF\u800C\u4E0D\u540C\uFF1F",
  "\u5728\u6211\u7684\u540E\u9762\uFF0C\\n\u6709\u62DB\u5F0F\u5B66\u4E60\u5668\u6389\u5728\u5730\u4E0A\u54E6\u3002\\r\\n\u4F60\u6361\u4E86\u5417\uFF1F",
  "\u8054\u76DF\u793E\u7684\u5B69\u5B50\u4EEC\\n\u5173\u7CFB\u4E0D\u591F\u878D\u6D3D\uFF1F\\r\\n\u4F5C\u4E3A\u8001\u5E08\uFF0C\u6211\u53EF\u4E0D\u80FD\u5750\u89C6\u4E0D\u7406\u3002",
  "\u8054\u76DF\u793E\u7684\u5B69\u5B50\u4EEC\\n\u4F3C\u4E4E\u8E0F\u5B9E\u4E0B\u6765\u4E86\u3002\\r\\n\u4F5C\u4E3A\u8001\u5E08\uFF0C\u6211\u5374\u4EC0\u4E48\u90FD\u6CA1\u505A\u5230\u3002",
  "\u8054\u76DF\u793E\u7684\u5B69\u5B50\u4EEC\\n\u50CF\u4EE5\u524D\u4E00\u6837\u91CD\u62FE\u4E86\u7B11\u5BB9\u3002\\r\\n\u4F5C\u4E3A\u8001\u5E08\uFF0C\u6211\u5E0C\u671B\u80FD\u7EE7\u7EED\u5B88\u671B\u4ED6\u4EEC\u3002",
  "\u4F60\u6311\u6218\u8FC7\\n\u98DE\u7FD4\u8BA1\u65F6\u8D5B\u5417\uFF1F\\c\\n\u8DEF\u7EBF\u4E0A\u6709\\n\u4E09\u5408\u4E00\u78C1\u602A\u4EEC\u5728\u5E2E\u5FD9\u54E6\uFF01"
]
