[
  "\u54C8\u554A\uFF01\u7ED9\u6211\u597D\u597D\u770B\u770B\uFF01\\n\u6781\u5730\u5E7F\u573A\u7684\u5BF9\u6218\u573A\uFF5E\uFF01[VAR 0114(004A)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF0C\u8FD9\u91CC\u9664\u4E86\u7279\u522B\u51B7\u4EE5\u5916\uFF0C\\n\u548C\u5176\u4ED6\u533A\u4E5F\u5DEE\u4E0D\u591A\u5566\uFF01[VAR 0114(004A)]",
  "\u6211\u867D\u7136\u662F\u9A6F\u9F99\u5E08\uFF0C\\n\u4F46\u8FD8\u633A\u559C\u6B22\u5BD2\u51B7\u7684\u3002[VAR 0114(004A)]",
  "\u54CE\u5440\uFF0C\u8BDD\u8BF4\u56DE\u6765\uFF0C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF0C\\n\u4F60\u662F\u4E3A\u56DB\u5929\u738B\u6311\u6218\u6765\u7684\u554A\u3002[VAR 0114(004A)]",
  "\u6211\u8FD9\u91CC\u7684\u6311\u6218\u662F\\n[VAR FF00(0006)]\u5DE8\u86CB\u9650\u5B9A\u5BF9\u6218[VAR FF00(0000)]\uFF01[VAR 0114(004A)]",
  "\u89C4\u5219\u975E\u5E38\u7B80\u5355\uFF01\\n\u53EA\u8981\u4F60\u6253\u8D62\u8054\u76DF\u793E\u7684\uFF13\u540D\u540E\u8F88\uFF0C\\r\\n\u6311\u6218\u5C31\u7B97\u5B8C\u4E8B\u5566\uFF01[VAR 0114(004A)]",
  "\u4E0D\u8FC7\uFF0C\u6B63\u5982\u5176\u540D\uFF5E\uFF01\\n\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\u5F97\u7B26\u5408\u6761\u4EF6\u624D\u884C\uFF01[VAR 0114(004A)]",
  "\u5176\u4E00\uFF01\u5FC5\u987B\u662F\u5728[VAR FF00(0006)]\u751F\u6001\u5DE8\u86CB[VAR FF00(0000)]\\n[VAR FF00(0006)]\u6355\u6349\u7684[VAR FF00(0000)]\u91CE\u751F\u5B9D\u53EF\u68A6\uFF01[VAR 0114(004A)]",
  "\u5176\u4E8C\uFF01\u5FC5\u987B\u662F[VAR FF00(0006)]\u81EA\u5DF1[VAR FF00(0000)]\\n[VAR FF00(0006)]\u6355\u6349\u7684[VAR FF00(0000)]\u5B9D\u53EF\u68A6\uFF01[VAR 0114(004A)]",
  "\u8981\u662F\u540C\u884C\u961F\u4F0D\u4E2D\u6709\u4E0D\u7B26\u5408\\n\u6761\u4EF6\u7684\u5B9D\u53EF\u68A6\uFF0C\u5C31\u4E0D\u80FD\u6311\u6218\u54E6\u3002[VAR 0114(004A)]",
  "\u867D\u7136\u8FD9\u53EF\u80FD\u6709\u70B9\u9EBB\u70E6\uFF0C\\n\u4F46\u5982\u679C\u7528\u4F60\u7684\u5927\u7B14\u79EF\u84C4\\r\\n\u8F7B\u677E\u6253\u8D62\u4E5F\u6CA1\u4EC0\u4E48\u610F\u601D\u561B\uFF01[VAR 0114(004A)]",
  "\u5F53\u7136\uFF0C\u5BF9\u624B\u4E5F\u4F1A\u4EE5\u76F8\u540C\u7684\u6761\u4EF6\u52AA\u529B\u5BF9\u6218\uFF0C\\n\u6240\u4EE5\u4F60\u4E5F\u914D\u5408\u4E00\u4E0B\u54AF\u3002[VAR 0114(004A)]",
  "\u90A3\u597D\uFF5E[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF0C\\n\u8981\u5F00\u59CB\u56DB\u5929\u738B\u6311\u6218\u5417\uFF01\uFF1F[VAR 0114(004A)]",
  "\u6211\u8981\u6311\u6218\uFF01",
  "\u542C\u8BF4\u660E",
  "\u4E0B\u6B21\u5427",
  "\u55EF\uFF01\u90A3\u597D\uFF5E\\n\u540E\u8F88\u4EEC\uFF5E\u51FA\u6765\u5427\uFF5E\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u8BF7\u591A\u5173\u7167\uFF01\\n\u8BF7\u591A\u6307\u6559\uFF5E\uFF01\u3000\u3000\u3000\u3000\u3000\u591A\u591A\u5173\u7167\u5566\uFF01[VAR 0114(004D)]",
  "\u6211\u7684\u6311\u6218\\n\u4EE5\u60A0\uFF5E\u95F2\u4E3A\u5B97\u65E8\u3002[VAR 0114(004A)]",
  "\u60F3\u9A6C\u4E0A\u5F00\u59CB\u5BF9\u6218\\n\u4E5F\u6CA1\u95EE\u9898\uFF01[VAR 0114(004A)]",
  "\u60F3\u5728\u5DE8\u86CB\u901B\uFF0C\u6355\u6349\u5B9D\u53EF\u68A6\\n\u4E5F\u6CA1\u95EE\u9898\uFF01[VAR 0114(004A)]",
  "\u90A3\u597D\uFF5E\u653E\u8F7B\u677E\uFF01\\n\u53CC\u65B9\u90FD\u597D\u597D\u52A0\u6CB9\u5427\uFF5E[VAR 0114(004A)]",
  "\u9A6C\u4E0A\u5F00\u59CB\u5BF9\u6218\uFF0C\u6216\u662F\u6362\u4E2A\u5FC3\u60C5\\n\u968F\u4FBF\u53BB\u54EA\u901B\u901B\u90FD\u6CA1\u95EE\u9898\uFF01\\r\\n\u60A0\uFF5E\u95F2\u5730\u597D\u597D\u52A0\u6CB9\u5427\uFF5E[VAR 0114(004A)]",
  "\u6211\u6700\u559C\u6B22\u8336\u8272\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01\\n\u4F60\u8981\u548C\u6211\u5BF9\u6218\u5417\uFF1F",
  "\u54CE\u5440\uFF5E\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u4E0D\u7B26\u5408\u6761\u4EF6\u5440\uFF01\\c\\n\u4F60\u80FD\u5E26\u6765\u7684\u5B9D\u53EF\u68A6\u4EC5\u9650\\n\u5728\u751F\u6001\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6355\u6349\u7684\uFF01",
  "\u597D\u561E\uFF5E\uFF01\u8BF7\u591A\u6307\u6559\uFF5E\uFF01",
  "\u5269\u4E0B\u7684\u5BF9\u6218\u4F60\u4E5F\u597D\u597D\u52A0\u6CB9\uFF01\\n\u6211\u4F1A\u7ED9\u4F60\u9001\u4E0A\u8336\u8272\u7684\u52A9\u5A01\u54E6\uFF01",
  "\u6211\u662F\u4E2A\u51B7\u9177\u7684\u5973\u4EBA\u2026\u2026\\n\u4F60\u505A\u597D\u2026\u2026\u98A4\u6296\u7684\u51C6\u5907\u4E86\u5417\uFF1F",
  "\u54A6\uFF1F\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u4E0D\u7B26\u5408\u6761\u4EF6\u54E6\u3002\\c\\n\u4F60\u9700\u8981\u5E26\u6765\u7684\u5B9D\u53EF\u68A6\u4EC5\u9650\\n\u5728\u751F\u6001\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6355\u6349\u7684\uFF01",
  "\u5475\u5475\u2026\u2026\u8BF7\u591A\u5173\u7167\uFF01",
  "\u4E0D\u754F\u5BD2\u51B7\u5730\u52A0\u6CB9\u5427\uFF0C\\n\u6211\u4F1A\u4E3A\u4F60\u9001\u4E0A\u51B7\u9177\u7684\u52A9\u5A01\u2026\u2026",
  "\u4F60\u77E5\u9053\u5947\u6811\u8FD9\u4E2A\u76F4\u64AD\u4E3B\u5417\uFF1F\\n\u6211\u548C\u5979\u7528\u76F8\u540C\u7684\u5C5E\u6027\u5BF9\u6218\u54E6\u3002",
  "\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u4E0D\u7B26\u5408\u6761\u4EF6\u54DF\u3002\\c\\n\u4F60\u8981\u5E26\u6765\u7684\u5B9D\u53EF\u80FD\u53EA\u80FD\u662F\\n\u5728\u751F\u6001\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6355\u6349\u7684\uFF01",
  "\u95EA\u95EA\u7535\u7535\u591A\u591A\u5173\u7167\u54E6\uFF01",
  "\u7EE7\u7EED\u52A0\u6CB9\uFF01\\n\u6211\u4F1A\u5173\u6CE8\u7740\u4F60\u523A\u6FC0\u7684\u5BF9\u6218\u54E6\uFF01",
  "\u5443\uFF0C\u8FD9\u6837\u5C31\u662F\\n\u4E00\u3001\u4E8C\u3001\u4E09\u2026\u2026[VAR 0114(004A)]",
  "\u54E6\uFF01\u4E0D\u77E5\u4E0D\u89C9\u4E2D\uFF0C\\n\u4F60\u597D\u50CF\u6218\u80DC\u4E86\u6240\u6709\u4EBA\u554A\uFF01[VAR 0114(004A)]",
  "\u6240\u4EE5\uFF01\\n\u56DB\u5929\u738B\u6311\u6218\u7ED3\u675F\u54AF\uFF01[VAR 0114(004A)]",
  "\u90A3\u597D\uFF5E\u5404\u4F4D\u8054\u76DF\u793E\u7684\u793E\u5458\uFF0C\\n\u64A4\u9000\u5427\uFF01\u5FEB\u5FEB\u5FEB\uFF5E\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u518D\u89C1\uFF01\\n\u8F9B\u82E6\u4E86\uFF5E\uFF01\u3000\u3000\u3000\u3000\u3000\u3000\u62DC\u62DC\uFF5E\uFF01[VAR 0114(004D)]",
  "\u8FD9\u4E9B\u5BB6\u4F19\u4EEC\u771F\u662F\u5766\u7387\u53C8\u53EF\u7231\u3002[VAR 0114(004A)]",
  "\u56DB\u5929\u738B\u6311\u6218\u8981\u52A0\u6CB9\u54E6\uFF01"
