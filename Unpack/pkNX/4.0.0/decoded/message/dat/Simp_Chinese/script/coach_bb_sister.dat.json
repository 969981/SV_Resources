  "[~ 67]",
  "\u4F60\u5C45\u7136\u4F1A\u4E3B\u52A8\u6765\u95EE\u5019\u6211\uFF0C\\n\u770B\u6765\u662F\u53D8\u673A\u7075\u4E86\u554A\uFF1F[VAR 0114(0044)]",
  "\u6211\u4E5F\u548C\u963F\u6817\\n\u4E00\u8D77\u56DE\u5230\u5B66\u56ED\u4E86\u3002[VAR 0114(0044)]",
  "\u6240\u4EE5\u4F60\u8981\u662F\u89C1\u5230\u6211\uFF0C\\n\u8BB0\u5F97\u8981\u5728\uFF12\u79D2\u4E4B\u5185\u8DDF\u6211\u6253\u62DB\u547C\uFF01[VAR 0114(0044)]",
  "\u597D\u7684\uFF01",
  "\u5443\uFF5E\u2026\u2026",
  "\u54CE\u54DF\uFF0C\u8FD8\u633A\u5766\u7387\u7684\u561B\u3002\\n\u4F60\u662F\u5403\u9519\u836F\u4E86\u5417\uFF1F[VAR 0114(0044)]",
  "\u563B\u563B\uFF01\\n\u4F60\u90A3\u5F20\u5ACC\u5F03\u7684\u8138\uFF01\\r\\n\u771F\u662F\u592A\u68D2\u5566\uFF01[VAR 0114(0044)]",
  "\u54CE\uFF5E\u5728\u5317\u4E0A\u5F85\u4E86\u4E00\u6BB5\u65F6\u95F4\u540E\uFF0C\\n\u73B0\u5728\u611F\u89C9\u5B66\u56ED\u770B\u8D77\u6765\u4E71\u54C4\u54C4\u7684\u3002[VAR 0114(0044)]",
  "\u56E0\u4E3A\u7FE0\u7EFF\u9547\\n\u4EC0\uFF5E\u4E48\u90FD\u6CA1\u6709\u554A\uFF01\\r\\n\u2026\u2026\u867D\u8BF4\u90A3\u6B63\u662F\u5B83\u7684\u4F18\u70B9\u5427\u3002[VAR 0114(0044)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u5440\u2026\u2026[VAR 0114(0044)]",
  "\u6211\u5F53\u65F6\u2026\u2026\u5443\u2026\u2026\\n\u54AD\u5457\u54AD\u5457\u5730\u8DF3\u821E\u7684\u6837\u5B50\u2026\u2026\\r\\n\u4F60\u6CA1\u6709\u62CD\u89C6\u9891\u4E4B\u7C7B\u7684\u5427\uFF01\uFF1F[VAR 0114(0044)]",
  "\u6CA1\u6709\u62CD",
  "\u5176\u5B9E\u2026\u2026",
  "\u554A\uFF5E\u592A\u597D\u4E86\uFF01\uFF01\\n\u5C31\u7B97\u6211\u90A3\u65F6\u662F\u88AB\u64CD\u7EB5\u4E86\uFF0C\\r\\n\u4F46\u90A3\u4E5F\u662F\u6211\u4EBA\u751F\u552F\u4E00\u7684\u6C61\u70B9\u554A\uFF01[VAR 0114(0044)]",
  "\u54C8\u554A\uFF5E\uFF01\uFF1F\u4E0D\u884C\uFF01\uFF01\\n\u73B0\u5728\u7ACB\u523B\uFF01\uFF01\u7ED9\u6211\u5220\u6389\uFF01[VAR 0114(0044)]",
  "\u8981\u662F\u7559\u4E0B\u7167\u7247\u4E4B\u7C7B\u7684\uFF0C\\n\u7B49\u6211\u51FA\u540D\u65F6\u53EF\u5C31\u5934\u75BC\u4E86\uFF01[VAR 0114(0044)]",
  "\u8BF4\u5230\u5E95\uFF0C\u90A3\u4E2A\u2026\u2026\\n\u53EB\u6843\u6B79\u90CE\u7684\uFF0C\u662F\u5B9D\u53EF\u68A6\uFF1F\\r\\n\u5B83\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B\u554A\uFF1F[VAR 0114(0044)]",
  "\u6211\u60F3\u4E86\u60F3\uFF0C\u4F60\u4E0D\u89C9\u5F97\u5B83\u548C\u5B9D\u4F34\\n\u7ED9\u4EBA\u7684\u611F\u89C9\u5F88\u50CF\u5417\uFF1F[VAR 0114(0044)]",
  "\u53EF\u80FD\u5427\uFF01",
  "\u662F\u5417\uFF1F",
  "\u7EDD\u5BF9\u50CF\uFF01\uFF01\\n\u8BF4\u4E0D\u5B9A\u5B83\u4EEC\u4E4B\u95F4\u6709\u4EC0\u4E48\u5173\u8054\uFF01[VAR 0114(0044)]",
  "\u4E0D\u8FC7\u4E5F\u6CA1\u6CD5\\n\u76F4\u63A5\u53BB\u95EE\u5B9D\u53EF\u68A6\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u8BF4\uFF0C\u771F\u76F8\u65E0\u6CD5\u6D6E\u51FA\u6C34\u9762\u4E86\uFF01[VAR 0114(0044)]",
  "\u4F60\u5C45\u7136\u4F1A\u4E3B\u52A8\u6765\u642D\u8BDD\uFF0C\\n\u4E0D\u9519\u5440\u3002[VAR 0114(0044)]",
  "\u5728\u90A3\u4E4B\u540E\u2026\u2026\\n\u4F60\u548C\u963F\u6817\u7684\u5173\u7CFB\u5982\u4F55\uFF1F[VAR 0114(0044)]",
  "\u5173\u7CFB\u5F88\u597D\uFF01",
  "\u4E00\u822C\u822C",
  "\u54E6\uFF5E\uFF1F\\n\u90A3\u5C31\u597D\u3002[VAR 0114(0044)]",
  "\u54E6\uFF5E\uFF1F\\n\u53EA\u8981\u5173\u7CFB\u4E0D\u574F\u5C31\u597D\u3002[VAR 0114(0044)]",
  "\u90A3\u5B69\u5B50\u73B0\u5728\u2026\u2026\\n\u4E0D\u8BBA\u662F\u5B66\u56ED\u751F\u6D3B\uFF0C\u8FD8\u662F\u793E\u56E2\u6D3B\u52A8\uFF0C\\r\\n\u65B9\u65B9\u9762\u9762\u90FD\u5F88\u52AA\u529B\u3002[VAR 0114(0044)]",
  "\u8981\u4F60\u652F\u6301\u4ED6\u2026\u2026\u5012\u662F\u4E0D\u5FC5\u3002\\n\u81F3\u5C11\u548C\u4E4B\u524D\u4E00\u6837\u548C\u4ED6\u597D\u597D\u76F8\u5904\u5427\u3002[VAR 0114(0044)]",
  "\u5F53\u7136\u4E86\uFF01",
  "\u90FD\u542C\u4E39\u745C\u4F60\u7684\uFF01",
  "\u6211\u60F3\u4E5F\u662F\u2026\u2026\\n\u5C31\u7B97\u6211\u4E0D\u8BF4\u8FD9\u4E9B\uFF0C\\r\\n\u4F60\u4EEC\u672C\u6765\u4E5F\u662F\u670B\u53CB\u561B\u3002[VAR 0114(0044)]",
  "\u8FD9\u5C31\u5BF9\u5566\uFF01\u4E3A\u4E86\u6211\uFF0C\\n\u4F60\u8981\u597D\u597D\u966A\u4ED6\uFF01[VAR 0114(0044)]",
  "\u5509\uFF5E\uFF01\u53EF\u80FD\u6211\u4E5F\\n\u6709\u70B9\u592A\u6EBA\u7231\u4ED6\u4E86\u5427\uFF5E\uFF01[VAR 0114(0044)]",
  "\u4ECE\u4ECA\u5F80\u540E\u6211\u4F1A\\n\u9002\u5EA6\u5730\u5B88\u62A4\u963F\u6817\u7684\uFF01\\r\\n\u2026\u2026\u867D\u7136\u611F\u89C9\u6709\u70B9\u5BC2\u5BDE\uFF01[VAR 0114(0044)]",
  "\u548C\u4F60\u804A\u5929\u4EE5\u540E\uFF0C\\n\u603B\u611F\u89C9\u53D8\u5F97\u6709\u70B9\u4F24\u611F\u3002[VAR 0114(0044)]",
  "\u4F60\u5F97\u8D1F\u8D77\u8D23\u4EFB\u6765\u554A\u3002[VAR 0114(0044)]",
  "\u55EF\u2026\u2026\\n\u90A3\u4F60\u5C31\u6765\u966A\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\u5427\u3002[VAR 0114(0044)]",
  "\u4F60\u7684\u6001\u5EA6\u4E0D\u9519\u561B\u3002\\n\u6211\u8981\u7528\u65AF\u9B54\u8336\u6765\u4EA4\u6362\uFF0C\\r\\n\u4F60\u8981\u7528\u4EC0\u4E48\uFF1F[VAR 0114(0044)]",
  "[VAR 0101(0001)]\u554A\u2026\u2026\\n\u4EE5\u4F60\u6765\u8BF4\u7B97\u662F\u4E0D\u9519\u7684\u5B9D\u53EF\u68A6\u5462\u3002\\c\\n\u6211\u4F1A\u597D\u597D\u73CD\u60DC\u5B83\u7684\uFF0C\\n\u4F60\u4E0D\u7528\u62C5\u5FC3\u5566\uFF01[VAR 0114(0044)]",
  "\u8981\u7528\u4F60\u7684[VAR 0101(0001)]\\n\u548C\u6211\u7684\u65AF\u9B54\u8336\u4EA4\u6362\u5BF9\u5427\uFF1F[VAR 0114(0044)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u53EA\u6709\uFF11\u53EA\u540C\u884C\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\n\u662F\u6CA1\u6CD5\u4EA4\u6362\u7684\uFF0C\u4F60\u4E0D\u77E5\u9053\u5417\uFF1F\\c\\n\u7B49\u4F60\u6709\uFF12\u53EA\u4EE5\u4E0A\u540C\u884C\u5B9D\u53EF\u68A6\u65F6\\n\u518D\u6765\u627E\u6211\u5427\u3002[VAR 0114(0044)]",
  "\u771F\u662F\u7684\u2026\u2026\u4E3A\u4EC0\u4E48\u554A\uFF01\uFF01[VAR 0114(0044)]",
  "\u679C\u7136\u4F60\u8FD8\u662F\u60F3\\n\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\u7684\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0044)]",
  "\u4F60\u597D\u50CF\u5F88\u95F2\u554A\u3002\\n\u6211\u6765\u966A\u4F60\u6253\u4E00\u573A\u5427\uFF1F[VAR 0114(0044)]",
  "\u5C45\u7136\u62D2\u7EDD\u6211\u7684\u9080\u8BF7\uFF0C\\n\u4F60\u5C31\u4E0D\u6015\u540E\u6094\u4E00\u8F88\u5B50\u5417\uFF1F[VAR 0114(0044)]",
  "\u563B\u563B\u2026\u2026\u90A3\u5C31\u8BA9\u6211\\n\u6765\u953B\u70BC\u4F60\u4E00\u4E0B\u5427\uFF01[VAR 0114(0044)]",
  "[VAR 0100(0000)]\uFF01\\n\u4F60\u600E\u4E48\u53EA\u6709\uFF11\u53EA\u5B9D\u53EF\u68A6\u554A\uFF1F\\r\\n\u6211\u60F3\u6253\u53CC\u6253\u5BF9\u6218\u5566\u3002[VAR 0114(0044)]",
  "\u2026\u2026\u8981\u662F\u90A3\u4E2A\u62DB\u5F0F\u547D\u4E2D\u4E86\uFF0C\\n\u6211\u60F3\u8D62\u7684\u5C31\u662F\u6211\u4E86\u3002[VAR 0114(0044)]",
  "\u80FD\u8BA9\u6211\u4E00\u8D25\u6D82\u5730\u7684\u4EBA\\n\u4E5F\u5C31\u53EA\u6709\u4F60\u4E86\u3002[VAR 0114(0044)]",
  "\u554A\uFF01\u7A0D\u5FAE\u7B49\u4E00\u4E0B\uFF01\\n\u4F5C\u4E3A\u5956\u52B1\uFF0C\u6211\u628A\u90A3\u4E2A\u7ED9\u4F60\u5427\uFF01[VAR 0114(0044)]",
  "\u8FD9\u4E2A\u773C\u955C\u548C\u4F60\u5F88\u914D\u54E6\u3002\\n\u4ECA\u540E\u4F60\u5C31\u4E00\u8F88\u5B50\u90FD\u6234\u7740\u5B83\u5427\u3002[VAR 0114(0044)]",
  "[VAR 0100(0000)]\u4ECE\u4E39\u745C\u90A3\u91CC\\n\u83B7\u5F97\u4E86[VAR FF00(0008)]\u641E\u602A\u773C\u955C\uFF08\u6765\u60B2\u7C97\u8336\uFF09[VAR FF00(0000)]\uFF01",
  "\u2026\u2026\u4F60\u542C\u597D\u4E86\u554A\u3002\\n\u662F\u6211\u6545\u610F\u8BA9\u4F60\u8D62\u7684\uFF0C\u61C2\u5417\uFF1F[VAR 0114(0044)]",
  "\u4E0B\u6B21\u6211\u53EF\u4E0D\u4F1A\u8FD9\u6837\u4E86\uFF01\\n\u660E\u767D\u4E86\u5427\uFF01\u771F\u662F\u7684\uFF01[VAR 0114(0044)]",
  "\u563B\u563B\uFF01\u8FD9\u5C31\u662F\\n\u6211\u4F7F\u51FA\u5168\u529B\u7684\u7ED3\u679C\u3002\\c\\n\u84DD\u8393\u8054\u76DF\u51A0\u519B\u7684\u5B9D\u5EA7\\n\u968F\u65F6\u90FD\u53EF\u4EE5\u8BA9\u7ED9\u6211\u54E6\u3002[VAR 0114(0044)]",
  "\u4F60\u95EE\u4E3A\u4EC0\u4E48\u6211\\n\u4E0D\u50CF\u963F\u6817\u4E00\u6837\u6709\u53E3\u97F3\uFF1F\\c\\n\u56E0\u4E3A\u6211\u662F\u4E00\u4F4D\u4FCF\u4F73\u4EBA\uFF01\\n\u5C31\u8FD9\u4E48\u7B80\u5355\u3002[VAR 0114(0044)]",
  "\u5B66\u56ED\u548C\u8054\u76DF\u793E\u4F60\u90FD\u81EA\u7136\u5730\\n\u878D\u5165\u8FDB\u53BB\u4E86\uFF0C\u771F\u53EF\u6015\uFF01\\r\\n\u611F\u89C9\u4F60\u633A\u9002\u5408\u53BB\u5F53\u95F4\u8C0D\u7684\uFF1F[VAR 0114(0044)]",
  "\u5384\u8BE1\u692A\u5B83\u8FC7\u5F97\u8FD8\u597D\u5417\uFF1F\\c\\n\u7EC4\u6210\u593A\u56DE\u9762\u5177\u5C0F\u961F\u53BB\u6253\u5012\\n\u5B9D\u4F34\u4EEC\u7684\u65E5\u5B50\u771F\u8BA9\u4EBA\u6000\u5FF5\u554A\u3002[VAR 0114(0044)]",
  "\u4F60\u7684[VAR 0101(0001)]\u5F88\u542C\u8BDD\u54E6\u3002\\n\u6211\u751A\u81F3\u90FD\u60F3\u53EB\u4F60\u5411\u5B83\u5B66\u4E60\u5462\uFF01[VAR 0114(0044)]",
  "\u6211\u7684\u65AF\u9B54\u8336\u5F88\u4E0D\u9519\u5427\uFF1F\\c\\n\u5B83\u53EF\u662F\u968F\u65F6\u90FD\u80FD\u4E3A\u4F60\\n\u9001\u4E0A\u70ED\u817E\u817E\u7684\u8336\u6C34\u5462\u3002[VAR 0114(0044)]"
]
