[
  "\u5401\uFF5E\uFF01\\n\u8981\u8FDF\u5230\uFF0C\u8981\u8FDF\u5230\uFF5E\uFF01[VAR 0114(002C)]",
  "\u554A\uFF5E\uFF01\u6D77\u5CB1\uFF01\\n\u7B49\u4E00\u4E0B\uFF5E\uFF01",
  "\u554A\uFF5E\u5C31\u8FD9\u4E48\u8D70\u6389\u4E86\u3002\\n\u4F60\u5FD8\u5E26\u4E86\u4E00\u6837\u4E1C\u897F\u5440\u2026\u2026",
  "\u83AB\u975E\u4F60\u662F\u8981\u53BB\u9053\u9986\u7684\\n\u6311\u6218\u8005\uFF0C\u6CA1\u9519\u5427\uFF1F",
  "\u5BF9\uFF01",
  "\u662F\u5417\u2026\u2026",
  "\u679C\u7136\u6CA1\u9519\uFF01\u6211\u731C\u5BF9\u4E86\u5427\uFF01",
  "\u4F60\u867D\u7136\u5634\u4E0A\u90A3\u4E48\u8BF4\uFF0C\\n\u4F46\u4E00\u5B9A\u662F\u6311\u6218\u8005\uFF01",
  "\u521A\u624D\u90A3\u4F4D\u58EE\u7855\u7684\u5927\u53D4\u662F\\n\u73BB\u74F6\u9053\u9986\u7684\u9986\u4E3B\u6D77\u5CB1\u3002",
  "\u4ED6\u8FD9\u4E2A\u4EBA\u554A\uFF0C\u5C31\u50CF\u4E2A\u5B69\u5B50\u4E00\u6837\uFF0C\\n\u660E\u660E\u8981\u53BB\u5E02\u573A\u91C7\u8D2D\uFF0C\\r\\n\u5374\u5FD8\u4E86\u5E26\u94B1\u5305\u3002",
  "\u6D77\u5CB1\u73B0\u5728\u4E00\u5B9A\u6B63\u5728\u53D1\u6101\u2026\u2026\\c\\n\u8FD9\u4F4D\u4EB2\u5207\u7684\u6311\u6218\u8005\uFF01\\n\u4F60\u80FD\u5E2E\u5FD9\u628A\u94B1\u5305\u4EA4\u7ED9\u4ED6\u5417\uFF01\uFF1F",
  "\u554A\u554A\uFF0C\u4F60\u600E\u4E48\u4F1A\u8FD9\u4E48\u4EB2\u5207\uFF01\\n\u641E\u5F97\u6211\u73B0\u5728\u5C31\u60F3\u5728\u8FD9\u91CC\\r\\n\u628A\u9053\u9986\u5FBD\u7AE0\u7ED9\u4F60\u4E86\uFF01",
  "\u4E0D\u597D\u610F\u601D\uFF0C\u6D77\u5CB1\u4E0D\u5728\u7684\u8BDD\uFF0C\\n\u5C31\u4E0D\u80FD\u8FDB\u884C\u9053\u9986\u6311\u6218\u3002\\r\\n\u800C\u4E14\u6211\u4E5F\u4E0D\u80FD\u79BB\u5F00\u524D\u53F0\u2026\u2026",
  "\u90A3\u4E48\uFF0C\u8FD9\u4E1C\u897F\u5C31\u62DC\u6258\u4F60\u4E86\uFF01",
  "\u5982\u679C\u4F60\u80FD\u628A\u94B1\u5305\u4EA4\u7ED9\u4ED6\uFF0C\\n\u5C31\u7834\u4F8B\u8BA9\u4F60\u901A\u8FC7\u9053\u9986\u6D4B\u9A8C\uFF01",
  "\u6D77\u5CB1\u524D\u5F80\u7684\u662F\u9700\u8981\u7A7F\u8FC7\u897F\u8FB9\u7684\u6C99\u6F20\\n\u624D\u80FD\u5230\u8FBE\u7684[VAR FF00(0006)]\u6E0D\u6C81\u9547[VAR FF00(0000)]\uFF01",
  "\u6C99\u6F20\u91CC\u4E5F\u6709\u5F88\u591A\u5371\u9669\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u4F60\u53EF\u8981\u5C0F\u5FC3\uFF5E\uFF01"
]
