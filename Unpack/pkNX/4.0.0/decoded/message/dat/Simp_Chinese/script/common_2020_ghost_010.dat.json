[
  "\u597D\u4E45\u4E0D\u89C1\uFF01\\n\u6211\u8BB0\u5F97\u4F60\u53EB\u2026\u2026[VAR 0100(0000)]\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(001B)]",
  "\u4F60\u4ECA\u5929\u6765\u662F\u4E3A\u4E86\u4EC0\u4E48\uFF1F\\n\u662F\u8981\u548C\u6211\u6765\u573A\u8BF4\u5531\u5BF9\u6218\u5417\uFF1F[VAR 0114(001B)]",
  "\u4E3A\u4E86\u89C6\u5BDF\u9053\u9986\uFF01",
  "\u4E3A\u4E86\u8BF4\u5531\u5BF9\u6218\uFF01",
  "\u55EF\uFF1F\u4F60\u662F\u8BF4\u9996\u5E2D\u62DC\u6258\u4F60\\n\u5230\u6211\u8FD9\u91CC\u6765\u89C6\u5BDF\u7684\uFF01\uFF1F[VAR 0114(001B)]",
  "HAHAHA\uFF01\\n\u4F60\u7684\u7B11\u8BDD\u4E5F\u662F\u51A0\u519B\u7EA7\u5417\uFF01\uFF1F[VAR 0114(001B)]",
  "\u54E6\u2026\u2026\\n\u6240\u4EE5\u4F60\u662F\u66FF\u4E5F\u6148\u6765\u7684\u554A\u3002[VAR 0114(001B)]",
  "\u6211\u57FA\u672C\u4E0A\u4E86\u89E3\u72B6\u51B5\u4E86\u3002\\n\u4E0D\u8FC7\u7ADF\u7136\u4F1A\u6D3E\u4E00\u4E2A\u83DC\u9E1F\u51A0\u519B\u6765\uFF0C\\r\\n\u6211\u8FD8\u771F\u662F\u88AB\u770B\u6241\u4E86\u5462\u3002[VAR 0114(001B)]",
  "\u4E0D\u597D\u610F\u601D\u554A\u2026\u2026\\n\u6211\u5E76\u4E0D\u662F\u5728\u51B2\u4F60\u53D1\u706B\u3002[VAR 0114(001B)]",
  "\u54CE\uFF0C\u4E0D\u8FC7\u6211\u4E5F\u786E\u5B9E\u60F3\u89C1\u4F60\uFF0C\\n\u800C\u4E14\u4F60\u4EBA\u90FD\u6765\u4E86\uFF0C\u8BF4\u4EC0\u4E48\u90FD\u6CA1\u7528\u4E86\u3002[VAR 0114(001B)]",
  "\u673A\u4F1A\u96BE\u5F97\u3002\u8BA9\u6211\u89C1\u8BC6\u4E00\u4E0B\\n\u4F60\u7684\u5B9E\u529B\u600E\u4E48\u6837\uFF1F[VAR 0114(001B)]",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u51C6\u5907\u597D\u5C55\u793A\u4F60\u7684\u5B9E\u529B\u4E86\u5417\uFF1F[VAR 0114(001B)]",
  "\u8FD9\u5C31\u5BF9\u4E86\uFF0C\u8DDF\u6211\u6765\uFF01\\n\u4E0D\u5B9A\u671F\u4E3E\u529E\u7684\u821E\u53F0\u8868\u6F14\u8981\u5F00\u59CB\u4E86\uFF01[VAR 0114(001B)]",
  "\u4F55\u610F\uFF1F\u653E\u5F03\uFF1F\u4E0D\u613F\u610F\uFF1F\\n\u9057\u61BE\uFF01\u6025\u76FC\uFF01\u518D\u6765\u6218\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u55EF\uFF1F\u60F3\u548C\u6211\u8F83\u91CF\u7684\u8BDD\uFF0C\\n\u81F3\u5C11\u9700\u8981\uFF12\u53EA\u80FD\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\uFF01[VAR 0114(001B)]"
]
