[
  "\u4F60\u548C\u6211\u5DF2\u7ECF\u5728\u56DB\u5929\u738B\u6218\u2026\u2026\\n\u4E5F\u5C31\u662F\u6280\u80FD\u6D4B\u9A8C\u65F6\u4EA4\u8FC7\u624B\u4E86\u3002[VAR 0114(0015)]",
  "\u6240\u4EE5\u4F60\u5E94\u8BE5\\n\u4E0D\u4F1A\u6709\u4EFB\u4F55\u611F\u6168\u3002\\r\\n\u4E0D\u8FC7\u8FD8\u662F\u8BF7\u591A\u6307\u6559\u4E86\u3002[VAR 0114(0015)]",
  "\u8FD9\u6B21\u6211\u7684\u8EAB\u4EFD\u662F\u9053\u9986\u9986\u4E3B\uFF0C\\n\u6240\u4EE5\u6211\u4F1A\u6D3E\u5E73\u65F6\u7684\u5B9D\u53EF\u68A6\u548C\u4F60\u5BF9\u6218\u7684\u3002[VAR 0114(0015)]",
  "\u4E00\u822C\u5C5E\u6027\u2026\u2026\\n\u666E\u901A\u2026\u2026\u5E38\u89C1\u2026\u2026\\r\\n\u5E73\u51E1\u2026\u2026\u4E0D\u7A00\u5947\u2026\u2026[VAR 0114(0015)]",
  "\u548C\u6CA1\u6709\u4E2A\u6027\u7684\u6211\u5F88\u642D\u8C03\uFF0C\\n\u6211\u5C31\u559C\u6B22\u8FD9\u6837\u3002[VAR 0114(0015)]",
  "\u4EBA\u548C\u5B9D\u53EF\u68A6\u90FD\u5E94\u8BE5\\n\u66F4\u7B80\u5355\u6613\u61C2\u624D\u597D\u3002[VAR 0114(0015)]",
  "\u8FD9\u4E2A\u4E16\u754C\u603B\u662F\u5BF9\u53E4\u602A\u554A\uFF0C\u5947\u8469\u554A\uFF0C\\n\u8FD8\u6709\u4E0D\u8D70\u5BFB\u5E38\u8DEF\u7684\u53E6\u773C\u76F8\u770B\u3002[VAR 0114(0015)]",
  "\u53BB\u522B\u7684\u5730\u65B9\u65C5\u6E38\u6216\u8BB8\u5F88\u6109\u5FEB\uFF0C\\n\u4F46\u56DE\u5BB6\u540E\u4E0D\u624D\u662F\u6700\u8212\u5766\u7684\u5417\uFF1F[VAR 0114(0015)]",
  "\u6CA1\u9519\uFF0C\u7B80\u7EA6\u624D\u662F\u6700\u5F3A\u7684\u3002[VAR 0114(0015)]",
  "\u5BF9\u4E8E\u5E73\u51E1\u7684\u6211\u6765\u8BF4\uFF0C\\n\u4F60\u5B9E\u5728\u662F\u592A\u523A\u6FC0\u4E86\u3002[VAR 0114(0015)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF0C\u6211\u7A0D\u5FAE\u660E\u767D\u4E00\u70B9\u4E86\u3002[VAR 0114(0015)]",
  "\u660E\u767D\u4E86\u4E3A\u4EC0\u4E48\u4F1A\u8BA9\u6211\u5728\\n\u62C5\u4EFB\u56DB\u5929\u738B\u65F6\u4F7F\u7528\u98DE\u884C\u5C5E\u6027\u3002[VAR 0114(0015)]",
  "\u6709\u4E9B\u666F\u8272\u5982\u679C\u5149\u662F\u8D70\u5728\\n\u5E73\u5766\u7684\u9053\u8DEF\u4E0A\u662F\u6CE8\u610F\u4E0D\u5230\u7684\u2026\u2026[VAR 0114(0015)]",
  "\u5076\u5C14\u4E5F\u9700\u8981\u4EF0\u671B\u4E00\u4E0B\\n\u50CF\u4F60\u8FD9\u6837\u80FD\u817E\u4E91\u9A7E\u96FE\u7684\u624D\u80FD\u3002[VAR 0114(0015)]",
  "\u6211\u53EA\u662F\u4FDD\u8BC1\u5B8C\u6210\u5DE5\u4F5C\u800C\u5DF2\u3002\\n\u4E0D\u662F\u7231\u505A\u624D\u505A\u7684\u54E6\u3002[VAR 0114(0015)]",
  "\u4ECA\u5929\u662F\u4E0D\u52A0\u73ED\u7684\u65E5\u5B50\uFF0C\\n\u6240\u4EE5\u5C31\u6B64\u544A\u8F9E\u4E86\u3002[VAR 0114(0015)]"
]
