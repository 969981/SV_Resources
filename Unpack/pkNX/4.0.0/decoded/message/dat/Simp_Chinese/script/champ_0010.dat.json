[
  "\u51A0\u519B\u59AE\u83AB\uFF0C\\n\u90A3\u5C31\u9EBB\u70E6\u4F60\u4EE3\u52B3\u4E86\u3002[VAR 0114(002C)]",
  "\u653E\uFF5E\u5FC3\u5730\u4EA4\u7ED9\u6211\u5427\uFF01\\n\u6211\u53CD\u800C\u8FD8\u5F88\u671F\u5F85\u5462\uFF01[VAR 0114(0004)]",
  "\u90A3\u5C31\u4EA4\u7ED9\u4F60\u4E86\u3002\\n\u795D\u4F60\u4E00\u5207\u987A\u5229\u3002[VAR 0114(002C)]",
  "\u54E6\u2026\u2026\uFF1F\u4E0D\u597D\u610F\u601D\u3002[VAR 0114(002C)]",
  "\u554A\uFF0C[VAR 0100(0000)]\uFF01[VAR 0114(0004)]",
  "\u521A\u624D\u90A3\u4E2A\u4EBA\u662F\uFF1F",
  "\u770B\u8D77\u6765\u662F\u4E2A\u5F88\u5389\u5BB3\u7684\u4EBA\u2026\u2026",
  "[VAR 0100(0000)]\u4F60\u4E5F\u5BF9\u5979\u5F88\u597D\u5947\u662F\u5427\uFF1F\\n\u5927\u5BB6\u90FD\u79F0\u5979\u4E3A\u9996\u5E2D\u3002\\c\\n\u5979\u53C8\u5F3A\u3001\u53C8\u5389\u5BB3\u3001\u53C8\u5E05\u6C14\uFF0C\\n\u662F\u6211\u7684\u76EE\u6807\u2026\u2026\\c\\n\u4E0D\uFF0C\u53EA\u8981\u662F\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF0C\\n\u6CA1\u4EBA\u4E0D\u5D07\u62DC\u5979\uFF5E\uFF01[VAR 0114(0004)]",
  "\u4F60\u4E5F\u770B\u51FA\u6765\u4E86\uFF01\uFF1F\\n\u5927\u5BB6\u90FD\u79F0\u5979\u4E3A\u9996\u5E2D\u3002\\c\\n\u5979\u53C8\u5F3A\u3001\u53C8\u5389\u5BB3\u3001\u53C8\u5E05\u6C14\uFF0C\\n\u662F\u6211\u7684\u76EE\u6807\u2026\u2026\\c\\n\u4E0D\uFF0C\u53EA\u8981\u662F\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF0C\\n\u6CA1\u4EBA\u4E0D\u5D07\u62DC\u5979\uFF5E\uFF01[VAR 0114(0004)]",
  "\u554A\uFF01\u8BDD\u8BF4\uFF01\\n\u6211\u4EEC\u521A\u624D\u5728\u6559\u5BA4\u91CC\u8BF4\u8FC7\u7684\u4E8B\uFF01[VAR 0114(0004)]",
  "\u6211\u521A\u624D\u95EE\u4F60\u76EE\u6807\u662F\u4EC0\u4E48\uFF0C\\n\u4F60\u56DE\u7B54\u8981\u5B8C\u6210\u56FE\u9274\uFF0C\u5BF9\u5427\uFF1F\\r\\n\u4E0D\u8FC7\uFF0C\u6211\u8FD8\u662F\u89C9\u5F97\u2026\u2026[VAR 0114(0004)]",
  "\u6211\u521A\u624D\u95EE\u4F60\u76EE\u6807\u662F\u4EC0\u4E48\uFF0C\\n\u4F60\u56DE\u7B54\u8981\u5F53\u4E2A\u5389\u5BB3\u7684\u8BAD\u7EC3\u5BB6\uFF0C\u5BF9\u5427\uFF1F\\r\\n\u65E2\u7136\u5982\u6B64\u2026\u2026[VAR 0114(0004)]",
  "\u6211\u521A\u624D\u95EE\u4F60\u76EE\u6807\u662F\u4EC0\u4E48\uFF0C\\n\u4F60\u56DE\u7B54\u8FD8\u4E0D\u77E5\u9053\uFF0C\u5BF9\u5427\uFF1F\\r\\n\u65E2\u7136\u5982\u6B64\u2026\u2026[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u8981\u4E0D\u8981\u4E5F\u4E89\u53D6\u6210\u4E3A[VAR FF00(0006)]\u51A0\u519B\u7EA7[VAR FF00(0000)]\u5462\uFF01\uFF1F[VAR 0114(0004)]",
  "\u597D\u554A\uFF01",
  "\u5443\u2026\u2026",
  "\u54CE\uFF01\u4F60\u5148\u522B\u6025\u7740\u7B54\u5E94\u561B\uFF01\\n\u5148\u8BA9\u6211\u8BF4\u660E\u4E00\u4E0B\u54AF\u3002[VAR 0114(0004)]",
  "\u54CE\uFF5E\uFF01\u4F60\u8FD9\u4E48\u5389\u5BB3\uFF0C\\n\u53EF\u4E0D\u8981\u6D6A\u8D39\u5B9E\u529B\u54E6\uFF5E\uFF01[VAR 0114(0004)]",
  "\u6240\u8C13\u51A0\u519B\u7EA7\uFF0C\\n\u5C31\u662F\u5F88\u4F1A\u953B\u70BC\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u901A\u8FC7\u5BF9\u6218\u6280\u672F\u8BA9\u4EBA\u4EEC\u7740\u8FF7\u7684\u4EBA\u3002\\r\\n\u4ED6\u4EEC\u5728\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E0A\u90FD\u662F\u804C\u4E1A\u7EA7\u7684\uFF01[VAR 0114(0004)]",
  "\u5F97\u5230\u5B9D\u53EF\u68A6\u8054\u76DF\u7684\u8BA4\u53EF\u540E\uFF0C\\n\u5C31\u80FD\u83B7\u5F97\u51A0\u519B\u7EA7\u7684\u79F0\u53F7\u3002[VAR 0114(0004)]",
  "\u8981\u60F3\u8FBE\u5230\u51A0\u519B\u7EA7\uFF0C\\n\u53EA\u9760\u4E0A\u8BFE\u662F\u4E0D\u591F\u7684\u3002\\c\\n\u8FD8\u9700\u8981\u95EF\u8FC7\uFF18\u4E2A\u5B9D\u53EF\u68A6\u9053\u9986\uFF0C\\n\u6536\u96C6\u9053\u9986\u5FBD\u7AE0\uFF01[VAR 0114(0004)]",
  "\u5728\u90A3\u4E4B\u540E\uFF0C\u5C31\u80FD\u5411\u7740\u7279\u522B\u7684\u6D4B\u9A8C\u2026\u2026\\n\u51A0\u519B\u6D4B\u9A8C\u53D1\u8D77\u6311\u6218\u3002[VAR 0114(0004)]",
  "\u80FD\u901A\u8FC7\u8FD9\u4E2A\u6D4B\u9A8C\u7684\u8BDD\uFF0C\\n\u5C31\u80FD\u6B63\u5F0F\u6210\u4E3A\u51A0\u519B\u7EA7\u5566\uFF01[VAR 0114(0004)]",
  "\u90A3\u662F\u6240\u6709\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\u68A6\u60F3\uFF01\\n\u662F\u4E2A\u8D85\uFF5E\u5389\u5BB3\u7684\u79F0\u53F7\u5462\uFF5E\uFF01\\r\\n\u2026\u2026\u6211\u81EA\u5DF1\u8FD9\u6837\u8BF4\uFF0C\u8FD8\u771F\u6709\u70B9\u4E0D\u597D\u610F\u601D\u5462\u3002[VAR 0114(0004)]",
  "\u6211\u662F\u901A\u8FC7\u4E0A\u6B21\u7684\u5BFB\u5B9D\\n\u6210\u4E3A\u51A0\u519B\u7EA7\u7684\uFF01[VAR 0114(0004)]",
  "\u554A\uFF0C\u5BFB\u5B9D\u662F\u6307\u4E00\u4E2A\u7279\u522B\u7684\u8BFE\u5916\u6D3B\u52A8\uFF0C\\n\u5F88\u5FEB\u5C31\u8981\u5F00\u59CB\u4E86\uFF01\\r\\n\u4E0A\u6B21\u7684\u5BFB\u5B9D\u5C31\u662F\u5728\u5165\u5B66\u540E\u6CA1\u591A\u4E45\u5F00\u59CB\u7684\uFF01[VAR 0114(0004)]",
  "\u80FD\u5230\u5B66\u6821\u5916\u9762\u4E00\u8FB9\u5192\u9669\uFF0C\\n\u4E00\u8FB9\u81EA\u7531\u5730\u5B66\u4E60\uFF0C\u53EF\u6709\u8DA3\u5566\uFF01[VAR 0114(0004)]",
  "\u73B0\u5728\u56DE\u60F3\u8D77\u6765\uFF0C\u90A3\u65F6\u7684\u7ECF\u9A8C\\n\u5C31\u662F\u6211\u7684\u5B9D\u7269\u2026\u2026\u5427\uFF1F[VAR 0114(0004)]",
  "\u5982\u679C\u548C[VAR 0100(0000)]\u4F60\u5728\u4E00\u8D77\u7684\u8BDD\uFF0C\\n\u6211\u8FD8\u80FD\u53D8\u5F97\u66F4\u5F3A\u2026\u2026[VAR 0114(0004)]",
  "\u63D0\u524D\u5E2E\u4F60\u628A\u9053\u9986\u7684\u4F4D\u7F6E\\n\u6DFB\u52A0\u5230\u5730\u56FEApp\u4E0A\u597D\u4E86\uFF01[VAR 0114(0004)]",
  "\u597D\u597D\u8003\u8651\u4E00\u4E0B\u5427\uFF01[VAR 0114(0004)]"
