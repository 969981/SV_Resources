[
  "\u6B63\u5728\u89C2\u770B\u5947\u6811\u5947\u8FF0\u76F4\u64AD\u7684\u5404\u4F4D\uFF01\\n\u65E9\u4E2D\u665A\u4E0A\u597D\u54C8\u5570\uFF01\u6211\u662F\u5947\u6811\uFF01[VAR 0114(0019)]",
  "\u4ECA\u5929\u6211\u8BF7\u5230\u7684\u5609\u5BBE\u662F\\n\u521A\u521A\u6210\u4E3A\u65B0\u51A0\u519B\u7684[VAR 0100(0000)]\uFF5E\uFF01[VAR 0114(0019)]",
  "\u8BDD\u8BF4[VAR 0100(0000)]\u554A\uFF0C\u5728\u9986\u4E3B\u5708\u513F\u91CC\\n\u4F60\u4E5F\u662F\u4E2A\u5927\u7EA2\u4EBA\uFF0C\u5927\u5BB6\u90FD\u7231\u8C08\u8BBA\u4F60\u54E6\uFF5E\uFF01[VAR 0114(0019)]",
  "\u73B0\u5728\u60F3\u6765\uFF0C\u4F60\u5728\u9053\u9986\u6D4B\u9A8C\u65F6\u7684\u8868\u73B0\\n\u4E5F\u662F\u8BA9\u4EBA\u9EBB\u5F97\u5F88\u523A\u6FC0\u5462\uFF5E[VAR 0114(0019)]",
  "\u8FD9\u89C6\u9891\u80FD\u6709\u591A\u706B\uFF0C\u70B9\u51FB\u91CF\u80FD\u6709\u591A\u9AD8\uFF0C\\n\u63A5\u4E0B\u6765\u5B9E\u5728\u662F\u592A\u8BA9\u4EBA\u671F\u5F85\u4E86\uFF5E\uFF01[VAR 0114(0019)]",
  "\u90A3\u5947\u597D\uFF5E\u955C\u5934\u62C9\u5230\u8FD9\u4E2A\u8DDD\u79BB\\n\u5C31\u5DEE\u4E0D\u591A\u4E86\u2026\u2026[VAR 0114(0019)]",
  "\u5927\u4F19\u7B49\u5F85\u5DF2\u4E45\u7684\u5BF9\u6218\uFF01\\n\u5DEE\u4E0D\u591A\u8BE5\u5F00\u59CB\u4E86\uFF01[VAR 0114(0019)]",
  "\u6211\u9053\u9986\u9986\u4E3B\u5947\u6811\uFF01\\n\u96BE\u5F97\u4E00\u89C1\u5730\u52A8\u4E86\u771F\u683C\uFF01[VAR 0114(0019)]",
  "\u54CE\u5440\u5440\uFF0C\u8F93\u6389\u5BF9\u6218\u8BA9\u6211\u786E\u5B9E\\n\u4E5F\u89C9\u5F97\u5F88\u4E0D\u7518\u5FC3\uFF0C\u4E0D\u8FC7\u5462\u2026\u2026[VAR 0114(0019)]",
  "\u672C\u671F\u5947\u6811\u5947\u8FF0\u76F4\u64AD\u7684\\n\u89C2\u770B\u4EBA\u6570\u5B9E\u73B0\u4E86\u98D9\u5347\uFF01\\r\\n\u554A\uFF5E\u592A\u5E78\u798F\u4E86\uFF01\u5347\u5929\u7684\u611F\u89C9\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u7EA2\u4EBA\u5438\u5F15\u4EBA\u5173\u6CE8\u7684\u529B\u91CF\\n\u5C31\u662F\u4E0D\u4E00\u6837\u554A\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u4EE5\u540E\u6211\u4EEC\u4E5F\u8981\u5B9A\u671F\u5408\u6F14\u54E6\uFF01\\n\u53E6\u5916\uFF0C\u4E0D\u8981\u4E0A\u5176\u4ED6\u76F4\u64AD\u4E3B\u7684\u89C6\u9891\uFF01[VAR 0114(0019)]",
  "\u90A3\u5947\u597D\uFF5E\u66FF\u6211\u5411\u9996\u5E2D\u95EE\u597D\uFF01\\n\u62A5\u544A\u65F6\u591A\u4E3A\u6211\u8BF4\u51E0\u53E5\u597D\u8BDD\u54E6\uFF5E\uFF01[VAR 0114(0019)]",
  "\u7528\u7535\u7F51\u6355\u83B7\u5927\u5BB6\u7684\u773C\u7403\uFF01\\n\u8C01\u5E26\u6765\u7684\u5947\u8FF0\uFF1F\u5947\u6811\u5E26\u6765\u7684\uFF5E\uFF01[VAR 0114(0019)]"
