[
  "\u4F60\u5728\u917F\u5149\u5E02\u73A9\u5F97\u8FD8\u5F00\u5FC3\u5417\uFF1F\\n\u8FD9\u91CC\u662F\u79D1\u6280\u53D1\u8FBE\uFF0C\u5145\u6EE1\u5546\u4E1A\u6765\u5F80\u7684\u57CE\u5E02\u54E6\uFF01",
  "\u4ECE\u8FD9\u91CC\u5F80\u5317\u5C31\u662F\u4E3B\u8857\u9053\uFF01\\c\\n\u88AB\u7535\u5B50\u516C\u544A\u677F\u56F4\u7ED5\u7684\u9053\u8DEF\\n\u662F\u917F\u5149\u7279\u6709\u7684\u666F\u8272\u54E6\u3002",
  "\u889C\u5B50\u6700\u91CD\u8981\u7684\u5C31\u662F\u7A7F\u8D77\u6765\u8212\u4E0D\u8212\u670D\uFF01\\n\u6BD5\u7ADF\u8FD9\u662F\u7ECF\u5E38\u7A7F\u5728\u8EAB\u4E0A\u7684\u4E1C\u897F\u3002",
  "\u5305\u5305\u6700\u91CD\u8981\u7684\u5C31\u662F\u8981\u65F6\u9AE6\uFF01\\n\u81F3\u4E8E\u80FD\u88C5\u591A\u5C11\u4E1C\u897F\u662F\u5176\u6B21\u5566\u3002",
  "\u8FD9\u91CC\u5C31\u662F\u5947\u6811\u7684\u9053\u9986\u2026\u2026\\n\u603B\u662F\u5728\u89C6\u9891\u91CC\u770B\u5230\u8FD9\u91CC\u3002\u597D\uFF5E\u611F\u52A8\uFF01",
  "\u4F60\u6709\u6CA1\u6709\u770B\u4E0A\u6B21\u7684\u5947\u6811\u5947\u8FF0\u76F4\u64AD\uFF1F\\n\u5979\u548C\u8389\u666E\u5408\u4F5C\u7684\u90A3\u4E00\u671F\u597D\u68D2\u54E6\uFF01",
  "\u5947\u6811\u771F\u7684\u597D\u53EF\u7231\u554A\uFF0C\u5BF9\u5427\uFF5E\uFF01\\n\u5979\u5E94\u8BE5\u662F\u73B0\u5728\u6700\u706B\u7684\u76F4\u64AD\u4E3B\u5427\u3002",
  "\u57CE\u9547\u91CC\u6709\u81EA\u7136\u666F\u89C2\u7684\u8BDD\uFF0C\\n\u5C31\u80FD\u8BA9\u6211\u5386\u7ECF\u6CA7\u6851\u7684\u5FC3\u88AB\u6CBB\u6108\u5462\u3002",
  "\u4F4F\u5728\u917F\u5149\u5E02\uFF0C\\n\u6BCF\u5929\u611F\u5B98\u90FD\u4F1A\u5927\u53D7\u523A\u6FC0\u662F\u5427\u3002",
  "\u597D\u7684\uFF0C\u9AD8\u7EA7\u7403\u662F\u5427\uFF01\\c\\n\u5B83\u6BD4\u8D85\u7EA7\u7403\u8FD8\u8981\u5389\u5BB3\uFF0C\\n\u6211\u5C31\u5148\u4E0B\u5355\uFF0C\u8BA2\u5B83\uFF13\uFF10\uFF10\u4E2A\u5427\uFF01",
  "\u7B49\u6211\u957F\u5927\u540E\uFF0C\\n\u4E5F\u8981\u5F53\u7F51\uFF5E\u7EA2\uFF5E\uFF01",
  "\u4E16\u754C\u4E0A\u6709\\n\u5404\u79CD\u5404\u6837\u7684\u5DE5\u4F5C\u54E6\uFF5E\uFF01",
  "\u6211\u672C\u6765\u662F\u8981\u505A\u4E09\u660E\u6CBB\u7684\uFF0C\\n\u7ED3\u679C\u624B\u5934\u7ADF\u7136\u6CA1\u6709\u7B7E\u5B50\u2026\u2026\uFF01\\r\\n\u8FD9\u7C7B\u6D88\u8017\u54C1\u8981\u591A\u4E70\u4E00\u4E9B\u624D\u597D\u54E6\u3002",
  "\u6211\u60F3\u5403\u9526\u6C47\u9547\u5B9D\u98DF\u5802\u7684\u6599\u7406\uFF0C\\n\u53C8\u89C9\u5F97\u73BB\u74F6\u5E02\u6D77\u5CB1\u4FF1\u4E50\u90E8\u4E5F\u633A\u597D\u2026\u2026\\r\\n\u5E72\u8106\u53EB\u98DE\u7FD4\u51FA\u79DF\u8F66\u5427\uFF1F",
  "\u8FC7\u4F1A\u513F\u8981\u53BB\u6349\u5B9D\u53EF\u68A6\uFF0C\\n\u6240\u4EE5\u6211\u60F3\u5403\u4E00\u4E9B\\r\\n\u80FD\u63D0\u5347\u6355\u83B7\u529B\u7684\u6599\u7406\uFF5E",
  "\u6709\u5B9D\u53EF\u68A6\u5728\u6D77\u4E0A\u98DE\u3002\\n\u6293\u597D\u65F6\u673A\u2026\u2026\u6309\u5FEB\u95E8\uFF01",
  "\u8FD9\u4E0B\u9762\u6709\u8239\u54E6\uFF01\\n\u6211\u597D\u60F3\u5230\u6D77\u5E95\u53BB\u770B\u770B\u54E6\uFF5E",
  "\u917F\u5149\u5E02\u6709\u975E\u5E38\u591A\u7684\u76D1\u63A7\u6444\u50CF\u5934\uFF0C\\n\u6CBB\u5B89\u7EF4\u6301\u5F97\u5F88\u597D\u54E6\uFF01\\c\\n\u542C\u8BF4\u5728\u917F\u5149\u9053\u9986\u7684\u9053\u9986\u6D4B\u9A8C\u4E2D\\n\u4F1A\u7528\u4E0A\u8FD9\u4E9B\u76D1\u63A7\u6444\u50CF\u5934\u62CD\u5230\u7684\u5F71\u50CF\u5462\u3002",
  "\u5728\u7119\u56FA\u9547\u4F53\u9A8C\u505A\u9676\u5668\uFF01\\n\u4E0B\u4E00\u4EFD\u65B9\u6848\u5C31\u5199\u8FD9\u4E2A\u5427\uFF01",
  "\u7F51\u7EDC\u76F4\u64AD\u4E5F\u5F88\u597D\u5566\uFF0C\\n\u4F46\u6211\u8FD8\u662F\u60F3\u5728\u73B0\u573A\u770B\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF01",
  "\u83B1\u59C6\u5728\u7F51\u4E0A\u53D1\u8868\u65B0\u6B4C\u4E86\u8036\uFF01\\n\u5F97\u5FEB\u70B9\u542C\u542C\u554A\uFF01",
  "\u8389\u666E\u63A8\u51FA\u7684\u9650\u5B9A\u7248\u5316\u5986\u54C1\uFF0C\\n\u6BCF\u4E00\u6B3E\u90FD\u597D\u68D2\uFF01\u4E0D\u77E5\u9053\u8981\u9009\u54EA\u4E2A\u5462\uFF5E\uFF01",
  "\u8FD9\u697C\u4E5F\u592A\u9AD8\u4E86\u5427\uFF01\\n\u770B\u7740\u770B\u7740\u6211\u8116\u5B50\u90FD\u9178\u4E86\u3002",
  "\u542C\u8BF4\u8FD9\uFF15\u680B\u90FD\u662F\\n\u5E15\u5E95\u4E9A\u4E0D\u52A8\u4EA7\u7684\u5927\u697C\u3002",
  "\u8FD9\u5EA7\u57CE\u9547\u91CC\u7684\u7535\u529B\u90FD\u662F\u7531\u53EB\u505A\\n\u5149\u86AA\u4ED4\u7684\u5B9D\u53EF\u68A6\u5728\u52AA\u529B\u53D1\u7535\u54E6\uFF01",
  "\u6211\u63A8\u7684\u4EBA\uFF01\u767B\u4E0A\u4E86\u7535\u5B50\u516C\u544A\u724C\uFF01\\n\u6211\u63A8\u7684\u4EBA\uFF01\u5076\u5C14\u4F1A\u51FA\u73B0\uFF01\\r\\n\u554A\u554A\u2026\u2026\u5BC7\u6C99\u2026\u2026\uFF01\uFF01",
  "\u53EA\u8981\u662F\u66FE\u7ECF\u83B7\u5F97\u8FC7\u7684\u62DB\u5F0F\u5B66\u4E60\u5668\uFF0C\\n\u5C31\u53EF\u4EE5\u7528\u62DB\u5F0F\u5B66\u4E60\u5668\u673A\u5236\u4F5C\u54E6\u3002",
  "\u8981\u662F\u6709\u4F1A\u51B2\u6D6A\u7684\u5750\u9A91\u5B9D\u53EF\u68A6\u5728\uFF0C\\n\u5C31\u7B97\u662F\u8DF3\u8FDB\u6D77\u91CC\u4E5F\u6CA1\u95EE\u9898\u54E6\u3002",
  "\u8FD9\u91CC\u4EE5\u524D\u662F\u6E2F\u9547\uFF0C\\n\u4F1A\u7528\u8239\u53BB\u642C\u8FD0\u77FF\u5C71\u7684\u77FF\u77F3\u3002\\c\\n\u60F3\u4E0D\u5230\u73B0\u5728\u7ADF\u7136\u53D8\u6210\\n\u8FD9\uFF5E\u6837\u7684\u5546\u4E1A\u57CE\u5E02\u5462\u3002",
  "\u917F\u5149\u5E02\u7684\u917F\u5149\u662F\u4EC0\u4E48\u610F\u601D\u5462\uFF1F\\n\u917F\u4E2A\u7CBE\u5149\uFF1F\u917F\u5230\u53D1\u5149\uFF1F\\c\\n\u65E2\u7136\u8FD9\u91CC\u7684\u591C\u666F\u88AB\u8A89\u4E3A\u767E\u4E07\u4F0F\u7279\u591C\u666F\uFF0C\\n\u90A3\u5E94\u8BE5\u5C31\u662F\u917F\u5230\u53D1\u5149\u5427\uFF1F",
  "\u4E0D\u662F\u6709\u4E2A\u77E5\u540D\u7684\u535A\u58EB\u5417\uFF1F\\n[VAR 1107(00FF,0101)]\u5979\u4ED6\u6700\u8FD1\u597D\u50CF\u90FD\u6CA1\u600E\u4E48\u5728\u5A92\u4F53\u4E0A\u51FA\u73B0\u8036\u3002",
  "\u5C0F\u5319\u9547\u9644\u8FD1\u6709\u4E2A\u706F\u5854\uFF0C\\n\u542C\u8BF4\u90A3\u91CC\u7684\uFF11\u697C\u662F\u4E2A\u7814\u7A76\u5BA4\u5462\u3002",
  "\u6362\u4E2A\u5916\u89C2\u7684\u8BDD\uFF0C\\n\u5FC3\u60C5\u4E5F\u4F1A\u968F\u4E4B\u6539\u53D8\u54E6\uFF01\\c\\n\u9009\u62E9\u7A7F\u4EC0\u4E48\u8863\u670D\uFF0C\\n\u4E5F\u4F1A\u5F71\u54CD\u4E00\u6574\u5929\u7684\u6C1B\u56F4\uFF0C\u5BF9\u5427\uFF01",
  "\u4F24\u836F\u3001\u98DF\u6750\uFF0C\\n\u8FD8\u6709\u7CBE\u7075\u7403\uFF01\\r\\n\u6CA1\u6709\u6F0F\u4E70\u4EC0\u4E48\u4E1C\u897F\u5427\uFF1F",
  "\u5230\u65F6\u5019\u5C31\u5750\u98DE\u7FD4\u51FA\u79DF\u8F66\\n\u8F7B\u677E\u76F4\u8FBE\u53CB\u597D\u5546\u5E97\u5427\u3002",
  "[~ 44]",
  "\u5947\u6811\u5979\u4ECE\u597D\u51E0\u5E74\u524D\\n\u5C31\u5F00\u59CB\u505A\u7F51\u7EDC\u76F4\u64AD\u4E86\u3002\\r\\n\u2026\u2026\u5979\u73B0\u5728\u5230\u5E95\u51E0\u5C81\u554A\uFF1F",
  "\u8FD9\u53EA\u52D2\u514B\u732B\u7684\u6BDB\u8272\\n\u662F\u4E0D\u662F\u8D85\u5E05\u7684\u554A\uFF5E\uFF01\\c\\n\u6BCF\u6B21\u5BF9\u6218\u540E\uFF0C\\n\u6211\u90FD\u4F1A\u7ACB\u9A6C\u7ED9\u5B83\u6D17\u6FA1\u6FA1\u5462\u3002",
  "\u603B\u6709\u4E00\u5929\u6211\u8981\u53D8\u6210\u6709\u94B1\u4EBA\uFF0C\\n\u7136\u540E\u8BF4\u201C\u4ECE\u8FD9\u91CC\u5230\u8FD9\u91CC\uFF0C\u6211\u90FD\u8981\u4E86\uFF01\u201D\\r\\n\u2026\u2026\u8FD9\u53E5\u7ECF\u5178\u53F0\u8BCD\uFF5E\uFF01",
  "\u6211\u56BC\uFF0C\u6211\u56BC\uFF0C\u6211\u56BC\u56BC\u56BC\u3002\\c\\n\u5728\u917F\u5149\u9053\u9986\u6311\u6218\u7684\u5B9E\u51B5\\n\u90FD\u4F1A\u88AB\u7F51\u7EDC\u76F4\u64AD\u54E6\u3002",
  "\u6211\u559D\uFF0C\u6211\u559D\uFF0C\u6211\u559D\u559D\u559D\u3002\\c\\n\u4E4B\u524D\u7684\u9053\u9986\u76F4\u64AD\u91CC\u6709\u4E2A\u53EB\u59AE\u83AB\u7684\u4EBA\uFF0C\\n\u5979\u7684\u5B9D\u53EF\u68A6\u597D\u5389\u5BB3\u554A\uFF01",
  "\u542C\u8BF4\u5728\u5B66\u9662\u91CC\\n\u6709\u8BB8\u8BB8\u591A\u591A\u7684\u4E66\uFF01\\c\\n\u7B49\u6211\u5165\u5B66\u4EE5\u540E\uFF0C\\n\u4E00\u5B9A\u8981\u8BFB\u904D\u300AOH\uFF01\u8D85\u81EA\u7136\u6587\u5316\u300B\uFF01",
  "\u4ECE\u8FD9\u524D\u9762\u7684\u706F\u5854\u671B\u4E0B\u53BB\uFF0C\\n\u53EF\u4EE5\u628A\u917F\u5149\u5E02\u7684\u98CE\u666F\u5C3D\u6536\u773C\u5E95\u54E6\u3002",
  "\u867D\u7136\u6211\u4E5F\u5F88\u559C\u6B22\u98CE\u666F\u7167\uFF0C\\n\u4F46\u662F\u4F1A\u7559\u5728\u56DE\u5FC6\u91CC\u7684\\r\\n\u603B\u662F\u4EBA\u6216\u5B9D\u53EF\u68A6\u7684\u7167\u7247\u5462\u3002"
]
