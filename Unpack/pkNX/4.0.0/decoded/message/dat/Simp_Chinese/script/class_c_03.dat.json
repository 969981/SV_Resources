[
  "\u55E8\uFF0C\u540C\u5B66\u4EEC\u597D\u3002\\n\u6628\u65E5\u4E5F\u5DF2\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u4E00\u90E8\u5206\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8BA9\u6211\u4EEC\u4E00\u8D77\\n\u89E3\u6790\u5386\u53F2\u7684\u7F8E\u5999\u4E4B\u5904\u5427\u3002[VAR 0114(0027)]",
  "\u5982\u540C\u6211\u5728\u4E0A\u6B21\u8BFE\u5802\u4E2D\u6240\u6559\u7684\uFF0C\\n\u5927\u7EA6\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\u8D77\uFF0C\\r\\n\u7B2C\u96F6\u533A\u6F2B\u957F\u7684\u5927\u63A2\u7D22\u65F6\u4EE3\u5F00\u59CB\u4E86\uFF01[VAR 0114(0027)]",
  "\u5927\u63A2\u7D22\u6301\u7EED\u4E86\uFF11\uFF10\uFF10\uFF10\u5E74\u5DE6\u53F3\uFF0C\\n\u5374\u6CA1\u6709\u4EFB\u4F55\u4EBA\u80FD\u591F\u5230\u8FBE\\r\\n\u7B2C\u96F6\u533A\u7684\u6700\u6DF1\u5904\u3002[VAR 0114(0027)]",
  "\u5E15\u5E95\u4E9A\u5E1D\u56FD\u957F\u65F6\u95F4\\n\u5C06\u4EBA\u529B\u548C\u8D22\u529B\u8017\u8D39\u5728\u7B2C\u96F6\u533A\u7684\u63A2\u7D22\uFF0C\\r\\n\u4E5F\u56E0\u6B64\u9010\u6E10\u5931\u53BB\u4E86\u56FD\u529B\u3002[VAR 0114(0027)]",
  "\u90A3\u4E4B\u540E\u8FC7\u4E86\uFF12\uFF10\uFF10\u5E74\u2026\u2026\\n\u4E5F\u5C31\u662F\u8DDD\u4ECA\uFF18\uFF10\uFF10\u5E74\u524D\u3002\\c\\n\u5E15\u5E95\u4E9A\u5E1D\u56FD\u4E0E\u5468\u8FB9\u7684\u56FD\u5BB6\u5408\u5E76\uFF0C\\n\u6210\u4E3A\u4E86\u73B0\u5728\u7684\u5E15\u5E95\u4E9A\u3002[VAR 0114(0027)]",
  "\u554A\uFF0C\u5BF9\u4E86\u5BF9\u4E86\uFF0C\\n\u4F60\u4EEC\u73B0\u5728\u5C31\u8BFB\u7684\u8FD9\u6240\u5B66\u6821\\r\\n\u4F3C\u4E4E\u4E5F\u662F\u5728\u90A3\u4E2A\u65F6\u671F\u5EFA\u7ACB\u7684\u3002[VAR 0114(0027)]",
  "\u867D\u7136\u8FD9\u5EA7\u6821\u820D\u7ECF\u5386\u4E86\u5404\u79CD\u7684\u7EF4\u4FEE\uFF0C\\n\u4F46\u5B83\u8FD8\u662F\u7EF4\u6301\u7740\u521B\u7ACB\u65F6\u7684\u72B6\u6001\uFF0C\\r\\n\u73B0\u5728\u4E5F\u4F9D\u7136\u4E3A\u5927\u5BB6\u6240\u7528\u3002[VAR 0114(0027)]",
  "\u80FD\u8BA9\u4EBA\u611F\u53D7\u5230\u5386\u53F2\u7684\u5EFA\u7B51\u2026\u2026\\n\u554A\u554A\u2026\u2026\u6240\u8C13\u53E4\u8001\u662F\u591A\u4E48\u5730\u7F8E\u5999\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF0C\u90A3\u4E2A\u8FD1\u671F\u65B0\u4FEE\u7684\\n\u7CBE\u7075\u7403\u90E8\u5206\uFF0C\u6211\u5B9E\u5728\u662F\u4E0D\u559C\u6B22\u5450\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u770B\u770B\u4F60\u662F\u5426\u6709\u597D\u597D\u542C\u8BB2\u5462\uFF1F\\n\u8FD9\u6240\u5B66\u6821\u662F\u5728\u5927\u7EA6\\r\\n\u591A\u5C11\u5E74\u524D\u5EFA\u7ACB\u7684\uFF1F[VAR 0114(0027)]",
  "\u5927\u7EA6\uFF16\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7EA6\uFF17\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7EA6\uFF18\uFF10\uFF10\u5E74\u524D",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u8DB3\u8DB3\u5C11\u4E86\uFF12\uFF10\uFF10\u5E74\u4EFD\u7684\u53E4\u8001\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u8DB3\u8DB3\u5C11\u4E86\uFF11\uFF10\uFF10\u5E74\u4EFD\u7684\u53E4\u8001\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u6B63\u786E\uFF01\\n\u4F60\u7684\u6CE8\u610F\u529B\u975E\u6BD4\u5BFB\u5E38\u3002\\r\\n\u770B\u6765\u5E76\u4E0D\u662F\u5728\u5047\u88C5\u542C\u8BB2\u5462\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u51C6\u786E\u6765\u8BF4\uFF0C\\n\u8FD9\u6240\u5B66\u6821\u521B\u7ACB\u4E8E\uFF18\uFF10\uFF15\u5E74\u524D\uFF0C\\r\\n\u4E5F\u5C31\u662F\u8BF4\u5B83\u5DF2\u7ECF\u6709\uFF18\uFF10\uFF15\u5E74\u7684\u5386\u53F2\u4E86\u3002[VAR 0114(0027)]",
  "\u5F53\u65F6\u5B83\u62E5\u6709\u6700\u65B0\u7684\u8BBE\u5907\uFF0C\\n\u80FD\u63D0\u4F9B\u6700\u5148\u8FDB\u7684\u6559\u80B2\uFF0C\u56E0\u800C\u5F97\u6B64\u4E00\u8BF4\u2026\u2026[VAR 0114(0027)]",
  "\u201C\u6B32\u6C42\u667A\u6167\uFF0C\\n \u4E14\u98DF\u6A58\u5B50\u3002\u201D[VAR 0114(0027)]",
  "\u201C\u6B32\u6C42\u667A\u6167\uFF0C\\n \u4E14\u98DF\u8461\u8404\u3002\u201D[VAR 0114(0027)]",
  "\u2026\u2026\u636E\u8BF4\uFF0C\u8FD9\u53E5\u8BDD\u751A\u81F3\\n\u6D41\u4F20\u5230\u4E86\u5E15\u5E95\u4E9A\u4E4B\u5916\u7684\u5730\u533A\u3002[VAR 0114(0027)]",
  "\u54CE\u5440\uFF1F\u6211\u6216\u8BB8\u8BF4\u592A\u591A\u4E86\uFF0C\\n\u65F6\u95F4\u597D\u50CF\u8D70\u592A\u5FEB\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u4E0B\u6B21\u4F1A\u8FDB\u884C\u671F\u4E2D\u8003\u8BD5\u54E6\u3002\\r\\n\u5E0C\u671B\u4F60\u4EEC\u80FD\u4E8B\u5148\u5524\u9192\u53E4\u8001\u7684\u77E5\u8BC6\u3002[VAR 0114(0027)]"
]
