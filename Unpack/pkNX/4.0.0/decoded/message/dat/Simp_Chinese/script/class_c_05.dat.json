[
  "\u55E8\uFF0C\u540C\u5B66\u4EEC\u597D\u3002\\n\u6628\u65E5\u4E5F\u5DF2\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u4E00\u90E8\u5206\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8BA9\u6211\u4EEC\u4E00\u8D77\u89E3\u6790\\n\u5386\u53F2\u7684\u7F8E\u5999\u4E4B\u5904\u5427\u2026\u2026\u6211\u539F\u672C\u662F\u8FD9\u4E48\u6253\u7B97\uFF0C\\r\\n\u4F46\u521A\u8003\u5B8C\u8BD5\uFF0C\u60F3\u5FC5\u4F60\u4EEC\u73B0\u5728\u4E5F\u6BEB\u65E0\u5E72\u52B2\u5427\uFF1F[VAR 0114(0027)]",
  "\u90A3\u4E48\u5076\u5C14\u4E5F\u6362\u4E0B\u65B9\u9488\uFF0C\\n\u8BA9\u4F60\u4EEC\u4EAB\u53D7\u5FEB\u4E50\u7684\u65F6\u95F4\u5427\u3002[VAR 0114(0027)]",
  "\u6211\u6765\u8BB2\u4E00\u8BB2\u76F8\u4F20\u4E8E\\n\u5E15\u5E95\u4E9A\u7684\u5F88\uFF5E\u4E45\u4EE5\u524D\u7684\u7AE5\u8BDD\u3002[VAR 0114(0027)]",
  "\u4ECE\u524D\u5728\u67D0\u4E2A\u5730\u65B9\uFF0C\\n\u6709\u4F4D\u56FD\u738B\u975E\u5E38\u559C\u6B22\u6536\u96C6\u5B9D\u7269\u3002[VAR 0114(0027)]",
  "\u56FD\u738B\u5C24\u5176\u559C\u7231\u5F02\u56FD\u7684\u5B9D\u7269\u3002\\c\\n\u67D0\u5929\uFF0C\u6765\u81EA\u4E1C\u65B9\u56FD\u5BB6\u7684\u5546\u4EBA\\n\u542C\u5230\u4E86\u8FD9\u4E2A\u4F20\u95FB\u800C\u524D\u6765\u62DC\u8BBF\u56FD\u738B\u3002[VAR 0114(0027)]",
  "\u5546\u4EBA\u5728\u56FD\u738B\u9762\u524D\u6446\u4E0A\u4E86\uFF14\u4E2A\u5B9D\u7269\u3002[VAR 0114(0027)]",
  "\u8FD9\uFF14\u4E2A\u5B9D\u7269\u5206\u522B\u662F\u2026\u2026\\n\u9F0E\u2026\u2026\u5251\u2026\u2026\\r\\n\u7B80\u2026\u2026\u7389\u2026\u2026[VAR 0114(0027)]",
  "\u4E00\u89C1\u5230\u7A00\u6709\u7684\u5B9D\u7269\uFF0C\\n\u56FD\u738B\u9AD8\u5174\u5F97\u8DF3\u4E86\u8D77\u6765\u3002[VAR 0114(0027)]",
  "\u4ED6\u7ED9\u4E86\u5546\u4EBA\u5F88\u591A\u5F88\u591A\u94B1\uFF0C\\n\u8BA9\u5546\u4EBA\u628A\uFF14\u4E2A\u5B9D\u7269\u7559\u7ED9\u4E86\u4ED6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u4F60\u77E5\u9053\u90A3\u5B9D\u7269\u4E2D\u7684\\n\u201C\u7B80\u201D\u662F\u600E\u6837\u7684\u4E1C\u897F\u5417\uFF1F[VAR 0114(0027)]",
  "\u6728\u677F",
  "\u4E50\u8C31",
  "\u8F7B\u98DF",
  "\u2026\u2026\u56DE\u7B54\u6B63\u786E\uFF01\\n\u770B\u6765\u4F60\u5E73\u65F6\u6709\u5728\u63A2\u7A76\u77E5\u8BC6\u5462\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u90A3\u662F\u201C\u7B80\u8C31\u201D\u5427\uFF01\\r\\n\u4F60\u5728\u7B49\u6211\u8FD9\u6837\u5410\u69FD\u5BF9\u4E0D\u5BF9\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u90A3\u662F\u201C\u7B80\u9910\u201D\u5427\uFF01\\r\\n\u4F60\u5728\u7B49\u6211\u8FD9\u6837\u5410\u69FD\u5BF9\u4E0D\u5BF9\uFF1F[VAR 0114(0027)]",
  "\u201C\u7B80\u201D\u662F\u53E4\u65F6\u5728\u4E1C\u65B9\u7684\u56FD\u5BB6\\n\u7528\u6765\u4E66\u5199\u6587\u5B57\u65F6\u4F7F\u7528\u7684\u6728\u677F\u3002\\r\\n\u2026\u2026\u4E5F\u88AB\u79F0\u4E3A\u201C\u6728\u7B80\u201D\u3002[VAR 0114(0027)]",
  "\u6B63\u5982\u5927\u5BB6\u6240\u77E5\uFF0C\\n\u5728\u7EB8\u666E\u53CA\u4E4B\u540E\uFF0C\\r\\n\u4EBA\u4EEC\u5C31\u4E0D\u592A\u4F7F\u7528\u6728\u7B80\u4E86\u3002[VAR 0114(0027)]",
  "\u4EE3\u66FF\u7EB8\u7684\u6728\u677F\u7ADF\u7136\u662F\u4E2A\u5B9D\u7269\uFF0C\\n\u6216\u8BB8\u662F\u90A3\u4E1C\u897F\u770B\u8D77\u6765\u7279\u522B\u6C14\u6D3E\uFF0C\\r\\n\u53C8\u6216\u8BB8\u662F\u90A3\u4E0A\u8FB9\u5199\u7740\u53EF\u8D35\u7684\u6559\u8BF2\u3002[VAR 0114(0027)]",
  "\u5728\u56FD\u738B\u5F97\u5230\u5B9D\u7269\u540E\u7684\u90A3\u4E2A\u591C\u665A\u2026\u2026[VAR 0114(0027)]",
  "\u707E\u96BE\u964D\u4E34\u5728\u4E86\u56FD\u738B\u7684\u57CE\u5821\uFF0C\\n\u636E\u8BF4\uFF0C\u4E00\u591C\u4E4B\u95F4\u57CE\u5821\u5168\u6BC1\u3002[VAR 0114(0027)]",
  "\u6211\u8FD8\u6CA1\u6709\u8BB2\u5B8C\u5462\uFF0C\\n\u65F6\u95F4\u597D\u50CF\u8D70\u592A\u5FEB\u4E86\u3002[VAR 0114(0027)]",
  "\u60F3\u77E5\u9053\u540E\u7EED\u7684\u540C\u5B66\\n\u5728\u8BFE\u4E0B\u65F6\u95F4\u6765\u627E\u6211\u5427\u3002[VAR 0114(0027)]"
]
