[
  "\u55E8\uFF0C\u540C\u5B66\u4EEC\u597D\u3002\\n\u6628\u65E5\u4E5F\u5DF2\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u4E00\u90E8\u5206\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u662F\u6700\u540E\u4E00\u5802\u8BFE\u3002\\n\u6211\u4EEC\u8FD8\u662F\u7EE7\u7EED\u4E00\u8D77\\r\\n\u89E3\u6790\u5386\u53F2\u7684\u7F8E\u5999\u4E4B\u5904\u5427\u3002[VAR 0114(0027)]",
  "\u4E0A\u4E00\u5802\u8BFE\u6211\u8BB2\u4E86\uFF12\uFF10\uFF10\u5E74\u524D\\n\u7B2C\u96F6\u533A\u89C2\u6D4B\u961F\u7684\u6545\u4E8B\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0027)]",
  "\u554A\u554A\u2026\u2026\u6211\u8981\u6559\u7684\u5185\u5BB9\\n\u5F00\u59CB\u63A5\u8FD1\u73B0\u4EE3\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u5386\u53F2\u8BFE\u603B\u662F\u4F1A\u968F\u7740\u8FDB\u5EA6\\n\u800C\u8D70\u5411\u672A\u6765\uFF0C\u8FD9\u70B9\u771F\u6CA1\u610F\u601D\u3002[VAR 0114(0027)]",
  "\u5E72\u8106\u4ECE\u73B0\u4EE3\u56DE\u6EAF\u65F6\u95F4\u5230\u8FC7\u53BB\uFF0C\\n\u8FD9\u6837\u624D\u6BD4\u8F83\u6D6A\u6F2B\uFF0C\u4E0D\u662F\u5417\uFF01\uFF1F[VAR 0114(0027)]",
  "\u8D5E\u540C\uFF01",
  "\u90A3\u4F1A\u5F88\u96BE\u61C2\u2026\u2026",
  "[VAR 0100(0000)]\uFF0C\u770B\u6765\u4F60\u61C2\u6211\uFF01\\c\\n\u4F46\u5982\u679C\u4E0D\u6309\u7167\u6559\u5B66\u5927\u7EB2\u6765\u7684\u8BDD\uFF0C\\n\u6821\u957F\u80AF\u5B9A\u4F1A\u4FEE\u7406\u6211\u4E00\u756A\u7684\u3002[VAR 0114(0027)]",
  "\u786E\u5B9E\u2026\u2026\u6BD4\u5982\u5148\u53D1\u751F\u4E86\u67D0\u4EF6\u4E8B\u60C5\uFF0C\\n\u968F\u540E\u53C8\u53D1\u751F\u4E86\u53E6\u4E00\u4EF6\u4E8B\uFF0C\\r\\n\u8981\u7406\u89E3\u8FD9\u6837\u7684\u8FDB\u7A0B\u6216\u8BB8\u6709\u4E9B\u56F0\u96BE\u3002[VAR 0114(0027)]",
  "\u54CE\u5440\uFF0C\u771F\u662F\u6CA1\u529E\u6CD5\u2026\u2026\\n\u5C31\u8BA9\u65F6\u949F\u8FC8\u5411\u672A\u6765\u524D\u8FDB\u5427\u3002[VAR 0114(0027)]",
  "\u6700\u540E\u4E00\u5802\u8BFE\u5C31\u8BA9\u6211\\n\u6765\u6559\u6559\u4F60\u4EEC\u592A\u6676\u7684\u5386\u53F2\u5427\u3002[VAR 0114(0027)]",
  "\u592A\u6676\u73E0\u539F\u672C\u662F\\n\u8BDE\u751F\u4E8E\u7B2C\u96F6\u533A\u7684\u6280\u672F\u3002[VAR 0114(0027)]",
  "\u636E\u8BF4\u5728\u89C2\u6D4B\u961F\u5230\u8FBE\u6700\u6DF1\u5904\u4E4B\u540E\uFF0C\\n\u4EBA\u4EEC\u5BF9\u7B2C\u96F6\u533A\u7684\u63A2\u7D22\u4E5F\u4F9D\u7136\u6301\u7EED\u2026\u2026[VAR 0114(0027)]",
  "\u4E8E\u662F\uFF0C\u5C31\u5728\u5927\u7EA6\uFF11\uFF14\uFF10\u5E74\u524D\uFF0C\\n\u6709\u4EBA\u53D1\u73B0\u4E86\u7B3C\u7F69\u5728\u795E\u79D8\u5149\u8292\u4E2D\u7684\u5B9D\u53EF\u68A6\u3002[VAR 0114(0027)]",
  "\u6211\u60F3\u4F60\u4EEC\u5DF2\u7ECF\u731C\u5230\u4E86\uFF0C\\n\u90A3\u6B63\u662F\u592A\u6676\u5316\u7684\u5B9D\u53EF\u68A6\u3002[VAR 0114(0027)]",
  "\u867D\u7136\u4EBA\u4EEC\u628A\u8FD9\u4E9B\u5B9D\u53EF\u68A6\u4ECE\u7B2C\u96F6\u533A\u5E26\u4E86\u56DE\u6765\uFF0C\\n\u4F46\u5B83\u4EEC\u5931\u53BB\u4E86\u8EAB\u4F53\u7684\u5149\u8292\u3002\\r\\n\u5F88\u957F\u4E00\u6BB5\u65F6\u95F4\uFF0C\u592A\u6676\u5316\u73B0\u8C61\u90FD\u88AB\u8C1C\u56E2\u7B3C\u7F69\u3002[VAR 0114(0027)]",
  "\u76F4\u5230\uFF11\uFF10\u5E74\u524D\u2026\u2026\u8FD9\u5DF2\u7ECF\u662F\u8FD1\u4EE3\u4E86\u5462\uFF0C\\n\u67D0\u4F4D\u4F60\u4EEC\u4E5F\u77E5\u9053\u7684\u4EBA\u7269\\r\\n\u89E3\u660E\u4E86\u592A\u6676\u5316\u7684\u539F\u7406\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u89E3\u660E\u4E86\u592A\u6676\u5316\u539F\u7406\u7684\u77E5\u540D\u535A\u58EB\u2026\u2026\\n\u53EB\u505A\u4EC0\u4E48\u540D\u5B57\uFF1F[VAR 0114(0027)]",
  "\u6D77\u54F2\u535A\u58EB",
  "\u5965\u7433\u535A\u58EB",
  "\u5F17\u56FE\u535A\u58EB",
  "\u514B\u62C9\u97E6\u5C14\u535A\u58EB",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u6D77\u54F2\u662F\u63A2\u9669\u8BB0\u7684\u4F5C\u8005\u554A\u3002\\r\\n\u4F60\u628A\u8FD9\u5802\u8BFE\u548C\u4E0A\u5802\u8BFE\u7684\u5185\u5BB9\u641E\u6DF7\u4E86\u54E6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u6B63\u786E\uFF01\\n\u4F60\u624D\u521A\u521A\u8F6C\u5B66\u8FC7\u6765\u5374\u5F88\u4E86\u89E3\u5462\uFF0C\\r\\n\u770B\u6765\u4F60\u5F88\u70ED\u7231\u5B66\u4E60\u554A\u3002[VAR 0114(0027)]",
  "\u56DE\u7B54\u9519\u8BEF\u2026\u2026\u7B49\u7B49\uFF0C\\n\u4ECE\u67D0\u79CD\u89D2\u5EA6\u6765\u8BF4\u6216\u8BB8\u662F\u6B63\u786E\u7684\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u5927\u7EA6\uFF11\uFF10\u5E74\u524D\uFF0C\u4E00\u4F4D\u540D\u4E3A\\n\u5965\u7433\u7684\u535A\u58EB\u89E3\u660E\u4E86\u592A\u6676\u5316\u73B0\u8C61\u3002[VAR 0114(0027)]",
  "\u5927\u7EA6\uFF11\uFF10\u5E74\u524D\uFF0C\u4E00\u4F4D\u540D\u4E3A\\n\u5F17\u56FE\u7684\u535A\u58EB\u89E3\u660E\u4E86\u592A\u6676\u5316\u73B0\u8C61\u3002[VAR 0114(0027)]",
  "\u5979\u67E5\u660E\u4E86\u539F\u56E0\uFF0C\\n\u662F\u7B2C\u96F6\u533A\u91CC\u53D1\u5149\u7684\u7ED3\u6676\u7684\u80FD\u91CF\u2026\u2026\\r\\n\u8BA9\u5B9D\u53EF\u68A6\u592A\u6676\u5316\u7684\u3002[VAR 0114(0027)]",
  "\u4ED6\u67E5\u660E\u4E86\u539F\u56E0\uFF0C\\n\u662F\u7B2C\u96F6\u533A\u91CC\u53D1\u5149\u7684\u7ED3\u6676\u7684\u80FD\u91CF\u2026\u2026\\r\\n\u8BA9\u5B9D\u53EF\u68A6\u592A\u6676\u5316\u7684\u3002[VAR 0114(0027)]",
  "\u7136\u540E\uFF0C\u535A\u58EB\u53D1\u660E\u4E86\u592A\u6676\u73E0\uFF0C\\n\u8BA9\u8FD9\u9879\u6280\u672F\u5F97\u4EE5\u5B9E\u7528\u3002\\c\\n\u5E76\u4E14\u63D0\u4F9B\u7ED9\u4E86\u5B9D\u53EF\u68A6\u8054\u76DF\u548C\u5B66\u6821\u54E6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u4F20\u95FB\u4E2D\uFF0C\u636E\u8BF4\u514B\u62C9\u97E6\u5C14\u6821\u957F\\n\u4E5F\u66FE\u5728\u540C\u4E00\u4E2A\u7EC4\u91CC\u8FDB\u884C\u8FC7\u7814\u7A76\u3002[VAR 0114(0027)]",
  "\u81EA\u5DF1\u8BA4\u8BC6\u7684\u4EBA\u7269\u4E00\u51FA\u73B0\uFF0C\\n\u77AC\u95F4\u5C31\u6BEB\u65E0\u6D6A\u6F2B\u53EF\u8A00\u4E86\u2026\u2026\\r\\n\u679C\u7136\u8FD1\u4EE3\u53F2\u5C31\u662F\u5F88\u65E0\u804A\u554A\u3002[VAR 0114(0027)]",
  "\u81F3\u6B64\uFF0C\u6211\u7684\u5386\u53F2\u8BFE\u5C31\u7ED3\u675F\u4E86\u3002\\n\u4E0B\u6B21\u4F1A\u8FDB\u884C\u671F\u672B\u8003\u8BD5\u54E6\u3002\\r\\n\u5E0C\u671B\u4F60\u4EEC\u80FD\u4E8B\u5148\u5524\u9192\u53E4\u8001\u7684\u77E5\u8BC6\u3002[VAR 0114(0027)]"
]
