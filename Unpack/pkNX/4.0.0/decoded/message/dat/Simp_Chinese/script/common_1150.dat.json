  "\u54CE\uFF5E\u5E72\u561B\uFF1F\\n\u597D\u620F\u6B63\u8981\u5F00\u59CB\u5462\u2026\u2026[VAR 0114(0004)]",
  "\u8981\u662F\u8DD1\u51FA\u6765\u96BE\u7F20\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u8BA9[VAR 0101(0001)]\u4E5F\u5728\u573A\\r\\n\u4F1A\u6BD4\u8F83\u597D\u5427\uFF1F[VAR 0114(0006)]",
  "\u5982\u679C\u662F\u5728\u6D77\u6E7E\u6D1E\u7A74\u770B\u5230\u7684\\n[VAR 0101(0001)]\uFF0C\u90A3\u786E\u5B9E\u5F88\u9760\u5F97\u4F4F\uFF01\\r\\n\u6211\u60F3\u770B\u5230\u5B83\u82F1\u52C7\u7684\u6218\u6597\u8868\u73B0\uFF01[VAR 0114(0004)]",
  "\u5443\uFF5E\u4E0D\u8FC7\u2026\u2026\\n\u81EA\u4ECE\u6765\u5230\u7B2C\u96F6\u533A\u4E4B\u540E\uFF0C\\r\\n\u5B83\u5C31\u4E0D\u559C\u6B22\u8BA9\u4EBA\u9A91\u2026\u2026\\r\\n\u8BDD\u8BF4\u5B83\u90FD\u6CA1\u6CD5\u53D8\u6210\u5BF9\u6218\u5F62\u6001\uFF0C\u4E0D\u662F\u5417\uFF1F[VAR 0114(0008)]",
  "\u90A3\u5BB6\u4F19\u5176\u5B9E\u662F\u5F88\u5F3A\u7684\u3002\\c\\n\u800C\u4E14\u5B83\u8FD8\u5403\u4E86\u79D8\u4F20\u8C03\u5473\u6599\uFF0C\\n\u5230\u4E86\u5173\u952E\u65F6\u523B\u5C31\u4F1A\u6218\u6597\u4E86\u5427\uFF01[VAR 0114(0006)]",
  "\u800C\u4E14\u7B2C\u96F6\u533A\u662F\u90A3\u5BB6\u4F19\\n\u4F4F\u8FC7\u4E00\u6BB5\u65F6\u95F4\u7684\u5730\u65B9\u2026\u2026\\c\\n\u628A\u5B83\u4ECE\u7403\u91CC\u653E\u51FA\u6765\u7684\u8BDD\uFF0C\\n\u8BF4\u4E0D\u5B9A\u5B83\u7684\u5BB6\u4EBA\u8FD8\u4F1A\u6765\u627E\u5B83\u5462\u3002[VAR 0114(0006)]",
  "\u8FD9\u8BDD\u867D\u7136\u51FA\u81EA\u6D3E\u5E15\u5634\u91CC\uFF0C\\n\u4F46\u597D\u50CF\u8FD8\u6709\u70B9\u9053\u7406\uFF01[VAR 0114(0004)]",
  "\u55EF\uFF5E\\n\u771F\u7684\u662F\u8FD9\u6837\u5417\u2026\u2026[VAR 0114(0008)]",
