[
  "\u55E8\uFF5E\u672A\u6765\u7684\u51A0\u519B\u3002[VAR 0114(004A)]",
  "\u62B1\u6B49\uFF0C\u62B1\u6B49\uFF0C\\n\u8BA9\u4F60\u7B49\u4E86\u4E00\u4F1A\u513F\u3002[VAR 0114(004A)]",
  "\u4F60\u6253\u8D25\u4E86\\n\u7B2C\uFF11\u4F4D\u56DB\u5929\u738B\uFF0C\\r\\n\u662F\u4E2A\u5F00\u95E8\u7EA2\u554A\uFF5E[VAR 0114(004A)]",
  "\u8D64\u677E\u7684\u5B9E\u529B\\n\u4E5F\u7B97\u4E0D\u5F31\uFF0C\\r\\n\u4ED6\u53EA\u662F\u60F3\u6CD5\u6BD4\u8F83\u5355\u7EAF\u3002[VAR 0114(004A)]",
  "\u4E0D\u8FC7\uFF0C\\n\u90A3\u4E5F\u662F\u4ED6\u7684\u4F18\u70B9\u3002[VAR 0114(004A)]",
  "\u4EE5\u524D\u5927\u5BB6\u5C31\u559C\u6B22\u5728\u793E\u56E2\u6D3B\u52A8\u7ED3\u675F\u540E\\n\u54C1\u5C1D\u8D64\u677E\u505A\u7684\u996D\u554A\uFF5E[VAR 0114(004A)]",
  "\u90A3\u5BB6\u4F19\u4E5F\u4EE5\u81EA\u5DF1\u7684\u65B9\u5F0F\\n\u2026\u2026\u70E6\u607C\u8FC7\u3002[VAR 0114(004A)]",
  "\u7EB3\u8389\u90A3\u5BB6\u4F19\\n\u5F88\u6709\u8DA3\u5427\uFF1F[VAR 0114(004A)]",
  "\u5979\u548C\u4E39\u745C\u8BF4\u8BDD\u65F6\\n\u83AB\u540D\u5176\u5999\u5730\u5408\u5F97\u6765\uFF0C\\r\\n\u8FD9\u4E00\u70B9\u4E5F\u5F88\u597D\u7B11\u554A\u3002[VAR 0114(004A)]",
  "\u7EB3\u8389\u5979\u8FD9\u4E2A\u4EBA\u554A\uFF0C\\n\u53C8\u8BA4\u771F\u53C8\u5014\u5F3A\u2026\u2026\\r\\n\u4F46\u6BD4\u4E00\u822C\u4EBA\u5FC3\u601D\u7EC6\u817B\u5F97\u591A\u3002[VAR 0114(004A)]",
  "\u5979\u5BB9\u6613\u88AB\u4EBA\u8BEF\u4F1A\uFF0C\\n\u4F46[VAR 0100(0000)]\u4F60\u8981\u7406\u89E3\u5979\u54E6\u3002[VAR 0114(004A)]",
  "\u7D2B\u7AFD\u7279\u522B\u559C\u6B22\u53EF\u7231\u7684\u4E8B\u7269\uFF0C\\n\u6240\u4EE5\u5B9D\u53EF\u68A6\u5BF9\u6218\u53D8\u5F97\u5F88\u5F3A\u3002[VAR 0114(004A)]",
  "\u51FA\u81EA\u7231\u597D\u7684\u52AA\u529B\u5728\u5979\u770B\u6765\\n\u90FD\u4E0D\u53EB\u52AA\u529B\uFF0C\u8FD9\u4E00\u70B9\u5F88\u5389\u5BB3\u5440\u3002[VAR 0114(004A)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF01[VAR 0100(0000)]\u4F60\\n\u4E5F\u5DEE\u4E0D\u591A\u662F\u8FD9\u6837\u5427\u3002[VAR 0114(004A)]",
  "\u4E0D\u50CF\u67D0\u4EBA\uFF0C\u4E3A\u4E86\u8FFD\u6C42\u5F3A\u5927\uFF0C\\n\u727A\u7272\u4E86\u8EAB\u8FB9\u7684\u4EBA\u548C\u81EA\u5DF1\u2026\u2026\\r\\n\u771F\u5E0C\u671B\u67D0\u4EBA\u80FD\u5B66\u7740\u70B9\u3002[VAR 0114(004A)]",
  "\u8BF4\u8D77\u6765\uFF0C\u4E0D\u77E5\u9053\u4E3A\u5565\uFF0C\\n\u7D2B\u7AFD\u5979\u53EA\u5728\u53EB\u6211\u540D\u5B57\u65F6\u53E3\u6C14\u5F88\u51B2\u3002\\r\\n\u2026\u2026\u548B\u56DE\u4E8B\uFF1F[VAR 0114(004A)]",
  "\u5BF9\u4E86\u2026\u2026\u7ED9\u4F60\uFF0C\\n\u8FD9\u662F\u8BF4\u597D\u7684\u4E1C\u897F\u3002[VAR 0114(004A)]",
  "\u6709\u70B9\u843D\u7070\u4E86\uFF0C\\n\u522B\u4ECB\u610F\u3002[VAR 0114(004A)]",
  "\u611F\u89C9\u4F60\u6216\u8BB8\u80FD\\n\u5728\u8054\u76DF\u793E\u6380\u8D77\u98CE\u6D6A\u3002[VAR 0114(004A)]",
  "\u2026\u2026\u90A3\u597D\uFF5E[VAR 0114(004A)]",
  "\u8FD8\u5269\u4E09\u5929\u738B\uFF0C\\n\u597D\u597D\u52A0\u6CB9\u5427\uFF5E[VAR 0114(004A)]"
]
