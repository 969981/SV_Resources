[
  "\u4ECA\u5929\u4E5F\u8981\u7CBE\u529B\u5145\u6C9B\u5730\u5B66\u4E60\u5BF9\u6218\u5B66\uFF01\\n\u563F\u5440\uFF01\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01[VAR 0114(0024)]",
  "\u4E4B\u524D\u6211\u6559\u7684\u81EA\u4E3B\u5BF9\u6218\uFF01\\n\u5404\u4F4D\u540C\u5B66\u53BB\u5C1D\u8BD5\u4E86\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u8981\u662F\u80FD\u719F\u7EC3\u638C\u63E1\u81EA\u4E3B\u5BF9\u6218\uFF0C\\n\u5C31\u80FD\u8BA9\u5B9D\u53EF\u68A6\u5F97\u5230\u5927\u5E45\u6210\u957F\uFF0C\u800C\u4E14\u2026\u2026[VAR 0114(0024)]",
  "\u8FD8\u53EF\u4EE5\u9760\u5B83\u6709\u6548\u5730\u6536\u96C6\u80FD\u591F\u7528\u5728\\n\u62DB\u5F0F\u5B66\u4E60\u5668\u673A\u7684\u5B9D\u53EF\u68A6\u7684\u6389\u843D\u7269\uFF01[VAR 0114(0024)]",
  "\u8BF4\u5230\u62DB\u5F0F\u5B66\u4E60\u5668\u673A\uFF01\\n\u5404\u4F4D\u540C\u5B66\u6709\u5728\u4F7F\u7528\u5B83\u5417\uFF1F[VAR 0114(0024)]",
  "\u90A3\u4E48\uFF0C\u6211\u8981\u6765\u8003\u4E00\u8003\u4F60\u4EEC\uFF01[VAR 0114(0024)]",
  "\u5728\u5236\u4F5C\u62DB\u5F0F\u5B66\u4E60\u5668\u65F6\uFF0C\\n\u9664\u4E86\u5B9D\u53EF\u68A6\u7684\u6389\u843D\u7269\u4E4B\u5916\uFF0C\\r\\n\u540C\u5B66\u4EEC\u8BB0\u5F97\u8FD8\u9700\u8981\u54EA\u4E00\u79CD\u4E1C\u897F\u5417\uFF1F[VAR 0114(0024)]",
  "\uFF2C\uFF30",
  "\uFF28\uFF30",
  "\u94B1",
  "\u8F6C\u5B66\u751F\uFF01\\n\u770B\u6765\u4F60\u5DF2\u7ECF\u5C06\u5B83\u8FD0\u7528\u81EA\u5982\u4E86\uFF01[VAR 0114(0024)]",
  "\u5582\u5582\u5582\uFF0C\u8F6C\u5B66\u751F\uFF01\\n\u4F60\u8BF4\u8981\u732E\u51FA\uFF28\uFF30\uFF1F\\r\\n\u624D\u6CA1\u6709\u8FD9\u79CD\u7C7B\u4F3C\u4EEA\u5F0F\u7684\u4E8B\u54E6\uFF01[VAR 0114(0024)]",
  "\u53EF\u60DC\u54E6\uFF0C\u8F6C\u5B66\u751F\uFF01\\n\u4E16\u4E0A\u5E76\u4E0D\u662F\u6BCF\u4EF6\u4E8B\\r\\n\u90FD\u53EF\u4EE5\u7528\u94B1\u6765\u89E3\u51B3\u7684\u54E6\uFF01[VAR 0114(0024)]",
  "\u7B54\u6848\u662F\u8054\u76DF\u652F\u4ED8\u70B9\uFF01\\n\u4E5F\u5C31\u662F\uFF2C\uFF30\uFF01[VAR 0114(0024)]",
  "\uFF2C\uFF30\u53EF\u4EE5\u5728\u62DB\u5F0F\u5B66\u4E60\u5668\u673A\\n\u7528\u5B9D\u53EF\u68A6\u7684\u6389\u843D\u7269\u6765\u5151\u6362\u54E6\uFF01[VAR 0114(0024)]",
  "\u6700\u8FD1\u542C\u8BF4\u6709\u4E9B\u9A87\u5BA2\\n\u8FD9\u7C7B\u4E0D\u8096\u4E4B\u5F92\u4F1A\u9A87\u8FDB\u7CFB\u7EDF\\r\\n\u4EE5\u4E0D\u5F53\u624B\u6BB5\u6765\u83B7\u53D6\uFF2C\uFF30\u2026\u2026[VAR 0114(0024)]",
  "\u5404\u4F4D\u540C\u5B66\u53EF\u5343\u4E07\u4E0D\u8981\\n\u53BB\u6CBE\u67D3\u8FD9\u6837\u7684\u574F\u4E8B\u554A\uFF01[VAR 0114(0024)]",
  "\u53EA\u8981\u628A\u4F60\u60F3\u5236\u4F5C\u7684\\n\u62DB\u5F0F\u5B66\u4E60\u5668\u6DFB\u52A0\u4E3A\u5173\u6CE8\uFF0C\\r\\n\u5C31\u80FD\u968F\u65F6\u67E5\u770B\u6389\u843D\u7269\u7684\u6536\u96C6\u60C5\u51B5\uFF01[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u60F3\u8981\u5236\u4F5C\u62DB\u5F0F\u5B66\u4E60\u5668\u7684\u8BDD\uFF0C\\n\u5B9D\u53EF\u68A6\u7684\u6389\u843D\u7269\u662F\u4E0D\u53EF\u6216\u7F3A\u7684\uFF01[VAR 0114(0024)]",
  "\u4E0E\u5B9D\u53EF\u68A6\u5BF9\u6218\u5BF9\u6218\u518D\u5BF9\u6218\uFF0C\\n\u6536\u96C6\u5927\u91CF\u7684\u6389\u843D\u7269\u5427\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u4E48\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u7CBE\u529B\u5145\u6C9B\u6BCF\u4E00\u5929\uFF01[VAR 0114(0024)]"
]
