[
  "[VAR 0100(0000)]\uFF01\\n\u65F6\u673A\u5230\u6765\u4E86\uFF01[VAR 0114(0027)]",
  "\u88AB\u8BC5\u5492\u7684\u707E\u7978\u4E4B\u5B9D\uFF0C\\n\u90A3\uFF14\u53EA\u5B9D\u53EF\u68A6\u2026\u2026[VAR 0114(0027)]",
  "\u662F\u771F\u5B9E\u5B58\u5728\u7684\uFF01\uFF01[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF01\u6CA1\u60F3\u5230\u662F\u62A5\u7EB8\uFF01\uFF01\\n\u7ADF\u7136\u5728\u6728\u5320\u7684\u91C7\u8BBF\u62A5\u9053\u91CC\\r\\n\u5BFB\u89C5\u5230\u4E86\u771F\u76F8\uFF01\uFF01[VAR 0114(0027)]",
  "\u636E\u8BF4\u5B9D\u53EF\u68A6\u4F7F\u8005\u7528\u795E\u5723\u7684\u6869\u5B50\uFF0C\\n\u5C06\u707E\u7978\u4E4B\u5B9D\u4EEC\u5C01\u5370\u5728\u4E86\u7960\u91CC\u3002[VAR 0114(0027)]",
  "\uFF11\u53EA\u5B9D\u53EF\u68A6\u5BF9\u5E94\uFF11\u5EA7\u7960\u2026\u2026\\n\u636E\u8BF4\u5728\u90A3\u4E9B\u5730\u65B9\u6253\u4E0A\u4E86\uFF18\u6839\u6869\u5B50\uFF0C\\r\\n\u7528\u6765\u6291\u5236\u707E\u7978\u4E4B\u529B\u3002[VAR 0114(0027)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\\n\u53EA\u8981\u62D4\u6389\u6240\u6709\u76F8\u5E94\u7684\u6869\u5B50\uFF01[VAR 0114(0027)]",
  "\u5C31\u80FD\u89E3\u653E\u88AB\u79F0\u4E3A\\n\u707E\u7978\u4E4B\u5B9D\u7684\u5B9D\u53EF\u68A6\uFF01\uFF01[VAR 0114(0027)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u4E0D\u60F3\u89E3\u653E\\n\u88AB\u5C01\u5370\u5728\u72ED\u7A84\u7684\u7960\u91CC\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8BA9\u4ED6\u4EEC\u5230\u5916\u9762\u6765\u5417\uFF1F[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C\u591A\u4E48\u5584\u826F\u7684\u5B69\u5B50\uFF0C\\n\u771F\u662F\u592A\u80FD\u5E72\u4E86\uFF01[VAR 0114(0027)]",
  "\u6CA1\u60F3\u5230\u4F60\u8FD9\u4E48\u51B7\u6F20\u554A\uFF01\\n\u597D\u5566\u4E0D\u8981\u8FD9\u4E48\u8BF4\uFF0C\u8FD8\u662F\u53BB\u5E2E\u5B83\u4EEC\u5427\uFF01[VAR 0114(0027)]",
  "\u636E\u5B9D\u53EF\u68A6\u4F7F\u8005\u7684\u540E\u4EBA\u6240\u8BF4\uFF0C\\n\u8981\u60F3\u62D4\u6389\u6869\u5B50\uFF0C\\r\\n\u5C31\u9700\u8981\u6709\u548C\u5B9D\u53EF\u68A6\u4E4B\u95F4\u7684\u7275\u7ECA\u2026\u2026[VAR 0114(0027)]",
  "\u5982\u679C\u662F\u50CF\u4F60\u8FD9\u6837\u64C5\u957F\\n\u4F7F\u7528\u5B9D\u53EF\u68A6\u7684\u4EBA\uFF0C\u5C31\u6709\u53EF\u80FD\u505A\u5230\u3002[VAR 0114(0027)]",
  "\u4FE1\u4E0D\u4FE1\u7531\u4F60\uFF0C\u4F46\u6211\u4F1A\u5728\\n\u5730\u56FE\u4E0A\u4E3A\u4F60\u6807\u8BB0\u597D\u7960\u7684\u4F4D\u7F6E\u3002[VAR 0114(0027)]",
  "\u539F\u672C\u6211\u60F3\u81EA\u5DF1\u53BB\u7684\uFF0C\\n\u4F46\u662F\u6211\u4E4B\u524D\u65F7\u8BFE\u5230\u5904\u53BB\u5192\u9669\uFF0C\\r\\n\u7ED3\u679C\u88AB\u6821\u957F\u76EF\u4E0A\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u5475\u5475\uFF0C\u67D0\u79CD\u610F\u4E49\u4E0A\u4E5F\u662F\u5BFB\u5B9D\u5427\uFF0C\\n\u53EA\u4E0D\u8FC7\u662F\u5BFB\u707E\u7978\u4E4B\u5B9D\u2026\u2026\\r\\n\u7B49\u4F60\u6709\u5174\u8DA3\u4E86\uFF0C\u5E2E\u6211\u8C03\u67E5\u4E00\u4E0B\u5427\u3002[VAR 0114(0027)]",
  "\u611F\u53D7\u5230\u4E86\\n\u857E\u8377\u8001\u5E08\u7684\u4FE1\u8D56\uFF01"
]
