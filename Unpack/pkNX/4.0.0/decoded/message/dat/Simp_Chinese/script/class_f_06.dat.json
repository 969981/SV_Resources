[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8BF7\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u54CE\u5440\u54CE\u5440\uFF0C\\n\u4E0A\u6B21\u771F\u662F\u4E0D\u597D\u610F\u601D\u4E86\u3002[VAR 0114(0012)]",
  "\u5C0F\u751F\u611F\u52A8\u5F97\u53F7\u5555\u5927\u54ED\uFF0C\\n\u8BA9\u5404\u4F4D\u540C\u5B66\u4EEC\u89C1\u7B11\u4E86\u3002[VAR 0114(0012)]",
  "\u90A3\u4E4B\u540E\u5C0F\u751F\u88AB\u6CF0\u59C6\u8001\u5E08\\n\u72E0\u72E0\u5730\u51F6\u4E86\u4E00\u987F\u2026\u2026[VAR 0114(0012)]",
  "\u597D\u4E86\uFF0C\u5C31\u8BA9\u6211\u4EEC\u91CD\u65B0\u6253\u8D77\u7CBE\u795E\uFF0C\\n\u5F00\u59CB\u4ECA\u5929\u7684\u8BFE\u7A0B\u5427\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B66\u662F\u5426\u542C\u8FC7\\n\u5E15\u5E95\u4E9A\u5341\u666F\u5462\uFF1F[VAR 0114(0012)]",
  "\u6B63\u5982\u5176\u540D\uFF0C\\n\u662F\u5E15\u5E95\u4E9A\u5730\u533A\u88AB\u6311\u9009\u51FA\u6765\u7684\\r\\n\uFF11\uFF10\u5904\u7F8E\u4E3D\u7684\u666F\u70B9\u3002[VAR 0114(0012)]",
  "\u5176\u4E2D\u53EF\u4EE5\u8F7B\u677E\u9020\u8BBF\u7684\\n\u5C31\u662F[VAR FF00(0006)]\u6A44\u6984\u5927\u519C\u56ED[VAR FF00(0000)]\u5427\u3002[VAR 0114(0012)]",
  "\u5728\u524D\u5F80\u5706\u6A21\u9547\u9014\u4E2D\u7684\\n\u4E18\u9675\u5730\u53EF\u4EE5\u671B\u89C1\u5E7F\u9614\u7684\u6A44\u6984\u56ED\uFF0C\\r\\n\u90A3\u5C31\u662F\u6A44\u6984\u5927\u519C\u56ED\u4E86\u3002[VAR 0114(0012)]",
  "\u88AB\u9009\u4E0A\u7684\u7011\u5E03\u6709\uFF12\u5904\u3002\\n\u4E5F\u5C31\u662F[VAR FF00(0006)]\u4E71\u51FB\u7011\u5E03[VAR FF00(0000)]\uFF0C\\r\\n\u4EE5\u53CA[VAR FF00(0006)]\u5927\u9505\u5927\u7011\u5E03[VAR FF00(0000)]\u3002[VAR 0114(0012)]",
  "\u5728\u8FD9\u4E2A\u5730\u533A\u6D77\u62D4\u6700\u9AD8\u7684\\n\u971C\u62B9\u5C71\u5C71\u9876\u662F[VAR FF00(0006)]\u5E15\u5E95\u4E9A\u6700\u9AD8\u5CF0[VAR FF00(0000)]\u3002[VAR 0114(0012)]",
  "\u540C\u6837\u5728\u971C\u62B9\u5C71\u7684\u8FD8\u6709\u4E00\u5904\u60AC\u5D16\uFF0C\\n\u5B83\u7684\u540D\u5B57\u6765\u6E90\u4E8E\u60AC\u5D16\u7684\u5F62\u72B6\u3002[VAR 0114(0012)]",
  "\u90A3\u4E48\uFF0C\u8BA9\u5C0F\u751F\u6765\u95EE\u95EE\u5404\u4F4D\u540C\u5B66\u5427\uFF01[VAR 0114(0012)]",
  "\u63D0\u793A\uFF0C\u7B54\u6848\u662F\u8EAB\u4F53\u7684\u67D0\u4E2A\u90E8\u4F4D\u3002\\n\u6709\u5EA7\u4F4D\u4E8E\u971C\u62B9\u5C71\u7684\u4E09\u5C94\u60AC\u5D16\uFF0C\\r\\n\u8BF7\u95EE\u5B83\u7684\u540D\u5B57\u662F\u971C\u62B9\u4E4B\u2026\u2026\uFF1F[VAR 0114(0012)]",
  "\u624B",
  "\u8033\u6735",
  "\u5C3E\u5DF4",
  "[VAR 0100(0000)]\uFF01\\n\u4F60\u7684\u60F3\u8C61\u529B\u771F\u68D2\uFF01[VAR 0114(0012)]",
  "\u4E09\u5C94\u7684\u8033\u6735\u2026\u2026\\n\u5982\u679C\u662F\u5173\u4E8E\u5409\u5229\u86CB\u8FD9\u79CD\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\r\\n\u6216\u8BB8\u5C31\u662F\u6B63\u786E\u7B54\u6848\u4E86\u5462\u3002[VAR 0114(0012)]",
  "\u4E09\u5C94\u7684\u5C3E\u5DF4\u2026\u2026\\n\u5982\u679C\u662F\u5173\u4E8E\u80AF\u6CF0\u7F57\u8FD9\u79CD\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\r\\n\u6216\u8BB8\u5C31\u662F\u6B63\u786E\u7B54\u6848\u4E86\u5462\u3002[VAR 0114(0012)]",
  "\u971C\u62B9\u5C71\u6709\u5904\u88AB\u79F0\u4E3A\\n[VAR FF00(0006)]\u971C\u62B9\u4E4B\u624B[VAR FF00(0000)]\u7684\u4E09\u5C94\u60AC\u5D16\u3002[VAR 0114(0012)]",
  "\u4F46\u8981\u8BF4\u90A3\u662F\u624B\u6307\u2026\u2026\\n\u5F62\u72B6\u53C8\u5B9E\u5728\u592A\u7C97\u592A\u77ED\uFF0C\\r\\n\u5B83\u6BD4\u55BB\u7684\u5927\u6982\u662F\u67D0\u79CD\u5B9D\u53EF\u68A6\u7684\u624B\u5427\u3002[VAR 0114(0012)]",
  "\u6B64\u5916\uFF0C\u4ECE\u4E1C\u7B2C\uFF13\u533A\u7684\u9AD8\u5C71\u5730\u5E26\\n\u53EF\u4EE5\u5C06\u917F\u5149\u5E02\u7684\u591C\u666F\u5C3D\u6536\u773C\u5E95\u3002[VAR 0114(0012)]",
  "\u4ECE\u90A3\u91CC\u770B\u5230\u7684\u666F\u8272\\n\u88AB\u79F0\u4E3A[VAR FF00(0006)]\u767E\u4E07\u4F0F\u7279\u591C\u666F[VAR FF00(0000)]\u5462\u3002[VAR 0114(0012)]",
  "\u636E\u8BF4\u90A3\u91CC\u662F\u70ED\u604B\u60C5\u4FA3\\n\u7231\u53BB\u7684\u70ED\u95E8\u666F\u70B9\u3002[VAR 0114(0012)]",
  "\u501F\u7528\u4E00\u4E0B\u5E74\u8F7B\u4EBA\u7684\u8BDD\uFF0C\\n\u5C31\u662F\u80FD\u62CD\u51FA\u7F51\u7EA2\u98CE\u7684\u7F8E\u7167\u2026\u2026\u5427\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u867D\u7136\u53F7\u79F0\u662F\u5341\u5927\u666F\u70B9\uFF0C\\n\u4F46\u4E16\u754C\u4E0A\u4E5F\u5B58\u5728\u7740\u8BB8\u591A\u89C2\u5149\u666F\u70B9\\r\\n\u4F1A\u8BA9\u4EBA\u5728\u5B9E\u9645\u9020\u8BBF\u540E\u5931\u671B\u800C\u5F52\u3002[VAR 0114(0012)]",
  "\u5C0F\u751F\u4E0D\u662F\u8981\u963B\u6B62\u5404\u4F4D\u524D\u5F80\uFF0C\\n\u53EA\u662F\u5E0C\u671B\u540C\u5B66\u4EEC\u4E0D\u8981\u62B1\u6709\u8FC7\u5927\u7684\u671F\u671B\u3002[VAR 0114(0012)]",
  "\u91CD\u8981\u7684\u662F\u4EB2\u81EA\u524D\u5F80\u5F53\u5730\uFF0C\\n\u4EB2\u773C\u786E\u8BA4\u4E8B\u5B9E\u3002[VAR 0114(0012)]",
  "\u4F53\u9A8C\u4E00\u4E0B\u5931\u671B\u4E0D\u4E5F\u633A\u597D\u5417\uFF1F\\n\u2026\u2026\u656C\u8BF7\u8BA9\u81EA\u5DF1\u88AB\u9A97\u4E00\u9A97\u5427\u3002[VAR 0114(0012)]",
  "\u4ECA\u5929\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\uFF01\\n\u611F\u8C22\u5404\u4F4D\uFF01[VAR 0114(0012)]"
]
