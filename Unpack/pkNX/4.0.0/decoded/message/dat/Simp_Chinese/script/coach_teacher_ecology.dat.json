[
  "\u4F60\u597D\u5440\uFF5E\u4F60\u597D\uFF5E[VAR 0114(002A)]",
  "\u6211\u6765\u81EA\u5B66\u9662\uFF0C\\n\u662F\u8D1F\u8D23\u6559\u751F\u7269\u7684\u5409\u5C3C\u4E9A\uFF5E[VAR 0114(002A)]",
  "\u54C7\uFF5E[VAR 0100(0000)]\u3002\\n\u6700\u8FD1\u6211\u4EEC\u603B\u662F\u89C1\u9762\u554A\uFF5E[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u4F60\u73B0\u5728\\n\u662F\u5728\u8FD9\u8FB9\u4EA4\u6362\u7559\u5B66\uFF0C\u5BF9\u5427\uFF5E\uFF1F[VAR 0114(002A)]",
