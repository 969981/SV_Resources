  "\u2026\u2026\u6539\u5F97\u5F88\u597D\u554A\u3002\\n\u8C22\u8C22\u4F60\u544A\u8BC9\u6211\uFF5E[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u597D\u5440\uFF5E[VAR 0114(002A)]",
  "\u6211\u4E5F\u628A\u84DD\u8393\u56FE\u9274\\n\u52A0\u8FDB\u56FE\u9274App\u4E86\uFF5E[VAR 0114(002A)]",
  "\u592A\u597D\u4E86\uFF01",
  "\u6211\u4EEC\u4E00\u6837\u4E86\uFF01",
  "\u662F\u7684\uFF5E\uFF01\u800C\u4E14\u84DD\u8272\u7684\u8BBE\u8BA1\\n\u4E5F\u5F88\u5E05\u6C14\uFF5E[VAR 0114(002A)]",
  "\u563B\u563B\u2026\u2026\\n\u6211\u4EEC\u53D8\u4E00\u6837\u4E86\uFF5E[VAR 0114(002A)]",
  "\u6211\u60F3\u5B8C\u6210\u56FE\u9274\uFF0C\\n\u4E8E\u662F\u5C31\u5728\u751F\u6001\u5DE8\u86CB\u91CC\u5230\u5904\u901B\uFF0C\\r\\n\u771F\u662F\u975E\uFF5E\u5E38\u4EE4\u6211\u6FC0\u52A8\u554A\uFF5E[VAR 0114(002A)]",
  "\u503C\u5F97\u5173\u6CE8\u7684\u662F\u5DE8\u86CB\u7684\u8BBE\u8BA1\uFF01\\n\u60F3\u51FA\u6765\u7684\u4EBA\u5B9E\u5728\u662F\u592A\u5389\u5BB3\u4E86\uFF5E[VAR 0114(002A)]",
  "\u5404\u79CD\u5404\u6837\u7684\u5B9D\u53EF\u68A6\\n\u90FD\u8212\u8212\u670D\u670D\u5730\u751F\u6D3B\u5728\u8FD9\u91CC\u3002[VAR 0114(002A)]",
  "\u5982\u679C\u4E0D\u662F\u8DB3\u591F\u4E86\u89E3\u5B9D\u53EF\u68A6\u7684\u751F\u6001\uFF0C\\n\u662F\u505A\u4E0D\u51FA\u8FD9\u6837\u7684\u8BBE\u8BA1\u7684\uFF5E[VAR 0114(002A)]",
  "\u770B\u6765\u76F4\u5230\u5B8C\u6210\u56FE\u9274\u4E3A\u6B62\uFF0C\\n\u5FC5\u987B\u5F97\u5E38\uFF5E\u5E38\u5230\u5DE8\u86CB\u6765\u624D\u884C\u5440\uFF5E[VAR 0114(002A)]",
  "\u8981\u6536\u96C6\u56FE\u9274\uFF0C\\n\u4EA4\u6362\u5B9D\u53EF\u68A6\u4E5F\u662F\u4E00\u79CD\u597D\u65B9\u6CD5\uFF5E[VAR 0114(002A)]",
  "\u673A\u4F1A\u96BE\u5F97\uFF0C\\n\u4F60\u8981\u4E0D\u8981\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\u5462\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u6211\u597D\u9AD8\u5174\u554A\uFF5E\\n\u90A3\u6211\u5C31\u9009\u6EB6\u98DF\u517D\u54AF\uFF5E\\r\\n[VAR 0100(0000)]\uFF0C\u4F60\u5462\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u4F60\u9009[VAR 0101(0001)]\u554A\uFF0C\u771F\u6709\u610F\u601D\uFF5E\\n\u5B83\u53EF\u662F\u9B45\u529B\u5341\u8DB3\u7684\u5B9D\u53EF\u68A6\uFF5E\\c\\n\u771F\u7684\u5F88\u8C22\u8C22\u4F60\\n\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\uFF5E[VAR 0114(002A)]",
  "\u90A3\u5C31\u7528[VAR 0100(0000)]\u7684[VAR 0101(0001)]\u548C\\n\u6211\u7684\u6EB6\u98DF\u517D\u4EA4\u6362\uFF0C\u786E\u5B9A\u5417\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u540C\u884C\u5B9D\u53EF\u68A6\u53EA\u6709\uFF11\u53EA\u7684\u8BDD\uFF0C\\n\u662F\u65E0\u6CD5\u4EA4\u6362\u7684\u54E6\uFF5E\\c\\n\u7B49\u4F60\u5E26\u7740\uFF12\u53EA\u4EE5\u4E0A\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u6211\u4EEC\u518D\u6765\u4EA4\u6362\u5427\uFF5E[VAR 0114(002A)]",
  "\u4F60\u53EF\u4EE5\u6162\u6162\u8003\u8651\uFF0C\\n\u4E0D\u7740\u6025\u7684\uFF5E[VAR 0114(002A)]",
  "\u54C7\u54E6\uFF5E[VAR 0100(0000)]\uFF0C\\n\u4F60\u8981\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\u5417\uFF5E\uFF1F[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\u770B\u4F60\u8FD9\u8868\u60C5\uFF0C\\n\u5E94\u8BE5\u662F\u60F3\u5BF9\u6218\u60F3\u5230\u5FC3\u75D2\u75D2\u4E86\u5427\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u54A6\uFF1F\u4E0D\u597D\u610F\u601D\uFF5E\\n\u662F\u6211\u641E\u9519\u4E86\uFF5E[VAR 0114(002A)]",
  "\u5F53\u7136\u6CA1\u95EE\u9898\u4E86\uFF5E\uFF01\\c\\n\u5076\u5C14\u80FD\u5728\u4F60\u9762\u524D\\n\u597D\u597D\u8868\u73B0\u4E00\u4E0B\u4E5F\u4E0D\u9519\u5440\uFF5E\uFF01[VAR 0114(002A)]",
  "[~ 62]",
  "\u563B\u563B\uFF0C\u771F\u670D\u4E86\u4F60\uFF5E\\n\u6211\u4E0D\u662F[VAR 0100(0000)]\u4F60\u7684\u5BF9\u624B\u5440\uFF5E[VAR 0114(002A)]",
  "\u6211\u771F\u7684\u975E\uFF5E\u5E38\u559C\u6B22\\n\u770B\u5230[VAR 0100(0000)]\u4F60\u7684\u6210\u957F\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u540E\u6211\u4E5F\u4F1A\u65F6\u65F6\u523B\uFF5E\u523B\\n\u90FD\u4E3A\u4F60\u52A0\u6CB9\u7684\uFF5E[VAR 0114(002A)]",
  "\u554A\uFF0C\u53EF\u4EE5\u7684\u8BDD\u8BF7\u6536\u4E0B\u8FD9\u4E2A\uFF0C\\n\u662F\u548C\u6211\u540C\u6B3E\u7684\u773C\u955C\uFF5E[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u4ECE\u5409\u5C3C\u4E9A\u8001\u5E08\u90A3\u91CC\\n\u83B7\u5F97\u4E86[VAR FF00(0008)]\u516D\u8FB9\u5F62\u773C\u955C\uFF08\u73B3\u7441\u82B1\u7EB9\uFF09[VAR FF00(0000)]\uFF01",
  "\u563B\u563B\uFF0C\u6211\u8F93\u4E86\uFF5E\\n\u4F60\u771F\u7684\u5F88\u5389\u5BB3\u554A\uFF5E[VAR 0114(002A)]",
  "\u5982\u679C\u4F60\u8FD8\u613F\u610F\u7684\u8BDD\uFF0C\\n\u5C31\u968F\u65F6\u6765\u627E\u6211\u5427\uFF5E[VAR 0114(002A)]",
  "\u6211\u5076\u5C14\u4E5F\u662F\\n\u4F1A\u52AA\u529B\u4E00\u628A\u7684\uFF5E\\c\\n\u5982\u679C\u8001\u5E08\u6211\u8868\u73B0\u5F97\u8FD8\u4E0D\u9519\uFF0C\\n\u90A3\u5C31\u592A\u597D\u4E86\uFF5E[VAR 0114(002A)]",
  "\u751F\u6001\u5DE8\u86CB\u771F\u662F\\n\u975E\uFF5E\u5E38\u6709\u610F\u601D\uFF5E\\c\\n\u6709\u597D\u591A\u5728\u5E15\u5E95\u4E9A\\n\u89C1\u4E0D\u5230\u7684\u5B9D\u53EF\u68A6\u554A\uFF5E[VAR 0114(002A)]",
  "\u6700\u8FD1\u6211\u80FD\u5728\u5404\u4E2A\u5730\u533A\u6765\u5F80\uFF0C\\n\u771F\u7684\u5F88\u5F00\u5FC3\uFF5E\\c\\n\u79FB\u52A8\u65F6\u53EA\u8981\u53D1\u4E00\u4F1A\u513F\u5446\uFF0C\\n\u5C31\u7ACB\u523B\u80FD\u5230\u76EE\u7684\u5730\uFF0C\u8F7B\u677E\u5F97\u5F88\uFF5E[VAR 0114(002A)]",
  "\u6211\u7ADF\u7136\u7A7F\u7740\u51C9\u978B\\n\u5C31\u6765\u4E86\u522B\u4EBA\u7684\u5B66\u6821\uFF5E\\c\\n\u8981\u662F\u88AB\u514B\u62C9\u97E6\u5C14\u6821\u957F\u770B\u5230\uFF0C\\n\u6211\u53EF\u80FD\u53C8\u8981\u6328\u9A82\u4E86\uFF5E[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u7684[VAR 0101(0001)]\\n\u662F\u975E\uFF5E\u5E38\u6709\u4E2A\u6027\u7684\u5B9D\u53EF\u68A6\uFF5E\uFF01\\r\\n\u6211\u5F88\u671F\u5F85\u5B83\u7684\u6210\u957F\uFF5E[VAR 0114(002A)]",
  "\u6211\u4EA4\u6362\u7ED9\u4F60\u7684\u6EB6\u98DF\u517D\\n\u53EF\u662F\u4E2A\u5F88\u6709\u610F\u601D\u7684\u5B69\u5B50\u54E6\uFF5E\uFF01\\c\\n\u56E0\u4E3A\u5B83\u662F\u8D2A\u5403\u9B3C\uFF0C\\n\u6240\u4EE5\u4F1A\u65E9\u65E9\u5C31\u628A\u6811\u679C\u5403\u6389\u3002[VAR 0114(002A)]"
