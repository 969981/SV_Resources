  "\u54C7\uFF5E\\n\u90A3\u771F\u662F\u592A\u4EE4\u6211\u9AD8\u5174\u4E86\uFF5E\\c\\n\u4F60\u5728\u8FD9\u8FB9\u4E5F\u5728\u52AA\u529B\\n\u563F\u5440\u5730\u6254\u7403\u51FA\u53BB\u554A\uFF01\\r\\n\u2026\u2026\u662F\u8FD9\u4E2A\u610F\u601D\u5427\uFF5E\uFF01[VAR 0114(002A)]",
  "\u54C7\uFF5E\u4F60\u4EA4\u5230\u5F88\u591A\\n\u65B0\u670B\u53CB\u4E86\u5417\uFF5E\uFF1F\\c\\n\u4E0B\u6B21\u4E00\u5B9A\u8981\u628A\u4ED6\u4EEC\\n\u4E5F\u4ECB\u7ECD\u7ED9\u8001\u5E08\u6211\u8BA4\u8BC6\u554A\uFF5E[VAR 0114(002A)]",
  "\u548C\u590F\u4EE4\u8425\u4E0D\u540C\uFF0C\\n\u8FD9\u6B21\u4F60\u662F\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u6765\u7559\u5B66\u3002\\r\\n\u6211\u672C\u6765\u8FD8\u633A\u62C5\u5FC3\u4F60\u7684\u2026\u2026[VAR 0114(002A)]",
  "\u4F46\u662F[VAR 0100(0000)]\u4F60\u770B\u8D77\u6765\u8FC7\u5F97\u5F88\u5F00\u5FC3\uFF0C\\n\u771F\u662F\u592A\u597D\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u5BF9\u4E86\uFF0C[VAR 0100(0000)]\u3002\\n\u4F60\u5728\u751F\u6001\u5DE8\u86CB\u7528\u7684\u662F\\r\\n\u4EC0\u4E48\u6837\u7684\u56FE\u9274App\u5462\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u84DD\u8393\u56FE\u9274\uFF01",
  "\u4F60\u8981\u770B\u770B\u5417\uFF1F",
  "\u54C7\uFF5E\uFF01\u8FD9\u96BE\u9053\u662F\u6539\u826F\u4E86\\n\u6211\u7684\u56FE\u9274App\uFF5E\uFF01\uFF1F[VAR 0114(002A)]",
  "\u6211\u7684App\u662F\u5F00\u653E\u6E90\u4EE3\u7801\u7684\uFF0C\\n\u56E0\u6B64\u53EF\u4EE5\u81EA\u7531\u5730\u6DFB\u52A0\u8981\u7D20\u2026\u2026[VAR 0114(002A)]",
  "\u505A\u51FA\u8FD9\u4E2A\u84DD\u8393\u56FE\u9274\u7684\u4EBA\u2026\u2026\\n\u662F\u53EB\u5E2D\u84DD\uFF1F[VAR 0114(002A)]",
  "\u54A6\uFF5E\uFF1F\u8FD9\u4E2A\u4EBA\u5199\u4EE3\u7801\u7684\u98CE\u683C\u548C\\n\u514B\u62C9\u97E6\u5C14\u6821\u957F\u5F88\u50CF\u554A\uFF5E[VAR 0114(002A)]",
