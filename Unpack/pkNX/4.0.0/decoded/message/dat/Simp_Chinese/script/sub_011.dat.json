  "\u6211\u9700\u8981\uFF15\uFF10\u4E2A\u592A\u6676\u788E\u5757\uFF01\\n\u2026\u2026\u597D\u50CF\u4E0D\u592A\u591F\u554A\uFF01",
  "\u6211\u4F1A\u5236\u4F5C\u7279\u522B\u7684\u6599\u7406\uFF0C\\n\u6765\u5E2E\u4F60\u8F6C\u6362\u5B9D\u53EF\u68A6\u7684\u592A\u6676\u5C5E\u6027\uFF01\\c\\n\u6599\u7406\u9700\u8981\uFF15\uFF10\u4E2A\u592A\u6676\u788E\u5757\u4F5C\u4E3A\u6750\u6599\uFF0C\\n\u4F60\u53BB\u6536\u96C6\u4E00\u4E0B\u5427\u3002",
  "\u8981\u7ED9\u54EA\u53EA\u5B9D\u53EF\u68A6\u5403\uFF1F",
  "\u786E\u5B9A\u8981\u5C06[VAR 0102(0002)]\\n\u8F6C\u6362\u4E3A[VAR 0103(0003)]\u5C5E\u6027\u5417\uFF1F",
  "\u6539\u53D8\u4EBA\u751F\u7684\u6599\u7406\uFF01\\n\u5C31\u7531\u6211\u4E3A\u4F60\u5236\u4F5C\uFF0C\u8BF7\u7A0D\u7B49\uFF01",
  "[VAR 0102(0002)]\u7684\u592A\u6676\u5C5E\u6027\\n\u5DF2\u7ECF\u662F[VAR 0103(0003)]\u5C5E\u6027\u4E86\u54E6\uFF01",
  "[VAR 0102(0002)]\u7684\u592A\u6676\u5C5E\u6027\\n\u8F6C\u6362\u4E3A[VAR 0103(0003)]\u5C5E\u6027\u4E86\uFF01",
  "\u5982\u679C\u8FD8\u60F3\u8F6C\u6362\u7684\u8BDD\uFF0C\\n\u5C31\u5E26\u592A\u6676\u788E\u5757\u8FC7\u6765\u5427\uFF01",
  "\u86CB\u5FC5\u987B\u5148\u5B75\u51FA\u6765\u624D\u884C\uFF01\\n\u2026\u2026\u6BD4\u8D77\u8F6C\u6362\uFF0C\u8981\u5148\u4ECE\u5934\u5F00\u59CB\u54E6\uFF01",
