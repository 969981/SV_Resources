  "\u591A\u4E8F\u4E86\u4F60\uFF0C\u5B9D\u53EF\u68A6\u7684\u8C03\u67E5\\n\u6B63\u5728\u4E0D\u65AD\u8FDB\u5C55\uFF5E[VAR 0114(002A)]",
  "\u4F5C\u4E3A\u8C22\u793C\uFF0C\\n\u8BF7\u6536\u4E0B\u8FD9\u4E2A\u5427\uFF5E[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u771F\u662F\u6355\u6349\u5B9D\u53EF\u68A6\u7684\u5929\u624D\uFF5E[VAR 0114(002A)]",
  "\u4E0B\u4E00\u4E2A\u76EE\u6807\u662F\u6536\u96C6\uFF12\uFF10\uFF10\u79CD\u5B9D\u53EF\u68A6\uFF5E\uFF01[VAR 0114(002A)]",
  "\u867D\u7136\u8D8A\u6765\u8D8A\u8270\u96BE\u4E86\uFF0C\\n\u4F46\u8FD8\u662F\u8981\u51C6\u5907\u597D\u7403\uFF0C\u563F\u5440\u4E00\u4E0B\uFF01\\r\\n\u2026\u2026\u5C31\u4EE5\u8FD9\u6837\u7684\u7CBE\u795E\u52A0\u6CB9\u5427\uFF5E[VAR 0114(002A)]"
