  "\u54C7\uFF5E\u54C7\uFF5E\uFF01\\n\u6709\u5C0F\u7684\u5B9D\u53EF\u68A6\uFF0C\u8FD8\u6709\u5927\u7684\u5B9D\u53EF\u68A6\uFF01\\r\\n\u554A\uFF0C\u8FDE\u8FD9\u79CD\u5927\u5C0F\u7684\u6570\u636E\u90FD\u6536\u96C6\u5230\u4E86\uFF01\uFF01[VAR 0114(002A)]",
