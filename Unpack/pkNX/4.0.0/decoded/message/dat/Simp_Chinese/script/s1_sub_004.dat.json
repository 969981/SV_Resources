  "\u6BC5\u4E07\uFF01\\n\u8C22\u8C22\u4F60\u771F\u8BDA\u7684\u5938\u8D5E\u54E6\u3002[VAR 0114(0041)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u5148\u524D\u9047\u5230\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u8FD8\u771F\u662F\u3002\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u90A3\u5C31\u662F\u5148\u524D\u9047\u5230\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u662F\u5076\u7136\uFF1F\u8FD8\u662F\u547D\u8FD0\uFF1F\u53C8\u6216\u662F\\n\u88AB\u540D\u6D41\u79BB\u5B50\u5438\u5F15\u800C\u6765\u7684\u5462\uFF1F[VAR 0114(0040)]",
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u751A\u597D\uFF01\u751A\u597D\uFF01[VAR 0114(0041)]",
  "\u4E3A\u5927\u4F17\u5E26\u6765\u68A6\u60F3\\n\u6B63\u662F\u6211\u7B49\u540D\u6D41\u7684\u804C\u8D23\u2026\u2026[VAR 0114(0041)]",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u6211\u8981\u628A\\n\u8FD9\u4EFD\u9053\u5177\u8D60\u4E0E\u4F60\u3002[VAR 0114(0041)]",
  "\u8FD9\u4F4D\u5EB6\u6C11\uFF0C\u4ED4\u7EC6\u542C\u597D\u54E6\u3002\\n\u6240\u8C13\u94B1\uFF0C\u5C31\u50CF\u662F\u8D1F\u79BB\u5B50\u4E00\u6837\u3002[VAR 0114(0041)]",
  "\u53EA\u8981\u88AB\u5176\u5305\u56F4\u5C31\u80FD\\n\u4ECE\u4E2D\u83B7\u5F97\u5B89\u5B9A\u4E0E\u5E73\u9759\u2026\u2026[VAR 0114(0041)]",
  "\u4F46\u7531\u6B64\u83B7\u5F97\u7684\u5E78\u798F\\n\u662F\u5426\u771F\u7684\u5B58\u5728\uFF0C\u5C31\u65E0\u4ECE\u5F97\u77E5\u4E86\u5462\u3002[VAR 0114(0041)]",
  "\u592A\u2026\u2026\u592A\u6DF1\u5965\u4E86\uFF01\\n\u5BF9\u5C0F\u670B\u53CB\u6765\u8BF4\u8FD9\u592A\u6DF1\u5965\u5566\uFF0C\u99A5\u597D\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\\n\u6211\u60F3\u53BB\u8DDF\u540D\u80DC\u6BEB\u4E0D\u6CBE\u8FB9\u7684\\r\\n[VAR FF00(0006)]\u504F\u50FB\u7684\u5730\u65B9[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\\n\u540D\u80DC\u53BB\u5F97\u592A\u591A\uFF0C\u90FD\u817B\u5473\u4E86\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5462\uFF01[VAR 0114(0040)]",
  "\u5728\u5357\u7B2C\uFF15\u533A\u548C\u5357\u7B2C\uFF11\u533A\u7684\\n\u4EA4\u754C\u5904\u6709\u4E2A\u597D\u5730\u65B9\u54E6\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u4E07\u5148\u751F\\n\u5DF2\u7ECF\u524D\u5F80\u5E15\u5E95\u4E9A\u5730\u533A\u5317\u7B2C\uFF12\u533A\\r\\n\u89C2\u8D4F\u540D\u80DC\u7684\u7011\u5E03\u4E86\u3002"
]
