  "\u8FD9\u7011\u5E03\u6BD4\u6211\u60F3\u8C61\u7684\\n\u8981\u5BD2\u9178\u5462\u2026\u2026[VAR 0114(0041)]",
  "\u4E0D\u8FC7\u867D\u8BF4\u5BD2\u9178\uFF0C\\n\u8FD8\u662F\u80FD\u611F\u53D7\u5230\u8D1F\u79BB\u5B50\u5462\uFF01[VAR 0114(0041)]",
  "\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u65E0\u8BBA\u4F55\u65F6\u90FD\u4FDD\u6301\u4E50\u89C2\u7684\u6DD1\u5973\u98CE\u8303\uFF01[VAR 0114(0040)]",
  "\u7A7A\u6C14\u91CC\u9664\u4E86\u8D1F\u79BB\u5B50\uFF0C\\n\u751A\u81F3\u8FD8\u98D8\u8361\u7740\u540D\u6D41\u79BB\u5B50\u5462\uFF01[VAR 0114(0040)]",
