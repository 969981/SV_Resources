[
  "\u8981\u8BA9\u6211\u770B\u770B\\n\u4F60\u548C\u5B9D\u53EF\u68A6\u6709\u591A\u53CB\u597D\u5417\uFF1F",
  "\u8981\u8BA9\u6211\u770B\u4F60\u548C\u54EA\u53EA\u5B9D\u53EF\u68A6\\n\u6709\u591A\u53CB\u597D\u5462\uFF1F",
  "\u8BA9\u6211\u770B\u770B\u54E6\u2026\u2026[VAR 0100(0000)]\u4F60\u548C\\n[VAR 0102(0001)]\u7684\u53CB\u597D\u7A0B\u5EA6\u662F\u2026\u2026\uFF1F",
  "\u6700\u4F73\u62CD\u6863\u975E\u4F60\u4EEC\u83AB\u5C5E\uFF01\uFF01\\n\u548C\u5F7C\u6B64\u5728\u4E00\u8D77\u5C31\u4F1A\u5F88\u5E78\u798F\u5427\uFF01",
  "\u4F60\u4EEC\u7684\u5173\u7CFB\u597D\u5F97\u6CA1\u8BDD\u8BF4\uFF01\\n\u800C\u4E14\u5F7C\u6B64\u90FD\u5F88\u73CD\u60DC\u5BF9\u65B9\u5462\uFF01",
  "\u55EF\uFF01\u4F60\u4EEC\u4FE9\u975E\u5E38\u53CB\u597D\uFF01\\n\u80FD\u4E92\u76F8\u966A\u4F34\u5728\u8EAB\u8FB9\uFF0C\u770B\u8D77\u6765\u597D\u5F00\u5FC3\uFF01",
  "\u4F60\u4EEC\u770B\u8D77\u6765\u611F\u60C5\u4E0D\u9519\u5462\u3002\\n\u4F46\u662F\u4F60\u4EEC\u5E94\u8BE5\u8FD8\u80FD\u53D8\u5F97\u66F4\u4EB2\u5BC6\uFF01",
  "\u4F60\u4EEC\u6709\u4E00\u70B9\u70B9\u53CB\u597D\uFF01\\n\u4ECA\u540E\u4E00\u5B9A\u4F1A\u8D8A\u6765\u8D8A\u597D\u7684\uFF01",
  "\u55EF\uFF5E\u4F60\u4EEC\u7684\u5173\u7CFB\u4E0D\u597D\u4E0D\u574F\uFF01\\n\u597D\u671F\u5F85\u4ECA\u540E\u7684\u53D1\u5C55\u5440\uFF01",
  "\u4F60\u662F\u4E0D\u662F\u4E0E\u5B83\u76F8\u9047\u8FD8\u6CA1\u591A\u4E45\u5440\uFF1F\\n\u5728\u4E00\u8D77\u65F6\u8FD8\u6709\u4E9B\u5C34\u5C2C\uFF1F",
  "\u4F60\u4EEC\u662F\u600E\u4E48\u56DE\u4E8B\u561B\uFF01\uFF1F\\n\u7ADF\u7136\u4E00\u70B9\u4E5F\u4E0D\u53CB\u597D\u2026\u2026",
  "\u4F5C\u4E3A\u53CB\u597D\u7684\u8BC1\u660E\uFF01\\n\u8BA9\u6211\u4E3A\u5B83\u6234\u4E0A\u8FD9\u4E2A\u597D\u4E1C\u897F\u5427\uFF01",
  "[VAR 0102(0001)]\\n\u6234\u4E0A\u4E86\u597D\u53CB\u5956\u7AE0\uFF01",
  "\u6B22\u8FCE\u968F\u65F6\u6765\u7ED9\u6211\u770B\u5B9D\u53EF\u68A6\u54E6\uFF01",
  "\u548C\u5B9D\u53EF\u68A6\u5728\u4E00\u8D77\u7684\u8BDD\uFF0C\\n\u4F60\u4EEC\u5C31\u4F1A\u6162\u6162\u53D8\u5F97\u53CB\u597D\u8D77\u6765\u3002",
  "[~ 16]"
]
