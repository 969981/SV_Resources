  "\u65E2\u7136\u8EAB\u5B50\u90FD\u70ED\u8D77\u6765\u4E86\uFF0C\u90A3\u63A5\u4E0B\u6765\\n\u5C31\u8981\u901A\u8FC7\u5BF9\u6218\u6765\u73A9\u547D\u953B\u70BC\u808C\u8089\u4E86\uFF01[VAR 0114(0024)]",
  "\u6BD4\u5E73\u65F6\u7684\u5BF9\u6218\u6D3B\u52A8\u5F97\u66F4\u6FC0\u70C8\u4E9B\uFF01\\n\u4E89\u53D6\u5851\u9020\u7406\u60F3\u7684BODY\u5427\uFF01",
