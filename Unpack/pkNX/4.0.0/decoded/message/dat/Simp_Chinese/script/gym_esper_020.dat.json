[
  "\u6B22\u8FCE\u6765\u5230\u7119\u56FA\u9053\u9986\uFF01\\n\u9700\u8981\u518D\u542C\u4E00\u6B21\\r\\n\u9053\u9986\u6D4B\u9A8C\u7684\u8BF4\u660E\u5417\uFF1F",
  "\u7119\u56FA\u9053\u9986\u7684\u9053\u9986\u6D4B\u9A8C\u662F\u505A[VAR FF00(0006)]\u4F53\u64CD[VAR FF00(0000)]\uFF01",
  "\u53EA\u8981\u80FD\u628A\u9053\u9986\u9986\u4E3B\u8389\u666E\u72EC\u521B\u7684\\n[VAR FF00(0006)]\u559C\u6012\u60CA\u4E50\u4F53\u64CD[VAR FF00(0000)]\\r\\n\u6210\u529F\u505A\u5230\u6700\u540E\uFF0C\u5C31\u80FD\u901A\u8FC7\u6D4B\u9A8C\uFF01",
  "\u8BE6\u7EC6\u89C4\u5219\u8BF7\u4F60\u5148\u51FA\u672C\u9053\u9986\uFF0C\\n\u518D\u53BB\u5DE6\u624B\u8FB9\u7684\u4F53\u64CD\u4F1A\u573A\\r\\n\u95EE\u7A7F\u9ED1\u8272\u8FD0\u52A8\u670D\u7684\u59D0\u59D0\u3002",
  "\u55E8\uFF01\u8F6C\u5B66\u751F\uFF01\\n\u6B22\u8FCE\u4F60\u6765\u5230\u559C\u6012\u60CA\u4E50\u4F53\u64CD\u4F1A\u573A\u3002[VAR 0114(0024)]",
  "\u4F60\u95EE\u6211\u4E3A\u4EC0\u4E48\\n\u6559\u5BF9\u6218\u7684\u51F0\u6A97\u8001\u5E08\\r\\n\u4F1A\u5728\u9053\u9986\u5F53\u6559\u7EC3\u5417\uFF1F[VAR 0114(0024)]",
  "\u2026\u2026\u9053\u9986\u9986\u4E3B\u8389\u666E\u548C\u6211\\n\u4ECE\u5C0F\u4E00\u8D77\u957F\u5927\u3002[VAR 0114(0024)]",
  "\u5728\u8C01\u8F93\u4E86\u8C01\u5C31\u8981\\n\u542C\u5BF9\u65B9\u8BDD\u7684\u89C4\u5219\u4E0B\uFF0C\\r\\n\u6211\u4EEC\u6765\u4E86\u573A\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\u7ED3\u679C\u2026\u2026[VAR 0114(0024)]",
  "\u2026\u2026\u54CE\uFF01\u53CD\u6B63\u80FD\u5F3A\u8EAB\u5065\u4F53\uFF0C\\n\u6240\u4EE5\u6CA1\u8BFE\u7684\u65F6\u5019\u6211\u5C31\u6765\u5E2E\u5FD9\u4E86\u3002[VAR 0114(0024)]",
  "\u4F53\u64CD\u7684\u89C4\u5219\u5F88\u7B80\u5355\uFF01\\n\u8DDF\u7740\u6211\u7684\u793A\u8303\\r\\n\u505A\u4E00\u6837\u7684\u52A8\u4F5C\u5C31\u597D\uFF01[VAR 0114(0024)]",
  "\u90A3\u597D\uFF0C\u9A6C\u4E0A\u5F00\u59CB\u9053\u9986\u6D4B\u9A8C\u5427\u3002\\n\u4F60\u7684\u8EAB\u5FC3\u90FD\u505A\u597D\u51C6\u5907\u4E86\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5F88\u597D\uFF0C\u4F53\u64CD\u5F00\u59CB\uFF01\\n\u628A\u4F60\u7684\u60C5\u611F\u8FF8\u53D1\u51FA\u6765\u5427\uFF01\uFF01[VAR 0114(0024)]",
  "\u55EF\uFF01\u4E00\u5B9A\u8981\u505A\u597D\u51C6\u5907\uFF01\\n\u597D\u4E86\u4E4B\u540E\u518D\u544A\u8BC9\u6211\u4E00\u58F0\u5427\u3002[VAR 0114(0024)]",
  "\u55EF\uFF01\u52A8\u4F5C\u505A\u5F97\u4E0D\u9519\uFF01\\n\u8F6C\u5B66\u751F\u548C\u5B9D\u53EF\u68A6\u8868\u73B0\u5F97\u90FD\u5F88\u8000\u773C\uFF01[VAR 0114(0024)]",
