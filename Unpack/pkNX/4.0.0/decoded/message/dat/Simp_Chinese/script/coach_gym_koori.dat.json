[
  "\u2026\u2026\u545C\u545C\uFF0C\u597D\u51B7\u3002[VAR 0114(001A)]",
  "\u8FD9\u91CC\u7684\u7A7A\u8C03\u4E5F\u592A\u51B7\u4E86\u3002[VAR 0114(001A)]",
  "\u4F60\u628A\u6211\u53EB\u6765\u8FD9\u91CC\u2026\u2026[VAR 0114(001A)]",
  "\u53EF\u662F\u4E00\u4EF6\u5F88\u5C34\u51B7\u7684\u4E8B\u2026\u2026\\n\u4F60\u77E5\u9053\u5417\uFF1F[VAR 0114(001A)]",
  "\u6211\u4E0D\u89C9\u5F97\u628A\u6211\u53EB\u6765\\n\u4F1A\u5BF9\u5B66\u56ED\u6709\u597D\u5904\u3002[VAR 0114(001A)]",
  "\u6CA1\u90A3\u56DE\u4E8B\uFF01",
