  "\u4F60\u770B\u2026\u2026\\n\u4F60\u4E0D\u4E5F\u662F\u6CA1\u6709\u81EA\u4FE1\u561B\u3002[VAR 0114(001A)]",
  "\u4F46\u65E2\u7136\u6765\u4E86\uFF0C\\n\u6211\u8FD8\u662F\u4F1A\u5B8C\u6210\u5DE5\u4F5C\u7684\u3002[VAR 0114(001A)]",
  "\u59D1\u4E14\u2026\u2026\\n\u6211\u4E5F\u662F\u4E13\u4E1A\u7684\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u662F\u4F60\u554A\uFF1F[VAR 0114(001A)]",
  "\u4F60\u53BB\u8FC7\u5DE8\u86CB\u7684\u6781\u5730\u533A\u5417\uFF1F\\n\u90A3\u91CC\u771F\u5389\u5BB3\u5440\u3002[VAR 0114(001A)]",
  "\u90A3\u91CC\u7684\u96EA\u8F6F\u5F97\u5C31\u50CF\u662F\u5929\u7136\u7684\u4E00\u6837\uFF0C\\n\u8BA9\u4EBA\u96BE\u4EE5\u76F8\u4FE1\u662F\u4EBA\u5DE5\u96EA\u3002[VAR 0114(001A)]",
  "\u76F4\u9053\u548C\u5F2F\u9053\u90FD\u5F88\u5145\u8DB3\uFF0C\\n\u975E\u5E38\u9002\u5408\u5355\u677F\u6ED1\u96EA\u3002[VAR 0114(001A)]",
  "\u4F60\u8981\u6ED1\u96EA\u5417\uFF01\uFF1F",
  "\u53BB\u6ED1\u96EA\u5427\uFF01",
  "\u2026\u2026\u554A\uFF0C\\n\u6211\u4E0D\u662F\u8FD9\u4E2A\u610F\u601D\u3002[VAR 0114(001A)]",
  "\u53EA\u662F\u6211\u6539\u4E0D\u6389\u770B\u5230\u96EA\u5C71\\n\u5C31\u4F1A\u5F00\u59CB\u89C2\u5BDF\u7684\u6BDB\u75C5\u3002[VAR 0114(001A)]",
  "\u5C45\u7136\u5728\u6821\u5185\u9020\u51FA\u90A3\u6837\u7684\u5C71\u2026\u2026\\n\u8FD9\u91CC\u771F\u662F\u4E2A\u4E0D\u5F97\u4E86\u7684\u5730\u65B9\u3002[VAR 0114(001A)]",
  "\u521A\u521A\u6211\u53BB\u767B\u4E86\\n\u6781\u5730\u533A\u7684\u96EA\u5C71\u3002[VAR 0114(001A)]",
  "\u5728\u4E0D\u662F\u971C\u62B9\u7684\u96EA\u5C71\u4E0A\uFF0C\\n\u8D70\u9CB8\u4EEC\u73A9\u5F97\u53EF\u5174\u594B\u4E86\u3002[VAR 0114(001A)]",
  "\u770B\u7740\u770B\u7740\uFF0C\u6211\u4E5F\u2026\u2026\\n\u5FCD\u4E0D\u4F4F\u2026\u2026\u73A9\u4E86\u4E00\u4E0B\u5355\u677F\u6ED1\u96EA\u3002[VAR 0114(001A)]",
  "\u771F\u597D\uFF01",
  "\u611F\u89C9\u600E\u4E48\u6837\uFF1F",
