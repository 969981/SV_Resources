  "\u8FD9\u6B21\u4E45\u8FDD\u7684\u6ED1\u96EA\\n\u8BA9\u6211\u5174\u594B\u8FC7\u5934\u4E86\u3002[VAR 0114(001A)]",
  "\u867D\u7136\u6211\u4E4B\u524D\u90FD\u4E0D\u6253\u7B97\\n\u518D\u8E0F\u4E0A\u6ED1\u96EA\u677F\u4E86\u2026\u2026[VAR 0114(001A)]",
  "\u4F46\u81F3\u5C11\u5230\u8FD9\u91CC\u6765\u65F6\uFF0C\\n\u8FD8\u662F\u53EF\u4EE5\u89E3\u9664\u8FD9\u4E2A\u9650\u5236\u5427\uFF1F[VAR 0114(001A)]",
  "\u2026\u2026\u62B1\u6B49\uFF0C\\n\u6211\u7684\u610F\u5FD7\u529B\u8FD9\u4E48\u8584\u5F31\u3002[VAR 0114(001A)]",
  "\u6211\u4EEC\u6765\u505A\u4E9B\u51B7\u4E0A\u52A0\u51B7\u7684\u4E8B\u5427\u3002[VAR 0114(001A)]",
  "\u4F60\u8981\u548C\u6211\u6765\\n\u8FDB\u884C\u5B9D\u53EF\u68A6\u4EA4\u6362\u5417\uFF1F[VAR 0114(001A)]",
  "\u771F\u7684\u8981\u6765\u4EA4\u6362\u5417\uFF1F\\n\u90A3\u4E48\u6211\u5C31\u7528\u8D70\u9CB8\u8DDF\u4F60\u6362\u5427\u3002\\r\\n\u4F60\u4F1A\u7528\u54EA\u53EA\u6765\u6362\u5462\uFF1F[VAR 0114(001A)]",
  "\u662F[VAR 0101(0001)]\u554A\u3002\\n\u55EF\u2026\u2026\u4E0D\u9519\u3002\\c\\n\u65E2\u7136\u5B83\u662F\u4F60\u6258\u4ED8\u7ED9\u6211\u7684\uFF0C\\n\u90A3\u6211\u662F\u4E0D\u4F1A\u7528\u5C34\u51B7\u7684\u65B9\u6CD5\u57F9\u80B2\u5B83\u7684\u3002[VAR 0114(001A)]",
  "\u90A3\u4E48\u5C31\u7528\u6211\u7684\u8D70\u9CB8\u6765\u548C\\n\u4F60\u7684[VAR 0101(0001)]\u4EA4\u6362\u54AF\u3002[VAR 0114(001A)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u53EA\u6709\uFF11\u53EA\u5B9D\u53EF\u68A6\u7684\u8BDD\u592A\u5C34\u51B7\u4E86\uFF0C\\n\u65E0\u6CD5\u8FDB\u884C\u4EA4\u6362\u3002\\c\\n\u540C\u884C\u7684\u5B9D\u53EF\u68A6\u81F3\u5C11\u8981\\n\u5E26\u4E0A\uFF12\u53EA\u624D\u884C\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u6211\u4E5F\u53EA\u662F\u5F00\u73A9\u7B11\u800C\u5DF2\uFF0C\u522B\u5728\u610F\u3002[VAR 0114(001A)]",
  "\u8981\u6765\u505A\u5C34\u51B7\u7684\u4E8B\u5417\uFF1F\\n\u4F8B\u5982\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\u4E4B\u7C7B\u7684\u3002[VAR 0114(001A)]",
  "\u4F60\u7684\u90A3\u4E2A\u8868\u60C5\u2026\u2026\\n\u662F\u60F3\u548C\u6211\u5BF9\u6218\u5417\uFF1F[VAR 0114(001A)]",
  "\u4F60\u653E\u5F03\u662F\u4E2A\u6B63\u786E\u7684\u9009\u62E9\u3002[VAR 0114(001A)]",
  "\u597D\u5C34\u51B7\u7684\u56DE\u7B54\u2026\u2026\\n\u4F46\u5076\u5C14\u8FD9\u6837\u4E5F\u4E0D\u574F\u3002[VAR 0114(001A)]",
  "[~ 59]",
  "\u2026\u2026\u6211\u8F93\u5F97\u4E94\u4F53\u6295\u5730\u3002\\n\u73B0\u5B9E\u771F\u662F\u51B0\u51B7\u554A\u3002[VAR 0114(001A)]",
  "\u4F46\u6211\u6253\u5F97\u5341\u5206\u5F00\u5FC3\uFF0C\\n\u7B97\u662F\u6709\u6240\u6536\u83B7\u5427\u3002[VAR 0114(001A)]",
  "\u8FD9\u662F\u8D25\u8005\u9001\u7ED9\u80DC\u8005\u7684\uFF0C\\n\u4F60\u62FF\u53BB\u5427\u3002[VAR 0114(001A)]",
  "\u4F60\u4E0D\u8981\u7684\u8BDD\u5C31\u6254\u6389\u5427\u3002[VAR 0114(001A)]",
  "[~ 59]",
  "\u611F\u89C9\u4F60\u771F\u7684\u597D\u559C\u6B22\\n\u628A\u6211\u6253\u8D25\u554A\u3002[VAR 0114(001A)]",
  "\u4E0B\u6B21\u518D\u6218\u7684\u65F6\u5019\uFF0C\\n\u6211\u4E0D\u4F1A\u8BA9\u7ED3\u679C\u5C34\u51B7\u7684\u3002[VAR 0114(001A)]",
  "\u5C31\u7B97\u6253\u8D62\u653E\u6C34\u7684\u4F60\uFF0C\\n\u6211\u4E5F\u4E00\u70B9\u90FD\u9AD8\u5174\u4E0D\u8D77\u6765\u3002\\r\\n\u4E0B\u6B21\u4F60\u53EF\u8981\u5168\u529B\u4EE5\u8D74\u54E6\u3002[VAR 0114(001A)]",
  "\u6211\u4E0D\u64C5\u957F\u8DDF\u5B66\u751F\u76F8\u5904\u2026\u2026\\n\u4E00\u60F3\u5230\u4ED6\u4EEC\u5C06\u6765\u53EF\u80FD\u4F1A\u9047\u5230\u632B\u6298\uFF0C\\r\\n\u6211\u5C31\u4E0D\u5FCD\u76F4\u89C6\u4E86\u3002[VAR 0114(001A)]",
  "\u6211\u5728\u8FD9\u8FB9\u4F3C\u4E4E\\n\u4E5F\u6709\u4E00\u70B9\u540D\u6C14\u3002\\c\\n\u4F46\u4F1A\u6765\u8981\u6C42\u5408\u7167\u7684\u4EBA\\n\u6709\u4F60\u4E00\u4E2A\u5C31\u591F\u4E86\u554A\u3002[VAR 0114(001A)]",
  "\u6211\u8FD8\u662F\u89C9\u5F97\u8FD9\u91CC\u7684\u7A7A\u8C03\\n\u6E29\u5EA6\u662F\u4E0D\u662F\u8C03\u5F97\u592A\u4F4E\u4E86\uFF1F\\r\\n\u8981\u8DDF\u8C01\u8BF4\u624D\u80FD\u8C03\u9AD8\u6E29\u5EA6\u5462\uFF1F[VAR 0114(001A)]",
  "[VAR 0101(0001)]\u8FC7\u5F97\u5F88\u597D\u54E6\u3002\\n\u5B83\u548C\u6211\u7684\u5B9D\u53EF\u68A6\u76F8\u5904\u5F97\u5F88\u4E0D\u9519\u3002\\r\\n\u2026\u2026\u76EE\u524D\u4E3A\u6B62\u5B83\u5E76\u4E0D\u5C34\u51B7\u3002[VAR 0114(001A)]",
  "\u4EA4\u6362\u7ED9\u4F60\u7684\\n\u8D70\u9CB8\u73B0\u5728\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\\c\\n\u5B83\u9A6C\u4E0A\u5C31\u4F1A\u8DD1\u5230\u522B\u7684\u5730\u65B9\u53BB\uFF0C\\n\u5728\u91CE\u9910\u65F6\u8BB0\u5F97\u8981\u597D\u597D\u770B\u7740\u5B83\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u8BF4\u8D77\u6765\uFF0C\u4E5F\u6148\u5979\\n\u544A\u8BC9\u4E86\u6211\u4E00\u4EF6\u5C34\u51B7\u7684\u4E8B\u3002\\c\\n\u636E\u8BF4\u4F60\u8DDF\u5979\u8BF4\\n\u4F60\u6700\u559C\u6B22\u7684\u9053\u9986\u9986\u4E3B\u662F\u6211\u3002\\c\\n\u867D\u7136\u6211\u5B8C\u5168\u4E0D\u80FD\u7406\u89E3\u4F60\u5230\u5E95\u662F\\n\u600E\u6837\u5F97\u51FA\u8FD9\u4E2A\u7B54\u6848\u7684\u2026\u2026\\c\\n\u4F46\u4F60\u7684\u5FC3\u610F\u6211\u77E5\u9053\u4E86\u2026\u2026\\n\u59D1\u4E14\u8DDF\u4F60\u8BF4\u58F0\u8C22\u8C22\u5427\u3002[VAR 0114(001A)]"
]
