[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u4EEC\u5F00\u59CB\u4E0A\u8BFE\u5427\uFF5E[VAR 0114(002A)]",
  "\u5927\u5BB6\u7684\u671F\u4E2D\u8003\u8BD5\\n\u90FD\u8868\u73B0\u5F97\u975E\u5E38\u4F18\u79C0\u54E6\u3002[VAR 0114(002A)]",
  "\u610F\u89C1\u8C03\u67E5\u65B9\u9762\u4E5F\u611F\u8C22\u5927\u5BB6\u4E86\u3002\\n\u6211\u4F1A\u5F53\u4F5C\u4ECA\u540E\u7684\u53C2\u8003\u7684\uFF5E[VAR 0114(002A)]",
  "\u597D\u4E86\uFF0C\u4ECE\u4ECA\u5929\u8D77\uFF0C\\n\u8BFE\u7A0B\u5C31\u8FDB\u5165\u4E86\u540E\u534A\u6BB5\u3002[VAR 0114(002A)]",
  "\u5C31\u8BA9\u6211\u4EEC\u7684\u77E5\u8BC6\u4E5F\u50CF\u5B9D\u53EF\u68A6\u90A3\u6837\\n\u4E0D\u65AD\u8FDB\u5316\u4E0B\u53BB\u5427\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6CA1\u9519\uFF0C\u8FDB\u5316\u2026\u2026\\n\u563B\u563B\uFF0C\u5C31\u662F\u8FDB\u5316\u3002[VAR 0114(002A)]",
  "\u4ECA\u5929\u6211\u4EEC\u8981\u5B66\u4E60\u5173\u4E8E\\n\u5B9D\u53EF\u68A6\u8FDB\u5316\u7684\u77E5\u8BC6\u54E6\uFF5E[VAR 0114(002A)]",
  "\u8BA9\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u6E10\u6E10\u63D0\u5347\u7B49\u7EA7\u4E4B\u540E\uFF0C\\r\\n\u5B83\u5C31\u4F1A\u5B66\u4F1A\u62DB\u5F0F\uFF0C\u5E76\u4E14\u53D8\u5F3A\u3002[VAR 0114(002A)]",
  "\u5F53\u5B9D\u53EF\u68A6\u7684\u7B49\u7EA7\\n\u8FBE\u5230\u67D0\u4E2A\u7A0B\u5EA6\u4E4B\u540E\u2026\u2026[VAR 0114(002A)]",
  "\u5B83\u7684\u5916\u89C2\u5C31\u4F1A\u6539\u53D8\uFF0C\\n\u80FD\u529B\u4E5F\u4F1A\u6709\u5F88\uFF5E\u5927\u7684\u63D0\u5347\u3002[VAR 0114(002A)]",
  "\u90A3\u5C31\u662F\u5B9D\u53EF\u68A6\u7684\u8FDB\u5316\uFF01[VAR 0114(002A)]",
  "\u5B9D\u53EF\u68A6\u4E00\u65E6\u8FDB\u5316\u4E4B\u540E\\n\u5C31\u4F1A\u53D8\u5F97\u5F88\u5F3A\u3002\\r\\n\u5BF9\u6218\u65F6\u4F1A\u6210\u4E3A\u4F60\u53EF\u9760\u7684\u642D\u6863\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u4F46\u662F\uFF01\u4E5F\u6709\u4EBA\u4E0D\u60F3\u8BA9\u5B9D\u53EF\u68A6\u8FDB\u5316\uFF0C\\n\u5E0C\u671B\u53EF\u4EE5\u7EF4\u6301\u5B83\u4E00\u76F4\u4EE5\u6765\u7684\u6837\u5B50\uFF0C\\r\\n\u597D\u7EE7\u7EED\u53BB\u75BC\u7231\u5B83\u3002[VAR 0114(002A)]",
  "\u5982\u679C\u662F\u8FD9\u6837\u7684\u8BDD\uFF0C\u53EF\u4EE5\u5728\u5B9D\u53EF\u68A6\\n\u5F00\u59CB\u8FDB\u5316\u65F6\u4E0D\u614C\u4E0D\u5FD9\u5730\u4F7F\u7528\u8FD9\u4E2A\u53E3\u8BC0\u3002[VAR 0114(002A)]",
  "\u5927\u5BB6\u4E00\u8D77\u8BF4\u51FA\u7B54\u6848\u5427\u3002\\n\u53D6\u6D88\u8FDB\u5316\u8981\u6309\u2026\u2026\u4E00\u3001\u4E8C\uFF5E\u4E09\uFF01[VAR 0114(002A)]",
  "\uFF21\u952E\uFF01",
  "\uFF22\u952E\uFF01",
  "\uFF23\u952E\uFF01",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u597D\u50CF\u53EA\u6709[VAR 0100(0000)]\u56DE\u7B54\u5F97\u4E0D\u4E00\u6837\u5462\u3002\\c\\n\uFF21\u952E\u66F4\u50CF\u662F\uFF2F\uFF2B\u5566\uFF5E\\n\u6216\u662F\u51B3\u5B9A\u54AF\uFF5E\u7684\u611F\u89C9\u5462\u3002[VAR 0114(002A)]",
  "Best\u7684B\uFF0C\u6700\u68D2\u7684B\uFF01\\n\u5927\u5BB6\u56DE\u7B54\u6B63\u786E\uFF01[VAR 0114(002A)]",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u597D\u50CF\u53EA\u6709[VAR 0100(0000)]\u56DE\u7B54\u5F97\u4E0D\u4E00\u6837\u5462\u3002\\c\\n\uFF23\u952E\u2026\u2026\u4E0D\u77E5\u4E3A\u4F55\uFF0C\\n\u8FD9\u4E2A\u8BCD\u8BED\u8BA9\u6211\u6709\u79CD\u5F88\u6000\u5FF5\u7684\u611F\u89C9\u5462\uFF5E[VAR 0114(002A)]",
  "\u6CA1\u9519\uFF0C\u8FD9\u4E2A\u53E3\u8BC0\u5C31\u662F\\n\u201C\uFF22\u952E\u53D6\u6D88\u8FDB\u5316\uFF01\u201D\u3002[VAR 0114(002A)]",
  "\u53EA\u8981\u662F\u5728\u8FDB\u5316\u5F00\u59CB\u540E\u7ACB\u523B\u4F7F\u7528\uFF0C\\n\u5C31\u80FD\u8BA9\u5B9D\u53EF\u68A6\u5916\u89C2\u7684\u6539\u53D8\u505C\u6B62\u4E0B\u6765\uFF5E[VAR 0114(002A)]",
  "\u8BA9\u5B9D\u53EF\u68A6\u643A\u5E26\\n\u540D\u4E3A\u4E0D\u53D8\u4E4B\u77F3\u7684\u9053\u5177\uFF0C\\r\\n\u4E5F\u53EF\u4EE5\u963B\u6B62\u8FDB\u5316\u54E6\uFF5E[VAR 0114(002A)]",
  "\u5BF9\u4E86\uFF0C\u5B9D\u53EF\u68A6\u7684\\n\u8FDB\u5316\u6761\u4EF6\u4F1A\u5404\u6709\u4E0D\u540C\u3002[VAR 0114(002A)]",
  "\u6709\u7684\u5B9D\u53EF\u68A6\u9700\u8981\u706B\u4E4B\u77F3\u3001\\n\u96F7\u4E4B\u77F3\u7B49\u9053\u5177\u624D\u80FD\u8FDB\u5316\uFF0C\\r\\n\u6709\u7684\u5219\u662F\u5FC5\u987B\u5B66\u4F1A\u7279\u5B9A\u62DB\u5F0F\uFF0C\\r\\n\u8FD8\u6709\u7684\u662F\u5FC5\u987B\u6253\u5012\u7279\u5B9A\u5B9D\u53EF\u68A6\u624D\u4F1A\u8FDB\u5316\u3002[VAR 0114(002A)]",
  "\u6BD4\u5982\uFF0C\u8BA9\u706B\u66B4\u7334\u8FDB\u5316\u6210\u5F03\u4E16\u7334\u7684\u65B9\u6CD5\uFF0C\\n\u90A3\u7B80\u76F4\u662F\u76F8\u5F53\u7279\u522B\u2026\u2026[VAR 0114(002A)]",
  "\u5F97\u8BA9\u67D0\u4E2A\u62DB\u5F0F\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u4E0D\u597D\u610F\u601D\uFF0C\\n\u6070\u5DE7\u5230\u4E86\u4E0B\u8BFE\u65F6\u95F4\u4E86\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u5C31\u4E0A\u5230\u8FD9\u91CC\u5427\u3002\\n\u4E0B\u8BFE\u54AF\uFF5E[VAR 0114(002A)]"
]
