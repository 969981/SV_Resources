[
  "\u8BF8\u4F4D\uFF0C\u6536\u8D77\u4F60\u4EEC\u7684\u624B\u673A\uFF0C\\n\u5F00\u59CB\u4E0A\u8BFE\u5427\u3002[VAR 0114(0029)]",
  "\u4E0A\u4E00\u8282\u8BFE\uFF0C\\n\u543E\u8F88\u8BB2\u89E3\u4E86\uFF28\uFF30\u7684\u56DE\u590D\u2026\u2026[VAR 0114(0029)]",
  "\u4E0D\u8FC7\u5728\u4E0B\u8BFE\u540E\uFF0C\u6709\u90E8\u5206\u540C\u5B66\\n\u95EE\u4E86\u543E\u8F88\u5173\u4E8E[VAR FF00(0006)]\uFF30\uFF30[VAR FF00(0000)]\u7684\u95EE\u9898\u3002[VAR 0114(0029)]",
  "\u5B8C\u5168\u5931\u53BB\uFF28\uFF30\u5C31\u4F1A\u9677\u5165\u660F\u53A5\u72B6\u6001\uFF01\\n\u5B9D\u53EF\u68A6\u5C06\u4F1A\u53D8\u5F97\u65E0\u6CD5\u5BF9\u6218\u3002[VAR 0114(0029)]",
  "\u90A3\u4E48\uFF0C\u5B8C\u5168\u5931\u53BB\uFF30\uFF30\u540E\uFF0C\\n\u5B9D\u53EF\u68A6\u4F1A\u53D8\u5F97\u600E\u6837\u5462\uFF1F[VAR 0114(0029)]",
  "\u53D8\u5F97\u65E0\u6CD5\u4F7F\u7528\u62DB\u5F0F",
  "\u53D8\u5F97\u4E0D\u542C\u8BDD",
  "\u6240\u6709\u80FD\u529B\u90FD\u4F1A\u964D\u4F4E",
  "[VAR 0100(0000)]\uFF0C\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\u3002\\n\u4F60\u8FD9\u662F\u4EB2\u8EAB\u4F53\u9A8C\u8FC7\u5417\uFF1F[VAR 0114(0029)]",
  "\u90A3\u7684\u786E\u662F\u4E2A\u5F88\u5371\u9669\u7684\u72B6\u6001\uFF0C\u4F46\u4F60\u7B54\u9519\u4E86\u3002\\c\\n\u2026\u2026\u5B9D\u53EF\u68A6\u542C\u4E0D\u542C\u8BDD\uFF0C\\n\u53D6\u51B3\u4E8E\u9053\u9986\u5FBD\u7AE0\u7684\u6570\u91CF\u3002[VAR 0114(0029)]",
  "\u90A3\u7684\u786E\u662F\u4E2A\u5F88\u5371\u9669\u7684\u72B6\u6001\uFF0C\u4F46\u4F60\u7B54\u9519\u4E86\u3002\\c\\n\uFF30\uFF30\u6307\u7684\u5E76\u4E0D\u662F\\n\u5177\u6709\u90A3\u79CD\u529B\u91CF\u7684\u70B9\u6570\u3002[VAR 0114(0029)]",
  "\u5B8C\u5168\u5931\u53BB\uFF30\uFF30\u540E\uFF0C\\n\u5B9D\u53EF\u68A6\u5C06\u4F1A\u65E0\u6CD5\u4F7F\u7528\u62DB\u5F0F\u3002[VAR 0114(0029)]",
  "\u6BCF\u4E2A\u62DB\u5F0F\u7684\uFF30\uFF30\u90FD\u662F\u72EC\u7ACB\u7684\uFF0C\\n\u6240\u4EE5\u907F\u514D\u603B\u662F\u7528\u540C\u4E00\u62DB\u4E3A\u597D\u3002\\r\\n\u66F4\u5E73\u5747\u5730\u4F7F\u7528\u62DB\u5F0F\uFF0C\u5C31\u4E0D\u5BB9\u6613\u7528\u5149\uFF30\uFF30\u4E86\u3002[VAR 0114(0029)]",
  "\u5F53\u6240\u6709\u62DB\u5F0F\u7684\uFF30\uFF30\u90FD\u7528\u5149\u540E\uFF0C\\n\u5B9D\u53EF\u68A6\u5C31\u53EA\u80FD\u505A\u51FA\\r\\n\u8BA9\u81EA\u8EAB\u4E5F\u4F1A\u53D7\u5230\u4F24\u5BB3\u7684\u201C\u6323\u624E\u201D\u4E86\u3002[VAR 0114(0029)]",
  "\u4E3A\u4E86\u907F\u514D\u53D8\u6210\u90A3\u6837\uFF0C\uFF30\uFF30\u4E5F\u8981\\n\u50CF\uFF28\uFF30\u4E00\u6837\uFF0C\u5230\u5B9D\u53EF\u68A6\u4E2D\u5FC3\u8FDB\u884C\u56DE\u590D\u3002[VAR 0114(0029)]",
  "\u4E5F\u6709\uFF30\uFF30\u5355\u9879\u5C0F\u8865\u5242\u3001\uFF30\uFF30\u5355\u9879\u5168\u8865\u5242\u4E4B\u7C7B\\n\u80FD\u56DE\u590D\uFF30\uFF30\u7684\u9053\u5177\u3002\\r\\n\u540D\u5B57\u91CC\u6709\uFF30\uFF30\u5C31\u662F\u8FD9\u7C7B\u9053\u5177\u7684\u7279\u5F81\u3002[VAR 0114(0029)]",
  "\u4E0D\u8FC7\uFF0C\u5E97\u91CC\u662F\u4E0D\u5356\u8FD9\u7C7B\u9053\u5177\u7684\uFF0C\\n\u6240\u4EE5\u5F53\u4F60\u627E\u5230\u5B83\u4EEC\u65F6\uFF0C\u8981\u73CD\u60DC\u4E00\u70B9\u4F7F\u7528\u3002[VAR 0114(0029)]",
  "\u8D8A\u5F3A\u5927\u7684\u62DB\u5F0F\uFF0C\u6700\u5927\uFF30\uFF30\u5C31\u4F1A\u8D8A\u5C11\uFF0C\\n\u6240\u4EE5\u80E1\u4E71\u4F7F\u7528\u7684\u8BDD\uFF0C\u5F88\u5FEB\u5C31\u4F1A\u7528\u4E2A\u7CBE\u5149\u3002\\r\\n\u62DB\u5F0F\u7684\u5E73\u8861\u6027\u4E5F\u4F1A\u5F88\u91CD\u8981\u3002[VAR 0114(0029)]",
  "\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u5192\u9669\u65F6\uFF0C\\n\u5E94\u5F53\u5728\u610F\u7684\u4E0D\u53EA\u662F\uFF28\uFF30\u3002[VAR 0114(0029)]",
  "\u5E0C\u671B\u8BF8\u4F4D\u80FD\u4E00\u8FB9\u5173\u5FC3\u642D\u6863\uFF0C\\n\u4EE5\u4FBF\u8BA9\u5B83\u4EEC\u62FF\u51FA\u6700\u4F73\u72B6\u6001\uFF0C\\r\\n\u4E00\u8FB9\u7EE7\u7EED\u5BFB\u5B9D\u3002[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u4E0B\u6B21\u4E0A\u8BFE\u90A3\u5929\u8981\u8003\u8BD5\u554A\u3002\\r\\n\u8BF7\u8BF8\u4F4D\u597D\u597D\u590D\u4E60\u5427\u3002[VAR 0114(0029)]"
]
