[
  "\u6D1B\u6258\u6D1B\u6258\u6D1B\u6258\u6D1B\u6258\u2026\u2026",
  "\u5582\u5582\uFF01\\n\u6211\u662F\u59AE\u83AB\uFF01\u662F\u6211\u59AE\u83AB\uFF01[VAR 0114(0004)]",
  "\u4EE5\u540E\u6211\u4EEC\u5C31\u7528\u624B\u673A\u6765\\n\u4E92\u76F8\u62A5\u544A\u5404\u81EA\u7684\u8FD1\u51B5\u5427\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u51B3\u5B9A\u4ECE\u5B66\u6821\u897F\u8FB9\u51FA\u53D1\u4E86\u5427\uFF01[VAR 0114(0004)]",
  "\u4ECE\u90A3\u8FB9\u51FA\u53D1\u7684\u8BDD\uFF0C\\n\u5706\u6A21\u9547\u5C31\u5728\u4E0D\u8FDC\u5904\u54E6\uFF01[VAR 0114(0004)]",
  "\u90A3\u91CC\u6709\u866B\u5C5E\u6027\u7684\u9053\u9986\uFF0C\\n\u6240\u4EE5\u4F60\u53EF\u4EE5\u6311\u6218\u9053\u9986\u9986\u4E3B\u5566\uFF01[VAR 0114(0004)]",
  "\u51ED[VAR 0100(0000)]\u4F60\u7684\u5B9E\u529B\uFF0C\u4E00\u5B9A\u80FD\u8D62\u7684\uFF01\\n\u52A0\u6CB9\uFF01\u6211\u8FD8\u4F1A\u8054\u7CFB\u4F60\u7684\uFF5E\uFF01[VAR 0114(0004)]",
  "\u5582\u5582\uFF0C\u662F[VAR 0100(0000)]\u7684\u624B\u673A\u6D1B\u6258\u59C6\uFF0C\\n\u6CA1\u9519\u5427\uFF1F[VAR 0114(0006)]",
  "\u662F\u6211\uFF0C\u6D3E\u5E15\uFF01\\n\u6211\u8FD9\u662F\u60E6\u8BB0\u7740\u4F60\u51FA\u53D1\u4E86\u6CA1\u3002[VAR 0114(0006)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u662F\u4ECE\u5B66\u6821\u4E1C\u8FB9\u51FA\u53D1\u7684\u5427\uFF01[VAR 0114(0006)]",
  "\u4ECE\u90A3\u8FB9\u7684\u8BDD\uFF0C\u79BB\u636E\u8BF4\u6709\u5CA9\u58C1\u5B9D\u4E3B\\n\u5728\u90A3\u91CC\u7684\u5CA9\u77F3\u5730\u5E26\u5F88\u8FD1\u54E6\u3002[VAR 0114(0006)]",
  "\u542C\u8BF4\u90A3\u5BB6\u4F19\u603B\u662F\\n\u50CF\u5CA9\u77F3\u4E00\u6837\u8D34\u5728\u5899\u58C1\u4E0A\uFF0C\\r\\n\u4F3A\u673A\u6355\u6349\u730E\u7269\u5462\uFF01[VAR 0114(0006)]",
  "\u4E0D\u8FC7\uFF0C\u8981\u662F\u5149\u987E\u7740\u627E\u5B9D\u4E3B\uFF0C\\n\u4ECE\u60AC\u5D16\u4E0A\u6389\u4E0B\u6765\u53EF\u5C31\u4E0D\u5F97\u4E86\u4E86\uFF01\\c\\n\u8FD9\u79CD\u65F6\u5019\u8981\u7528\u5730\u56FEApp\\n\u53EB\u98DE\u7FD4\u51FA\u79DF\u8F66\u6765\u3002\\c\\n\u56E0\u4E3A\u5CA9\u77F3\u5730\u5E26\u5F88\u591A\uFF0C\\n\u5730\u5F62\u4F1A\u50CF\u5929\u7136\u7684\u8FF7\u5BAB\u4E00\u6837\u3002\\r\\n\u52AA\u529B\u53BB\u627E\uFF0C\u4F46\u4E0D\u8981\u8FF7\u8DEF\u554A\uFF01\\r\\n\u8981\u662F\u627E\u5230\u5B9D\u4E3B\u4E86\uFF0C\u5C31\u62DC\u6258\u4F60\u5566\uFF01[VAR 0114(0006)]"
]
