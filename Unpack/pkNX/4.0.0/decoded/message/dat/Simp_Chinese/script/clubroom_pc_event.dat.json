  "\u90A3\u3001\u90A3\u4E48\uFF0C\u6211\u9A6C\u4E0A\u5C31\\n\u51FA\u53D1\u53BB\u4F60\u90A3\u8FB9\uFF01[VAR 0114(0055)]"
