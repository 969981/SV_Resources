  "\u4F60\u5728\u7528\u5165\u53E3\u5904\u7684\u697C\u68AF\\n\u953B\u70BC\u817F\u811A\u5417\uFF1F[VAR 0114(0006)]",
  "\u2026\u2026\u55EF\uFF1F\u54E6\u54E6\uFF0C\\n\u6211\u554A\uFF0C\u6211\u662F\u5728\u90A3\u4E2A\uFF0C\\r\\n\u7EE7\u7EED\u5BFB\u627E\u81EA\u6211\u3002[VAR 0114(0006)]",
  "\u6211\u5728\u5165\u53E3\u5904\u7684\u4E66\u67B6\u4E0A\\n\u80E1\u4E71\u7FFB\u6211\u5988\u7684\u7814\u7A76\u62A5\u544A\u65F6\uFF0C\\r\\n\u627E\u5230\u4E86\u8FD9\u672C\u4E66\u3002[VAR 0114(0006)]",
  "\u6211\u5728\u5165\u53E3\u5904\u7684\u4E66\u67B6\u4E0A\\n\u80E1\u4E71\u7FFB\u6211\u7238\u7684\u7814\u7A76\u62A5\u544A\u65F6\uFF0C\\r\\n\u627E\u5230\u4E86\u8FD9\u672C\u4E66\u3002[VAR 0114(0006)]",
  "\u706F\u5854\u7684\u7814\u7A76\u6240\u91CC\u4E5F\u6709\u4E00\u672C\uFF0C\\n\u5BF9\u6211\u5988\u6765\u8BF4\u662F\u975E\u5E38\u91CD\u8981\u7684\u4E66\u2026\u2026\\r\\n\u53EB\u4EC0\u4E48\u300A\u6731\u4E4B\u4E66\u300B\u6765\u7740\uFF1F[VAR 0114(0006)]",
  "\u706F\u5854\u7684\u7814\u7A76\u6240\u91CC\u4E5F\u6709\u4E00\u672C\uFF0C\\n\u5BF9\u6211\u7238\u6765\u8BF4\u662F\u975E\u5E38\u91CD\u8981\u7684\u4E66\u2026\u2026\\r\\n\u53EB\u4EC0\u4E48\u300A\u7D2B\u4E4B\u4E66\u300B\u6765\u7740\uFF1F[VAR 0114(0006)]",
  "\u6211\u662F\u7B2C\u4E00\u6B21\u8BA4\u771F\u8BFB\u79D8\u4F20\u8C03\u5473\u6599\\n\u4EE5\u5916\u7684\u5185\u5BB9\uFF0C\u8D85\u5389\u5BB3\u7684\uFF01[VAR 0114(0006)]",
  "\u867D\u7136\u5185\u5BB9\u5F88\u53EF\u7591\uFF0C\u4F46\u4E5F\u5F88\u6709\u8DA3\uFF01\\n\u91CC\u9762\u8FD8\u914D\u4E86\u63D2\u56FE\uFF0C\u633A\u597D\u8BFB\u7684\uFF01[VAR 0114(0006)]",
  "\u6765\uFF0C\u4F60\u770B\u770B\u8FD9\u91CC\u4E4B\u7C7B\u7684\uFF01[VAR 0114(0006)]",
  "\u8FD9\u4E00\u9875\u7684\u6587\u5B57\u5728\u6BCF\u672C\u4E66\u91CC\\n\u5168\u90FD\u6A21\u7CCA\u4E0D\u6E05\uFF0C\u65E0\u6CD5\u9605\u8BFB\u3002\\r\\n\u611F\u89C9\u5B83\u7684\u5185\u5BB9\u4E00\u5B9A\u5F88\u4E0D\u7B80\u5355\u3002[VAR 0114(0006)]",
  "\u867D\u7136\u8FD9\u672C\u4E66\u91CC\u5C3D\u662F\u4E9B\u7834\u5929\u8352\u7684\u5185\u5BB9\uFF0C\\n\u53EF\u662F\u79D8\u4F20\u8C03\u5473\u6599\u4E5F\u786E\u5B9E\u627E\u5230\u4E86\u3002\\c\\n\u52A0\u4E0A\u6211\u4EEC\u5728\u7B2C\u96F6\u533A\u7684\u90A3\u79CD\u7ECF\u5386\uFF0C\\n\u91CC\u9762\u662F\u4E0D\u662F\u5168\u5728\u778E\u626F\uFF0C\u8FD8\u771F\u4E0D\u597D\u8BF4\uFF5E[VAR 0114(0006)]",
  "\u800C\u4E14\u554A\uFF0C\u53EF\u80FD\u6B63\u662F\u8BFB\u4E86\u8FD9\u672C\u4E66\uFF0C\\n\u6211\u5988\u624D\u7ACB\u5FD7\u4E8E\u7814\u7A76\u7684\u3002[VAR 0114(0006)]",
  "\u800C\u4E14\u554A\uFF0C\u53EF\u80FD\u6B63\u662F\u8BFB\u4E86\u8FD9\u672C\u4E66\uFF0C\\n\u6211\u7238\u624D\u7ACB\u5FD7\u4E8E\u7814\u7A76\u7684\u3002[VAR 0114(0006)]",
  "[VAR 1107(00FF,0101)]\u5979\u4ED6\u4E00\u5B9A\u662F\u88AB\u8FD9\u672C\u4E66\u91CC\u63D0\u5230\u7684\\n\u53E4\u4EE3\u7684\u5B9D\u53EF\u68A6\u6240\u5438\u5F15\uFF0C\\r\\n\u624D\u60F3\u8981\u4EB2\u773C\u89C1\u5230\u5B83\u5427\u3002[VAR 0114(0006)]",
  "[VAR 1107(00FF,0101)]\u5979\u4ED6\u4E00\u5B9A\u662F\u88AB\u8FD9\u672C\u4E66\u91CC\u63D0\u5230\u7684\\n\u672A\u6765\u7684\u5B9D\u53EF\u68A6\u6240\u5438\u5F15\uFF0C\\r\\n\u624D\u60F3\u8981\u4EB2\u773C\u89C1\u5230\u5B83\u5427\u3002[VAR 0114(0006)]",
  "\u54A6\uFF1F\u56E0\u4E3A\u6211\u5988\u9020\u51FA\u4E86\u65F6\u5149\u673A\uFF0C\\n\u6240\u4EE5\u53E4\u4EE3\u7684\u5B9D\u53EF\u68A6\\r\\n\u624D\u4F1A\u6765\u5230\u8FD9\u91CC\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0006)]",
  "\u54A6\uFF1F\u56E0\u4E3A\u6211\u7238\u9020\u51FA\u4E86\u65F6\u5149\u673A\uFF0C\\n\u6240\u4EE5\u672A\u6765\u7684\u5B9D\u53EF\u68A6\\r\\n\u624D\u4F1A\u6765\u5230\u8FD9\u91CC\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0006)]",
  "\u5728\u9020\u51FA\u65F6\u5149\u673A\u4E4B\u524D\u7684\u4E66\u91CC\\n\u63D0\u5230\u4E86\u53E4\u4EE3\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD9\u4E0D\u5408\u7406\u5427\u2026\u2026\uFF1F[VAR 0114(0006)]",
  "\u5728\u9020\u51FA\u65F6\u5149\u673A\u4E4B\u524D\u7684\u4E66\u91CC\\n\u63D0\u5230\u4E86\u672A\u6765\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD9\u4E0D\u5408\u7406\u5427\u2026\u2026\uFF1F[VAR 0114(0006)]",
