  "\u8FD9\u4E0D\u662F[VAR 0100(0000)]\u5417\uFF01\\n\u4F60\u7684\u5BF9\u624B\u662F\u5C0F\u751F\uFF01\\r\\n\u8BF7\u591A\u591A\u5173\u7167\u4E86\u3002[VAR 0114(0012)]",
