  "\u867D\u7136\u5F88\u4E0D\u7518\u5FC3\uFF0C\u4F46\u662F\u6211\u8F93\u4E86\uFF01\\n\u795D\u4F60\u4E0B\u4E00\u573A\u5BF9\u6218\u4E5F\u82F1\u52C7\u5A01\u6B66\uFF01[VAR 0114(0024)]",
  "\u54CE\u5440\uFF0C\u662F[VAR 0100(0000)]\u5440\u3002\\n\u8BF7\u624B\u4E0B\u7559\u60C5\u54E6\u3002[VAR 0114(0025)]",
