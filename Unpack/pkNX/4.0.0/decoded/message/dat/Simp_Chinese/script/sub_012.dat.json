  "\u5BF9\u3001\u5BF9\u624B\u5C31\u7B97\u662F[VAR 0100(0000)]\u4F60\uFF0C\\n\u6211\u4E5F\u4F1A\u7528\u5E03\u5E03\u4EEC\u597D\u597D\u6559\u8BAD\u4F60\u4E00\u756A\u7684\u2026\u2026\uFF01[VAR 0114(0008)]",
  "\u679C\u7136[VAR 0100(0000)]\u4F60\u597D\u5F3A\u2026\u2026\\n\u4E0D\u8FC7\uFF0C\u603B\u89C9\u5F97\u5F88\u503C\u5F97\u9A84\u50B2\u5462\u3002[VAR 0114(0008)]",
