  "\u80FD\u548C[VAR 0100(0000)]\u4F60\u5BF9\u6218\uFF0C\u6211\u5F88\u8363\u5E78\u3002\\n\u6211\u4F1A\u62FC\u5C3D\u5168\u529B\u7684\uFF5E[VAR 0114(002A)]",
