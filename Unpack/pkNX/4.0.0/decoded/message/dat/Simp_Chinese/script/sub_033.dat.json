[
  "\u6D1B\u6258\u6D1B\u6258\u6D1B\u6258\u6D1B\u6258\u2026\u2026",
  "\u4F60\u597D\u554A\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u662F\u5409\u5C3C\u4E9A\u3002[VAR 0114(002A)]",
  "\u4F60\u5728\u592A\u6676\u56E2\u4F53\u6218\\n\u591A\u6B21\u594B\u52C7\u6218\u6597\uFF0C\\r\\n\u771F\u7684\u975E\u5E38\u611F\u8C22\uFF5E[VAR 0114(002A)]",
  "\u591A\u4E8F\u4E86[VAR 0100(0000)]\u4F60\uFF0C\\n\u8C03\u67E5\u624D\u5F97\u4EE5\u8FDB\u5C55\uFF0C\u6709\u4E86\u4E00\u4E9B\u53D1\u73B0\u3002[VAR 0114(002A)]",
  "\u770B\u6765\uFF0C\u4ECE\u5E15\u5E95\u4E9A\u5DE8\u5751\\n\u6709\u65F6\u4F1A\u653E\u5C04\u51FA\u592A\u6676\u80FD\u91CF\uFF0C\\r\\n\u4F3C\u4E4E\u5BF9\u7ED3\u6676\u9020\u6210\u4E86\u5F71\u54CD\u3002[VAR 0114(002A)]",
  "\u592A\u6676\u56E2\u4F53\u6218\u53D7\u5230\u683C\u5916\u5F3A\u70C8\u7684\u5F71\u54CD\u540E\uFF0C\\n\u5176\u7ED3\u6676\u4F3C\u4E4E\u4F1A\u53D8\u6210[VAR FF00(0006)]\u9ED1\u8272\u7ED3\u6676[VAR FF00(0000)]\uFF5E[VAR 0114(002A)]",
  "\u9ED1\u8272\u7ED3\u6676\u7684\u592A\u6676\u5B9D\u53EF\u68A6\\n\u5B9E\u5728\u592A\u5F3A\u5927\u4E86\u2026\u2026[VAR 0114(002A)]",
  "\u4E00\u822C\u7684\u8BAD\u7EC3\u5BB6\\n\u6839\u672C\u4E0D\u662F\u5B83\u7684\u5BF9\u624B\u3002[VAR 0114(002A)]",
  "\u54EA\u6015\u5BF9[VAR 0100(0000)]\u4F60\u6765\u8BF4\uFF0C\\n\u4E5F\u662F\u975E\u5E38\u5371\u9669\u7684\u2026\u2026[VAR 0114(002A)]",
  "\u4F60\u542C\u597D\u4E86\uFF1F\u5C31\u7B97\u901A\u8FC7\\n\u5730\u56FEApp\u786E\u8BA4\u5230\u6240\u5728\u5730\uFF0C\\c\\n\u9ED1\u8272\u7ED3\u6676\u4E5F\u5B9E\u5728\u592A\u5371\u9669\u4E86\uFF0C\\n\u7EDD\u5BF9\u4E0D\u8981\u53BB\u6311\u6218\u54E6\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6211\u77E5\u9053\u4E86\uFF01",
  "\u8FD9\u4E2A\u4E0D\u597D\u8BF4\u2026\u2026",
  "\u5514\uFF5E\u55EF\uFF0C\u4F60\u7B54\u5E94\u5F97\u592A\u723D\u5FEB\u4E86\uFF0C\\n\u6709\u4E9B\u4EE4\u4EBA\u6000\u7591\u554A\u2026\u2026[VAR 0114(002A)]",
  "\u4E0D\u4E0D\uFF0C\u8FD9\u53EF\u4E0D\u662F\\n\u542B\u7CCA\u5176\u8F9E\u7684\u65F6\u5019\u554A\uFF5E[VAR 0114(002A)]",
  "\u5F88\u62B1\u6B49\u628A\u4F60\u5377\u8FDB\u6B64\u4E8B\u4E4B\u4E2D\uFF0C\\n\u4F46\u662F\u771F\u7684\u5F88\u5371\u9669\u54E6\uFF5E\uFF01\\r\\n\u4E0D\u53EF\u4EE5\u6311\u6218\u9ED1\u8272\u7ED3\u6676\uFF0C\u7EDD\u5BF9\u4E0D\u884C\uFF01[VAR 0114(002A)]",
  "\u90A3\u5C31\u8BF4\u5230\u8FD9\u91CC\uFF0C\\n\u62DC\u6258\u4F60\u4E86\uFF5E\uFF01[VAR 0114(002A)]"
]
