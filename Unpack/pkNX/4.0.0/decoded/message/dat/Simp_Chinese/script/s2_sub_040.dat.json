[
  "[VAR 0100(0000)]\u4ECE\u8001\u5E08\u90A3\u91CC\\n\u83B7\u5F97\u4E86[VAR 0204(0001,0000)]\uFF22\uFF30\uFF01",
  "\u6765\u4EA4\u6362\u7559\u5B66\u7684\u5B66\u751F\uFF01\\n\u6211\u662F\u8F85\u5BFC\u8001\u5E08\uFF01",
  "\u6211\u5C31\u5F00\u95E8\u89C1\u5C71\u5730\u95EE\u4E86\uFF0C\\n\u4F60\u5E73\u65F6\u5728\u6253\u5B9D\u53EF\u68A6\u5BF9\u6218\u5417\uFF01\uFF1F",
  "\u5728\u84DD\u8393\u5B66\u56ED\uFF0C\u6211\u4EEC\u5E0C\u671B\u80FD\u8BA9\u5B66\u751F\u4EEC\\n\u4E92\u76F8\u5BF9\u6218\u7684\u6C14\u6C1B\u9AD8\u6DA8\u8D77\u6765\u3002\\c\\n\u56E0\u6B64\u53EA\u8981\u5728\u5DE8\u86CB\u91CC\u548C\u5176\u4ED6\u5B66\u751F\u5BF9\u6218\uFF0C\\n\u5C31\u80FD\u83B7\u5F97\u6211\u4EEC\u9001\u51FA\u7684\uFF22\uFF30\uFF0C\\r\\n\u800C\u4E14\u5BF9\u6218\u8D8A\u591A\uFF0C\u9001\u5F97\u5C31\u8D8A\u591A\uFF01",
  "\u9996\u5148\uFF0C\u4F60\u5C31\u8BD5\u7740\u5728\u8349\u539F\u533A\u8FD9\u91CC\\n\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\u5427\uFF01",
  "\u9996\u5148\uFF0C\u4F60\u5C31\u8BD5\u7740\u5728\u5CE1\u8C37\u533A\u8FD9\u91CC\\n\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\u5427\uFF01",
  "\u9996\u5148\uFF0C\u4F60\u5C31\u8BD5\u7740\u5728\u6D77\u5CB8\u533A\u8FD9\u91CC\\n\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\u5427\uFF01",
  "\u9996\u5148\uFF0C\u4F60\u5C31\u8BD5\u7740\u5728\u6781\u5730\u533A\u8FD9\u91CC\\n\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\u5427\uFF01",
  "\u5728\u8349\u539F\u533A\uFF0C\\n\u4F60\u6218\u80DC\u4E86\u2026\u2026\\r\\n[VAR 0201(0003)]\u4F4D\u5B66\u751F\uFF01",
  "\u5728\u5CE1\u8C37\u533A\uFF0C\\n\u4F60\u6218\u80DC\u4E86\u2026\u2026\\r\\n[VAR 0201(0003)]\u4F4D\u5B66\u751F\uFF01",
  "\u5728\u6D77\u5CB8\u533A\uFF0C\\n\u4F60\u6218\u80DC\u4E86\u2026\u2026\\r\\n[VAR 0201(0003)]\u4F4D\u5B66\u751F\uFF01",
  "\u5728\u6781\u5730\u533A\uFF0C\\n\u4F60\u6218\u80DC\u4E86\u2026\u2026\\r\\n[VAR 0201(0003)]\u4F4D\u5B66\u751F\uFF01",
  "\u7B49\u4F60\u603B\u5171\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\u4E4B\u540E\uFF0C\\n\u518D\u6765\u627E\u6211\u5427\uFF01",
  "\u4F60\u5F88\u52AA\u529B\u554A\uFF01\\n\u79EF\u6781\u5730\u548C\u4EBA\u5BF9\u6218\uFF0C\u771F\u4E86\u4E0D\u8D77\uFF01",
  "\u6211\u5C31\u9001\u4F60\uFF22\uFF30\u5F53\u4F5C\u52AA\u529B\u5956\u5427\uFF01",
  "\u53E6\u5916\u518D\u591A\u9001\u4F60\u4E00\u4E2A\u5956\u54C1\uFF01",
  "\u4E0B\u4E00\u4E2A\u76EE\u6807\u662F\u2026\u2026\\n\u6218\u80DC[VAR 0201(0002)]\u4F4D\u5B66\u751F\uFF0C\u4F46\u662F\u2026\u2026\\r\\n\u4F60\u5DF2\u7ECF\u5B8C\u6210\u4E86\uFF01\uFF1F",
  "\u7B49\u4F60\u5C3D\u60C5\u5BF9\u6218\u4E4B\u540E\uFF0C\\n\u518D\u6765\u62FF\u5956\u54C1\u5427\uFF01",
  "\u96BE\u9053\u8BF4\u2026\u2026\u4F60\uFF01\\c\\n\u597D\u50CF\u5DF2\u7ECF\u6218\u80DC\u4E86\\n\u8349\u539F\u533A\u7684\u6240\u6709\u5B66\u751F\uFF01",
  "\u96BE\u9053\u8BF4\u2026\u2026\u4F60\uFF01\\c\\n\u597D\u50CF\u5DF2\u7ECF\u6218\u80DC\u4E86\\n\u5CE1\u8C37\u533A\u7684\u6240\u6709\u5B66\u751F\uFF01",
  "\u96BE\u9053\u8BF4\u2026\u2026\u4F60\uFF01\\c\\n\u597D\u50CF\u5DF2\u7ECF\u6218\u80DC\u4E86\\n\u6D77\u5CB8\u533A\u7684\u6240\u6709\u5B66\u751F\uFF01",
  "\u96BE\u9053\u8BF4\u2026\u2026\u4F60\uFF01\\c\\n\u597D\u50CF\u5DF2\u7ECF\u6218\u80DC\u4E86\\n\u6781\u5730\u533A\u7684\u6240\u6709\u5B66\u751F\uFF01",
  "\u4F60\u8FD9\u4E48\u52AA\u529B\uFF0C\\n\u6211\u8981\u7ED9\u4F60\u65E0\u4E0E\u4F26\u6BD4\u52AA\u529B\u5956\uFF01",
  "\u53E6\u5916\uFF0C\u8FD8\u8981\u591A\u9001\u4F60\u4E00\u4E2A\\n\u65E0\u4E0E\u4F26\u6BD4\u7684\u5956\u54C1\uFF01",
  "\u5176\u4ED6\u533A\u57DF\u4E5F\u4F1A\u6709\u8001\u5E08\u5728\uFF0C\\n\u6240\u4EE5\u4F60\u5728\u5176\u4ED6\u533A\u57DF\u4E5F\u8981\u52A0\u6CB9\u54E6\uFF01",
  "\u4F60\u6218\u80DC\u4E86\\n\u5168\u90E8\u533A\u57DF\u7684\u6240\u6709\u5B66\u751F\u3002\\r\\n\u4E3A\u6B64\uFF0C\u8001\u5E08\u6211\u8981\u7ED9\u4F60\u5DE8\u86CB\u6700\u4F73\u5B66\u751F\u5956\uFF01",
  "\u4ECA\u540E\u4F60\u4E5F\u8981\u597D\u597D\u4EAB\u53D7\\n\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u4E50\u8DA3\u54E6\uFF01",
  "\u4F60\u5C45\u7136\u5728\u8349\u539F\u533A\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\\n\u6218\u80DC\u4E86\u6240\u6709\u5B66\u751F\uFF01\u597D\u5389\u5BB3\uFF01",
  "\u4F60\u5C45\u7136\u5728\u5CE1\u8C37\u533A\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\\n\u6218\u80DC\u4E86\u6240\u6709\u5B66\u751F\uFF01\u597D\u5389\u5BB3\uFF01",
  "\u4F60\u5C45\u7136\u5728\u6D77\u5CB8\u533A\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\\n\u6218\u80DC\u4E86\u6240\u6709\u5B66\u751F\uFF01\u597D\u5389\u5BB3\uFF01",
  "\u4F60\u5C45\u7136\u5728\u6781\u5730\u533A\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E2D\\n\u6218\u80DC\u4E86\u6240\u6709\u5B66\u751F\uFF01\u597D\u5389\u5BB3\uFF01"
]
