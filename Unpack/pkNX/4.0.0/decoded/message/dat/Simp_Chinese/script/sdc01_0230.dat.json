[
  "\u8BF4\u6765\u8BDD\u957F\uFF0C\\n\u4F60\u8981\u542C\u5417\uFF1F[VAR 0114(0030)]",
  "\u7B49\u4F60\u60F3\u542C\u7684\u65F6\u5019\uFF0C\\n\u5C31\u6765\u544A\u8BC9\u6211\u5427\u3002[VAR 0114(0030)]",
  "\u6211\u4E5F\u662F\u4ECE\u6211\u7236\u4EB2\u90A3\u91CC\u542C\u6765\u7684\u2026\u2026\\n\u8FD9\u4E2A\u6545\u4E8B\u53EA\u5728\u6211\u4EEC\u4E00\u65CF\u5185\u53E3\u53E3\u76F8\u4F20\u3002[VAR 0114(0030)]",
  "\u8FD9\u662F\u4E2A\u771F\u5B9E\u7684\u6545\u4E8B\uFF0C\\n\u4E0D\u80FD\u544A\u8BC9\u6751\u5B50\u91CC\u7684\u5176\u4ED6\u4EBA\u3002[VAR 0114(0030)]",
  "\u4F60\u4EEC\u7EDD\u5BF9\u4E0D\u53EF\u5916\u4F20\u3002[VAR 0114(0030)]",
  "\u55EF\uFF0C\u6211\u77E5\u9053\u4E86\u2026\u2026[VAR 0114(0044)]",
  "\u5F88\u4E45\u5F88\u4E45\u4EE5\u524D\uFF0C\u6709\u4E2A\u6765\u81EA\u5F02\u56FD\u4ED6\u4E61\u7684\\n\u7537\u4EBA\u548C\u9B3C\u8FF7\u8DEF\u6765\u5230\u4E86\u5317\u4E0A\u4E61\u3002[VAR 0114(0030)]",
  "\u6751\u91CC\u7684\u4EBA\u4EEC\u5BB3\u6015\u4ED6\u4EEC\\n\u4E0D\u540C\u4E8E\u81EA\u5DF1\u7684\u5916\u8868\u2026\u2026[VAR 0114(0030)]",
  "\u4E8E\u662F\u4FBF\u4E0D\u5141\u8BB8\\n\u7537\u4EBA\u548C\u9B3C\u9760\u8FD1\u81EA\u5DF1\u7684\u6751\u5B50\u3002[VAR 0114(0030)]",
  "\u7537\u4EBA\u548C\u9B3C\u56E0\u4E3A\u6CA1\u6709\u53D7\u5230\\n\u6751\u6C11\u4EEC\u7684\u6B22\u8FCE\u800C\u611F\u5230\u5F88\u96BE\u8FC7\u2026\u2026[VAR 0114(0030)]",
  "\u4F46\u662F\u53EA\u8981\u80FD\u5728\u4E00\u8D77\uFF0C\u4ED6\u4EEC\u5C31\u5F88\u5E78\u798F\u4E86\uFF0C\\n\u4E8E\u662F\u5C31\u5728\u540E\u5C71\u7684\u6D1E\u7A9F\u8FC7\u8D77\u4E86\u7B80\u6734\u7684\u751F\u6D3B\u3002[VAR 0114(0030)]",
  "\u53EA\u6709\u6751\u91CC\u7684\u9762\u5177\u5DE5\u5320\\n\u89C9\u5F97\u4ED6\u4EEC\u5F88\u53EF\u601C\u2026\u2026[VAR 0114(0030)]",
  "\u4E8E\u662F\u5C31\u5E2E\u7537\u4EBA\u548C\u9B3C\\n\u5236\u4F5C\u4E86\u597D\u51E0\u4E2A\u9762\u5177\u3002[VAR 0114(0030)]",
  "\u9762\u5177\u4E0A\u88C5\u9970\u7740\u7537\u4EBA\u4ECE\u5F02\u56FD\u5E26\u6765\u7684\u5B9D\u77F3\uFF0C\\n\u95EA\u95EA\u53D1\u5149\uFF0C\u534E\u4E3D\u81F3\u6781\u3002[VAR 0114(0030)]",
  "\u53EA\u8981\u6234\u4E0A\u9762\u5177\uFF0C\u5C31\u80FD\u628A\u8138\u906E\u4F4F\uFF0C\\n\u548C\u6751\u6C11\u4EEC\u53CB\u597D\u76F8\u5904\u3002[VAR 0114(0030)]",
  "\u7537\u4EBA\u548C\u9B3C\u56E0\u4E3A\u9762\u5177\u5DE5\u5320\u7684\u548C\u5584\\n\u800C\u611F\u5230\u975E\u5E38\u9AD8\u5174\uFF0C\u5E76\u5BF9\u5DE5\u5320\u611F\u6FC0\u4E0D\u5DF2\u3002[VAR 0114(0030)]",
  "\u4ECE\u6B64\uFF0C\u7537\u4EBA\u548C\u9B3C\u4F1A\u6234\u4E0A\u9762\u5177\uFF0C\\n\u5077\u5077\u53C2\u52A0\u6751\u5B50\u7684\u5E86\u5178\u3002[VAR 0114(0030)]",
  "\u8FD9\u5BF9\u795E\u79D8\u7EC4\u5408\u7684\u9762\u5177\\n\u5DE7\u593A\u5929\u5DE5\uFF0C\u5F88\u5FEB\u5927\u53D7\u597D\u8BC4\u3002[VAR 0114(0030)]",
  "\u6D88\u606F\u751A\u81F3\u4E00\u4E0B\u5B50\u5C31\\n\u4F20\u5230\u4E86\u8BB8\u591A\u9065\u8FDC\u7684\u56FD\u5EA6\u3002[VAR 0114(0030)]",
  "\u6216\u8BB8\u662F\u542C\u5230\u4E86\u8FD9\u4E16\u95F4\u7F55\u89C1\u7684\\n\u95EA\u4EAE\u9762\u5177\u7684\u4F20\u95FB\u2026\u2026[VAR 0114(0030)]",
  "\u51E0\u53EA\u8D2A\u5F97\u65E0\u538C\u7684\u5B9D\u53EF\u68A6\\n\u6765\u5230\u4E86\u5317\u4E0A\u4E61\u3002[VAR 0114(0030)]",
  "\u5B83\u4EEC\u5077\u5077\u6F5C\u5165\\n\u7537\u4EBA\u548C\u9B3C\u7684\u4F4F\u5904\u2026\u2026[VAR 0114(0030)]",
  "\u4F01\u56FE\u593A\u8D70\\n\u88AB\u6089\u5FC3\u4FDD\u7BA1\u7684\u9762\u5177\u3002[VAR 0114(0030)]",
  "\u7537\u4EBA\u78B0\u5DE7\u5728\u573A\uFF0C\\n\u52C9\u5F3A\u4FDD\u4F4F\u4E86\u4E00\u4E2A\u9762\u5177\u2026\u2026[VAR 0114(0030)]",
  "\u4F46\u5FC3\u6709\u4F59\u800C\u529B\u4E0D\u8DB3\uFF0C\\n\u5269\u4E0B\uFF13\u4E2A\u9762\u5177\u90FD\u88AB\u5B9D\u53EF\u68A6\u4EEC\u593A\u8D70\u4E86\u3002[VAR 0114(0030)]",
  "\u51E0\u4E2A\u65F6\u8FB0\u540E\uFF0C\\n\u5F53\u9B3C\u56DE\u5230\u6D1E\u7A9F\u540E\u2026\u2026[VAR 0114(0030)]",
  "\u5B83\u53D1\u73B0\u90A3\u91CC\u53EA\u7559\u4E0B\u4E86\\n\u4E89\u6597\u7684\u75D5\u8FF9\u548C\u7EFF\u8272\u7684\u9762\u5177\u3002[VAR 0114(0030)]",
  "\u6216\u8BB8\u662F\u4E3A\u4E86\u5BFB\u627E\u7537\u4EBA\uFF0C\\n\u9B3C\u6234\u7740\u7EFF\u8272\u7684\u9762\u5177\u4E0B\u5C71\u524D\u5F80\u6751\u5B50\u3002[VAR 0114(0030)]",
  "\u7136\u540E\u2026\u2026\u628A\u4E3E\u7740\u95EA\u95EA\u53D1\u5149\u7684\u9762\u5177\\n\u4E50\u5F00\u82B1\u7684\u5B9D\u53EF\u68A6\u4EEC\u901A\u901A\u5E72\u6389\u4E86\u3002[VAR 0114(0030)]",
  "\u6BEB\u4E0D\u77E5\u60C5\u7684\u6751\u6C11\u4EEC\\n\u5BF9\u773C\u524D\u53D1\u751F\u7684\u4E8B\u60C5\u4E00\u5934\u96FE\u6C34\u3002[VAR 0114(0030)]",
  "\u4ED6\u4EEC\u770B\u5230\u7684\u53EA\u662F\u9B3C\u5927\u53D1\u96F7\u9706\u7684\u6837\u5B50\uFF0C\\n\u5E76\u5BF9\u6B64\u611F\u5230\u975E\u5E38\u5BB3\u6015\u3002[VAR 0114(0030)]",
  "\u6751\u6C11\u4EEC\u4EE5\u4E3A\u662F\u90A3\uFF13\u53EA\u5B9D\u53EF\u68A6\\n\u4ECE\u9B3C\u7684\u9B54\u638C\u4E2D\u5B88\u62A4\u4E86\u6751\u5B50\u3002[VAR 0114(0030)]",
  "\u4E8E\u662F\u4EB2\u5207\u5730\u79F0\u5B83\u4EEC\u4E3A\u5B9D\u4F34\uFF0C\\n\u5E76\u539A\u846C\u4E86\u5B83\u4EEC\u3002[VAR 0114(0030)]",
  "\u53D7\u4F24\u7684\u9B3C\u6C89\u6D78\u5728\u60B2\u4F24\u4E4B\u4E2D\uFF0C\\n\u72EC\u81EA\u56DE\u5230\u540E\u5C71\u7684\u6D1E\u7A9F\u53BB\u4E86\u3002[VAR 0114(0030)]",
  "[~ 35]"
