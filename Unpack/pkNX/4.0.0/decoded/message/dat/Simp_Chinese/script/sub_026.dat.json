[
  "\u8FD9\u91CC\u662F\u5929\u661F\u961F\\n\u8FB9\u7F18\u5206\u5B50\u4E4B\u5BB6\u3002",
  "\u661F\u5C18\uFF1F\u5BA3\u6218\u516C\u544A\uFF1F\\n\u2026\u2026\u6211\u4EEC\u4E0D\u77E5\u9053\u554A\u3002\\r\\n\u53CD\u6B63\u6211\u4EEC\u548C\u672C\u90E8\u7684\u4EBA\u4E5F\u6CA1\u4EC0\u4E48\u8054\u7CFB\u3002",
  "\u867D\u7136\u6CA1\u529E\u6CD5\u62DB\u5F85\u4F60\u4EC0\u4E48\uFF0C\\n\u2026\u2026\u8FD9\u4E2A\u5C31\u9001\u7ED9\u4F60\u5427\u3002",
  "[VAR 0100(0000)]\u83B7\u5F97\u4E86\\n[VAR FF00(0008)]\u8FD0\u52A8\u5E3D\uFF08\u661F\u661F\uFF09[VAR FF00(0000)]\uFF01",
  "\u4F60\u60F3\u5F85\u5230\u4EC0\u4E48\u65F6\u5019\u90FD\u884C\uFF0C\\n\u4E5F\u53EF\u4EE5\u968F\u65F6\u79BB\u5F00\u3002",
  "\u8FD9\u91CC\u662F\u5929\u661F\u961F\\n\u8FB9\u7F18\u5206\u5B50\u4E4B\u5BB6\u3002",
  "\u6211\u4EEC\u53EA\u662F\u538C\u5026\u4E86\u961F\u91CC\u7684\u6D3B\u52A8\uFF0C\\n\u8FD8\u7792\u7740\u5176\u4ED6\u4EBA\u53BB\u4E0A\u5B66\u4E86\u54E6\u3002",
  "\u4E00\u5982\u65E2\u5F80\u5730\u5145\u6EE1\u6D3B\u529B\uFF0C\\n\u4ECA\u5929\u661F\u82E6\u4E86\uFF5E\uFF01",
  "\u8FD9\u91CC\u8C01\u4E5F\u4E0D\u4F1A\u8D77\u4E89\u6267\uFF0C\\n\u6240\u4EE5\u6BD4\u5B66\u6821\uFF0C\u6BD4\u5929\u661F\u961F\uFF0C\\r\\n\u6BD4\u5BB6\u91CC\u90FD\u66F4\u81EA\u5728\u3002"
]
