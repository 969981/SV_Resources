[
  "\u55E8\uFF5E\u963F\u7F57\u62C9\uFF01\\n\u6211\u8D85\u559C\u6B22\u963F\u7F57\u62C9\u7684\u5B9D\u53EF\u68A6\u54E6\uFF01",
  "\u6211\u60F3\u770B\u4E00\u773C\\n\u963F\u7F57\u62C9\u7684\u6837\u5B50\u7684\u9686\u9686\u5CA9\uFF0C\\r\\n\u4F60\u7684\u540C\u884C\u5B9D\u53EF\u68A6\u6216\u76D2\u5B50\u91CC\u6709\u5B83\u5417\uFF1F",
  "\u53EA\u6709\u9686\u9686\u5CA9\\n\u6211\u65E0\u8BBA\u5982\u4F55\u90FD\u627E\u4E0D\u5230\u2026\u2026",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u751A\u81F3\u90FD\u4E0D\u662F\u9686\u9686\u5CA9\u54E6\uFF01",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u53EA\u662F\u666E\u901A\u7684\u9686\u9686\u5CA9\u54E6\uFF01\uFF01\\r\\n\u6211\u60F3\u770B\u7684\uFF01\u662F\u5B83\u963F\u7F57\u62C9\u7684\u6837\u5B50\uFF01\uFF01",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u662F\u963F\u7F57\u62C9\u7684\u6837\u5B50\u7684\u9686\u9686\u5CA9\uFF01\uFF01",
  "\u5934\u4E0A\u7EFD\u5F00\u7684\u6837\u5B50\u5145\u6EE1\u5F02\u56FD\u60C5\u8C03\uFF01\\n\u7709\u6BDB\u548C\u80E1\u987B\u4E5F\u90FD\u5A01\u98CE\u51DB\u51DB\uFF5E\uFF01",
  "\u2026\u2026\u56E0\u4E3A\u8981\u901A\u8FC7\u8FDE\u63A5\u4EA4\u6362\u6765\u8FDB\u5316\uFF0C\\n\u6240\u4EE5\u5F88\u5C11\u4F1A\u9047\u5230\u91CE\u751F\u7684\u5427\u3002",
  "\u5728\u611F\u8C22\u4F60\u7684\u540C\u65F6\uFF0C\u8BF7\u4F60\u6765\u8BD5\u8BD5\\n\u8FD9\u4E2A\u65E2\u963F\u7F57\u62C9\u53C8\u9686\u9686\u5CA9\u7684\u52A8\u4F5C\u5427\uFF01",
  "[VAR 0100(0000)]\u4ECE\u5973\u5B69\u90A3\u91CC\\n\u5B66\u4F1A\u4E86[VAR FF00(0008)]\u7535\uFF3A\u52A8\u4F5C[VAR FF00(0000)]\uFF01",
  "\u7535\uFF3A\u59FF\u52BF\u7684\u91CD\u70B9\u5728\u4E8E\u624B\u7684\u89D2\u5EA6\uFF01\\n\u7136\u540E\u5C31\u662F\u8981\u5927\u58F0\u558A\u201C\u963F\u7F57\u62C9\u201D\u54E6\uFF01"
]
