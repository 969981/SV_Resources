[
  "[~ 64]",
  "[~ 64]",
  "\u55E8\uFF5E\u51A0\u519B\u3002[VAR 0114(004A)]",
  "\u84DD\u8393\u8054\u76DF\\n\u8F9B\u82E6\u54AF\u3002[VAR 0114(004A)]",
  "\u591A\u4E8F\u51A0\u519B\u6362\u4EBA\u4E86\uFF0C\\n\u7D27\u5F20\u7684\u7A7A\u6C14\u7F13\u548C\u5566\uFF01[VAR 0114(004A)]",
  "\u963F\u82E5\u6211\u554A\uFF5E\\n\u5012\u662F\u4E5F\u60F3\u548C\u4E4C\u6817\u5F00\u5FC3\u5730\u76F8\u5904\u2026\u2026[VAR 0114(004A)]",
  "\u2026\u2026\u4F46\u73B0\u5B9E\u603B\u662F\u6CA1\u6709\\n\u60F3\u8C61\u4E2D\u7684\u90A3\u4E48\u987A\u5229\u554A\uFF5E[VAR 0114(004A)]",
  "\u6CA1\u5173\u7CFB\uFF01",
  "\u603B\u6709\u4E00\u5929\u80FD\u884C\uFF01",
  "\u4E0D\u6127\u662F\u73B0\u4EFB\u51A0\u519B\uFF01\\n\u771F\u4F1A\u8BF4\u8BDD\uFF01[VAR 0114(004A)]",
  "\u2026\u2026\u6700\u540E\u5F04\u5F97\u597D\u50CF\\n\u6211\u5229\u7528\u4E86[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u4E00\u6837\u3002[VAR 0114(004A)]",
  "\u672C\u6765\u6CA1\u6253\u7B97\u8FD9\u6837\u7684\uFF0C\\n\u7ED3\u679C\u6211\u4E5F\u7A0D\u5FAE\u8BA4\u771F\u4E86\u8D77\u6765\u3002[VAR 0114(004A)]",
  "\u5BF9\u4E8E\u8FD9\u4E00\u70B9\uFF0C\\n\u518D\u6B21\u6536\u4E0B\u6211\u7684\u6B49\u610F\u5427\uFF5E[VAR 0114(004A)]",
  "\u55E8\uFF5E[VAR 0100(0000)]\u3002[VAR 0114(004A)]",
  "\u4F60\u8FD9\u4E2A\u8054\u76DF\u793E\u793E\u957F\uFF01\\n\u4ECA\u5929\u4E5F\u5728\u597D\u597D\u52A0\u6CB9\u5417\uFF5E\uFF1F[VAR 0114(004A)]",
  "\u793E\u957F\uFF01\uFF1F",
  "\u600E\u4E48\u56DE\u4E8B\uFF1F",
  "\u54CE\u5440\u5440\uFF1F\u6211\u6CA1\u8DDF\u4F60\u8BF4\u5417\uFF1F\\n\u8054\u76DF\u793E\u7684\u793E\u957F\u2026\u2026\\c\\n\u8981\u7531\u84DD\u8393\u8054\u76DF\u7684\u51A0\u519B\u62C5\u4EFB\u54E6\u3002[VAR 0114(004A)]",
  "\u6211\u521A\u77E5\u9053\uFF01",
  "\u6CA1\u542C\u8BF4\u8FC7",
  "\u90A3\u771F\u662F\u5931\u793C\u4E86\uFF01\\n\u603B\u4E4B\u5C31\u662F\u8FD9\u4E48\u4E00\u56DE\u4E8B\u513F\uFF01[VAR 0114(004A)]",
  "\u6CA1\u5173\u7CFB\uFF0C\u6CA1\u5173\u7CFB\uFF01\\n\u5927\u5BB6\u90FD\u4F1A\u5E2E\u4F60\u7684\uFF01[VAR 0114(004A)]",
  "\u6211\u5728\u5B9E\u529B\u6700\u5F3A\u7684\u65F6\u5019\uFF0C\\n\u4E5F\u6545\u610F\u4E0D\u8981\u51A0\u519B\u7684\u540D\u53F7\u3002[VAR 0114(004A)]",
  "\u8BA9\u56DB\u5929\u738B\u7684\u5927\u4F19\u513F\\n\u8F6E\u6D41\u62C5\u4EFB\u793E\u957F\u6765\u7740\uFF01\\r\\n\u2026\u2026\u56E0\u4E3A\u592A\u9EBB\u70E6\u4E86\u3002[VAR 0114(004A)]",
  "\u51FA\u4E86\u4E8B\u513F\u6709\u6211\u5E2E\u4F60\u515C\u7740\uFF0C\\n\u793E\u957F\u4F60\u5C31\u628A\u5FC3\u653E\u5BBD\uFF5E\u4E86\u5427\uFF5E\uFF01[VAR 0114(004A)]",
  "\u55E8\uFF0C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF0C\\n\u4E4B\u524D\u8DDF\u4F60\u8BF4\u7684\u5F53\u793E\u957F\u90A3\u4E8B\u513F\u2026\u2026[VAR 0114(004A)]",
  "\u201C\u628A\u5DE5\u4F5C\u5168\u63A8\u7ED9[VAR 0100(0000)]\uFF0C\\n \u6211\u89C9\u5F97\u8FD9\u6837\u4E0D\u597D\u54E6\uFF01\u201D[VAR 0114(004A)]",
  "\u2026\u2026\u6211\u88AB\u7D2B\u7AFD\u90A3\u5BB6\u4F19\\n\u8FD9\u6837\u72E0\u72E0\u5730\u8BAD\u4E86\u4E00\u987F\u3002[VAR 0114(004A)]",
  "\u81F3\u4ECA\u5077\u7684\u61D2\u4E5F\u88AB\u62FF\u51FA\u6765\u7B97\u8D26\uFF0C\\n\u7ED3\u679C\u5C31\u53D8\u6210\u6211\u6765\u5F53\u4E86\u2026\u2026[VAR 0114(004A)]",
  "\u52A0\u6CB9\uFF01",
  "\u606D\u559C\uFF01",
  "\u6055\u6211\u76F4\u8A00\uFF0C[VAR 0100(0000)]\uFF01\\n\u963F\u82E5\u6211\u89C9\u5F97\u554A\uFF5E\u4E0D\u60F3\u52A0\u6CB9\uFF5E\uFF01[VAR 0114(004A)]",
  "\u54E6\u54E6\uFF01\uFF1F[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF0C\\n\u60F3\u4E0D\u5230\u4F60\u8FD8\u633A\u4F1A\u8BF4\u8BDD\u7684\u554A\u3002[VAR 0114(004A)]",
  "\u554A\uFF5E\u597D\u9EBB\u70E6\uFF5E\\n\u9EBB\u70E6\u6B7B\u4E86\uFF5E[VAR 0114(004A)]",
  "\u4F60\u8981\u662F\u60F3\u5E2E\u5FD9\u4E86\uFF0C\\n\u968F\u65F6\u8FC7\u6765\u9886\u6D3B\u513F\u5E72\u5427\uFF5E[VAR 0114(004A)]",
  "\u8BF4\u8D77\u6765\uFF0C\u793E\u957F\u7684\u5DE5\u4F5C\\n\u5305\u62EC\u652F\u63F4\u793E\u5458\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(004A)]",
  "\u8FD9\u79CD\u5C0F\u4E8B\u7684\u8BDD\uFF0C\\n\u6211\u5012\u662F\u53EF\u4EE5\u505A\u4E00\u70B9\uFF5E\uFF01[VAR 0114(004A)]",
  "\u90A3\u4E48\u8BDD\u4E0D\u591A\u8BF4\uFF0C\u5F00\u59CB\u652F\u63F4\uFF01\\n\u6211\u4EEC\u6765\u4EA4\u6362\u5B9D\u53EF\u68A6\u5427\uFF5E\uFF01[VAR 0114(004A)]",
  "\u591F\u8C6A\u723D\uFF5E\uFF01\\n\u6211\u7684\u8BDD\u5F53\u7136\u662F\u9009\u94DD\u94A2\u9F99\uFF01\\r\\n[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u8981\u9009\u54EA\u53EA\u5462\uFF1F[VAR 0114(004A)]",
  "\u662F[VAR 0101(0001)]\u554A\uFF0C\u9009\u5F97\u597D\uFF01\\n\u4E0D\u6127\u662F\u51A0\u519B\u7684\u5B9D\u53EF\u68A6\uFF01\\c\\n\u867D\u7136\u6211\u5F88\u6015\u9EBB\u70E6\uFF0C\\n\u4F46\u6211\u4F1A\u597D\uFF5E\u597D\u7167\u987E\u8FD9\u5BB6\u4F19\u7684\u3002[VAR 0114(004A)]",
  "[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u8981\u7528[VAR 0101(0001)]\\n\u6765\u4EA4\u6362\u6211\u7684\u94DD\u94A2\u9F99\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(004A)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u554A\uFF5E[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u73B0\u5728\u4E0D\u4F1A\\n\u53EA\u6709\uFF11\u53EA\u540C\u884C\u7684\u5B9D\u53EF\u68A6\u5427\uFF1F\\c\\n\u8981\u662F\u6CA1\u6709\uFF12\u53EA\u4EE5\u4E0A\uFF0C\\n\u5C31\u6CA1\u6CD5\u4EA4\u6362\u54E6\u3002[VAR 0114(004A)]",
  "\u522B\u8BF4\u8FD9\u79CD\u8BDD\u554A\uFF5E\\n\u597D\u4E0D\u597D\uFF01\uFF1F\u914D\u5408\u4E00\u4E0B\u561B\uFF01[VAR 0114(004A)]",
  "\u4F60\u613F\u610F\u914D\u5408\u4E86\uFF01\uFF1F\\n\u90A3\u597D\uFF5E\u6211\u4EEC\u6765\u4EA4\u6362\u5B9D\u53EF\u68A6\u5427\uFF5E\uFF01[VAR 0114(004A)]",
  "\u563F\uFF0C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF0C\\n\u8981\u548C\u6211\u5BF9\u6218\u5417\uFF1F[VAR 0114(004A)]",
  "\u62D2\u7EDD\u4E5F\u4E0D\u662F\u574F\u4E8B\u554A\u3002\\n\u5565\u65F6\u5019\u90FD\u62FC\u5C3D\u5168\u529B\u662F\u4F1A\u7D2F\u7684\u3002[VAR 0114(004A)]",
  "\u90A3\u597D\uFF5E\\n\u5DEE\u4E0D\u591A\u53BB\u5BF9\u6218\u573A\u5427\u3002[VAR 0114(004A)]",
  "\u54CE\u5440\uFF0C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF01\\n\u6211\u60F3\u548C\u4F60\u6253\u7684\u662F\u53CC\u6253\u5BF9\u6218\uFF0C\\r\\n\u518D\u591A\u5E26\u4E00\u53EA\u5B9D\u53EF\u68A6\u6765\u5427\uFF5E[VAR 0114(004A)]",
  "\u548C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u5BF9\u6218\uFF0C\\n\u771F\u662F\u592A\u75DB\u5FEB\u5566\u3002[VAR 0114(004A)]",
  "\u4E3A\u4E86\u8868\u8FBE\u5E73\u65F6\u5BF9\u4F60\u7684\u611F\u8C22\uFF01\\n\u6211\u6709\u4EF6\u793C\u7269\u8981\u9001\u7ED9\u4F60\uFF5E[VAR 0114(004A)]",
  "\u5728\u8863\u67DC\u91CC\u653E\u5F97\u90FD\u5403\u7070\u4E86\u3002\\n\u4F60\u6536\u4E0B\u5B83\u5427\uFF5E[VAR 0114(004A)]",
  "\u563F\u563F\u563F\uFF0C\\n\u4E0A\u8863\u548C\u6211\u7684\u4E00\u6837\u54E6\uFF5E\\r\\n\u8FD9\u5C31\u53EB\u7A7F\u6210\u4E00\u5BF9\u513F\u554A\uFF01[VAR 0114(004A)]",
  "[VAR 0100(0000)]\u4ECE\u675C\u82E5\u90A3\u91CC\\n\u83B7\u5F97\u4E86[VAR FF00(0008)]\u8FD0\u52A8\u670D\u5957\u88C5\uFF08\u9ED1\u00D7\u91D1\uFF09[VAR FF00(0000)]\uFF01",
  "\u4F60\u7684\u5B9E\u529B\u53C8\uFF5E\u63D0\u9AD8\u4E86\uFF0C\\n\u4E0D\u6127\u662F\u6211\u7684[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\uFF01[VAR 0114(004A)]",
  "\u5982\u679C\u4E0D\u7ECF\u5E38\u548C\\n[VAR 0100(0000)]\u4F60\u8FC7\u62DB\u7684\u8BDD\uFF0C\\r\\n\u6211\u90FD\u53D8\u5F97\u4E0D\u80FD\u53D1\u6CC4\u538B\u529B\u4E86\u3002[VAR 0114(004A)]",
  "\u563F\u563F\u563F\uFF01\\n\u6361\u6F0F\u8D62\u4E86\u4E00\u628A\u3002\\c\\n\u4F60\u5C31\u7B97\u89C9\u5F97\u8F93\u4E86\u4E0D\u7518\u5FC3\uFF0C\\n\u4E5F\u522B\u50CF\u4E4C\u6817\u90A3\u6837\u8D70\u6781\u7AEF\u54E6\u3002[VAR 0114(004A)]",
  "\u4F60\u80AF\u5B9A\u4EE5\u4E3A\u6211\u8170\u4E0A\u7684\\n\u662F\u88D9\u5B50\u5427\uFF5E\uFF1F\\c\\n\u4E0D\u662F\u7684\uFF5E\u563F\u563F\u563F\uFF5E\uFF01\\n\u5176\u5B9E\u662F\u56F4\u7740\u6597\u7BF7\u54E6\u3002[VAR 0114(004A)]",
  "\u6211\u554A\uFF0C\u4E0D\u592A\u64C5\u957F\u7406\u8BBA\u8BFE\uFF5E\\n\u7559\u4E86\u5927\u6982\u2026\u2026\uFF13\u6B21\u7EA7\uFF1F\\c\\n\u6211\u6BD4\u5176\u4ED6\u7684\u5BB6\u4F19\u4EAB\u53D7\u4E86\\n\u66F4\u957F\u7684\u5B66\u56ED\u751F\u6D3B\uFF0C\u8D5A\u5230\u4E86\uFF5E[VAR 0114(004A)]",
  "\u6905\u5B50\u771F\u662F\u4E2A\u597D\u4E1C\u897F\uFF0C\\n\u6211\u7231\u6B7B\u6905\u5B50\u4E86\u3002\\c\\n\u660E\u660E\u7AD9\u7740\u5F88\u7D2F\uFF0C\\n\u4E3A\u5565\u5927\u5BB6\u90FD\u8981\u7AD9\u7740\u5462\uFF1F[VAR 0114(004A)]",
  "\u6211\u548C[VAR 1100(00FF,0101)]\u54E5\u59D0\u4EEC\u4F60\u7684[VAR 0101(0001)]\\n\u76F8\u5904\u5F97\u5F88\u597D\uFF5E\\c\\n\u6211\u4F1A\u50CF\u5BF9[VAR 0100(0000)]\u4F60\u4E00\u6837\\n\u75BC\u7231\u5B83\u7684\uFF0C\u4F60\u5C31\u653E\u5FC3\u5427\uFF5E[VAR 0114(004A)]",
  "\u6211\u7684\u94DD\u94A2\u9F99\u53EA\u8981\u8EAB\u4F53\u5149\u6ED1\uFF0C\\n\u5B83\u5C31\u7279\u9AD8\u5174\u3002\\c\\n\u8BB0\u5F97\u5076\u5C14\u5E2E\u5B83\\n\u597D\u597D\u6253\u78E8\u4E00\u4E0B\uFF5E[VAR 0114(004A)]"
]
