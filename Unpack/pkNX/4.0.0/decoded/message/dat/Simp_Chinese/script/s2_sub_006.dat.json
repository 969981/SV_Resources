[
  "\u8EAB\u4E3A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF01\\n\u6211\u5411\u5F80\u7740\u201C\u6700\u5F3A\u201D\u8FD9\u4E2A\u8BCD\u8BED\u554A\uFF01",
  "\u771F\u5E0C\u671B\u6709\u4E00\u5929\u6211\u80FD\u770B\u5230\\n\u6301\u6709\u6700\u5F3A\u4E4B\u8BC1\u7684\u5B9D\u53EF\u68A6\u554A\uFF01",
  "\u56E0\u4E3A\u4E0D\u662F\u80FD\u968F\u4FBF\u78B0\u4E0A\u7684\uFF0C\\n\u6240\u4EE5\u662F\u6700\u5F3A\u554A\uFF01",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u5E76\u6CA1\u6301\u6709\u6700\u5F3A\u4E4B\u8BC1\u554A\uFF01",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u662F\u6700\u5F3A\u7684[VAR 0101(0001)]\uFF01\uFF1F",
  "\u54E6\u54E6\u54E6\u2026\u2026\u771F\u5389\u5BB3\u554A\uFF5E\uFF01\\n\u771F\u8BA9\u4EBA\u5411\u5F80\u554A\uFF5E\uFF01",
  "\u8BA9\u6211\u6559\u4F60\u5728\u4F3D\u52D2\u5C14\u5730\u533A\u5F88\u6D41\u884C\u7684\\n\u6700\u5F3A\u52A8\u4F5C\u6765\u7B54\u8C22\u4F60\u5427\uFF01",
  "[VAR 0100(0000)]\u4ECE\u7537\u5B69\u90A3\u91CC\\n\u5B66\u4F1A\u4E86[VAR FF00(0008)]\u55B7\u706B\u9F99\u59FF\u52BF\u52A8\u4F5C[VAR FF00(0000)]\uFF01",
  "\u55B7\u706B\u9F99\u59FF\u52BF\u662F\\n\u4F3D\u52D2\u5C14\u5730\u533A\u51A0\u519B\\r\\n\u6700\u5F3A\u7684\u5E05\u6C14\u59FF\u52BF\u554A\uFF01"
]
