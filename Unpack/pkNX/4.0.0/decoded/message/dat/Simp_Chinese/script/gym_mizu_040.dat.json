  "\u4F60\u5F97\u5230\u9053\u9986\u5FBD\u7AE0\u7684\u77AC\u95F4\uFF01\\c\\n\u7528\u4FFA\u4E4B\u524D\u5C31\u4E00\u76F4\u60F3\u6446\u7684\\n\u4E0A\u76F8\u59FF\u52BF\u6765\u62CD\u5F20\u7EAA\u5FF5\u7167\u5427\uFF01[VAR 0114(0018)]",
  "\u6709[VAR 0200(0001)]\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u7B49\u7EA7[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4F1A\u66F4\u5BB9\u6613\u6349\u5230\uFF0C\\r\\n\u4E5F\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\uFF01[VAR 0114(0018)]",
  "\u6709\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u4E0D\u7BA1\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\uFF01[VAR 0114(0018)]",
  "\u5982\u679C\u662F\u4F60\u7684\u8BDD\uFF0C\u90A3\u8FD9\u4E2A\u62DB\u5F0F\u4E5F\u80FD\u719F\u7EC3\u4F7F\u7528\uFF01\\n\u8FD9\u53EF\u662F\u5410\u8840\u5927\u4F18\u5F85\uFF0C\u62FF\u53BB\u5427\uFF01[VAR 0114(0018)]",
  "\u597D\uFF0C\u4FFA\u5DEE\u4E0D\u591A\u4E5F\u8BE5\\n\u5F00\u59CB\u51C6\u5907\u5F00\u5E97\u4E86\uFF01[VAR 0114(0018)]",
  "\u6B22\u8FCE\u4F60\u518D\u5230\u5E97\u91CC\u6765\u554A\uFF0C\\n\u4FFA\u4F1A\u7B49\u4F60\u7684\uFF01[VAR 0114(0018)]",
  "\u606D\u559C\uFF01\\n\u4F60\u7A81\u7834\u4E86\u73BB\u74F6\u9053\u9986\uFF01"
