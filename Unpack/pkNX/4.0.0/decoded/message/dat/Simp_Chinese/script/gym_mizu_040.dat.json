  "\u62B1\u6B49\u554A\uFF0C\u5927\u4F19\uFF01\\n\u4FFA\u63A5\u4E0B\u6765\u8FD8\u6709\u9053\u9986\u7684\u5DE5\u4F5C\u8981\u505A\uFF01[VAR 0114(0018)]",
  "\u6709\u4EBA\u7B49\u7740\u4FFA\u5462\uFF0C\\n\u5927\u5BB6\u80FD\u4E0D\u80FD\u5148\u56DE\u53BB\u554A\uFF1F[VAR 0114(0018)]",
  "\u597D\uFF5E\uFF01",
  "\u662F\u4F60\u554A\uFF01\\n\u563F\uFF01\u5403\u4E86\u5417\uFF1F[VAR 0114(0018)]",
  "\u4F60\u5728\u6E0D\u6C81\u9547\\n\u5E2E\u4E86\u4FFA\u4E00\u4E2A\u5927\u5FD9\u554A\uFF01[VAR 0114(0018)]",
  "\u591A\u4E8F\u4E86\u4F60\uFF0C\u4FFA\u5E94\u8BE5\\n\u80FD\u505A\u51FA\u7A76\u6781\u7684\u88D9\u5E26\u83DC\u6599\u7406\u4E86\uFF01[VAR 0114(0018)]",
  "\u4E0D\u8FC7\uFF0C\u5728\u5BF9\u6218\u7684\u65F6\u5019\\n\u4FFA\u662F\u4E0D\u4F1A\u624B\u4E0B\u7559\u60C5\u7684\uFF01[VAR 0114(0018)]",
  "[~ 28]",
  "\u62CD\u5356\u6BD4\u7684\u662F\u4E70\u5356\u7684\u529F\u592B\uFF0C\\n\u9053\u9986\u6BD4\u7684\u662F\u62F3\u811A\u7684\u529F\u592B\u3002[VAR 0114(0018)]",
  "\u62DB\u5F0F\u7B56\u7565\u7684\u5BF9\u649E\uFF0C\\n\u5377\u8D77\u6F29\u6DA1\u7684\u5927\u6D77\uFF01[VAR 0114(0018)]",
  "\u6C34\u5C5E\u6027\u5B9D\u53EF\u68A6\u7684\u76DB\u5BB4\uFF01\\n\u6765\u6765\uFF0C\u5927\u53E3\u5927\u53E3\u5730\u54C1\u5C1D\u4E00\u4E0B\u5427\uFF01[VAR 0114(0018)]",
  "\u554A\u3001\u54C8\u3001\u54C8\uFF01\u4FFA\u8F93\u5F97\u5C31\u50CF\\n\u65E9\u5E02\u4E00\u6837\u4EE4\u4EBA\u795E\u6E05\u6C14\u723D\u554A\uFF01[VAR 0114(0018)]",
  "\u5728\u4F60\u770B\u6765\uFF0C\u4FFA\u5C31\u662F\u53EA\\n\u83DC\u677F\u4E0A\u7684\u9CA4\u9C7C\u738B\uFF01[VAR 0114(0018)]",
