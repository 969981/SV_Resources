[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8BF7\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u611F\u8C22\u5404\u4F4D\u540C\u5B66\\n\u5BF9\u4E0A\u6B21\u592A\u6676\u5316\u8BFE\u7A0B\u7684\u597D\u8BC4\u3002[VAR 0114(0012)]",
  "\u51F0\u6A97\u8001\u5E08\u4E5F\u5E0C\u671B\u5C0F\u751F\\n\u80FD\u6559\u7ED9\u540C\u5B66\u4EEC\u66F4\u591A\u7684\u5BF9\u6218\u77E5\u8BC6\uFF01\\r\\n\u2026\u2026\u8FD9\u662F\u5979\u4EB2\u81EA\u62DC\u6258\u5C0F\u751F\u7684\u3002[VAR 0114(0012)]",
  "\u56E0\u6B64\uFF0C\u7F8E\u672F\u8001\u5E08\u516B\u6714\uFF0C\u4E5F\u5C31\u662F\u5C0F\u751F\uFF0C\\n\u4ECA\u5929\u4E5F\u8981\u7EE7\u7EED\u8BB2\u592A\u6676\u5316\u54E6\u3002[VAR 0114(0012)]",
  "\u5706\u5706\u565C\u3002",
  "\u5F53\u7136\uFF0C\u5706\u9646\u9CA8\u524D\u8F88\u4E5F\u5728\u3002[VAR 0114(0012)]",
  "\u5706\u9646\u9CA8\u524D\u8F88\uFF0C\\n\u8BF7\u592A\u6676\u5316\u5427\uFF01[VAR 0114(0012)]",
  "\u5706\u54D2\uFF5E\uFF01",
  "\u54CE\u5440\uFF1F\\n\u4E0A\u6B21\u662F\u8349\u5C5E\u6027\u7684\u592A\u6676\uFF0C\\r\\n\u8FD9\u6B21\u5F62\u72B6\u4E0D\u540C\u4E86\u5462\u3002[VAR 0114(0012)]",
  "\u8FD9\u592A\u6676\u5B9D\u77F3\u5C31\u50CF\u662F\u96EA\u82B1\uFF0C\\n\u6811\u679D\u72B6\u7684\u5F62\u72B6\u771F\u7F8E\u554A\u3002[VAR 0114(0012)]",
  "\u9760\u8FD1\u7684\u8BDD\\n\u80FD\u611F\u53D7\u5230\u51C9\u51C9\u7684\u5BD2\u6C14\u5462\u3002[VAR 0114(0012)]",
  "\u90A3\u4E48\uFF0C\u8BF7\u95EE\u5404\u4F4D\u540C\u5B66\uFF0C\\n\u8FD9\u662F\u4EC0\u4E48\u592A\u6676\u5C5E\u6027\u5462\uFF1F[VAR 0114(0012)]",
  "\u6C34\u5C5E\u6027",
  "\u51B0\u5C5E\u6027",
  "\u5E7D\u7075\u5C5E\u6027",
  "[VAR 0100(0000)]\uFF0C\u771F\u53EF\u60DC\uFF01\\n\u8FD9\u662F\u6C34\u7684\u72B6\u6001\u6539\u53D8\u540E\u7684\u5C5E\u6027\u54E6\u3002[VAR 0114(0012)]",
  "[VAR 0100(0000)]\uFF01\\n\u4E00\u767E\u5206\u6EE1\u5206\uFF01[VAR 0114(0012)]",
  "[VAR 0100(0000)]\uFF0C\u771F\u53EF\u60DC\uFF01\\n\u786E\u5B9E\uFF0C\u51C9\u51C9\u7684\u8FD9\u4E00\u70B9\u662F\u540C\u6837\u7684\u5C31\u662F\u4E86\uFF01[VAR 0114(0012)]",
  "\u7B54\u6848\u63ED\u6653\u3002\u5706\u9646\u9CA8\u524D\u8F88\u7684\u5934\u4E0A\\n\u4E4B\u6240\u4EE5\u4F1A\u95EA\u8000\u7740\u96EA\u7684\u7ED3\u6676\uFF0C\\r\\n\u662F\u56E0\u4E3A\u5B83\u53D8\u6210\u4E86\u51B0\u5C5E\u6027\u3002[VAR 0114(0012)]",
  "\u7531\u4E8E\u5706\u9646\u9CA8\u524D\u8F88\u73B0\u5728\u662F\u51B0\u5C5E\u6027\u2026\u2026[VAR 0114(0012)]",
  "\u5E73\u65F6\u5BF9\u5B83\u80FD\u9020\u6210\uFF14\u500D\u4F24\u5BB3\u7684\u51B0\u5C5E\u6027\u62DB\u5F0F\uFF0C\\n\u73B0\u5728\u7684\u8BDD\uFF0C\u5374\u4F1A\u53D8\u6210\u6548\u679C\u4E0D\u597D\u5462\u3002[VAR 0114(0012)]",
  "\u5BF9\u4E86\uFF0C\u8BF4\u5230\u96EA\u7684\u7ED3\u6676\uFF0C\\n\u867D\u7136\u5B83\u6709\u5F88\u591A\u79CD\u5F62\u72B6\uFF0C\\r\\n\u4F46\u51E0\u4E4E\u90FD\u53EF\u4EE5\u88AB\u5F52\u7C7B\u4E3A\u516D\u89D2\u5F62\u3002[VAR 0114(0012)]",
  "\u5E76\u6CA1\u6709\u4EBA\u5B9A\u4E0B\u89C4\u5219\uFF0C\u4F46\u96EA\u82B1\u5374\u4F1A\\n\u5448\u73B0\u51FA\u540C\u6837\u7684\u5F62\u72B6\u5728\u51AC\u5929\u7FE9\u7FE9\u964D\u843D\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B66\u662F\u5426\u4E5F\u80FD\\n\u611F\u53D7\u5230\u5927\u81EA\u7136\u7684\u795E\u79D8\u5462\uFF1F[VAR 0114(0012)]",
  "\u2026\u2026\u54B3\u54B3\uFF01\\c\\n\u867D\u7136\u6CA1\u4EC0\u4E48\u5173\u7CFB\uFF0C\\n\u4F46\u5409\u5C3C\u4E9A\u8001\u5E08\u7684\u773C\u955C\u4E5F\u662F\u516D\u89D2\u5F62\u7684\u5462\u3002[VAR 0114(0012)]",
  "\u53E6\u5916\uFF0C\u5DEE\u70B9\u5FD8\u8BB0\u544A\u8BC9\u5404\u4F4D\u4E86\u3002\\n\u5B9D\u53EF\u68A6\u7684\u592A\u6676\u5C5E\u6027\u53EF\u4EE5\u5728\\r\\n\u9526\u6C47\u9547\u7684[VAR FF00(0006)]\u5B9D\u98DF\u5802[VAR FF00(0000)]\u66F4\u6539\u3002[VAR 0114(0012)]",
  "\u98DF\u5802\u7684\u5927\u53A8\u662F\u4E2A\u5F88\u96BE\u4F3A\u5019\u7684\u4EBA\uFF0C\\n\u8FD8\u5F97\u5148\u8BA9\u5979\u559C\u6B22\u4F60\u624D\u884C\u5C31\u662F\u4E86\u2026\u2026[VAR 0114(0012)]",
  "\u597D\u4E86\uFF0C\\n\u4E0B\u5802\u8BFE\u662F\u671F\u4E2D\u8003\u8BD5\u54E6\uFF01\\r\\n\u5706\u9646\u9CA8\u524D\u8F88\uFF0C\u4E5F\u8C22\u8C22\u4F60\u7684\u534F\u52A9\u4E86\uFF01[VAR 0114(0012)]",
  "\u95EA\u565C\u2026\u2026"
]
