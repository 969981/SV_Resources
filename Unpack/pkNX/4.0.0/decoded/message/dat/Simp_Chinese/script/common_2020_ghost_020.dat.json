  "\u5982\u679C\u9047\u5230\u8BA9\u4F60\u607C\u706B\u7684\u8BAD\u7EC3\u5BB6\\n\u6216\u5E7D\u7075\u7684\u8BDD\u5C31\u9A6C\u4E0A\u53EB\u6211\u554A\u3002\\r\\n\u6211\u4F1A\u52A9\u4F60\u4E00\u81C2\u4E4B\u529B\u7684\u3002[VAR 0114(001B)]",
  "\u5728\u8FD9\u4E2AGOOD\u7684\u4E16\u754C\u8BB4\u6B4C\u4EBA\u751F\u5427\uFF01\\n\u62DC\u62DC\uFF0C\u5B9D\u8D1D\uFF01[VAR 0114(001B)]"
