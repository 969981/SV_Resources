[
  "\u4F60\u660E\u660E\u5728\u4E0D\u4E45\u4E4B\u524D\\n\u624D\u521A\u6765\u53C2\u52A0\u9053\u9986\u6D4B\u9A8C\u2026\u2026[VAR 0114(001B)]",
  "\u73B0\u5728\u5374\u6210\u4E86\u51A0\u519B\uFF0C\\n\u8FD8\u66FF\u9996\u5E2D\u529E\u4E8B\u3002[VAR 0114(001B)]",
  "\u4E00\u5230\u8FD9\u4E2A\u5C81\u6570\uFF0C\\n\u5C31\u4F1A\u611F\u5230\u65F6\u95F4\u771F\u662F\u4E00\u6643\u800C\u8FC7\u554A\u3002[VAR 0114(001B)]",
  "\u2026\u2026\u591A\u6101\u5584\u611F\u7684\u611F\u89C9\u4E0D\u9002\u5408\u6211\uFF01\\n\u6700\u68D2\u7684\u83B1\u59C6IN DA HOUSE\uFF01[VAR 0114(001B)]",
  "\u7528\u52A8\u771F\u683C\u7684\u5BF9\u6218\\nCHECK OUT MY SOUL\uFF01[VAR 0114(001B)]",
  "\u5AE9\u53F6\u529B\u91CF\u5F88\u67D4\u5F31\uFF01\\n\u6210\u719F\u4E4B\u540E\u624D\u96C4\u539A\uFF01[VAR 0114(001B)]",
  "\u53D1\u6325\u672C\u9886SHAKE MY SOUL\uFF01[VAR 0114(001B)]",
