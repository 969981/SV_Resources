[
  "\u6B22\u8FCE\u6765\u5230\u6DF1\u94B5\u9053\u9986\uFF01",
  "\u6211\u8981\u767B\u8BB0\u4E00\u4E0B\\n\u6311\u6218\u8005\u7684\u540D\u5B57\u2026\u2026\\r\\n\u4F60\u662F[VAR 0100(0000)]\uFF0C\u6CA1\u9519\u5427\uFF1F",
  "\u60F3\u548C\u672C\u9053\u9986\u7684\\n\u9986\u4E3B\u5BC7\u6C99\u5BF9\u6218\uFF0C\\r\\n\u9700\u8981\u5148\u901A\u8FC7\u9053\u9986\u6D4B\u9A8C\u624D\u884C\u3002",
  "\u6DF1\u94B5\u9053\u9986\u7684\u9053\u9986\u6D4B\u9A8C\u662F\u2026\u2026\\n[VAR FF00(0006)]\u6536\u96C6\u5411\u65E5\u82B1\u602A[VAR FF00(0000)]\uFF01",
  "\u6DF1\u94B5\u662F\u827A\u672F\u4E4B\u9547\u2026\u2026\\c\\n\u4EBA\u4EEC\u5BF9\u80FD\u591F\u6210\u4E3A\u4F5C\u54C1\u4E3B\u9898\u7684\u201C\u81EA\u7136\u201D\\n\u4EE5\u53CA\u5B55\u80B2\u81EA\u7136\u7684\u201C\u592A\u9633\u201D\u5FC3\u6000\u611F\u6069\u3002\\c\\n\u56E0\u6B64\uFF0C\u8FD9\u91CC\u6709\u6536\u96C6\u517C\u5177\u8FD9\u4E24\u4E2A\u8981\u7D20\u7684\\n\u5411\u65E5\u82B1\u602A\u5E76\u6B3E\u5F85\u5B83\u4EEC\u7684\u98CE\u4FD7\u4E60\u60EF\u3002",
  "[VAR 0100(0000)]\uFF0C\u5E0C\u671B\u4F60\u80FD\u5728\u6DF1\u94B5\u9547\\n\u627E\u51FA\u53C8\u50CF\u592A\u9633\u53C8\u50CF\u82B1\u513F\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u4E5F\u5C31\u662F\u5411\u65E5\u82B1\u602A\u3002",
  "\u5982\u679C\u4F60\u80FD\u6536\u96C6[VAR 0201(0001)]\u53EA\uFF0C\\n\u5E76\u628A\u5B83\u4EEC\u5E26\u5230\u5411\u65E5\u82B1\u602A\u5E7F\u573A\u7684\u8BDD\uFF0C\\r\\n\u5C31\u80FD\u901A\u8FC7\u9053\u9986\u6D4B\u9A8C\uFF01",
  "\u9996\u5148\u8981\u628A\u5411\u65E5\u82B1\u602A\u5E7F\u573A\u7684\u4F4D\u7F6E\\n\u6DFB\u52A0\u5230\u5730\u56FE\u4E0A\u3002\\c\\n\u5177\u4F53\u4E8B\u5B9C\u8BF7\u4F60\u53BB\u95EE\\n\u90A3\u8FB9\u7684\u5DE5\u4F5C\u4EBA\u5458\u5427\u3002\\c\\n\u4ECE\u9053\u9986\u51FA\u53BB\u540E\u5F80\u53F3\u8FB9\u4E00\u8D70\u5C31\u5230\uFF01\\n\u628A\u5411\u65E5\u82B1\u602A\u7684\u5DE8\u5927\u6446\u8BBE\u5F53\u505A\u76EE\u6807\u5427\uFF01",
  "\u597D\u4E86\uFF0C\u5FEB\u53BB\u5427\uFF01"
]
