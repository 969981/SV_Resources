[
  "\u8BF8\u4F4D\uFF0C\u6536\u8D77\u4F60\u4EEC\u7684\u624B\u673A\uFF0C\\n\u5F00\u59CB\u4E0A\u8BFE\u5427\u3002[VAR 0114(0029)]",
  "\u4E0A\u4E00\u8282\u8BFE\uFF0C\u543E\u8F88\u8BB2\u89E3\u4E86\\n\u91CE\u9910\u65F6\u7684\u6599\u7406\u6240\u5E26\u6765\u7684\u6548\u679C\u3002[VAR 0114(0029)]",
  "\u5236\u4F5C\u6599\u7406\u4E0D\u4F46\u80FD\u83B7\u5F97\u98DF\u529B\uFF0C\\n\u8FD8\u80FD\u8BA9\u6240\u6709\u540C\u884C\u5B9D\u53EF\u68A6\u5F97\u5230\u56DE\u590D\uFF0C\\r\\n\u662F\u4E00\u79CD\u5F88\u65B9\u4FBF\u7684\u6CBB\u7597\u624B\u6BB5\u3002[VAR 0114(0029)]",
  "\u4E0D\u8FC7\u5F88\u81EA\u7136\u7684\uFF0C\u8FD9\u4E0D\u9002\u7528\u4E8E\\n\u4E0D\u80FD\u5236\u4F5C\u6599\u7406\u7684\u5BF9\u6218\u65F6\uFF0C\\r\\n\u4EE5\u53CA\u6025\u7740\u9700\u8981\u56DE\u590D\u7684\u65F6\u5019\u3002[VAR 0114(0029)]",
  "\u50CF\u8FD9\u6837\u7684\u573A\u9762\u5C31\u5E94\u8BE5\u4F7F\u7528\\n\u80FD\u5728\u53CB\u597D\u5546\u5E97\u548C\u5C0F\u5356\u90E8\u8D2D\u4E70\u7684\\r\\n[VAR FF00(0006)]\u4F24\u836F[VAR FF00(0000)]\u4E4B\u7C7B\u7684\u56DE\u590D\u9053\u5177\u3002[VAR 0114(0029)]",
  "\u56DE\u590D\u9053\u5177\u6709\u901F\u6548\u6027\uFF0C\\n\u6253\u5F00\u5305\u5305\u65F6\u968F\u65F6\u90FD\u80FD\u7528\u3002\\r\\n\u5F53\u7136\uFF0C\u7528\u8FC7\uFF11\u6B21\u5C31\u4F1A\u6D88\u5931\u5C31\u662F\u4E86\u3002[VAR 0114(0029)]",
  "\u4F24\u836F\u7684\u56DE\u590D\u91CF\u662F\uFF12\uFF10\uFF0C\\n\u597D\u4F24\u836F\u662F\uFF16\uFF10\uFF0C\\r\\n\u5389\u5BB3\u4F24\u836F\u662F\uFF11\uFF12\uFF10\u2026\u2026[VAR 0114(0029)]",
  "\u4EF7\u683C\u8D8A\u9AD8\uFF0C\u56DE\u590D\u91CF\u4E5F\u5C31\u8D8A\u5927\u3002\\n\u6240\u4EE5\u5728\u94B1\u5305\u5141\u8BB8\u7684\u524D\u63D0\u4E0B\uFF0C\u5E38\u5907\u4E00\u4E9B\u5427\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u4F46\u662F\uFF0C\u65C5\u884C\u5728\u5916\uFF0C\\n\u96BE\u514D\u4F1A\u9047\u5230\u610F\u5916\u7684\u72B6\u51B5\u3002[VAR 0114(0029)]",
  "\u8BF7\u8BF8\u4F4D\u60F3\u8C61\u4E00\u4E0B\u2026\u2026\\n\u5B9D\u53EF\u68A6\u53D7\u4F24\u4E86\uFF0C\u5374\u6CA1\u6709\u4F24\u836F\u3002\\r\\n\u4E09\u660E\u6CBB\u7684\u98DF\u6750\u4E5F\u7528\u5149\u4E86\u3002\\r\\n\u9644\u8FD1\u4E5F\u627E\u4E0D\u5230\u5B9D\u53EF\u68A6\u4E2D\u5FC3\u3002[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u6765\u56DE\u7B54\u3002\\n\u5728\u6CA1\u6709\u4EFB\u4F55\u56DE\u590D\u624B\u6BB5\u7684\u5371\u9669\u72B6\u51B5\u4E0B\uFF0C\\r\\n\u5E94\u8BE5\u5230\u5468\u56F4\u5BFB\u627E\u4EC0\u4E48\u5462\uFF1F[VAR 0114(0029)]",
  "\u6709\u6C34\u7684\u5730\u65B9",
  "\u5B66\u6821\u7684\u8001\u5E08",
  "\u6389\u5728\u5730\u4E0A\u7684\u4E1C\u897F",
  "\u5C31\u50CF\u521A\u624D\u6240\u8BF4\u7684\u4E00\u6837\uFF0C\\n\u5373\u4F7F\u627E\u5230\u6709\u6C34\u7684\u5730\u65B9\u4E5F\u6CA1\u6709\u98DF\u6750\uFF0C\\r\\n\u6240\u4EE5\u5728\u8FD9\u4E2A\u6761\u4EF6\u4E0B\u662F\u65E0\u6CD5\u505A\u6599\u7406\u7684\u2026\u2026[VAR 0114(0029)]",
  "\u2026\u2026\u5982\u679C\u9644\u8FD1\u6709\u8001\u5E08\u7684\u8BDD\uFF0C\\n\u4ED6\u4EEC\u81EA\u7136\u4F1A\u52A9\u4F60\u4E00\u81C2\u4E4B\u529B\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u4F60\u6700\u597D\u4E0D\u8981\u89C9\u5F97\\n\u968F\u65F6\u968F\u5730\u90FD\u80FD\u627E\u5230\u4F1A\u5E2E\u4F60\u7684\u5927\u4EBA\u2026\u2026[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\u3002\\n\u770B\u6765\u4F60\u7CBE\u901A\u751F\u5B58\u77E5\u8BC6\u554A\u3002[VAR 0114(0029)]",
  "\u5982\u679C\u5468\u56F4\u6709\u95EA\u95EA\u53D1\u5149\u7684\u4E1C\u897F\uFF0C\\n\u5C31\u8BF4\u660E\u90A3\u662F\u6389\u5728\u5730\u4E0A\u7684\u4E1C\u897F\uFF01\\c\\n\u8BF4\u4E0D\u5B9A\u80FD\u6361\u5230\\n\u6A59\u6A59\u679C\u6216\u4F24\u836F\u4E4B\u7C7B\u7684\u56DE\u590D\u9053\u5177\u3002[VAR 0114(0029)]",
  "\u4E5F\u53EF\u4EE5\u901A\u8FC7\u201C[VAR FF00(0006)]\uFF32\u952ELet\u0027s Go[VAR FF00(0000)]\u201D\\n\u8BA9\u5B9D\u53EF\u68A6\u6361\u6765\u54E6\u3002[VAR 0114(0029)]",
  "\u6811\u679C\u548C\u5546\u5E97\u91CC\u5356\u7684\u9053\u5177\u4E0D\u540C\uFF0C\\n\u53EA\u8981\u8BA9\u5B9D\u53EF\u68A6\u643A\u5E26\uFF0C\u5728\u5BF9\u6218\u65F6\\r\\n\u5B9D\u53EF\u68A6\u5C31\u4F1A\u81EA\u884C\u5224\u65AD\u72B6\u51B5\u5E76\u98DF\u7528\u3002[VAR 0114(0029)]",
  "\u4EA4\u7ED9\u5B9D\u53EF\u68A6\u6765\u5224\u65AD\u4EC0\u4E48\u65F6\u5019\u4F7F\u7528\uFF0C\\n\u4E5F\u662F\u4E00\u79CD\u4E50\u8DA3\u554A\u3002[VAR 0114(0029)]",
  "\u603B\u4E4B\uFF0C\u5728\u56DE\u590D\u624B\u6BB5\u6349\u895F\u89C1\u8098\u65F6\uFF0C\\n\u5C31\u5728\u5468\u56F4\u5BFB\u627E\u95EA\u95EA\u53D1\u5149\u7684\u4E1C\u897F\u5427\u3002[VAR 0114(0029)]",
  "\u5982\u679C\u8FDE\u6811\u679C\u90FD\u627E\u4E0D\u5230\u7684\u8BDD\uFF0C\\n\u8FD8\u6709\u5176\u4ED6\u624B\u6BB5\u53EF\u4EE5\u56DE\u590D\u2026\u2026\\r\\n\u4F46\u770B\u6765\u4E0B\u8BFE\u94C3\u4E0D\u5141\u8BB8\u543E\u8F88\u63A5\u7740\u8BB2\u4E86\u3002[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u5C31\u6B64\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
