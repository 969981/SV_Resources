[
  "\u81EA\u4ECE\u4F60\u5E2E\u4FFA\u62CD\u4E0B\u88D9\u5E26\u83DC\u4E4B\u540E\uFF0C\\n\u5BA2\u4EBA\u90FD\u62A2\u7740\u5403\u88D9\u5E26\u83DC\u6599\u7406\uFF01[VAR 0114(0018)]",
  "\u90A3\u65F6\u5019\u591A\u8C22\u4F60\u5566\uFF5E\uFF01\\n\u771F\u4E0D\u6127\u662F\u5F53\u51A0\u519B\u7684\u6599\uFF01[VAR 0114(0018)]",
  "\u54CE\u5440\u5440\uFF0C\u5E72\u8FD9\u6837\u7684\u5DE5\u4F5C\\n\u771F\u662F\u80FD\u9047\u5230\u5404\u79CD\u5404\u6837\u7684\u4EBA\u554A\uFF5E[VAR 0114(0018)]",
  "\u65E2\u6709\u50CF\u4F60\u4E00\u6837\\n\u6025\u6D41\u52C7\u8FDB\u7684\u4EBA\uFF0C\\r\\n\u53C8\u6709\u505C\u6EDE\u4E0D\u524D\u7684\u4EBA\u3002[VAR 0114(0018)]",
  "\u4E0A\u5C81\u6570\u7684\u5927\u4EBA\\n\u5F80\u5F80\u4F1A\u7518\u5F53\u540E\u8005\uFF0C\\r\\n\u4F46\u4FFA\u5C31\u89C9\u5F97\u90A3\u6709\u70B9\u65E0\u804A\u3002[VAR 0114(0018)]",
  "\u2026\u2026\u5DDD\u6CB3\u6D41\u6DCC\uFF0C\u6C47\u4E8E\u5927\u6D77\uFF0C\\n\u84B8\u53D1\u6210\u4E91\uFF0C\u51DD\u7ED3\u4E3A\u96E8\u3002[VAR 0114(0018)]",
  "\u6B32\u77E5\u5343\u53D8\u4E07\u5316\u7684\u60CA\u6D9B\u6D77\u5CB1\u5B9E\u529B\u5982\u4F55\uFF01\\n\u5C31\u4EB2\u8EAB\u4F53\u4F1A\u4E00\u4E0B\u5427\uFF01[VAR 0114(0018)]",
  "\u8FDE\u9996\u5E2D\u90FD\u8BA4\u53EF\u7684\u538B\u8FEB\u529B\uFF01\\n\u8D27\u771F\u4EF7\u5B9E\u7684\u7206\u62A4\uFF0C\u7206\u62A4\u5566\uFF01[VAR 0114(0018)]",
  "\u8FC7\u731B\u7684\u6FC0\u6D41\u65E0\u8BBA\u597D\u574F\uFF0C\\n\u5E94\u8BE5\u90FD\u4F1A\u4E3A\u5468\u56F4\\r\\n\u5E26\u6765\u5DE8\u5927\u7684\u5F71\u54CD\uFF01[VAR 0114(0018)]",
  "\u800C\u4E14\u548C\u4F60\u5728\u4E00\u8D77\u7684\u670B\u53CB\\n\u5BF9\u4F60\u6765\u8BF4\u662F\u5F88\u91CD\u8981\u7684\u5B58\u5728\u554A\u3002[VAR 0114(0018)]",
  "\u5E74\u8F7B\u6709\u529B\u7684\u4EBA\u627E\u4E0A\u95E8\u6765\uFF0C\\n\u53D4\u53D4\u4FFA\u7684\u5E72\u52B2\u5C31\u50CF\u6D2A\u6D41\u4E00\u6837\uFF01[VAR 0114(0018)]",
  "\u66FF\u4FFA\u544A\u8BC9\u4E5F\u6148\u5C0F\u59D0\uFF01\\n\u6D77\u5CB1\u4F1A\u8FDB\u4E00\u6B65\u8715\u53D8\u2026\u2026\uFF01[VAR 0114(0018)]",
  "\u62DC\u6258\u4F60\u4E86\uFF0C\u5E74\u8F7B\u4EBA\uFF01\\n\u4FFA\u4F1A\u968F\u65F6\u6B22\u8FCE\u4F60\u518D\u5149\u4E34\u7684\uFF01[VAR 0114(0018)]"
]
