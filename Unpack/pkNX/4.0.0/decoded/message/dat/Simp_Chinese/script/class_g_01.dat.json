[
  "\u2026\u2026\u770B\u8D77\u6765\u5F88\u6709\u7CBE\u795E\u7684\u5B69\u5B50\u4EEC\u3002[VAR 0114(002C)]",
  "\u543E\u8F88\u662F\u8428\u74E6\u7F57\u3002\\c\\n\u5728\u8FD9\u5802\u8BFE\u4E0A\u8981\u8BF7\u5927\u5BB6\u5B66\u4E60\\n\u751F\u6D3B\u4E0A\u6240\u5FC5\u9700\u7684\u77E5\u8BC6\u548C\u6280\u80FD\u3002[VAR 0114(0029)]",
  "\u4F60\u4EEC\u5F53\u4E2D\u4E5F\u6709\u5F88\u591A\u4EBA\u662F\u79BB\u5F00\u5BB6\u957F\uFF0C\\n\u72EC\u81EA\u4E00\u4EBA\u5728\u5BBF\u820D\u751F\u6D3B\u7684\u3002[VAR 0114(0029)]",
  "\u5E0C\u671B\u901A\u8FC7\u543E\u8F88\u4F20\u6388\u7684\u77E5\u8BC6\uFF0C\\n\u8BA9\u8BF8\u4F4D\u5728\u8863\u3001\u98DF\u3001\u4F4F\u4E0A\\r\\n\u90FD\u80FD\u63D0\u9AD8\u751F\u6D3B\u54C1\u8D28\u3002[VAR 0114(0029)]",
  "\u76EE\u524D\u4F60\u4EEC\u6240\u5728\u610F\u7684\\n\u5E94\u8BE5\u662F\u201C\u98DF\u201D\u5427\uFF1F[VAR 0114(0029)]",
  "\u5728\u91CE\u9910\u65F6\u5403\u4E09\u660E\u6CBB\u7684\u8BDD\uFF0C\\n\u5C31\u4F1A\u83B7\u5F97\u88AB\u79F0\u4E3A[VAR FF00(0006)]\u98DF\u529B[VAR FF00(0000)]\u7684\u529B\u91CF\uFF0C\\r\\n\u53D1\u6325\u5404\u79CD\u5404\u6837\u7684\u6548\u679C\u3002[VAR 0114(0029)]",
  "\u4E0D\u4EC5\u80FD\u56DE\u590D\u4F53\u529B\uFF0C\\n\u8FD8\u80FD\u66F4\u5BB9\u6613\u6355\u6349\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u4EE5\u53CA\u83B7\u5F97\u66F4\u591A\u7ECF\u9A8C\u503C\u4E4B\u7C7B\u3002[VAR 0114(0029)]",
  "\u8981\u662F\u80FD\u505A\u51FA\u597D\u5403\u7684\u4E09\u660E\u6CBB\uFF0C\\n\u8FD8\u80FD\u8FDB\u4E00\u6B65\u589E\u52A0\u6548\u679C\u3002[VAR 0114(0029)]",
  "\u53E6\u5916\uFF0C\u4E3A\u4E86\u83B7\u5F97\u66F4\u597D\u7528\u7684\u98DF\u529B\uFF0C\\n\u5728\u8FDB\u884C\u70F9\u8C03\u7684\u65F6\u5019\\r\\n\u6709\u4E00\u70B9\u975E\u5E38\u91CD\u8981\u2026\u2026[VAR 0114(0029)]",
  "\u90A3\u4E48\uFF0C[VAR 0100(0000)]\uFF0C\u4F60\u6765\u56DE\u7B54\u3002\\n\u4E3A\u4E86\u83B7\u5F97\u66F4\u597D\u7528\u7684\u98DF\u529B\uFF0C\\r\\n\u4F60\u4F1A\u6CE8\u610F\u4EC0\u4E48\uFF1F[VAR 0114(0029)]",
  "\u9985\u6599\u548C\u8C03\u5473\u6599",
  "\u70F9\u8C03\u7684\u901F\u5EA6",
  "\u6295\u5165\u611F\u60C5",
  "[VAR 0100(0000)]\uFF0C\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\u3002\\n\u4F60\u662F\u5E73\u65F6\u4F1A\u5728\u5BB6\u91CC\u5E2E\u5FD9\u505A\u996D\uFF0C\\r\\n\u6240\u4EE5\u624D\u65E9\u65E9\u5730\u5C31\u660E\u767D\u4E86\u5417\uFF1F[VAR 0114(0029)]",
  "\u2026\u2026\u4F60\u7B54\u9519\u4E86\u3002\\n\u6BD4\u8D77\u901F\u5EA6\uFF0C\u543E\u8F88\u66F4\u5E0C\u671B\\r\\n\u4F60\u80FD\u91CD\u89C6\u7EC6\u81F4\u5EA6\u3002[VAR 0114(0029)]",
  "\u5443\u2026\u2026\uFF01\u8FD9\u662F\u4E2A\u6709\u8DA3\u7684\u56DE\u7B54\u3002\\n\u867D\u7136\u4E0D\u662F\u543E\u8F88\u60F3\u8981\u7684\u7B54\u6848\u2026\u2026\\r\\n\u4F46\u5728\u67D0\u79CD\u610F\u4E49\u4E0A\u8BF4\u4E5F\u662F\u6B63\u89E3\u3002[VAR 0114(0029)]",
  "\u4E3A\u4E86\u83B7\u5F97\u66F4\u597D\u7528\u7684\u98DF\u529B\uFF0C\\n\u91CD\u8981\u7684\u662F\u9985\u6599\u548C\u8C03\u5473\u6599\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u6240\u8C13\u7684\u98DF\u6750\u3002[VAR 0114(0029)]",
  "\u6BD4\u5982\u591A\u4F7F\u7528\u751C\u5473\u7684\u98DF\u6750\uFF0C\\n\u5C31\u4F1A\u66F4\u5BB9\u6613\u83B7\u5F97\u86CB\u86CB\u529B\u2026\u2026[VAR 0114(0029)]",
  "\u591A\u4F7F\u7528\u82E6\u5473\u7684\u98DF\u6750\uFF0C\\n\u5C31\u4F1A\u66F4\u5BB9\u6613\u83B7\u5F97\u6389\u7269\u529B\uFF0C\u4E4B\u7C7B\u3002[VAR 0114(0029)]",
  "\u5982\u679C\u80FD\u8BA9\u505A\u51FA\u7684\u4E09\u660E\u6CBB\\n\u5177\u5907\u81EA\u5DF1\u60F3\u8981\u7684\u6548\u679C\uFF0C\\r\\n\u6599\u7406\u5C31\u4F1A\u53D8\u5F97\u66F4\u4EE4\u4EBA\u6EE1\u610F\u5427\u3002\\c\\n\u59D1\u4E14\u4E5F\u8BF4\u4E00\u4E0B\uFF0C\\n\u5728\u9910\u5385\u7528\u9910\u4E5F\u80FD\u83B7\u5F97\u98DF\u529B\u54E6\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u5982\u679C\u8BF8\u4F4D\u80FD\u638C\u63E1\u8FD9\u4E9B\u77E5\u8BC6\uFF0C\\n\u52A0\u6DF1\u5BF9\u5BB6\u653F\u8BFE\u7684\u7406\u89E3\u7684\u8BDD\uFF0C\\r\\n\u543E\u8F88\u4E5F\u4F1A\u975E\u5E38\u9AD8\u5174\u7684\u3002[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u5C31\u6B64\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
