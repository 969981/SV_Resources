  "\u867D\u7136\u6211\u5F88\u60F3\u77E5\u9053\u4F60\u6700\u540E\u9009\u62E9\u4E86\u4EC0\u4E48\uFF0C\\n\u4F46\u662F\u65F6\u5019\u8981\u53BB\u62DC\u8BBF\u4E0B\u4E00\u5BB6\u4E86\u2026\u2026[VAR 0114(000A)]",
  "\u6211\u4F1A\u5F85\u5728\u90A3\u6237\u4EBA\u5BB6\u3002\\n\u4F60\u4ED4\u7EC6\u8003\u8651\u4E00\u4E0B\uFF0C\\r\\n\u518D\u6765\u544A\u8BC9\u6211\u4F60\u7684\u51B3\u5B9A\u5427\u3002[VAR 0114(000A)]",
