  "\u771F\u662F\u4E2A\u5F6C\u5F6C\u6709\u793C\u7684\u6821\u957F\u554A\u3002[VAR 0114(002B)]",
  "\u5927\u5BB6\u90FD\u5F88\u68D2\uFF0C\\n\u4F46\u53EA\u80FD\u9009\uFF11\u53EA\u554A\uFF1F[VAR 0114(002B)]",
  "\u673A\u4F1A\u96BE\u5F97\uFF0C\\n\u5E26\u4E0A\u5B83\u4EEC\u4E00\u8D77\u8D70\u8D70\uFF0C\\r\\n\u518D\u89C2\u5BDF\u4E00\u4E0B\u600E\u4E48\u6837\uFF1F[VAR 0114(002B)]",
  "\u8BF4\u4E0D\u5B9A\u4F60\u80FD\u5BF9\u5B9D\u53EF\u68A6\\n\u4E86\u89E3\u5F97\u66F4\u591A\u3002[VAR 0114(002B)]",
  "\u53E6\u5916\u2026\u2026\u4E3A\u4E86\u7EAA\u5FF5\u4F60\u5165\u5B66\uFF0C\\n\u5988\u5988\u9001\u4F60\u4E2A\u793C\u7269\uFF01\\r\\n\u5982\u679C\u4F60\u8981\u51FA\u95E8\u7684\u8BDD\uFF0C\u5C31\u628A\u8FD9\u4E2A\u5E26\u5728\u8EAB\u4E0A\u5427\u3002[VAR 0114(002B)]",
