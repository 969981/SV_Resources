[
  "[VAR 0100(0000)]\\n\u83B7\u5F97\u4E86[VAR FF00(0008)]\u5404\u79CD\u98DF\u6750[VAR FF00(0000)]\uFF01",
  "[VAR 0100(0000)]\\n\u628A\u5404\u79CD\u98DF\u6750\u88C5\u8FDB\u4E86[VAR FF00(0008)]\u91CE\u9910[VAR FF00(0000)]\u53E3\u888B\uFF01",
  "\u6211\u521A\u521A\u4E70\u7684\u98DF\u6750\u592A\u591A\u4E86\uFF0C\\n\u4F60\u80FD\u4E0D\u80FD\u62FF\u8D70\u4E00\u4E9B\uFF1F",
  "\u8981\u8BF4\u91CE\u9910\uFF0C\\n\u679C\u7136\u5C11\u4E0D\u4E86\u4E09\u660E\u6CBB\uFF01\\r\\n\u8BD5\u7740\u7528\u6211\u7ED9\u4F60\u7684\u98DF\u6750\u5236\u4F5C\u5427\uFF01",
  "\u8981\u4E0D\u8981\u987A\u4FBF\u52A0\u5165\u6211\u7684\u91CE\u9910\uFF0C\\n\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u4F11\u606F\u4E00\u4E0B\uFF1F",
  "\u6B22\u8FCE\u52A0\u5165\u6211\u7684\u91CE\u9910\uFF0C\\n\u8981\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u4F11\u606F\u5417\uFF1F",
  "\u4F60\u548C\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u90FD\u5145\u6EE1\u6D3B\u529B\u4E86\u5462\uFF01\\r\\n\u6B22\u8FCE\u968F\u65F6\u8FC7\u6765\u4F11\u606F\u3002",
  "\u8981\u662F\u7D2F\u4E86\u7684\u8BDD\uFF0C\u53EF\u4E0D\u8981\u52C9\u5F3A\u54E6\u3002\\n\u6B22\u8FCE\u968F\u65F6\u8FC7\u6765\u4F11\u606F\u3002",
  "\u6211\u5305\u91CC\u7684\u98DF\u6750\u585E\u592A\u591A\u4E86\uFF01\\n\u5206\u7ED9\u4F60\u4E00\u4E9B\u54E6\uFF01",
  "\u9732\u5929\u5403\u7684\u4E09\u660E\u6CBB\u6700\u597D\u5403\u4E86\uFF01\\n\u8BD5\u7740\u7528\u6211\u5206\u7ED9\u4F60\u7684\u98DF\u6750\u5236\u4F5C\u5427\uFF01",
  "\u8981\u4E0D\u8981\u5C31\u8FD9\u6837\u548C\u6211\u4E00\u8D77\u91CE\u9910\uFF0C\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5462\uFF1F",
  "\u8981\u548C\u6211\u4E00\u8D77\u91CE\u9910\uFF0C\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5417\uFF1F",
  "\u4F60\u548C\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u90FD\u5145\u6EE1\u6D3B\u529B\u4E86\u5462\uFF01\\r\\n\u6B22\u8FCE\u4F60\u968F\u65F6\u518D\u6765\u4F11\u606F\u54E6\uFF01",
  "\u4E0D\u8981\u8FD9\u4E48\u5BA2\u6C14\u561B\uFF5E\\n\u90A3\u5C31\u6B22\u8FCE\u4F60\u968F\u65F6\u518D\u6765\u5566\uFF01",
  "\u8FD9\u91CC\u662F\u684C\u53F0\u5E02\u548C\\n\u6DF1\u94B5\u9547\u7684\u6B63\u4E2D\u5FC3\u4E00\u5E26\uFF01\\c\\n\u5403\u5B8C\u4E09\u660E\u6CBB\uFF0C\\n\u5C31\u80FD\u7EE7\u7EED\u52A0\u6CB9\u5192\u9669\u54AF\uFF5E\uFF01\\c\\n\u2026\u2026\u4E3A\u4E86\u8BA9\u4F60\u4E5F\u80FD\u7EE7\u7EED\u52A0\u6CB9\uFF0C\\n\u6211\u5206\u7ED9\u4F60\u4E00\u4E9B\u98DF\u6750\u5427\uFF01",
  "\u5BF9\u4E86\uFF0C\u6211\u542C\u8BF4\u8FD9\u4E00\u5E26\u7684\u5CA9\u58C1\u52A8\u4E86\uFF0C\\n\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u771F\u7684\uFF5E\uFF1F",
  "\u4E3A\u4E86\u54EA\u6015\u5CA9\u58C1\u52A8\u8D77\u6765\u4E5F\u4E0D\u88AB\u5413\u5230\uFF0C\\n\u4F60\u6765\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5427\uFF01",
  "\u52AA\u529B\u7684\u52B2\u5934\u4E0D\u591F\u4E86\uFF1F\\n\u4F60\u6765\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5427\uFF01",
  "\u4E0D\u8BBA\u662F\u4EBA\u8FD8\u662F\u5B9D\u53EF\u68A6\uFF0C\\n\u8981\u52AA\u529B\u5C31\u5FC5\u987B\u4F11\u606F\u624D\u884C\uFF01\\r\\n\u611F\u5230\u7D2F\u4E86\u7684\u8BDD\uFF0C\u8BB0\u5F97\u518D\u6765\u54E6\uFF01",
  "\u8FD9\u6837\u554A\uFF01\\n\u4E0D\u8981\u592A\u52C9\u5F3A\u54E6\uFF01",
  "\u5761\u9053\u6BD4\u60F3\u8C61\u4E2D\u9661\uFF0C\\n\u597D\u7D2F\u554A\u2026\u2026\\c\\n\u8FD9\u79CD\u65F6\u5019\u5C31\u8981\u5403\u4E1C\u897F\\n\u6765\u8BA9\u8EAB\u5FC3\u7115\u53D1\u6D3B\u529B\uFF01\\c\\n\u6211\u5206\u7ED9\u4F60\u4E00\u4E9B\u98DF\u6750\uFF0C\\n\u4F60\u4E5F\u6765\u7115\u53D1\u6D3B\u529B\u5427\uFF01",
  "\u8981\u662F\u809A\u5B50\u7A7A\u7A7A\u5982\u4E5F\uFF0C\\n\u672C\u6765\u80FD\u52AA\u529B\u7684\u4E8B\u60C5\u4E5F\u52AA\u529B\u4E0D\u4E86\u5566\uFF01",
  "\u65C5\u884C\u9760\u540C\u4F34\uFF0C\u5904\u4E16\u9760\u4EBA\u60C5\uFF01\\n\u4F60\u4E5F\u987A\u4FBF\u6765\u653E\u677E\u4E00\u4E0B\u5982\u4F55\uFF1F",
  "\u4F60\u4E5F\u722C\u5761\u722C\u7D2F\u4E86\u5417\uFF1F\\n\u8981\u4E0D\u8981\u6765\u7A0D\u5FAE\u653E\u677E\u4E00\u4E0B\u770B\u770B\uFF1F",
  "\u7F8E\u5473\u7684\u98DF\u7269\u8BA9\u4EBA\u7115\u53D1\u6D3B\u529B\uFF01\uFF01\\n\u6709\u56F0\u96BE\u65F6\u5C31\u8981\u4E92\u76F8\u5E2E\u52A9\uFF01\\r\\n\u8981\u662F\u611F\u5230\u7D2F\u4E86\uFF0C\u5C31\u6765\u8DDF\u6211\u8BF4\u4E00\u58F0\u54E6\uFF01",
  "\u771F\u4E0D\u6127\u662F\u5E74\u8F7B\u4EBA\uFF01\\n\u54CE\u5440\uFF5E\u6211\u597D\u7FA1\u6155\u554A\uFF5E\uFF01",
  "\u4E00\u8FB9\u6B23\u8D4F\u7F8E\u666F\u4E00\u8FB9\u5403\u4E09\u660E\u6CBB\\n\u771F\u662F\u522B\u6709\u98CE\u5473\uFF0C\u54C8\u54C8\uFF01\\c\\n\u4E3A\u4E86\u7EAA\u5FF5\u6211\u4EEC\u7684\u76F8\u9047\uFF0C\u8FD9\u4E2A\u9001\u7ED9\u4F60\uFF01\\n\u4F60\u4E5F\u597D\u597D\u4F53\u4F1A\u65C5\u884C\u7684\u6ECB\u5473\u5427\uFF01\uFF01",
  "\u5403\u4E0B\u4E09\u660E\u6CBB\u540E\uFF0C\\n\u6EE1\u6EE1\u7684\u98DF\u529B\\r\\n\u4F1A\u8BA9\u65C5\u9014\u66F4\u5FEB\u4E50\uFF0C\u54C8\u54C8\uFF01",
  "\u987A\u4FBF\u5728\u8FD9\u91CC\u505C\u4E0B\u811A\u6B65\uFF0C\\n\u4F11\u606F\u4E00\u4E0B\u5982\u4F55\uFF1F",
  "\u5076\u5C14\u505C\u4E0B\u811A\u6B65\uFF0C\\n\u6B23\u8D4F\u7740\u7F8E\u666F\u4F11\u606F\u4E00\u4E0B\u5982\u4F55\uFF1F",
  "\u52AA\u529B\u4E5F\u5F88\u91CD\u8981\uFF0C\\n\u4F46\u5076\u5C14\u4E5F\u8981\u8BD5\u7740\u505C\u4E0B\u811A\u6B65\uFF01\\r\\n\u4E5F\u6709\u8FD9\u6837\u624D\u80FD\u770B\u5230\u7684\u98CE\u666F\u54E6\uFF0C\u54C8\u54C8\uFF01",
  "\u5306\u5FD9\u8D76\u8DEF\u4E5F\u4E0D\u9519\uFF01\\n\u5982\u679C\u4F60\u60F3\u6B47\u6B47\u811A\u7684\u8BDD\uFF0C\\r\\n\u968F\u65F6\u6765\u627E\u6211\u5427\u3002",
  "\u6211\u5728\u6E0D\u6C81\u5E02\u573A\\n\u4E70\u5230\u4E86\u5F88\u5212\u7B97\u7684\u98DF\u6750\uFF01\uFF01\\c\\n\u4F46\u662F\u6211\u81EA\u5DF1\u5403\u4E0D\u5B8C\uFF0C\\n\u6240\u4EE5\u8FD9\u4E9B\u5C31\u9001\u7ED9\u4F60\u4E86\uFF01",
  "\u548C\u670B\u53CB\u4E00\u8D77\u505A\u6599\u7406\u7684\u65F6\u5019\uFF0C\\n\u5E26\u4E0A\u5404\u5F0F\u98DF\u6750\u53BB\uFF0C\\c\\n\u5C31\u80FD\u505A\u51FA\u5343\u5947\u767E\u602A\u7684\u4E09\u660E\u6CBB\uFF0C\\n\u975E\u5E38\u597D\u73A9\u54E6\uFF5E\uFF01",
  "\u2026\u2026\u5BF9\u4E86\uFF01\u8FD9\u4E00\u5E26\u5F88\u9669\u5CFB\uFF0C\\n\u4F60\u6765\u4F11\u606F\u4E00\u4E0B\u5427\uFF5E\uFF01",
  "\u4ECE\u8FD9\u91CC\u4E0D\u8BBA\u5F80\u5357\u8FD8\u662F\u5F80\u5317\u90FD\u5F88\u9669\u5CFB\uFF0C\\n\u4F60\u8981\u51FA\u53D1\u7684\u8BDD\uFF0C\u5148\u4F11\u606F\u4E00\u4E0B\u5427\uFF5E\uFF01",
  "\u75B2\u52B3\u4E00\u626B\u800C\u7A7A\u4E86\u5427\uFF01\\n\u5192\u9669\u8DEF\u4E0A\u591A\u52A0\u5C0F\u5FC3\uFF5E\uFF01",
  "\u5982\u679C\u4F60\u662F\u53BB\u897F\u8FB9\u7684\u6E0D\u6C81\u9547\uFF0C\\n\u6211\u7684\u62C5\u5FC3\u53EF\u80FD\u6709\u4E9B\u591A\u4F59\u5566\uFF5E\uFF01",
  "\u6211\u5728\u5927\u9505\u6E56\u770B\u5230\u5947\u602A\u7684\\n\u5B9D\u53EF\u68A6\u540E\u5F97\u5230\u4E86\u7075\u611F\uFF01\\c\\n\u8FD9\u662F\u6211\u4F7F\u51FA\u5168\u529B\u521B\u4F5C\u7684\\n\u4E09\u660E\u6CBB\u98DF\u8C31\uFF0C\u8BF7\u4E00\u5B9A\u5236\u4F5C\u770B\u770B\uFF01",
  "[VAR 0100(0000)]\\n\u80FD\u591F\u5236\u4F5C[VAR FF00(0006)]\u5BFF\u53F8\u98CE\u5473\u4E09\u660E\u6CBB[VAR FF00(0000)]\u4E86\uFF01",
  "\u4E00\u822C\u6765\u8BF4\uFF0C\u5BFF\u53F8\u4E0D\u662F\u642D\u914D\u9762\u5305\uFF0C\\n\u800C\u662F\u628A\u98DF\u6750\u653E\u5728\u7C73\u996D\u4E0A\u6765\u5403\u7684\u3002\\c\\n\u2026\u2026\u4E5F\u5C31\u662F\u8BF4\uFF0C\u628A\u5BFF\u53F8\u653E\u5728\\n\u9762\u5305\u4E0A\u7684\u8BDD\uFF0C\u7F8E\u5473\u4E5F\u4F1A\u52A0\u500D\u54E6\uFF01",
  "\u6211\u4EEC\u5728\u6E56\u8FB9\u76F8\u9047\u4E5F\u662F\u4E00\u79CD\u7F18\u5206\uFF01\\n\u4F60\u6765\u6B47\u53E3\u6C14\u518D\u8D70\u5427\uFF01",
  "\u5728\u6E56\u8FB9\u91CE\u9910\uFF01\u611F\u89C9\u8D85\u68D2\u5427\uFF1F\\n\u4F60\u6765\u6B47\u53E3\u6C14\u518D\u8D70\u5427\uFF01",
  "\u4E3A\u4EC0\u4E48\u6E56\u8FB9\u4F1A\u8BA9\u4EBA\\n\u611F\u5230\u5982\u6B64\u8212\u9002\u5462\uFF1F\\r\\n\u8FD9\u4E48\u4E00\u6765\uFF0C\u8EAB\u5FC3\u5F7B\u5E95\u653E\u677E\u4E86\uFF01",
  "\u5982\u679C\u4F60\u60F3\u611F\u53D7\u6E56\u7684\u6C14\u606F\uFF0C\\n\u968F\u65F6\u968F\u523B\u6765\u8DDF\u6211\u8BF4\u4E00\u58F0\u5427\u3002"
]
