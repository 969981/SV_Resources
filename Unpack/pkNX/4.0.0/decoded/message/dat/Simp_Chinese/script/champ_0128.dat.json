[
  "\u9535\u9535\u9535\u78C5\uFF5E\uFF01\uFF01\\n\u5C31\u5728\u8FD9\u91CC\u5BF9\u6218\u54E6\uFF5E\uFF01[VAR 0114(0004)]",
  "\u5BF9\u6218\u573A\u662F\u8FD9\u79CD\u611F\u89C9\u554A\uFF5E\uFF01\\n\u55EF\u55EF\uFF01\u8981\u591A\u6CE8\u610F\u4E00\u4E0B\u5462\uFF01[VAR 0114(0004)]",
  "\u56E0\u4E3A\u8FD9\u53EF\u80FD\u4F1A\u7A0D\u5FAE\u5F71\u54CD\u5230\\n\u5B9D\u53EF\u68A6\u7684\u817F\u80FD\u5426\u7528\u5F97\u4E0A\u529B\u4E4B\u7C7B\u7684\uFF01[VAR 0114(0004)]",
  "\u867D\u7136\u6211\u786C\u662F\u628A\u4F60\u7ED9\u5E26\u6765\u4E86\uFF0C\\n\u4F46\u4F60\u5C31\u5F53\u662F\u53BB\u9053\u9986\u524D\u7684\u51C6\u5907\u6D3B\u52A8\u5427\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF01\\n\u8BA9\u6211\u4EEC\u6765\u4E00\u573A\u5927\u6709\u6536\u83B7\u7684\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "\u8FD9\u573A\u5BF9\u6218\uFF0C\u662F\u6211\u8F93\u4E86\uFF01\\n\u4F60\u53D8\u5F97\u8D85\uFF5E\u5389\u5BB3\u554A\uFF5E\uFF01[VAR 0114(0004)]",
  "\u8FD9\u573A\u5BF9\u6218\uFF0C\u662F\u6211\u8D62\u4E86\u554A\uFF01\\n\u4E0D\u8FC7\uFF0C\u4F60\u6253\u5F97\u5F88\u6F02\u4EAE\u54E6\uFF01[VAR 0114(0004)]",
  "\u55EF\uFF0C\u597D\u554A\u3002\\n\u4E5F\u5DEE\u4E0D\u591A\u53EF\u4EE5\u4E86\u2026\u2026\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u548C\u5B9D\u53EF\u68A6\\n\u73B0\u5728\u90FD\u505A\u597D\u70ED\u8EAB\uFF0C\u51C6\u5907\u5C31\u7EEA\u4E86\uFF01\\r\\n\u4E3A\u4E86\u8C22\u8C22\u4F60\u966A\u6211\u5BF9\u6218\uFF0C\u6536\u4E0B\u8FD9\u4E9B\u5427\uFF01[VAR 0114(0004)]",
  "\u8DDD\u79BB\u51A0\u519B\u7EA7\u53EA\u5DEE\u4E00\u70B9\u4E86\uFF01\\n\u5269\u4E0B\u7684\uFF12\u4E2A\u9053\u9986\u4E5F\u8981\u52A0\u6CB9\u54E6\uFF01[VAR 0114(0004)]",
  "\u6211\u9001\u4F60\u56DE\u524D\u53F0\u5427\uFF01[VAR 0114(0004)]"
]
