[
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01[VAR 0114(0041)]",
  "\u6BC5\u4E07\uFF0C\u770B\u5440\uFF01\\n\u591A\u68D2\u7684\u76C6\u683D\u554A\uFF01[VAR 0114(0041)]",
  "\u99A5\u597D\uFF01\\n\u8FD9\u662F\u679C\u56ED\u54E6\uFF01\\r\\n\u867D\u7136\u5728\u4F60\u6765\u770B\u5B83\u53EF\u80FD\u53EA\u662F\u4E2A\u76C6\u683D\uFF01[VAR 0114(0040)]",
  "\u4E0D\u4F1A\u5427\u2026\u2026\uFF1F\\n\u8FD9\u662F\u679C\u6811\u7684\u56ED\u5B50\uFF01\uFF1F\\r\\n\u591A\u4E48\u5730\u6734\u7D20\u554A\uFF01\uFF01[VAR 0114(0041)]",
  "\u6BC5\u4E07\uFF01\\n\u8C22\u8C22\u4F60\u7684\u8BA2\u6B63\u54E6\u3002[VAR 0114(0041)]",
  "\u4E0D\u7528\u8C22\uFF01\u6BD5\u7ADF\u5EB6\u6C11\u7684\u751F\u6001\\n\u8FD8\u6709\u5F88\u591A\u8C1C\u56E2\u5462\uFF01[VAR 0114(0040)]",
  "\u554A\u554A\uFF5E\u5EB6\u6C11\uFF01\\n\u591A\u4E48\u4E0D\u53EF\u601D\u8BAE\u7684\u5B58\u5728\u2026\u2026\\r\\n\u65E0\u8BBA\u4F55\u65F6\u90FD\u80FD\u8BA9\u6211\u5FC3\u6F6E\u6F8E\u6E43\uFF01\uFF01[VAR 0114(0041)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\u8BF4\u5230\u5C31\u5230\uFF0C\\n\u6211\u4EEC\u719F\u6089\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u8FD8\u771F\u662F\u3002\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u90A3\u5C31\u662F\u6211\u4EEC\u719F\u6089\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u6211\u60F3\u8981\u8FDB\u4E00\u6B65\u4E86\u89E3\u5EB6\u6C11\uFF01\\n\u60F3\u8981\u62C9\u8FD1\u548C\u5EB6\u6C11\u7684\u8DDD\u79BB\uFF01\uFF01[VAR 0114(0041)]",
  "\u2026\u2026\u56E0\u6B64\uFF0C\u4F60\u53EF\u4EE5\\n\u518D\u6B21\u548C\u6211\u51B3\u6597\u5417\uFF1F[VAR 0114(0041)]",
  "\u51FA\u2026\u2026\u51FA\u73B0\u4E86\uFF01\\n\u99A5\u597D\u7684\u7231\u597D\uFF01\\r\\n\u901A\u8FC7\u5BF9\u6218\u6765\u4E86\u89E3\u5BF9\u65B9\u7684\u90A3\u4E00\u5957\uFF5E\uFF01[VAR 0114(0040)]",
  "\u5475\u5475\u5475\u2026\u2026\u8981\u662F\u505A\u597D\u5FC3\u7406\u51C6\u5907\u4E86\uFF0C\\n\u5C31\u7531\u5EB6\u6C11\u4F60\u6765\u9080\u8BF7\u6211\u5F00\u59CB\u5427\u3002[VAR 0114(0041)]",
  "\u80FD\u548C\u540D\u6D41\u51B3\u6597\u53EF\u662F\u5343\u91D1\u96BE\u4E70\u7684\u673A\u4F1A\uFF01\\n\u5FEB\u53BB\u548C\u99A5\u597D\u642D\u8BDD\u5440\uFF01[VAR 0114(0040)]",
  "\u6765\u548C\u6211\u51B3\u6597\uFF01\\n\u4F60\u613F\u610F\u63A5\u53D7\u5427\uFF1F[VAR 0114(0041)]",
  "\u2026\u2026\u867D\u8BF4\u5076\u5C14\u88AB\u5EB6\u6C11\\n\u540A\u540A\u80C3\u53E3\u4E5F\u4E0D\u9519\u2026\u2026\\c\\n\u4F46\u540D\u6D41\u7684\u65F6\u95F4\u662F\u5B9D\u8D35\u7684\uFF01\\n\u73B0\u5728\u7ACB\u523B\u5C31\u6765\u5F00\u6253\u54AF\uFF5E\uFF5E\uFF5E\uFF01\uFF01[VAR 0114(0041)]",
  "\u5E15\u5E95\u4E9A\u4E0D\u52A8\u4EA7\u7684\u793E\u957F\u99A5\u597D\uFF01\\n\u8981\u6765\u78BE\u538B\u5EB6\u6C11\u54AF\uFF5E\uFF5E\uFF5E\uFF01\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\u54BB\uFF5E\uFF01\\n\u52A0\u6CB9\u5440\uFF0C\u99A5\u597D\uFF01[VAR 0114(0040)]",
  "\u6211\u53C8\u4E00\u6B21\u8F93\u4E86\uFF01\\n\u4F60\u7A76\u7ADF\u662F\u4F55\u65B9\u795E\u5723\u5440\uFF01[VAR 0114(0041)]",
  "\u6211\u8BF4\uFF0C\u6BC5\u4E07\uFF01\\n\u5EB6\u6C11\u90FD\u5F88\u64C5\u957F\u5B9D\u53EF\u68A6\u5BF9\u6218\u5417\uFF01\uFF1F\\r\\n\u8FD8\u662F\u8BF4\u53EA\u662F\u8FD9\u4E00\u4F4D\u5F88\u7279\u522B\uFF01\uFF1F[VAR 0114(0041)]",
  "\u99A5\u597D\uFF0C\u8FD9\u4E2A\u5EB6\u6C11\u4E00\u5B9A\u662F\u62E5\u6709\\n\u88AB\u9009\u4E2D\u7684\u5EB6\u6C11\u624D\u6709\u7684\u2026\u2026[VAR 0114(0040)]",
  "\u540D\u4E3A\u8FDB\u53D6\u5FC3\u7684\u7279\u8D28\u5440\uFF01\uFF01[VAR 0114(0040)]",
  "\u8FDB\u53D6\u5FC3\uFF01\uFF1F\u5C31\u662F\u540D\u6D41\u4E00\u8F88\u5B50\\n\u90FD\u4E0D\u4F1A\u62E5\u6709\u7684\u90A3\u4E2A\u7279\u8D28\u2026\u2026\uFF01\uFF1F[VAR 0114(0041)]",
  "\u96BE\u602A\u6211\u8D62\u4E0D\u4E86\u5440\u3002\u73B0\u5728\u906E\u4F4F\u773C\u775B\u7684\\n\u4E38\u5B50\u73CD\u73E0\u4E00\u6389\uFF0C\u6211\u7A81\u7136\u5C31\u770B\u6E05\u4E86\u2026\u2026[VAR 0114(0041)]",
  "\u2026\u2026\u8BF4\u5230\u73CD\u73E0\uFF0C\\n\u6211\u5C31\u60F3\u53BB\u6C34\u8FB9\u4E86\u5462\uFF01[VAR 0114(0041)]",
  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\\n\u6211\u73B0\u5728\u60F3\u7ACB\u523B\u5230\u5E15\u5E95\u4E9A\\r\\n\u770B\u770B\u6700[VAR FF00(0006)]\u5E7F\u5927\u7684\u6C34\u8FB9[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\u597D\u5947\u5FC3\\n\u603B\u662F\u6765\u5F97\u8FD9\u4E48\u7A81\u7136\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5440\uFF01[VAR 0114(0040)]",
  "\u6211\u4EEC\u53BB\u6E56\u8FB9\u7684\u5C0F\u5C9B\\n\u7F13\u89E3\u51B3\u6597\u540E\u7684\u75B2\u52B3\u5427\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u4E07\u5148\u751F\\n\u5728\u5317\u4E0A\u4E61\u672C\u5730\\r\\n\u524D\u53BB\u89C2\u8D4F\u6C34\u679C\u56ED\u4E86\u3002"
]
