[
  "\u563F\uFF0C\u5C0F\u4F19\u5B50\u3002\\n\u4F60\u7684\u5B9D\u53EF\u68A6\u770B\u4E0A\u53BB\u5F88\u5F3A\u561B\u3002",
  "\u563F\uFF0C\u5C0F\u59D1\u5A18\u3002\\n\u4F60\u7684\u5B9D\u53EF\u68A6\u770B\u4E0A\u53BB\u5F88\u5F3A\u561B\u3002",
  "\u4F60\u8BF4\u4E0D\u5B9A\u80FD\\n\u6253\u5012\u5317\u4E0A\u9B3C\u9762\u7EC4\u3002",
  "\u5317\u4E0A\u9B3C\u9762\u7EC4\uFF1F",
  "\u4EC0\u4E48\u6765\u5934\uFF1F",
  "\u5317\u4E0A\u9B3C\u9762\u7EC4\u662F\\n\u51FA\u6CA1\u4E8E\u6751\u5B50\u4E4B\u5916\uFF0C\\r\\n\u6234\u7740\u9B3C\u9762\u5177\u7684\u5F3A\u5927\u8BAD\u7EC3\u5BB6\u3002",
  "\u90A3\u4E9B\u5BB6\u4F19\u6700\u559C\u6B22\u5389\u5BB3\u7684\u5B69\u5B50\uFF0C\\n\u4E00\u76F4\u6EE1\u5FC3\u671F\u5F85\u7740\u522B\u4EBA\u6765\u6311\u6218\u54E6\u3002",
  "\u6839\u636E\u4F20\u95FB\uFF0C\\n\u5317\u4E0A\u9B3C\u9762\u7EC4\u7531\uFF17\u4E2A\u4EBA\u7EC4\u6210\u2026\u2026",
  "\u5982\u679C\u4F60\u60F3\u6311\u6218\u4ED6\u4EEC\uFF0C\u53EF\u5F97\u5C0F\u5FC3\u54E6\u3002\\n\u90A3\u7FA4\u5BB6\u4F19\u53EF\u4E0D\u662F\u597D\u5BF9\u4ED8\u7684\u3002\\r\\n\u4F60\u6BCF\u6253\u8D62\u4E00\u4E2A\u4EBA\uFF0C\u6211\u90FD\u4F1A\u9001\u4F60\u597D\u4E1C\u897F\u54E6\u3002",
  "\u6211\u542C\u8BF4\u6709\u5173\u4F60\u7684\u4E8B\u60C5\u4E86\u54E6\u3002\\n\u770B\u6765\u4F60\u6253\u8D62\u9B3C\u9762\u7EC4\u4E86\u554A\u3002\\r\\n\u90A3\u6211\u5C31\u6309\u7167\u7EA6\u5B9A\u9001\u4F60\u597D\u4E1C\u897F\u5427\u3002",
  "\u6211\u542C\u8BF4\u6709\u5173\u4F60\u7684\u4E8B\u60C5\u4E86\u54E6\u3002\\n\u770B\u6765\u4F60\u6253\u8D62\u9B3C\u9762\u7EC4\u4E86\u554A\u3002\\r\\n\u90A3\u6211\u5C31\u6309\u7167\u7EA6\u5B9A\u9001\u4F60\u597D\u4E1C\u897F\u5427\u3002",
  "\u9B3C\u9762\u7EC4\u53EA\u5269\u4E0B\uFF11\u4E2A\u4EBA\u4E86\u2026\u2026\\n\u9700\u8981\u63D0\u793A\u4F60\u90A3\u4E2A\u4EBA\u5728\u54EA\u91CC\u5417\uFF1F",
  "\u9B3C\u9762\u7EC4\u8FD8\u5269\u4E0B[VAR 0200(0001)]\u4E2A\u4EBA\u2026\u2026\\n\u9700\u8981\u63D0\u793A\u4F60\u4ED6\u4EEC\u5728\u54EA\u91CC\u5417\uFF1F",
  "\u81EA\u9B3C\u5C71\u5F80\u9752\u4E4B\u65B9\u4F4D\uFF0C\\n\u7AF9\u6797\u4E4B\u4E2D\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u81EA\u8FDC\u65B9\u80FD\u77AD\u671B\u9B3C\u89D2\u4E4B\u5730\uFF0C\\n\u543E\u4E4B\u6240\u5728\u3002",
  "\u81EA\u9B3C\u53E3\u6D41\u51FA\u4E4B\u6C34\uFF0C\\n\u5176\u8FD1\u65C1\u7F1D\u9699\u5904\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u5730\u72F1\u6216\u4E50\u571F\uFF0C\\n\u4E8C\u8005\u7686\u53EF\u9009\u4E4B\u6C60\u7554\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u8FDC\u79BB\u75DB\u82E6\u4E4B\u571F\u5730\uFF0C\\n\u5947\u5CA9\u8352\u91CE\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u9B3C\u89D2\u6709\u957F\u6709\u77ED\uFF0C\\n\u975E\u957F\u4E00\u4FA7\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u4E0D\u591C\u6C60\u65C1\u6709\u6D1E\u7A74\uFF0C\\n\u843D\u5165\u5176\u4E2D\uFF0C\u543E\u4E4B\u6240\u5728\u3002",
  "\u8FD9\u6837\u4E00\u6765\u2026\u2026\u4F60\u4F3C\u4E4E\u5C31\\n\u5C06\u9B3C\u9762\u7EC4\u7684\u4EBA\u5168\u90FD\u6253\u5012\u4E86\u3002",
  "\u9047\u5230\u4F60\u8FD9\u4E48\u5389\u5BB3\u7684\u5BB6\u4F19\uFF0C\\n\u770B\u6765\u6211\u7EC8\u4E8E\u80FD\u62FF\u51FA\u771F\u672C\u4E8B\u4E86\u2026\u2026",
  "\u54C8\uFF01\uFF01",
  "\u9119\u4EBA\u4E43\u72EC\u4E00\u65E0\u4E8C\u7684\\n\u5E55\u540E\u5317\u4E0A\u9B3C\u9762\u7EC4\u2026\u2026",
  "\u6700\u7EC8\u5BF9\u51B3\u5373\u5C06\u5C55\u5F00\uFF0C\\n\u5F85\u4F60\u51C6\u5907\u4E07\u5168\uFF0C\\r\\n\u4FBF\u6765\u544A\u77E5\u9119\u4EBA\u5427\u3002",
  "\u4E0E\u9119\u4EBA\u7684\u6700\u7EC8\u5BF9\u51B3\u2026\u2026\\n\u4F60\u505A\u597D\u5B8C\u5168\u51C6\u5907\u4E86\u5417\uFF1F",
  "\u2026\u2026\u5F85\u4F60\u5907\u597D\u518D\u6765\u3002",
  "\u9700\u79FB\u81F3\u9002\u5408\u5BF9\u51B3\u4E4B\u5904\u3002\\n\u2026\u2026\u968F\u9119\u4EBA\u6765\u3002",
  "\u5E55\u540E\u5317\u4E0A\u9B3C\u9762\u7EC4\u2014\u2014\u6751\u6B63\uFF01\\n\u9119\u4EBA\u2026\u2026\u6765\u4E5F\uFF01",
  "\u54C8\u3001\u54C8\u3001\u54C8\uFF01\\n\u6CA1\u60F3\u5230\u8FDE\u9119\u4EBA\u90FD\u88AB\u4F60\u6253\u8D25\u4E86\uFF01\\r\\n\u4F60\u914D\u5F97\u4E0A\u9119\u4EBA\u7684\u79F0\u8D5E\uFF01",
  "\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026",
  "\u2026\u2026\u5F00\u73A9\u7B11\u7684\uFF01\\n\u8F9B\u82E6\u4F60\u4E86\uFF01",
  "\u4F60\u521A\u521A\u4F53\u9A8C\u7684\u662F\u9B3C\u9762\u7EC4\u6D3B\u52A8\uFF01\\n\u662F\u4E00\u573A\u80FD\u8BA9\u5C0F\u5B69\u5B50\u953B\u70BC\u8170\u817F\uFF0C\\r\\n\u4E86\u89E3\u5BF9\u6218\u4E50\u8DA3\u7684\u6D3B\u52A8\u54E6\u3002",
  "\u867D\u7136\u6BCF\u5E74\u90FD\u4F1A\u5728\u63A9\u9762\u796D\u671F\u95F4\\n\u4E3E\u884C\u8FD9\u573A\u6D3B\u52A8\u2026\u2026",
  "\u4F46\u5DE5\u4F5C\u4EBA\u5458\u90FD\u4E0D\u61C2\u5F97\u624B\u4E0B\u7559\u60C5\uFF0C\\n\u4ECE\u6765\u6CA1\u6709\u5C0F\u5B69\u80FD\u591F\u901A\u5173\uFF01",
  "\u8FDE\u6211\u90FD\u6253\u8D25\u7684\u4EBA\uFF0C\\n\u4F60\u5927\u6982\u8FD8\u662F\u7B2C\u4E00\u4E2A\u5462\uFF01",
  "\u6240\u4EE5\u606D\u559C\u4F60\uFF01\\n\u5956\u54C1\u8D4F\u7ED9\u4F60\u4E86\uFF01\uFF01",
  "\u5E0C\u671B\u4F60\u4ECA\u540E\u4E5F\u80FD\u5728\u5317\u4E0A\u7684\u5927\u81EA\u7136\u4E2D\\n\u7EE7\u7EED\u6210\u957F\uFF0C\u53D8\u5F97\u66F4\u5F3A\u554A\uFF01",
  "\u54E6\u54E6\uFF0C\u5F3A\u5927\u7684\u5B69\u5B50\u554A\uFF01\\n\u4F60\u6765\u89C1\u9119\u4EBA\u5566\uFF01\\r\\n\u54C8\u3001\u54C8\u3001\u54C8\uFF0C\u4E50\u54C9\u4E50\u54C9\uFF01"
]
