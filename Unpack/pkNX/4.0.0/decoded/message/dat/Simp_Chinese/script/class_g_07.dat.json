[
  "\u8BF8\u4F4D\uFF0C\u6536\u8D77\u4F60\u4EEC\u7684\u624B\u673A\uFF0C\\n\u5F00\u59CB\u672C\u5B66\u671F\u6700\u540E\u4E00\u5802\u8BFE\u5427\u3002[VAR 0114(0029)]",
  "\u56DE\u60F3\u8D77\u6765\uFF0C\u543E\u8F88\u5728\u8BFE\u4E0A\u6240\u8BB2\u7684\\n\u5C3D\u662F\u8863\u98DF\u4F4F\u7684\u201C\u98DF\u201D\u554A\u3002[VAR 0114(0029)]",
  "\u867D\u7136\u6709\u4E9B\u665A\u4E86\uFF0C\\n\u4F46\u543E\u8F88\u8FD8\u662F\u8BB2\u8BB2\u201C\u8863\u201D\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u670D\u88C5\u76F8\u5173\u7684\u4E8B\u5427\u3002[VAR 0114(0029)]",
  "\u8BF8\u4F4D\u5E94\u8BE5\u90FD\u77E5\u9053\uFF0C\\n\u672C\u6821\u7684\u6821\u98CE\u5F88\u81EA\u7531\u3002[VAR 0114(0029)]",
  "\u4E3A\u4E86\u914D\u5408\u5E15\u5E95\u4E9A\u5730\u533A\u591A\u6837\u7684\u6C14\u5019\uFF0C\\n\u5B66\u6821\u6309\u5B63\u8282\u51C6\u5907\u4E86\u591A\u5957\u5236\u670D\u3002\\r\\n\u4E0D\u8FC7\uFF0C\u4EC0\u4E48\u65F6\u5019\u7A7F\u54EA\u4EF6\u5236\u670D\u90FD\u662F\u968F\u610F\u7684\u3002[VAR 0114(0029)]",
  "\u8BF8\u4F4D\u5728\u5165\u5B66\u65F6\u5E94\u8BE5\u90FD\u9886\u5230\u4E86\\n\u9002\u5408\u6625\u590F\u79CB\u51AC\u5404\u4E2A\u5B63\u8282\u6240\u7A7F\u7684\\r\\n\u4E0A\u88C5\u548C\u4E0B\u88C5\u5404\uFF14\u4EF6\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u5982\u679C\u6709\u540C\u5B66\u6CA1\u6CE8\u610F\u5230\uFF0C\\n\u5C31\u8BF7\u786E\u8BA4\u4E00\u4E0B\u81EA\u5DF1\u7684\u8863\u67DC\u3002[VAR 0114(0029)]",
  "\u5E73\u65F6\u53EA\u8981\u7A7F\u4E0A\u5236\u670D\uFF0C\\n\u5C31\u53EF\u4EE5\u4E0D\u4F7F\u7528\u5B66\u6821\u6307\u5B9A\u7684\u5305\u5305\u3002[VAR 0114(0029)]",
  "\u800C\u4E14\u6234\u54EA\u79CD\u5E3D\u5B50\uFF0C\u6234\u4E0D\u6234\u5E3D\u5B50\uFF0C\\n\u751A\u81F3\u8FDE\u53D1\u578B\u90FD\u662F\u81EA\u7531\u7684\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u8D5B\u5409\u8001\u5E08\u7684\u53D1\u578B\\n\u5982\u679C\u662F\u653E\u5728\u543E\u8F88\u5E74\u8F7B\u7684\u65F6\u5019\uFF0C\\r\\n\u4E5F\u4F1A\u8FDD\u53CD\u6821\u89C4\u7684\u554A\u3002[VAR 0114(0029)]",
  "\u8BDD\u8BF4\u2026\u2026[VAR 0114(0029)]",
  "\u8BF8\u4F4D\u9664\u4E86\u670D\u88C5\u4E4B\u5916\\n\u7ECF\u5E38\u4F1A\u6539\u53D8\u98CE\u683C\u800C\u4E14\u5F88\u53EF\u7231\u7684\u90A3\u4E2A\\r\\n\u2026\u2026\u7A76\u7ADF\u662F\u600E\u4E48\u505A\u7684\u5462\uFF1F[VAR 0114(0029)]",
  "\u6559\u5BA4\u7684\u8BFE\u684C\uFF1F",
  "\u5BBF\u820D\uFF1F",
  "\u624B\u673A\u6D1B\u6258\u59C6\uFF1F",
  "\u4E0D\uFF0C\u4E0D\u662F\u2026\u2026\\n\u662F\u66F4\u5C0F\u3001\u66F4\u53EF\u7231\u7684\u90A3\u4E2A\u2026\u2026\\r\\n\u8BDD\u8BF4\uFF0C\u4F60\u7684\u8BFE\u684C\\r\\n\u660E\u660E\u5C31\u5F88\u5E73\u6DE1\u65E0\u5947\u554A\uFF01[VAR 0114(0029)]",
  "\u4E0D\u3001\u4E0D\u662F\u2026\u2026\\n\u662F\u66F4\u5C0F\u3001\u66F4\u53EF\u7231\u7684\u90A3\u4E2A\u2026\u2026\\r\\n\u8BDD\u8BF4\uFF0C\u5982\u679C\u543E\u8F88\u4E86\u89E3\u8BF8\u4F4D\u5BBF\u820D\u7684\u72B6\u51B5\uFF0C\\r\\n\u90A3\u53EF\u5C31\u662F\u4E2A\u95EE\u9898\u4E86\u3002[VAR 0114(0029)]",
  "\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\uFF01\u5C31\u662F\u90A3\u4E2A\u53EF\u7231\u7684\u4E1C\u897F\uFF01\\n\u543E\u8F88\u4E00\u76F4\u90FD\u5F88\u5728\u610F\uFF01\uFF01[VAR 0114(0029)]",
  "\u6CA1\u9519\u2026\u2026\u5C31\u662F\u624B\u673A\u6D1B\u6258\u59C6\uFF01[VAR 0114(0029)]",
  "\u2026\u2026\u539F\u6765\u5982\u6B64\uFF0C\u9887\u6709\u610F\u601D\uFF01\\n\u5728\u53EB\u505A\u4FE1\u4F7F\u9E1F\u5305\u5305\u7684\u5546\u5E97\\r\\n\u80FD\u4E70\u5230\u624B\u673A\u6D1B\u6258\u59C6\u7684\u624B\u673A\u58F3\u554A\uFF01[VAR 0114(0029)]",
  "\u8FD9\u4E2A\u4FE1\u606F\u5F88\u5B9E\u7528\uFF0C\u591A\u8C22\u2026\u2026[VAR 0114(0029)]",
  "\u543E\u8F88\u660E\u5929\u5C31\u7ACB\u523B\u53BB\u4E70\\n\u81EA\u5DF1\u4E2D\u610F\u7684\u53EF\u7231\u7684\u624B\u673A\u58F3\u597D\u4E86\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u95F2\u8BDD\u8BF4\u5F97\u592A\u591A\u4E86\u554A\u3002[VAR 0114(0029)]",
  "\u597D\u4E86\uFF0C\u548C\u543E\u8F88\u4E00\u8D77\u5C06\u540D\u4E3A\u5BB6\u653F\u7684\\n\u751F\u6D3B\u5FC5\u9700\u4E4B\u672F\u78E8\u7EC3\u81F3\u4ECA\u7684\u8BF8\u4F4D\u3002\\r\\n\u543E\u8F88\u8981\u544A\u8BC9\u4F60\u4EEC\u3002[VAR 0114(0029)]",
  "\u543E\u8F88\u6559\u7684\u8FD9\u95E8\u5B66\u95EE\u548C\u6570\u5B66\u4E4B\u7C7B\u7684\u4E0D\u540C\uFF0C\\n\u5B83\u4E0D\u662F\u4EE5\u8003\u8BD5\u5206\u6570\u51B3\u5B9A\u8BF8\u4F4D\u524D\u9014\\r\\n\u90A3\u79CD\u5413\u4EBA\u7684\u5B66\u95EE\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u4E0D\u8FC7\uFF0C\u5236\u4F5C\u6599\u7406\\n\u6216\u7167\u987E\u5B9D\u53EF\u68A6\u7684\u65F6\u95F4\uFF0C\\r\\n\u4EE5\u53CA\u65E9\u4E0A\u8D77\u5E8A\u540E\u6311\u9009\u8863\u670D\u7684\u65F6\u95F4\u7B49\u7B49\u2026\u2026[VAR 0114(0029)]",
  "\u5982\u679C\u5B83\u4EEC\u80FD\u6210\u4E3A\u5145\u5B9E\u8BF8\u4F4D\u4EBA\u751F\u7684\\n\u5C0F\u5C0F\u6DA6\u6ED1\u5242\uFF0C\u5C31\u662F\u543E\u8F88\u7684\u8363\u5E78\u4E86\u3002\\r\\n\u2026\u2026\u8FD9\u662F\u4ECE\u516B\u6714\u8001\u5E08\u90A3\u91CC\u62FE\u5230\u7684\u7259\u6167\u3002[VAR 0114(0029)]",
  "\u611F\u8C22\u8BF8\u4F4D\u966A\u543E\u8F88\\n\u4E0A\u5B8C\u4E86\u8FD9\u95E8\u8BFE\u3002[VAR 0114(0029)]",
  "\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u671F\u672B\u8003\u8BD5\u4E5F\u8BF7\u8BF8\u4F4D\u52A0\u6CB9\u3002[VAR 0114(0029)]"
]
