  "\u5C0F\u5B69\u5B50\u603B\uFF5E\u662F\u5168\u529B\u4EE5\u8D74\uFF0C\\n\u771F\u662F\u4E0D\u5F97\u4E86\u554A\u2026\u2026[VAR 0114(0028)]",
