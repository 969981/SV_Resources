  "\u4E00\u4E0D\u505A\u4E8C\u4E0D\u4F11\uFF0C\u6211\u8981\u8BA9\u5168\u4E16\u754C\\n\u90FD\u77E5\u9053\u8389\u666E\u7684\u7F8E\u4E3D\u79D8\u8BC0\uFF01[VAR 0114(001C)]",
  "\u8BF4\u8D77\u6765\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u8FD8\u8BB0\u5F97\u4F60\u548C\u8389\u666E\u6211\u4E4B\u95F4\u7684\u7EA6\u5B9A\u5417\uFF1F[VAR 0114(001C)]",
  "\u80FD\u597D\u597D\u8BB0\u4F4F\u6765\u81EA\u957F\u8F88\u7684\u610F\u89C1\uFF0C\\n\u771F\u662F\u4E86\u4E0D\u8D77\u5440\u3002[VAR 0114(001C)]",
  "\u867D\u7136\u4F60\u88C5\u50BB\u7684\u6837\u5B50\u4E5F\u5F88\u53EF\u7231\u2026\u2026\\n\u4F46\u4EC5\u9650\u73B0\u5728\u54E6\u3002[VAR 0114(001C)]",
  "\u8981\u8BA9\u81EA\u5DF1\u7684\u624D\u80FD\u767B\u5CF0\u9020\u6781\uFF0C\\n\u4E0D\u65AD\u53D1\u5149\u53D1\u4EAE\u7684\u7EA6\u5B9A\u2026\u2026[VAR 0114(001C)]",
  "\u770B\u6765\u6211\u5B8C\u5168\u4E0D\u7528\u62C5\u5FC3\uFF01\\n\u4E0D\u5982\u8BF4\u2026\u2026\u5475\u5475\uFF01\\r\\n\u8389\u666E\u6211\u751A\u81F3\u6709\u70B9\u201C\u60CA\u5403\u201D\u3002[VAR 0114(001C)]",
