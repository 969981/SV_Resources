  "\u7B54\u5F97\u5BF9\uFF01\\n\u8389\u666E\u6211\u662F\u4E2A\u5316\u5986\u5E08\uFF01\\c\\n\u800C\u4E14\u8FD8\u517C\u804C\u6A21\u7279\\n\u548C\u9053\u9986\u9986\u4E3B\u3002[VAR 0114(001C)]",
  "\u5728\u8FD9\u91CC\u6709\u5F88\u591A\u4E0D\u8BA4\u8BC6\u7684\u4EBA\uFF0C\\n\u5F53\u544A\u8BC9\u4ED6\u4EEC\u8389\u666E\u6211\u7684\u804C\u4E1A\u540E\uFF0C\\r\\n\u5927\u5BB6\u90FD\u975E\uFF5E\u5E38\u611F\u5174\u8DA3\u3002[VAR 0114(001C)]",
