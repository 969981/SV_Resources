  "\u53EF\u4E0D\u8BB8\u4F60\u5FD8\u4E86\\n\u548C\u8389\u666E\u6211\u7684\u65B0\u7EA6\u5B9A\u54E6\u3002[VAR 0114(001C)]",
  "\u4E3A\u4E86\u80FD\u8BA9\u4F60\u8BB0\u4F4F\u8FD9\u4E2A\u65B0\u7EA6\u5B9A\u2026\u2026\\n\u4F60\u8981\u548C\u8389\u666E\u6211\u521B\u9020\u4E00\u4E9B\u56DE\u5FC6\u5417\uFF1F[VAR 0114(001C)]",
  "\u2026\u2026\u5BF9\u4E86\uFF01\u6765\u548C\u8389\u666E\u6211\\n\u8FDB\u884C\u5B9D\u53EF\u68A6\u4EA4\u6362\u5427\uFF01[VAR 0114(001C)]",
  "\u5475\u5475\uFF01\u8FD9\u6837\u624D\u5BF9\u561B\uFF01\\n\u8389\u666E\u6211\u4F1A\u7528\u98D8\u98D8\u96CF\u6765\u4EA4\u6362\uFF0C\\r\\n\u4F60\u4F1A\u9009\u62E9\u54EA\u4E2A\u5B69\u5B50\u5462\uFF1F[VAR 0114(001C)]",
  "\u5C45\u7136\u9009\u62E9[VAR 0101(0001)]\uFF01\\n\u5475\u5475\uFF01\u4F60\u6709\u9897\u5F88\u68D2\u7684\u7231\u7F8E\u4E4B\u5FC3\u5462\u3002\\c\\n\u6211\u4F1A\u628A\u5B83\u5F53\u6210\u662F[VAR 0100(0000)]\u4F60\uFF0C\\n\u6E29\u67D4\u5730\u79C1\u85CF\u8D77\u5B83\uFF0C\u57F9\u80B2\u5B83\u7684\u3002[VAR 0114(001C)]",
  "[VAR 0100(0000)]\u4F60\u8981\u7528[VAR 0101(0001)]\\n\u548C\u8389\u666E\u6211\u7684\u98D8\u98D8\u96CF\u4EA4\u6362\uFF1F[VAR 0114(001C)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u2026\u2026\u53EF\u4E0D\u8BB8\u5728\u540C\u884C\u5B9D\u53EF\u68A6\\n\u53EA\u6709\uFF11\u53EA\u65F6\u8FDB\u884C\u4EA4\u6362\u54E6\u3002\\c\\n\u8981\u662F\u540C\u884C\u5B9D\u53EF\u68A6\u81F3\u5C11\u6709\uFF12\u53EA\u7684\u8BDD\uFF0C\\n\u90A3\u8FD8\u597D\u8BF4\u2026\u2026[VAR 0114(001C)]",
  "\u62DC\u6258\u4F60\u8981\u5728\u8389\u666E\u6211\\n\u6539\u53D8\u5FC3\u610F\u524D\u518D\u6765\u54E6\u3002[VAR 0114(001C)]",
  "\u5475\u5475\uFF01\u7B49\u4F60\u5F88\u4E45\u4E86\u3002\\n\u4F60\u8981\u548C\u8389\u666E\u6211\u7684\u98D8\u98D8\u96CF\u4EA4\u6362\u4E86\u5417\uFF1F[VAR 0114(001C)]",
  "\u563F\uFF0C[VAR 0100(0000)]\u3002\\n\u8981\u548C\u8389\u666E\u6211\u4E00\u8D77\u8FFD\u6C42\u7A76\u6781\u7684\u7F8E\u5417\uFF1F[VAR 0114(001C)]",
  "\u54CE\u5440\uFF0C\u4F60\u5C45\u7136\u62D2\u7EDD\u4E86\u8389\u666E\u6211\u7684\u9080\u8BF7\uFF0C\\n\u771F\u662F\u4E2A\u5927\u4EBA\u7269\u554A\u3002[VAR 0114(001C)]",
  "\u5475\u5475\uFF0C\u90A3\u5C31\u8FD9\u6837\u3002\\n\u6211\u4EEC\u53BB\u5BF9\u6218\u573A\u5427\u3002[VAR 0114(001C)]",
  "[~ 59]",
  "\u7F8E\u4E3D\u81F3\u6781\uFF0C\u5F3A\u5927\u65E0\u6BD4\uFF0C\\n\u800C\u4E14\u6709\u9B54\u6CD5\u52A0\u6301\uFF01[VAR 0114(001C)]",
  "\u2026\u2026\u5F88\u9AD8\u5174\u4F60\u9075\u5B88\u4E86\\n\u548C\u8389\u666E\u6211\u4E4B\u95F4\u7684\u7EA6\u5B9A\u3002[VAR 0114(001C)]",
  "\u4F60\u8BF4\u4E0D\u5B9A\u80FD\u8D85\u8D8A\u8389\u666E\u6211\uFF0C\\n\u6210\u4E3A\u4E00\u4E2A\u8D85\u7EA7\u5927\u4EBA\u7269\uFF0C\\r\\n\u6240\u4EE5\u8BA9\u6211\u9001\u4F60\u70B9\u597D\u4E1C\u897F\u5427\u3002[VAR 0114(001C)]",
  "\u90A3\u53EF\u662F\u5F88\u201C\u5927\u5F3A\u201D\u7684\u4E1C\u897F\u54E6\u3002\\n\u56DE\u793C\u5C31\u7B49\u4F60\u4EE5\u540E\u51FA\u4EBA\u5934\u5730\u518D\u7ED9\u6211\u5427\u3002[VAR 0114(001C)]",
  "[~ 59]",
  "\u5728\u7F8E\u4E3D\u4E0A\u6211\u4EEC\u53EF\u662F\u6253\u6210\u5E73\u624B\u7684\u54E6\u3002\\n\u6765\uFF0C\u6536\u4E0B\u6211\u7684\u5FC3\u610F\u5427\u3002[VAR 0114(001C)]",
  "\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u8981\u518D\u6765\u5F53\u6211\u7684\u5BF9\u624B\u54E6\u3002[VAR 0114(001C)]",
  "\u65E0\u8BBA\u662F\u5BF9\u6218\u4E0A\uFF0C\u8FD8\u662F\u7F8E\u4E3D\u4E0A\uFF0C\\n\u8389\u666E\u6211\u90FD\u8D62\u4E86\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u201C\u6258\u62DC\u201D\u4F60\u4E0D\u8981\u7070\u5FC3\uFF0C\\n\u4E5F\u4E0D\u8981\u592A\u4ECB\u610F\u54E6\u3002[VAR 0114(001C)]",
  "\u867D\u7136\u8389\u666E\u6211\u5F88\u5FD9\uFF0C\\n\u4F46\u53EA\u8981\u662F[VAR 0100(0000)]\u4F60\u53EB\u6211\uFF0C\\r\\n\u6211\u968F\u65F6\u90FD\u4F1A\u8D76\u7D27\u8FC7\u6765\u7684\uFF01[VAR 0114(001C)]",
  "\u51F0\u6A97\u5F53\u8001\u5E08\\n\u5F53\u5F97\u8FD8\u597D\uFF5E\u5417\uFF1F\\r\\n\u90A3\u5B69\u5B50\u4ECE\u4EE5\u524D\u5F00\u59CB\u5C31\u6709\u70B9\u5192\u5931\u3002[VAR 0114(001C)]",
  "\u5E73\u65F6\u603B\u6446\u540C\u4E00\u4E2A\u59FF\u52BF\\n\u662F\u4E0D\u53EF\u53D6\u7684\u54E6\u3002\\c\\n\u8FD9\u65F6\u8BE5\u600E\u4E48\u529E\u624D\u597D\uFF1F\\n\u5475\u5475\uFF01\u5F53\u7136\u662F\u505A\u559C\u6012\u60CA\u4E50\u4F53\u64CD\u554A\uFF01[VAR 0114(001C)]",
  "[VAR 0101(0001)]\u771F\u662F\u5F88\u68D2\u7684\u7D20\u6750\uFF0C\\n\u6211\u4F1A\u628A\u5B83\u57F9\u80B2\u5F97\u7F8E\u4E3D\u52A8\u4EBA\u7684\u3002[VAR 0114(001C)]",
  "\u8389\u666E\u6211\u7684\u98D8\u98D8\u96CF\\n\u8FC7\u5F97\u8FD8\u597D\u5417\uFF1F\\c\\n\u5B83\u65E2\u201C\u5927\u5F3A\u201D\uFF0C\u53C8\u201C\u5BB3\u5389\u201D\uFF0C\\n\u662F\u4E2A\u4F1A\u8BA9\u4EBA\u201C\u60CA\u5403\u201D\u7684\u597D\u7D20\u6750\u5427\uFF01[VAR 0114(001C)]",
  "[VAR 0100(0000)]\uFF0C\u4F60\u2026\u2026\\n\u628A\u8389\u666E\u6211\u9009\u4E3A\u4E86\\r\\n\u4F60\u6700\u559C\u6B22\u7684\u9053\u9986\u9986\u4E3B\u554A\u3002\\c\\n\u662F\u90A3\u4E2A\u4EBA\u2026\u2026\\n\u4E5F\u6148\u5979\u544A\u8BC9\u6211\u7684\u3002\\c\\n\u660E\u660E\u53EA\u8981\u4F60\u8DDF\u6211\u8BF4\u4E00\u58F0\uFF0C\\n\u6211\u9A6C\u4E0A\u5C31\u4F1A\u6765\u628A\u4F60\u79C1\u85CF\u8D77\u6765\u7684\u2026\u2026\\c\\n\u8389\u666E\u6211\u5BF9\u4F60\u4E5F\u5F88\u4E2D\u610F\u54E6\uFF01\\n\u5475\u5475\u2026\u2026\uFF01\u4E24\u60C5\u76F8\u60A6\u5462\uFF01[VAR 0114(001C)]"
]
