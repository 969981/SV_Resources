[
  "\u4F60\u6349\u5230\u963F\u7F57\u62C9\u7684\u6837\u5B50\u7684\\n\u5B9D\u53EF\u68A6\u4E86\u5417\uFF1F",
  "\u6000\u7740\u963F\u7F57\u62C9\u7684\u5FC3\u60C5\\n\u56DB\u5904\u8D70\u8D70\u5427\uFF01",
  "\u2026\u2026\u5F88\u9057\u61BE\uFF0C\u8FD9\u53EA\u5B9D\u53EF\u68A6\\n\u4E0D\u662F\u963F\u7F57\u62C9\u7684\u6837\u5B50\u3002",
  "\u54E6\u54E6\uFF01\u6CA1\u9519\uFF01\\n\u8FD9\u53EA[VAR 0101(0001)]\u662F\u963F\u7F57\u62C9\u7684\u6837\u5B50\uFF01",
  "\u5B83\u4F1A\u9A91\u4E0A\u96C6\u4E2D\u4E86\u7CBE\u795E\u529B\u91CF\u7684\u5C3E\u5DF4\uFF0C\\n\u50CF\u6ED1\u884C\u4E00\u6837\u79FB\u52A8\u3002\\r\\n\u8FD8\u88AB\u79F0\u4E3A\u201C\u9646\u5730\u51B2\u6D6A\u624B\u201D\u5462\uFF01",
  "\u5B83\u4F1A\u6446\u52A8\u4ECE\u5934\u4E0A\u957F\u51FA\u7684\\n\u91D1\u5C5E\u6750\u8D28\u7684\u80E1\u987B\uFF0C\\r\\n\u8DDF\u4F19\u4F34\u8FDB\u884C\u4EA4\u6D41\uFF01",
  "\u5B83\u95EA\u7740\u91D1\u5149\u7684\u80E1\u987B\\n\u662F\u9AD8\u7075\u654F\u7684\u611F\u5E94\u5668\u3002\\r\\n\u8FDE\u6570\u516C\u91CC\u5916\u7684\u58F0\u97F3\u4E5F\u80FD\u611F\u77E5\u5230\uFF01",
  "\u5B83\u6D6E\u8E81\u3001\u4EFB\u6027\u3001\u8010\u4E0D\u4F4F\u6027\u5B50\uFF01\\n\u6DF1\u53D7\u6BD4\u8D77\u88AB\u522B\u4EBA\u7167\u987E\uFF0C\\r\\n\u66F4\u559C\u6B22\u7167\u987E\u522B\u4EBA\u7684\u8BAD\u7EC3\u5BB6\u6B22\u8FCE\uFF01",
  "\u5B83\u62E5\u6709\u4F18\u79C0\u7684\u4F53\u80FD\uFF0C\\n\u5706\u5706\u7684\u8138\u5B54\u548C\u5149\u6ED1\u7684\u6BDB\u53D1\\r\\n\u8BA9\u5B83\u5728\u963F\u7F57\u62C9\u5730\u533A\u5907\u53D7\u6B22\u8FCE\uFF01",
  "\u5B83\u662F\u4E3A\u4E86\u89E3\u51B3\u5783\u573E\u95EE\u9898\\n\u800C\u4ECE\u5176\u4ED6\u5730\u533A\u5E26\u5230\u963F\u7F57\u62C9\u7684\u81ED\u6CE5\\r\\n\u4E0D\u77E5\u4E0D\u89C9\u53D8\u6210\u7684\u6837\u5B50\uFF01",
  "\u5B83\u770B\u4E0A\u53BB\u50CF\u7259\u9F7F\u6216\u722A\u5B50\u7684\u4E1C\u897F\u5176\u5B9E\u662F\\n\u6BD2\u7D20\u7684\u7ED3\u6676\u3002\u53EA\u8981\u78B0\u5230\u5C31\u4F1A\u4E2D\u6BD2\uFF0C\\r\\n\u6240\u4EE5\u9760\u8FD1\u5B83\u5F88\u5371\u9669\uFF01",
  "\u5B83\u60A0\u7136\u60EC\u610F\u5730\u957F\u5927\uFF0C\\n\u6240\u4EE5\u4E0D\u518D\u9700\u8981\u7CBE\u795E\u529B\u91CF\uFF0C\\r\\n\u4E8E\u662F\u4F53\u5185\u7684\u9F99\u4E4B\u529B\u91CF\u5C31\u89C9\u9192\u4E86\uFF01",
  "\u5B83\u4F1A\u55B7\u51FA\u96F6\u4E0B\uFF15\uFF10\u5EA6\u7684\u51B7\u6C14\uFF61\\n\u6709\u65F6\u5019\u4EBA\u4EEC\u4F1A\u7528\u8FC7\u53BB\u7684\u540D\u5B57\\r\\n\u79F0\u547C\u5B83\u4E3A\u51EF\u6B27\u51EF\u6B27\uFF01",
  "\u5B83\u6816\u606F\u5728\u5927\u96EA\u51B0\u5C01\u7684\u6DF1\u5C71\u4E2D\uFF0C\\n\u4F1A\u4ECE\u4F53\u6BDB\u4E2D\u751F\u51FA\u51B0\u7C92\u3002\\r\\n\u4EBA\u4EEC\u66FE\u628A\u5B83\u656C\u4E3A\u795E\u7684\u5316\u8EAB\uFF01",
  "\u5B83\u6816\u606F\u4E8E\u88AB\u96EA\u5305\u56F4\u7740\u7684\u5C71\u5CB3\u5730\u5E26\uFF0C\\n\u62E5\u6709\u94A2\u94C1\u822C\u575A\u786C\u7684\u51B0\u96EA\u810A\u80CC\\r\\n\u548C\u67D4\u8F6F\u7684\u809A\u5B50\uFF01",
  "\u5B83\u4E3A\u4E86\u5C06\u96EA\u62E8\u5F00\uFF0C\\n\u722A\u5B50\u957F\u5F97\u53C8\u7C97\u53C8\u5C16\uFF0C\u5341\u5206\u53D1\u8FBE\uFF0C\\r\\n\u80FD\u5728\u96EA\u539F\u4E0A\u5954\u9A70\uFF01",
  "\u5B83\u7684\u8EAB\u4F53\u662F\u5E26\u6709\u78C1\u529B\u7684\u77F3\u5934\u3002\\n\u5728\u78C1\u529B\u7279\u522B\u5F3A\u7684\u90E8\u5206\\r\\n\u5BC6\u5BC6\u9EBB\u9EBB\u5730\u9644\u7740\u94C1\u77FF\u7802\uFF01",
  "\u5B83\u53D7\u5230\u559C\u6B22\u5403\u7684\u77F3\u5934\u5F71\u54CD\uFF0C\\n\u5168\u8EAB\u90FD\u5E26\u7740\u7535\uFF0C\\r\\n\u800C\u4E14\u6027\u683C\u975E\u5E38\u597D\u6597\uFF01",
  "\u5B83\u7684\u4E2A\u6027\u987D\u56FA\u4E14\u96BE\u4EE5\u76F8\u5904\uFF01\\n\u5982\u679C\u5B83\u4E0D\u9AD8\u5174\u4E86\uFF0C\u5C31\u4F1A\u653E\u7535\uFF0C\\r\\n\u5E76\u4EE5\u96F7\u9E23\u822C\u7684\u58F0\u97F3\u543C\u53EB\uFF01",
  "\u4EC0\u4E48\uFF01\uFF1F[VAR 0100(0000)]\u4F60\\n\u5DF2\u7ECF\u6349\u5230\u4E86\u5417\uFF1F[VAR 0114(0049)]",
  "\u82B1\u4E86\u4E0D\u5C11\u529B\u6C14\uFF01",
  "\u5C0F\u83DC\u4E00\u789F\uFF01",
  "\u4F60\u4E0D\u5149\u64C5\u957F\u5BF9\u6218\uFF0C\\n\u7ADF\u7136\u8FD8\u64C5\u957F\u6355\u6349\u2026\u2026[VAR 0114(0049)]",
  "\u6A58\u5B50\u5B66\u9662\u7684\\n\u6C34\u5E73\u4E4B\u9AD8\u53EF\u89C1\u4E00\u6591\u3002[VAR 0114(0049)]",
  "\u8461\u8404\u5B66\u9662\u7684\\n\u6C34\u5E73\u4E4B\u9AD8\u53EF\u89C1\u4E00\u6591\u3002[VAR 0114(0049)]",
  "\u90A3\u597D\uFF0C\u8BF7\u5927\u5BB6\u5230\u8FD9\u91CC\u96C6\u5408\uFF5E\uFF01",
  "\u65F6\u95F4\u5230\u4E86\uFF0C\\n\u8FD9\u6B21\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\uFF01",
  "\u7ED9\u8FD8\u6CA1\u6349\u5230\u7684\u4EBA\u7559\u4E2A\u4F5C\u4E1A\uFF0C\\n\u4E0B\u6B21\u4E0A\u8BFE\u524D\u8981\u6349\u5230\u54E6\uFF01\\r\\n\u597D\u4E86\uFF0C\u89E3\u6563\uFF01",
  "\u5567\uFF5E\u6211\u5F97\u5B8C\u6210\u4F5C\u4E1A\u554A\uFF5E",
  "[VAR 0100(0000)]\uFF0C\\n\u84DD\u8393\u5B66\u56ED\u7684\u8BFE\u600E\u4E48\u6837\uFF1F[VAR 0114(0049)]",
  "\u4E0A\u5F97\u5F88\u5F00\u5FC3\uFF01",
  "\u5C0F\u83DC\u4E00\u789F\uFF01",
  "\u54C7\uFF0C\u592A\u597D\u4E86\uFF01\\n\u8FDE\u6211\u90FD\u8DDF\u7740\u5F00\u5FC3\u8D77\u6765\u4E86\u3002[VAR 0114(0049)]",
  "\u770B\u6765\u4F60\u4EEC\u5B66\u9662\u7684\u8BFE\u7A0B\\n\u6C34\u5E73\u66F4\u9AD8\u554A\u2026\u2026\uFF01[VAR 0114(0049)]",
  "\u5BF9\u4E86\uFF01\u6211\u5F97\u53BB\u793E\u56E2\u6D3B\u52A8\u5BA4\\n\u9732\u4E2A\u8138\u624D\u884C\uFF01[VAR 0114(0049)]",
  "\u5B66\u56ED\u4ECB\u7ECD\u5C31\u5230\u6B64\u4E3A\u6B62\u4E86\uFF0C\\n\u4F46\u6700\u540E\u8FD9\u4EF6\u4E8B\u8BF7\u4F60\u4E00\u5B9A\u8981\u542C\uFF01[VAR 0114(0049)]",
  "\u8FD9\u6240\u5B66\u56ED\\n\u76DB\u884C[VAR FF00(0006)]\u84DD\u8393\u8DA3\u4E50\u6D3B\u52A8[VAR FF00(0000)]\uFF0C\\r\\n\u7B80\u79F0[VAR FF00(0006)]\u84DD\u4E50\u6D3B[VAR FF00(0000)]\uFF01[VAR 0114(0049)]",
  "\u84DD\u4E50\u6D3B\u662F\u5B66\u56ED\u5E03\u7F6E\u7684\u4EFB\u52A1\uFF0C\\n\u5728\u5DE8\u86CB\u5185\u6D3B\u52A8\u65F6\u4F1A\u6536\u5230\u3002[VAR 0114(0049)]",
  "\u6BD4\u5982\u6765\u573A\u81EA\u4E3B\u5BF9\u6218\u5427\uFF5E\\n\u6355\u6349\u7279\u5B9A\u7684\u5B9D\u53EF\u68A6\u5427\uFF5E\u4E4B\u7C7B\u7684\uFF0C\\r\\n\u6709\u5404\u79CD\u5404\u6837\u7684\u4EFB\u52A1\uFF01[VAR 0114(0049)]",
  "\u5E03\u7F6E\u4EFB\u52A1\u7684\u65F6\u95F4\u3001\u5730\u70B9\uFF0C\\n\u4EE5\u53CA\u5185\u5BB9\u662F\u600E\u6837\u7684\uFF0C\u8C01\u90FD\u9884\u60F3\u4E0D\u5230\u3002[VAR 0114(0049)]",
  "\u6BCF\u5F53\u5B8C\u6210\u4EFB\u52A1\uFF0C\u90FD\u80FD\u83B7\u5F97\\n\u5728\u5B66\u56ED\u5185\u6D41\u901A\u7684\u8D27\u5E01\uFF0C[VAR FF00(0006)]\uFF22\uFF30\uFF08\u84DD\u8393\u70B9\u6570\uFF09[VAR FF00(0000)]\uFF01[VAR 0114(0049)]",
  "\uFF22\uFF30\u53EF\u4EE5\u5728[VAR FF00(0006)]\u98DF\u5802[VAR FF00(0000)]\u548C[VAR FF00(0006)]\u5C0F\u5356\u90E8[VAR FF00(0000)]\\n\u4F5C\u4E3A\u94B1\u6765\u4F7F\u7528\u54E6\uFF01\\r\\n\u8FD8\u6709\u4ECA\u540E[VAR FF00(0006)]\u793E\u56E2\u6D3B\u52A8[VAR FF00(0000)]\u4E5F\u2026\u2026[VAR 0114(0049)]",
  "\u6211\u7684\u9996\u63A8\u5C31\u662F\u84DD\u4E50\u6D3B\uFF01\\n\u53C2\u52A0\u84DD\u4E50\u6D3B\uFF0C\u6536\u96C6\uFF22\uFF30\u5427\uFF01[VAR 0114(0049)]",
  "\u2026\u2026\u6211\u8981\u8BF4\u7684\u5C31\u662F\u8FD9\u4E9B\uFF01\\n\u6025\u6025\u5FD9\u5FD9\u7684\uFF0C\u771F\u662F\u62B1\u6B49\u3002[VAR 0114(0049)]",
  "\u90A3\u4E48\u6211\u5C31\u544A\u8F9E\u4E86\uFF01\\n\u5C3D\u60C5\u4EAB\u53D7\u5B66\u56ED\u751F\u6D3B\u5427\uFF01[VAR 0114(0049)]",
  "\u4ECE\u8FD9\u91CC\u5F00\u59CB\uFF0C\\n\u82E5\u8981\u8FDB\u5165\u540E\u9762\u7684\u5267\u60C5\uFF0C\\c\\n\u5FC5\u987B\u5148\u5B8C\u6210\u672C\u7BC7\u7684\u4E3B\u7EBF\u5267\u60C5\\n\u548C\u300A\u96F6\u4E4B\u79D8\u5B9D\u300B\u201C\u524D\u7BC7\uFF1A\u78A7\u4E4B\u5047\u9762\u201D\u3002\\c\\n\u5B8C\u6210\u5728[VAR FF00(0006)]\u5E15\u5E95\u4E9A\u5730\u533A[VAR FF00(0000)]\u548C[VAR FF00(0006)]\u5317\u4E0A\u4E61[VAR FF00(0000)]\\n\u5C1A\u672A\u505A\u5B8C\u7684\u4E8B\u60C5\u5427\uFF01"
]
