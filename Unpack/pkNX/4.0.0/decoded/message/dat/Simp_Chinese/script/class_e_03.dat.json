[
  "\u4ECA\u5929\u4E5F\u8981\u7CBE\u529B\u5145\u6C9B\u5730\u5B66\u4E60\u5BF9\u6218\u5B66\uFF01\\n\u563F\u5440\uFF01\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01[VAR 0114(0024)]",
  "\u4E4B\u524D\u6211\u6559\u7684\u592A\u6676\u56E2\u4F53\u6218\uFF01\\n\u5404\u4F4D\u540C\u5B66\u53BB\u6311\u6218\u4E86\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u592A\u6676\u5B9D\u53EF\u68A6\u53EF\u662F\u5F3A\u654C\uFF01\\n\u8981\u662F\u9047\u4E0A\u9AD8\u96BE\u5EA6\u7684\u5BF9\u624B\uFF0C\\r\\n\u5B83\u8FD8\u4F1A\u91C7\u53D6\u5F88\u68D8\u624B\u7684\u884C\u52A8\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u5C31\u662F[VAR FF00(0006)]\u592A\u6676\u62A4\u76FE[VAR FF00(0000)]\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u5BF9\u624B\u5C55\u5F00\u4E86\u592A\u6676\u62A4\u76FE\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u6211\u65B9\u80FD\u7ED9\u4E88\u7684\\n\u4F24\u5BB3\u5C31\u4F1A\u5927\u91CF\u51CF\u5C11\uFF01[VAR 0114(0024)]",
  "\u592A\u6676\u62A4\u76FE\u4E00\u65E6\u88AB\u53D1\u52A8\u2026\u2026[VAR 0114(0024)]",
  "\u6211\u65B9\u5C31\u4F1A\u65E0\u8BA1\u53EF\u65BD\uFF0C\\n\u5F88\u53EF\u80FD\u5C31\u6B64\u843D\u8D25\u2026\u2026\uFF01[VAR 0114(0024)]",
  "\u73B0\u5728\u6211\u8981\u63D0\u95EE\u4E86\uFF01[VAR 0114(0024)]",
  "\u5F53\u5BF9\u624B\u5C55\u5F00\u592A\u6676\u62A4\u76FE\u65F6\uFF0C\\n\u6211\u4EEC\u5E94\u8BE5\u600E\u4E48\u529E\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u9759\u9759\u95ED\u4E0A\u773C\u775B",
  "\u7ED9\u5BB6\u91CC\u6253\u7535\u8BDD",
  "\u592A\u6676\u5316\u540E\u53BB\u653B\u51FB",
  "\u5582\u5582\u5582\uFF0C\\n\u522B\u90A3\u4E48\u8F7B\u6613\u5730\u5C31\u63A5\u53D7\u6700\u540E\u4E00\u523B\u554A\uFF01\\r\\n\u52AA\u529B\u6323\u624E\u5E94\u8BE5\u5C31\u80FD\u6253\u5F00\u7A81\u7834\u53E3\u7684\uFF01[VAR 0114(0024)]",
  "\u5582\u5582\u5582\uFF0C\\n\u4F60\u662F\u8981\u5728\u6C38\u522B\u6765\u4E34\u4E4B\u524D\u8DDF\u5BB6\u4EBA\u8BF4\u8BDD\u5417\uFF01\uFF1F\\r\\n\u52AA\u529B\u6323\u624E\u5E94\u8BE5\u5C31\u80FD\u6253\u5F00\u7A81\u7834\u53E3\u7684\uFF01[VAR 0114(0024)]",
  "\u6B63\u786E\u7B54\u6848\uFF01\\n\u8F6C\u5B66\u751F\u4F60\u771F\u662F\u592A\u6676\u56E2\u4F53\u6218\u7684\u5927\u5E08\u5462\uFF01[VAR 0114(0024)]",
  "\u5BF9\u4E8E\u5C55\u5F00\u4E86\u592A\u6676\u62A4\u76FE\u7684\u5BF9\u624B\uFF0C\\n\u666E\u901A\u7684\u653B\u51FB\u662F\u4E0D\u592A\u594F\u6548\u7684\uFF01[VAR 0114(0024)]",
  "\u4F46\u662F\uFF0C\u5982\u679C\u6211\u65B9\u4E5F\u901A\u8FC7\u592A\u6676\u5316\u53BB\u653B\u51FB\uFF0C\\n\u5C31\u4F1A\u662F\u6709\u6548\u7684\u624B\u6BB5\uFF01\\c\\n\u5982\u679C\u4F7F\u7528\u592A\u6676\u5C5E\u6027\u7684\u62DB\u5F0F\uFF0C\\n\u8FD8\u80FD\u7ED9\u4E88\u66F4\u5927\u7684\u4F24\u5BB3\uFF01[VAR 0114(0024)]",
  "\u53EA\u8981\u6301\u7EED\u7ED9\u4E88\u4F24\u5BB3\uFF0C\\n\u5C31\u80FD\u7834\u574F\u592A\u6676\u62A4\u76FE\uFF0C\\r\\n\u8FD8\u80FD\u8BA9\u5BF9\u624B\u5931\u53BB\u5E73\u8861\uFF01[VAR 0114(0024)]",
  "\u6240\u4EE5\u5728\u592A\u6676\u56E2\u4F53\u6218\u4E2D\\n\u4F7F\u7528\u592A\u6676\u5316\u7684\u65F6\u673A\u4E5F\u975E\u5E38\u91CD\u8981\u3002[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u4FD7\u8BDD\u8BF4\u4EE5\u7259\u8FD8\u7259\uFF01\\n\u5BF9\u4ED8\u592A\u6676\u5316\uFF0C\u5C31\u8981\u7528\u592A\u6676\u5316\uFF01[VAR 0114(0024)]",
  "\u8BF7\u5404\u4F4D\u52A1\u5FC5\u4E0E\u4F19\u4F34\u597D\u597D\u914D\u5408\uFF0C\\n\u51FB\u57AE\u5BF9\u65B9\u7684\u592A\u6676\u62A4\u76FE\u3002[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4E0B\u5802\u8BFE\u662F\u671F\u4E2D\u8003\u8BD5\u54DF\uFF01\\n\u8981\u4E89\u53D6\u62FF\uFF11\uFF10\uFF10\u5206\uFF01\u563F\u5440\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]"
]
