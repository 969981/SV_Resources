[
  "[VAR 0100(0000)]\uFF0C\u4F60\u6765\u5566\u3002[VAR 0114(0004)]",
  "\u60F3\u8981\u53C2\u52A0\u6821\u5185\u6700\u5F3A\u5927\u8D5B\uFF0C\\n\u5C31\u8981\u5411\u5DE5\u4F5C\u4EBA\u5458\u7533\u8BF7\u62A5\u540D\uFF01[VAR 0114(0004)]",
  "\u90A3\u5C31\u9EBB\u70E6\u4F60\u5BF9\u5927\u8D5B\\n\u4F5C\u4E2A\u8BF4\u660E\u5427\uFF01[VAR 0114(0004)]",
  "\u6821\u5185\u6700\u5F3A\u5927\u8D5B\u7684\u89C4\u5219\u662F\u8FD9\u6837\u7684\u3002\\n\u4E0D\u8BBA\u662F\u5B66\u751F\u8FD8\u662F\u8001\u5E08\u90FD\u80FD\u53C2\u52A0\uFF0C\\r\\n\u6BD4\u8D5B\u5BF9\u624B\u968F\u673A\u5B89\u6392\uFF0C\u8D62\u4E86\u624D\u80FD\u6253\u4E0B\u4E00\u573A\u3002",
  "\u8FD0\u8425\u65B9\u4F1A\u901A\u8FC7\u62BD\u7B7E\u7684\u65B9\u5F0F\\n\u51B3\u5B9A\u6BD4\u8D5B\u7684\u5BF9\u9635\u3002",
  "\u5BF9\u6218\u53CC\u65B9\u5728\u5BF9\u6218\u573A\u5BF9\u5CD9\u4E4B\u524D\uFF0C\\n\u65E0\u6CD5\u77E5\u9053\u81EA\u5DF1\u7684\u5BF9\u6218\u5BF9\u624B\u662F\u8C01\uFF01",
  "\u8D62\u4E0B\u6BD4\u8D5B\u7684\u4EBA\\n\u53EF\u4EE5\u7EE7\u7EED\u8FDB\u884C\u4E0B\u4E00\u573A\u6BD4\u8D5B\u3002",
  "\u53EA\u8981\u8F93\u4E00\u573A\u5C31\u4F1A\u51FA\u5C40\uFF0C\\n\u5E76\u4E14\u65E0\u6CD5\u5728\u4E4B\u540E\u7684\u6BD4\u8D5B\u51FA\u573A\u3002",
  "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u901A\u8FC7\u4E0D\u65AD\u5730\u5BF9\u6218\uFF0C\\n\u8D62\u5230\u6700\u540E\u7684\u90A3\u4E2A\u4EBA\\r\\n\u5C31\u662F\u6821\u5185\u6700\u5F3A\u8BAD\u7EC3\u5BB6\uFF01",
  "\u8C22\u8C22\uFF01[VAR 0114(0004)]",
  "\u5927\u8D5B\u7684\u89C4\u5219\u662F\\n\u6211\u548C\u514B\u62C9\u97E6\u5C14\u6821\u957F\u5546\u91CF\u540E\u5B9A\u4E0B\u7684\uFF01[VAR 0114(0004)]",
  "\u4EE5\u73B0\u5728\u62A5\u540D\u7684\u4EBA\u6570\u6765\u770B\uFF0C\\n\u5927\u6982\u8D62\u4E0B\uFF14\u573A\u5C31\u80FD\u593A\u51A0\u4E86\u5427\uFF01[VAR 0114(0004)]",
  "\u8001\u5E08\u4EEC\u4E5F\u662F\u5F3A\u624B\u5982\u6797\uFF0C\\n\u4F60\u53EF\u8981\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0004)]",
  "\u9664\u4E86\u6211\u4E4B\u5916\uFF0C\\n\u4F60\u53EF\u4E0D\u80FD\u8F93\u7ED9\u5176\u4ED6\u4EBA\u54E6\uFF5E\uFF01[VAR 0114(0004)]",
  "\u5982\u679C\u4F60\u51C6\u5907\u597D\u4E86\uFF0C\\n\u5C31\u544A\u8BC9\u6211\u4E00\u58F0\u5427\u3002"
]
