  "\u80FD\u63A5\u53D7\u7B2C\u4E8C\u8F6E\u6D4B\u9A8C\u4E0D\u5BB9\u6613\u554A\u3002\\n\u4E0D\u8FC7\u5927\u59D0\u59D0\uFF0C\u6211\u5C31\u8981\u5728\u8FD9\u91CC\u548C\u4F60\u8BF4\u62DC\u62DC\u4E86\uFF01[VAR 0114(0014)]",
  "\u56E0\u4E3A\u6CE2\u7435\u6211\u7684\u5B9D\u53EF\u68A6\\n\u5B83\u4EEC\u90FD\uFF5E\u662F\u786C\u90A6\u90A6\u7684\uFF01[VAR 0114(0014)]",
