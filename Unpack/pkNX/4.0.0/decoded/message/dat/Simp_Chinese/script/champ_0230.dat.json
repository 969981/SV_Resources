  "\u54CE\u5440\uFF5E\u5DEE\u70B9\u5FD8\u4E86\uFF5E\uFF01\\n\u6211\u90FD\u597D\u4E45\u90FD\u6CA1\u53EB\u53D4\u53D4\u4E86\u3002[VAR 0114(0014)]",
  "\u53D4\u53D4\uFF5E\uFF01\u8BE5\u4F60\u6765\u5566\uFF5E\uFF01[VAR 0114(0014)]",
