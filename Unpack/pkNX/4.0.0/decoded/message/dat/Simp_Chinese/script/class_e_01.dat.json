[
  "\u563F\u5440\uFF01\u5BF9\u6218\u5B66\u7684\u8001\u5E08\u662F\u6211\uFF01\\n\u70ED\u8840\u6CB8\u817E\u7684\u51F0\u6A97\uFF01\uFF01[VAR 0114(0024)]",
  "\u4ECA\u5E74\uFF12\uFF15\u5C81\uFF01\\n\u5174\u8DA3\u662F\u7EC3\u808C\u8089\uFF01\\r\\n\u6211\u559C\u6B22\u7684\u5C5E\u6027\u662F\u2026\u2026[VAR 0114(0024)]",
  "\u808C\u8089\u7ED3\u5B9E\u7684\u683C\u6597\u5C5E\u6027\uFF01\uFF01[VAR 0114(0024)]",
  "\u597D\u4E86\uFF0C\u63A5\u4E0B\u6765\u5404\u4F4D\u540C\u5B66\\n\u5C06\u5728\u6211\u7684\u8BFE\u5802\u4E0A\\r\\n\u5B66\u4E60\u5B9D\u53EF\u68A6\u7684\u6218\u6597\uFF01[VAR 0114(0024)]",
  "\u4E3A\u4E86\u4E0D\u8BA9\u4EFB\u4F55\u4EBA\u843D\u540E\uFF0C\\n\u6211\u4F1A\u4ECE\u57FA\u7840\u5F00\u59CB\u6559\u8D77\uFF01\\r\\n\u6240\u4EE5\u7B2C\u4E00\u6B21\u63A5\u89E6\u7684\u4EBA\u4E5F\u53EF\u4EE5\u653E\u5FC3\uFF01[VAR 0114(0024)]",
  "\u5C31\u5F53\u505A\u662F\u4E0A\u4E86\u8258\u53EF\u9760\u7684\u5927\u8239\u2026\u2026\u4E0D\uFF0C\\n\u5C31\u5F53\u662F\u6302\u5728\u94C1\u638C\u529B\u58EB\u7684\u80A9\u8180\u4E0A\uFF0C\\r\\n\u8BA9\u6211\u4EEC\u4E00\u540C\u71C3\u70E7\u6597\u5FD7\u5427\uFF01[VAR 0114(0024)]",
  "\u5B9D\u53EF\u68A6\u7684\u653B\u51FB\u62DB\u5F0F\\n\u6709\u7740\u5F88\u591A\u79CD\u7C7B\u3002\\r\\n\u6BCF\u79CD\u62DB\u5F0F\u90FD\u6709\u5404\u81EA\u4E0D\u540C\u7684\u5730\u65B9\uFF01[VAR 0114(0024)]",
  "\u90A3\u5C31\u662F\u5A01\u529B\u3001\u5C5E\u6027\u2026\u2026\\n\u8FD8\u6709[VAR FF00(0006)]\u5206\u7C7B[VAR FF00(0000)]\uFF01[VAR 0114(0024)]",
  "\u5A01\u529B\u8D8A\u5927\uFF0C\u80FD\u9020\u6210\u7684\u4F24\u5BB3\u4E5F\u5C31\u8D8A\u5927\u3002\\n\u5982\u679C\u521A\u597D\u662F\u514B\u5236\u5BF9\u624B\u7684\u5C5E\u6027\uFF0C\u5C31\u66F4\u5389\u5BB3\u4E86\uFF01\uFF01[VAR 0114(0024)]",
  "\u800C\u653B\u51FB\u62DB\u5F0F\u7684\u5206\u7C7B\\n\u5219\u53EF\u5206\u4E3A\uFF12\u79CD\u3002\\r\\n\u2026\u2026\u8F6C\u5B66\u751F\uFF0C\u4F60\u7B54\u5F97\u51FA\u6765\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5149\u660E\u4E0E\u9ED1\u6697",
  "\u7269\u7406\u4E0E\u7279\u6B8A",
  "\u559C\u6B22\u548C\u8BA8\u538C",
  "\u4E0D\u53EA\u7B54\u9519\uFF0C\u8FD8\u5E26\u70B9\u4EE4\u4EBA\u62C5\u5FC3\u7684\u7126\u9999\uFF01\\n\u4F60\u600E\u4E48\u4E86\uFF0C\u8F6C\u5B66\u751F\uFF01\uFF1F\\r\\n\u662F\u6B63\u5728\u8BB4\u6B4C\u9752\u6625\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5F88\u597D\uFF01\u770B\u6765\u6211\u770B\u597D\u7684\u8F6C\u5B66\u751F\\n\u5DF2\u7ECF\u628A\u57FA\u7840\u638C\u63E1\u5F97\u5F88\u8E0F\u5B9E\u4E86\uFF01[VAR 0114(0024)]",
  "\u4E0D\u53EA\u7B54\u9519\uFF0C\u8FD8\u5E26\u70B9\u9178\u9178\u751C\u751C\u7684\u5473\u9053\uFF01\\n\u4F60\u600E\u4E48\u4E86\uFF0C\u8F6C\u5B66\u751F\uFF01\uFF1F\\r\\n\u662F\u6B63\u5728\u8BB4\u6B4C\u9752\u6625\u5417\uFF01\uFF1F[VAR 0114(0024)]",
  "\u62DB\u5F0F\u5206\u4E3A[VAR FF00(0006)]\u7269\u7406[VAR FF00(0000)]\u4E0E[VAR FF00(0006)]\u7279\u6B8A[VAR FF00(0000)]\\n\u8FD9\uFF12\u79CD\u5206\u7C7B\uFF01[VAR 0114(0024)]",
  "\u5B9D\u53EF\u68A6\u7684[VAR FF00(0006)]\u653B\u51FB[VAR FF00(0000)]\u8D8A\u9AD8\uFF0C\\n\u7528\u7269\u7406\u62DB\u5F0F\u7ED9\u5BF9\u624B\u9020\u6210\u7684\u4F24\u5BB3\u5C31\u8D8A\u5927\uFF01[VAR 0114(0024)]",
  "\u5B9D\u53EF\u68A6\u7684[VAR FF00(0006)]\u7279\u653B[VAR FF00(0000)]\u8D8A\u9AD8\uFF0C\\n\u7528\u7279\u6B8A\u62DB\u5F0F\u7ED9\u5BF9\u624B\u9020\u6210\u7684\u4F24\u5BB3\u5C31\u8D8A\u5927\uFF01[VAR 0114(0024)]",
  "\u53CD\u4E4B\uFF0C\u5728\u5BF9\u624B\u4F7F\u51FA\u62DB\u5F0F\u65F6\uFF0C\\n\u81EA\u5DF1\u7684[VAR FF00(0006)]\u9632\u5FA1[VAR FF00(0000)]\u548C[VAR FF00(0006)]\u7279\u9632[VAR FF00(0000)]\u8D8A\u9AD8\uFF0C\\r\\n\u5C31\u8D8A\u80FD\u51CF\u5C11\u53D7\u5230\u7684\u4F24\u5BB3\uFF01[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u5BF9\u4E8E\u64C5\u957F[VAR FF00(0006)]\u7269\u7406\u62DB\u5F0F[VAR FF00(0000)]\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5C31\u7ED9\u5B83\u63D0\u9AD8[VAR FF00(0006)]\u653B\u51FB[VAR FF00(0000)]\u800C\u4E0D\u662F\u7279\u653B\u2026\u2026\\c\\n\u5BF9\u4E8E\u64C5\u957F[VAR FF00(0006)]\u7279\u6B8A\u62DB\u5F0F[VAR FF00(0000)]\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5C31\u7ED9\u5B83\u63D0\u9AD8[VAR FF00(0006)]\u7279\u653B[VAR FF00(0000)]\u800C\u4E0D\u662F\u653B\u51FB\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u57F9\u80B2\u6210\u6A21\u68F1\u4E24\u53EF\u7684\u80FD\u529B\uFF0C\\n\u5728\u5BF9\u6218\u4E2D\u4F1A\u96BE\u4EE5\u53D1\u6325\u5B9E\u529B\u54E6\uFF01[VAR 0114(0024)]",
  "\u65E0\u8BBA\u662F\u4EBA\u8FD8\u662F\u5B9D\u53EF\u68A6\u90FD\u4E00\u6837\uFF01\\n\u8981\u597D\u597D\u5E2E\u5B83\u53D1\u6325\u957F\u5904\u624D\u662F\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u53EA\u8981\u662F\u6211\u7684\u8BFE\u5802\uFF0C\\n\u5373\u4F7F\u4E0A\u7406\u8BBA\u8BFE\u4E5F\u8981\u5728\u64CD\u573A\u96C6\u5408\u54E6\uFF01\\r\\n\u8FD9\u6837\u624D\u6BD4\u8F83\u8212\u7545\u561B\uFF01[VAR 0114(0024)]",
  "\u90A3\u4E48\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u7CBE\u529B\u5145\u6C9B\u6BCF\u4E00\u5929\uFF01[VAR 0114(0024)]"
]
