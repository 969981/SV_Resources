  "[VAR 0100(0000)]\uFF0C\u4F60\u7B54\u5F97\u592A\u5BF9\u4E86\u3002\\n\u4F60\u5DF2\u7ECF\u8BD5\u8FC7\u4E86\u5417\uFF1F[VAR 0114(0029)]",
  "\u55EF\u55EF\uFF01\u4F60\u5938\u5B83\u53EF\u7231\u7684\u8BDD\uFF0C\\n\u4F60\u4EEC\u90FD\u4F1A\u7B11\u5F97\u5F88\u5F00\u5FC3\u3002\\r\\n\u4F46\u8FD9\u6837\u662F\u4E0D\u53EF\u80FD\u8FDB\u5316\u7684\u3002[VAR 0114(0029)]",
  "\u55EF\u55EF\uFF01\u4F60\u4EEC\u4E00\u8D77\u5403\u82B1\u751F\u9171\u4E09\u660E\u6CBB\u7684\u8BDD\uFF0C\\n\u5C31\u4F1A\u597D\u5403\u5230\u8FDB\u5316\uFF01\\r\\n\u2026\u2026\u600E\u4E48\u53EF\u80FD\u4F1A\u6709\u8FD9\u79CD\u4E8B\uFF01[VAR 0114(0029)]",
  "\u8981\u60F3\u8BA9\u5C0F\u4ED9\u5976\u8FDB\u5316\u6210\u971C\u5976\u4ED9\uFF0C\\n\u5C31\u9700\u8981\u5E26\u7740\u5B83\u540C\u884C\uFF0C\\r\\n\u5E76\u8F6C\u5708\u5708\u3002[VAR 0114(0029)]",
  "\u8FD9\u6837\u4E00\u6765\uFF0C\u9C9C\u5976\u6CB9\u7ECF\u8FC7\u6405\u62CC\uFF0C\\n\u5C31\u4F1A\u53D8\u6210\u677E\u677E\u8F6F\u8F6F\u7684\u971C\u5976\u4ED9\u4E86\u3002[VAR 0114(0029)]",
  "\u5728\u90A3\u4E4B\u524D\uFF0C\\n\u4E0D\u8981\u5FD8\u4E86\u8BA9\u5C0F\u4ED9\u5976\u643A\u5E26\u7CD6\u9970\u3002[VAR 0114(0029)]",
  "\u6839\u636E\u643A\u5E26\u7684\u7CD6\u9970\u548C\u4F60\u8F6C\u5708\u7684\u65B9\u5F0F\uFF0C\\n\u971C\u5976\u4ED9\u7684\u5916\u8868\u4F1A\u6709\u6240\u4E0D\u540C\uFF0C\u8981\u6CE8\u610F\u54E6\u3002[VAR 0114(0029)]",
  "\u543E\u8F88\u4E5F\u662F\u4E3A\u4E86\u8BA9\u81EA\u5DF1\u7684\u971C\u5976\u4ED9\\n\u53D8\u6210\u73B0\u5728\u7684\u5916\u8868\uFF0C\u8C03\u6574\u4E86\u8F6C\u5708\u7684\u65B9\u5F0F\u3002[VAR 0114(0029)]",
  "\u543E\u8F88\u4E4B\u6240\u4EE5\u80FD\u9047\u5230\u971C\u5976\u4ED9\uFF0C\\n\u4E5F\u662F\u56E0\u4E3A\u4F60\u628A\u543E\u8F88\u53EB\u6765\u4E86\u5B66\u56ED\u3002[VAR 0114(0029)]",
  "\u4F60\u53BB\u8FC7\u5404\u79CD\u5730\u65B9\uFF0C\\n\u5E94\u8BE5\u9047\u5230\u8FC7\u5F88\u591A\u4E0D\u9519\u7684\u5B9D\u53EF\u68A6\u5427\u3002[VAR 0114(0029)]",
  "\u6211\u4EEC\u80FD\u5426\u6765\u4EA4\u6362\u5B9D\u53EF\u68A6\uFF0C\\n\u8BA9\u543E\u8F88\u4E86\u89E3\u4E00\u4E0B\u4F60\u8D70\u8FC7\u7684\u8F68\u8FF9\u5462\uFF1F[VAR 0114(0029)]",
  "\u543E\u8F88\u6253\u7B97\u9009\u51FA\u63D0\u5E03\u8389\u59C6\u3002\\n[VAR 0100(0000)]\uFF0C\u4F60\u5462\uFF1F[VAR 0114(0029)]",
