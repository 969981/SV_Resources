  "\u5C31\u7528[VAR 0100(0000)]\u4F60\u7684[VAR 0101(0001)]\u548C\\n\u543E\u8F88\u7684\u63D0\u5E03\u8389\u59C6\u6765\u4EA4\u6362\uFF0C\u786E\u5B9A\u4E86\u5417\uFF1F[VAR 0114(0029)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u2026\u2026\u540C\u884C\u5B9D\u53EF\u68A6\u53EA\u6709\uFF11\u53EA\u7684\u8BDD\uFF0C\\n\u8FD8\u662F\u4E0D\u8981\u4EA4\u6362\u4E86\u5427\u3002\\c\\n\u7B49\u4F60\u5E26\u7740\uFF12\u53EA\u4EE5\u4E0A\u7684\u5B9D\u53EF\u68A6\u4E4B\u540E\\n\u518D\u6765\u8BD5\u8BD5\u5427\uFF0C\u5982\u4F55\uFF1F[VAR 0114(0029)]",
  "\u7B49\u4F60\u60F3\u4EA4\u6362\u7684\u65F6\u5019\u4E5F\u884C\uFF0C\\n\u5230\u65F6\u5C31\u62DC\u6258\u4F60\u5566\u3002[VAR 0114(0029)]",
  "\u4F60\u613F\u610F\u548C\u543E\u8F88\u4EA4\u6362\u5B9D\u53EF\u68A6\u5417\uFF1F[VAR 0114(0029)]",
  "\u51A0\u519B\uFF0C\\n\u4F60\u8981\u548C\u543E\u8F88\u5BF9\u6218\u5417\uFF1F[VAR 0114(0029)]",
  "\u543E\u8F88\u5DF2\u7ECF\u505A\u597D\u4E86\u51C6\u5907\uFF0C\\n\u968F\u65F6\u6B22\u8FCE\u4F60\u6765\u3002[VAR 0114(0029)]",
  "\u90A3\u4E48\u52A1\u5FC5\u8BA9\u6211\u4EEC\u6765\u5BF9\u6218\u5427\u3002\\n\u543E\u8F88\u8981\u597D\u597D\u62FF\u51FA\u5B9E\u529B\u6765\u4E86\u3002[VAR 0114(0029)]",
  "[~ 66]",
  "\u543E\u8F88\u81EA\u8BA4\u5DF2\u7ECF\\n\u8FDB\u884C\u4E86\u5145\u5206\u7684\u953B\u70BC\u2026\u2026[VAR 0114(0029)]",
  "\u51A0\u519B\u786E\u5B9E\u5389\u5BB3\uFF0C\\n\u4F60\u7684\u8FDB\u6B65\u4E4B\u5927\uFF0C\u975E\u540C\u51E1\u54CD\u554A\u3002[VAR 0114(0029)]",
  "\u5BF9\u6218\u4E4B\u540E\uFF0C\u60F3\u5FC5\u4F60\u4E5F\u7D2F\u4E86\u5427\uFF1F\\n\u543E\u8F88\u628A\u8FD9\u4E2A\u7ED9\u4F60\u3002[VAR 0114(0029)]",
  "\u5403\u4E86\u9178\u9178\u7684\u4E1C\u897F\uFF0C\\n\u5C31\u80FD\u6D88\u9664\u75B2\u52B3\u54E6\u3002[VAR 0114(0029)]",
  "[~ 66]",
  "\u65E0\u8BBA\u8FDB\u884C\u591A\u5C11\u6B21\uFF0C\\n\u548C\u4F60\u7684\u5BF9\u6218\u4F9D\u7136\u5F88\u751C\u7F8E\u554A\u3002[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uFF0C\\n\u8C22\u8C22\u4F60\u548C\u543E\u8F88\u5BF9\u6218\u3002[VAR 0114(0029)]",
  "\u8FD9\u53EF\u4E0D\u50CF\u4F60\u554A\u3002\\n\u6216\u8BB8\u662F\u4E0D\u591F\u96C6\u4E2D\u5427\uFF1F\\c\\n\u4F60\u8981\u7167\u987E\u597D\u81EA\u5DF1\u7684\u8EAB\u4F53\uFF0C\\n\u8FD8\u8981\u597D\u597D\u7292\u52B3\u5B9D\u53EF\u68A6\u554A\u3002[VAR 0114(0029)]",
  "\u543E\u8F88\u6709\u4E2A\u5907\u53D7\u597D\u8BC4\u7684\u8BFE\uFF0C\\n\u5185\u5BB9\u662F\u4ECB\u7ECD\u6218\u6597\u540E\u7ED9\u5B9D\u53EF\u68A6\u5403\u7684\u5065\u5EB7\u6599\u7406\u3002\\r\\n\u4E0B\u6B21\u4F60\u4E5F\u6765\u542C\u542C\u5427\uFF1F[VAR 0114(0029)]",
  "\u5728\u751F\u6001\u5DE8\u86CB\\n\u4E5F\u4F1A\u4E0B\u96E8\u554A\u3002\\c\\n\u770B\u6765\u91CE\u9910\u4E2D\u7A81\u7136\u4E0B\u96E8\u8FD9\u79CD\u4E8B\\n\u5728\u5DE8\u86CB\u6CA1\u4EC0\u4E48\u4E0D\u540C\u5440\u3002[VAR 0114(0029)]",
  "\u4F60\u559D\u8FC7\u8FD9\u91CC\u7684\u98DF\u5802\\n\u5356\u7684\u5B66\u56ED\u5976\u6614\u4E86\u5417\uFF1F\\c\\n\u5B83\u751C\u5230\u8BA9\u543E\u8F88\u7684\u820C\u5934\u53D1\u9EBB\uFF0C\\n\u53EA\u8981\u559D\u4E86\u5C31\u4F1A\u4E0D\u7531\u81EA\u4E3B\u5730\u7B11\u5BB9\u6EE1\u9762\u3002[VAR 0114(0029)]",
  "[VAR 0100(0000)]\u4F60\u7684[VAR 0101(0001)]\\n\u8EAB\u4E0A\u7684\u5149\u6CFD\u5F88\u9971\u6EE1\u3002\\c\\n\u4F60\u4E4B\u524D\u662F\u4E0D\u662F\u5F88\u6CE8\u610F\\n\u7ED9\u5B83\u63D0\u4F9B\u8425\u517B\u5747\u8861\u7684\u9910\u98DF\uFF1F[VAR 0114(0029)]",
  "\u543E\u8F88\u4EA4\u6362\u7ED9\u4F60\u7684\\n\u63D0\u5E03\u8389\u59C6\u8FD8\u597D\u5417\uFF1F\\c\\n\u5B83\u7684\u53EF\u7231\u5E94\u8BE5\u662F\u65E0\u51FA\u5176\u53F3\u7684\u3002[VAR 0114(0029)]"
