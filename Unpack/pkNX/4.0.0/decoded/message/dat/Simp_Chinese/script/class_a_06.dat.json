[
  "\u5927\u5BB6\u597D\u5440\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u4EEC\u5F00\u59CB\u4E0A\u8BFE\u5427\uFF5E[VAR 0114(002A)]",
  "\u5BF9\u4E86\uFF0C\u671F\u4E2D\u8003\u8BD5\u90A3\u9053\\n\u5077\u5077\u8BF7\u5927\u5BB6\u586B\u5199\u7684\u610F\u89C1\u8C03\u67E5\u2026\u2026[VAR 0114(002A)]",
  "\u4E0D\u77E5\u600E\u5730\u88AB\u514B\u62C9\u97E6\u5C14\u6821\u957F\u53D1\u73B0\u4E86\uFF0C\\n\u7136\u540E\u6211\u5C31\u6328\u9A82\u4E86\uFF5E[VAR 0114(002A)]",
  "\u6821\u957F\u8BF4\u4ED6\u4E00\u770B\u5230\u6211\u7684\u8138\u8272\uFF0C\\n\u5C31\u77E5\u9053\u6211\u6709\u4E8B\u60C5\u7792\u7740\u4ED6\u3002[VAR 0114(002A)]",
  "\u6211\u7684\u8138\u8272\u771F\u7684\\n\u548C\u5E73\u65F6\u5DEE\u90A3\u4E48\u591A\u5417\u2026\u2026\uFF1F[VAR 0114(002A)]",
  "\u8138\u8272\u2026\u2026\u4F53\u8272\u2026\u2026\\n\u6CA1\u9519\uFF0C\u4ECA\u5929\u6211\u8981\u6559\u7684\u662F\\r\\n\u5173\u4E8E\u5B9D\u53EF\u68A6\u7684\u4F53\u8272\u3002[VAR 0114(002A)]",
  "\u5B9D\u53EF\u68A6\u6709\u4E9B\u79CD\u7C7B\\n\u4F1A\u4F9D\u636E\u6027\u522B\u3001\u4E2A\u4F53\u7684\u4E0D\u540C\uFF0C\\r\\n\u800C\u6709\u4E0D\u540C\u7684\u4F53\u8272\u6216\u82B1\u7EB9\u3002[VAR 0114(002A)]",
  "\u5728\u6781\u4E3A\u7F55\u89C1\u7684\u60C5\u51B5\u4E0B\uFF0C\\n\u5B9D\u53EF\u68A6\u4F1A\u8BDE\u751F\u51FA\u62E5\u6709\u8BB8\u591A\\r\\n\u4E0E\u5176\u4ED6\u4E2A\u4F53\u4E0D\u540C\u8272\u7D20\u7684\u4E2A\u4F53\uFF5E[VAR 0114(002A)]",
  "\u90A3\u5C31\u662F\u88AB\u79F0\u4E3A[VAR FF00(0006)]\u5F02\u8272[VAR FF00(0000)]\u7684\u5B9D\u53EF\u68A6\u3002[VAR 0114(002A)]",
  "\u4E0D\u8FC7\uFF0C\u9047\u89C1\u5B83\u4EEC\\n\u53EF\u662F\u4E00\u4EF6\u975E\u5E38\u7A00\u6709\u7684\u4E8B\u60C5\u3002[VAR 0114(002A)]",
  "\u90A3\u4E48\uFF0C\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u5B58\u5728\u7684\u6982\u7387\u662F\u591A\u5C11\u5462\uFF1F\\r\\n\u6709\u6CA1\u6709\u4EBA\u77E5\u9053\u5440\uFF5E\uFF1F[VAR 0114(002A)]",
  "\uFF14\uFF10\u5206\u4E4B\uFF11",
  "\uFF14\uFF10\uFF10\u5206\u4E4B\uFF11",
  "\uFF14\uFF10\uFF10\uFF10\u5206\u4E4B\uFF11",
  "\u8981\u662F\u6BCF\uFF14\uFF10\u53EA\u91CC\u80FD\u6709\uFF11\u53EA\uFF0C\\n\u6211\u5C31\u8981\u4E3A\u7814\u7A76\u7684\u8FDB\u5C55\u800C\u6B22\u547C\u96C0\u8DC3\u54AF\u3002\\r\\n\u4F46\u5176\u5B9E\u5B83\u4EEC\u66F4\uFF5E\u7A00\u6709\u54E6\u3002[VAR 0114(002A)]",
  "\u54E6\uFF0C\u4F60\u633A\u654F\u9510\u7684\u5462\uFF5E\\n\uFF14\uFF10\uFF10\u53EA\u91CC\u6709\uFF11\u53EA\u4E5F\u5F88\u8D35\u91CD\u4E86\uFF0C\\r\\n\u5176\u5B9E\u5B83\u4EEC\u8FD8\u8981\u66F4\u52A0\u7A00\u6709\u54E6\u3002[VAR 0114(002A)]",
  "\u54C7\uFF01\u56DE\u7B54\u6B63\u786E\uFF01\\n[VAR 0100(0000)]\u4F60\u5C06\u6765\\r\\n\u4E5F\u8BB8\u80FD\u5F53\u4E0A\u5B9D\u53EF\u68A6\u535A\u58EB\u5462\uFF5E[VAR 0114(002A)]",
  "\u6CA1\u60F3\u5230\u5427\uFF01\u51FA\u73B0\u5F02\u8272\u5B9D\u53EF\u68A6\u7684\\n\u6982\u7387\u7ADF\u7136\u662F\uFF14\uFF10\uFF10\uFF10\u5206\u4E4B\uFF11\u5462\uFF01[VAR 0114(002A)]",
  "\u65E0\u8BBA\u662F\u91CE\u751F\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u8FD8\u662F\u4ECE\u86CB\u91CC\u5B75\u51FA\u6765\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u6982\u7387\u90FD\u662F\u4E00\u6837\u7684\u54E6\uFF5E[VAR 0114(002A)]",
  "\u4E0D\u8FC7\uFF0C\u5982\u679C\u662F\u4E24\u53EA\u5728\u4E0D\u540C\u8BED\u8A00\u7684\\n\u5730\u533A\u957F\u5927\u7684\u5B9D\u53EF\u68A6\u4E4B\u95F4\u6709\u4E86\u86CB\u7684\u8BDD\u2026\u2026[VAR 0114(002A)]",
  "\u90A3\u4E48\u4ECE\u8FD9\u9897\u86CB\u5B75\u51FA\u5F02\u8272\u5B9D\u53EF\u68A6\u7684\\n\u6982\u7387\u5C31\u4F1A\u6BD4\u4E00\u822C\u8FD8\u8981\u9AD8\u3002[VAR 0114(002A)]",
  "\u4F46\u81F3\u4ECA\u6211\u4EEC\u8FD8\u65E0\u6CD5\u89E3\u91CA\\n\u8FD9\u5176\u4E2D\u7684\u7406\u7531\uFF5E[VAR 0114(002A)]",
  "\u53E6\u5916\uFF0C\u4E0D\u77E5\u9053\u662F\u771F\u662F\u5047\uFF0C\\n\u636E\u8BF4\u6709\u79CD\u62A4\u7B26\uFF0C\u53EA\u8981\u628A\u5B83\u5E26\u5728\u8EAB\u4E0A\\r\\n\u5C31\u4F1A\u66F4\u5BB9\u6613\u9047\u89C1\u5F02\u8272\u5B9D\u53EF\u68A6\u2026\u2026[VAR 0114(002A)]",
  "\u867D\u7136\u4E0D\u592A\u79D1\u5B66\uFF0C\\n\u4F46\u5982\u679C\u662F\u771F\u7684\u5C31\u6709\u610F\u601D\u4E86\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u554A\uFF0C\u4E0B\u8BFE\u94C3\u54CD\u4E86\u3002[VAR 0114(002A)]",
  "\u4ECA\u5929\u5C31\u4E0A\u5230\u8FD9\u91CC\uFF5E\\n\u4E0B\u8BFE\u54AF\uFF5E[VAR 0114(002A)]"
]
