  "\u5F53\u65F6\u8FD8\u6CA1\u63A5\u89E6\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u6211\u90FD\u628A\u90A3\u79CD\u611F\u89C9\u7ED9\u5FD8\u4E86\uFF5E[VAR 0114(0004)]",
