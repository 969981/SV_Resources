  "\u611F\u89C9\u5F88\u65B0\u9C9C\uFF01",
  "\u6CA1\u9519\u6CA1\u9519\uFF01\u5C31\u662F\u90A3\u611F\u89C9\uFF01[VAR 0114(0004)]",
