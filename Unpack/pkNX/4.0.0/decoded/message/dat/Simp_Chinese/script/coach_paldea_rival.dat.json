  "\u662F[VAR 0101(0001)]\uFF01\u771F\u68D2\uFF01\\n\u6211\u4F1A\u628A\u5B83\u57F9\u80B2\u5F3A\u5927\uFF0C\u8BA9\u5B83\u65E0\u4EBA\u80FD\u654C\uFF01\\r\\n\u8C22\u8C22\u4F60\u548C\u6211\u4EA4\u6362\uFF01[VAR 0114(0004)]",
  "\u90A3\u5C31\u7528[VAR 0100(0000)]\u4F60\u7684[VAR 0101(0001)]\\n\u6765\u4EA4\u6362\u6211\u7684\u80AF\u6CF0\u7F57\u54AF\uFF5E\uFF01[VAR 0114(0004)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u4F60\u53EA\u5E26\u4E86\uFF11\u53EA\u5B9D\u53EF\u68A6\uFF0C\\n\u8FDB\u884C\u4EA4\u6362\u4F1A\u6709\u70B9\u5371\u9669\u54E6\uFF01\\c\\n\u8BA9\u540C\u884C\u7684\u5B9D\u53EF\u68A6\u6709\uFF12\u53EA\u4EE5\u4E0A\\n\u518D\u8FDB\u884C\u4EA4\u6362\uFF0C\u6211\u60F3\u4F1A\u6BD4\u8F83\u597D\uFF01[VAR 0114(0004)]",
  "\u4F60\u6709\u522B\u7684\u4E8B\u8981\u505A\u5417\uFF1F\\n\u90A3\u7B49\u4E0B\u6B21\u518D\u6765\u4EA4\u6362\u5427\uFF01[VAR 0114(0004)]",
  "\u4E4B\u524D\u6211\u4EEC\u6CA1\u80FD\u4EA4\u6362\u5B9D\u53EF\u68A6\uFF0C\\n\u73B0\u5728\u5FEB\u6765\u4EA4\u6362\u5427\uFF5E\uFF01[VAR 0114(0004)]",
  "\u5982\u679C\u4F60\u6709\u65F6\u95F4\uFF0C\\n\u8981\u6765\u8DDF\u6211\u8FDB\u884C\u5B9D\u53EF\u68A6\u5BF9\u6218\u5417\uFF1F[VAR 0114(0004)]",
  "\u4F60\u662F\u6B63\u5728\u8C03\u6574\u540C\u884C\u7684\u961F\u4F0D\u5417\uFF1F\\n\u55EF\u2026\u2026\u771F\u53EF\u60DC\uFF01[VAR 0114(0004)]",
  "\u592A\u597D\u4E86\uFF01\u90A3\u5C31\u6765\u5427\uFF01\\n\u8BA9\u6211\u4EEC\u6765\u4E00\u573A\u5927\u6709\u6536\u83B7\u7684\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "[~ 62]",
  "\u8FD9\u6B21\u662F\u6211\u8F93\u4E86\uFF01\\n\u554A\uFF5E\u592A\u6709\u8DA3\u4E86\uFF01[VAR 0114(0004)]",
  "\u771F\u5E0C\u671B\u957F\u5927\u540E\u4E5F\u80FD\u968F\u65F6\u968F\uFF5E\u5730\\n\u8DDF[VAR 0100(0000)]\u4F60\u5BF9\u6218\u554A\uFF5E[VAR 0114(0004)]",
  "\u80FD\u5706\u68A6\u4E5F\u597D\uFF0C\\n\u53BB\u8FFD\u68A6\u66F4\u597D\uFF01\u8BF4\u5B9A\u4E86\u54E6\uFF01\\r\\n\u4F5C\u4E3A\u7EA6\u5B9A\u7684\u8BC1\u660E\uFF0C\u6536\u4E0B\u8FD9\u4E2A\u5427\uFF01[VAR 0114(0004)]",
  "\u4F7F\u7528\u65F6\u5C31\u5F53\u662F\u6211\u5728\u5E2E\u4F60\u5427\uFF01\\n\u4ECA\u540E\u4E5F\u2026\u2026\u8BF7\u4F60\u591A\u591A\u6307\u6559\uFF01[VAR 0114(0004)]",
  "[~ 62]",
  "\u8FD9\u6B21\u662F\u6211\u8F93\u4E86\uFF01\\n\u8C22\u8C22\u4F60\u548C\u6211\u5BF9\u6218\uFF01[VAR 0114(0004)]",
  "\u4E0B\u6B21\u6211\u4E0D\u4F1A\u8F93\u7684\uFF01\\n\u8981\u518D\u548C\u6211\u5BF9\u6218\u54E6\uFF01[VAR 0114(0004)]",
  "\u592A\u597D\u4E86\uFF5E\uFF01\\n\u8FD9\u6B21\u662F\u6211\u8D62\u4E86\uFF01\\r\\n\u4E0D\u8FC7\uFF0C\u4F60\u6253\u5F97\u5F88\u6F02\u4EAE\u54E6\uFF01[VAR 0114(0004)]",
  "\u84DD\u8393\u5B66\u56ED\u5728\u4E0A\u8BFE\u65F6\\n\u4E0D\u600E\u4E48\u4F7F\u7528\u6559\u5BA4\u554A\uFF01\\c\\n\u5C45\u7136\u4F1A\u5728\u5DE8\u86CB\u4E2D\u4E0A\u8BFE\uFF0C\\n\u7B80\u76F4\u662F\u6587\u5316\u51B2\u51FB\u554A\uFF01[VAR 0114(0004)]",
  "\u867D\u7136\u53D1\u751F\u4E86\u4E0D\u5C11\u4E8B\uFF0C\\n\u4F46\u5728\u5317\u4E0A\u4E61\u771F\u7684\u8FC7\u5F97\u5F88\u5FEB\u4E50\uFF01\\r\\n\u597D\u60F3\u518D\u548C\u5927\u5BB6\u4E00\u8D77\u53BB\u65C5\u884C\u554A\uFF5E\uFF01[VAR 0114(0004)]",
  "\u542C\u8BF4\u84DD\u8393\u5B66\u56ED\\n\u4E5F\u6709\u56DB\u5929\u738B\uFF01\\c\\n\u4ED6\u4EEC\u4F1A\u7528\u4EC0\u4E48\u5B9D\u53EF\u68A6\u5462\uFF01\uFF1F\\n\u55EF\uFF5E\u597D\u5728\u610F\u554A\uFF01[VAR 0114(0004)]",
  "[VAR 0101(0001)]\u5728\u4E0D\u65AD\u6210\u957F\u8715\u53D8\u54E6\uFF01\\n\u8BA9\u4EA4\u6362\u7684\u5B9D\u53EF\u68A6\u76F8\u4E92\u5BF9\u6218\uFF0C\\r\\n\u6216\u8BB8\u4E5F\u4F1A\u5F88\u6709\u8DA3\uFF01[VAR 0114(0004)]",
  "\u6211\u4EA4\u6362\u7ED9\u4F60\u7684\u80AF\u6CF0\u7F57\\n\u5728\u4E4B\u524D\u7684\u5BFB\u5B9D\u4E2D\u5E2E\u4E86\u6211\u4E0D\u5C11\u5FD9\u54E6\uFF01\\c\\n\u5982\u679C[VAR 0100(0000)]\u4F60\u80FD\u597D\u597D\u57F9\u80B2\u5B83\uFF0C\\n\u6211\u4F1A\u975E\u5E38\u975E\u5E38\u5F00\u5FC3\u7684\uFF01[VAR 0114(0004)]"
