  "\u4F60\u662F\u7792\u4E0D\u8FC7\u53BB\u7684\uFF01\\n\u8981\u662F\u4F60\u4E0D\u627F\u8BA4\uFF0C\u6211\u8FD8\u6709\u8BC1\u4EBA\u54E6\uFF5E\uFF01[VAR 0114(0004)]",
  "\u867D\u7136\u6211\u5F88\u60F3\u9A6C\u4E0A\u5C31\u8DDF\\n\u84DD\u8393\u8054\u76DF\u7684\u51A0\u519B\u5BF9\u6218\u2026\u2026[VAR 0114(0004)]",
  "\u4F46\u52B2\u654C\u5728\u5404\u79CD\u5730\u65B9\u5927\u663E\u8EAB\u624B\uFF0C\\n\u8FD9\u4E00\u70B9\u66F4\uFF5E\u8BA9\u6211\u9AD8\u5174\uFF5E\uFF01[VAR 0114(0004)]",
  "\u55EF\uFF5E\u6240\u4EE5\u2026\u2026\\n\u4EE5\u540E\u4E5F\u8BF7\u4F60\u591A\u591A\u6307\u6559\u54E6\uFF01[VAR 0114(0004)]",
  "\u2026\u2026\u611F\u89C9\u8BF4\u7740\u8BF4\u7740\u5C31\u6B63\u7ECF\u8D77\u6765\u4E86\uFF01[VAR 0114(0004)]",
  "\u8BDD\u8BF4\u6211\u4EEC\u867D\u7136\\n\u5BF9\u6218\u8FC7\u5F88\u591A\u6B21\uFF0C\\r\\n\u4F46\u8FD8\u6CA1\u8BD5\u8FC7\u8FDB\u884C\u4EA4\u6362\u5462\uFF01[VAR 0114(0004)]",
  "\u8981\u4E0D\u5C31\u8D81\u8FD9\u4E2A\u673A\u4F1A\\n\u6765\u8FDB\u884C\u5B9D\u53EF\u68A6\u4EA4\u6362\u5427\uFF01\uFF1F[VAR 0114(0004)]",
