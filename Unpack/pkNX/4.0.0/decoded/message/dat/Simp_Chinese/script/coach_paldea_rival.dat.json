  "[VAR 0100(0000)]\uFF01\\n\u8C22\u8C22\u4F60\u628A\u6211\u53EB\u6765\uFF01[VAR 0114(0004)]",
  "\u6211\u53BB\u751F\u6001\u5DE8\u86CB\u901B\u4E86\u4E00\u4E0B\uFF0C\\n\u53D1\u73B0\u90A3\u91CC\u6709\u5F88\u591A\u6CA1\u89C1\u8FC7\u7684\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0004)]",
