  "\u597D\u4E86\uFF0C\u90A3\u5C31\u4E00\u8FB9\u548C\u91CE\u751F\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u5E76\u6355\u6349\u5B83\u4EEC\u2026\u2026[VAR 0114(0004)]",
  "\u4E00\u8FB9\u524D\u5F80\u90A3\u5EA7\u706F\u5854\u5427\uFF01\\n\u4ECE\u4E0A\u9762\u53EF\u4EE5\u770B\u89C1\u6211\u4EEC\u7684\u5B66\u6821\u54E6\uFF01[VAR 0114(0004)]",
