  "\u679C\u7136\u5389\u5BB3\uFF01\u6253\u5012\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\n[VAR 0101(0001)]\u5C31\u4F1A\u6210\u957F\uFF0C\u53D8\u5F97\u66F4\u5F3A\uFF01[VAR 0114(0004)]",
