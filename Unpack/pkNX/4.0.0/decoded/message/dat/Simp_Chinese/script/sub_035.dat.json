[
  "\u4F60\u597D\u5440\uFF0C\u6211\u6765\u544A\u8BC9\u4F60\\n\u5B9D\u53EF\u68A6\u7684\u5C3A\u5BF8\u600E\u4E48\u6837\uFF1F",
  "\u4F60\u60F3\u77E5\u9053\u54EA\u53EA\\n\u5B9D\u53EF\u68A6\u7684\u5C3A\u5BF8\u5462\uFF1F",
  "\u4F60\u7684[VAR 0102(0001)]\uFF0C\\n\u55EF\uFF0C\u6211\u770B\u770B\u2026\u2026",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u771Fbig\u554A\uFF01\uFF01\uFF01\uFF01\\c\\n\u8FD9\u4E48\u5927\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5B9E\u5728\u975E\u5E38\u7F55\u89C1\u54E6\uFF01",
  "\u5B83\u4E00\u5B9A\u662F\u5168\u4E16\u754C\u6700\u5927\u7684\\n[VAR 0101(0001)]\uFF01",
  "\u54CE\u5440\uFF01\u597D\u5927\u7684\u5B9D\u53EF\u68A6\uFF01\\n\u53EF\u4EE5\u6251\u901A\u4E00\u4E0B\u9760\u5728\u5B83\u7684\u80CC\u4E0A\uFF0C\\r\\n\u4EE4\u4EBA\u5341\u5206\u5B89\u5FC3\u54E6\uFF01",
  "\u563B\u563B\uFF01\u5B83\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\\n\u5B9D\u53EF\u68A6\u5927\u5F88\u591A\u5462\uFF01\\r\\n\u8981\u73CD\u60DC\u8FD9\u4E2A\u7279\u70B9\u54E6\uFF01",
  "\u5B83\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\u5B9D\u53EF\u68A6\\n\u7A0D\u5FAE\u5927\u4E00\u70B9\u70B9\u5462\uFF01",
  "\u6807\u51C6\u81F3\u6781\uFF01\\n\u5B83\u5E73\u5747\u6C34\u51C6\u7684\u5C3A\u5BF8\uFF0C\\r\\n\u5145\u6EE1\u4E86\u6B63\u7EDF\u6D3E\u7684\u9B45\u529B\u54E6\u3002",
  "\u5B83\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\u5B9D\u53EF\u68A6\\n\u7A0D\u5FAE\u5C0F\u4E00\u70B9\u70B9\u5462\uFF01",
  "\u563B\u563B\uFF01\u5B83\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\\n\u5B9D\u53EF\u68A6\u5C0F\u5F88\u591A\uFF01\\r\\n\u8981\u73CD\u60DC\u8FD9\u4E2A\u7279\u70B9\u54E6\uFF01",
  "\u54CE\u5440\uFF01\u597D\u5C0F\u7684\u5B9D\u53EF\u68A6\uFF01\\n[VAR 0101(0001)]\u754C\u7684\u5C0F\u5C0F\u5076\u50CF\uFF01\\r\\n\u5B83\u5B9E\u5728\u662F\u592A\u53EF\u7231\u4E86\uFF01",
  "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u771Fsmall\u554A\uFF01\uFF01\uFF01\uFF01\\c\\n\u8FD9\u4E48\u5C0F\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5B9E\u5728\u975E\u5E38\u7F55\u89C1\u54E6\uFF01",
  "\u5B83\u4E00\u5B9A\u662F\u5168\u4E16\u754C\u6700\u5C0F\u7684\\n[VAR 0101(0001)]\uFF01",
  "\u8C22\u8C22\u4F60\u8BA9\u6211\u770B\u5230\\n\u8FD9\u4E48\u5927\u7684\u5B9D\u53EF\u68A6\u3002\\r\\n\u6211\u6765\u7ED9\u5B83\u6234\u4E0A\u8BC1\u7AE0\u54E6\u3002",
  "\u8C22\u8C22\u4F60\u8BA9\u6211\u770B\u5230\\n\u8FD9\u4E48\u5C0F\u7684\u5B9D\u53EF\u68A6\u3002\\r\\n\u6211\u6765\u7ED9\u5B83\u6234\u4E0A\u8BC1\u7AE0\u54E6\u3002",
  "[VAR 0102(0001)]\u83B7\u5F97\u4E86\\n\u5927\u4E2A\u5B50\u4E4B\u8BC1\uFF01",
  "[VAR 0102(0001)]\u83B7\u5F97\u4E86\\n\u5C0F\u4E0D\u70B9\u4E4B\u8BC1\uFF01",
  "\u4F60\u8981\u662F\u60F3\u77E5\u9053\u5B9D\u53EF\u68A6\u7684\u5C3A\u5BF8\uFF0C\\n\u968F\u65F6\u6765\u627E\u6211\u54E6\uFF01",
  "\u4F60\u77E5\u9053\u5417\uFF1F\u5C31\u7B97\u662F\u76F8\u540C\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u4E5F\u662F\u6709\u7684\u5B69\u5B50\u6BD4\u8F83\u5927\uFF0C\u6709\u7684\u6BD4\u8F83\u5C0F\u54E6\u3002\\c\\n\u53EA\u8981\u6BD4\u8F83\u4E00\u4E0B\u6211\u7684\u5E15\u5947\u5229\u5179\u4EEC\uFF0C\\n\u5C31\u4E00\u76EE\u4E86\u7136\u4E86\uFF01\\c\\n\u6211\u5440\uFF0C\u53EA\u901A\u8FC7\u770B\u5C31\u80FD\u975E\uFF5E\u5E38\u7CBE\u786E\u5730\\n\u77E5\u9053\u5B9D\u53EF\u68A6\u7684\u5927\u5C0F\u54E6\uFF01",
  "[~ 21]"
