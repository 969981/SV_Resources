[
  "[~ 40]",
  "[VAR 0100(0000)]\uFF0C\\n\u6B22\u8FCE\u6765\u5230\u51B0\u67DC\u9053\u9986\u3002",
  "\u6DF1\u60C5\u7075\u9B42\u9976\u820C\u4E50\u83B1\u59C6\u2026\u2026\\n\u8981\u6311\u6218\u8FD9\u4E2A\u9053\u9986\u9986\u4E3B\u5417\uFF1F",
  "\u90A3\u597D\uFF0C\u6211\u5E26\u4F60\u53BB\u5BF9\u6218\u573A\u5427\u3002",
  "\u7B49\u4F60\u51C6\u5907\u597D\u4E86\uFF0C\\n\u968F\u65F6\u90FD\u53EF\u4EE5\u544A\u8BC9\u6211\u3002",
  "\u81F3\u5C11\u9700\u8981\u6709\uFF12\u53EA\u80FD\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\\n\u624D\u80FD\u6311\u6218\u83B1\u59C6\uFF01",
  "YO\u3001YO\u2026\u2026\uFF01",
  "\u2026\u2026\u4ECE\u5BF9\u6218\u573A\u4E0A\u4F20\u6765\u4E86\\n\u8282\u594F\u611F\u5F88\u5F3A\u7684\u8BF4\u8BDD\u58F0\uFF01",
  "\u8BF4\u5531\u5BF9\u6218\u54B1\u6BD4\u4E00\u6BD4\uFF01\u6211\u4ECA\u5929\u5C31\u662F\u8981\u6253\u8D62\u4F60\u266A\\nYO\u670B\u53CB\uFF01\u4E0E\u5176\u88AB\u6211\u6446\u5E73\uFF01\u4E0D\u5982\u81EA\u5DF1\u8EBA\u5E73\u266A",
  "\u7AD6\u8D77\u8033\u6735\u542C\u6211\u8BF4\u5531\u9053\u9986\u9986\u4E3B\u266A\\n\u6211\u662F\u5E97\u91CC\u6253\u5DE5\u5E2E\u7684\u5E26\u5934\u5E2E\u4E3B\u266A",
  "\u549A\u549A\u9535\u2026\u2026\\n\u549A\u549A\u9535\u2026\u2026",
  "\u597D\u4E2A\u5E97\u91CC\u6253\u5DE5\u7684\u5E26\u5934\u5E2E\u4E3B\u266A\\n\u8DDF\u83B1\u59C6\u6BD4\u4E5F\u5C31\u662F\u521D\u51FA\u8305\u5E90\u266A\\r\\n\u4F60\u806A\u660E\u7684\u8BDD\u8D76\u7D27\u6253\u9053\u56DE\u5E9C\u266A[VAR 0114(001B)]",
  "\u6211\u7684\u540D\u5B57\u662F\u83B1\u59C6\u266A\u5BF9\u8C01\u90FD\u4F1A\u5F88\u7C97\u9C81\u266A\\n\u4EBA\u89C1\u4EBA\u558A\u4E0D\u4E0D\u4E0D\u266A\u5C31\u50CF\u89C1\u4E86\u70B8\u836F\u5E93\u266A[VAR 0114(001B)]",
  "\u76AE\u6BDB\u7684\u529F\u592B\u522B\u6765\u79C0\u266A\\n\u8BF4\u5531\u54EA\u80FD\u4E00\u8E74\u800C\u5C31\u266AHEY\uFF01[VAR 0114(001B)]",
  "\u549A\u549A\u9535\u2026\u2026\\n\u549A\u549A\u9535\u2026\u2026",
  "\u5B8C\u8D25\uFF0C\u60E8\u8D25\uFF0C\u4F60\u9001\u4E86\u6211\u573A\u6E83\u8D25\uFF01\\n\u4E0B\u6B21\u4E00\u5B9A\u633D\u56DE\u989C\u9762\uFF0C\u96EA\u803B\u5C31\u5728\u4E0B\u5348\uFF13\u70B9\uFF5E\uFF01",
  "\u7B49\u7B49\uFF01\u63A5\u7740\u6765\u554A\uFF01\\c\\n\u554A\u2026\u2026\u8BF4\u5565\uFF1F\u4E0B\u5348\uFF13\u70B9\uFF1F\\n\u4F60\u8FD9\u80A1\u6FC0\u60C5\u4E5F\u592A\u653E\u98DE\u81EA\u6211\u4E86\u5427\uFF01[VAR 0114(001B)]",
  "\u65E9\u65E9\u653E\u5F03\uFF0C\u5B9A\u662F\u78B0\u58C1\uFF01\\n\u8C01\u6709\u9AA8\u6C14\uFF0C\u5FEB\u6765\u627EME\uFF01ME\uFF5EN\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u55EF\uFF1F[VAR 0114(001B)]",
  "\u4E0B\u4E00\u4E2A\u5BF9\u624B\u662F\u505A\u4E86\u5F00\u573A\u8868\u6F14\u7684\u4F60\uFF1F\\n\u9053\u9986\u5BF9\u6218\uFF1F\u8FD8\u662F\u8BF4\u5531\u5BF9\u6218\uFF1F\u8981\u6BD4\u54EA\u4E2A\uFF1F[VAR 0114(001B)]",
  "\u9053\u9986\u5BF9\u6218\uFF01",
  "\u8BF4\u5531\u5BF9\u6218\uFF01",
  "\u4E0D\u53EF\u80FD\u662F\u8BF4\u5531\uFF01\\n\u4E00\u70B9\u90FD\u6CA1\u9519\uFF01HAHAHA\uFF01[VAR 0114(001B)]",
  "HAHA\uFF01\u4F60\u7684\u56DE\u7B54\u771F\u662F\u641E\u7B11\uFF01\\n\u9017\u5F97\u8BA9\u6211\u7761\u4E0D\u597D\u89C9\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u55EF\uFF1F\u4F60\u8BF4\u6211\u7684\u8BF4\u8BDD\u65B9\u5F0F\\n\u542C\u8D77\u6765\u5F88\u5947\u5999\u5417\uFF1F[VAR 0114(001B)]",
  "\u8FD9\u662F\u8BF4\u5531\uFF01\\c\\n\u662F\u4EE5\u4E0D\u65AD\u62BC\u97F5\u7684\u53E5\u5B50\\n\u8C31\u5199\u800C\u6210\u7684\u7075\u9B42\u4E4B\u6B4C\uFF01[VAR 0114(001B)]",
  "\u52FE\u9B42\u773C\uFF0C\u8DDF\u968F\u4FFA\uFF0C\u521A\u4E00\u51FA\u53D1\u5C31\u6253\u95EA\u266A\\n\u5F88\u4E60\u60EF\uFF0C\u4E0D\u7A00\u7F55\uFF0C\u7136\u540E\u6210\u4E86\u5BB6\u5E38\u996D\u266A\\r\\n\u2026\u2026\u5C31\u662F\u8FD9\u79CD\u611F\u89C9\uFF01\u7406\u89E3\u4E86\u5417\uFF1F[VAR 0114(001B)]",
  "\u54CE\uFF0C\u4F60\u662F\u4E2A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF01\\n\u5728\u5BF9\u6218\u4E2D\u5C55\u73B0\u51FA\u4F60\u90A3\u9897\u4EA2\u594B\u7684\u5FC3\u5427\uFF01[VAR 0114(001B)]",
  "\u867D\u7136\u6211\u4E5F\u662F\u628A\u8BF4\u5531\u5F53\u6210\u6B63\u4E1A\uFF0C\\n\u4F46\u5982\u679C\u8BA9\u6211\u7528\u5E7D\u7075\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u8BDD\uFF0C\\r\\n\u57FA\u672C\u6CA1\u4EBA\u80FD\u6BD4\u5F97\u4E0A\u6211\u54E6\u3002[VAR 0114(001B)]",
  "\u6211\u662F\u83B1\u59C6\uFF01\\n\uFF41\uFF0E\uFF4B\uFF0E\uFF41\u6DF1\u60C5\u7075\u9B42\u9976\u820C\u4E50\uFF01[VAR 0114(001B)]",
  "\u52BF\u5982\u5F3A\u5F29\uFF01\\n\u7075\u4E0E\u547D\uFF01\u5BF9\u6218\u573A\u4E0A\u628A\u4F60\u8650\uFF01\uFF01[VAR 0114(001B)]",
  "HAHAHA\uFF01\u597D\u554A\uFF5E\uFF01\\n\u6211\u6DF1\u6DF1\u5730\u611F\u53D7\u5230\u4E86\u4F60\u7684\u7075\u9B42\uFF01[VAR 0114(001B)]",
  "\u80FD\u8BA9\u6211\u53EB\u51FA\u58F0\u6765\uFF0C\u8BF4\u660E\u4F60\u5F88\u6709\u9AA8\u6C14\uFF01\\n\u54FC\uFF01\u9053\u9986\u5FBD\u7AE0\u62FF\u53BB\u5427\uFF01[VAR 0114(001B)]",
  "\u987A\u4FBF\u4E5F\u7ED9\u4F60\u4E2A\u80FD\u5728\u5934\u7B49\u5E2D\\n\u542C\u6211\u6F14\u51FA\u7684\u6743\u5229\u600E\u4E48\u6837\uFF1F[VAR 0114(001B)]",
  "\u6709[VAR 0200(0001)]\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u7B49\u7EA7[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4F1A\u66F4\u5BB9\u6613\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u5B83\u4EEC\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\u54E6\uFF01[VAR 0114(001B)]",
  "\u6709\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u4E0D\u7BA1\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u5B83\u4EEC\u90FD\u4F1A\u8001\u8001\u5B9E\u5B9E\u5730\u542C\u4F60\u7684\u8BDD\u54E6\uFF01[VAR 0114(001B)]",
  "\u8BF4\u5531\u8BA9\u6211\u5F88\u5174\u594B\uFF0C\u5FC3\u60C5\u597D\u5F97\u5F88\uFF01\\n\u518D\u9001\u4F60\u4E00\u4E2A\u793C\u7269\u5427\uFF01[VAR 0114(001B)]",
  "\u6211\u8FD8\u6CA1\u8BA9\u4F60\u542C\u591F\u5462\uFF01\\n\u7B49\u4F60\u529E\u5B8C\u4E8B\u540E\u8981\u518D\u6765\u554A\uFF01\\r\\n\u4E0B\u6B21\u6211\u4EEC\u6765\u573A\u8BF4\u5531\u5BF9\u6218\u4E5F\u6210\u54E6\uFF01[VAR 0114(001B)]",
  "\u6211\u4F1A\u4E3A\u4F60\u7CBE\u5F69\u7684\u5192\u9669\u52A0\u6CB9\u7684\uFF01\\n\u62DC\u62DC\uFF01\u5B9D\u8D1D\uFF01[VAR 0114(001B)]",
  "\u606D\u559C\uFF01\\n\u4F60\u7A81\u7834\u4E86\u51B0\u67DC\u9053\u9986\uFF01"
]
