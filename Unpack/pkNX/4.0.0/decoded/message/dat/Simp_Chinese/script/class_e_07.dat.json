[
  "\u6700\u540E\u4E00\u5802\u8BFE\u4E5F\u8981\u7CBE\u529B\u5145\u6C9B\uFF01\\n\u563F\u5440\uFF01\u8BA9\u6211\u4EEC\u8E0F\u8E0F\u5B9E\u5B9E\u5730\u753B\u4E0B\u53E5\u53F7\u5427\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u540C\u5B66\u7684\u77E5\u8BC6\\n\u5DF2\u7ECF\u975E\u5E38\u5F3A\u5927\u4E86\uFF01[VAR 0114(0024)]",
  "\u6211\u51E0\u4E4E\u5DF2\u7ECF\u6CA1\u6709\\n\u53EF\u4EE5\u6559\u4F60\u4EEC\u7684\u4E8B\u60C5\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4F46\u4E3A\u4E86\u8FFD\u6C42\u66F4\u9AD8\u7684\u5883\u754C\uFF01[VAR 0114(0024)]",
  "\u4ECA\u5929\u5C31\u8BF7\u540C\u5B66\u4EEC\\n\u8BB0\u4F4F\u8FDE\u63A5\u5BF9\u6218\u7684\u89C4\u5219\u5427\uFF01[VAR 0114(0024)]",
  "\u8FDE\u63A5\u5BF9\u6218\u65F6\uFF0C\u5982\u679C\u662F\uFF12\u4E2A\u4EBA\\n\u5C31\u53EF\u4EE5\u8FDB\u884C\u5355\u6253\u5BF9\u6218\u6216\u53CC\u6253\u5BF9\u6218\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u805A\u96C6\u4E86\uFF14\u4E2A\u670B\u53CB\uFF0C\\n\u5C31\u53EF\u4EE5\u8FDB\u884C\u591A\u4EBA\u5BF9\u6218\u54E6\uFF01[VAR 0114(0024)]",
  "\u5728\u8BFE\u5916\u6D3B\u52A8\u4E2D\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u6D3E\u4E0A\u573A\u7684\u5B9D\u53EF\u68A6\u7684\u6570\u91CF\u6216\u5B9E\u529B\\r\\n\u90FD\u53EF\u4EE5\u81EA\u7531\u5B89\u6392\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0024)]",
  "\u4F46\u662F\u8FDE\u63A5\u5BF9\u6218\\n\u5C31\u5B58\u5728\u7740\u51E0\u9879\u89C4\u5219\uFF01[VAR 0114(0024)]",
  "\u9996\u5148\u662F\u7B49\u7EA7\u8C03\u6574\uFF01[VAR 0114(0024)]",
  "\u6BD4\u5982\u5728[VAR FF00(0006)]\u65E0\u9650\u5236[VAR FF00(0000)]\u7684\u89C4\u5219\u4E2D\uFF0C\\n\u5B9D\u53EF\u68A6\u7684\u7B49\u7EA7\u4F1A\u7EF4\u6301\u73B0\u72B6\uFF01\\r\\n\u540C\u884C\u4E2D\u6709\u591A\u53EA\u76F8\u540C\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u6216\u662F\u643A\u5E26\u7740\u76F8\u540C\u6301\u6709\u7269\uFF0C\u5168\u90FD\uFF2F\uFF2B\uFF01[VAR 0114(0024)]",
  "\u800C[VAR FF00(0006)]\u666E\u901A\u89C4\u5219[VAR FF00(0000)]\uFF0C\\n\u5219\u662F\u65E0\u8BBA\u591A\u5F3A\u7684\u5B9D\u53EF\u68A6\\r\\n\u90FD\u4F1A\u88AB\u8C03\u6574\u4E3A\u7B49\u7EA7\uFF15\uFF10\u7EA7\u6765\u53D1\u6325\u529B\u91CF\uFF01[VAR 0114(0024)]",
  "\u5373\u4F7F\u662F\u7B49\u7EA7\u4E0D\u9AD8\u7684\u5B9D\u53EF\u68A6\\n\u4E5F\u80FD\u53D1\u6325\u6210\u957F\u4E4B\u540E\u7684\u529B\u91CF\uFF01[VAR 0114(0024)]",
  "\u5728\u8FD9\u4E2A\u89C4\u5219\u91CC\uFF0C\u4F7F\u7528\u76F8\u540C\u7684\u5B9D\u53EF\u68A6\u6216\u662F\\n\u8BA9\u5B83\u4EEC\u643A\u5E26\u76F8\u540C\u7684\u6301\u6709\u7269\uFF0C\u4E5F\u662F\uFF2F\uFF2B\u7684\uFF01[VAR 0114(0024)]",
  "\u53EA\u8981\u5B66\u4F1A\u4E86\u62DB\u5F0F\uFF0C\u5C31\u7B97\u4E0D\u63D0\u5347\u7B49\u7EA7\uFF0C\\n\u4E5F\u80FD\u8BA9\u5B9D\u53EF\u68A6\u5927\u5C55\u8EAB\u624B\u3002\\r\\n\u8FD9\u5C31\u662F\u666E\u901A\u89C4\u5219\u7684\u4F18\u70B9\uFF01[VAR 0114(0024)]",
  "\u6700\u540E\u662F[VAR FF00(0006)]\u53D7\u9650\u89C4\u5219[VAR FF00(0000)]\u3002\u5728\u8FD9\u4E2A\u89C4\u5219\u4E2D\uFF0C\\n\u7B49\u7EA7\uFF15\uFF10\u4EE5\u4E0A\u7684\u5B9D\u53EF\u68A6\\r\\n\u4F1A\u88AB\u7EDF\u4E00\u8C03\u6574\u4E3A\u7B49\u7EA7\uFF15\uFF10\uFF01[VAR 0114(0024)]",
  "\u53D7\u9650\u89C4\u5219\u662F\\n\u6700\u5177\u6218\u672F\u6027\u7684\u89C4\u5219\uFF01[VAR 0114(0024)]",
  "\u8FD9\u4E2A\u89C4\u5219\u4F1A\u7981\u6B62\\n\u4F7F\u7528\u591A\u53EA\u76F8\u540C\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD8\u7981\u6B62\u8BA9\u5B9D\u53EF\u68A6\u643A\u5E26\u76F8\u540C\u7684\u9053\u5177\uFF01[VAR 0114(0024)]",
  "\u73B0\u5728\u6211\u8981\u63D0\u95EE\u4E86\uFF01[VAR 0114(0024)]",
  "\u523B\u610F\u60F3\u7528\u7B49\u7EA7\u8F83\u4F4E\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u65F6\uFF0C\\n\u5728\u666E\u901A\u89C4\u5219\u4E0E\u53D7\u9650\u89C4\u5219\u4E4B\u95F4\u2026\u2026\\r\\n\u5E94\u8BE5\u9009\u62E9\u54EA\u79CD\u89C4\u5219\u6BD4\u8F83\u597D\u5462\uFF1F[VAR 0114(0024)]",
  "\u666E\u901A\u89C4\u5219",
  "\u53D7\u9650\u89C4\u5219",
  "\u53EF\u60DC\uFF01\u5728\u666E\u901A\u89C4\u5219\u4E2D\uFF0C\\n\u5C31\u7B97\u5B9D\u53EF\u68A6\u7684\u7B49\u7EA7\u4E0D\u9AD8\uFF0C\\r\\n\u4E5F\u4F1A\u88AB\u7EDF\u4E00\u8C03\u6574\u4E3A\u7B49\u7EA7\uFF15\uFF10\u5462\uFF01[VAR 0114(0024)]",
  "\u4E0D\u6127\u662F\u8F6C\u5B66\u751F\uFF01\\n\u4F60\u6709\u5728\u8BA4\u771F\u542C\u8BB2\u5462\uFF01[VAR 0114(0024)]",
  "\u51FA\u4E8E\u6218\u672F\u8003\u91CF\uFF0C\\n\u7279\u610F\u8981\u8BA9\u7B49\u7EA7\uFF15\u7684\u5B9D\u53EF\u68A6\u4E0A\u573A\u65F6\uFF0C\\r\\n\u6700\u597D\u7684\u9009\u62E9\u5C31\u662F\u7528\u53D7\u9650\u89C4\u5219\u53BB\u5BF9\u6218\uFF01[VAR 0114(0024)]",
  "\u5F53\u7136\uFF0C\u4EE5\u65E0\u9650\u5236\u89C4\u5219\u5BF9\u6218\u65F6\uFF0C\\n\u53EF\u4EE5\u968F\u5FC3\u6240\u6B32\u5730\u7EC4\u5408\\r\\n\u5B9D\u53EF\u68A6\u3001\u7B49\u7EA7\u548C\u6301\u6709\u7269\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u8981\u548C\u670B\u53CB\u81EA\u7531\u5730\u5BF9\u6218\uFF0C\\n\u8FD9\u4E2A\u89C4\u5219\u5C31\u518D\u9002\u5408\u4E0D\u8FC7\u4E86\uFF01[VAR 0114(0024)]",
  "\u7ED3\u8BBA\uFF01\uFF01[VAR 0114(0024)]",
  "\u7B49\u7EA7\u4E00\u5F8B\uFF15\uFF10\u7684\u662F\u666E\u901A\u89C4\u5219\uFF0C\\n\u7B49\u7EA7\u4E0D\u9AD8\u4E5F\uFF2F\uFF2B\u7684\u662F\u53D7\u9650\u89C4\u5219\uFF01[VAR 0114(0024)]",
  "\u4E0E\u670B\u53CB\u4E00\u8D77\u706B\u70ED\u5730\u5BF9\u6218\uFF0C\\n\u8BA9\u5185\u5FC3\u96C0\u8DC3\u4E0D\u5DF2\u5427\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u672C\u6765\u60F3\u8BA9\u5404\u4F4D\u4EB2\u8EAB\u4F53\u9A8C\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u65F6\u95F4\u5DF2\u7ECF\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4E0B\u5802\u8BFE\u662F\u671F\u672B\u8003\u8BD5\u54DF\uFF01\\n\u8981\u4E89\u53D6\u62FF\uFF11\uFF10\uFF10\u5206\uFF01\u563F\u5440\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]"
]
