  "\u2026\u2026\u867D\u8BF4\u5076\u5C14\u88AB\u5EB6\u6C11\\n\u540A\u540A\u80C3\u53E3\u4E5F\u4E0D\u9519\u2026\u2026\\c\\n\u4F46\u540D\u6D41\u7684\u65F6\u95F4\u662F\u5B9D\u8D35\u7684\uFF01\\n\u73B0\u5728\u7ACB\u523B\u5C31\u6765\u5F00\u6253\u54AF\uFF5E\uFF5E\uFF5E\uFF01\uFF01[VAR 0114(0041)]",
  "\u5E15\u5E95\u4E9A\u4E0D\u52A8\u4EA7\u7684\u793E\u957F\u99A5\u597D\uFF01\\n\u8981\u6765\u78BE\u538B\u5EB6\u6C11\u54AF\uFF5E\uFF5E\uFF5E\uFF01\uFF01[VAR 0114(0041)]",
