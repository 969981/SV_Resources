[
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01[VAR 0114(002C)]",
