  "\u600E\u3001\u600E\u4E48\u529E\u5440\uFF0C\u6BC5\u4E07\uFF01\u5982\u679C\u6211\\n\u8BF7\u6C42\u548C\u90A3\u4EBA\u63E1\u624B\uFF0C\u4F1A\u6709\u5931\u793C\u6570\u5417\uFF01\uFF1F\\r\\n\u6211\u53EF\u4EE5\u8981\u4E2A\u7B7E\u540D\u5417\uFF01\uFF1F[VAR 0114(0041)]",
  "\u51B7\u9759\u4E00\u70B9\uFF0C\u99A5\u597D\uFF01\\n\u5EB6\u6C11\u662F\u4E0D\u4F1A\u9003\u8D70\u7684\u5440\uFF01[VAR 0114(0040)]",
