  "\u99A5\u597D\uFF01\\n\u4ECA\u5929\u6211\u4EEC\u8981\u5982\u4F55\\r\\n\u6765\u6D6A\u8D39\u65F6\u95F4\u548C\u91D1\u94B1\u5440\uFF01\uFF1F[VAR 0114(0040)]",
