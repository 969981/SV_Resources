  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\\n\u6211\u60F3\u73B0\u5728\u7ACB\u523B\u53BB\u770B\\r\\n\u5E15\u5E95\u4E9A\u7684[VAR FF00(0006)]\u90A3\u4E2A\u7011\u5E03[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\u624D\u521A\u521A\u6765\u5230\u5317\u4E0A\uFF0C\\n\u5C31\u5DF2\u7ECF\u8981\u56DE\u53BB\u4E86\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5440\uFF01[VAR 0114(0040)]",
  "\u5509\uFF0C\u99A5\u597D\u5C0F\u59D0\uFF0C\u6BC5\u4E07\u5148\u751F\u3002\\n\u4F60\u4EEC\u4E8C\u4F4D\u5230\u54EA\u91CC\u53BB\u4E86\u5462\uFF1F",
  "\u201C\u6211\u8981\u53BB\u53EF\u4EE5\u77AD\u671B\\n\u4F18\u7F8E\u7530\u56ED\u98CE\u5149\u7684\u5730\u65B9\uFF01\u201D\\c\\n\u2026\u2026\u5C0F\u59D0\u867D\u7136\u662F\u8FD9\u6837\u8BF4\u7684\uFF0C\\n\u4F46\u90A3\u7A76\u7ADF\u662F\u5728\u4F55\u5904\uFF1F"
