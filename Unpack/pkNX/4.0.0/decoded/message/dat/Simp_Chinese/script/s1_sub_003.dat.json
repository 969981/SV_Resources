  "\u5982\u679C\u60F3\u8981\u83B7\u5F97\u4E0D\u83F2\u7684\u8D22\u5BCC\uFF0C\\n\u5C31\u50CF\u5EB6\u6C11\u4E00\u6837\u5411\u99A5\u597D\u642D\u8BDD\u5427\uFF01[VAR 0114(0040)]",
