[
  "\u518D\u548C[VAR 0100(0000)]\u4F60\u8BF4\u660E\u4E00\u6B21\uFF01\\n\u53EA\u8981\u653B\u7834\u5404\u79CD\u9053\u9986\uFF0C\\r\\n\u4E0D\u65AD\u6536\u96C6\u5FBD\u7AE0\u7684\u8BDD\u2026\u2026[VAR 0114(0004)]",
  "\u5C31\u80FD\u6311\u6218\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\u6700\u9AD8\u6BBF\u5802\uFF01[VAR 0114(0004)]",
  "\u55EF\uFF0C\u8BF4\u7684\u662F\u5B9D\u53EF\u68A6\u8054\u76DF\u5427\u3002[VAR 0114(0011)]",
  "\u4F4D\u4E8E\u684C\u53F0\u5E02\u7684\u897F\u5317\u8FB9\u3002[VAR 0114(0011)]",
  "\u5B9D\u53EF\u68A6\u8054\u76DF\u2026\u2026\u662F\u62E5\u6709\u6700\u5F3A\u79F0\u53F7\\n\u51A0\u519B\u7EA7\u7684\u8BAD\u7EC3\u5BB6\u2026\u2026\\r\\n\u8BDE\u751F\u7684\u5730\u65B9\u2026\u2026[VAR 0114(0011)]",
  "\u5982\u679C\u80FD\u6536\u96C6\u5230\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\uFF0C\\n\u5C31\u80FD\u63A5\u53D7\u6D4B\u9A8C\u2026\u2026[VAR 0114(0004)]",
  "\u53EA\u8981\u80FD\u6253\u8D62\u6700\u5F3A\u7684\u8003\u5B98\uFF0C\\n\u5C31\u80FD\u6210\u4E3A\u51A0\u519B\u5462\uFF01[VAR 0114(0004)]",
  "\u60F3\u8C61\u4E00\u4E0B\u5230\u65F6\u662F\u4EC0\u4E48\u5FC3\u60C5\uFF0C\\n\u4ECE\u73B0\u5728\u8D77\u5F00\u59CB\u8868\u8C61\u8BAD\u7EC3\u5427\uFF01[VAR 0114(0004)]",
  "\u4EE5\u6700\u9AD8\u7684\u821E\u53F0\u4E3A\u76EE\u6807\uFF0C\\n\u6765\u4E00\u573A\u5BF9\u6218\u2026\u2026[VAR 0114(0004)]",
  "\u54E6\uFF1F\u8BF7\u7B49\u4E00\u4E0B\u3002[VAR 0114(0011)]",
  "[VAR 0100(0000)]\u7684\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u6709\u70B9\u7D2F\u4E86\u5462\u3002[VAR 0114(0011)]",
  "\u62B1\u6B49\uFF5E\uFF01\u6211\u5149\u60F3\u5FEB\u70B9\u5BF9\u6218\uFF0C\\n\u90FD\u6CA1\u987E\u4E0A\u8FD9\u4E8B\u513F\u2026\u2026[VAR 0114(0004)]",
  "\u591A\u4E8F\u4E86\u9996\u5E2D\uFF0C\\n\u4F60\u73B0\u5728\u90FD\u51C6\u5907\u597D\u4E86\u5427\uFF01[VAR 0114(0004)]",
  "\u91CD\u65B0\u6253\u8D77\u7CBE\u795E\u6765\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0004)]",
  "\u8FD9\u6B21\u4E5F\u8BA9\u6211\u4EEC\u6765\u4E00\u573A\\n\u5927\u6709\u6536\u83B7\u7684\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]",
  "\u5373\u4F7F\u9762\u5BF9\u51A0\u519B\u59AE\u83AB\uFF0C\\n\u4F60\u4E5F\u80FD\u6709\u5982\u6B64\u7684\u8868\u73B0\u2026\u2026[VAR 0114(0011)]",
  "\u6211\u6B23\u8D4F\u5230\u4E86\u4E00\u573A\\n\u7CBE\u5F69\u7684\u8F83\u91CF\u3002[VAR 0114(0011)]",
  "\u8FDE\u9996\u5E2D\u90FD\u8BA4\u540C\u4F60\u7684\u6F5C\u529B\uFF0C\\n\u771F\u662F\u592A\u5389\u5BB3\u4E86\uFF01[VAR 0114(0004)]",
  "\u770B\u6765\u6211\u4E5F\u6CA1\u6709\\n\u5077\u61D2\u7684\u529F\u592B\u554A\uFF01[VAR 0114(0004)]",
  "\u5728\u9996\u5E2D\u7684\u9762\u524D\uFF0C\\n\u4F60\u6709\u70B9\u7D27\u5F20\u4E86\u5417\uFF1F[VAR 0114(0004)]",
  "\u867D\u7136\u5BF9\u6218\u662F\u6211\u8D62\u4E86\uFF0C\u4F46\u6211\u5374\u611F\u53D7\u5230\u4E86\\n\u4F60\u548C\u5B9D\u53EF\u68A6\u7684\u6DF1\u539A\u7275\u7ECA\u3002[VAR 0114(0004)]",
  "\u4ECE\u7B2C\u4E00\u6B21\u9047\u5230\u4F60\u7684\u65F6\u5019\u5F00\u59CB\uFF0C\\n\u6211\u5C31\u9690\u7EA6\u611F\u89C9\u5230\u4E86\u8FD9\u4E00\u70B9\u2026\u2026[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF0C\u5982\u679C\u662F\u4F60\u7684\u8BDD\uFF0C\\n\u4E00\u5B9A\u4F1A\u6210\u4E3A\u51A0\u519B\u7EA7\u7684\u3002[VAR 0114(0004)]",
  "\u5269\u4E0B\u7684\u9053\u9986\u4F60\u4E5F\u4E00\u5B9A\uFF0C\\n\u4E00\uFF5E\u5B9A\u6CA1\u95EE\u9898\u7684\uFF01[VAR 0114(0004)]",
  "\u6211\u4E5F\u662F\u8FD9\u4E48\u60F3\u7684\u3002\\n\u5C31\u5F53\u662F\u6211\u6295\u8D44\u672A\u6765\u5427\uFF0C\\r\\n\u8BF7\u6536\u4E0B\u8FD9\u4E9B\u4E1C\u897F\u3002[VAR 0114(0011)]",
  "\u5728\u592A\u6676\u72B6\u6001\u4E0B\u4F7F\u51FA\u8FD9\u62DB\u7684\u8BDD\uFF0C\\n\u62DB\u5F0F\u7684\u5C5E\u6027\u4E5F\u4F1A\\r\\n\u6839\u636E\u592A\u6676\u5C5E\u6027\u4EA7\u751F\u53D8\u5316\u3002[VAR 0114(0011)]",
  "[VAR 0100(0000)]\uFF0C\u6709\u4F60\u8FD9\u4E2A\u5BF9\u624B\u5728\uFF0C\\n\u6211\u4EEC\u603B\u6709\u4E00\u5929\u80FD\u5B9E\u73B0\u6700\u68D2\u7684\u5BF9\u6218\u2026\u2026\uFF01[VAR 0114(0004)]",
  "\u6211\u4E5F\u4F1A\u66F4\u52A0\uFF0C\\n\u66F4\uFF5E\u52A0\u52AA\u529B\u7684\uFF5E\uFF01[VAR 0114(0004)]",
  "\u8FD9\u662F\u53CB\u60C5\u2026\u2026\u6FC0\u52B1\u2026\u2026\\n\u8FD8\u662F\u671F\u5F85\u5462\uFF1F[VAR 0114(0011)]",
  "\u4E0D\u2026\u2026\u8FD9\u4E00\u5B9A\u662F\u56E0\u4E3A\u5979\u786E\u4FE1\u4F1A\u5982\u6B64\uFF0C\\n\u624D\u4F1A\u8FD9\u4E48\u8BF4\u7684\u5427\u3002[VAR 0114(0011)]",
  "\u8BA9\u6211\u6765\u9001\u4F60\u5230\u521A\u624D\u7684\u9053\u9986\u5427\u3002[VAR 0114(0011)]"
]
