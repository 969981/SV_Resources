[
  "\u91CD\u5934\u620F\u524D\u5FC3\u6F6E\u6F8E\u6E43\u2026\u2026\\n\u4F53\u5185\u7EC6\u80DE\u84C4\u52BF\u5F85\u53D1\u3002[VAR 0114(001C)]",
