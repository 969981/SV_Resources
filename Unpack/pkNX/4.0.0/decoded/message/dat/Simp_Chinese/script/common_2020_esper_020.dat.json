  "\u8389\u666E\u6211\u554A\uFF0C\u9AD8\u5174\u6781\u4E86\u3002[VAR 0114(001C)]",
  "\u81EA\u5DF1\u63A5\u89E6\u8FC7\u7684\u4EBA\u80FD\u8BA9\u624D\u80FD\u89C9\u9192\uFF0C\\n\u5E76\u4E14\u8FD8\u80FD\u5927\u5C55\u8EAB\u624B\u2026\u2026[VAR 0114(001C)]",
