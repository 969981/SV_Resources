[
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u627E\u5230\u707E\u7978\u4E4B\u5B9D\u4E86\u5417\uFF1F[VAR 0114(0027)]",
  "\u7B49\u4F60\u6709\u5174\u8DA3\u4E86\uFF0C\u5E2E\u6211\u8C03\u67E5\u4E00\u4E0B\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u4F60\u597D\u50CF\u6CA1\u6709\\n\u5173\u4E8E\u707E\u7978\u4E4B\u5B9D\u7684\u65B0\u62A5\u544A\u554A\u3002[VAR 0114(0027)]",
  "\u54E6\u54E6\uFF01\u4F60\u6349\u5230\u707E\u7978\u4E4B\u9F0E\u7684\\n\u53E4\u9F0E\u9E7F\u4E86\u5417\uFF01\uFF01[VAR 0114(0027)]",
  "\u54E6\u54E6\uFF01\u4F60\u6349\u5230\u707E\u7978\u4E4B\u5251\u7684\\n\u53E4\u5251\u8C79\u4E86\u5417\uFF01\uFF01[VAR 0114(0027)]",
  "\u54E6\u54E6\uFF01\u4F60\u6349\u5230\u707E\u7978\u4E4B\u7B80\u7684\\n\u53E4\u7B80\u8717\u4E86\u5417\uFF01\uFF01[VAR 0114(0027)]",
  "\u54E6\u54E6\uFF01\u4F60\u6349\u5230\u707E\u7978\u4E4B\u7389\u7684\\n\u53E4\u7389\u9C7C\u4E86\u5417\uFF01\uFF01[VAR 0114(0027)]",
  "\u54DF\u5475\uFF5E\uFF01\u771F\u662F\u8010\u4EBA\u5BFB\u5473\uFF01\\n\u771F\u662F\u4EE4\u4EBA\u597D\u5947\u5FC3\u6D0B\u6EA2\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u4ECE\u5176\u5F62\u72B6\u548C\u5927\u5C0F\u6765\u770B\uFF0C\\n\u8FD9\u4EF6\u9F0E\u5E94\u8BE5\u4E0D\u662F\u65E5\u7528\u54C1\uFF01[VAR 0114(0027)]",
  "\u662F\u827A\u672F\u54C1\u2026\u2026\\n\u6216\u8005\u5F88\u53EF\u80FD\u66FE\u4F5C\u4E3A\\r\\n\u796D\u7940\u795E\u660E\u7684\u796D\u5668\u800C\u88AB\u4F7F\u7528\uFF01\uFF01[VAR 0114(0027)]",
  "\u5B83\u957F\u7740\u89D2\u548C\u6A21\u4EFF\u773C\u775B\u7684\u8BBE\u8BA1\uFF0C\\n\u603B\u89C9\u5F97\u5176\u4E2D\u5E94\u8BE5\u6709\u4EC0\u4E48\u542B\u4E49\u3002[VAR 0114(0027)]",
  "\u53D7\u5230\u4FE1\u4EF0\u7684\u795E\u660E\uFF0C\u6709\u6CA1\u6709\u53EF\u80FD\\n\u672C\u8EAB\u5C31\u662F\u9F0E\u7684\u5F62\u72B6\uFF01\uFF1F[VAR 0114(0027)]",
  "\u539F\u6765\u5251\u67C4\u548C\u5251\u8EAB\u7684\u90E8\u5206\\n\u5206\u522B\u6784\u6210\u4E86\u5DE6\u53F3\u4E24\u8FB9\u7684\u7259\u9F7F\uFF01[VAR 0114(0027)]",
  "\u4E0D\u77E5\u9053\u662F\u5728\u6210\u4E3A\u5B9D\u53EF\u68A6\u65F6\u6298\u65AD\u7684\uFF0C\\n\u8FD8\u662F\u4ECE\u4E00\u5F00\u59CB\u5C31\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u4E0D\u5BF9\uFF0C\u7B49\u7B49\uFF0C\u56FD\u738B\u600E\u4E48\u53EF\u80FD\\n\u4F1A\u53BB\u4E70\u4E00\u628A\u6298\u65AD\u7684\u5251\u5462\u3002[VAR 0114(0027)]",
  "\u6216\u8005\u4E5F\u6709\u53EF\u80FD\u5B83\u539F\u672C\u5C31\u662F\\n\u5728\u6298\u65AD\u72B6\u6001\u4E0B\u4F7F\u7528\u7684\u6B66\u5668\u2026\u2026\uFF01\uFF1F[VAR 0114(0027)]",
  "\u8FD9\u4E48\u591A\u6728\u7B80\u8FDE\u5728\u4E00\u8D77\uFF0C\\n\u771F\u662F\u4E00\u90E8\u957F\u7BC7\u5DE8\u4F5C\u554A\uFF01[VAR 0114(0027)]",
  "\u5927\u591A\u6570\u51FA\u571F\u7684\u6728\u7B80\\n\u90FD\u53EA\u662F\u4E00\u4E9B\u8349\u7A3F\u6216\u7B14\u8BB0\u800C\u5DF2\u2026\u2026\\r\\n\u4F46\u5B83\u4EEC\u4ECD\u662F\u4E86\u89E3\u5F53\u65F6\u60C5\u51B5\u7684\u91CD\u8981\u7269\u54C1\uFF01[VAR 0114(0027)]",
  "\u867D\u7136\u6211\u65E0\u6CD5\u89E3\u8BFB\uFF0C\u4F46\u4EE5\u5B83\u7684\u957F\u5EA6\uFF0C\\n\u662F\u6545\u4E8B\u5417\uFF1F\u4EA6\u6216\u662F\u8BC5\u5492\u7684\u8A00\u8BED\u5462\uFF1F[VAR 0114(0027)]",
  "\u53EA\u53EF\u60DC\u5B57\u8FF9\u5DF2\u7ECF\u6A21\u7CCA\u4E0D\u6E05\u4E86\uFF01\\n\u5F15\u8D77\u56FD\u738B\u5174\u8DA3\u7684\u6728\u7B80\uFF01\\r\\n\u4E0A\u9762\u5230\u5E95\u5199\u4E86\u600E\u6837\u7684\u6587\u7AE0\u5462\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u52FE\u7389\u56E0\u5176\u795E\u5723\uFF0C\\n\u66FE\u88AB\u4F69\u6234\u5728\u8EAB\u4E0A\u7528\u4E8E\u796D\u7940\u3002[VAR 0114(0027)]",
  "\u5927\u591A\u662F\u50CF\u540A\u5760\u4E00\u6837\\n\u5C06\uFF11\u4E2A\u52FE\u7389\u6234\u5728\u8116\u5B50\u4E0A\uFF0C\\r\\n\u4F46\u662F\u53E4\u7389\u9C7C\u5374\u6234\u4E86\uFF14\u4E2A\u4E4B\u591A\u3002[VAR 0114(0027)]",
  "\u8FD9\u662F\u7528\u6765\u88C5\u9970\u8033\u6735\u548C\u624B\u8155\u7B49\\n\u6210\u5BF9\u7684\u90E8\u4F4D\u7684\u88C5\u9970\u54C1\uFF1F\\r\\n\u8FD8\u662F\u8BF4\u796D\u7940\u662F\u7531\uFF14\u4E2A\u4EBA\u8FDB\u884C\u7684\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u66FE\u88AB\u7528\u6765\u9664\u9B54\u9A71\u90AA\u7684\u52FE\u7389\uFF0C\\n\u5230\u5E95\u7ECF\u5386\u4E86\u4EC0\u4E48\\r\\n\u4EE5\u81F4\u88AB\u79F0\u4E3A\u707E\u7978\u2026\u2026[VAR 0114(0027)]",
  "\u8C1C\u56E2\u8D8A\u6765\u8D8A\u6DF1\uFF0C\\n\u54CE\u5440\uFF5E\u6211\u7684\u6C42\u77E5\u6B32\u9010\u6E10\u5F97\u5230\u6EE1\u8DB3\u2026\u2026\uFF01[VAR 0114(0027)]",
  "\u55EF\uFF1F\u597D\u50CF\u8FD8\u6709\\n\u80FD\u62A5\u544A\u7684\u8C03\u67E5\u54E6\uFF1F[VAR 0114(0027)]",
  "\u611F\u8C22\u4F60\uFF0C[VAR 0100(0000)]\uFF0C\\n\u80FD\u770B\u5230\u5B9E\u7269\u771F\u7684\u592A\u597D\u4E86\u3002[VAR 0114(0027)]",
  "\u8981\u662F\u627E\u5230\u5176\u4ED6\u7684\u707E\u7978\u4E4B\u5B9D\uFF0C\\n\u518D\u6765\u5411\u6211\u62A5\u544A\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u771F\u662F\u60CA\u4EBA\uFF0C\u8FD9\u4E48\u4E00\u6765\uFF0C\\n\u707E\u7978\u4E4B\u5B9D\u7684\u8C03\u67E5\u62A5\u544A\u5C31\u5168\u90E8\u7ED3\u675F\u4E86\u3002[VAR 0114(0027)]",
  "\u771F\u6CA1\u60F3\u5230\u4F60\u8FD9\u5B69\u5B50\\n\u7ADF\u7136\u8FD9\u4E48\u80FD\u5E72\u3002[VAR 0114(0027)]",
  "\u611F\u8C22\u4F60\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(0027)]",
  "\u6211\u539F\u672C\u60F3\u4EB2\u81EA\u8C03\u67E5\\n\u707E\u7978\u4E4B\u5B9D\uFF0C\u5E76\u5C06\u5176\\r\\n\u636E\u4E3A\u5DF1\u6709\u2026\u2026[VAR 0114(0027)]",
  "\u4F46\u6B63\u662F\u7531\u6BEB\u65E0\u6742\u5FF5\u7684\u4F60\uFF0C\\n\u624D\u80FD\u5B8C\u6210\u8C03\u67E5\u3002[VAR 0114(0027)]",
  "\u6211\u68A6\u5BD0\u4EE5\u6C42\u7684\u5B9D\u7269\uFF0C\\n\u5C31\u5148\u7531\u4F60\u4FDD\u7BA1\u5427\u3002[VAR 0114(0027)]",
  "\u8FD9\u662F\u4EE3\u8868\u6211\u611F\u8C22\u4E4B\u60C5\u7684\\n\u4E00\u70B9\u5FC3\u610F\uFF0C\u4F60\u62FF\u53BB\u5427\u3002[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C[VAR 0100(0000)]\u2026\u2026\\n\u4F60\u8FD9\u5B69\u5B50\u771F\u662F\u6709\u8DA3\uFF0C\\r\\n\u8BA9\u6211\u628A\u4F60\u52A0\u5165\u89C2\u5BDF\u540D\u5355\u4E2D\u5427\u3002[VAR 0114(0027)]",
  "\u4E0E\u857E\u8377\u8001\u5E08\u4E4B\u95F4\u7684\\n\u7275\u7ECA\u840C\u82BD\u4E86\uFF01"
]
