  "\u679C\u7136\u2026\u2026\u548C\u4E4C\u6817\u3001\u4E39\u745C\u7684\\n\u592A\u6676\u73E0\u6709\u4E00\u6837\u7684\u53CD\u5E94\u3002[VAR 0114(0042)]",
  "\u53EF\u80FD\u662F\u56E0\u4E3A\u5728\u5927\u7A7A\u6D1E\\n\u76F4\u63A5\u63A5\u89E6\u4E86\u592A\u4E50\u5DF4\u6208\u65AF\u7684\u80FD\u91CF\u3002[VAR 0114(0042)]",
