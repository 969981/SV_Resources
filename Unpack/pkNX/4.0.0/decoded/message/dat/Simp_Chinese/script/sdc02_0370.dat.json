  "\u771F\u4E0D\u6127\u662F\u5E74\u8F7B\u4EBA\uFF01\\n\u6211\u554A\uFF0C\u8FC7\u4E86\u597D\u591A\u5929\\r\\n\u8FD8\u89C9\u5F97\u5F88\u7D2F\u5462\uFF01[VAR 0114(0042)]",
  "\u4EC0\u4E48\uFF01\u4F60\u8FD9\u4E48\u5E74\u8F7B\uFF0C\u6CA1\u60F3\u5230\u554A\uFF01\\n\u4F60\u5E94\u8BE5\u8FD8\u6CA1\u5230\u4E24\u5929\u540E\u624D\u4F1A\\r\\n\u808C\u8089\u75DB\u7684\u5E74\u7EAA\u624D\u5BF9\u554A\uFF01\uFF1F[VAR 0114(0042)]",
  "\u5BF9\u4E86\uFF0C\u4E3A\u4E86\u628A\u5728\u5927\u7A7A\u6D1E\u7684\\n\u8C03\u67E5\u6574\u7406\u6210\u4E66\uFF0C\\r\\n\u4ECE\u90A3\u4EE5\u540E\u6211\u4E00\u76F4\u4E0D\u7720\u4E0D\u4F11\u5730\u5199\u4F5C\u3002[VAR 0114(0042)]",
  "\u5F53\u7136\uFF0C\u8FD9\u662F\u5F97\u5230\u4E5F\u6148\u8BB8\u53EF\u7684\uFF0C\\n\u5177\u4F53\u4E8B\u4EF6\u548C\u4EBA\u540D\u4E4B\u7C7B\u7684\u5185\u5BB9\\r\\n\u6211\u90FD\u6CA1\u6709\u8BF4\u51FA\u6765\uFF0C\u6240\u4EE5\u653E\u5FC3\u5427\u3002[VAR 0114(0042)]",
  "\u8FD9\u662F\u521A\u624D\u6536\u5230\u7684\u6837\u4E66\u3002[VAR 0114(0042)]",
  "\u5728\u96F6\u4E4B\u5927\u7A7A\u6D1E\\n\u771F\u7684\u7ED9\u4F60\u6DFB\u9EBB\u70E6\u4E86\u3002[VAR 0114(0042)]",
  "\u8C08\u4E0D\u4E0A\u8868\u8FBE\u6B49\u610F\uFF0C\\n\u4F46\u662F\u5E0C\u671B\u4F60\u4E00\u5B9A\u8981\u6536\u4E0B\u3002[VAR 0114(0042)]",
