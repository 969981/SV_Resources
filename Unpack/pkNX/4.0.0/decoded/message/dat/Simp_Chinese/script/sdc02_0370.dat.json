  "\u592A\u6676\u7684\u7814\u7A76\u5927\u6709\u8FDB\u5C55\uFF0C\\n\u771F\u662F\u66F4\u52A0\u5149\u5F69\u593A\u76EE\u4E86\u554A\uFF01[VAR 0114(0042)]",
  "\u7136\u540E\u2026\u2026\u5BF9\u4E86\uFF0C\\n\u5165\u53E3\u5927\u5802\u90A3\u8FB9\u2026\u2026\\c\\n\u6709\u4E2A\u7A7F\u9ED1\u897F\u88C5\u7684\u5927\u53D4\\n\u6B63\u5728\u627E\u4F60\u54E6\u3002[VAR 0114(0042)]",
  "\u6211\u8981\u544A\u8BC9\u4F60\u7684\u5C31\u662F\u8FD9\u4E9B\uFF01\\n\u8C22\u8C22\u4F60\u62BD\u51FA\u65F6\u95F4\u542C\u6211\u8BF4\uFF01[VAR 0114(0042)]",
  "\u63A5\u4E0B\u6765\u6211\u8FD8\u8981\u53BB\u51FA\u7248\u793E\uFF0C\\n\u5C31\u5148\u5931\u966A\u4E86\u3002\\c\\n\u5E0C\u671B\u4E0B\u6B21\u80FD\u8BA9\u6211\u597D\u597D\\n\u89C2\u5BDF\u4E00\u4E0B\u592A\u4E50\u5DF4\u6208\u65AF\u554A\u3002[VAR 0114(0042)]"
