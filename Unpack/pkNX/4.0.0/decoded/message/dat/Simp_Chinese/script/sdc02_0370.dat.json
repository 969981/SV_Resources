  "\u5C31\u662F\u5173\u4E8E\u540A\u5728\u751F\u6001\u5DE8\u86CB\\n\u5706\u9876\u4E0A\u7684\u751F\u6001\u6838\uFF01[VAR 0114(0042)]",
  "\u4E00\u76F4\u4EE5\u6765\uFF0C\u6211\u7ECF\u5E38\u5411\u91CC\u9762\\n\u6CE8\u5165\u5E15\u5E95\u4E9A\u7684\u571F\u58E4\u6216\u6676\u5149\u6C60\u7684\u6C34\u3002[VAR 0114(0042)]",
  "\u56E0\u6B64\u624D\u80FD\u5728\u5B66\u56ED\u5185\\n\u7A33\u5B9A\u5730\u4F7F\u7528\u592A\u6676\u5316\uFF0C\\r\\n\u53EF\u662F\u6CA1\u60F3\u5230\u2026\u2026[VAR 0114(0042)]",
  "\u628A\u524D\u51E0\u5929\u5728\u5927\u7A7A\u6D1E\u91C7\u96C6\u7684\u7ED3\u6676\\n\u653E\u8FDB\u53BB\u540E\uFF0C\u6838\u5FC3\u7684\u6027\u8D28\u53D1\u751F\u4E86\u6539\u53D8\u3002[VAR 0114(0042)]",
