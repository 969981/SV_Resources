  "[~ 15]",
  "[~ 15]",
  "\u6B22\u8FCE\u6765\u5230\u9526\u6C47\u9053\u9986\uFF01",
  "\u6211\u8981\u767B\u8BB0\u4E00\u4E0B\\n\u6311\u6218\u8005\u7684\u540D\u5B57\u2026\u2026\\r\\n\u4F60\u662F[VAR 0100(0000)]\uFF0C\u6CA1\u9519\u5427\uFF1F",
  "\u60F3\u548C\u672C\u9053\u9986\u7684\\n\u9986\u4E3B\u9752\u6728\u5BF9\u6218\uFF0C\\r\\n\u9700\u8981\u5148\u901A\u8FC7\u9053\u9986\u6D4B\u9A8C\u624D\u884C\u3002",
  "\u9526\u6C47\u9053\u9986\u7684\\n\u9053\u9986\u6D4B\u9A8C\u662F\u2026\u2026\\r\\n[VAR FF00(0006)]\u70B9\u79D8\u5BC6\u83DC\u5355\u7684\u83DC[VAR FF00(0000)]\uFF01",
  "\u8FC7\u5173\u6761\u4EF6\u662F\u5728\u9526\u6C47\u9547\u4E2D\\n\u5F88\u53D7\u6B22\u8FCE\u7684[VAR FF00(0006)]\u5B9D\u98DF\u5802[VAR FF00(0000)]\\r\\n\u70B9\u79D8\u5BC6\u83DC\u5355\u7684\u83DC\u3002",
  "\u73B0\u5728\u8FD9\u4E2A\u9547\u5B50\u91CC\\n\u9664\u4F60\u4E4B\u5916\u8FD8\u6709\uFF13\u4F4D\\r\\n\u9053\u9986\u6D4B\u9A8C\u7684\u6311\u6218\u8005\u3002",
  "\u6BCF\u4F4D\u6311\u6218\u8005\u90FD\u77E5\u9053\u4E00\u90E8\u5206\\n\u79D8\u5BC6\u83DC\u5355\u7684\u63D0\u793A\uFF0C\u4F46\u5185\u5BB9\u90FD\u4E0D\u4E00\u6837\u3002",
  "\u8BF7\u4F60\u4EEC\u51E0\u4F4D\u6311\u6218\u8005\u4E92\u76F8\u5BF9\u6218\uFF0C\\n\u8F93\u7684\u4E00\u65B9\u8981\u628A\u81EA\u5DF1\u77E5\u9053\u7684\u63D0\u793A\\r\\n\u544A\u8BC9\u8D62\u7684\u4E00\u65B9\u3002",
  "\u7136\u540E\u6839\u636E\u6536\u96C6\u5230\u7684\u63D0\u793A\uFF0C\\n\u627E\u5B9D\u98DF\u5802\u7684\u5E97\u5458\\r\\n\u70B9\u79D8\u5BC6\u83DC\u5355\u7684\u83DC\u5427\u3002",
  "\u80FD\u6210\u529F\u70B9\u83DC\u7684\u6311\u6218\u8005\u5C31\u80FD\\n\u901A\u8FC7\u9053\u9986\u6D4B\u9A8C\uFF0C\u4EC5\u9650\u4E00\u4EBA\u3002",
  "[VAR 0100(0000)]\uFF0C\\n\u4F60\u7684\u63D0\u793A\u662F[VAR FF00(0006)]\u5E38\u5BA2\u7684\u5403\u6CD5[VAR FF00(0000)]\uFF01",
  "\u53BB\u5411\u5B9D\u98DF\u5802\u7684\u5E38\u5BA2\\n\u6253\u542C\u4E00\u4E0B\u6216\u8BB8\u662F\u4E2A\u597D\u4E3B\u610F\u54E6\uFF01",
  "[~ 15]"
]
