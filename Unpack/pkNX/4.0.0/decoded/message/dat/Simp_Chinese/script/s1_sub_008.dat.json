[
  "\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01\\n\u54E6\u54E6\uFF5E\u5475\u3001\u5475\u3001\u5475\uFF01[VAR 0114(0041)]",
  "\u767D\u94F6\u7684\u4E16\u754C\u4E00\u671B\u65E0\u57A0\uFF0C\\n\u771F\u662F\u5947\u5999\u65E0\u6BD4\u5462\uFF01[VAR 0114(0041)]",
  "\u662F\u5440\uFF01\u53EA\u8981\u7A7F\u4E0A\\n\u99A5\u597D\u4F60\u51C6\u5907\u7684\u8FD9\u4EF6\u8863\u670D\uFF0C\\r\\n\u5C31\u7B97\u5929\u51B7\u4E5F\u4E0D\u6015\uFF0C\u5F88\u6696\u548C\u5462\uFF01[VAR 0114(0040)]",
  "\u8FD9\u53EF\u662F\u7528\u4E86\u6700\u9AD8\u7EA7\u9762\u6599\u7684\\n\u6700\u9AD8\u7EA7\u540D\u724C\u8D27\u5462\uFF01[VAR 0114(0041)]",
  "\u6CA1\u7A7F\u8FD9\u4EF6\u8863\u670D\u5C31\u6765\u767B\u5C71\u7684\u4EBA\\n\u5DF2\u7ECF\u8BA9\u6211\u89C9\u5F97\u5F88\u53EF\u601C\u4E86\u3002[VAR 0114(0040)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u6309\u60EF\u4F8B\u4F1A\u51FA\u73B0\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u8FD8\u771F\u662F\u3002\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u90A3\u5C31\u662F\u6309\u60EF\u4F8B\u4F1A\u51FA\u73B0\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\uFF0C\u5FEB\u770B\uFF01\\n\u5EB6\u6C11\u7684\u8863\u670D\u9762\u6599\u90A3\u4E48\u8584\uFF01[VAR 0114(0040)]",
  "\u54CE\u3001\u54CE\u5440\uFF01\\n\u8FD9\u9762\u6599\u771F\u662F\u592A\u5355\u8584\u5566\uFF01[VAR 0114(0041)]",
  "\u6211\u8BF4\uFF0C\u6BC5\u4E07\uFF01\\n\u83AB\u975E\u5EB6\u6C11\u662F\u4E0D\u6015\u51B7\u7684\u5417\uFF1F[VAR 0114(0041)]",
  "\u6015\u4E0D\u6015\u51B7\u2026\u2026\u6211\u8FD8\u771F\u4E0D\u77E5\u9053\uFF0C\\n\u4F46\u5EB6\u6C11\u4E4B\u95F4\u4F3C\u4E4E\u4F1A\u7528\u201C\u8D2B\u5BD2\u201D\\r\\n\u6765\u5F62\u5BB9\u6CA1\u6709\u94B1\u7684\u60C5\u51B5\u54E6\u3002[VAR 0114(0040)]",
  "\u6240\u4EE5\u4ED6\u4EEC\u53EF\u80FD\u5DF2\u7ECF\\n\u4E60\u60EF\u5BD2\u51B7\u4E86\u5427\uFF1F[VAR 0114(0040)]",
  "\u6BC5\u4E07\uFF0C\u4F60\u2026\u2026[VAR 0114(0041)]",
  "\u771F\u662F\u5F88\u535A\u5B66\u5462\uFF01\\n\u6211\u8981\u4E3A\u4F60\u9881\u53D1\u91D1\u99A5\u597D\u5956\uFF01[VAR 0114(0041)]",
  "\u592A\u597D\u5566\uFF5E\uFF01[VAR 0114(0040)]",
  "\u5411\u7A77\u56F0\u6F66\u5012\u7684\u5EB6\u6C11\u4F38\u51FA\u63F4\u624B\\n\u6B63\u662F\u6211\u7B49\u540D\u6D41\u7684\u804C\u8D23\u2026\u2026[VAR 0114(0041)]",
  "\u8FD9\u4EFD\u9053\u5177\u5C31\u8D60\u4E0E\u4F60\u4E86\u3002\\n\u52AA\u529B\u6491\u8FC7\u4E25\u5BD2\u5427\uFF5E[VAR 0114(0041)]",
  "\u8FD9\u4F4D\u5EB6\u6C11\uFF0C\u4ED4\u7EC6\u542C\u597D\u54E6\u3002\\c\\n\u201C\u624B\u51B7\u7684\u4EBA\u6709\u70ED\u5FC3\u80A0\uFF01\u201D\u2026\u2026\\n\u8FD9\u6837\u7684\u8BF4\u6CD5\u6839\u672C\u5C31\u662F\u8FF7\u4FE1\uFF01\uFF01[VAR 0114(0041)]",
  "\u4F60\u7EDD\u4E0D\u53EF\u4EE5\\n\u5FD8\u8BB0\u8FD9\u4E00\u70B9\u54E6\u2026\u2026[VAR 0114(0041)]",
  "\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u91D1\u53E5\u8BF4\u5F97\u8D8A\u6765\u8D8A\u968F\u4FBF\u4E86\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u4E07\uFF01\u6211\u4EEC\u7684\u4F11\u5047\\n\u4E5F\u5DEE\u4E0D\u591A\u8BE5\u7ED3\u675F\u4E86\u2026\u2026[VAR 0114(0041)]",
  "\u6700\u540E\u4F5C\u4E3A\u6536\u5C3E\uFF0C\\n\u6211\u60F3\u53BB\u4FEF\u77B0\\r\\n\u5E15\u5E95\u4E9A\u5730\u533A\u7684[VAR FF00(0006)]\u6B63\u4E2D\u5FC3[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u54BB\uFF5E\uFF01\\n\u58EE\u89C2\u7684\u5730\u65B9\u4E5F\u8981\u4ECE\u4E0A\u65B9\u4FEF\u77B0\uFF01\\r\\n\u99A5\u597D\u4F60\u771F\u662F\u540D\u6D41\u7684\u5178\u8303\u5440\uFF01[VAR 0114(0040)]",
  "\u867D\u7136\u6211\u4EEC\u53EF\u80FD\u4E0D\u4F1A\u8FDB\u5165\u5DE8\u5751\u91CC\u9762\uFF0C\\n\u4F46\u6211\u59D1\u4E14\u8FD8\u662F\u5148\u5411\u8054\u76DF\u7533\u8BF7\u4E00\u4E0B\u54E6\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u4E07\u5148\u751F\\n\u5DF2\u7ECF\u524D\u53BB\u6500\u767B\\r\\n\u50CF\u6211\u53F8\u4E00\u6837\u6D01\u767D\u7684\u5C71\u4E86\u3002",
  "\u2026\u2026\u5148\u4E0D\u8BBA\u655D\u516C\u53F8\u662F\u5426\u6D01\u767D\uFF0C\\n\u8BF4\u8D77\u767D\u8272\u7684\u5C71\uFF0C\u971C\u62B9\u5C71\u662F\u5F88\u6709\u540D\u7684\u3002"
]
