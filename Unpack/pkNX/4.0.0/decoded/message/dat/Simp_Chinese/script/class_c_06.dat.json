[
  "\u55E8\uFF0C\u540C\u5B66\u4EEC\u597D\u3002\\n\u6628\u65E5\u4E5F\u5DF2\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u4E00\u90E8\u5206\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8BA9\u6211\u4EEC\u4E00\u8D77\\n\u89E3\u6790\u5386\u53F2\u7684\u7F8E\u5999\u4E4B\u5904\u5427\u3002[VAR 0114(0027)]",
  "\u524D\u534A\u6BB5\u7684\u8BFE\u5802\u91CC\u6211\u4EEC\u63A2\u8BA8\u4E86\\n\u5E15\u5E95\u4E9A\u5DE8\u5751\u4EE5\u53CA\u5B83\u7684\u5185\u90E8\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u7B2C\u96F6\u533A\uFF0C\u540C\u5B66\u4EEC\u5E94\u8BE5\u8FD8\u8BB0\u5F97\u5427\uFF1F[VAR 0114(0027)]",
  "\u90A3\u4E2A\u8BA9\u7687\u5E1D\u4EE5\u53CA\u4F17\u591A\u7684\u4EBA\\n\u4E3A\u4E4B\u75AF\u72C2\u7684\u795E\u79D8\u5DE8\u5751\u2026\u2026[VAR 0114(0027)]",
  "\u636E\u8BF4\u5728\u8DDD\u4ECA\uFF12\uFF10\uFF10\u5E74\u524D\uFF0C\\n\u7EC8\u4E8E\u6709\u4EBA\u5230\u8FBE\u4E86\u6700\u6DF1\u5904\u3002[VAR 0114(0027)]",
  "\u8FBE\u6210\u6B64\u9879\u4F1F\u4E1A\u7684\\n\u662F\u88AB\u79F0\u4E3A\u7B2C\u96F6\u533A\u89C2\u6D4B\u961F\u7684\u961F\u4F0D\u3002[VAR 0114(0027)]",
  "\u89C2\u6D4B\u961F\u7684\u961F\u5458\u4E4B\u4E2D\\n\u6709\u64C5\u957F\u5BF9\u6218\u7684\u4EBA\uFF0C\\r\\n\u8FD8\u6709\u77E5\u8BC6\u4E30\u5BCC\u7684\u4EBA\u7B49\u7B49\u3002[VAR 0114(0027)]",
  "\u4F3C\u4E4E\u662F\u7531\u5E15\u5E95\u4E9A\u7684\\n\u624D\u534E\u6A2A\u6EA2\u7684\u4EBA\u805A\u5728\u4E00\u8D77\u6240\u7EC4\u6210\u7684\u3002[VAR 0114(0027)]",
  "\u961F\u5458\u4E4B\u4E2D\u6709\u4E00\u4F4D\u4F5C\u5BB6\uFF0C\\n\u4E14\u5341\u5206\u7CBE\u901A\u535A\u7269\u5B66\u3002\\r\\n\u8FD9\u4F4D\u7537\u6027\u7684\u540D\u5B57\u53EB\u505A[VAR FF00(0006)]\u6D77\u54F2[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u4ED6\u53D1\u6325\u4E86\u81EA\u5DF1\u7684\u6587\u5B66\u624D\u534E\uFF0C\\n\u4ECE\u7B2C\u96F6\u533A\u56DE\u6765\u4E4B\u540E\\r\\n\u5C31\u64B0\u5199\u4E86\u63A2\u9669\u8BB0\uFF0C\u5E76\u5C06\u5176\u51FA\u7248\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u4E48\uFF0C\u8BF7\u73B0\u5728\u4E0D\u5E78\u4E0E\u6211\\n\u5BF9\u4E0A\u89C6\u7EBF\u7684[VAR 0100(0000)]\u6765\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u6211\u8981\u8003\u8003\u4F60\u6709\u6CA1\u6709\u597D\u597D\u542C\u8BB2\u3002\\n\u6700\u521D\u5230\u8FBE\u5DE8\u5751\u5185\u90E8\uFF0C\\r\\n\u4E5F\u5C31\u662F\u7B2C\u96F6\u533A\u6700\u6DF1\u5904\u7684\u961F\u4F0D\u7684\u540D\u5B57\u662F\uFF1F[VAR 0114(0027)]",
  "\u7B2C\u96F6\u533A\u5192\u9669\u961F",
  "\u7B2C\u96F6\u533A\u89C2\u6D4B\u961F",
  "\u7B2C\u96F6\u533A\u8C03\u67E5\u961F",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u6211\u770B\u4F60\u4E5F\u662F\u5BF9\u5192\u9669\\r\\n\u8FD9\u4E2A\u8BCD\u8BED\u5FC3\u52A8\u4E86\u5427\u2026\u2026[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u6B63\u786E\uFF01\\n\u5C3D\u7BA1\u662F\u6211\u82E5\u65E0\u5176\u4E8B\u8BB2\u7684\u5185\u5BB9\uFF0C\\r\\n\u4F60\u4E5F\u80FD\u4ECE\u4E2D\u5438\u53D6\u77E5\u8BC6\uFF0C\u771F\u662F\u806A\u6167\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u56DE\u7B54\u9519\u8BEF\uFF01\\n\u867D\u7136\u8C03\u67E5\u548C\u89C2\u6D4B\\r\\n\u6240\u505A\u7684\u4E8B\u90FD\u5DEE\u4E0D\u591A\u5C31\u662F\u4E86\uFF01[VAR 0114(0027)]",
  "\u6CA1\u9519\uFF01\u6B63\u786E\u7684\u961F\u540D\\n\u662F\u7B2C\u96F6\u533A\u89C2\u6D4B\u961F\uFF01[VAR 0114(0027)]",
  "\u89C2\u6D4B\u961F\u961F\u5458\u6D77\u54F2\u6240\u5199\u7684\u63A2\u9669\u8BB0\\n\u73B0\u5728\u4E5F\u80FD\u5728\u4E66\u5E97\u7B49\u5730\u65B9\u627E\u5230\u3002[VAR 0114(0027)]",
  "\u4E66\u540D\u5E94\u8BE5\u662F\u53EB[VAR FF00(0006)]\u300A\u6731\u4E4B\u4E66\u300B[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u4E66\u540D\u5E94\u8BE5\u662F\u53EB[VAR FF00(0006)]\u300A\u7D2B\u4E4B\u4E66\u300B[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u5F53\u65F6\u6574\u4E2A\u5E15\u5E95\u4E9A\\n\u90FD\u9677\u5165\u4E86\u7B2C\u96F6\u533A\u70ED\u6F6E\u3002[VAR 0114(0027)]",
  "\u300A\u6731\u4E4B\u4E66\u300B\u975E\u5E38\u7545\u9500\uFF0C\\n\u51E0\u4E4E\u5230\u4E86\u4EBA\u624B\u4E00\u672C\u7684\u7A0B\u5EA6\u3002[VAR 0114(0027)]",
  "\u300A\u7D2B\u4E4B\u4E66\u300B\u975E\u5E38\u7545\u9500\uFF0C\\n\u51E0\u4E4E\u5230\u4E86\u4EBA\u624B\u4E00\u672C\u7684\u7A0B\u5EA6\u3002[VAR 0114(0027)]",
  "\u4F46\u5185\u5BB9\u5374\u5145\u65A5\u7740\u96BE\u4EE5\u7F6E\u4FE1\u7684\u63CF\u8FF0\\n\u548C\u8352\u5510\u65E0\u7406\u7684\u63D2\u753B\uFF0C\u7B80\u76F4\u5C31\u662F\u65E0\u7A3D\u4E4B\u8C08\u2026\u2026\\r\\n\u4E8E\u662F\u5927\u4F17\u4FBF\u79F0\u6D77\u54F2\u662F\u4E2A\u9A97\u5B50\u3002[VAR 0114(0027)]",
  "\u5C31\u8FDE\u89C2\u6D4B\u961F\u7A76\u7ADF\u6709\u6CA1\u6709\\n\u5230\u8FBE\u6700\u6DF1\u5904\u4E00\u4E8B\u4E5F\u53D8\u5F97\u6A21\u7CCA\u4E0D\u6E05\u3002[VAR 0114(0027)]",
  "\u800C\u540E\u300A\u6731\u4E4B\u4E66\u300B\u88AB\u5F53\u4F5C\u662F\u8D85\u81EA\u7136\u6587\u5B66\uFF0C\\n\u5012\u662F\u8BA9\u4E8C\u624B\u4E66\u5E97\u5E02\u573A\u70ED\u95F9\u4E86\u4E0D\u5C11\u3002[VAR 0114(0027)]",
  "\u800C\u540E\u300A\u7D2B\u4E4B\u4E66\u300B\u88AB\u5F53\u4F5C\u662F\u8D85\u81EA\u7136\u6587\u5B66\uFF0C\\n\u5012\u662F\u8BA9\u4E8C\u624B\u4E66\u5E97\u5E02\u573A\u70ED\u95F9\u4E86\u4E0D\u5C11\u3002[VAR 0114(0027)]",
  "\u5165\u53E3\uFF11\u697C\u7684\u4E66\u67B6\u4E0A\u5C31\u6709\uFF0C\\n\u5982\u679C\u4F60\u4EEC\u611F\u5174\u8DA3\u7684\u8BDD\u5C31\u770B\u4E00\u770B\u5427\u3002[VAR 0114(0027)]",
  "\u54CE\u5440\uFF1F\u6211\u6216\u8BB8\u8BF4\u592A\u591A\u4E86\uFF0C\\n\u65F6\u95F4\u597D\u50CF\u8D70\u592A\u5FEB\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8BFE\u5C31\u4E0A\u5230\u8FD9\u91CC\u3002\\n\u6211\u4EEC\u4E0B\u56DE\u518D\u89E3\u5386\u53F2\u4E4B\u8C1C\u3002[VAR 0114(0027)]"
]
