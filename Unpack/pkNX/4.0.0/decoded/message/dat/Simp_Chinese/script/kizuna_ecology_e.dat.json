  "\u867D\u7136\u56FE\u9274\u5DF2\u7ECF\u5B8C\u6210\u4E86\uFF0C\\n\u4F46\u5192\u9669\u624D\u521A\u521A\u5F00\u59CB\u3002[VAR 0114(002A)]",
  "\u4ECE\u6B64\u5F80\u540E\u4F60\u4E5F\u8981\u548C\\n\u5F88\uFF5E\u591A\u5E15\u5E95\u4E9A\u7684\u5B9D\u53EF\u68A6\u76F8\u9047\u54E6\uFF5E[VAR 0114(002A)]",
  "\u6821\u957F\u6211\u4E5F\u4F1A\\n\u5173\u6CE8\u548C\u5B88\u62A4\u7740\u4F60\u7684\u54E6\u3002[VAR 0114(000A)]"
