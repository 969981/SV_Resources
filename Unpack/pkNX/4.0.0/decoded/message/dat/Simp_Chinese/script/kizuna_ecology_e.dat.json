  "\u514B\u62C9\u97E6\u5C14\u6821\u957F\\n\u5728\u7F16\u7A0B\u65B9\u9762\u4E5F\u5F88\u5389\u5BB3\u3002[VAR 0114(002A)]",
  "\u8BDD\u8BF4\u56DE\u6765\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u771F\u7684\u975E\u5E38\u52AA\u529B\u3002[VAR 0114(002A)]",
  "\u5982\u679C[VAR 0100(0000)]\u4F60\u7684\u5B9D\u7269\\n\u5C31\u662F\u5B8C\u6210\u5B9D\u53EF\u68A6\u56FE\u9274\u7684\u8BDD\uFF0C\\r\\n\u5BFB\u5B9D\u771F\u662F\u5927\u83B7\u6210\u529F\u5462\uFF01[VAR 0114(002A)]",
  "\u786E\u5B9E\u5982\u6B64\u3002\\n\u5409\u5C3C\u4E9A\u8001\u5E08\u8BF4\u5F97\u592A\u597D\u4E86\u3002[VAR 0114(000A)]",
