[
  "\u554A\uFF0C[VAR 0100(0000)]\u3002\\n\u4F60\u597D\u5440\uFF5E\u4F60\u597D\uFF01[VAR 0114(002A)]",
  "\u4EC0\u4E48\uFF01\uFF1F\u96BE\u9053\u8BF4\uFF0C\\n\u5B9D\u53EF\u68A6\u56FE\u9274\u7684\uFF14\uFF10\uFF10\u79CD\u5B9D\u53EF\u68A6\uFF01\\r\\n\u4F60\u5168\u90FD\u6536\u96C6\u5230\u4E86\u5417\uFF01\uFF1F[VAR 0114(002A)]",
  "\u54C7\uFF5E\u54C7\uFF5E\uFF01\\n\u5B9D\u53EF\u68A6\u56FE\u9274\u5B8C\u6210\u4E86\uFF5E\uFF01\\r\\n\u592A\u5389\u5BB3\u4E86\uFF5E\u771F\u7684\u592A\u5389\u5BB3\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u591A\u4E8F\u4E86[VAR 0100(0000)]\u4F60\uFF0C\\n\u5E15\u5E95\u4E9A\u5730\u533A\u7684\u5B9D\u53EF\u68A6\u8C03\u67E5\\r\\n\u53D6\u5F97\u4E86\u524D\u6240\u672A\u6709\u7684\u8FDB\u5C55\uFF01[VAR 0114(002A)]",
  "\u8FD9\u662F\u6211\u4E4B\u524D\u5728\u4E00\u5BB6\u5947\u602A\u7684\u5546\u5E97\u91CC\\n\u4E70\u7684\u7279\u4EA7\uFF0C\u771F\u662F\u4E0D\u597D\u610F\u601D\uFF0C\\r\\n\u5C31\u7B97\u8001\u5E08\u9001\u7ED9\u4F60\u7684\u793C\u7269\u5427\uFF01[VAR 0114(002A)]",
  "\u8981\u662F\u80FD\u9001\u4F60\\n\u66F4\u50CF\u6837\u7684\u793C\u7269\u5C31\u597D\u4E86\u2026\u2026[VAR 0114(002A)]",
  "\u8FD9\u91CC\u597D\u50CF\u6709\u70B9\u70ED\u95F9\uFF0C\\n\u53D1\u751F\u4EC0\u4E48\u4E8B\u4E86\u5417\uFF1F[VAR 0114(000A)]",
