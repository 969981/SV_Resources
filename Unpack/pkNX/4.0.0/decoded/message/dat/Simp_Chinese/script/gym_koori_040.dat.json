  "\u600E\u4E48\u529E\u2026\u2026",
  "\u597D\u4E2A\u5C34\u51B7\u7684\u56DE\u7B54\u3002\\n\u2026\u2026\u592A\u9057\u61BE\u4E86\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u505C\u4E0B\u811A\u6B65\u4E5F\u662F\u9700\u8981\u52C7\u6C14\u7684\u3002\\n\u4E0D\u8FC7\uFF0C\u50CF\u4F60\u8FD9\u6837\u7684\u4EBA\\r\\n\u5230\u6700\u540E\u8FD8\u662F\u4F1A\u9009\u62E9\u524D\u8FDB\u7684\u3002[VAR 0114(001A)]",
