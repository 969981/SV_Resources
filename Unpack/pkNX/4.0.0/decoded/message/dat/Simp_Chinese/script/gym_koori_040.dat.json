  "\u4E0D\uFF0C\u6CA1\u4EC0\u4E48\u3002\\n\u6211\u5F97\u628A\u9053\u9986\u5FBD\u7AE0\u7ED9\u4F60\u3002[VAR 0114(001A)]",
  "\u55EF\uFF1F\u4F60\u8BF4\u4E3A\u4E86\u5E86\u795D\u5408\u683C\uFF0C\\n\u60F3\u548C\u6211\u4E00\u8D77\u62CD\u5F20\u7EAA\u5FF5\u7167\u2026\u2026\uFF1F[VAR 0114(001A)]",
  "\u545C\u545C\u2026\u2026\u8FD9\u592A\u5C34\u51B7\u4E86\uFF0C\\n\u6240\u4EE5\u6211\u86EE\u8BA8\u538C\u8FD9\u79CD\u4E8B\u3002\\r\\n\u6CA1\u529E\u6CD5\u2026\u2026\u8FD9\u6B21\u5C31\u7834\u4E2A\u4F8B\u5427\u3002[VAR 0114(001A)]",
  "\u6709[VAR 0200(0001)]\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u7B49\u7EA7[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4F1A\u66F4\u5BB9\u6613\u6349\u5230\uFF0C\\r\\n\u8FD8\u5E94\u8BE5\u90FD\u4F1A\u542C\u4F60\u7684\u8BDD\u3002[VAR 0114(001A)]",
  "\u6709\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u7684\u8BDD\uFF0C\\n\u4E0D\u7BA1\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u5C31\u7B97\u662F\u5C34\u51B7\u7684\u6307\u793A\uFF0C\u5B83\u4EEC\u4E5F\u5E94\u8BE5\u4F1A\u542C\u7684\u3002[VAR 0114(001A)]",
  "\u5BF9\u4E86\uFF0C\u8D81\u6211\u8FD8\u6CA1\u5FD8\uFF0C\\n\u628A\u8FD9\u4E2A\u4E5F\u62FF\u53BB\u5427\u3002[VAR 0114(001A)]",
  "\u8FD9\u7EDD\u5BF9\u6BD4\u548C\u6211\u7684\u5408\u7167\\n\u66F4\u80FD\u6D3E\u4E0A\u7528\u573A\u624D\u5BF9\u2026\u2026[VAR 0114(001A)]",
  "\u5982\u679C\u4F60\u4E0D\u5ACC\u51B7\u7684\u8BDD\uFF0C\\n\u5C31\u518D\u6765\u627E\u6211\u5427\u2026\u2026\u518D\u89C1\u4E86\u3002[VAR 0114(001A)]",
