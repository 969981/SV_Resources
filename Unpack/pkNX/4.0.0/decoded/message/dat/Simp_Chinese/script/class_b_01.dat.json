[
  "\u5927\u5BB6\u597D\uFF0C\u521D\u6B21\u89C1\u9762\u3002\\n\u6211\u53EB\u6CF0\u59C6\uFF0C\u8D1F\u8D23\u6559\u4F60\u4EEC\u6570\u5B66\u3002[VAR 0114(0025)]",
  "\u867D\u7136\u6709\u4E9B\u7A81\u7136\uFF0C\\n\u4F46\u8BA9\u6211\u63D0\u4E2A\u95EE\u9898\uFF0C\\r\\n\u5927\u5BB6\u662F\u5426\u559C\u6B22\u6570\u5B57\u548C\u8BA1\u7B97\u8FD9\u7C7B\u4E1C\u897F\u5462\uFF1F[VAR 0114(0025)]",
  "\u559C\u6B22\uFF5E\uFF01",
  "\u8FD8\u884C\u2026\u2026",
  "\u5443\u2026\u2026",
  "\u54CE\u5440\uFF0C\u54E6\u5475\u5475\u2026\u2026\\n\u8C22\u8C22\u4F60\u4EEC\u7684\u56DE\u7B54\u3002[VAR 0114(0025)]",
  "\u6709\u4EBA\u559C\u6B22\uFF0C\u4E5F\u6709\u4EBA\u53CD\u611F\uFF0C\\n\u73ED\u91CC\u7684\u540C\u5B66\u4E0D\u5C3D\u76F8\u540C\uFF0C\u771F\u597D\u554A\u3002[VAR 0114(0025)]",
  "\u4E0D\u8FC7\uFF0C\u65E0\u8BBA\u4F60\u5C5E\u4E8E\u54EA\u7C7B\u4EBA\uFF0C\u90FD\u653E\u5FC3\u5427\u3002\\c\\n\u548C\u8001\u5E08\u4E00\u8D77\\n\u5FEB\u5FEB\u4E50\u4E50\u5730\u5B66\u4E60\u77E5\u8BC6\u5427\uFF5E\uFF01[VAR 0114(0025)]",
  "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5173\u4E8E\u5B9D\u53EF\u68A6\u7684\u5C5E\u6027\u76F8\u514B\uFF0C\\n\u5927\u5BB6\u5E94\u8BE5\u90FD\u638C\u63E1\u5F97\u5F88\u597D\u4E86\u5427\uFF1F[VAR 0114(0025)]",
  "\u8349\u514B\u6C34\uFF0C\\n\u800C\u6C34\u514B\u706B\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u597D\u50CF\u5F88\u4E86\u89E3\u5B9D\u53EF\u68A6\u7684[VAR 0100(0000)]\uFF0C\\n\u6211\u5E0C\u671B\u4F60\u53EF\u4EE5\u544A\u8BC9\u8001\u5E08\u3002[VAR 0114(0025)]",
  "\u5F53\u514B\u706B\u7684\u6C34\u5C5E\u6027\u62DB\u5F0F\uFF0C\\n\u6C34\u67AA\u547D\u4E2D\u706B\u5B9D\u53EF\u68A6\u7684\u8BDD\uFF0C\\r\\n\u7ED9\u4E88\u5BF9\u624B\u7684\u4F24\u5BB3\u662F\u600E\u6837\u7684\u5462\uFF1F[VAR 0114(0025)]",
  "\u51CF\u534A",
  "\u4E0D\u53D8",
  "\u53D8\u6210\uFF12\u500D",
  "\u54CE\u5440\uFF0C\u662F\u9006\u5411\u601D\u7EF4\u5462\uFF01\\n\u4F46\u5982\u679C\u662F\u8001\u5E08\u6211\u88AB\u8BA8\u538C\u7684\u4E1C\u897F\u78B0\u5230\u4E86\uFF0C\\r\\n\u53EF\u80FD\u4F1A\u6709\u4E9B\u96BE\u53D7\u5462\u3002[VAR 0114(0025)]",
  "[VAR 0100(0000)]\u4F60\u5F88\u64C5\u957F\u5FCD\u8010\uFF0C\u662F\u5427\uFF1F\\n\u4F46\u5982\u679C\u662F\u8001\u5E08\u6211\u88AB\u8BA8\u538C\u7684\u4E1C\u897F\u78B0\u5230\u4E86\uFF0C\\r\\n\u53EF\u80FD\u4F1A\u6709\u4E9B\u96BE\u53D7\u5462\u3002[VAR 0114(0025)]",
  "\u6CA1\u9519\uFF01\u7B54\u5F97\u975E\u5E38\u597D\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\u4F60\u5462\uFF01[VAR 0114(0025)]",
  "\u53EA\u8981\u4F7F\u51FA\u7684\u62DB\u5F0F\u5C5E\u6027\u662F\u5BF9\u65B9\u7684\u5F31\u70B9\uFF0C\\n\u90A3\u5C31\u662F\u6548\u679C\u7EDD\u4F73\uFF01\\r\\n\u7ED9\u4E88\u7684\u4F24\u5BB3\u4F1A\u53D8\u6210\uFF12\u500D\u3002[VAR 0114(0025)]",
  "\u76F8\u53CD\uFF0C\u5982\u679C\u662F\u5BF9\u65B9\u64C5\u957F\u7684\u5C5E\u6027\uFF0C\\n\u90A3\u5C31\u4F1A\u6548\u679C\u4E0D\u597D\u2026\u2026\\r\\n\u4F24\u5BB3\u53EA\u6709\u901A\u5E38\u7684\u4E00\u534A\u3002[VAR 0114(0025)]",
  "\u54E6\u5475\u5475\uFF01\u8FD9\u66F4\u50CF\u662F\u5BF9\u6218\u5B66\u7684\u5185\u5BB9\uFF0C\\n\u867D\u7136\u5BF9\u51F0\u6A97\u8001\u5E08\u6709\u4E9B\u62B1\u6B49\uFF0C\\r\\n\u4F46\u6211\u60F3\u5982\u679C\u62FF\u5B9D\u53EF\u68A6\u5BF9\u6218\u6765\u4E3E\u4F8B\u7684\u8BDD\u2026\u2026[VAR 0114(0025)]",
  "\u5C31\u7B97\u662F\u4F60\u4EEC\u4E0D\u592A\u559C\u6B22\u7684\u6570\u5B66\uFF0C\\n\u4E5F\u80FD\u8BA9\u5927\u5BB6\u4E00\u8D77\u4E50\u5728\u5176\u4E2D\uFF0C\u5BF9\u5427\uFF1F[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u4E0B\u8BFE\u94C3\u54CD\u4E86\uFF1F\\n\u5DF2\u7ECF\u5230\u65F6\u95F4\u4E86\u5440\uFF0C\u771F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u6211\u4F1A\u53D1\u81EA\u5185\u5FC3\u5730\u671F\u5F85\\n\u4E0B\u6B21\u7EE7\u7EED\u548C\u5927\u5BB6\u4E00\u8D77\u5B66\u4E60\u54E6\u3002[VAR 0114(0025)]"
]
