  "\u770B\u6765\u6211\u8FD8\u6CA1\u6709\\n\u90A3\u4E48\u4E0D\u4E2D\u7528\u5427\uFF1F\\c\\n\u8C22\u8C22\u4F60\u548C\u6211\u5BF9\u6218\uFF0C\\n\u6211\u6253\u5F97\u5F88\u5F00\u5FC3\u3002[VAR 0114(0025)]",
  "\u5982\u679C\u6211\u5728\u84DD\u8393\u5B66\u56ED\\n\u628A\u5CA9\u77F3\u5C5E\u6027\u7684\u5389\u5BB3\u4E4B\u5904\u6559\u7ED9\u5927\u5BB6\uFF0C\\r\\n\u5C06\u6765\u7528\u5CA9\u77F3\u5C5E\u6027\u7684\u4EBA\u4F1A\u4E0D\u4F1A\u53D8\u591A\u5462\uFF1F[VAR 0114(0025)]",
  "\u5728\u84DD\u8393\u5B66\u56ED\\n\u6709\u79CD\u53EB\uFF22\uFF30\u7684\u8D27\u5E01\u5427\uFF1F\\r\\n\u4F3C\u4E4E\u80FD\u7528\u6765\u5F53\u505A\u6570\u5B66\u9898\u76EE\u5440\u3002[VAR 0114(0025)]",
  "\u521A\u521A\u6709\u4EBA\u628A\u6211\u8BA4\u6210\u6211\u59B9\u59B9\uFF0C\\n\u975E\u8981\u6211\u7B7E\u540D\u3002\\c\\n\u6211\u89C9\u5F97\u6211\u8DDF\u83B1\u59C6\\n\u662F\u4E00\u70B9\u90FD\u4E0D\u50CF\u554A\u2026\u2026[VAR 0114(0025)]",
  "[VAR 0100(0000)]\u7684[VAR 0101(0001)]\\n\u975E\u5E38\u4E56\u54E6\u3002\\c\\n\u5B83\u603B\u662F\u60A0\u95F2\u5730\u9A91\u5728\\n\u6211\u7684\u76D0\u77F3\u5DE8\u7075\u7684\u80A9\u8180\u4E0A\u3002[VAR 0114(0025)]",
  "\u6211\u4EA4\u6362\u7ED9\u4F60\u7684\u5CA9\u72D7\u72D7\u548C\u4F60\\n\u76F8\u5904\u5F97\u8FD8\u597D\u5417\uFF1F\\c\\n\u5CA9\u72D7\u72D7\u662F\u5C11\u89C1\u5730\u4F1A\u6839\u636E\u65F6\u95F4\u6BB5\\n\u8FDB\u5316\u6210\u4E0D\u540C\u6837\u5B50\u7684\u5B9D\u53EF\u68A6\u54E6\u3002[VAR 0114(0025)]"
