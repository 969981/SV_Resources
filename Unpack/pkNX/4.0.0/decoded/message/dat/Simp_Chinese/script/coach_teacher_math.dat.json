  "\u5927\u7EA6\uFF11\uFF12\uFF05",
  "\u54E6\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u771F\u53EF\u60DC\u554A\u3002\\c\\n\u6B63\u786E\u7B54\u6848\u662F\u5927\u7EA6\uFF14\uFF05\u3002\\n\u4F60\u8981\u597D\u597D\u60F3\u8D77\u6765\u554A\u3002[VAR 0114(0025)]",
  "\u6CA1\u9519\uFF01\u7B54\u5F97\u975E\u5E38\u597D\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01\\r\\n\u4F60\u5DF2\u7ECF\u719F\u7EC3\u638C\u63E1\u5B66\u8FC7\u7684\u77E5\u8BC6\u4E86\u554A\u3002[VAR 0114(0025)]",
  "\u8001\u5E08\u6211\u554A\u2026\u2026\\n\u5728\u84DD\u8393\u5B66\u56ED\u770B\u5230\u5B66\u751F\u4EEC\u5C31\u4F1A\u611F\u5230\u4E0D\u5B89\u3002[VAR 0114(0025)]",
  "\u8BFE\u7A0B\u5927\u90E8\u5206\u90FD\u662F\u5BF9\u6218\u5B66\u4E4B\u7C7B\\n\u8DDF\u80DC\u8D1F\u6709\u5173\u7684\u5185\u5BB9\u2026\u2026[VAR 0114(0025)]",
  "\u5C06\u6765\u80FD\u6D3B\u7528\u90A3\u4E9B\u77E5\u8BC6\\n\u627E\u5230\u76F8\u5173\u5DE5\u4F5C\u7684\u4EBA\u5012\u662F\u8FD8\u597D\u3002[VAR 0114(0025)]",
  "\u4F46\u662F\uFF0C\u5982\u679C\u68A6\u60F3\u7834\u706D\u4E86\u5462\u2026\u2026\uFF1F\\n\u5C82\u4E0D\u662F\u8FDE\u522B\u7684\u8DEF\u90FD\u8D70\u4E0D\u901A\u4E86\uFF1F[VAR 0114(0025)]",
  "\u6570\u5B66\u3001\u5BB6\u653F\u3001\u8BED\u8A00\u5B66\u2026\u2026\\n\u672A\u6765\u662F\u591A\u59FF\u591A\u5F69\u7684\u3002\\r\\n\u7406\u89E3\u8FD9\u4E00\u70B9\u662F\u81F3\u5173\u91CD\u8981\u7684\u554A\u3002[VAR 0114(0025)]",
