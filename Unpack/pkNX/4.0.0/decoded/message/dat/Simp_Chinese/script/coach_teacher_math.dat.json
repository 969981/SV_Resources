  "[~ 65]",
  "[VAR 0100(0000)]\uFF0C\u597D\u5389\u5BB3\u5440\uFF5E\uFF01\\n\u4F60\u771F\u7684\u5F88\u5F3A\u554A\u3002[VAR 0114(0025)]",
  "\u5C31\u7B97\u662F\u5168\u76DB\u671F\u7684\u6211\\n\u5E94\u8BE5\u4E5F\u65E0\u6CD5\u8D62\u8FC7\u4F60\u554A\u3002[VAR 0114(0025)]",
  "\u4F60\u613F\u610F\u63A5\u53D7\\n\u8001\u5E08\u6211\u7684\u4E00\u70B9\u5C0F\u5FC3\u610F\u5417\uFF1F[VAR 0114(0025)]",
  "\u5982\u679C\u8FD9\u80FD\u4E3A\u4F60\u7684\u5192\u9669\u6D3E\u4E0A\u7528\u573A\uFF0C\\n\u8001\u5E08\u6211\u4F1A\u5F88\u5F00\u5FC3\u7684\u3002[VAR 0114(0025)]",
