  "\u5728\u90A3\u4E4B\u540E\uFF0C\u6211\u76F4\u63A5\u53BB\u627E\\n\u84DD\u8393\u5B66\u56ED\u7684\u6821\u957F\u4EA4\u6D89\u4E86\uFF01\\r\\n\u6211\u8BF4\u5E0C\u671B\u4E5F\u80FD\u589E\u52A0\u5BF9\u6218\u5B66\u4E4B\u5916\u7684\u8BFE\u7A0B\uFF01[VAR 0114(0025)]",
  "\u7ED3\u679C\u5462\uFF1F",
  "\u597D\u63D0\u8BAE\uFF01",
  "\u201C\u867D\u7136\u57FA\u7840\u8BFE\u4E0D\u80FD\u6539\uFF0C\\n \u4F46\u5982\u679C\u662F\u6559\u9009\u4FEE\u8BFE\u7684\u8BDD\u5B8C\u5168\u53EF\u4EE5\uFF5E\u201D\\r\\n\u2026\u2026\u6821\u957F\u662F\u8FD9\u4E48\u8BF4\u7684\uFF01[VAR 0114(0025)]",
  "\u2026\u2026\u6362\u53E5\u8BDD\u8BF4\uFF0C\\n\u88AB[VAR 0100(0000)]\u4F60\u53EB\u6765\u5F53\u7279\u9080\u6559\u5458\uFF0C\\r\\n\u636E\u8BF4\u5176\u5B9E\u4E5F\u662F\u5176\u4E2D\u4E00\u73AF\u3002[VAR 0114(0025)]",
  "\u8001\u5E08\u6211\u592A\u5FC3\u6025\u5566\uFF01\\n\u54E6\u5475\u5475\u2026\u2026\u4E22\u8138\u4E86\u3002[VAR 0114(0025)]",
  "\u867D\u7136\u53C2\u52A0\u7684\u5B66\u751F\u6BD4\u8F83\u5C11\uFF0C\\n\u4F46\u8001\u5E08\u6211\u4F1A\u52AA\u529B\u4E0A\u597D\u6570\u5B66\u8BFE\u7684\u3002\\r\\n[VAR 0100(0000)]\uFF0C\u4F60\u8981\u4E3A\u6211\u52A0\u6CB9\u554A\u3002[VAR 0114(0025)]",
  "\u70E6\u607C\u89E3\u51B3\u540E\uFF0C\\n\u8001\u5E08\u6211\u677E\u4E86\u53E3\u6C14\u3002[VAR 0114(0025)]",
  "\u6211\u73B0\u5728\u5F88\u60F3\u505A\u4E9B\u7F8E\u597D\u7684\u4E8B\\n\u6765\u7597\u6108\u4E00\u4E0B\u81EA\u5DF1\u2026\u2026[VAR 0114(0025)]",
  "\u5BF9\u4E86\uFF0C[VAR 0100(0000)]\u3002\\n\u6211\u4EEC\u6765\u4EA4\u6362\u5B9D\u53EF\u68A6\u5427\uFF1F[VAR 0114(0025)]",
