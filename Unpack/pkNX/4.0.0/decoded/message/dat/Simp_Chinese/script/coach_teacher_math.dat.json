[
  "\u84DD\u8393\u5B66\u56ED\u7684\u5404\u4F4D\uFF0C\\n\u5F88\u9AD8\u5174\u8BA4\u8BC6\u5927\u5BB6\u3002[VAR 0114(0025)]",
