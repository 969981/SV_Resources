  "\u7ADF\u7136\u662F[VAR 0101(0001)]\u5440\uFF0C\u771F\u597D\uFF01\\n\u975E\uFF5E\u5E38\u7597\u6108\u554A\u3002\\c\\n\u8C22\u8C22\u4F60\u548C\u6211\u4EA4\u6362\u3002\\n\u6211\u4F1A\u597D\u597D\u57F9\u80B2\u5B83\u7684\u3002[VAR 0114(0025)]",
  "\u7528[VAR 0100(0000)]\u4F60\u7684[VAR 0101(0001)]\u548C\\n\u8001\u5E08\u6211\u7684\u5CA9\u72D7\u72D7\u4EA4\u6362\uFF0C\u53EF\u4EE5\u5417\uFF1F[VAR 0114(0025)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u54CE\u5440\uFF1F\u4F60\u7684\u540C\u884C\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u53EA\u6709\uFF11\u53EA\u554A\u3002\\c\\n\u8981\u4EA4\u6362\u7684\u8BDD\uFF0C\\n\u5FC5\u987B\u5F97\u6709\uFF12\u53EA\u4EE5\u4E0A\u7684\u540C\u884C\u5B9D\u53EF\u68A6\u54E6\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u4E0D\u4EA4\u6362\u4E86\u5417\uFF1F\\n\u8001\u5E08\u6211\u597D\u5BC2\u5BDE\u554A\u3002[VAR 0114(0025)]",
