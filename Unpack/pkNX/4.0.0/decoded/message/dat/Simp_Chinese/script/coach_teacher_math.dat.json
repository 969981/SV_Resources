  "\u867D\u7136\u8FD9\u5F88\u5510\u7A81\uFF0C\\n\u4F46\u7ED9[VAR 0100(0000)]\u4F60\u51FA\u4E2A\u590D\u4E60\u9898\u5982\u4F55\uFF1F[VAR 0114(0025)]",
  "\u901A\u5E38\u6765\u8BF4\uFF0C\u5B9D\u53EF\u68A6\u7684\u62DB\u5F0F\\n\u51FB\u4E2D\u8981\u5BB3\u7684\u6982\u7387\u662F\u591A\u5C11\uFF1F[VAR 0114(0025)]",
  "\u5927\u7EA6\uFF11\uFF05",
