  "\u90A3\u5947\u597D\uFF5E\u6211\u4EEC\u5C31\u8D76\u5FEB\\n\u6765\u573A\u52A8\u771F\u683C\u7684\u5BF9\u6218\u5427\uFF5E\uFF01\uFF1F[VAR 0114(0019)]",
  "[VAR 0100(0000)]\uFF01\\n\u4F60\u73B0\u5728\u60F3\u548C\u6211\u6765\u573A\u52A8\u771F\u683C\u7684\u5BF9\u6218\u5566\uFF5E\uFF01\uFF1F[VAR 0114(0019)]",
  "\u5F88\uFF5E\u597D\uFF01\u90A3\u6211\u4EEC\u5C31\\n\u524D\u5F80\u5BF9\u6218\u573A\u54AF\uFF5E\uFF01[VAR 0114(0019)]",
