[
  "\u7528\u7535\u7F51\u6355\u83B7\u9996\u5E2D\u7684\u773C\u7403\uFF01\\n\u8C01\u6765\u5947\u8FF0\uFF1F\u5947\u6811\u6765\u4E86\uFF01[VAR 0114(0019)]",
