  "\u54A6\uFF1F[VAR 0100(0000)]\u4F60\u662F\\n\u65B0\u7684\u51A0\u519B\uFF0C\u66FF\u9996\u5E2D\u6765\u7684\uFF01\uFF1F[VAR 0114(0019)]",
  "\u524D\u4E0D\u4E45\u4F60\u8FD9\u53EA\u9EBB\u9EBB\u5C0F\u9C7C\u8FD8\u5728\u53C2\u52A0\u9053\u9986\u6D4B\u9A8C\uFF0C\\n\u73B0\u5728\u4E00\u8DC3\u800C\u8D77\u53D8\u9EBB\u9EBB\u9CD7\u9C7C\u738B\u4E86\uFF5E\uFF01\uFF1F\u5389\u5BB3\uFF01\uFF01[VAR 0114(0019)]",
  "\u54A6\uFF5E\uFF1F\u4E5F\u5C31\u662F\u8BF4\uFF0C\\n\u5982\u679C\u73B0\u5728\u548C[VAR 0100(0000)]\u5408\u6F14\u7684\u8BDD\uFF0C\\r\\n\u6211\u7684\u4EBA\u6C14\u4E5F\u4F1A\u66F4\u52A0\u7206\u68DA\u2026\u2026\uFF1F\\r\\n\u563F\u563F\u2026\u2026\u563B\u563B\u563B\uFF01[VAR 0114(0019)]",
  "\u597D\uFF0C\u6211\u77E5\u9053\u4E86\uFF01\\nOKOK\uFF0C\u662F\u9171\u7D2B\u7684\u5267\u60C5\u554A\uFF5E\uFF01[VAR 0114(0019)]",
