[
  "\u73B0\u5728\u7684\u5929\u6C14\u5BF9\u4F60\u6765\u8BF4\u5F88\u5E78\u8FD0\u3002\\n\u662F\u96EA\u5C71\u5411\u4F60\u5C55\u9732\u4E86\u6E29\u60C5\u5417\uFF1F[VAR 0114(001A)]",
  "\u5BF9\u4F60\u6765\u8BF4\u771F\u662F\u7CDF\u7CD5\u900F\u9876\u3002\\n\u770B\u6765\u96EA\u5C71\u7AD9\u5728\u4E86\u6211\u8FD9\u4E00\u8FB9\u3002[VAR 0114(001A)]",
  "\u6BCF\u5E74\u90FD\u4F1A\u6709\u51E0\u6B21\\n\u50CF\u8FD9\u6837\u7684\u8054\u76DF\u89C6\u5BDF\u3002[VAR 0114(001A)]",
  "\u8FD9\u662F\u4E2A\u5982\u679C\u4E0D\u80FD\u53D1\u6325\u51FA\u79F0\u804C\u7684\u5B9E\u529B\uFF0C\\n\u5C31\u4F1A\u88AB\u64A4\u4E0B\u9053\u9986\u9986\u4E3B\u4E00\u804C\u7684\u6D4B\u9A8C\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u867D\u7136\u4E5F\u6148\u8BF4\\n\u8FD9\u662F\u4E2A\u8D70\u8FC7\u573A\u7684\u4E8B\u2026\u2026[VAR 0114(001A)]",
  "\u4F46\u5982\u679C\u6211\u5728\u5355\u677F\u6ED1\u96EA\u8FD9\u6761\u8DEF\u8D70\u5230\u5934\u540E\uFF0C\\n\u8FDE\u53D1\u6325\u5269\u4F59\u624D\u80FD\u7684\u673A\u4F1A\u4E5F\u88AB\u593A\u8D70\u7684\u8BDD\uFF0C\\r\\n\u7559\u7ED9\u6211\u7684\u8FD8\u5269\u4EC0\u4E48\u5462\uFF1F[VAR 0114(001A)]",
  "\u867D\u7136\u6211\u8BF4\u4E86\u4E9B\u6709\u70B9\u5C34\u51B7\u7684\u8BDD\u2026\u2026\\n\u4F46\u8FD9\u4E8B\u5176\u5B9E\u6CA1\u90A3\u4E48\u590D\u6742\u3002[VAR 0114(001A)]",
  "\u56E0\u4E3A\u6211\u53EA\u8981\u8BA9\u4F60\\n\u51BB\u5F97\u4F53\u65E0\u5B8C\u80A4\u5C31\u884C\u4E86\u3002[VAR 0114(001A)]",
  "\u4E5F\u6148\u4E5F\u771F\u662F\u7231\u5201\u96BE\u4EBA\uFF0C\\n\u7ADF\u7136\u4F1A\u5DEE\u4E00\u4E2A\u6211\u7EDD\u5BF9\u8D62\u4E0D\u4E86\u7684\u4EBA\u6765\u3002[VAR 0114(001A)]",
  "\u4E0D\u8FC7\uFF0C\u6211\u4E0D\u540E\u6094\u3002\\n\u6211\u81EA\u8BA4\u4E3A\u53D1\u6325\u51FA\u4E86\u5168\u90E8\u5B9E\u529B\u3002[VAR 0114(001A)]",
  "\u6211\u52A8\u771F\u683C\u5730\u5411\u4F60\u6311\u6218\u5374\u8F93\u4E86\u2026\u2026\\n\u8FD9\u8BA9\u6211\u611F\u5230\u5F88\u4E0D\u7518\u5FC3\u3002[VAR 0114(001A)]",
  "\u6211\u60F3\u66F4\u8BA4\u771F\u4E00\u70B9\u5730\\n\u5F53\u9053\u9986\u9986\u4E3B\u4E86\u3002[VAR 0114(001A)]",
  "\u4F60\u8BA9\u6211\u5B8C\u5168\u51B7\u5374\u7684\u70ED\u60C5\\n\u53C8\u91CD\u65B0\u71C3\u70E7\u4E86\u8D77\u6765\u3002\\r\\n\u2026\u2026\u8C22\u8C22\u4F60\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(001A)]",
  "\u4E0B\u6B21\u5BF9\u6218\u65F6\u6211\u4E0D\u4F1A\u8F93\u7684\u3002[VAR 0114(001A)]",
  "\u4E0B\u96EA\u5C71\u65F6\u8981\u591A\u52A0\u5C0F\u5FC3\uFF0C\\n\u4E0D\u8981\u611F\u5192\u554A\u3002[VAR 0114(001A)]"
]
