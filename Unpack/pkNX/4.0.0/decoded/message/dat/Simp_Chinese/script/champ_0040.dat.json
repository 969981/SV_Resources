[
  "\u54A6\uFF1F[VAR 0100(0000)]\uFF01\uFF1F[VAR 0114(0004)]",
  "\u7ADF\u7136\u53C8\u5728\u540C\u4E00\u4E2A\u9053\u9986\u9047\u5230\u4E86\u4F60\uFF01\\n\u771F\u662F\u8D85\uFF5E\u6709\u7F18\uFF01\\r\\n\u4E5F\u592A\uFF5E\u5DE7\u4E86\u5427\u2026\u2026[VAR 0114(0004)]",
  "\u6211\u53EF\u4E0D\u662F\u60F3\u5BF9\u6218\u6240\u4EE5\u63D0\u524D\u5728\u8FD9\u513F\u7B49\u4F60\uFF01\\n\u2026\u2026\u4F60\u53EF\u4E0D\u8981\u8BEF\u4F1A\u54E6\uFF01[VAR 0114(0004)]",
  "\u6211\u6CA1\u9A97\u4F60\uFF01\u6211\u8FD9\u6B21\u4E0D\u548C\u4F60\u5BF9\u6218\uFF0C\\n\u8FD9\u4E0B\u4F60\u8BE5\u4FE1\u4E86\u5427\uFF1F\\r\\n\u2026\u2026\u2026\u2026\u5176\u5B9E\u6211\u5F88\u60F3\u548C\u4F60\u5BF9\u6218\u5C31\u662F\u4E86\u3002[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u6BD4\u4E0A\u4E00\u6B21\u66F4\u5F3A\u4E86\u2026\u2026\uFF01[VAR 0114(0004)]",
  "\u7136\u540E\uFF0C\u518D\u6709\u8FD9\u4E2A\u7684\u8BDD\uFF0C\\n\u5C31\u80FD\u51C6\u5907\u5C31\u7EEA\u4E86\uFF01[VAR 0114(0004)]",
  "\u6211\u4F1A\u4E00\u8FB9\u953B\u70BC\uFF12\uFF10\u6765\u53EA\u5B9D\u53EF\u68A6\uFF0C\\n\u4E00\u8FB9\u4E3A\u4F60\u52A0\u6CB9\u7684\uFF5E\uFF01[VAR 0114(0004)]"
