  "\u5173\u4E8E\u624B\u5957\u7684\u7B54\u590D\u2026\u2026\\n\u6211\u4F1A\u8010\u5FC3\u7B49\u5019\u4F60\u7684\u3002[VAR 0114(0011)]",
  "\u80FD\u770B\u5230\u4F60\u8FD9\u6837\u7684\u80FD\u4EBA\u5931\u8D25\uFF0C\\n\u771F\u662F\u7F55\u89C1\u3002\\c\\n\u8BF7\u4F60\u4E0B\u6B21\\n\u4E00\u5B9A\u8981\u6218\u80DC\u6211\u3002[VAR 0114(0011)]",
  "\u6A21\u4EFF\u5B9D\u53EF\u68A6\u8054\u76DF\u7684\u793E\u56E2\uFF0C\\n\u8FD9\u4E2A\u60F3\u6CD5\u771F\u7684\u5341\u5206\u8010\u4EBA\u5BFB\u5473\u3002\\c\\n\u8BA9\u6211\u548C\u514B\u62C9\u97E6\u5C14\u5546\u91CF\u4E00\u4E0B\uFF0C\\n\u770B\u80FD\u4E0D\u80FD\u628A\u540C\u6837\u7684\u4E8B\u4E5F\u5BFC\u5165\u5B66\u9662\u5427\u3002[VAR 0114(0011)]",
  "\u6211\u4E5F\u66FE\u591A\u6B21\\n\u9020\u8BBF\u96F6\u533A\u7814\u7A76\u6240\u3002\\c\\n\u4F46\u5B8C\u5168\u6CA1\u60F3\u5230\u8981\u5C06\\n\u84DD\u4E4B\u5149\u789F\u653E\u8FDB\u5165\u53E3\u7684\u9762\u677F\u5185\u3002\\c\\n\u5475\u5475\u2026\u2026\u4F60\u679C\u7136\u662F\u4E2A\\n\u80FD\u8F7B\u6613\u8D85\u51FA\u6211\u60F3\u8C61\u7684\u4EBA\u3002[VAR 0114(0011)]",
  "\u84DD\u8393\u5B66\u56ED\u7684\u5165\u53E3\u5F88\u6709\u72EC\u521B\u6027\uFF0C\\n\u8BBE\u8BA1\u5F97\u975E\u5E38\u5DE7\u5999\u3002\\c\\n\u5F53\u7136\uFF0C\u6211\u8BA4\u4E3A\u5B66\u9662\u7684\u5165\u53E3\\n\u4E5F\u6BEB\u4E0D\u900A\u8272\u5C31\u662F\u4E86\u3002[VAR 0114(0011)]",
  "\u51A0\u519B[VAR 0100(0000)]\u4F60\\n\u4EA4\u6362\u7ED9\u6211\u7684[VAR 0101(0001)]\u2026\u2026\\c\\n\u5B83\u548C\u4F60\u5F88\u50CF\uFF0C\\n\u62E5\u6709\u4E86\u4E0D\u8D77\u7684\u624D\u80FD\u3002[VAR 0114(0011)]",
