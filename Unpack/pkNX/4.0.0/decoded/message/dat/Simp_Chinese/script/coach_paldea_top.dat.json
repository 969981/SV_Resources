  "\u4E4C\u6817\uFF01\\n\u662F\u84DD\u8393\u8054\u76DF\u7684\u524D\u51A0\u519B\u554A\u3002\\c\\n\u4ED6\u8FD8\u524D\u53BB\u8C03\u67E5\u4E86\u5DE8\u5751\uFF0C\\n\u662F\u4E2A\u5B9E\u529B\u51FA\u4F17\u7684\u4EBA\u2026\u2026\\c\\n\u5982\u679C\u4ED6\u4E0E\u51A0\u519B[VAR 0100(0000)]\u4F60\u7684\\n\u4EA4\u60C5\u8DB3\u591F\u6DF1\u539A\uFF0C\\r\\n\u6216\u8BB8\u4F1A\u613F\u610F\u524D\u5F80\u5E15\u5E95\u4E9A\uFF1F[VAR 0114(0011)]",
  "\u4E39\u745C\uFF01\\n\u662F\u524D\u53BB\u8C03\u67E5\u4E86\u5DE8\u5751\u7684\u6210\u5458\u554A\u3002\\c\\n\u5728\u90A3\u4E4B\u524D\u5979\u4E5F\u548C\u767D\u857E\u96C5\\n\u5230\u6821\u5916\u8FDB\u884C\u8FC7\u8FDC\u5F81\uFF0C\u7ECF\u9A8C\u4E30\u5BCC\u2026\u2026\\c\\n\u5982\u679C\u5979\u4E0E\u51A0\u519B[VAR 0100(0000)]\u4F60\u7684\\n\u4EA4\u60C5\u8DB3\u591F\u6DF1\u539A\uFF0C\\r\\n\u6216\u8BB8\u4F1A\u613F\u610F\u524D\u5F80\u5E15\u5E95\u4E9A\uFF1F[VAR 0114(0011)]",
  "\u8D64\u677E\uFF01\\n\u662F\u84DD\u8393\u8054\u76DF\u7684\u56DB\u5929\u738B\u554A\u3002\\c\\n\u56E0\u4E3A\u5728\u5B9D\u53EF\u68A6\u8054\u76DF\u4E2D\\n\u6CA1\u6709\u4E13\u7CBE\u706B\u5C5E\u6027\u7684\u4EBA\uFF0C\\r\\n\u6240\u4EE5\u4ED6\u8BA9\u4EBA\u611F\u89C9\u5F88\u65B0\u9C9C\u3002[VAR 0114(0011)]",
  "\u7EB3\u8389\uFF01\\n\u662F\u84DD\u8393\u8054\u76DF\u7684\u56DB\u5929\u738B\u554A\u3002\\c\\n\u65E2\u7136\u5979\u662F\u4E13\u7CBE\u94A2\u5C5E\u6027\u7684\u8BAD\u7EC3\u5BB6\uFF0C\\n\u611F\u89C9\u5E94\u8BE5\u80FD\u548C\u6CE2\u7435\u76F8\u5904\u5F97\u5F88\u597D\u3002\\c\\n\u800C\u5979\u51ED\u501F\u51B7\u9759\u7684\u6027\u683C\u6240\u7F16\u7EC7\u51FA\u7684\u6218\u7565\uFF0C\\n\u6216\u8BB8\u4F1A\u5728\u5E15\u5E95\u4E9A\u53D1\u5149\u53D1\u4EAE\uFF1F[VAR 0114(0011)]",
