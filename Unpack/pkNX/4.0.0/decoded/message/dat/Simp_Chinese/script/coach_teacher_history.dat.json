  "\u600E\u4E48\u8FD9\u6837\u2026\u2026",
  "\u6211\u660E\u767D\u4E86\uFF01",
  "\u5475\u5475\u5475\uFF01\u8FD9\u662F\u4F60\u81EA\u5DF1\u57CB\u4E0B\u7684\u79CD\u5B50\uFF0C\\n\u4F60\u5C31\u597D\u597D\u7948\u7977\u4E30\u6536\u5427\u3002[VAR 0114(0027)]",
  "\u54CE\u5440\uFF1F\u60F3\u4E0D\u5230\u4F60\u8FD9\u4E48\u987A\u4ECE\u3002\\n\u5475\u5475\u5475\u2026\u2026\u53EF\u771F\u662F\u7701\u5FC3\u3002[VAR 0114(0027)]",
  "\u90A3\u4E48\uFF0C\u8981\u8BA9\u4F60\u6210\u4E3A\\n\u4EC0\u4E48\u6837\u7684\u5080\u5121\u4F9B\u6211\u64CD\u7EB5\u5462\u2026\u2026\\r\\n\u6211\u4ECE\u73B0\u5728\u5C31\u5F00\u59CB\u671F\u5F85\u4E86\u3002[VAR 0114(0027)]",
  "\u600E\u4E48\uFF0C\u662F\u4F60\u554A\u3002\\n\u4F60\u6BD4\u4EE5\u524D\u53E4\u8001\u7684\u8FD9\u51E0\u5929\u53C8\u6210\u4E86\u5386\u53F2\u3002[VAR 0114(0027)]",
  "\u4E4B\u524D\u6211\u867D\u7136\u4E0D\u60C5\u4E0D\u613F\u5730\u8FDC\u5F81\u6765\u8FD9\u91CC\uFF0C\\n\u4F46\u73B0\u5728\u4E00\u60F3\uFF0C\u8FD9\u91CC\u662F\u5408\u4F17\u5730\u533A\u2026\u2026\\r\\n\u662F\u79EF\u6DC0\u4E86\u60A0\u4E45\u5386\u53F2\u7684\u5B9D\u5E93\u554A\uFF01[VAR 0114(0027)]",
  "\u5176\u4E2D\uFF0C\u6C89\u7761\u5728\u6D77\u5E95\u7684\u53E4\u8001\u9057\u8FF9\\n\u771F\u662F\u4EE4\u4EBA\u597D\u5947\u5FC3\u6D0B\u6EA2\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u5728\u8FD9\u91CC\u7684\u8BDD\uFF0C\\n\u6821\u957F\u4E5F\u770B\u7BA1\u4E0D\u5230\uFF0C\u53EF\u771F\u662F\u7701\u5FC3\u3002[VAR 0114(0027)]",
  "\u5F85\u4F1A\u6211\u5C31\u8BA9\u5B9D\u53EF\u68A6\u5E26\u6211\\n\u201C\u54DF\u5475\uFF5E\uFF01\u201D\u5730\u6E38\u5230\u90A3\u91CC\u63A2\u7D22\u5427\uFF01[VAR 0114(0027)]",
  "\u597D\u50CF\u5F88\u6709\u8DA3\uFF01",
  "\u6CE8\u610F\u5B89\u5168",
  "\u5475\u5475\u5475\uFF01\\n\u6211\u5FCD\u4E0D\u4F4F\u8981\u597D\u597D\u4EAB\u53D7\u4E00\u756A\u4E86\uFF01\\c\\n\u80FD\u53D7\u5230\u8003\u53E4\u5F0F\u601D\u8003\u7684\u523A\u6FC0\\n\u53EF\u662F\u65E0\u53EF\u66FF\u4EE3\u7684\u73CD\u5B9D\u3002[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C\u4E0D\u5FC5\u62C5\u5FC3\u3002\\c\\n\u5982\u679C\u80FD\u5728\u9057\u8FF9\u548C\u9057\u7269\u7684\\n\u5305\u56F4\u4E0B\u7ED3\u675F\u751F\u6DAF\uFF0C\u6B64\u751F\u65E0\u61BE\u3002[VAR 0114(0027)]",
  "\u554A\uFF0C\u554A\u554A\u2026\u2026\\n[VAR 0100(0000)]\u2026\u2026\u662F\u4F60\u554A\u2026\u2026[VAR 0114(0027)]",
  "\u4F60\u600E\u4E48\u4E86\uFF1F",
  "\u4F60\u611F\u89C9\u4E0D\u592A\u597D\u5417\uFF1F",
  "\u4F60\u770B\u4E0D\u51FA\u6765\u5417\uFF1F\\n\u6211\u592A\u6EE1\u8DB3\u4E86\uFF0C\u73B0\u5728\u6709\u4E9B\u75B2\u4E4F\u3002[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C\u4E0D\uFF0C\u6B63\u76F8\u53CD\u2026\u2026\\n\u6211\u592A\u6EE1\u8DB3\u4E86\uFF0C\u73B0\u5728\u6709\u4E9B\u75B2\u4E4F\u3002[VAR 0114(0027)]",
  "\u6628\u5929\u6211\u8BA9\u9713\u8679\u9C7C\u5E26\u6211\u6E38\u5230\u4E86\\n\u5408\u4F17\u7684\u6D77\u5E95\u9057\u8FF9\u2026\u2026[VAR 0114(0027)]",
  "\u90A3\u91CC\u592A\u2026\u2026\u592A\u68D2\u4E86\u2026\u2026\\n\u5B9E\u5728\u662F\u2026\u2026\u592A\u7F8E\u5999\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u963B\u6321\u5165\u4FB5\u8005\u7684\u53E4\u8001\u88C5\u7F6E\uFF01\\n\u8BB0\u8F7D\u5728\u5899\u58C1\u4E0A\u7684\u53E4\u4EE3\u6587\u5B57\uFF01[VAR 0114(0027)]",
  "\u548C\u53E4\u4EE3\u7684\u4EBA\u4EEC\u6597\u667A\uFF0C\\n\u610F\u4E49\u6DF1\u523B\uFF0C\u582A\u79F0\u7F8E\u5999\uFF01[VAR 0114(0027)]",
  "\u4F46\u662F\u4E00\u53E3\u6C14\u5230\u8FBE\u9057\u8FF9\u6700\u6DF1\u5904\\n\u4F1A\u6D6A\u8D39\u8FD9\u4E2A\u96BE\u5F97\u7684\u673A\u4F1A\u3002\\r\\n\u6211\u6253\u7B97\u6162\u6162\u5730\u63A2\u7D22\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u5BF9\u4E86\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u60F3\u51FA\u4E00\u4E2A\u597D\u4E3B\u610F\u3002[VAR 0114(0027)]",
  "\u6211\u8BB0\u5F97\u4F60\u662F\u51A0\u519B\uFF0C\u5BF9\u5427\u2026\u2026\\n\u4F60\u8981\u4E0D\u8981\u548C\u6211\u4EA4\u6362\u5B9D\u53EF\u68A6\uFF1F[VAR 0114(0027)]",
  "\u53EA\u8981\u662F\u51A0\u519B\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u4E0D\u7BA1\u662F\u54EA\u53EA\u5E94\u8BE5\u90FD\u5F88\u80FD\u5E72\u3002\\r\\n\u5C31\u548C\u6211\u7684\u7D22\u8D22\u7075\u4EA4\u6362\u2026\u2026\u5982\u4F55\uFF1F[VAR 0114(0027)]",
  "\u597D\uFF0C\u4F60\u5C31\u9009\u4E00\u9009\u5B9D\u53EF\u68A6\u5427\u3002\\n\u6700\u597D\u80FD\u9009\u4E00\u79CD\u6709\u52A9\u4E8E\u63A2\u7D22\u7684\u3002[VAR 0114(0027)]",
  "\u55EF\uFF0C\u8FD9\u4E2A\u4EA4\u6362\u5F88\u68D2\u3002\\c\\n\u4F60\u7684[VAR 0101(0001)]\u2026\u2026\\n\u6211\u4F1A\u597D\u597D\u75BC\u7231\u5B83\u7684\u3002[VAR 0114(0027)]",
  "\u786E\u5B9A\u662F\u7528\u4F60\u7684[VAR 0101(0001)]\u548C\\n\u6211\u7684\u7D22\u8D22\u7075\u6765\u4EA4\u6362\u5417\uFF1F[VAR 0114(0027)]",
  "\u65E0\u6CD5\u4F7F\u7528\u521D\u8BAD\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\\n\u5B9D\u53EF\u68A6\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u7A00\u6709\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u65E0\u6CD5\u4F7F\u7528\u5F02\u8272\u5B9D\u53EF\u68A6\\n\u8FDB\u884C\u4EA4\u6362\u3002",
  "\u2026\u2026\u4F60\u624B\u4E0A\u80FD\u591F\u884C\u52A8\u7684\\n\u5B9D\u53EF\u68A6\u597D\u50CF\u53EA\u6709\uFF11\u53EA\u554A\u3002\\c\\n\u529D\u4F60\u5148\u5E26\u7740\uFF12\u53EA\u4EE5\u4E0A\u540C\u884C\u5B9D\u53EF\u68A6\\n\u518D\u6B23\u7136\u63A5\u53D7\u8FD9\u6B21\u4EA4\u6362\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u53D8\u5366\u5728\u5386\u53F2\u4E0A\u4E5F\u662F\u5E38\u6709\u4E4B\u4E8B\u3002\\n\u5C31\u8BA9\u6211\u62B1\u7740\u671F\u5F85\u7B49\u4F60\u5427\u3002[VAR 0114(0027)]",
  "\u90A3\u5C31\u7528\u4F60\u6240\u62E5\u6709\u7684\u5B9D\u53EF\u68A6\u548C\\n\u6211\u6240\u62E5\u6709\u7684\u7D22\u8D22\u7075\\r\\n\u6765\u4EA4\u6362\u5427\u3002[VAR 0114(0027)]",
  "\u4E00\u76F4\u5F85\u5728\u5BA4\u5185\u7684\u8BDD\uFF0C\\n\u6211\u4F1A\u53D7\u4E0D\u4E86\u8FD9\u65B0\u9C9C\u7684\u6C14\u5473\u2026\u2026\\r\\n\u5C31\u5F53\u662F\u8F6C\u6362\u5FC3\u60C5\uFF0C\u53BB\u5916\u9762\u5BF9\u6218\u5427\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026\u6CA1\u60F3\u5230\u4F60\u8FD9\u4E48\u6CA1\u5174\u81F4\u554A\u3002\\n\u90A3\u6211\u4E00\u4E2A\u4EBA\u53BB\u8F6C\u6362\u5FC3\u60C5\u4E86\u3002[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C\u591A\u4E48\u5584\u826F\u7684\u5B69\u5B50\u3002\\n\u90A3\u6211\u4EEC\u5C31\u5954\u8D74\u6C99\u573A\u5427\u3002[VAR 0114(0027)]",
  "[~ 59]",
  "\u2026\u2026\u771F\u6CA1\u60F3\u5230\u4F60\u8FD9\u4E48\u96BE\u5BF9\u4ED8\u3002\\n\u770B\u6765\u4F60\u4E00\u8DEF\u8D70\u7684\u90FD\u662F\u738B\u9053\u554A\u3002[VAR 0114(0027)]",
  "\u5982\u679C\u2026\u2026\u80FD\u5229\u7528\u4F60\u90A3\u4EFD\u5B9E\u529B\uFF0C\\n\u90A3\u5404\u79CD\u5404\u6837\u7684\u9057\u8FF9\u548C\u575F\u5893\u2026\u2026\\r\\n\u6211\u5C31\u90FD\u80FD\u5C3D\u60C5\u8C03\u67E5\u4E86\u2026\u2026\u4E0D\u662F\u5417\uFF01\uFF1F[VAR 0114(0027)]",
  "\u597D\u2026\u2026\u8BA9\u6211\u9017\u4E00\u9017\u4F60\uFF0C\\n\u8FD9\u4E2A\u996F\u522B\u793C\u5C31\u8D4F\u7ED9\u4F60\u4E86\u3002[VAR 0114(0027)]",
  "\u90A3\u53EF\u662F\u4EF7\u503C\u6781\u9AD8\u7684\u4E1C\u897F\u3002\\n\u4F60\u5C31\u6BCF\u665A\u4E00\u8FB9\u611F\u8C22\u857E\u8377\u8001\u5E08\uFF0C\\r\\n\u4E00\u8FB9\u51DD\u671B\u5B83\u5427\u3002[VAR 0114(0027)]",
  "[~ 59]",
  "\u5475\u5475\u5475\uFF0C\u4F60\u90A3\u4EFD\u5B9E\u529B\\n\u679C\u7136\u5927\u6709\u7528\u5904\u3002\\c\\n\u8FD9\u6B21\u4E5F\u8D4F\u4F60\u8BF1\u9975\u2026\u2026\\n\u54E6\u4E0D\uFF0C\u6211\u662F\u8BF4\u8D4F\u4F60\u996F\u522B\u793C\u3002[VAR 0114(0027)]",
  "\u5E0C\u671B\u4F60\u548C\u857E\u8377\u8001\u5E08\u6211\u4E00\u540C\u5B55\u80B2\u7684\u5386\u53F2\\n\u80FD\u591F\u6210\u4E3A\u4E0D\u53EF\u66FF\u4EE3\u7684\u5B58\u5728\u3002[VAR 0114(0027)]",
  "\u5373\u4F7F\u4F60\u6709\u5B9E\u529B\uFF0C\u4E00\u65E6\u50B2\u6162\u8D77\u6765\uFF0C\\n\u5C31\u4F1A\u88AB\u653B\u5176\u4E0D\u5907\u5BFC\u81F4\u8D25\u5317\u2026\u2026\\c\\n\u4F60\u96BE\u9053\u662F\u60F3\u4EB2\u81EA\u4F53\u9A8C\\n\u5386\u53F2\u6027\u7684\u53CD\u8F6C\u5267\u5417\uFF1F[VAR 0114(0027)]",
  "\u4F60\u80FD\u9A7E\u9A6D\u707E\u7978\u4E4B\u5B9D\u4E86\u5417\uFF1F\\c\\n\u8981\u662F\u60F3\u653E\u624B\u7684\u8BDD\uFF0C\\n\u53EF\u4EE5\u9A6C\u4E0A\u6765\u627E\u6211\u5546\u91CF\u54E6\u3002[VAR 0114(0027)]",
  "\u4F60\u771F\u7684\u8FDB\u53BB\u8FC7\\n\u5E15\u5E95\u4E9A\u5DE8\u5751\u5417\uFF1F\\c\\n\u5982\u679C\u662F\u771F\u7684\uFF0C\u90A3\u6211\u53EF\u8981\u62D8\u7559\u4F60\u51E0\u5929\uFF0C\\n\u597D\u628A\u4E8B\u60C5\u76D8\u95EE\u4E2A\u4E00\u6E05\u4E8C\u695A\u2026\u2026[VAR 0114(0027)]",
  "\u751F\u6001\u5DE8\u86CB\u7684\u786E\u662F\\n\u975E\u5E38\u4F18\u79C0\u7684\u6280\u672F\u2026\u2026\\c\\n\u4F46\u6211\u4E2A\u4EBA\u5BF9\u8FD9\u79CD\u7F3A\u4E4F\u5386\u53F2\uFF0C\\n\u5E76\u4E14\u88AB\u626D\u66F2\u7684\u81EA\u7136\u6BEB\u65E0\u5174\u8DA3\u3002[VAR 0114(0027)]",
  "\u4F60\u7684[VAR 0101(0001)]\\n\u786E\u5B9E\u662F\u5F88\u80FD\u5E72\u3002\\r\\n\u5B83\u5728\u6211\u8C03\u67E5\u9057\u8FF9\u65F6\u6D3E\u4E0A\u7528\u573A\u4E86\u54E6\u3002[VAR 0114(0027)]",
  "\u6211\u7684\u5174\u8DA3\u662F\\n\u6536\u96C6\u53E4\u8001\u7684\u4E1C\u897F\u3002\\c\\n\u4F60\u63A5\u624B\u7684\u7D22\u8D22\u7075\u4EE5\u524D\u4F1A\\n\u5411\u6211\u7D22\u8981\u53E4\u94B1\uFF0C\u8BA9\u6211\u5F88\u5934\u75DB\u3002[VAR 0114(0027)]"
]
