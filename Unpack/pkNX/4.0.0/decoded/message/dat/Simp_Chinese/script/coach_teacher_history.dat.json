[
  "\u8FD9\u5EA7\u6821\u820D\u2026\u2026\\n\u5145\u6EE1\u4E86\u65B0\u9C9C\u7684\u6C14\u606F\u3002[VAR 0114(0027)]",
  "[VAR 0100(0000)]\uFF0C\u662F\u4F60\u5417\uFF1F\\n\u53EB\u6211\u6765\u8FD9\u513F\u7684\u4EBA\u2026\u2026[VAR 0114(0027)]",
  "\u7ADF\u7136\u9080\u8BF7\u6211\u6765\u65B0\u7684\u5EFA\u7B51\u7269\uFF0C\\n\u4F60\u8EAB\u4EFD\u4E0D\u4E00\u822C\u554A\uFF01[VAR 0114(0027)]",
  "\u6211\u672C\u6765\u4E00\u70B9\u5174\u8DA3\u90FD\u6CA1\u6709\uFF0C\\n\u662F\u770B\u5728\u4F60\u7684\u9762\u5B50\u4E0A\u624D\u6765\u7684\u3002[VAR 0114(0027)]",
