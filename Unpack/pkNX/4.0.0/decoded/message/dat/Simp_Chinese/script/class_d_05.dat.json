  "\u6240\u4EE5\uFF0C\u5C31\u7B97\u662F\u76F8\u540C\u5B9D\u53EF\u68A6\u7684\u8BED\u8A00\uFF0C\\n\u53D1\u97F3\u4E5F\u4F1A\u968F\u7740\u4F7F\u7528\u65F6\u673A\u800C\u6709\u6240\u4E0D\u540C\uFF01[VAR 0114(0026)]",
