[
  "\u671F\u4E2D\u8003\u8BD5\u8F9B\u82E6\u5566\uFF01\\n\u5927\u5BB6\u90FD\u8003\u5F97\u5F88\uFF5E\u4E0D\u9519\uFF5E\u54E6\uFF01[VAR 0114(0026)]",
