[
  "\u54E6\uFF0C\u662F\u540C\u5B66\u4F60\u554A\uFF01\\n\u96BE\u9053\u2026\u2026[VAR 0114(0046)]",
  "\u4F60\u5728\u5317\u4E0A\u4E61\u6355\u6349\u5230\uFF11\uFF15\uFF10\u79CD\u4EE5\u4E0A\u7684\\n\u5B9D\u53EF\u68A6\u4E86\u554A\uFF01\u633A\u5389\u5BB3\u561B\uFF5E\uFF01[VAR 0114(0046)]",
  "\u6CA1\u9519\uFF0C\u6211\u5F88\u5389\u5BB3\u54E6\uFF01",
  "\u4F60\u8FC7\u5956\u4E86\u2026\u2026",
  "\u771F\u5389\u5BB3\uFF0C\u771F\u5389\u5BB3\uFF01\\n\u5F88\u80FD\u5E72\u561B\uFF0C\u5E74\u8F7B\u4EBA\uFF5E\uFF01[VAR 0114(0046)]",
  "\u554A\u54C8\u54C8\uFF01\\n\u4F60\u8981\u81EA\u4FE1\u70B9\u54E6\uFF0C\u5E74\u8F7B\u4EBA\uFF5E\uFF01[VAR 0114(0046)]",
  "\u611F\u89C9\u4F60\u6BD4\u66F4\u65E9\u6765\u5230\u8FD9\u91CC\u7684\u6211\\n\u90FD\u66F4\u4E86\u89E3\u5317\u4E0A\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01[VAR 0114(0046)]",
  "\u2026\u2026\u5BF9\u4E86\uFF01\u540C\u5B66\uFF01[VAR 0114(0046)]",
  "\u6211\u6709\u4E8B\u60F3\u62DC\u6258\u4F60\u8FD9\u4F4D\\n\u6355\u6349\u5B9D\u53EF\u68A6\u7684\u9AD8\u624B\uFF01[VAR 0114(0046)]",
  "\u6709\u4E8B\u60F3\u62DC\u6258\uFF1F",
  "\u6211\u6CA1\u5174\u8DA3\u2026\u2026",
  "\u5F88\u597D\uFF01\u6211\u5F88\u6B23\u8D4F\\n\u4F60\u90A3\u5145\u6EE1\u597D\u5947\u5FC3\u7684\u7CBE\u795E\uFF01\\r\\n\u90A3\u4E48\uFF5E\u5C31\u8BA9\u6211\u6765\u8BF4\u660E\u4E00\u4E0B\u5427\u3002[VAR 0114(0046)]",
  "\u540C\u5B66\uFF01\u5076\u5C14\u7ED5\u7ED5\u8DEF\\n\u4E5F\u662F\u5F88\u91CD\u8981\u7684\u54E6\uFF01\\r\\n\u2026\u2026\u90A3\u4E48\u6211\u8981\u8BF4\u660E\u54AF\u3002[VAR 0114(0046)]",
  "\u6211\u4E4B\u6240\u4EE5\u4F1A\u6765\u5317\u4E0A\uFF0C\\n\u662F\u56E0\u4E3A\u60F3\u627E\u51FA\u67D0\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\r\\n\u5E76\u62CD\u4E0B\u5B83\u7684\u7167\u7247\u3002[VAR 0114(0046)]",
  "\u6211\u4E00\u76F4\u5728\u72EC\u81EA\u4E00\u4EBA\u5BFB\u627E\u5B83\uFF0C\\n\u4F46\u5B8C\uFF5E\u5168\u627E\u4E0D\u5230\uFF01[VAR 0114(0046)]",
  "\u2026\u2026\u6240\u4EE5\uFF01\u5982\u679C\u540C\u5B66\u4F60\\n\u80FD\u548C\u6211\u4E00\u8D77\u627E\u5B83\uFF0C\\r\\n\u6211\u4F1A\u5341\u5206\u611F\u6FC0\u7684\u2026\u2026[VAR 0114(0046)]",
  "\u800C\u4E14\u6211\u8FD8\u542C\u8BF4\uFF0C\\n\u6211\u5728\u5BFB\u627E\u7684\u5B9D\u53EF\u68A6\u76F8\u5F53\u5F3A\u3002[VAR 0114(0046)]",
  "\u5982\u679C\u4F60\u80FD\u6349\u4F4F\u5B83\uFF0C\u5B83\u53EF\u80FD\u4F1A\\n\u6210\u4E3A\u4F60\u65C5\u9014\u4E2D\u53EF\u9760\u7684\u4F19\u4F34\u54E6\u3002[VAR 0114(0046)]",
  "\u5982\u679C\u4F60\u6709\u5174\u8DA3\u4E00\u8D77\u627E\uFF0C\\n\u5C31\u8BA9\u6211\u89C1\u8BC6\u4E00\u4E0B\u4F60\u6709\u591A\u5F3A\u5427\uFF01[VAR 0114(0046)]",
  "\u6BD5\u7ADF\u662F\u8981\u6210\u4E3A\u6211\u7684\u642D\u6863\uFF0C\\n\u6211\u60F3\u5148\u4E86\u89E3\u4E00\u4E0B\u4F60\u7684\u5B9E\u529B\u3002\\r\\n\u800C\u4E14\u6211\u8FD8\u60F3\u62CD\u4E0B\u4F60\u7684\u82F1\u59FF\u3002[VAR 0114(0046)]"
