  "\u5728\u5317\u4E0A\u4E61\u56DB\u5904\u8D70\u8D70\uFF0C\\n\u5BFB\u627E\u5B9D\u53EF\u68A6\u5427\uFF01\\c\\n\u5B9D\u53EF\u68A6\u4F1A\u51FA\u73B0\u5728\u8349\u4E1B\u548C\u6D1E\u7A9F\u7B49\\n\u5404\u79CD\u5404\u6837\u7684\u5730\u65B9\u54E6\uFF01\\c",
  "\u8FD8\u6709\u4E0D\u5C11\u5B9D\u53EF\u68A6\\n\u53EA\u80FD\u901A\u8FC7\u4EA4\u6362\u9047\u5230\uFF01\\c\\n\u8BD5\u8BD5\u4E0E\u5176\u4ED6\u5B66\u6821\u7684\u8BAD\u7EC3\u5BB6\\n\u4EA4\u6362\u5B9D\u53EF\u68A6\u770B\u770B\u5427\uFF01\\c",
  "\u8FD8\u5DEE\u4E00\u70B9\u5C31\u80FD\\n\u5B8C\u6210\u5317\u4E0A\u56FE\u9274\u4E86\uFF01\\c\\n[VAR 0100(0000)]\u4F60\\n\u7EDD\u5BF9\u80FD\u591F\u5B8C\u6210\u7684\uFF01\\c",
  "\u5317\u4E0A\u56FE\u9274\u5B8C\u6210\u4E86\uFF01\\c\\n\u7531\u8877\u5BF9\u4F60\u4E3A\u9047\u5230\u6240\u6709\u5B9D\u53EF\u68A6\\c\\n\u800C\u4ED8\u51FA\u7684\u52AA\u529B\u8868\u793A\u795D\u8D3A\uFF01\\c",
  "\u606D\u559C\u4F60\u5B8C\u6210\u4E86\u5317\u4E0A\u56FE\u9274\uFF01",
  "\u606D\u559C\u4F60\u5B8C\u6210\u4E86\u84DD\u8393\u56FE\u9274\uFF01",
  "\u84DD\u8393\u56FE\u9274",
  "\u606D\u559C\u4F60\uFF01\\n\u84DD\u8393\u56FE\u9274\u5DF2\u8FBE\u5230[VAR 0202(0000)]\u672C\uFF01\\c\\n\u4E3A\u8868\u795D\u8D3A\uFF0C\u5C06\u8D60\u9001[VAR 0202(0002)]\u4E2A\\n[VAR 0109(0001)]\u7ED9\u4F60\uFF01\\c",
  "\u606D\u559C\u4F60\uFF01\\n\u84DD\u8393\u56FE\u9274\u5DF2\u8FBE\u5230[VAR 0202(0000)]\u672C\uFF01\\c\\n\u4E3A\u8868\u795D\u8D3A\uFF0C\u5C06\u8D60\u9001[VAR 0202(0002)]\u4E2A\\n[VAR 0109(0001)]\u7ED9\u4F60\uFF01\\c",
  "\u5389\u3001\u5389\u5BB3\uFF01\\n\u84DD\u8393\u56FE\u9274\u5B8C\u6210\u4E86\uFF01\\c\\n\u4E5F\u5C31\u662F\u8BF4[VAR 0100(0000)]\u4F60\\n\u5DF2\u7ECF\u9047\u5230\u8FC7\u84DD\u8393\u5B66\u56ED\\r\\n\u6240\u6709\u7684\u5B9D\u53EF\u68A6\uFF01\\c\\n\u4F60\u7528\u4F60\u7684\u53CC\u817F\u8D70\u904D\u56DB\u65B9\u7684\\n\u8FD9\u573A\u5192\u9669\u5C06\u662F\u65E0\u4EF7\u7684\u5B9D\u7269\u2026\u2026\\c\\n\u4E3A\u4E86\u79F0\u8D5E\u4F60\u53D6\u5F97\u7684\u8363\u8000\uFF0C\\n\u5E76\u5BF9\u4F60\u8FDB\u884C\u8868\u5F70\u2026\u2026\\c\\n\u8BF7\u5230\u84DD\u8393\u5B66\u56ED\u7684\u5165\u53E3\\n\u627E\u5E2D\u84DD\u5427\uFF01\\c",
  "\u5728\u751F\u6001\u5DE8\u86CB\u56DB\u5904\u8D70\u8D70\uFF0C\\n\u5BFB\u627E\u5B9D\u53EF\u68A6\u5427\uFF01\\c\\n\u5B9D\u53EF\u68A6\u4F1A\u51FA\u73B0\u5728\uFF14\u4E2A\u533A\u57DF\u7684\\n\u5404\u79CD\u5404\u6837\u7684\u5730\u65B9\u54E6\uFF01\\c",
  "\u751F\u6001\u5DE8\u86CB\u7684\u5929\u7A7A\\n\u4F1A\u8DDF\u968F\u73B0\u5B9E\u65F6\u95F4\u53D1\u751F\u53D8\u5316\uFF01\\c\\n\u5373\u4FBF\u662F\u5728\u540C\u6837\u7684\u5730\u65B9\uFF0C\u6839\u636E\u65F6\u95F4\u6BB5\u4E0D\u540C\uFF0C\\n\u51FA\u73B0\u7684\u5B9D\u53EF\u68A6\u4E5F\u4F1A\u6709\u53D8\u5316\u54E6\uFF01\\c",
  "\u8FD8\u5DEE\u4E00\u70B9\u5C31\u80FD\\n\u5B8C\u6210\u84DD\u8393\u56FE\u9274\u4E86\uFF01\\c\\n[VAR 0100(0000)]\u4F60\\n\u7EDD\u5BF9\u80FD\u591F\u5B8C\u6210\u7684\uFF01\\c",
  "\u84DD\u8393\u56FE\u9274\u5B8C\u6210\u4E86\uFF01\\c\\n\u7531\u8877\u5BF9\u4F60\u4E3A\u9047\u5230\u6240\u6709\u5B9D\u53EF\u68A6\\c\\n\u800C\u4ED8\u51FA\u7684\u52AA\u529B\u8868\u793A\u795D\u8D3A\uFF01\\c"
]
