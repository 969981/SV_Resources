  "\u76D0\u77F3\u5B9D\u5CA9\u76D0\u51B0\u6DC7\u6DCB",
  "TERIYAKI\u51B0\u6DC7\u6DCB",
  "\u8FD0\u7528\u4E86\u9999\u8FA3\u9171\u6C41\uFF0C\\n\u5DE7\u5999\u5E26\u51FA\u852C\u83DC\u9C9C\u751C\u7684\u4E09\u660E\u6CBB\u3002",
  "\u9985\u6599\u4EC5\u6709\u679C\u9171\u548C\u8349\u8393\u7684\u4E09\u660E\u6CBB\u3002\\n\u6B63\u56E0\u4E3A\u5176\u6734\u7D20\uFF0C\u6240\u4EE5\u662F\u767E\u5403\u4E0D\u817B\u7684\u4F73\u80B4\u3002",
  "\u9178\u5473\u4E0E\u9C9C\u7F8E\u7684\u5E73\u8861\u662F\u5176\u5173\u952E\uFF0C\\n\u591A\u4E0B\u6A58\u5B50\u9171\u662F\u5176\u7F8E\u5473\u7684\u79D8\u8BC0\u3002",
  "\u6734\u5B9E\u4E14\u4EF7\u683C\u5B9E\u60E0\uFF0C\u5374\u4E0D\u5931\u7F8E\u5473\uFF0C\\n\u5207\u8584\u70E4\u9999\u589E\u6DFB\u98CE\u5473\u4E5F\u751A\u4F73\u3002",
  "\u5473\u9053\u4F1A\u968F\u725B\u6CB9\u679C\u7684\u540E\u719F\u7A0B\u5EA6\u800C\u53D8\u5316\uFF0C\\n\u662F\u4E00\u6B3E\u8BA9\u4EBA\u6C38\u8FDC\u5403\u4E0D\u817B\u7684\u4E09\u660E\u6CBB\u3002",
  "\u591A\u79CD\u98DF\u6750\u594F\u51FA\u4E86\u7F8E\u5999\u7684\u65CB\u5F8B\uFF0C\\n\u8FD9\u9053\u83DC\u786E\u5B9E\u503C\u5F97\u51A0\u4EE5\u5730\u540D\u3002",
  "\u7531\u591A\u79CD\u6C34\u679C\u7F16\u7EC7\u51FA\u7684\u6ECB\u5473\u6D53\u539A\u4E14\u590D\u6742\uFF0C\\n\u8BA9\u4EBA\u96BE\u4EE5\u76F8\u4FE1\u8FD9\u662F\u51FA\u81EA\u4E8E\u679C\u6C41\u7684\u5473\u9053\u3002",
  "\u7ECF\u8FC7\u70E7\u70E4\u540E\u7684\u852C\u83DC\u9C9C\u5473\u6D53\u70C8\uFF0C\\n\u65E0\u8BBA\u662F\u7528\u4F5C\u914D\u83DC\u8FD8\u662F\u524D\u83DC\u90FD\u5341\u5206\u5408\u9002\u3002",
  "\u6734\u5B9E\u7684\u5473\u9053\u80FD\u7ED9\u820C\u5934\u548C\u5FC3\u7075\u90FD\u5E26\u6765\u5B89\u8BE6\u7684\u611F\u53D7\uFF0C\\n\u662F\u5E15\u5E95\u4E9A\u6700\u7ECF\u5178\u7684\u62DB\u724C\u524D\u83DC\u3002",
  "\u8FD9\u9053\u83DC\u80FD\u8BA9\u4EBA\u5355\u7EAF\u5730\u4EAB\u53D7\u73CD\u7A00\u98DF\u6750\uFF0C\\n\u800C\u5269\u4E0B\u7684\u6CB9\u66F4\u53EF\u7528\u5728\u901A\u5FC3\u7C89\u4E0A\u3002",
  "\u98DF\u6750\u65B0\u9C9C\u5F97\u8BA9\u4EBA\u4EFF\u4F5B\u7F6E\u8EAB\u5927\u6D77\uFF0C\\n\u800C\u6F02\u4EAE\u7684\u6446\u76D8\u66F4\u662F\u8BA9\u8FD9\u5473\u83DC\u7F8E\u4E3D\u5982\u753B\u3002",
  "\u5176\u751C\u5473\u6734\u5B9E\u800C\u6E29\u67D4\u8BA9\u4EBA\u8EAB\u5FC3\u8212\u7545\uFF0C\\n\u65E0\u8BBA\u662F\u51B0\u9547\u8FD8\u662F\u8D81\u70ED\u4EAB\u7528\u90FD\u90A3\u4E48\u7F8E\u5473\u3002",
  "\u8FD9\u9053\u83DC\u7684\u9178\u5473\u8BF1\u4EBA\u98DF\u6B32\uFF0C\\n\u800C\u65E0\u4E0E\u4F26\u6BD4\u7684\u9C9C\u5EA6\u4E5F\u662F\u5176\u7F8E\u5473\u7684\u79D8\u8BC0\u3002",
  "\u8FD9\u4EFF\u4F5B\u662F\u4E00\u573A\u4E30\u5BCC\u7684\u718F\u9999\u4E0E\u9999\u8349\u9999\u7684\u5A5A\u59FB\uFF0C\\n\u4E43\u4E00\u9053\u80FD\u8BA9\u4EBA\u54C1\u5C1D\u9999\u5473\u7684\u4F73\u80B4\u3002",
  "\u4F7F\u7528\u7684\u98DF\u6750\u968F\u5F53\u65E5\u5E02\u573A\u60C5\u51B5\u800C\u53D8\uFF0C\\n\u5728\u67D0\u79CD\u610F\u4E49\u4E0A\u800C\u8A00\u662F\u4E00\u9053\u4EA4\u7531\u5927\u6D77\u70F9\u996A\u7684\u901A\u5FC3\u7C89\u3002",
  "\u4EE5\u82B1\u4E3A\u4E3B\u9898\u76844\u6B3E\u5BFF\u53F8\uFF0C\\n\u4E0D\u77E5\u4E3A\u4F55\u6BCF\u79CD\u90FD\u975E\u5E38\u8FA3\u3002",
  "\u4EE5\u9E1F\u4E3A\u4E3B\u9898\u76844\u6B3E\u5BFF\u53F8\uFF0C\\n\u4E0D\u77E5\u4E3A\u4F55\u6BCF\u79CD\u90FD\u975E\u5E38\u751C\u3002",
  "\u4EE5\u98CE\u4E3A\u4E3B\u9898\u76844\u6B3E\u5BFF\u53F8\uFF0C\\n\u4E0D\u77E5\u4E3A\u4F55\u6BCF\u79CD\u90FD\u975E\u5E38\u9178\u3002",
  "\u4EE5\u6708\u4E3A\u4E3B\u9898\u76844\u6B3E\u5BFF\u53F8\uFF0C\\n\u4E0D\u77E5\u4E3A\u4F55\u6BCF\u79CD\u90FD\u975E\u5E38\u82E6\u3002",
  "\u4F7F\u7528\u4E86\u7ECF\u957F\u65F6\u95F4\u719F\u6210\u7684\u5473\u564C\uFF0C\\n\u800C\u5176\u6C64\u5934\u4E5F\u5341\u5206\u4E4B\u8BB2\u7A76\u3002",
  "\u4EE5\u971C\u4E3A\u4E3B\u9898\u7684\u5E97\u94FA\u9650\u5B9A\u7EC4\u5408\uFF0C\\n4\u8D2F\u5BFF\u53F8\u90FD\u7ECF\u5927\u53A8\u7CBE\u6311\u7EC6\u9009\u3002",
  "\u4EE5\u9730\u4E3A\u4E3B\u9898\u7684\u5E97\u94FA\u9650\u5B9A\u7EC4\u5408\uFF0C\\n4\u8D2F\u5BFF\u53F8\u90FD\u7528\u4E0A\u4E86\u5927\u53A8\u7684\u6D51\u8EAB\u89E3\u6570\u3002",
  "\u4EE5\u96F9\u4E3A\u4E3B\u9898\u7684\u5E97\u94FA\u9650\u5B9A\u7EC4\u5408\uFF0C\\n4\u8D2F\u5BFF\u53F8\u90FD\u662F\u5927\u53A8\u7684\u8BDA\u610F\u63A8\u8350\u3002",
  "\u4EE5\u9719\u4E3A\u4E3B\u9898\u7684\u5E97\u94FA\u9650\u5B9A\u7EC4\u5408\uFF0C\\n4\u8D2F\u5BFF\u53F8\u90FD\u7ECF\u5927\u53A8\u7AED\u5C3D\u5168\u529B\u3002",
  "\u6E05\u6F88\u7684\u6C64\u5934\u5BCC\u542B\u9C9C\u5473\uFF0C\\n\u662F\u4E00\u9053\u6781\u4E3A\u8BB2\u7A76\u7684\u5E97\u94FA\u9650\u5B9A\u83DC\u5F0F\u3002",
  "\u4F4E\u5EC9\u7684\u4EF7\u683C\u5374\u6709\u771F\u6750\u5B9E\u6599\u7684\u5473\u9053\uFF0C\\n\u5176\u9EBB\u4E0E\u8FA3\u7684\u5473\u9053\u5341\u5206\u6B63\u5B97\u3002",
  "\u8FD9\u6B3E\u62DB\u724C\u751C\u70B9\u7684\u751C\u5473\u9AD8\u96C5\u6E05\u65B0\uFF0C\\n\u800C\u4E14\u5BF9\u820C\u5934\u65E0\u6BD4\u6E29\u67D4\u3002",
  "\u8FD9\u9053\u5C0F\u83DC\u7528\u6765\u8F6C\u6362\u53E3\u5473\u975E\u5E38\u5408\u9002\uFF0C\\n\u5176\u6734\u7D20\u7684\u9178\u5473\u8BA9\u4EBA\u5FC3\u65F7\u795E\u6021\u3002",
  "\u504F\u6D53\u7684\u8C03\u5473\u4E0B\u996D\u53C8\u4E0B\u9152\uFF0C\\n\u662F\u4EBA\u6C14\u5F88\u9AD8\u7684\u83DC\u5F0F\u3002",
  "\u4E00\u6B3E\u6C64\u5E95\u4EE5\u9171\u6CB9\u4E3A\u57FA\u7840\u7684\u62C9\u9762\uFF0C\u5E97\u4E3B\u8868\u793A\\n\u8FD9\u7897\u9762\u91CD\u73B0\u4E86\u5176\u5728\u5173\u90FD\u65F6\u54C1\u5C1D\u5230\u7684\u5473\u9053\u3002",
  "\u4F7F\u7528\u4E86\u6700\u9AD8\u7EA7\u98DF\u6750\u5C06\u683C\u96F7\u6D3E\u997C\\n\u70F9\u8C03\u81F3\u6781\u81F4\u7684\u4E00\u6B3E\u9876\u7EA7\u6599\u7406\u3002",
  "\u6781\u5C3D\u5962\u534E\uFF0C\u5C06\u7CD6\u716E\u6C34\u679C\\n\u70F9\u8C03\u81F3\u6781\u81F4\u7684\u4E00\u6B3E\u7834\u5929\u8352\u6599\u7406\u3002",
  "\u4F7F\u7528\u4E86\u4E25\u9009\u7684\u98DF\u6750\u5C06\u4EC0\u9526\u7096\u83DC\\n\u70F9\u8C03\u81F3\u6781\u81F4\u7684\u4E00\u6B3E\u8D85\u51E1\u6599\u7406\u3002",
  "\u4F7F\u7528\u4E86\u4E00\u6D41\u7684\u98DF\u6750\u5C06\u54B8\u6D3E\\n\u70F9\u8C03\u81F3\u6781\u81F4\u7684\u4E00\u6B3E\u5353\u8D8A\u6599\u7406\u3002",
  "\u4E0D\u8BA1\u6210\u672C\u5730\u5C06\u83DC\u8089\u7096\u6C64\\n\u70F9\u8C03\u81F3\u6781\u81F4\u7684\u4E00\u6B3E\u7A76\u6781\u6599\u7406\u3002",
  "\u683C\u5916\u545B\u7684\u8FA3\u5473\u662F\u5176\u7279\u5F81\uFF0C\\n\u800C\u5176\u5B9E\u60E0\u7684\u4EF7\u683C\u4E5F\u662F\u4E00\u5927\u9B45\u529B\u3002",
  "\u4EC5\u9760\u8FD9\u4E2A\u5C31\u80FD\u6444\u53D61\u5929\u4EFD\u91CF\u7684\u5361\u8DEF\u91CC\uFF0C\\n\u5BF9\u809A\u5B50\u6765\u8BF4\u6027\u4EF7\u6BD4\u975E\u5E38\u4E4B\u9AD8\u3002",
  "\u4EBA\u5DE5\u7684\u9178\u5473\u5341\u5206\u523A\u6FC0\uFF0C\\n\u9002\u5408\u5728\u54C1\u5C1D\u6CB9\u817B\u6599\u7406\u540E\u98DF\u7528\u3002",
  "\u867D\u7136\u852C\u83DC\u4E0D\u7B97\u7279\u522B\u65B0\u9C9C\uFF0C\\n\u4F46\u51EF\u6492\u9171\u5E7F\u53D7\u597D\u8BC4\u3002",
  "\u5230\u8BE5\u5E97\u5FC5\u70B9\u7684\u62DB\u724C\u83DC\uFF0C\\n\u4EE5\u4EFD\u91CF\u4E3A\u5356\u70B9\uFF0C\u5728\u5E74\u8F7B\u4EBA\u4E2D\u5F88\u6709\u4EBA\u6C14\u3002",
  "\u70B8\u81F3\u677E\u8106\u7684\u571F\u8C46\u4E0E\\n\u72E0\u8FA3\u6912\u9171\u975E\u5E38\u642D\u914D\u3002",
  "\u6E05\u8106\u7684\u53E3\u611F\u8BA9\u4EBA\u8EAB\u5FC3\u8212\u7545\uFF0C\\n\u662F\u9002\u5408\u4E0E\u504F\u82E6\u7684\u5496\u5561\u4E00\u540C\u4EAB\u7528\u7684\u8336\u70B9\u3002",
  "\u8FD9\u662F\u4E00\u6B3E\u73B0\u69A8\u7684\u67E0\u6AAC\u6C41\u914D\u5408\u4E0A\u5F3A\u52B2\u78B3\u9178\uFF0C\\n\u4F1A\u8BA9\u4EBA\u60F3\u5927\u53E3\u5927\u53E3\u559D\u7684\u996E\u6599\u3002",
  "\u5473\u9053\u7A0D\u82E6\u7684\u6DF7\u5408\u5496\u5561\uFF0C\\n\u7531\u4E8E\u5176\u99A5\u90C1\u82AC\u82B3\uFF0C\u6240\u4EE5\u4F1A\u8BA9\u4EBA\u559D\u4E2A\u4E0D\u505C\u3002",
  "\u53EA\u5939\u4E86\u829D\u58EB\u548C\u706B\u817F\uFF0C\u5341\u5206\u7B80\u6734\u3002\\n\u677E\u8106\u53E3\u611F\u5BB9\u6613\u98DF\u7528\u3002",
  "\u9985\u6599\u4EE5\u8FA3\u5473\u9171\u6C41\u4E0E\u852C\u83DC\u4E3A\u4E3B\uFF0C\\n\u53E3\u611F\u6E05\u723D\u7684\u4E09\u660E\u6CBB\u3002",
  "\u6D53\u539A\u7684\u751C\u5473\u4F1A\u5728\u53E3\u4E2D\u4E45\u4E45\u4E0D\u6563\uFF0C\\n\u662F\u4E00\u6B3E\u8981\u6CE8\u610F\u4E0D\u80FD\u5403\u8FC7\u5934\u7684\u4E09\u660E\u6CBB\u3002",
  "\u571F\u8C46\u6C99\u62C9\u80FD\u4EE4\u4EBA\u5F88\u6709\u9971\u8179\u611F\uFF0C\\n\u8FD9\u6B3E\u4E09\u660E\u6CBB\u5F88\u9002\u5408\u7528\u4F5C\u5348\u9910\u3002",
  "\u9985\u6599\u6734\u7D20\u4EC5\u6709\u9178\u9EC4\u74DC\uFF0C\\n\u662F\u4E00\u6B3E\u7B80\u7EA6\u7684\u4E09\u660E\u6CBB\u3002",
  "\u8FD9\u4E2A\u4E09\u660E\u6CBB\u7684\u4EAE\u70B9\u662F\u5E76\u6CA1\u4F7F\u7528\u7092\u86CB\uFF0C\\n\u800C\u662F\u4F7F\u7528\u4E86\u5207\u6210\u7247\u7684\u6C34\u716E\u86CB\u3002",
  "\u5FAE\u5FAE\u7684\u8FA3\u5473\u80FD\u8BA9\u4EBA\u611F\u89C9\u7C73\u996D\u9999\u751C\uFF0C\\n\u634F\u5F97\u8F83\u84EC\u677E\u4E5F\u662F\u4EAE\u70B9\u4E4B\u4E00\u3002",
  "\u4F5C\u4E3A\u70B9\u5FC3\u6216\u662F\u996D\u540E\u751C\u54C1\u90FD\u5341\u5206\u5408\u9002\uFF0C\\n\u5473\u9053\u6E29\u548C\u751C\u800C\u4E0D\u817B\u3002",
  "\u9178\u5F97\u80FD\u9EBB\u75F9\u820C\u5934\uFF0C\\n\u54B8\u5473\u5341\u8DB3\u597D\u5473\u9053\u3002",
  "\u8FD9\u9053\u83DC\u91CD\u73B0\u4E86\u8001\u677F\u5A18\u5728\\n\u4E30\u7F18\u5730\u533A\u65C5\u884C\u65F6\u6240\u5C1D\u5230\u7684\u5473\u9053\u3002",
  "\u914D\u6599\u523B\u610F\u53EA\u653E\u4E86\u5927\u8471\uFF0C\u662F\u4E00\u7897\u80FD\\n\u8BA9\u4EBA\u4EAB\u53D7\u9762\u9732\u4E0E\u835E\u9EA6\u5473\u9053\u7684\u9762\u3002",
  "\u9999\u8FA3\u7684\u8C03\u5473\u8BA9\u4EBA\u6B32\u7F62\u4E0D\u80FD\uFF0C\\n\u8FA3\u5473\u6781\u5F3A\u800C\u5473\u9053\u6781\u4F73\u54E6\u3002",
  "\u4E0D\u4EC5\u65B0\u9C9C\u70ED\u4E4E\u4E4E\u7684\u65F6\u5019\u5F88\u597D\u5403\uFF0C\\n\u51B7\u6389\u4E4B\u540E\u53E3\u611F\u6E7F\u6DA6\u4E5F\u5F88\u7F8E\u5473\u3002",
  "\u716E\u5F97\u7C98\u7A20\u4E0D\u6613\u51B7\uFF0C\\n\u9178\u9178\u7684\u5473\u9053\u5F88\u597D\u5403\u3002",
  "\u6E05\u723D\u7684\u82E6\u6DA9\u5473\u548C\u6D53\u90C1\u7684\u9999\u5473\\n\u548C\u6CB9\u817B\u7684\u6599\u7406\u5F88\u76F8\u914D\u3002",
  "\u9C9C\u5473\u6781\u5F3A\u7684\u6C64\uFF0C\\n\u636E\u8BF4\u662F\u4F7F\u7528\u4E86\u72EC\u95E8\u7684\u98DF\u6750\u3002",
  "\u975E\u5E38\u6B63\u5B97\u7684\u5409\u62FF\u68D2\uFF0C\\n\u6CA1\u6709\u7279\u522B\u4E4B\u5904\u4F46\u8DB3\u591F\u7F8E\u5473\u3002",
  "\u6492\u4E0A\u4E86\u5DE7\u514B\u529B\u7684\u5409\u62FF\u68D2\uFF0C\\n\u6CA1\u6709\u7279\u522B\u4E4B\u5904\u4F46\u8DB3\u591F\u7F8E\u5473\u3002",
  "\u6563\u53D1\u8089\u6842\u82B3\u9999\u7684\u5409\u62FF\u68D2\uFF0C\\n\u6CA1\u6709\u7279\u522B\u4E4B\u5904\u4F46\u8DB3\u591F\u7F8E\u5473\u3002",
  "\u521A\u70E4\u597D\u65F6\u975E\u4E00\u822C\u7684\u597D\u5403\uFF0C\\n\u6D53\u90C1\u7684\u9999\u5473\u8BF1\u4EBA\u98DF\u6B32\u3002",
  "\u70E4\u5F97\u6070\u5230\u597D\u5904\u7684\u996D\u56E2\uFF0C\\n\u4EE5\u9171\u6CB9\u4E3A\u57FA\u7840\u7684\u9171\u6C41\u5341\u5206\u82B3\u9999\u3002",
  "\u51FA\u751F\u4E8E\u5173\u90FD\u7684\u5E97\u4E3B\u5BF9\u5176\u5473\u9053\u5F15\u4EE5\u4E3A\u50B2\uFF0C\\n\u914D\u6599\u662F\u8349\u8393\u548C\u5DE7\u514B\u529B\u3002",
  "\u51FA\u751F\u4E8E\u5173\u90FD\u7684\u5E97\u4E3B\u5BF9\u5176\u5473\u9053\u5F15\u4EE5\u4E3A\u50B2\uFF0C\\n\u914D\u6599\u662F\u8349\u8393\u548C\u9C9C\u5976\u6CB9\u3002",
  "\u51FA\u751F\u4E8E\u5173\u90FD\u7684\u5E97\u4E3B\u5BF9\u5176\u5473\u9053\u5F15\u4EE5\u4E3A\u50B2\uFF0C\\n\u914D\u6599\u662F\u5DE7\u514B\u529B\u548C\u9999\u8549\u3002",
  "\u8584\u8377\u8F83\u5F3A\u52B2\u5DE7\u514B\u529B\u8F83\u82E6\uFF0C\\n\u72EC\u7279\u7684\u5473\u9053\u8BA9\u4EBA\u4E0A\u763E\u3002",
  "\u6C99\u6C99\u7684\u53E3\u611F\u8BA9\u4EBA\u8212\u7545\uFF0C\\n\u6DE1\u6DE1\u7684\u751C\u5473\u767E\u5403\u4E0D\u817B\u3002",
  "\u52A0\u5165\u4E86\u65B0\u9C9C\u7684\u8349\u8393\uFF0C\\n\u80FD\u8BA9\u4EBA\u5403\u5230\u9C9C\u7F8E\u7684\u751C\u5473\u54E6\u3002",
  "\u4F7F\u7528\u4E86\u7ECF\u7CBE\u6311\u7EC6\u9009\u7684\u6210\u719F\u8292\u679C\uFF0C\\n\u56E0\u4E3A\u751C\u5F97\u80FD\u8BA9\u4EBA\u53D1\u9EBB\uFF0C\u6240\u4EE5\u559C\u6B22\u4E0E\u5426\u56E0\u4EBA\u800C\u5F02\u3002",
  "\u5E97\u91CC\u7684\u62DB\u724C\u51B0\u6DC7\u6DCB\uFF0C\\n\u4F7F\u7528\u4E86\u76D0\u77F3\u5B9D\u7684\u76D0\uFF0C\u54B8\u5473\u67D4\u548C\u3002",
  "\u751C\u751C\u8FA3\u8FA3\u7684\u9171\u6C41\u8BA9\u4EBA\u4E0A\u763E\uFF0C\\n\u662F\u9690\u85CF\u7684\u4EBA\u6C14\u5546\u54C1\u3002",
  "\u82B1\u74E3\u51B0\u6DC7\u6DCB\u3000\u676F\u88C5",
  "\u82B1\u74E3\u51B0\u6DC7\u6DCB\u3000\u8106\u7B52",
  "\u8349\u8393\u5228\u51B0",
  "\u751C\u74DC\u5228\u51B0",
  "\u67E0\u6AAC\u5228\u51B0",
  "\u84DD\u8272\u963F\u7F57\u62C9\u5228\u51B0",
  "\u8461\u8404\u5228\u51B0",
  "\u5317\u4E0A\u7092\u9762",
  "\u7CD6\u82F9\u679C",
  "\u7CD6\u9752\u82F9\u679C",
  "\u7CD6\u8393\u8393",
  "\u7CD6\u8513\u8393",
  "\u7CD6\u82F9\u91CE",
  "\u7CD6\u51F0\u68A8",
  "\u4F7F\u7528\u5317\u4E0A\u751F\u4EA7\u7684\u5976\u5236\u6210\uFF0C\\n\u662F\u5F53\u5730\u5F15\u4EE5\u4E3A\u50B2\u7684\u540D\u4EA7\u4E4B\u4E00\u3002",
  "\u4F7F\u7528\u7684\u51B0\u6DC7\u6DCB\u548C\u676F\u88C5\u7684\u4E00\u6837\uFF0C\\n\u7136\u800C\u603B\u611F\u89C9\u522B\u6709\u4E00\u756A\u98CE\u5473\uFF0C\u5341\u5206\u795E\u5947\u3002",
  "\u6D47\u4E0A\u4E86\u7CD6\u6D46\u7684\u5228\u51B0\u3002\\n\u7CD6\u6D46\u65E8\u5728\u6A21\u4EFF\u51FA\u8349\u8393\u7684\u9178\u751C\u5473\u3002",
  "\u6D47\u4E0A\u4E86\u7CD6\u6D46\u7684\u5228\u51B0\u3002\\n\u7CD6\u6D46\u7684\u989C\u8272\u4F1A\u8BA9\u4EBA\u8054\u60F3\u5230\u751C\u74DC\u3002",
  "\u8BA9\u4EBA\u75DB\u5FEB\u7684\u67E0\u6AAC\u8272\u5F88\u517B\u773C\u3002\\n\u6CA1\u6709\u9178\u5473\uFF0C\u662F\u79CD\u5F88\u5927\u4F17\u7684\u5228\u51B0\u3002",
  "\u6D47\u4E0A\u4E86\u7CD6\u6D46\u7684\u5228\u51B0\u3002\u7CD6\u6D46\u7684\u8272\u5F69\\n\u4EE5\u963F\u7F57\u62C9\u5730\u533A\u5927\u6D77\u7684\u989C\u8272\u4E3A\u539F\u578B\u3002",
  "\u4E3A\u7231\u5403\u8461\u8404\u7684\u4EBA\u91CF\u8EAB\u5B9A\u5236\u7684\u5228\u51B0\u3002\\n\u6D53\u70C8\u7684\u7D2B\u8272\u5F88\u6709\u51B2\u51FB\u529B\u3002",
  "\u56E0\u70E7\u7126\u7684\u9171\u6C41\u4EA7\u751F\u7684\u7F8E\u62C9\u5FB7\u53CD\u5E94\uFF0C\\n\u6B64\u7092\u9762\u8272\u9999\u5473\u7F8E\u8BA9\u4EBA\u96BE\u4EE5\u6297\u62D2\u3002",
  "\u4F7F\u7528\u5317\u4E0A\u751F\u4EA7\u7684\u82F9\u679C\u5236\u6210\uFF0C\\n\u662F\u975E\u5E38\u597D\u5403\u7684\u7CD6\u82F9\u679C\u3002",
  "\u5317\u4E0A\u751F\u4EA7\u7684\u9752\u82F9\u679C\u9178\u5473\u5F3A\u70C8\uFF0C\\n\u548C\u8986\u76D6\u5728\u8868\u9762\u7684\u7CD6\u6D46\u5F88\u642D\u914D\u3002",
  "\u4F1A\u8BA9\u4EBA\u7C7B\u611F\u89C9\u82E6\u5F97\u4E0D\u5F97\u4E86\uFF0C\\n\u4F46\u8FD8\u662F\u4E0D\u65AD\u6709\u5B69\u5B50\u88AB\u5176\u5916\u8868\u6240\u9A97\u3002",
  "\uFF11\uFF10\uFF10\uFF05\u5B8C\u5168\u4F7F\u7528\u4E86\u53C8\u8FA3\u53C8\u6DA9\u7684\u8513\u8393\u679C\uFF0C\\n\u4EBA\u7C7B\u5403\u4E86\u4E4B\u540E\u4F1A\u6446\u51FA\u96BE\u4EE5\u8A00\u55BB\u7684\u8868\u60C5\u3002",
  "\u6BD4\u8D77\u5176\u4ED6\u6811\u679C\u8981\u5BB9\u6613\u5165\u53E3\uFF0C\\n\u590D\u6742\u7684\u53E3\u5473\u5728\u61C2\u884C\u4EBA\u58EB\u4E4B\u95F4\u5F88\u53D7\u6B22\u8FCE\u3002",
  "\u7CD6\u6D46\u7684\u751C\u5473\u4E0E\u51F0\u68A8\u7684\u9178\u8FA3\u5473\\n\u642D\u914D\u5F97\u6070\u5230\u597D\u5904\u3002",
  "\u5B66\u56ED\u6BD4\u8428",
  "\u5B66\u56ED\u5976\u6614",
  "\u5B66\u56ED\u85AF\u6761",
  "\u5B66\u56ED\u5957\u9910",
  "\u7528\u8DB3\u91CF\u7684\u6C49\u5821\u6392\u548C\u829D\u58EB\\n\u5851\u9020\u51FA\u5B66\u56ED\u6821\u5FBD\u7684\u7279\u5927\u6BD4\u8428\u3002",
  "\u4E00\u6B3E\u51B0\u6DC7\u6DCB\u548C\u6C34\u679C\\n\u585E\u5230\u676F\u5B50\u90FD\u88C5\u4E0D\u4E0B\u7684\u51B7\u996E\u3002",
  "\u5806\u79EF\u5982\u5C71\u7684\u85AF\u6761\u3002\u4ECE\u5356\u76F8\u4E5F\u80FD\u611F\u53D7\u5230\\n\u5F53\u4E2D\u5145\u6EE1\u60F3\u8BA9\u5B66\u751F\u5403\u9971\u7684\u5F3A\u70C8\u613F\u671B\u3002",
  "\u5C06\u5E2D\u84DD\u6821\u957F\u9009\u62E9\u7684\u6599\u7406\\n\u4E0D\u60DC\u8840\u672C\u5730\u62FC\u5728\u4E00\u8D77\u7684\u68A6\u5E7B\u5957\u9910\u3002"
]
