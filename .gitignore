docs/_site/

# Intentionally DO NOT ignore 4.0.0/1 or *.7z.001 etc.

# Upstream checkouts and in-progress extraction work; never vendor dependencies
/tools/_external/
/Unpack/**/_work/
/Unpack/**/.cache/

# Private locally provided Oodle component and generated PokeDocs hashes
/tools/_local/
**/oo2core_8_win64.dll
**/GFPAKHashCache.bin
**/GFPAKHashCache.report.json
# Incomplete per-file exports are never committed
**/*.sv-writing

# Ephemeral pinned third-party source checkouts for ZA Lua verification
/.research/
