# Local developer/editor files
.vs/
.vscode/
.idea/
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.suo
*.user

# Temporary files emitted by local transfer/verification tools
*.sv-copying
*.sv-writing
*.partial
docs/_site/

# Intentionally DO NOT ignore 4.0.0/1 or *.7z.001 etc.

# Upstream checkouts and in-progress extraction work; never vendor dependencies
/tools/_external/
/Unpack/**/_work/
/Unpack/**/.cache/

# Private locally provided Oodle component and generated PokeDocs hashes
/tools/_local/
**/oo2core_8_win64.dll
**/GFPAKHashCache.bin
**/GFPAKHashCache.report.json
# Incomplete per-file exports are never committed
**/*.sv-writing

# Ephemeral pinned third-party source checkouts for ZA Lua verification
/.research/

# Local R0/R1 derived resource data; track curated samples only with git add -f.
/Unpack/4.0.0/romfs/arc/data.trpfs/_index/resource_catalog.sqlite*
/Unpack/4.0.0/romfs/arc/data.trpfs/_index/exports/
/Unpack/4.0.0/romfs/arc/data.trpfs/parsed/**
!/Unpack/4.0.0/romfs/arc/data.trpfs/parsed/README.md
/Unpack/4.0.0/romfs/arc/data.trpfs/converted/**
!/Unpack/4.0.0/romfs/arc/data.trpfs/converted/README.md
/Unpack/4.0.0/romfs/arc/data.trpfs/resources/**
!/Unpack/4.0.0/romfs/arc/data.trpfs/resources/README.md

# R3/R4 incremental state and metadata archives (local-only by default)
/Unpack/4.0.0/romfs/arc/data.trpfs/_index/r4-checkpoint.json
/Unpack/4.0.0/romfs/arc/data.trpfs/_index/r4-last-run.json
/Unpack/4.0.0/romfs/arc/data.trpfs/_index/r4-archives/

# Isolated hardlink workspaces for concurrent SV secondary conversion
/.sv-secondary-work/

# Generated SLR Lua54 decompilation (local-only; no bulk game source in Git)
/Unpack/4.0.0/romfs/arc/data.trpfs/virtual_converted/script/lua/recovered/
/Unpack/4.0.0/romfs/arc/data.trpfs/virtual_converted/script/lua/haxe/
/Unpack/4.0.0/romfs/arc/data.trpfs/virtual_converted/script/lua/_temp/
/Unpack/4.0.0/romfs/arc/data.trpfs/virtual_converted/script/lua/index/*.sqlite*
