<Project Sdk="Microsoft.NET.Sdk">
  <!-- Experimental, side-by-side .NET 10 port. The .NET Framework 4.8 project is unchanged. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>BrawlboxHelper</RootNamespace>
    <AssemblyName>BrawlboxHelper</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BrawlLib"><HintPath>..\Toolbox\Lib\BrawlLib.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Gl_EditorFramework"><HintPath>..\GL_EditorFramework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Syroot.BinaryData"><HintPath>..\Toolbox\Lib\Syroot.BinaryData.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Syroot.Maths"><HintPath>..\Toolbox\Lib\Syroot.Maths.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Syroot.NintenTools.Bfres"><HintPath>..\Toolbox\Lib\Syroot.NintenTools.Bfres.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bfres"><HintPath>..\Toolbox\Lib\Syroot.NintenTools.NSW.Bfres.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Switch_Toolbox_Library\Toolbox_Library.Net10.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Match the original project Compile / EmbeddedResource lists exactly. -->
    <Compile Include="BrawlHelper.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />

  </ItemGroup>
</Project>
