<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless/ROM-free compilation of the EXACT vendored Gen9 encounter implementation.
       Do not duplicate pkNX's encounter rules or use PKHeX reference blobs as output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../pkNX.Containers/pkNX.Containers.csproj" />
    <ProjectReference Include="../pkNX.Structures/pkNX.Structures.csproj" />
    <ProjectReference Include="../FlatBuffers/SV/World/pkNX.Structures.FlatBuffers.SV.World.csproj" />
    <ProjectReference Include="../FlatBuffers/SV/Trinity/pkNX.Structures.FlatBuffers.SV.Trinity.csproj" />
    <ProjectReference Include="../FlatBuffers/SV/Battle/pkNX.Structures.FlatBuffers.SV.Battle.csproj" />
    <PackageReference Include="PKHeX.Core" Version="25.9.25" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../pkNX.WinForms/Dumping/Gen9/BoxCollision9.cs" Link="Gen9/BoxCollision9.cs" />
    <Compile Include="../pkNX.WinForms/Dumping/Gen9/Encounter/*.cs" Link="Gen9/Encounter/%(Filename)%(Extension)" />
    <Compile Include="../pkNX.WinForms/Dumping/Gen9/Location/*.cs" Link="Gen9/Location/%(Filename)%(Extension)" />
    <Compile Include="../pkNX.WinForms/Dumping/Gen9/Models/*.cs" Link="Gen9/Models/%(Filename)%(Extension)" />
    <!-- EXACT pinned fog coordinates: weather legality must not silently lose mist. -->
    <Content Include="../pkNX.WinForms/Resources/all_fog.txt" Link="all_fog.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
